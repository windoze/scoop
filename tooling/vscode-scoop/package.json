{
  "name": "scoop-language-support",
  "displayName": "Scoop Language Support",
  "description": "Scoop language services and native debugging with the Scoop LLDB toolchain",
  "version": "0.3.0",
  "publisher": "scoop",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/windoze/scoop.git",
    "directory": "tooling/vscode-scoop"
  },
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers"
  ],
  "keywords": [
    "scoop",
    "tree-sitter",
    "syntax",
    "highlighting",
    "lsp",
    "completion",
    "debugger",
    "lldb"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onLanguage:scoop",
    "onDebug:scoop",
    "onCommand:scoop.debugFile"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Tree-sitter features are available. The language server and debugger run in trusted workspaces."
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "scoop",
        "aliases": [
          "Scoop",
          "scoop"
        ],
        "extensions": [
          ".scoop"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "configurationDefaults": {
      "[scoop]": {
        "editor.semanticHighlighting.enabled": true,
        "editor.formatOnType": true
      }
    },
    "semanticTokenScopes": [
      {
        "language": "scoop",
        "scopes": {
          "namespace": [
            "entity.name.namespace.scoop"
          ],
          "type": [
            "entity.name.type.scoop"
          ],
          "class": [
            "entity.name.type.class.scoop"
          ],
          "interface": [
            "entity.name.type.interface.scoop"
          ],
          "struct": [
            "entity.name.type.struct.scoop"
          ],
          "enum": [
            "entity.name.type.enum.scoop"
          ],
          "enumMember": [
            "constant.other.enum.scoop"
          ],
          "typeParameter": [
            "entity.name.type.parameter.scoop"
          ],
          "function": [
            "entity.name.function.scoop"
          ],
          "method": [
            "entity.name.function.member.scoop"
          ],
          "parameter": [
            "variable.parameter.scoop"
          ],
          "property": [
            "variable.other.property.scoop"
          ],
          "variable": [
            "variable.other.readwrite.scoop"
          ],
          "variable.readonly": [
            "variable.other.constant.scoop"
          ],
          "variable.defaultLibrary": [
            "variable.language.scoop"
          ],
          "decorator": [
            "entity.name.function.decorator.scoop"
          ],
          "keyword": [
            "keyword.control.scoop"
          ],
          "modifier": [
            "storage.modifier.scoop"
          ],
          "operator": [
            "keyword.operator.scoop"
          ],
          "string": [
            "string.quoted.double.scoop"
          ],
          "number": [
            "constant.numeric.scoop"
          ],
          "comment": [
            "comment.scoop"
          ],
          "comment.documentation": [
            "comment.block.documentation.scoop"
          ]
        }
      }
    ],
    "commands": [
      {
        "command": "scoop.restartLanguageServer",
        "title": "Scoop: Restart Language Server"
      },
      {
        "command": "scoop.showLanguageServerOutput",
        "title": "Scoop: Show Language Server Output"
      },
      {
        "command": "scoop.debugFile",
        "title": "Scoop: Debug Current File"
      },
      {
        "command": "scoop.showDebugOutput",
        "title": "Scoop: Show Debug Output"
      }
    ],
    "configuration": {
      "title": "Scoop",
      "properties": {
        "scoop.server.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable scoop-lsp in trusted workspaces.",
          "scope": "window"
        },
        "scoop.server.path": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Path to scoop-lsp, or a command on PATH. Supports `~/`. When empty, try `~/.scoop/bin/scoop-lsp` and then PATH. The executable runs on the workspace host."
        },
        "scoop.target": {
          "type": "string",
          "default": "",
          "description": "Target triple for analysis. Empty uses the server host target.",
          "scope": "window"
        },
        "scoop.sysroot": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Sysroot for analysis. Empty uses `SCOOP_SYSROOT` or the server installation. Relative paths are resolved by scoop-lsp against the Cone root."
        },
        "scoop.purpose": {
          "type": "string",
          "enum": [
            "production",
            "test"
          ],
          "default": "production",
          "description": "Analyze production sources or include the root Cone tests.",
          "scope": "window"
        },
        "scoop.artifactSearchRoots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional precompiled dependency search directories, relative to the Cone root or absolute.",
          "scope": "window"
        },
        "scoop.configurations": {
          "type": "array",
          "default": [],
          "markdownDescription": "Named analysis configurations. Empty discovers Cone roots from workspace folders and opened Scoop files. Each `rootUri` must be a file URI. Per-configuration settings override the shared analysis settings.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "rootUri"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "description": "Unique configuration name."
              },
              "rootUri": {
                "type": "string",
                "pattern": "^file:",
                "description": "File URI of the root Cone directory."
              },
              "target": {
                "type": "string",
                "minLength": 1
              },
              "sysroot": {
                "type": "string",
                "minLength": 1
              },
              "purpose": {
                "type": "string",
                "enum": [
                  "production",
                  "test"
                ]
              },
              "artifactSearchRoots": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "packageManager": {
                "type": "string",
                "minLength": 1
              },
              "packageCacheDir": {
                "type": "string",
                "minLength": 1
              },
              "lockfile": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "scope": "window"
        },
        "scoop.activeConfiguration": {
          "type": "string",
          "default": "",
          "description": "Name of the active analysis configuration. Empty lets the server select by file.",
          "scope": "window"
        },
        "scoop.trace.server": {
          "type": "string",
          "enum": [
            "messages",
            "verbose"
          ],
          "default": "messages",
          "description": "Trace LSP traffic in the Scoop LSP output channel.",
          "scope": "window",
          "markdownDescription": "LSP trace verbosity. Enable tracing by setting the Scoop LSP output channel log level to Trace (Developer: Set Log Level)."
        },
        "scoop.packageManager": {
          "type": "string",
          "default": "",
          "description": "Companion scoop-pm executable. Empty uses the executable beside scoop-lsp. Relative paths are resolved against the configuration root.",
          "scope": "window"
        },
        "scoop.packageCacheDir": {
          "type": "string",
          "default": "",
          "description": "Local package cache for analysis. Empty uses SCOOP_PACKAGE_CACHE_DIR or ~/.scoop/packages. Analysis never downloads missing packages.",
          "scope": "window"
        },
        "scoop.lockfile": {
          "type": "string",
          "default": "",
          "description": "Explicit Cone.lock path for analysis, relative to the configuration root or absolute. Empty uses the workspace lock.",
          "scope": "window"
        },
        "scoop.debug.adapterPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Path to the Python-enabled Scoop `lldb-dap`. Empty tries `~/.scoop/bin/lldb-dap`, then PATH (Windows uses `lldb-dap.exe`). Runs on the workspace host."
        },
        "scoop.debug.compilerPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Path to the Scoop driver for debug builds. Empty tries `~/.scoop/bin/scoop`, then PATH; Windows uses `sco.exe`. Supports `~/`."
        }
      }
    },
    "breakpoints": [
      {
        "language": "scoop"
      }
    ],
    "debuggers": [
      {
        "type": "scoop",
        "label": "Scoop",
        "languages": [
          "scoop"
        ],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "program": {
                "type": "string",
                "description": "Executable to debug. Launch builds the target when omitted."
              },
              "cwd": {
                "type": "string",
                "description": "Working directory of the debuggee; defaults to the workspace."
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "sourceMap": {
                "type": "array",
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "string"
                  }
                },
                "description": "Source path pairs: [[build path, local path]]."
              },
              "initCommands": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "stopOnEntry": {
                "type": "boolean",
                "default": false
              },
              "console": {
                "type": "string",
                "enum": [
                  "integratedTerminal",
                  "internalConsole",
                  "externalTerminal"
                ],
                "default": "integratedTerminal"
              },
              "stdio": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Optional stdin, stdout and stderr file paths."
              },
              "enableSyntheticChildDebugging": {
                "type": "boolean",
                "default": true,
                "description": "Show a [raw] child beside Scoop formatted values."
              },
              "build": {
                "oneOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "input": {
                        "type": "string",
                        "description": "One Cone directory, Cone.toml, or .scoop file."
                      },
                      "tests": {
                        "type": "boolean",
                        "default": false,
                        "description": "Build the Cone test executable without running it."
                      },
                      "filter": {
                        "type": "string",
                        "description": "Substring of the full test name to run under the debugger."
                      },
                      "profile": {
                        "type": "string",
                        "enum": [
                          "debug",
                          "release"
                        ],
                        "default": "debug"
                      },
                      "args": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        },
                        "description": "Additional scoop build/test arguments, such as --target-dir or --cache-dir."
                      }
                    }
                  }
                ],
                "description": "Build before launch with full debug information. Defaults to true when program is omitted."
              }
            }
          },
          "attach": {
            "properties": {
              "program": {
                "type": "string",
                "description": "Executable to debug. Launch builds the target when omitted."
              },
              "cwd": {
                "type": "string",
                "description": "Working directory of the debuggee; defaults to the workspace."
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "sourceMap": {
                "type": "array",
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "string"
                  }
                },
                "description": "Source path pairs: [[build path, local path]]."
              },
              "initCommands": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "stopOnEntry": {
                "type": "boolean",
                "default": false
              },
              "console": {
                "type": "string",
                "enum": [
                  "integratedTerminal",
                  "internalConsole",
                  "externalTerminal"
                ],
                "default": "integratedTerminal"
              },
              "stdio": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Optional stdin, stdout and stderr file paths."
              },
              "enableSyntheticChildDebugging": {
                "type": "boolean",
                "default": true,
                "description": "Show a [raw] child beside Scoop formatted values."
              },
              "pid": {
                "oneOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "string"
                  }
                ],
                "description": "Process ID to attach."
              }
            },
            "required": [
              "pid"
            ]
          }
        },
        "configurationSnippets": [
          {
            "label": "Scoop: Build and debug",
            "body": {
              "type": "scoop",
              "request": "launch",
              "name": "Scoop: Build and debug",
              "build": {
                "input": "${workspaceFolder}"
              },
              "console": "integratedTerminal"
            }
          },
          {
            "label": "Scoop: Debug tests",
            "body": {
              "type": "scoop",
              "request": "launch",
              "name": "Scoop: Debug tests",
              "build": {
                "input": "${workspaceFolder}",
                "tests": true
              },
              "console": "integratedTerminal"
            }
          },
          {
            "label": "Scoop: Debug existing executable",
            "body": {
              "type": "scoop",
              "request": "launch",
              "name": "Scoop: Debug executable",
              "program": "${workspaceFolder}/target/program",
              "build": false
            }
          },
          {
            "label": "Scoop: Attach",
            "body": {
              "type": "scoop",
              "request": "attach",
              "name": "Scoop: Attach",
              "pid": "${1:1234}"
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "vscode:prepublish": "npm run build -w tree-sitter-scoop && npm run build",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "test:vscode": "node scripts/test-vscode.mjs",
    "package": "vsce package --no-dependencies --skip-license"
  },
  "dependencies": {
    "vscode-languageclient": "11.0.0",
    "web-tree-sitter": "0.27.1"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "@types/vscode": "1.100.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2"
  },
  "extensionKind": [
    "workspace"
  ]
}
