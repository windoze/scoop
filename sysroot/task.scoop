// Scoop sysroot: Task internals
//
// 说明：
// - 这里承载 core task 的普通 Scoop 实现；
// - runtime 只继续提供 continuation / GC / thread / atomic substrate；
// - task 对象模型已从 per-task `Mutex` 收口为最小 atomic claim 字段；
// - public `step()` 对 claim 冲突、重入 drive 与 `Running` 观察统一按 fatal misuse trap 处理。
// - claim 只覆盖状态检查/发布的短窗口；真正执行用户代码、`awaited.step()` 与
//   `Continuation.resume(...)` 前都必须释放，因此跨线程只允许顺序 handoff。

package scoop.core

import scoop.core.*
import scoop.thread.*
import scoop.unsafe.*

fun <T> __task_claim_acquire(task: Task<T>): Unit {
    // `__atomicIntCompareExchange` / `__atomicIntStore` 当前都固定为 SeqCst；
    // 这里依赖它们在跨线程顺序 handoff 时同时承担“独占 claim”与“状态发布可见性”合同。
    val claimed: Bool = @Unsafe do { __atomicIntCompareExchange(task.__claim, 0, 1) }
    if (claimed) {
        return
    }

    // public `step()` 的并发 / reentrant 误用按 fatal trap 处理，而不是回落为 `Pending`。
    panic("task claim already held")
}

fun <T> __task_claim_release(task: Task<T>): Unit {
    // SeqCst store 同时承担“释放独占 claim”与“发布刚写入的 Waiting/Completed 状态”。
    @Unsafe do { __atomicIntStore(task.__claim, 0) }
}

fun <T> __task_create(block: () -> __TaskStepResult<T>): Task<T> {
    val state: __TaskState<T> = Created(block)
    return Task(0, state)
}

fun <T> __task_step_ready(value: T): __TaskStepResult<T> {
    return Ready(__task_transport_pack<T>(value))
}

fun <T> __task_step_pending(
    awaited: Task<(Int, Any)>,
    continuation: Continuation<(Int, Any), __TaskStepResult<T>>,
): __TaskStepResult<T> {
    return Pending(awaited, continuation)
}

fun <T> __task_from_result(value: T): Task<T> {
    val state: __TaskState<T> = Completed(__task_transport_pack<T>(value))
    return Task(0, state)
}

fun <T> __task_apply_step(task: Task<T>, step: __TaskStepResult<T>): TaskStep<T> {
    __task_claim_acquire(task)
    return when (step) {
        Pending(awaited, continuation) -> {
            val next: __TaskState<T> = Waiting(awaited, continuation)
            task.__state = next
            __task_claim_release(task)
            Pending()
        }
        Ready(value) -> {
            val next: __TaskState<T> = Completed(value)
            task.__state = next
            __task_claim_release(task)
            Ready(__task_transport_unpack<T>(value))
        }
    }
}

fun <T> __task_restore_waiting(
    task: Task<T>,
    awaited: Task<(Int, Any)>,
    continuation: Continuation<(Int, Any), __TaskStepResult<T>>,
): TaskStep<T> {
    __task_claim_acquire(task)
    val next: __TaskState<T> = Waiting(awaited, continuation)
    task.__state = next
    __task_claim_release(task)
    return Pending()
}

fun <T> __task_drive_created(
    task: Task<T>,
    start: () -> __TaskStepResult<T>,
): TaskStep<T> {
    // 进入用户代码前 claim 已释放；single-driver 合同只约束状态发布窗口。
    val step: __TaskStepResult<T> = start()
    return __task_apply_step(task, step)
}

fun <T> __task_drive_waiting(
    task: Task<T>,
    awaited: Task<(Int, Any)>,
    continuation: Continuation<(Int, Any), __TaskStepResult<T>>,
): TaskStep<T> {
    // 这里继续沿用同一规则：awaited.step() 与 continuation.resume(...) 都发生在无 claim 状态下。
    val awaited_step: TaskStep<(Int, Any)> = awaited.step()
    return when (awaited_step) {
        Pending -> __task_restore_waiting(task, awaited, continuation)
        Ready(value) -> {
            val resumed: TaskStep<T> = try {
                val step: __TaskStepResult<T> = continuation.resume(value)
                __task_apply_step(task, step)
            } catch (e: RuntimeError) {
                // 与 legacy task runtime 一致：这里若触发 continuation runtime error，
                // 说明 task 内部 drive/resume 合同被破坏，按 fatal invariant 处理。
                panic("task continuation resume invariant violated")
            }
            resumed
        }
    }
}

fun <T> Task<T>.step(): TaskStep<T> {
    __task_claim_acquire(this)
    return when (this.__state) {
        Running -> {
            // 成功 claim 后若仍观察到 `Running`，说明另一个 driver 正在推进该 task；
            // 这属于 core task single-driver 合同的误用，不能再编码成 `Pending`。
            panic("task.step observed Running while claim held")
        }
        Completed(value) -> {
            __task_claim_release(this)
            Ready(__task_transport_unpack<T>(value))
        }
        Created(start) -> {
            val next: __TaskState<T> = Running()
            this.__state = next
            __task_claim_release(this)
            __task_drive_created(this, start)
        }
        Waiting(awaited, continuation) -> {
            val next: __TaskState<T> = Running()
            this.__state = next
            __task_claim_release(this)
            __task_drive_waiting(this, awaited, continuation)
        }
    }
}

fun <T> __task_join(task: Task<T>): T {
    while (true) {
        when (task.step()) {
            Pending -> yield()
            Ready(value) -> {
                return value
            }
        }
    }
    return panic("task join loop exited unexpectedly")
}
