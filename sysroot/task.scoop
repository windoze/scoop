// Scoop sysroot: task/executor surface（std v3，early stage）
//
// TODO T1319e：
// - 为 `Task<T>` / executor 提供 std 层适配接口（对接 `runtime/c/scoop_task_executor.c`）；
// - 当前阶段只固定最小可执行路径：create/start/complete/onComplete；
// - 语义/性能（work-stealing、多 executor、取消）均留给后续任务扩展。
//
// 设计约定（early stage）：
// - `Executor` / `Task<T>` 当前都落到 runtime 私有的 GC-managed 对象表示；
// - 本模块的 API 面向 std/runtime glue，不承诺稳定 ABI（与 sysroot 其它 runtime-adapter 一致）。

package scoop.task

import scoop.core.*

/// 协作式执行器（opaque object；语义由 std/runtime 约定）。
class Executor

// --- Executor ---

/// 创建一个新的 executor。
fun executorCreate(): Executor

/// 销毁 executor：drain 队列并释放资源（不会执行剩余 job）。
fun Executor.destroy(): Unit

/// 返回当前队列中的 job 数量（用于测试/调试）。
fun Executor.debugPendingCount(): Int

/// 运行一个 job（若存在）。
///
/// 返回值约定：
/// - `true`：执行了一个 job；
/// - `false`：队列为空，没有执行任何 job。
fun Executor.runNext(): Bool

/// 运行直到队列为空或达到 `maxSteps` 步数上限。
///
/// 返回值：实际执行的步数（>=0）。
///
/// 约定：`maxSteps == 0` 表示“不设上限”（由 runtime 解释）。
fun Executor.runUntilIdle(maxSteps: Int): Int

// --- Task<T>（object-model 最小落点，early stage） ---

/// 创建一个带有 body 的 task：start 后会在 executor 中运行 `block` 并完成。
fun <T> taskCreate(block: () -> T): Task<T>

/// 创建一个“无 body”的 task：不能 start，只能由外部显式 `complete`。
fun <T> taskCreateManual(): Task<T>

/// 返回 task 的当前状态（稳定数值见 runtime 约定）。
fun <T> Task<T>.state(): Int

/// 返回 task 的结果（仅在 completed 后有意义）。
fun <T> Task<T>.result(): T

/// 尝试启动 task：把 task body 入队到 executor（若 task 处于 created 且有 body）。
fun <T> Task<T>.tryStart(executor: Executor): Bool

/// 显式完成 task，并把所有 onComplete waiters 入队到对应 executor。
///
/// 说明：重复 complete 会触发运行期 one-shot 断言（exit(3)）。
fun <T> Task<T>.complete(value: T): Bool

/// 注册完成回调：当 task 完成时，把 continuation 入队到 executor，并以 `value` 恢复它。
///
/// 说明：
/// - 若 task 已完成，则立即把 continuation 入队到 executor；
/// - continuation 由 runtime pin/unpin，避免 GC sweep 期间被回收。
fun <T> Task<T>.onComplete(executor: Executor, continuation: Continuation<T>): Bool

// --- Task async adapters（stdlib v4，early stage） ---
//
// 说明（TODO T1320b）：
// - 这些 API 作为“stdlib 适配层”的声明表面，便于 resolver/typecheck 可见；
// - 真实实现由 stdlib 注入的 `stdlib/task.scoop` 提供（pure scoop）；
// - 当前阶段仅提供 `Int` 专用落点，避免泛型/单态化边角影响可执行回归。

/// bridge：创建并尝试 start 一个 task（lazy body 入队到 executor）。
fun Executor.spawn(block: () -> Int): Task<Int>

/// await：驱动 executor 直到 task 完成，并返回结果（v0：`Int` 专用）。
///
/// 失败语义（early stage）：若 executor 无可运行 job 但 task 仍未完成，视为 deadlock 并通过
/// `Raise<RuntimeError>` 终止。
fun Executor.await(task: Task<Int>): Int / Raise<RuntimeError>

/// map：当 task 完成时，应用 mapper 并完成一个新的 task（v0：`Int` 专用）。
fun Task<Int>.map(executor: Executor, mapper: (Int) -> Int): Task<Int>

/// andThen（flatMap）：当 task 完成时，运行 binder 生成下一个 task，并转发其完成结果。
fun Task<Int>.andThen(executor: Executor, binder: (Int) -> Task<Int>): Task<Int>
