// Scoop sysroot: process surface（std v2，early stage）
//
// 说明：
// - 该模块提供标准库 `scoop.process` 的最小可执行表面（T1318c）。
// - 当前阶段只实现“当前进程可观察接口”：
//   - 读取启动参数（argv，不含 argv[0]）
//   - 主动退出并指定退出码
// - 由 LLVM codegen 直接映射到 runtime C 符号（`scoop_process_*`）。

package scoop.process

import scoop.core.*

/// 退出当前进程并返回指定退出码。
///
/// 说明：当前阶段直接映射到 runtime 的 `exit(3)`；不做资源清理/析构语义。
fun exit(code: Int): Unit

/// 返回启动参数数组（不包含 argv[0]）。
///
/// 约定：
/// - 与 Kotlin `fun main(args: Array<String>)` 对齐：`args` 仅包含用户参数，不含程序路径；
/// - 当前阶段返回的 `Array<String>` 由 runtime 在首次调用时构造并缓存（不保证无泄漏）。
fun args(): Array<String>
