// Scoop sysroot: scoop.lang.string cone.

package scoop.lang.string

import scoop.core.*

// These helpers are implemented by this cone's native-build source, not runtime core.
@Extern(name = "scoop_string_from_byte_array", abi = "scoop")
private fun __scoop_lang_string_from_byte_array_unchecked(bytes: MutableArray<Byte>): String

@Unsafe
fun __scoop_string_from_byte_array(bytes: MutableArray<Byte>): String {
    return __scoop_lang_string_from_byte_array_unchecked(bytes)
}

@Extern(name = "scoop_string_from_char_array", abi = "scoop")
fun __scoop_string_from_char_array(chars: MutableArray<Char>): String

@Extern(name = "scoop_string_from_string_array", abi = "scoop")
fun __scoop_string_from_string_array(parts: MutableArray<String>): String

class StringBuilder() {
    private val parts: MutableArray<String> = mutableArrayNew<String>(capacity = 8)

    fun add(s: String): StringBuilder {
        this.parts.push(s)
        return this
    }

    fun toString(): String {
        return __scoop_string_from_string_array(this.parts)
    }
}

// Advanced String helpers live in scoop.lang.string and are exposed by the
// automatic prelude, while their byte-level substrate remains in scoop.core.
fun String.substring(start: Int, end: Int): String {
    val len: Int = this.byteLength()

    var s: Int = start
    if (s < 0) { s = 0 }
    if (s > len) { s = len }

    var e: Int = end
    if (e < s) { e = s }
    if (e > len) { e = len }

    val sliceLen: Int = e - s
    return @Unsafe do { this.unsafeSliceBytes(s, sliceLen) }
}

fun String.indexOf(substr: String): Int {
    val slen: Int = this.byteLength()
    val dlen: Int = substr.byteLength()

    if (dlen <= 0) {
        return 0
    }
    if (dlen > slen) {
        return 0 - 1
    }

    val limit: Int = slen - dlen
    var i: Int = 0
    while (i <= limit) {
        var j: Int = 0
        var matched: Bool = true
        while (j < dlen) {
            if (this.getByte(i + j) != substr.getByte(j)) {
                matched = false
                break
            }
            j = j + 1
        }
        if (matched) {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

fun String.contains(substr: String): Bool {
    return this.indexOf(substr) >= 0
}

fun String.startsWith(prefix: String): Bool {
    val slen: Int = this.byteLength()
    val plen: Int = prefix.byteLength()

    if (plen > slen) {
        return false
    }

    var i: Int = 0
    while (i < plen) {
        if (this.getByte(i) != prefix.getByte(i)) {
            return false
        }
        i = i + 1
    }
    return true
}

fun String.endsWith(suffix: String): Bool {
    val slen: Int = this.byteLength()
    val plen: Int = suffix.byteLength()

    if (plen > slen) {
        return false
    }

    val offset: Int = slen - plen
    var i: Int = 0
    while (i < plen) {
        if (this.getByte(offset + i) != suffix.getByte(i)) {
            return false
        }
        i = i + 1
    }
    return true
}

fun String.split(delimiter: String): Array<String> {
    val slen: Int = this.byteLength()
    val dlen: Int = delimiter.byteLength()

    val parts: MutableArray<String> = mutableArrayNew<String>(capacity = 4)

    if (slen <= 0) {
        val empty: String = @Unsafe do { this.unsafeSliceBytes(0, 0) }
        parts.push(empty)
    } else if (dlen <= 0) {
        parts.push(this)
    } else {
        var start: Int = 0
        var i: Int = 0
        val limit: Int = slen - dlen

        while (i <= limit) {
            var j: Int = 0
            var matched: Bool = true
            while (j < dlen) {
                if (this.getByte(i + j) != delimiter.getByte(j)) {
                    matched = false
                    break
                }
                j = j + 1
            }

            if (matched) {
                val segLen: Int = i - start
                val seg: String = @Unsafe do { this.unsafeSliceBytes(start, segLen) }
                parts.push(seg)
                start = i + dlen
                i = start
            } else {
                i = i + 1
            }
        }

        val tailLen: Int = slen - start
        val tail: String = @Unsafe do { this.unsafeSliceBytes(start, tailLen) }
        parts.push(tail)
    }

    return parts.freeze()
}

fun String.trimStart(): String {
    val len: Int = this.byteLength()
    var start: Int = 0
    while (start < len) {
        val byte: Int = this.getByte(start)
        if (byte == 32) {
            start = start + 1
        } else if (byte >= 9) {
            if (byte <= 13) {
                start = start + 1
            } else {
                break
            }
        } else {
            break
        }
    }

    val sliceLen: Int = len - start
    return @Unsafe do { this.unsafeSliceBytes(start, sliceLen) }
}

fun String.trimEnd(): String {
    val len: Int = this.byteLength()
    var end: Int = len
    while (end > 0) {
        val byte: Int = this.getByte(end - 1)
        if (byte == 32) {
            end = end - 1
        } else if (byte >= 9) {
            if (byte <= 13) {
                end = end - 1
            } else {
                break
            }
        } else {
            break
        }
    }

    return @Unsafe do { this.unsafeSliceBytes(0, end) }
}

fun String.trim(): String {
    return this.trimStart().trimEnd()
}
