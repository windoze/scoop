package scoop.io.encoding

import scoop.io.encoding.Base64.PaddingOption
import scoop.bytes.ByteArrayBuilder

private fun base64Digit(character: Char, urlSafe: Boolean): UInt? {
    val code = character.code
    if (code >= 65 && code <= 90) return Some((code - 65).toUInt())
    if (code >= 97 && code <= 122) return Some((code - 97 + 26).toUInt())
    if (code >= 48 && code <= 57) return Some((code - 48 + 52).toUInt())
    if (character == (if (urlSafe) '-' else '+')) return Some(62u)
    if (character == (if (urlSafe) '_' else '/')) return Some(63u)
    return None
}

internal fun decodeBase64(source: String, urlSafe: Boolean, padding: PaddingOption): Array<Byte>? {
    val output = ByteArrayBuilder()
    var buffer = 0u
    var symbols = 0
    var pads = 0
    for (character in source) {
        if (character == '=') {
            if (padding == PaddingOption.ABSENT || pads == 2) return None
            pads += 1
        } else {
            if (pads != 0) return None
            val digit = when (base64Digit(character, urlSafe)) {
                case None -> return None
                case Some(value) -> value
            }
            buffer = (buffer shl 6L) or digit
            symbols += 1
            if (symbols == 4) {
                output.append((buffer shr 16L).toByte())
                output.append((buffer shr 8L).toByte())
                output.append(buffer.toByte())
                buffer = 0u
                symbols = 0
            }
        }
    }
    if (symbols == 1) return None
    val expectedPads = if (symbols == 0) 0 else 4 - symbols
    if (pads != 0 && pads != expectedPads) return None
    if (pads == 0 && expectedPads != 0 && padding == PaddingOption.REQUIRED) return None
    if (symbols == 2) {
        if ((buffer and 15u) != 0u) return None
        output.append((buffer shr 4L).toByte())
    } else if (symbols == 3) {
        if ((buffer and 3u) != 0u) return None
        output.append((buffer shr 10L).toByte())
        output.append((buffer shr 2L).toByte())
    }
    return Some(output.toByteArray())
}
