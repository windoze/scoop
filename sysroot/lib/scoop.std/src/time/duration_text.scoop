package scoop.time

import scoop.text.padStart

internal fun formatDuration(parts: DurationParts): String {
    val negative = parts.negative && (parts.seconds != 0uL || parts.nanos != 0)
    val prefix = if (negative) "-PT" else "PT"
    if (parts.nanos == 0) return prefix + parts.seconds.toString() + "S"
    var fraction = parts.nanos
    var width = 9L
    while (fraction % 10 == 0) { fraction /= 10; width -= 1L }
    return prefix + parts.seconds.toString() + "." + fraction.toString().padStart(width, '0') + "S"
}

internal fun parseDuration(text: String): Duration? {
    val chars = text.toCharArray()
    if (chars.size == 0L) return None
    val negative = chars[0L] == '-'
    var index = if (negative) 1L else 0L
    if (index >= chars.size || chars[index] != 'P') return None
    index += 1L
    val limit = if (negative) 0x8000000000000000uL else 0x7fffffffffffffffuL
    var seconds = 0uL
    var nanos = 0
    var time = false
    var last = -1
    while (index < chars.size) {
        if (chars[index] == 'T') {
            if (time) return None
            time = true
            index += 1L
            if (index == chars.size) return None
            continue
        }
        val start = index
        var amount = 0uL
        while (index < chars.size && chars[index] >= '0' && chars[index] <= '9') {
            val digit = (chars[index].code - '0'.code).toULong()
            if (amount > (limit - digit) / 10uL) return None
            amount = amount * 10uL + digit
            index += 1L
        }
        if (index == start || index == chars.size) return None
        val fractional = chars[index] == '.'
        if (fractional) {
            index += 1L
            val fractionStart = index
            while (index < chars.size && chars[index] >= '0' && chars[index] <= '9') {
                if (index - fractionStart == 9L) return None
                nanos = nanos * 10 + chars[index].code - '0'.code
                index += 1L
            }
            if (index == fractionStart || index == chars.size) return None
            var digits = index - fractionStart
            while (digits < 9L) { nanos *= 10; digits += 1L }
        }
        val unit = chars[index]
        val rank = if (unit == 'D' && !time) 0 else if (unit == 'H' && time) 1
            else if (unit == 'M' && time) 2 else if (unit == 'S' && time) 3 else -1
        if (rank <= last || (fractional && rank != 3)) return None
        val scale = if (rank == 0) 86400uL else if (rank == 1) 3600uL else if (rank == 2) 60uL else 1uL
        if (amount > (limit - seconds) / scale) return None
        seconds += amount * scale
        last = rank
        index += 1L
    }
    if (last < 0 || (seconds == 0x8000000000000000uL && nanos != 0)) return None
    return Some(Duration.fromParts(DurationParts(negative, seconds, nanos)))
}
