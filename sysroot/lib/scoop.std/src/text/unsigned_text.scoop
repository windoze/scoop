package scoop.text

import scoop.map

public fun String.toUInt8OrNull(radix: Int = 10): UInt8? =
    parseUnsignedInteger(this, radix, UInt8.MAX_VALUE.toUInt64()).map<ULong, UInt8> { value -> value.toUInt8() }

public fun String.toUInt8(radix: Int = 10): UInt8 = requireParsedNumber<UInt8>(toUInt8OrNull(radix))

public fun String.toUInt16OrNull(radix: Int = 10): UInt16? =
    parseUnsignedInteger(this, radix, UInt16.MAX_VALUE.toUInt64()).map<ULong, UInt16> { value -> value.toUInt16() }

public fun String.toUInt16(radix: Int = 10): UInt16 = requireParsedNumber<UInt16>(toUInt16OrNull(radix))

public fun String.toUIntOrNull(radix: Int = 10): UInt? =
    parseUnsignedInteger(this, radix, UInt.MAX_VALUE.toUInt64()).map<ULong, UInt> { value -> value.toUInt32() }

public fun String.toUInt(radix: Int = 10): UInt = requireParsedNumber<UInt>(toUIntOrNull(radix))

public fun String.toULongOrNull(radix: Int = 10): ULong? =
    parseUnsignedInteger(this, radix, ULong.MAX_VALUE.toUInt64()).map<ULong, ULong> { value -> value.toUInt64() }

public fun String.toULong(radix: Int = 10): ULong = requireParsedNumber<ULong>(toULongOrNull(radix))
