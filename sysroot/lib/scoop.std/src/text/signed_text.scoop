package scoop.text

import scoop.map

public fun String.toByteOrNull(radix: Int = 10): Byte? =
    parseSignedInteger(this, radix, Int8.MAX_VALUE.toULong()).map<Long, Int8> { value -> value.toByte() }

public fun String.toByte(radix: Int = 10): Byte = requireParsedNumber<Int8>(toByteOrNull(radix))

public fun String.toShortOrNull(radix: Int = 10): Short? =
    parseSignedInteger(this, radix, Int16.MAX_VALUE.toULong()).map<Long, Int16> { value -> value.toShort() }

public fun String.toShort(radix: Int = 10): Short = requireParsedNumber<Int16>(toShortOrNull(radix))

public fun String.toIntOrNull(radix: Int = 10): Int? =
    parseSignedInteger(this, radix, Int.MAX_VALUE.toULong()).map<Long, Int> { value -> value.toInt() }

public fun String.toInt(radix: Int = 10): Int = requireParsedNumber<Int>(toIntOrNull(radix))

public fun String.toLongOrNull(radix: Int = 10): Long? =
    parseSignedInteger(this, radix, Long.MAX_VALUE.toULong()).map<Long, Long> { value -> value.toLong() }

public fun String.toLong(radix: Int = 10): Long = requireParsedNumber<Long>(toLongOrNull(radix))
