package scoop.bytes

public class ByteArrayReader public constructor(input: List<Byte>) {
    private val bytes: Array<Byte> = Array<Byte>(input.size) { index -> input[index] }
    private var cursor: Long = 0L
    public val size: Long get() = bytes.size
    public val position: Long get() = cursor
    public val remaining: Long get() = bytes.size - cursor

    private fun requireAvailable(count: Long) {
        if (count < 0L) throw IllegalArgumentException(Some("negative byte count"))
        if (count > remaining) throw IndexOutOfBoundsException()
    }

    public fun seek(position: Long) {
        if (position < 0L || position > bytes.size) throw IndexOutOfBoundsException()
        cursor = position
    }

    public fun skip(count: Long) {
        requireAvailable(count)
        cursor += count
    }

    public fun readBytes(count: Long): Array<Byte> {
        requireAvailable(count)
        val start = cursor
        val result = Array<Byte>(count) { index -> bytes[start + index] }
        cursor += count
        return result
    }

    private fun read(width: Long, order: ByteOrder): ULong {
        requireAvailable(width)
        var result = 0uL
        var index = 0L
        while (index < width) {
            val offset = if (order == ByteOrder.BigEndian) index else width - index - 1L
            result = (result shl 8L) or bytes[cursor + offset].toUByte().toULong()
            index += 1L
        }
        cursor += width
        return result
    }

    public fun readInt8(): Int8 = read(1L, ByteOrder.BigEndian).toByte()
    public fun readUInt8(): UInt8 = read(1L, ByteOrder.BigEndian).toUByte()
    public fun readInt16(order: ByteOrder): Int16 = read(2L, order).toShort()
    public fun readUInt16(order: ByteOrder): UInt16 = read(2L, order).toUShort()
    public fun readInt32(order: ByteOrder): Int32 = read(4L, order).toInt()
    public fun readUInt32(order: ByteOrder): UInt32 = read(4L, order).toUInt()
    public fun readInt64(order: ByteOrder): Int64 = read(8L, order).toLong()
    public fun readUInt64(order: ByteOrder): UInt64 = read(8L, order)
    public fun readFloat(order: ByteOrder): Float = Float.fromBits(readInt32(order))
    public fun readDouble(order: ByteOrder): Double = Double.fromBits(readInt64(order))
}
