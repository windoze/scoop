package scoop.collections

internal fun <T> requireCollectionElement(value: T?): T = when (value) {
    case Some(element) -> element
    case None -> throw NoSuchElementException("no matching element")
}

public fun <T> Iterable<T>.firstOrNone(): T? = iterator().next()
public fun <T> Iterable<T>.first(): T = requireCollectionElement<T>(firstOrNone<T>())

public fun <T> Iterable<T>.firstOrNone(predicate: (T) -> Boolean): T? {
    for (element in this) { if (predicate(element)) return Some(element) }
    return None
}

public fun <T> Iterable<T>.first(predicate: (T) -> Boolean): T =
    requireCollectionElement<T>(firstOrNone<T>(predicate))

public fun <T> Iterable<T>.find(predicate: (T) -> Boolean): T? = firstOrNone<T>(predicate)

public fun <T> Iterable<T>.lastOrNone(predicate: (T) -> Boolean): T? {
    var result: T? = None
    for (element in this) { if (predicate(element)) result = Some(element) }
    return result
}

public fun <T> Iterable<T>.lastOrNone(): T? = lastOrNone<T> { _ -> true }
public fun <T> Iterable<T>.last(): T = requireCollectionElement<T>(lastOrNone<T>())
public fun <T> Iterable<T>.last(predicate: (T) -> Boolean): T =
    requireCollectionElement<T>(lastOrNone<T>(predicate))

private fun <T> Iterable<T>.singleResult(predicate: (T) -> Boolean, rejectMany: Boolean): T? {
    var result: T? = None
    var found = false
    for (element in this) {
        if (predicate(element)) {
            if (found) {
                if (rejectMany) throw IllegalArgumentException(Some("multiple matching elements"))
                return None
            }
            found = true
            result = Some(element)
        }
    }
    return result
}

public fun <T> Iterable<T>.singleOrNone(predicate: (T) -> Boolean): T? = singleResult<T>(predicate, false)
public fun <T> Iterable<T>.singleOrNone(): T? = singleOrNone<T> { _ -> true }
public fun <T> Iterable<T>.single(predicate: (T) -> Boolean): T =
    requireCollectionElement<T>(singleResult<T>(predicate, true))
public fun <T> Iterable<T>.single(): T = single<T> { _ -> true }

public fun <T> Iterable<T>.elementAtOrNone(index: Long): T? {
    if (index < 0L) return None
    var remaining = index
    for (element in this) {
        if (remaining == 0L) return Some(element)
        remaining -= 1L
    }
    return None
}

public fun <T> Iterable<T>.elementAt(index: Long): T = when (elementAtOrNone<T>(index)) {
    case Some(element) -> element
    case None -> throw IndexOutOfBoundsException()
}

public fun <T : Equals<T>> Iterable<T>.indexOf(element: T): Long {
    var index = 0L
    for (value in this) {
        if (value == element) return index
        index = nextCollectionCount(index)
    }
    return -1L
}

public operator fun <T : Equals<T>> Iterable<T>.contains(element: T): Boolean {
    for (value in this) { if (value == element) return true }
    return false
}
