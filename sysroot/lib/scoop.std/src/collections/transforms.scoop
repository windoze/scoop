package scoop.collections

public fun <T, R> Iterable<T>.map(transform: (T) -> R): List<R> {
    val result = ArrayList<R>()
    for (element in this) result.add(transform(element))
    return ListSnapshot<R>(result.toArray())
}

public fun <T, R> Iterable<T>.mapIndexed(transform: (Long, T) -> R): List<R> {
    val result = ArrayList<R>()
    var index = 0L
    for (element in this) {
        result.add(transform(index, element))
        index = nextCollectionCount(index)
    }
    return ListSnapshot<R>(result.toArray())
}

public fun <T, R> Iterable<T>.mapNotNone(transform: (T) -> R?): List<R> {
    val result = ArrayList<R>()
    for (element in this) {
        when (transform(element)) {
            case Some(value) -> result.add(value)
            case None -> continue
        }
    }
    return ListSnapshot<R>(result.toArray())
}

public fun <T> Iterable<T>.filter(predicate: (T) -> Boolean): List<T> {
    val result = ArrayList<T>()
    for (element in this) { if (predicate(element)) result.add(element) }
    return ListSnapshot<T>(result.toArray())
}

public fun <T> Iterable<T>.filterNot(predicate: (T) -> Boolean): List<T> =
    filter<T> { element -> !predicate(element) }

public fun <T> Iterable<T?>.filterNotNone(): List<T> = mapNotNone<T?, T> { element -> element }

public fun <T, R> Iterable<T>.flatMap(transform: (T) -> Iterable<R>): List<R> {
    val result = ArrayList<R>()
    for (element in this) {
        for (value in transform(element)) result.add(value)
    }
    return ListSnapshot<R>(result.toArray())
}

public fun <T> Iterable<Iterable<T>>.flatten(): List<T> = flatMap<Iterable<T>, T> { element -> element }

public fun <T> Iterable<T>.partition(predicate: (T) -> Boolean): (List<T>, List<T>) {
    val matches = ArrayList<T>()
    val others = ArrayList<T>()
    for (element in this) {
        if (predicate(element)) matches.add(element) else others.add(element)
    }
    val yes: List<T> = ListSnapshot<T>(matches.toArray())
    val no: List<T> = ListSnapshot<T>(others.toArray())
    return (yes, no)
}
