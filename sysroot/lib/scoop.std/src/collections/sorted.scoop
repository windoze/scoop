package scoop.collections

import scoop.comparisons.Comparator

public interface SortedMap<K, V> : Map<K, V> {
    public val comparator: Comparator<K>
    public fun firstEntryOrNull(): Map.Entry<K, V>?
    public fun lastEntryOrNull(): Map.Entry<K, V>?
    public fun lowerEntry(key: K): Map.Entry<K, V>?
    public fun floorEntry(key: K): Map.Entry<K, V>?
    public fun ceilingEntry(key: K): Map.Entry<K, V>?
    public fun higherEntry(key: K): Map.Entry<K, V>?
}

public interface MutableSortedMap<K, V> : SortedMap<K, V>, MutableMap<K, V> {}

public interface SortedSet<T> : Set<T> {
    public val comparator: Comparator<T>
    public fun firstOrNull(): T?
    public fun lastOrNull(): T?
    public fun lower(element: T): T?
    public fun floor(element: T): T?
    public fun ceiling(element: T): T?
    public fun higher(element: T): T?
}

public interface MutableSortedSet<T> : SortedSet<T>, MutableSet<T> {}
