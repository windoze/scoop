package scoop.platform.system

public enum PlatformErrorKind {
    NotFound, AlreadyExists, PermissionDenied, NotDirectory, IsDirectory,
    InvalidInput, NoMemory, NoSpace, BrokenPipe, ConnectionRefused, ConnectionReset,
    AddressInUse, AddressUnavailable, TimedOut, Interrupted, WouldBlock, Unsupported, Other
}

public enum NativeErrorDomain { PosixErrno, AddressResolution }

public struct NativeError(val domain: NativeErrorDomain, val code: Int, val systemCode: Int? = None) {
    public val kind: PlatformErrorKind get() {
        @Unsafe {
            val category = nativeErrorKind(if (domain == NativeErrorDomain.PosixErrno) 0 else 1,
                code, systemCode ?: 0)
            return errorKind(category)
        }
    }
}

public class PlatformException public constructor(
    public val operation: String,
    public val kind: PlatformErrorKind,
    public val nativeError: NativeError? = None,
    public val context: OsString? = None
) : Exception(Some(platformErrorMessage(operation, nativeError, context)))

private fun platformErrorMessage(operation: String, error: NativeError?, context: OsString?): String {
    var message = operation + " failed"
    if (error != None) message += " (native code " + error!!.code.toString() + ")"
    if (context != None) message += ": " + context!!.display()
    return message
}

private fun errorKind(category: Int): PlatformErrorKind = when (category) {
    case 1 -> PlatformErrorKind.NotFound
    case 2 -> PlatformErrorKind.AlreadyExists
    case 3 -> PlatformErrorKind.PermissionDenied
    case 4 -> PlatformErrorKind.NotDirectory
    case 5 -> PlatformErrorKind.IsDirectory
    case 6 -> PlatformErrorKind.InvalidInput
    case 7 -> PlatformErrorKind.NoMemory
    case 8 -> PlatformErrorKind.NoSpace
    case 9 -> PlatformErrorKind.BrokenPipe
    case 10 -> PlatformErrorKind.ConnectionRefused
    case 11 -> PlatformErrorKind.ConnectionReset
    case 12 -> PlatformErrorKind.AddressInUse
    case 13 -> PlatformErrorKind.AddressUnavailable
    case 14 -> PlatformErrorKind.TimedOut
    case 15 -> PlatformErrorKind.Interrupted
    case 16 -> PlatformErrorKind.WouldBlock
    case 17 -> PlatformErrorKind.Unsupported
    else -> PlatformErrorKind.Other
}

@GCLeaf
@Extern(name = "scoop_platform_error_kind")
private fun nativeErrorKind(domain: Int, code: Int, systemCode: Int): Int
