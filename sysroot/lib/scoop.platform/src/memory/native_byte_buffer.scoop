package scoop.platform.memory

import scoop.bytes.ByteOrder
import scoop.platform.system.*

public class NativeByteBuffer private constructor() : Closeable {
    private var memory: Ptr<Byte>? = None
    private var storageCapacity: Long = 0L
    private var reader: Long = 0L
    private var writer: Long = 0L
    private var closed: Boolean = false
    private var borrowed: Boolean = false
    private val stateLock: AtomicBoolean = AtomicBoolean(false)

    public val capacity: Long get() = withState { requireOpen(); storageCapacity }
    public val readPosition: Long get() = withState { requireOpen(); reader }
    public val writePosition: Long get() = withState { requireOpen(); writer }
    public val readableBytes: Long get() = withState { requireOpen(); writer - reader }
    public val writableBytes: Long get() = withState { requireOpen(); storageCapacity - writer }
    public val isClosed: Boolean get() = withState { closed }

    public companion object {
        public fun allocate(capacity: Long = 0L): NativeByteBuffer {
            requireCount(capacity)
            val result = NativeByteBuffer()
            if (capacity > 0L) result.ensureWritable(capacity)
            return result
        }
    }

    private fun <T> withState(block: () -> T): T {
        while (!stateLock.compareAndSet(false, true, MemoryOrder.Acquire, MemoryOrder.Relaxed)) {}
        try { return block() }
        finally { stateLock.store(false, MemoryOrder.Release) }
    }

    private fun requireOpen() {
        if (closed) throw IllegalStateException(Some("buffer is closed"))
    }

    private fun requireMutable() {
        requireOpen()
        if (borrowed) throw IllegalStateException(Some("buffer is borrowed"))
    }

    private fun requireReadable(count: Long) {
        requireMutable()
        requireCount(count)
        if (count > writer - reader) throw IndexOutOfBoundsException()
    }

    private fun requireWritable(count: Long) {
        requireMutable()
        requireCount(count)
        if (count > storageCapacity - writer) throw IndexOutOfBoundsException()
    }

    private fun requireIndex(index: Long) {
        requireOpen()
        if (index < 0L || index >= writer) throw IndexOutOfBoundsException()
    }

    private fun resize(capacity: Long) {
        @Unsafe {
            val (next, error) = nativeMemoryResize(memory, capacity)
            if (next == None) {
                throw PlatformException("allocate native buffer", PlatformErrorKind.NoMemory,
                    Some(NativeError(NativeErrorDomain.PosixErrno, error)))
            }
            val delta = capacity - storageCapacity
            memory = next
            storageCapacity = capacity
            gcAdjustPressure(delta)
        }
    }

    public fun ensureWritable(count: Long) {
        withState {
            requireMutable()
            requireCount(count)
            if (count <= storageCapacity - writer) return@withState
            if (count > Long.MAX_VALUE - writer) throw ArithmeticException()
            val needed = writer + count
            val grown = if (storageCapacity <= Long.MAX_VALUE / 2L) storageCapacity * 2L else Long.MAX_VALUE
            resize(if (grown > needed) grown else needed)
        }
    }

    public fun clear() {
        withState {
            requireMutable()
            reader = 0L
            writer = 0L
        }
    }

    public fun compact() {
        withState {
            requireMutable()
            val count = writer - reader
            if (count > 0L && reader > 0L) {
                @Unsafe { nativeMemoryMove(memory!!, memory!! + reader, count) }
            }
            reader = 0L
            writer = count
        }
    }

    public fun skip(count: Long) {
        withState {
            requireReadable(count)
            reader += count
        }
    }

    public fun getByte(index: Long): Byte {
        return withState {
            requireIndex(index)
            @Unsafe { return@withState memory!!.load(index) }
        }
    }

    public fun setByte(index: Long, value: Byte) {
        withState {
            requireMutable()
            requireIndex(index)
            @Unsafe { memory!!.store(index, value) }
        }
    }

    public fun readByte(): Byte = readInt8()
    public fun writeByte(value: Byte) { writeInt8(value) }

    public fun readBytes(count: Long): Array<Byte> {
        return withState {
            requireReadable(count)
            val start = reader
            val result = Array<Byte>(count) { index -> @Unsafe { return@Array memory!!.load(start + index) } }
            reader += count
            return@withState result
        }
    }

    public fun readInto(array: MutableArray<Byte>, offset: Long = 0L, count: Long = array.size - offset) {
        withState {
            requireReadable(count)
            requireArrayRange(array.size, offset, count)
            if (count > 0L) {
                @Unsafe {
                    array.withDataPointer { pointer, _ -> @Unsafe { nativeMemoryMove(pointer + offset, memory!! + reader, count) } }
                }
            }
            reader += count
        }
    }

    public fun writeBytes(array: List<Byte>, offset: Long = 0L, count: Long = array.size - offset) {
        requireArrayRange(array.size, offset, count)
        @Unsafe {
            withWritableBytes { destination, available ->
                if (count > available) throw IndexOutOfBoundsException()
                if (count > 0L) {
                    val snapshot = Array<Byte>(count) { index -> array[offset + index] }
                    @Unsafe {
                        snapshot.withDataPointer { pointer, _ -> @Unsafe { nativeMemoryMove(destination!!, pointer, count) } }
                    }
                }
                count
            }
        }
    }

    private fun read(width: Long, order: ByteOrder): ULong {
        return withState {
            requireReadable(width)
            var value = 0uL
            var index = 0L
            @Unsafe {
                while (index < width) {
                    val offset = if (order == ByteOrder.BIG_ENDIAN) index else width - index - 1L
                    value = (value shl 8L) or memory!!.load(reader + offset).toUInt8().toUInt64()
                    index += 1L
                }
            }
            reader += width
            return@withState value
        }
    }

    private fun write(value: ULong, width: Long, order: ByteOrder) {
        withState {
            requireWritable(width)
            var index = 0L
            @Unsafe {
                while (index < width) {
                    val shift = (if (order == ByteOrder.BIG_ENDIAN) width - index - 1L else index) * 8L
                    memory!!.store(writer + index, (value shr shift).toInt8())
                    index += 1L
                }
            }
            writer += width
        }
    }

    public fun readInt8(): Int8 = read(1L, ByteOrder.BIG_ENDIAN).toInt8()
    public fun readUInt8(): UInt8 = read(1L, ByteOrder.BIG_ENDIAN).toUInt8()
    public fun readInt16(order: ByteOrder): Int16 = read(2L, order).toInt16()
    public fun readUInt16(order: ByteOrder): UInt16 = read(2L, order).toUInt16()
    public fun readInt(order: ByteOrder): Int = read(4L, order).toInt32()
    public fun readUInt(order: ByteOrder): UInt = read(4L, order).toUInt32()
    public fun readLong(order: ByteOrder): Long = read(8L, order).toInt64()
    public fun readULong(order: ByteOrder): ULong = read(8L, order)
    public fun readFloat(order: ByteOrder): Float = Float.fromBits(readInt(order))
    public fun readDouble(order: ByteOrder): Double = Double.fromBits(readLong(order))

    public fun writeInt8(value: Int8) { write(value.toUInt64(), 1L, ByteOrder.BIG_ENDIAN) }
    public fun writeUInt8(value: UInt8) { write(value.toUInt64(), 1L, ByteOrder.BIG_ENDIAN) }
    public fun writeInt16(value: Int16, order: ByteOrder) { write(value.toUInt64(), 2L, order) }
    public fun writeUInt16(value: UInt16, order: ByteOrder) { write(value.toUInt64(), 2L, order) }
    public fun writeInt(value: Int, order: ByteOrder) { write(value.toUInt64(), 4L, order) }
    public fun writeUInt(value: UInt, order: ByteOrder) { write(value.toUInt64(), 4L, order) }
    public fun writeLong(value: Long, order: ByteOrder) { write(value.toUInt64(), 8L, order) }
    public fun writeULong(value: ULong, order: ByteOrder) { write(value, 8L, order) }
    public fun writeFloat(value: Float, order: ByteOrder) { writeInt(value.toBits(), order) }
    public fun writeDouble(value: Double, order: ByteOrder) { writeLong(value.toBits(), order) }

    @Unsafe
    public fun <R> withReadableBytes(block: (Ptr<Byte>?, Long) -> R): R {
        val borrow = beginBorrow(None, false)
        try { return block(borrow.pointer(), borrow.length) }
        finally { borrow.complete(0L) }
    }

    @Unsafe
    public fun withWritableBytes(block: (Ptr<Byte>?, Long) -> Long): Long {
        val borrow = beginBorrow(None, true)
        val count = try { block(borrow.pointer(), borrow.length) }
        catch (error: Throwable) { borrow.complete(0L); throw error }
        borrow.complete(count)
        return count
    }

    @Unsafe
    public fun borrowReadable(count: Long): NativeByteBorrow = beginBorrow(Some(count), false)

    @Unsafe
    public fun borrowWritable(count: Long): NativeByteBorrow = beginBorrow(Some(count), true)

    private fun beginBorrow(count: Long?, writable: Boolean): NativeByteBorrow = withState {
        requireMutable()
        val available = if (writable) storageCapacity - writer else writer - reader
        val length = count ?: available
        requireCount(length)
        if (length > available) throw IndexOutOfBoundsException()
        val offset = if (writable) writer else reader
        @Unsafe {
            val pointer: Ptr<Byte>? = if (length == 0L) None else Some(memory!! + offset)
            val borrow = NativeByteBorrow(this, pointer, length, writable)
            borrowed = true
            return@withState borrow
        }
    }

    internal fun finishBorrow(count: Long, length: Long, writable: Boolean) {
        withState {
            borrowed = false
            if (count < 0L || count > length) throw IllegalArgumentException(Some("invalid borrowed byte count"))
            if (writable) writer += count else reader += count
        }
    }

    public override fun close() {
        withState {
            if (closed) return@withState
            requireMutable()
            val owned = memory
            val capacity = storageCapacity
            memory = None
            storageCapacity = 0L
            reader = 0L
            writer = 0L
            closed = true
            when (owned) {
                case Some(pointer) -> @Unsafe { nativeMemoryFree(pointer); gcAdjustPressure(-capacity) }
                case None -> {}
            }
        }
    }


    release {
        when (memory) {
            case Some(pointer) -> @Unsafe { nativeMemoryFree(pointer); gcAdjustPressure(-storageCapacity) }
            case None -> {}
        }
    }
}

private fun requireCount(count: Long) {
    if (count < 0L) throw IllegalArgumentException(Some("negative byte count"))
}

private fun requireArrayRange(size: Long, offset: Long, count: Long) {
    if (offset < 0L || offset > size || count > size - offset) throw IndexOutOfBoundsException()
}
