package scoop.platform.process

import scoop.bytes.ByteArrayBuilder
import scoop.platform.fs.File
import scoop.platform.io.*
import scoop.platform.memory.NativeByteBuffer
import scoop.platform.system.*

internal class ProcessPipes internal constructor(input: PipeSink?, output: PipeSource?, error: PipeSource?) : Closeable {
    private val files: Array<File?> = [input?.file, output?.file, error?.file]
    private val open: MutableArray<Boolean> = MutableArray<Boolean>(3L) { false }

    init {
        for (index in 0L..<3L) open[index] = !(files[index]?.isClosed ?: true)
    }

    internal fun transfer(input: Array<Byte>?): (Array<Byte>, Array<Byte>) = use {
        val bytes = input ?: Array<Byte>(0L) { 0.toInt8() }
        val output = ByteArrayBuilder()
        val error = ByteArrayBuilder()
        for (index in 0L..<3L) {
            if (open[index]) {
                files[index]!!.withDescriptor { fd ->
                    @Unsafe {
                        val (status, code) = nativeNonblocking(fd)
                        checkNativeStatus(status, code, "configure process pipe")
                    }
                }
            }
        }
        if (bytes.size == 0L) close(0L)
        NativeByteBuffer.allocate(8192L).use { buffer ->
            var written = 0L
            while (open[0L] || open[1L] || open[2L]) {
                val ready = poll()
                if ((ready and 1) != 0) {
                    written += writeInput(bytes, written)
                    if (written == bytes.size) close(0L)
                }
                if ((ready and 2) != 0) readOutput(1L, output, buffer)
                if ((ready and 4) != 0) readOutput(2L, error, buffer)
            }
        }
        (output.toByteArray(), error.toByteArray())
    }

    private fun poll(): Int = withDescriptor(0L) inputScope@ { input ->
        withDescriptor(1L) outputScope@ { output ->
            withDescriptor(2L) errorScope@ { error ->
                @Unsafe {
                    val (ready, code) = nativePoll(input, output, error)
                    checkNativeStatus(ready, code, "poll process pipes")
                    return@errorScope ready
                }
            }
        }
    }

    private fun <R> withDescriptor(index: Long, block: (Int) -> R): R =
        if (open[index]) files[index]!!.withDescriptor(block) else block(-1)

    private fun writeInput(bytes: Array<Byte>, offset: Long): Long {
        try { return files[0L]!!.writeFrom(bytes, offset) }
        catch (error: PlatformException) {
            if (error.kind == PlatformErrorKind.WouldBlock) return 0L
            throw error
        }
    }

    private fun readOutput(index: Long, builder: ByteArrayBuilder, buffer: NativeByteBuffer) {
        buffer.clear()
        val received = try { files[index]!!.readInto(buffer) }
        catch (error: PlatformException) {
            if (error.kind == PlatformErrorKind.WouldBlock) return
            throw error
        }
        if (received == 0L) close(index)
        else builder.append(buffer.readBytes(received))
    }

    private fun close(index: Long) {
        if (!open[index]) return
        open[index] = false
        files[index]!!.close()
    }

    public override fun close() {
        var failure: Throwable? = None
        for (index in 0L..<3L) {
            try { close(index) }
            catch (error: Throwable) { failure = Some(combineProcessFailure(failure, error)) }
        }
        when (failure) { case Some(error) -> throw error; case None -> {} }
    }
}

@Extern(name = "scoop_platform_pipe_nonblocking", captureErrno = true)
private fun nativeNonblocking(descriptor: Int): (Int, Int)
@Extern(name = "scoop_platform_process_poll", captureErrno = true)
private fun nativePoll(input: Int, output: Int, error: Int): (Int, Int)
