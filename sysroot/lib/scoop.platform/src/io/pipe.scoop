package scoop.platform.io

import scoop.platform.fs.File
import scoop.platform.memory.NativeByteBuffer

public class PipeSource internal constructor(internal val file: File) : ByteSource, Disposable {
    public val isDisposed: Boolean get() = file.isDisposed
    public override fun readInto(buffer: NativeByteBuffer, count: Long): Long = file.readInto(buffer, count)
    public override fun dispose() { file.dispose() }
    public fun close() { dispose() }
    internal fun borrowed(): ByteSource = BorrowedSource(file)
}

public class PipeSink internal constructor(internal val file: File) : ByteSink, Disposable {
    public val isDisposed: Boolean get() = file.isDisposed
    public override fun writeFrom(buffer: NativeByteBuffer, count: Long): Long = file.writeFrom(buffer, count)
    public override fun flush() { file.flush() }
    public override fun dispose() { file.dispose() }
    public fun close() { dispose() }
    internal fun borrowed(): ByteSink = BorrowedSink(file)
}

private class BorrowedSource(private val file: File) : ByteSource {
    public override fun readInto(buffer: NativeByteBuffer, count: Long): Long = file.readInto(buffer, count)
}
private class BorrowedSink(private val file: File) : ByteSink {
    public override fun writeFrom(buffer: NativeByteBuffer, count: Long): Long = file.writeFrom(buffer, count)
    public override fun flush() { file.flush() }
}

public class Pipe private constructor(public val source: PipeSource, public val sink: PipeSink) {
    public companion object {
        public fun open(): Pipe {
            val pipe = Pipe(PipeSource(File.newOwner()), PipeSink(File.newOwner()))
            val descriptors = MutableArray<Int>(2L) { -1 }
            @Unsafe {
                descriptors.withDataPointer { pointer, _ ->
                    @Unsafe {
                        val (status, error) = nativePipe(pointer)
                        checkNativeStatus(status, error, "create pipe")
                    }
                }
            }
            pipe.source.file.adoptDescriptor(descriptors[0L])
            pipe.sink.file.adoptDescriptor(descriptors[1L])
            return pipe
        }
    }
}

@Extern(name = "scoop_platform_pipe_open", captureErrno = true)
private fun nativePipe(descriptors: Ptr<Int>): (Int, Int)
