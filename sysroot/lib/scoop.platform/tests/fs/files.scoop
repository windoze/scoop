package scoop.platform.fs

import scoop.platform.io.*
import scoop.platform.memory.NativeByteBuffer
import scoop.platform.system.*
import scoop.test.*

@Test
private class FilesTest {
    @Test
    fun `files support byte transfers seek truncate append and metadata`() {
        TestDirectory().use { tree ->
            val path = tree.child("data")
            File.open(path, OpenOptions(write = true, createNew = true, mode = 0x180)).use { file ->
                file.writeAllBytes(Array<Byte>(6L) { (it + 1L).toByte() })
                assertEquals(6L, file.position)
                assertEquals(6L, file.size)
                file.seek(1L)
                val bytes = MutableArray<Byte>(4L) { 0.toByte() }
                assertEquals(2L, file.readInto(bytes, 1L, 2L))
                assertEquals(2.toByte(), bytes[1L])
                assertEquals(3.toByte(), bytes[2L])
                assertEquals(3L, file.position)
                file.truncate(2L)
                assertEquals(3L, file.position)
                assertEquals(2L, file.size)
                file.syncData()
                file.syncAll()
                file.flush()
                val metadata = file.metadata()
                assertTrue(metadata.kind == FileKind.Regular)
                assertEquals(0, metadata.permissions and 0x3f)
                assertTrue(metadata.modifiedAt.nanosecondsOfSecond >= 0)
            }
            File.open(path, OpenOptions(read = false, write = true, append = true)).use { file ->
                file.seek(0L)
                assertEquals(1L, file.writeFrom(Array<Byte>(1L) { 9.toByte() }))
            }
            val result = Files.readAllBytes(path)
            assertEquals(3L, result.size)
            assertEquals(1.toByte(), result[0L])
            assertEquals(9.toByte(), result[2L])
        }
    }

    @Test
    fun `duplicates share file position and close independently`() {
        TestDirectory().use { tree ->
            val path = tree.child("shared")
            Files.writeText(path, "abc")
            val original = File.open(path)
            val duplicate = original.duplicate()
            NativeByteBuffer.allocate(1L).use { buffer ->
                original.readFully(buffer)
                assertEquals(97.toByte(), buffer.readByte())
                original.close()
                buffer.clear()
                duplicate.readFully(buffer)
                assertEquals(98.toByte(), buffer.readByte())
            }
            duplicate.close()
            assertTrue(original.isClosed)
            assertTrue(duplicate.isClosed)
            assertFailsWith<IllegalStateException> { original.position }
            assertFailsWith<IllegalStateException> { original.metadata() }
            assertFailsWith<IllegalStateException> { original.flush() }
            assertFailsWith<IllegalStateException> { original.truncate(0L) }
            original.dispose()
        }
    }

    @Test
    fun `overlapping file operations permit reads and reject reentrant close`() {
        TestDirectory().use { tree ->
            val path = tree.child("overlapping")
            Files.writeText(path, "abc")
            File.open(path).use { file ->
                file.withDescriptor { fd ->
                    assertEquals(3L, file.size)
                    assertFailsWith<IllegalStateException> { file.dispose() }
                    assertEquals("abc", file.readText())
                }
                assertFalse(file.isClosed)
            }
        }
    }

    @Test
    fun `invalid options and native failures keep precise categories and context`() {
        TestDirectory().use { tree ->
            val path = tree.child("missing")
            assertFailsWith<IllegalArgumentException> { File.open(path, OpenOptions(read = false)) }
            assertFailsWith<IllegalArgumentException> { File.open(path, OpenOptions(append = true)) }
            assertFailsWith<IllegalArgumentException> { File.open(path, OpenOptions(write = true, append = true, truncate = true)) }
            assertFailsWith<IllegalArgumentException> { File.open(path, OpenOptions(mode = -1)) }
            val failure = assertFailsWith<PlatformException> { File.open(path) }
            assertTrue(failure.kind == PlatformErrorKind.NotFound)
            assertEquals(path.toOsString(), failure.context!!)
            assertTrue(failure.nativeError != None)
            Files.writeText(path, "x")
            assertFailsWith<PlatformException> { File.open(path, OpenOptions(write = true, createNew = true)) }
            File.open(path).use { file ->
                assertFailsWith<IllegalArgumentException> { file.seek(-1L) }
                assertFailsWith<IllegalArgumentException> { file.truncate(-1L) }
                assertEquals(0L, file.position)
            }
            assertFalse(Files.exists(path.resolve(Path.fromString("child"))))
        }
    }

    @Test
    fun `copy and move honor replacement and self copy never truncates input`() {
        TestDirectory().use { tree ->
            val source = tree.child("source")
            val target = tree.child("target")
            Files.writeText(source, "hello")
            assertEquals(5L, Files.copy(source, target))
            assertEquals("hello", Files.readText(target))
            assertTrue(assertFailsWith<PlatformException> { Files.copy(source, target) }.kind == PlatformErrorKind.AlreadyExists)
            assertFailsWith<IllegalArgumentException> { Files.copy(source, source, replaceExisting = true) }
            assertEquals("hello", Files.readText(source))
            Files.writeText(source, "new")
            assertEquals(3L, Files.copy(source, target, replaceExisting = true))
            assertTrue(assertFailsWith<PlatformException> { Files.move(source, target) }.kind == PlatformErrorKind.AlreadyExists)
            assertTrue(Files.exists(source))
            Files.move(source, target, replaceExisting = true)
            assertFalse(Files.exists(source))
            assertEquals("new", Files.readText(target))
        }
    }

    @Test
    fun `UTF8 content remains independent from path processing`() {
        TestDirectory().use { tree ->
            val name = Path.fromString("名字")
            val path = tree.path.resolve(name)
            Files.writeText(path, "中")
            Files.writeText(path, "😀", append = true)
            assertEquals("中😀", Files.readText(path))
            Files.writeAllBytes(path, Array<Byte>(1L) { -1.toByte() })
            assertFailsWith<CharacterCodingException> { Files.readText(path) }
            assertEquals("�", Files.readTextLossy(path))
            Files.entries(tree.path).use { entries -> assertEquals(name.toOsString(), entries.next()!!.name) }
        }
    }
}
