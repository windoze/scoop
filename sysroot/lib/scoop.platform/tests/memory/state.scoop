package scoop.platform.memory

import scoop.test.*

@Test
private class NativeByteBufferStateTest {
    @Test
    fun `empty storage has no readable bytes and needs explicit growth`() {
        NativeByteBuffer.allocate().use { buffer ->
            assertEquals(0L, buffer.capacity)
            assertEquals(0L, buffer.readPosition)
            assertEquals(0L, buffer.writePosition)
            assertEquals(0L, buffer.readableBytes)
            assertEquals(0L, buffer.writableBytes)
            buffer.clear()
            buffer.compact()
            buffer.skip(0L)
            buffer.ensureWritable(0L)
            assertEquals(0L, buffer.readBytes(0L).size)
            assertFailsWith<IndexOutOfBoundsException> { buffer.readByte() }
            assertFailsWith<IndexOutOfBoundsException> { buffer.writeByte(1.toInt8()) }
            buffer.ensureWritable(3L)
            assertTrue(buffer.capacity >= 3L)
            buffer.writeByte(7.toInt8())
            assertEquals(7.toInt8(), buffer.readByte())
        }
    }

    @Test
    fun `clear hides previous bytes and absolute access never extends initialization`() {
        NativeByteBuffer.allocate(4L).use { buffer ->
            assertEquals(4L, buffer.capacity)
            assertFailsWith<IndexOutOfBoundsException> { buffer.getByte(0L) }
            assertFailsWith<IndexOutOfBoundsException> { buffer.setByte(0L, 3.toInt8()) }
            buffer.writeByte(5.toInt8())
            buffer.setByte(0L, 6.toInt8())
            assertEquals(6.toInt8(), buffer.readByte())
            assertEquals(6.toInt8(), buffer.getByte(0L))
            assertFailsWith<IndexOutOfBoundsException> { buffer.getByte(-1L) }
            assertFailsWith<IndexOutOfBoundsException> { buffer.getByte(1L) }
            buffer.clear()
            assertEquals(4L, buffer.capacity)
            assertEquals(0L, buffer.writePosition)
            assertFailsWith<IndexOutOfBoundsException> { buffer.getByte(0L) }
            assertFailsWith<IndexOutOfBoundsException> { buffer.readByte() }
        }
    }

    @Test
    fun `growth preserves consumed and unread bytes while compact uses overlap safely`() {
        NativeByteBuffer.allocate(6L).use { buffer ->
            buffer.writeBytes(Array<Byte>(6L) { (it + 1L).toInt8() })
            buffer.skip(2L)
            buffer.ensureWritable(1L)
            assertTrue(buffer.capacity >= 7L)
            assertEquals(2L, buffer.readPosition)
            assertEquals(6L, buffer.writePosition)
            assertEquals(1.toInt8(), buffer.getByte(0L))
            buffer.compact()
            assertEquals(0L, buffer.readPosition)
            assertEquals(4L, buffer.writePosition)
            assertEquals(3.toInt8(), buffer.getByte(0L))
            assertEquals(6.toInt8(), buffer.getByte(3L))
            buffer.skip(4L)
            buffer.compact()
            assertEquals(0L, buffer.writePosition)
        }
    }

    @Test
    fun `array transfers check both ranges and return independent storage`() {
        val buffer = NativeByteBuffer.allocate(8L)
        val source = MutableArray<Byte>(4L) { (it + 10L).toInt8() }
        buffer.writeBytes(source, 1L, 2L)
        source[1L] = 99.toInt8()
        buffer.writeBytes(Array<Byte>(3L) { (it + 20L).toInt8() }, 1L)
        val copy = buffer.readBytes(2L)
        val destination = MutableArray<Byte>(4L) { 0.toInt8() }
        buffer.readInto(destination, 1L, 2L)
        assertEquals(0.toInt8(), destination[0L])
        assertEquals(21.toInt8(), destination[1L])
        assertEquals(22.toInt8(), destination[2L])
        assertEquals(0.toInt8(), destination[3L])
        buffer.setByte(0L, 88.toInt8())
        buffer.close()
        assertEquals(11.toInt8(), copy[0L])
        assertEquals(12.toInt8(), copy[1L])
    }

    @Test
    fun `invalid ranges and overflow leave positions unchanged`() {
        assertFailsWith<IllegalArgumentException> { NativeByteBuffer.allocate(-1L) }
        NativeByteBuffer.allocate(8L).use { buffer ->
            buffer.writeByte(4.toInt8())
            val array = MutableArray<Byte>(2L) { 0.toInt8() }
            assertFailsWith<IllegalArgumentException> { buffer.ensureWritable(-1L) }
            assertFailsWith<ArithmeticException> { buffer.ensureWritable(Long.MAX_VALUE) }
            assertFailsWith<IllegalArgumentException> { buffer.skip(-1L) }
            assertFailsWith<IllegalArgumentException> { buffer.readBytes(-1L) }
            assertFailsWith<IndexOutOfBoundsException> { buffer.readBytes(2L) }
            assertFailsWith<IndexOutOfBoundsException> { buffer.skip(2L) }
            assertFailsWith<IndexOutOfBoundsException> { buffer.readInto(array, 2L, 1L) }
            assertFailsWith<IndexOutOfBoundsException> { buffer.writeBytes(array, -1L, 1L) }
            assertFailsWith<IndexOutOfBoundsException> { buffer.writeBytes(array, Long.MAX_VALUE, 1L) }
            assertFailsWith<IllegalArgumentException> { buffer.writeBytes(array, 0L, -1L) }
            assertEquals(0L, buffer.readPosition)
            assertEquals(1L, buffer.writePosition)
            assertEquals(8L, buffer.capacity)
            assertEquals(4.toInt8(), buffer.readByte())
        }
    }

    @Test
    fun `closed aliases share state and every access except close is rejected`() {
        val buffer = NativeByteBuffer.allocate(4L)
        val alias = buffer
        buffer.close()
        alias.dispose()
        alias.close()
        assertTrue(alias.isClosed)
        assertFailsWith<IllegalStateException> { alias.capacity }
        assertFailsWith<IllegalStateException> { alias.readPosition }
        assertFailsWith<IllegalStateException> { alias.writePosition }
        assertFailsWith<IllegalStateException> { alias.readableBytes }
        assertFailsWith<IllegalStateException> { alias.writableBytes }
        assertFailsWith<IllegalStateException> { alias.clear() }
        assertFailsWith<IllegalStateException> { alias.compact() }
        assertFailsWith<IllegalStateException> { alias.skip(0L) }
        assertFailsWith<IllegalStateException> { alias.ensureWritable(0L) }
        assertFailsWith<IllegalStateException> { alias.readBytes(0L) }
        assertFailsWith<IllegalStateException> { alias.getByte(0L) }
        assertFailsWith<IllegalStateException> { alias.setByte(0L, 0.toInt8()) }
        assertFailsWith<IllegalStateException> { alias.writeByte(0.toInt8()) }
        @Unsafe {
            assertFailsWith<IllegalStateException> { @Unsafe { alias.withReadableBytes { _, _ -> 0 } } }
            assertFailsWith<IllegalStateException> { @Unsafe { alias.withWritableBytes { _, _ -> 0L } } }
        }
    }
}
