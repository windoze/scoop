package scoop.platform.system

import scoop.test.*

@Test
private class PlatformErrorTest {
    @Test
    fun `unknown codes keep their domains and original values`() {
        val posix = NativeError(NativeErrorDomain.PosixErrno, Int.MAX_VALUE)
        val address = NativeError(NativeErrorDomain.AddressResolution, Int.MAX_VALUE, Some(17))
        assertTrue(posix.kind == PlatformErrorKind.Other)
        assertTrue(address.kind == PlatformErrorKind.Other)
        assertTrue(address.domain == NativeErrorDomain.AddressResolution)
        assertEquals(Int.MAX_VALUE, address.code)
        assertEquals(17, address.systemCode!!)
        assertTrue(posix.systemCode == None)
        val libuv = NativeError(NativeErrorDomain.Libuv, Int.MIN_VALUE)
        assertTrue(libuv.kind == PlatformErrorKind.Other)
        assertTrue(libuv.domain == NativeErrorDomain.Libuv)
        assertEquals(Int.MIN_VALUE, libuv.code)
        assertTrue(NativeError(NativeErrorDomain.Libuv, -4095).kind == PlatformErrorKind.Other)
    }

    @Test
    fun `libuv system errors preserve the negative code and classify the target errno`() {
        // All supported POSIX targets define ENOENT as 2 and EACCES as 13.
        assertTrue(NativeError(NativeErrorDomain.Libuv, -2).kind == PlatformErrorKind.NotFound)
        assertTrue(NativeError(NativeErrorDomain.Libuv, -13).kind == PlatformErrorKind.PermissionDenied)
        assertTrue(NativeError(NativeErrorDomain.Libuv, 2).kind == PlatformErrorKind.Other)
        assertTrue(NativeError(NativeErrorDomain.Libuv, 0).kind == PlatformErrorKind.Other)
    }

    @Test
    fun `exceptions retain operation raw context and error snapshot`() {
        val raw = NativeError(NativeErrorDomain.PosixErrno, Int.MAX_VALUE)
        val context = OsString.fromBytes(Array<Byte>(1L) { _ -> -1 })
        val error = assertFailsWith<PlatformException> {
            throw PlatformException("open", raw.kind, Some(raw), Some(context))
        }
        assertEquals("open", error.operation)
        assertTrue(error.kind == PlatformErrorKind.Other)
        assertEquals(Int.MAX_VALUE, error.nativeError!!.code)
        assertSame(context, error.context!!)
        assertEquals(-1.toInt8(), error.context!!.toBytes()[0L])
    }
}
