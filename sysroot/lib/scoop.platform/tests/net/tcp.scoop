package scoop.platform.net

import scoop.platform.concurrent.Thread
import scoop.platform.io.*
import scoop.platform.system.*
import scoop.test.*

@Test
private class TcpTest {
    @Test
    fun `TCP supports both families buffered IO options and independent half close`() {
        for (address in [IpAddress.IPV4_LOOPBACK, IpAddress.IPV6_LOOPBACK]) {
            TcpListener.bind(SocketAddress(address, 0), 8, true).use { listener ->
                val endpoint = listener.localAddress()
                assertTrue(endpoint.port > 0)
                val bytes = Array<Byte>(65536L) { (it % 251L).toByte() }
                Thread.start {
                    listener.accept().use { stream ->
                        assertEquals(endpoint, stream.localAddress())
                        assertTrue(stream.peerAddress().port > 0)
                        stream.setNoDelay(true)
                        stream.setKeepAlive(true)
                        assertTrue(stream.noDelay() && stream.keepAlive())
                        stream.setNoDelay(false)
                        stream.setKeepAlive(false)
                        assertFalse(stream.noDelay() || stream.keepAlive())
                        val received = stream.readAllBytes()
                        assertEquals(bytes.size, received.size)
                        for (index in 0L..<bytes.size) assertEquals(bytes[index], received[index])
                        gcCollect()
                        BufferedSink(stream, 3L).use { it.writeText("response 中"); it.flush() }
                        stream.shutdownOutput()
                    }
                }.use {
                    gcCollect()
                    TcpStream.connect(endpoint).use { stream ->
                        assertEquals(endpoint, stream.peerAddress())
                        assertEquals(address, stream.localAddress().address)
                        stream.writeAllBytes(bytes)
                        stream.shutdownOutput()
                        assertEquals("response 中", stream.readText())
                        assertEquals(0L, stream.readAllBytes().size)
                    }
                }
            }
        }
    }

    @Test
    fun `listener and stream reject operations after close and bind reports actual conflict`() {
        val listener = TcpListener.bind(SocketAddress(IpAddress.IPV4_LOOPBACK, 0))
        val endpoint = listener.localAddress()
        val conflict = assertFailsWith<PlatformException> { TcpListener.bind(endpoint) }
        assertTrue(conflict.kind == PlatformErrorKind.AddressInUse)
        Thread.start { listener.accept().use { assertEquals("still writing", it.readText()) } }.use {
            val stream = TcpStream.connect(endpoint)
            stream.shutdownInput()
            stream.writeText("still writing")
            stream.close()
            stream.close()
            assertTrue(stream.isClosed)
            assertFailsWith<IllegalStateException> { stream.localAddress() }
            assertFailsWith<IllegalStateException> { stream.peerAddress() }
            assertFailsWith<IllegalStateException> { stream.noDelay() }
            assertFailsWith<IllegalStateException> { stream.setKeepAlive(true) }
            assertFailsWith<IllegalStateException> { stream.shutdownOutput() }
            assertFailsWith<IllegalStateException> { stream.readAllBytes() }
            assertFailsWith<IllegalStateException> { stream.flush() }
        }
        listener.dispose()
        listener.dispose()
        assertTrue(listener.isClosed)
        assertFailsWith<IllegalStateException> { listener.accept() }
        assertFailsWith<IllegalStateException> { listener.localAddress() }
        assertFailsWith<IllegalArgumentException> { TcpListener.bind(endpoint, 0) }
    }

    @Test
    fun `writing after output shutdown reports broken pipe and preserves the process`() {
        TcpListener.bind(SocketAddress(IpAddress.IPV4_LOOPBACK, 0)).use { listener ->
            Thread.start { listener.accept().use { it.readAllBytes() } }.use {
                TcpStream.connect(listener.localAddress()).use { stream ->
                    stream.shutdownOutput()
                    val failure = assertFailsWith<PlatformException> { stream.writeText("closed") }
                    assertTrue(failure.kind == PlatformErrorKind.BrokenPipe)
                }
            }
        }
    }
}
