// Scoop sysroot: standard delegates (spec §10.4)
//
// 说明：
// - 本文件仅提供“声明表面”，用于名字解析与类型检查；
// - 标准库的真实实现与线程安全/运行期语义由后续 runtime/stdlib 任务补齐。

package scoop.delegates

import scoop.core.*

/// 委托属性的只读接口（spec §10.4）。
public interface ReadOnlyProperty<in T, out V> {
    public fun getValue(thisRef: T, property: PropertyMeta): V
}

/// 委托属性的可写接口（spec §10.4）。
public interface ReadWriteProperty<in T, V> : ReadOnlyProperty<T, V> {
    public fun setValue(thisRef: T, property: PropertyMeta, value: V)
}

/// `lazy` 的线程安全策略（Kotlin-like，spec §10.4 示例）。
public enum LazyThreadSafetyMode {
    None,
    Publication,
    Synchronized,
}

/// lazy：首次读取时计算并缓存（实现语义后续补齐）。
@Intrinsic
public fun <V> lazy(initializer: () -> V): ReadOnlyProperty<Any, V>

/// lazy：指定线程安全策略（实现语义后续补齐）。
///
/// 平台 policy（early stage）：
/// - `LazyThreadSafetyMode.None`：不依赖线程/互斥锁，可在所有平台落地；
/// - `Publication/Synchronized`（以及省略 mode 的默认行为）会被编译器 lowering 为 `Mutex` + lock/unlock，
///   因此要求目标平台具备线程/互斥锁 runtime 能力；否则编译期会给出清晰诊断。
@Intrinsic
public fun <V> lazy(mode: LazyThreadSafetyMode, initializer: () -> V): ReadOnlyProperty<Any, V>

/// observable：每次写入触发回调（old/new）。
///
/// 并发语义（early stage）：
/// - 编译器会为该属性注入一个内部互斥锁字段（per-property `Mutex`），用于保护 backing field 的读写，
///   从而保证并发可见性并避免 data race；
/// - 回调在写入完成后执行，且不在锁内执行（允许回调 reentrancy，并避免 `Raise`/异常路径导致锁泄漏）。
///
/// 平台 policy（early stage）：
/// - 当前实现依赖 per-property `Mutex` 以保证并发可见性，因此要求目标平台具备线程/互斥锁能力；
/// - 单线程/无 mutex 平台的“无锁降级实现”留给后续平台 backends 任务细化。
@Intrinsic
public fun <V> observable(initial: V, onChange: (V, V) -> Unit): ReadWriteProperty<Any, V>

/// vetoable：写入前触发回调，返回 false 时拒绝更新。
///
/// 并发语义（early stage）：
/// - backing field 的读写由编译器注入的 per-property `Mutex` 保护（保证并发可见性、避免 data race）；
/// - 回调不在锁内执行（允许回调 reentrancy，并避免 `Raise`/异常路径导致锁泄漏）；
/// - 因此在并发场景下，回调看到的 `old` 是一次受保护读取的快照；回调返回 `true` 后的实际写入会再次加锁提交。
///
/// 平台 policy（early stage）：同 `observable`（需要线程/互斥锁能力）。
@Intrinsic
public fun <V> vetoable(initial: V, onChange: (V, V) -> Bool): ReadWriteProperty<Any, V>
