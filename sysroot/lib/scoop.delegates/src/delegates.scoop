// Scoop sysroot: standard delegates (spec §10.4)

package scoop.delegates

import scoop.core.*
import scoop.sync.*

/// 委托属性的只读接口（spec §10.4）。
public interface ReadOnlyProperty<in T, out V> {
    public fun getValue(thisRef: T, property: PropertyMeta): V
}

/// 委托属性的可写接口（spec §10.4）。
public interface ReadWriteProperty<in T, V> : ReadOnlyProperty<T, V> {
    public fun setValue(thisRef: T, property: PropertyMeta, value: V)
}

/// `lazy` 的线程安全策略（Kotlin-like，spec §10.4 示例）。
public enum LazyThreadSafetyMode {
    None,
    Publication,
    Synchronized,
}

private fun __scoop_delegates_lazy_mutex(mode: LazyThreadSafetyMode): Mutex? {
    return when (mode) {
        None -> None()
        Publication -> Some(mutexCreate())
        Synchronized -> Some(mutexCreate())
    }
}

/// `lazy` 委托对象：首次读取时计算并缓存 initializer 结果。
public class Lazy<V>(mode: LazyThreadSafetyMode, initializer: () -> V, mutex: Mutex?) : ReadOnlyProperty<Any, V> {
    private val mode: LazyThreadSafetyMode = mode
    private val initializer: () -> V = initializer
    private val mutex: Mutex? = mutex
    private var value: V? = None()

    private fun requireMutex(): Mutex {
        return when (this.mutex) {
            Some(m) -> m
            None -> panic("lazy mode requires a mutex")
        }
    }

    private fun getValueNone(): V {
        return when (this.value) {
            Some(v) -> v
            None -> {
                val computed: V = this.initializer()
                this.value = Some(computed)
                computed
            }
        }
    }

    private fun getValueSynchronized(): V {
        val m: Mutex = this.requireMutex()
        m.lock()
        val result: V = when (this.value) {
            Some(v) -> v
            None -> {
                val computed: V = this.initializer()
                this.value = Some(computed)
                computed
            }
        }
        m.unlock()
        return result
    }

    private fun getValuePublication(): V {
        val m: Mutex = this.requireMutex()
        m.lock()
        when (this.value) {
            Some(v) -> {
                m.unlock()
                return v
            }
            None -> {
                m.unlock()
            }
        }

        val computed: V = this.initializer()

        m.lock()
        val result: V = when (this.value) {
            Some(v) -> v
            None -> {
                this.value = Some(computed)
                computed
            }
        }
        m.unlock()
        return result
    }

    public fun getValue(thisRef: Any, property: PropertyMeta): V {
        return when (this.mode) {
            None -> this.getValueNone()
            Publication -> this.getValuePublication()
            Synchronized -> this.getValueSynchronized()
        }
    }
}

/// observable：持有 backing value，并在写入完成后调用回调。
public class ObservableProperty<V>(initial: V, onChange: (V, V) -> Unit, mutex: Mutex) : ReadWriteProperty<Any, V> {
    private var value: V = initial
    private val onChange: (V, V) -> Unit = onChange
    private val mutex: Mutex = mutex

    public fun getValue(thisRef: Any, property: PropertyMeta): V {
        this.mutex.lock()
        val result: V = this.value
        this.mutex.unlock()
        return result
    }

    public fun setValue(thisRef: Any, property: PropertyMeta, newValue: V): Unit {
        this.mutex.lock()
        val old: V = this.value
        this.value = newValue
        this.mutex.unlock()
        this.onChange(old, newValue)
    }
}

/// vetoable：写入前调用回调；回调返回 false 时保留旧值。
public class VetoableProperty<V>(initial: V, onChange: (V, V) -> Bool, mutex: Mutex) : ReadWriteProperty<Any, V> {
    private var value: V = initial
    private val onChange: (V, V) -> Bool = onChange
    private val mutex: Mutex = mutex

    public fun getValue(thisRef: Any, property: PropertyMeta): V {
        this.mutex.lock()
        val result: V = this.value
        this.mutex.unlock()
        return result
    }

    public fun setValue(thisRef: Any, property: PropertyMeta, newValue: V): Unit {
        this.mutex.lock()
        val old: V = this.value
        this.mutex.unlock()

        if (this.onChange(old, newValue)) {
            this.mutex.lock()
            this.value = newValue
            this.mutex.unlock()
        }
    }
}

/// lazy：默认使用 `Synchronized`，首次读取时计算并缓存。
public fun <V> lazy(initializer: () -> V): Lazy<V> {
    return Lazy(
        LazyThreadSafetyMode.Synchronized,
        initializer,
        __scoop_delegates_lazy_mutex(LazyThreadSafetyMode.Synchronized),
    )
}

/// lazy：指定线程安全策略。
///
/// 平台 policy：
/// - `LazyThreadSafetyMode.None`：不依赖线程/互斥锁，可在所有平台落地；
/// - `Publication/Synchronized`（以及省略 mode 的默认行为）会由库实现组合 `Mutex`，因此要求目标平台具备线程/互斥锁 runtime 能力。
public fun <V> lazy(mode: LazyThreadSafetyMode, initializer: () -> V): Lazy<V> {
    return Lazy(mode, initializer, __scoop_delegates_lazy_mutex(mode))
}

/// observable：每次写入触发回调（old/new）。
///
/// 并发语义：
/// - 委托对象内部持有 `Mutex` 保护 backing value 的读写，从而保证并发可见性并避免 data race；
/// - 回调在写入完成后执行，且不在锁内执行（允许回调 reentrancy，并避免 `Raise`/异常路径导致锁泄漏）。
///
/// 平台 policy：
/// - 当前实现依赖委托对象内部 `Mutex` 以保证并发可见性，因此要求目标平台具备线程/互斥锁能力；
/// - 单线程/无 mutex 平台的“无锁降级实现”留给后续平台 backends 任务细化。
public fun <V> observable(initial: V, onChange: (V, V) -> Unit): ObservableProperty<V> {
    return ObservableProperty(initial, onChange, mutexCreate())
}

/// vetoable：写入前触发回调，返回 false 时拒绝更新。
///
/// 并发语义（early stage）：
/// - backing value 的读写由委托对象内部 `Mutex` 保护（保证并发可见性、避免 data race）；
/// - 回调不在锁内执行（允许回调 reentrancy，并避免 `Raise`/异常路径导致锁泄漏）；
/// - 因此在并发场景下，回调看到的 `old` 是一次受保护读取的快照；回调返回 `true` 后的实际写入会再次加锁提交。
///
/// 平台 policy（early stage）：同 `observable`（需要线程/互斥锁能力）。
public fun <V> vetoable(initial: V, onChange: (V, V) -> Bool): VetoableProperty<V> {
    return VetoableProperty(initial, onChange, mutexCreate())
}
