// Scoop sysroot: runtime test-only helper surface.
//
// 说明：
// - 该 cone 只供仓库 fixture / compiler tests 显式导入；不进入自动 prelude；
// - helper 用于验证 GC、moving roots 与 stackmap smoke，不是稳定用户态 API。

package scoop.runtime.test

import scoop.core.*
import scoop.unsafe.*

// 手动触发真实 GC；保持 scoop ABI，确保调用边界保留 managed roots。
@Extern(name = "scoop_gc_collect", abi = "scoop")
public fun __scoop_gc_collect(): Unit

// 手动触发 minor GC；非 Immix backend 会按 runtime contract 退化为一次普通 collect。
@Extern(name = "scoop_gc_collect_minor", abi = "scoop")
public fun __scoop_gc_collect_minor(): Unit

// 只读取 runtime heap 计数，不接收/返回 GC ref，按 C ABI leaf helper 暴露。
@Extern(name = "scoop_gc_debug_heap_object_count", abi = "c")
public fun __scoop_gc_debug_heap_object_count(): Int

// 只读取 runtime 累计分配字节数，不接收/返回 GC ref，按 C ABI leaf helper 暴露。
@Extern(name = "scoop_gc_debug_heap_bytes_allocated", abi = "c")
public fun __scoop_gc_debug_heap_bytes_allocated(): Int

// 会通过 runtime 分配垃圾对象并可能触发 safepoint；必须保持 managed boundary。
@Extern(name = "scoop_gc_debug_alloc_garbage", abi = "scoop")
public fun __scoop_gc_debug_alloc_garbage(count: Int): Unit

// 显式 opt-in 的 stackmap smoke；编译器会仅对该 FQN 恢复 statepoint lowering。
@Intrinsic
public fun __scoop_stackmap_statepoint_smoke(): Int

// `@ReleaseHook` 端到端 fixture 的 test-only native handle 探针。
@Extern(name = "scoop_test_release_hook_probe_reset", abi = "c")
public fun __scoop_release_hook_probe_reset(): Unit

@Extern(name = "scoop_test_release_hook_probe_create", abi = "c")
public fun __scoop_release_hook_probe_create(id: Int): Ptr<Int>

@Extern(name = "scoop_test_release_hook_probe_release", abi = "c")
public fun __scoop_release_hook_probe_release(raw: Ptr<Int>): Unit

@Extern(name = "scoop_test_release_hook_probe_id", abi = "c")
public fun __scoop_release_hook_probe_id(raw: Ptr<Int>): Int

@Extern(name = "scoop_test_release_hook_probe_release_count", abi = "c")
public fun __scoop_release_hook_probe_release_count(): Int

@Extern(name = "scoop_test_release_hook_probe_duplicate_count", abi = "c")
public fun __scoop_release_hook_probe_duplicate_count(): Int

@Extern(name = "scoop_test_release_hook_probe_invalid_count", abi = "c")
public fun __scoop_release_hook_probe_invalid_count(): Int

@Extern(name = "scoop_test_release_hook_probe_live_count", abi = "c")
public fun __scoop_release_hook_probe_live_count(): Int

@Extern(name = "scoop_test_release_hook_probe_last_id", abi = "c")
public fun __scoop_release_hook_probe_last_id(): Int

@Extern(name = "scoop_test_release_hook_probe_expect_at_exit", abi = "c")
public fun __scoop_release_hook_probe_expect_at_exit(releaseCount: Int, liveCount: Int): Unit
