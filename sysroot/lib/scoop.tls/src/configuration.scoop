package scoop.tls

import scoop.bytes.ByteArrayBuilder
import scoop.crypto.native.peerIdentityData
import scoop.crypto.x509.PeerIdentity
import scoop.platform.net.IpAddress

public enum TlsVersion { TLS12, TLS13 }
public enum TlsPeerName { Dns(String), Ip(IpAddress) }
public struct TlsOptions(
    val minimum: TlsVersion = TlsVersion.TLS12,
    val maximum: TlsVersion = TlsVersion.TLS13,
    val alpn: List<Array<Byte>> = ArrayList<Array<Byte>>()
)
public struct TlsConnectionInfo(val version: TlsVersion, val alpn: Array<Byte>?)

internal fun versionCode(version: TlsVersion): Int = when (version) {
    case TLS12 -> 0x0303
    case TLS13 -> 0x0304
}

internal fun encodeOptions(options: TlsOptions): Array<Byte> {
    if (versionCode(options.minimum) > versionCode(options.maximum))
        throw IllegalArgumentException(Some("minimum TLS version exceeds maximum"))
    val result = ByteArrayBuilder()
    var total = 0L
    for (protocol in options.alpn) {
        if (protocol.size < 1L || protocol.size > 255L) throw IllegalArgumentException(Some("ALPN protocol must contain 1 to 255 bytes"))
        total += 1L + protocol.size
        if (total > 65535L) throw IllegalArgumentException(Some("ALPN list exceeds 65535 bytes"))
        result.append(protocol.size.toByte())
        result.append(protocol)
    }
    return result.toByteArray()
}

internal fun peerData(peer: TlsPeerName): (Int, Array<Byte>) = when (peer) {
    case Dns(name) -> peerIdentityData(PeerIdentity.Dns(name))
    case Ip(address) -> peerIdentityData(PeerIdentity.Ip(address.toBytes()))
}
