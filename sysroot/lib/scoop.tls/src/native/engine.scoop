package scoop.tls.native

import scoop.crypto.native.cryptoBytes
import scoop.platform.memory.*
import scoop.tls.*

public enum TlsStepKind { Done, WantRead, WantWrite, Closed }
public struct TlsStep(val kind: TlsStepKind, val count: Long)

public class TlsEngine private constructor(private var handle: ULong) : Closeable {
    public companion object {
        public fun client(context: TlsClientContext, peer: TlsPeerName): TlsEngine = TlsEngine(context.newSession(peer))
        public fun server(context: TlsServerContext): TlsEngine = TlsEngine(context.newSession())
    }

    private fun nativeHandle(): ULong {
        if (handle == 0UL) throw IllegalStateException(Some("TLS engine is closed"))
        return handle
    }

    public val inputCapacity: Long get() { @Unsafe { return inputCapacity(nativeHandle()) } }
    public val pendingOutput: Long get() { @Unsafe { return pendingOutput(nativeHandle()) } }
    public val connectionInfo: TlsConnectionInfo get() {
        @Unsafe {
            val owned = nativeHandle()
            val version = when (sessionVersion(owned)) {
                case 0x0303 -> TlsVersion.TLS12
                case 0x0304 -> TlsVersion.TLS13
                else -> throw IllegalStateException(Some("TLS handshake is incomplete"))
            }
            val alpn = cryptoBytes(sessionAlpn(owned), "read TLS ALPN")
            return TlsConnectionInfo(version, if (alpn.size == 0L) None else Some(alpn))
        }
    }

    public fun handshake(): TlsStep { @Unsafe { return checkedStep(sessionStep(nativeHandle(), 0, None, 0L), "TLS handshake") } }
    public fun shutdown(): TlsStep { @Unsafe { return checkedStep(sessionStep(nativeHandle(), 3, None, 0L), "TLS shutdown") } }

    @Unsafe public fun read(borrow: NativeByteBorrow): TlsStep {
        if (borrow.length == 0L) throw IllegalArgumentException(Some("TLS engine read requires a nonempty buffer"))
        return checkedStep(sessionStep(nativeHandle(), 1, borrow.pointer(), borrow.length), "TLS read")
    }

    @Unsafe public fun write(borrow: NativeByteBorrow): TlsStep {
        if (borrow.length == 0L) throw IllegalArgumentException(Some("TLS engine write requires a nonempty buffer"))
        val count = if (borrow.length > 16384L) 16384L else borrow.length
        return checkedStep(sessionStep(nativeHandle(), 2, borrow.pointer(), count), "TLS write")
    }

    public fun receiveCiphertext(buffer: NativeByteBuffer, requested: Long = buffer.readableBytes): Long {
        if (requested < 0L || requested > buffer.readableBytes) throw IllegalArgumentException(Some("invalid TLS ciphertext count"))
        val capacity = inputCapacity
        val count = if (requested < capacity) requested else capacity
        if (count == 0L) return 0L
        @Unsafe {
            val received = buffer.withReadableBytes { pointer, _ ->
                @Unsafe { return@withReadableBytes tlsValue(ciphertext(nativeHandle(), 1, pointer!!, count), "feed TLS ciphertext").toInt64() }
            }
            buffer.skip(received)
            return received
        }
    }

    public fun takeCiphertext(buffer: NativeByteBuffer, requested: Long = buffer.writableBytes): Long {
        if (requested < 0L || requested > buffer.writableBytes) throw IllegalArgumentException(Some("invalid TLS ciphertext count"))
        val pending = pendingOutput
        val count = if (requested < pending) requested else pending
        if (count == 0L) return 0L
        @Unsafe { return buffer.withWritableBytes { pointer, _ ->
            @Unsafe { return@withWritableBytes tlsValue(ciphertext(nativeHandle(), 0, pointer!!, count), "drain TLS ciphertext").toInt64() }
        } }
    }

    public fun endInput() { @Unsafe { endInput(nativeHandle()) } }
    public override fun close() {
        val owned = handle
        handle = 0UL
        if (owned != 0UL) @Unsafe { sessionFree(owned) }
    }
}
