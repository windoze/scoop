package scoop.asyncio

import scoop.platform.memory.NativeByteBuffer
import scoop.platform.net.*
import scoop.test.*

@Test
private class AsyncUdpCancellationTest {
    @Test
    fun `submitted send cancellation waits for its callback and commits the complete packet`() {
        val backend = LibuvEventLoop()
        val loop: EventLoop = backend
        loop.run suspend { scope ->
            val sender = loop.bindUdp(SocketAddress(IpAddress.IPV4_LOOPBACK, 0))
            val receiver = loop.bindUdp(SocketAddress(IpAddress.IPV4_LOOPBACK, 0))
            NativeByteBuffer.allocate(2L).use suspend { bytes ->
                bytes.writeByte(11)
                bytes.writeByte(12)
                val sending = scope.launch suspend { sender.sendTo(bytes, receiver.localAddress, 2L) }
                backend.state.post {
                    sending.cancel()
                    assertFalse(sending.isCompleted)
                    assertFailsWith<IllegalStateException> { bytes.clear() }
                    gcCollect()
                }
                sending.join()
                assertTrue(sending.isCancelled)
                assertEquals(2L, bytes.readPosition)
                bytes.clear()
                assertEquals(2L, receiver.receiveFrom(bytes, 2L).count)
                assertEquals(11.toInt8(), bytes.readByte())
                assertEquals(12.toInt8(), bytes.readByte())
                bytes.clear()
                bytes.writeByte(42)
                assertEquals(1L, sender.sendTo(bytes, receiver.localAddress, 1L))
                bytes.clear()
                assertEquals(1L, receiver.receiveFrom(bytes, 2L).count)
                assertEquals(42.toInt8(), bytes.readByte())
            }
        }
    }

    @Test
    fun `cancelled receives leave the socket usable and do not consume the next packet`() {
        val backend = LibuvEventLoop()
        val loop: EventLoop = backend
        loop.run suspend { scope ->
            val sender = loop.bindUdp(SocketAddress(IpAddress.IPV4_LOOPBACK, 0))
            val receiver = loop.bindUdp(SocketAddress(IpAddress.IPV4_LOOPBACK, 0))
            NativeByteBuffer.allocate(1L).use suspend { bytes ->
                val early = scope.launch suspend { receiver.receiveFrom(bytes, 1L) }
                early.cancel()
                early.join()
                val subscribed = scope.launch suspend { receiver.receiveFrom(bytes, 1L) }
                backend.state.post { subscribed.cancel() }
                subscribed.join()
                assertTrue(early.isCancelled && subscribed.isCancelled)
                assertEquals(0L, bytes.writePosition)
                bytes.writeByte(42)
                sender.sendTo(bytes, receiver.localAddress, 1L)
                bytes.clear()
                assertEquals(1L, receiver.receiveFrom(bytes, 1L).count)
                assertEquals(42.toInt8(), bytes.readByte())
            }
        }
    }
}
