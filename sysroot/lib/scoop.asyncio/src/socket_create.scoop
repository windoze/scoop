package scoop.asyncio

internal fun <T> finishSocketCreation(loop: LibuvEventLoop, kind: SocketKind, result: IoResult, selected: Throwable?,
    continuation: Continuation<T>, make: (OwnedSocket) -> T) {
    when (result) {
        case Created(pointer) -> {
            val owner = OwnedSocket(loop, pointer, kind)
            loop.state.retain(owner)
            when (selected) {
                case Some(error) -> { failSocketCreation(owner, error, continuation); return }
                case None -> {}
            }
            val value = try { make(owner) }
            catch (error: Throwable) { failSocketCreation(owner, error, continuation); return }
            continuation.resume(value)
        }
        case _ -> {
            val error = completionFailure("socket create", result, selected)
                ?: IllegalStateException(Some("socket creation returned no resource"))
            continuation.resumeWithException(error)
        }
    }
}

private fun <T> failSocketCreation(owner: OwnedSocket, error: Throwable, continuation: Continuation<T>) {
    owner.closeOnLoop { cleanup ->
        val reported = when (cleanup) { case Some(value) -> ResourceUseException(error, value); case None -> error }
        continuation.resumeWithException(reported)
    }
}
