package scoop.asyncio

import scoop.time.Duration
import scoop.platform.net.*
import scoop.platform.system.OsString
import scoop.platform.fs.*

public class LibuvEventLoop public constructor() : EventLoop {
    private val accepted: AtomicBoolean = AtomicBoolean(false)
    internal val state: LoopState = LoopState()

    public override fun run(block: suspend (CoroutineScope) -> Unit) {
        when (currentJobOrNull()) {
            case Some(_) -> throw IllegalStateException(Some("run requires a caller outside a Job"))
            case None -> {}
        }
        if (hasEventLoop()) throw IllegalStateException(Some("nested event loop run"))
        if (!accepted.compareAndSet(false, true)) throw IllegalStateException(Some("event loop already used"))
        val native = state.open()
        val loop: EventLoop = this
        context(loop) {
            startCoroutine<Unit>(suspend { coroutineScope<Unit>(block) }, LoopCompletion(state))
        }
        state.drive(native)
    }

    internal fun requireJob(cancellable: Boolean = true): Job {
        if (!hasEventLoop() || currentEventLoop() !== this) throw IllegalStateException(Some("wrong event loop"))
        val job = currentJobOrNull() ?: throw IllegalStateException(Some("I/O requires a Job"))
        if (job.isCompleted) throw IllegalStateException(Some("I/O requires an active Job"))
        if (cancellable) job.ensureActive()
        return job
    }

    public override suspend fun sleep(duration: Duration) {
        val job = requireJob()
        if (duration.floorSeconds < 0L) throw IllegalArgumentException(Some("negative sleep duration"))
        if (duration == Duration.ZERO) return
        suspendCoroutine<Unit> { continuation ->
            val operation = LoopOperation(state, state.nextOperation(),
                { native, id -> @Unsafe { return@LoopOperation nativeStatus(id, nativeTimerStart(native, id, duration.floorSeconds, duration.nanosecondsOfSecond)) } },
                { native, id -> @Unsafe { nativeTimerCancel(native, id) } },
                { event, cancelled ->
                    when (completionFailure("sleep", event.result, cancelled)) {
                        case Some(error) -> continuation.resumeWithException(error)
                        case None -> continuation.resume(Unit)
                    }
                })
            operation.subscribe(job)
            state.submit(operation)
        }
    }

    public override suspend fun resolve(host: OsString, port: Int, family: AddressFamily?): Array<SocketAddress> =
        resolveOnLoop(this, host, port, family)

    public override suspend fun openFile(path: Path, options: OpenOptions): AsyncFile =
        openFileOnLoop(this, path, options)

    public override suspend fun connectTcp(address: SocketAddress): AsyncTcpStream = connectTcpOnLoop(this, address)
    public override suspend fun listenTcp(address: SocketAddress, backlog: Int, reuseAddress: Boolean): AsyncTcpListener =
        listenTcpOnLoop(this, address, backlog, reuseAddress)

    public override suspend fun bindUdp(address: SocketAddress, reuseAddress: Boolean): AsyncUdpSocket =
        bindUdpOnLoop(this, address, reuseAddress)
}

private class LoopCompletion(val state: LoopState) : Continuation<Unit> {
    public override fun resume(value: Unit) { state.finishRoot(None) }
    public override fun resumeWithException(exception: Throwable) { state.finishRoot(Some(exception)) }
}
