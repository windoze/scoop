package scoop.asyncio

import scoop.platform.net.*

internal typealias IoAddress = NativeSocketAddress
@CLayout
internal struct NativeSocketName(val address: IoAddress, val status: Int)

internal fun ioAddress(address: SocketAddress): IoAddress {
    val bytes = address.address.toBytes()
    return IoAddress(if (address.address.family == AddressFamily.IPv4) 4 else 6,
        address.port, address.address.scopeId, addressWord(bytes, 0L), addressWord(bytes, 4L),
        addressWord(bytes, 8L), addressWord(bytes, 12L))
}

private fun addressWord(bytes: Array<Byte>, offset: Long): UInt {
    if (offset >= bytes.size) return 0u
    var word = 0u
    for (index in offset..<offset + 4L) word = (word shl 8L) or bytes[index].toUInt8().toUInt32()
    return word
}

internal fun tcpAddress(pointer: Ptr<Unit>, peer: Boolean): SocketAddress {
    @Unsafe {
        val result = nativeTcpAddress(pointer, peer)
        if (result.status < 0) throw uvFailure("TCP address", result.status)
        return ioSocketAddress(result.address)
    }
}

internal fun ioSocketAddress(value: IoAddress): SocketAddress {
    val bytes = Array<Byte>(if (value.family == 4) 4L else 16L) { index ->
        val word = when (index / 4L) { case 0L -> value.a; case 1L -> value.b; case 2L -> value.c; case _ -> value.d }
        ((word shr ((3L - index % 4L) * 8L)) and 255u).toInt8()
    }
    return SocketAddress(IpAddress.fromBytes(bytes, value.scopeId), value.port)
}

@Extern(name = "scoop_io_tcp_connect")
internal fun nativeTcpConnect(loop: Ptr<Unit>, id: Long, address: IoAddress): Int
@Extern(name = "scoop_io_tcp_listen")
internal fun nativeTcpListen(loop: Ptr<Unit>, id: Long, address: IoAddress, backlog: Int, reuse: Boolean): Int
@Extern(name = "scoop_io_tcp_connect_cancel")
internal fun nativeTcpConnectCancel(loop: Ptr<Unit>, id: Long)
@Extern(name = "scoop_io_tcp_accept")
internal fun nativeTcpAccept(tcp: Ptr<Unit>, id: Long): Int
@Extern(name = "scoop_io_accept_cancel")
internal fun nativeTcpAcceptCancel(tcp: Ptr<Unit>, id: Long)
@Extern(name = "scoop_io_tcp_address")
private fun nativeTcpAddress(tcp: Ptr<Unit>, peer: Boolean): NativeSocketName
@Extern(name = "scoop_io_tcp_close")
internal fun nativeTcpClose(tcp: Ptr<Unit>, id: Long): Int
@Extern(name = "scoop_io_tcp_read")
internal fun nativeTcpRead(tcp: Ptr<Unit>, id: Long, bytes: Ptr<Byte>?, count: Long): Int
@Extern(name = "scoop_io_read_cancel")
internal fun nativeTcpReadCancel(tcp: Ptr<Unit>, id: Long)
@Extern(name = "scoop_io_tcp_write")
internal fun nativeTcpWrite(tcp: Ptr<Unit>, id: Long, bytes: Ptr<Byte>?, count: Long): Int
@Extern(name = "scoop_io_tcp_write_cancel")
internal fun nativeTcpWriteCancel(tcp: Ptr<Unit>, id: Long)
@Extern(name = "scoop_io_tcp_shutdown")
internal fun nativeTcpShutdown(tcp: Ptr<Unit>, id: Long): Int
