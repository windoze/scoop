package scoop.json

internal fun writeJsonString(text: String, output: StringBuilder) {
    val hex = "0123456789abcdef"
    output.append('"')
    for (character in text) {
        when (character) {
            case '"' -> { output.append("\\\"") }
            case '\\' -> { output.append("\\\\") }
            case '\u{8}' -> { output.append("\\b") }
            case '\u{c}' -> { output.append("\\f") }
            case '\n' -> { output.append("\\n") }
            case '\r' -> { output.append("\\r") }
            case '\t' -> { output.append("\\t") }
            else -> {
                val code = character.code
                if (code < 32) {
                    output.append("\\u00")
                    output.append(hex[(code / 16).toInt64()])
                    output.append(hex[(code % 16).toInt64()])
                } else { output.append(character) }
            }
        }
    }
    output.append('"')
}

internal fun writeJson(value: JsonNode, output: StringBuilder) {
    when (value) {
        case JsonNode.Null -> { output.append("null") }
        case JsonNode.BooleanValue(result) -> { output.append(result) }
        case JsonNode.Number(text) -> { output.append(text) }
        case JsonNode.Text(text) -> { writeJsonString(text, output) }
        case JsonNode.Record(members) -> {
            output.append('{')
            var first: Boolean = true
            for (member in members) {
                if (!first) { output.append(',') }
                first = false
                writeJsonString(member.name, output)
                output.append(':')
                writeJson(member.value, output)
            }
            output.append('}')
        }
        case JsonNode.Sequence(elements) -> {
            output.append('[')
            var first: Boolean = true
            for (element in elements) {
                if (!first) { output.append(',') }
                first = false
                writeJson(element, output)
            }
            output.append(']')
        }
    }
}

internal fun renderJson(value: JsonNode): String {
    val output = StringBuilder()
    writeJson(value, output)
    return output.toString()
}
