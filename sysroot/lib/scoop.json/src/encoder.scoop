package scoop.json

internal enum JsonEncodingContainer {
    Unselected,
    Single,
    Record(JsonKeyedEncoder),
    Sequence(JsonUnkeyedEncoder)
}

internal class JsonEncoder(public override val path: String)
    : Encoder, SingleValueEncodingContainer {
    private var container: JsonEncodingContainer = JsonEncodingContainer.Unselected
    private var output: Option<JsonNode> = None
    private var committed: Boolean = false

    internal fun checkWritable() {
        if (committed) { throw EncodingException(path, "a value is already committed") }
    }

    internal fun begin() {
        checkWritable()
        output = None
    }

    internal fun finish(value: JsonNode) {
        checkWritable()
        output = Some(value)
    }

    internal fun result(): JsonNode {
        return when (output) {
            case Some(_) -> {
                committed = true
                output!!
            }
            case None -> { throw EncodingException(path, "a value is incomplete") }
        }
    }

    public override fun keyed(): KeyedEncodingContainer {
        return when (container) {
            case JsonEncodingContainer.Record(view) -> view
            case JsonEncodingContainer.Unselected -> {
                val view = JsonKeyedEncoder(this)
                container = JsonEncodingContainer.Record(view)
                view
            }
            else -> { throw EncodingException(path, "a different container is already selected") }
        }
    }

    public override fun unkeyed(): UnkeyedEncodingContainer {
        return when (container) {
            case JsonEncodingContainer.Sequence(view) -> view
            case JsonEncodingContainer.Unselected -> {
                val view = JsonUnkeyedEncoder(this)
                container = JsonEncodingContainer.Sequence(view)
                view
            }
            else -> { throw EncodingException(path, "a different container is already selected") }
        }
    }

    public override fun singleValue(): SingleValueEncodingContainer {
        when (container) {
            case JsonEncodingContainer.Single -> { return this }
            case JsonEncodingContainer.Unselected -> { container = JsonEncodingContainer.Single }
            else -> { throw EncodingException(path, "a different container is already selected") }
        }
        return this
    }

    private fun write(value: JsonNode) {
        checkWritable()
        when (container) {
            case JsonEncodingContainer.Single -> {
                when (output) {
                    case Some(_) -> { throw EncodingException(path, "a value was written twice") }
                    case None -> { output = Some(value) }
                }
            }
            else -> { throw EncodingException(path, "a single-value container was not selected") }
        }
    }

    internal fun writeNumberToken(text: String): Unit = write(JsonNode.Number(text))

    public override fun writeBoolean(value: Boolean): Unit = write(JsonNode.BooleanValue(value))
    public override fun writeLong(value: Long): Unit = write(JsonNode.Number(value.toString()))
    public override fun writeULong(value: ULong): Unit = write(JsonNode.Number(value.toString()))
    public override fun writeFloat(value: Float) {
        if (!value.isFinite()) { throw EncodingException(path, "expected a finite Float") }
        write(JsonNode.Number(value.toString()))
    }
    public override fun writeDouble(value: Double) {
        if (!value.isFinite()) { throw EncodingException(path, "expected a finite Double") }
        write(JsonNode.Number(value.toString()))
    }
    public override fun writeString(value: String): Unit = write(JsonNode.Text(value))
    public override fun writeNull(): Unit = write(JsonNode.Null)
}
