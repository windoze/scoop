package scoop.json

public object Json {
    public fun <T> encode(value: T, codec: Encodable<T>): String {
        val encoder = JsonEncoder("")
        codec.encode(value, encoder)
        return renderJson(encoder.result())
    }

    public fun <T> decode(text: String, codec: Decodable<T>): T {
        val decoder = JsonDecoder(JsonParser(text).parse(), "")
        val result = codec.decode(decoder)
        decoder.requireComplete()
        return result
    }
}

internal enum JsonValue {
    Null,
    BooleanValue(Boolean),
    Number(String),
    Text(String),
    Record(ArrayList<JsonMember>),
    Sequence(ArrayList<JsonValue>)
}

internal struct JsonMember(val name: String, val value: JsonValue)

internal fun childPath(path: String, name: String): String {
    val result = StringBuilder().add(path).add("/")
    for (character in name) {
        when (character) {
            case '~' -> { result.add("~0") }
            case '/' -> { result.add("~1") }
            else -> { result.add(character) }
        }
    }
    return result.build()
}
