package crypto.consumer

import scoop.crypto.*
import scoop.crypto.jws.*
import scoop.test.*

@Test
private class JwsConsumerTests {
    @Test
    fun `public JWS enum keys and verified payload cross Cone boundaries`() {
        PrivateKey.generate(KeyAlgorithm.Ed25519).use { privateKey ->
            val payload: Array<Byte> = [1.toByte(), 2.toByte(), 3.toByte()]
            val token = signCompact("{\"alg\":\"EdDSA\",\"kid\":\"local\"}", payload, JwsAlgorithm.EdDSA, JwsSigningKey.Signature(privateKey))
            privateKey.publicKey().use { publicKey ->
                val result = verifyCompactOrNull(token, JwsAlgorithm.EdDSA, JwsVerificationKey.Signature(publicKey))!!
                assertEquals("local", result.keyId!!)
                assertEquals(3L, result.payload.size)
                assertEquals(2.toByte(), result.payload[1L])
            }
        }
    }
}
