package scoop.crypto.jws

import scoop.crypto.*
import scoop.test.*
import scoop.text.*

@Test
private class JwsTests {
    @Test
    fun `HS256 external vector preserves original header and payload`() {
        val key = SecretKey.fromBytes(Array<Byte>(32L) { index -> index.toByte() })
        try {
            val header = "{ \"kid\": \"interop\", \"alg\": \"HS256\" }"
            val payload = "Scoop JWS interoperability".toByteArray()
            assertEquals(hs256Token(), signCompact(header, payload, JwsAlgorithm.HS256, JwsSigningKey.Mac(key)))
            val verified = verifyCompactOrNull(hs256Token(), JwsAlgorithm.HS256, JwsVerificationKey.Mac(key))!!
            assertEquals(header, verified.protectedHeader)
            assertEquals("interop", verified.keyId!!)
            assertEquals(payload.toHexString(), verified.payload.toHexString())
            val parts = hs256Token().split('.')
            assertMissing(verifyCompactOrNull(parts[0L] + ".Y2hhbmdlZA." + parts[2L], JwsAlgorithm.HS256, JwsVerificationKey.Mac(key)))
            assertMissing(verifyCompactOrNull(urlEncoding.encode("{\"alg\":\"HS256\",\"kid\":\"interop\"}".toByteArray()) + "." + parts[1L] + "." + parts[2L], JwsAlgorithm.HS256, JwsVerificationKey.Mac(key)))
            val empty = signCompact("{\"alg\":\"HS256\",\"b64\":true}", ArrayList<Byte>(), JwsAlgorithm.HS256, JwsSigningKey.Mac(key))
            assertEquals(0L, verifyCompactOrNull(empty, JwsAlgorithm.HS256, JwsVerificationKey.Mac(key))!!.payload.size)
        } finally { key.close() }
    }

    @Test
    fun `RSA PSS and ES256 JWK interoperability`() {
        importJwk(rsaJwk()).use { key ->
            assertPayload(rs256Token(), JwsAlgorithm.RS256, key)
            assertPayload(ps256Token(), JwsAlgorithm.PS256, key)
            assertEquals(rsaPublicPem(), key.toPem())
        }
        importJwk(ecJwk()).use { key ->
            assertPayload(es256Token(), JwsAlgorithm.ES256, key)
            assertEquals(ecPublicPem(), key.toPem())
        }
        roundTripJws(rsaPrivatePem(), JwsAlgorithm.RS256)
        roundTripJws(rsaPrivatePem(), JwsAlgorithm.PS256)
        roundTripJws(ecPrivatePem(), JwsAlgorithm.ES256)
    }

    @Test
    fun `RFC 8037 EdDSA compact signature and public JWK`() {
        val token = "eyJhbGciOiJFZERTQSJ9.RXhhbXBsZSBvZiBFZDI1NTE5IHNpZ25pbmc." +
            "hgyY0il_MGCjP0JzlnLWG1PPOt7-09PGcvMg3AIbQR6dWbhijcNR4ki4iylGjg5BhVsPt9g7sVvpAr_MuM0KAg"
        val jwk = "{\"kty\":\"OKP\",\"crv\":\"Ed25519\",\"x\":\"11qYAYKxCrfVS_7TyWQHOg7hcvPapiMlrwIaaPcHURo\"}"
        val seed = "302e020100300506032b6570042204209d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60".hexToByteArray()
        importJwk(jwk).use { publicKey ->
            val verified = verifyCompactOrNull(token, JwsAlgorithm.EdDSA, JwsVerificationKey.Signature(publicKey))!!
            assertEquals("Example of Ed25519 signing".toByteArray().toHexString(), verified.payload.toHexString())
            PrivateKey.fromDer(seed).use { key ->
                assertEquals(token, signCompact(verified.protectedHeader, verified.payload, JwsAlgorithm.EdDSA, JwsSigningKey.Signature(key)))
            }
        }
    }

    @Test
    fun `format algorithm critical fields and key role failures`() {
        SecretKey.fromBytes(Array<Byte>(32L) { _ -> 1.toByte() }).use { key ->
            val headers: Array<String> = ["{}", "[]", "{\"alg\":\"none\"}", "{\"alg\":1}",
                "{\"alg\":\"HS256\",\"crit\":[]}", "{\"alg\":\"HS256\",\"b64\":false}",
                "{\"alg\":\"HS256\",\"b64\":1}", "{\"alg\":\"HS256\",\"kid\":null}",
                "{\"alg\":\"HS256\",\"alg\":\"HS256\"}"]
            for (header in headers) assertFailsWith<JwsException> { signCompact(header, ArrayList<Byte>(), JwsAlgorithm.HS256, JwsSigningKey.Mac(key)) }
            val prefix = hs256Token().split('.')[0L]
            val invalid: Array<String> = ["a.b", "a.b.c.d", "=.e30.AA", "_w.e30.AA", prefix + ".e3=.AA", prefix + ".e30.A+", prefix + ".e30.AB"]
            for (token in invalid) assertFailsWith<JwsException> { verifyCompactOrNull(token, JwsAlgorithm.HS256, JwsVerificationKey.Mac(key)) }
            assertFailsWith<IllegalArgumentException> { verifyCompactOrNull(rs256Token(), JwsAlgorithm.RS256, JwsVerificationKey.Mac(key)) }
        }
        SecretKey.fromBytes("short".toByteArray()).use { key ->
            assertFailsWith<IllegalArgumentException> { verifyCompactOrNull(hs256Token(), JwsAlgorithm.HS256, JwsVerificationKey.Mac(key)) }
        }
        importJwk(ecJwk()).use { key ->
            assertFailsWith<IllegalArgumentException> { verifyCompactOrNull(hs256Token(), JwsAlgorithm.HS256, JwsVerificationKey.Signature(key)) }
            assertFailsWith<IllegalArgumentException> { verifyCompactOrNull(rs256Token(), JwsAlgorithm.RS256, JwsVerificationKey.Signature(key)) }
            val parts = es256Token().split('.')
            assertFailsWith<JwsException> { verifyCompactOrNull(parts[0L] + "." + parts[1L] + ".AA", JwsAlgorithm.ES256, JwsVerificationKey.Signature(key)) }
        }
    }

    @Test
    fun `JWK rejects private fields malformed parameters and invalid public points`() {
        val invalid: Array<String> = ["{\"kty\":\"oct\",\"k\":\"AA\"}", "{\"kty\":\"RSA\",\"n\":\"AA\",\"e\":\"AQAB\"}",
            "{\"kty\":\"OKP\",\"crv\":\"X25519\",\"x\":\"AA\"}", "{\"kty\":\"EC\",\"crv\":\"P-256\",\"x\":\"AA\",\"y\":\"AA\"}"]
        for (jwk in invalid) assertFailsWith<JwsException> { importJwk(jwk) }
        assertFailsWith<JwsException> { importJwk("{\"d\":\"AA\",\"kty\":\"RSA\"}") }
        assertFailsWith<CryptoException> { importJwk("{\"kty\":\"RSA\",\"n\":\"AQ\",\"e\":\"AQ\"}") }
        val zero = "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
        assertFailsWith<CryptoException> { importJwk("{\"kty\":\"EC\",\"crv\":\"P-256\",\"x\":\"" + zero + "\",\"y\":\"" + zero + "\"}") }
    }
}

private fun assertMissing(result: VerifiedJws?) {
    assertTrue(when (result) { case None -> true; case Some(_) -> false })
}

private fun assertPayload(token: String, algorithm: JwsAlgorithm, key: PublicKey) {
    val result = verifyCompactOrNull(token, algorithm, JwsVerificationKey.Signature(key))!!
    assertEquals("Scoop JWS interoperability".toByteArray().toHexString(), result.payload.toHexString())
}

private fun roundTripJws(pem: String, algorithm: JwsAlgorithm) {
    PrivateKey.fromPem(pem).use { key ->
        val token = signCompact("{\"alg\":\"" + algorithmName(algorithm) + "\"}", "round trip".toByteArray(), algorithm, JwsSigningKey.Signature(key))
        if (algorithm == JwsAlgorithm.ES256) assertEquals(64L, decodePart(token.split('.')[2L]).size)
        key.publicKey().use { publicKey ->
            assertEquals("round trip".toByteArray().toHexString(), verifyCompactOrNull(token, algorithm, JwsVerificationKey.Signature(publicKey))!!.payload.toHexString())
        }
    }
}
