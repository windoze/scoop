package scoop.crypto

import scoop.test.*
import scoop.text.*

@Test
private class DigestTests {
    @Test
    fun `SHA standard vectors and incremental state`() {
        val data = "abc".toByteArray()
        assertEquals("ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad",
            digest(DigestAlgorithm.SHA256, data).toHexString())
        assertEquals("cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7",
            digest(DigestAlgorithm.SHA384, data).toHexString())
        assertEquals("ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f",
            digest(DigestAlgorithm.SHA512, data).toHexString())
        Digest(DigestAlgorithm.SHA256).use { context ->
            context.update("a".toByteArray())
            context.update(Array<Byte>(0L) { _ -> 0.toInt8() })
            context.update("bc".toByteArray())
            assertEquals(digest(DigestAlgorithm.SHA256, data).toHexString(), context.finish().toHexString())
            assertFailsWith<IllegalStateException> { context.update(data) }
            assertFailsWith<IllegalStateException> { context.finish() }
        }
        assertEquals("e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
            digest(DigestAlgorithm.SHA256, Array<Byte>(0L) { _ -> 0.toInt8() }).toHexString())
        val closed = Digest(DigestAlgorithm.SHA512)
        closed.close()
        closed.close()
        assertFailsWith<IllegalStateException> { closed.finish() }
    }

    @Test
    fun `secure random counts and explicit secret lifetime`() {
        assertEquals(0L, secureRandomBytes(0L).size)
        val first = secureRandomBytes(32L)
        val second = secureRandomBytes(32L)
        assertEquals(32L, first.size)
        assertNotEquals(first.toHexString(), second.toHexString())
        assertFailsWith<IllegalArgumentException> { secureRandomBytes(-1L) }
        val input = MutableArray<Byte>(16L) { _ -> 7.toInt8() }
        val key = SecretKey.fromBytes(input)
        input[0L] = 8.toInt8()
        assertEquals(7.toInt8(), key.exportBytes()[0L])
        key.dispose()
        key.dispose()
        assertFailsWith<IllegalStateException> { key.exportBytes() }
    }
}
