// Scoop sysroot: thread surface（std v3，early stage）
//
// 说明：
// - public API 保留为 Scoop wrapper；底层 OS thread primitive 归 `scoop.thread` cone-local native-build 所有。
// - `threadSpawn` 使用 `GcHandle.raw` 作为 native userdata token，避免把 GC ref 裸传给 OS thread trampoline。
// - 线程句柄采用引用类型 `class Thread`（opaque handle），避免值类型 copy/析构语义在 early stage 过早复杂化。

package scoop.thread

import scoop.core.*

/// 线程句柄（opaque handle；语义由 std/runtime 约定）。
class Thread

/// 创建一个新线程执行 `block`，并返回可用于 `join` 的句柄。
///
/// 说明（early stage 语义约定）：
/// - 当前阶段只要求 "spawn + join" 的最小 happy path 可回归；
/// - 不做取消、优先级、thread-local 初始化顺序保证等更复杂语义；
/// - `block` 作为 OS 线程入口，必须在静态上等价于 `Pure!`；
/// - 因此未显式写函数类型的纯 closure / 纯函数值也允许传入；
/// - native trampoline 只持有 stable GC handle token，实际调用在 Scoop entry shim 中恢复 closure。
@Extern(name = "scoop_thread_spawn", abi = "scoop")
private fun __scoop_thread_spawn(entryHandleRaw: UIntPtr): Thread

fun threadSpawn(block: () -> Unit / Pure!): Thread {
    val entryHandle: GcHandle = @Unsafe do { GC.handleNew(block) }
    return __scoop_thread_spawn(entryHandle.raw)
}

@CallingConvention(name = "scoop_thread_entry_trampoline", convention = "C")
public fun __scoop_thread_entry_trampoline(entryHandleRaw: UIntPtr): Unit {
    val entryHandle = GcHandle(entryHandleRaw)
    val erased: Any = @Unsafe do { GC.handleGet(entryHandle) }
    val restored: (() -> Unit / Pure!)? = erased as? (() -> Unit / Pure!)
    when (restored) {
        Some(entry) -> entry()
        None -> panic("invalid scoop.thread entry handle")
    }
}

/// 等待该线程执行完成（join）。
@Extern(name = "scoop_thread_join", abi = "scoop")
private fun __scoop_thread_join(thread: Thread): Unit

fun Thread.join(): Unit {
    __scoop_thread_join(this)
}

/// 让出当前线程的时间片（hint）。
@Extern(name = "scoop_thread_yield", abi = "scoop")
private fun __scoop_thread_yield(): Unit

fun yield(): Unit {
    __scoop_thread_yield()
}

/// 休眠当前线程指定毫秒数（<=0 则直接返回）。
@Extern(name = "scoop_thread_sleep_millis", abi = "scoop")
private fun __scoop_thread_sleep_millis(ms: Int): Unit

fun sleepMillis(ms: Int): Unit {
    __scoop_thread_sleep_millis(ms)
}

/// 返回当前线程的 platform thread id（若平台支持）。
///
/// 返回值约定：
/// - 返回 0 表示平台不支持或获取失败；
/// - 返回非 0 表示一个可观测但不承诺跨平台稳定的线程标识符。
@Extern(name = "scoop_thread_current_id", abi = "scoop")
private fun __scoop_thread_current_id(): Int

fun currentId(): Int {
    return __scoop_thread_current_id()
}
