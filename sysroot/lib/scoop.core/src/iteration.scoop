public interface Iterator<T> {
    public fun next(): Option<T>
}

public interface Iterable<T> {
    public operator fun iterator(): Iterator<T>
}

internal class ArrayIterator<T> internal constructor(
    private val source: Array<T>,
    private var index: Long
) : Iterator<T> {
    public override fun next(): Option<T> {
        if (index < source.size) {
            val value = source[index]
            index = index + 1L
            return Some(value)
        }
        return None
    }
}

internal class MutableArrayIterator<T> internal constructor(
    private val source: MutableArray<T>,
    private var index: Long
) : Iterator<T> {
    public override fun next(): Option<T> {
        if (index < source.size) {
            val value = source[index]
            index = index + 1L
            return Some(value)
        }
        return None
    }
}
