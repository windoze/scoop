public interface ToString {
    public fun toString(): String
}

public interface Hash {
    public fun hash(): Int
}

@Intrinsic("core_int")
public struct Int : ToString, Hash {
    public operator fun equals(other: Int): Boolean = coreIntEquals(this, other)

    @Intrinsic("int_unary_plus")
    public operator fun unaryPlus(): Int

    @Intrinsic("int_unary_minus")
    public operator fun unaryMinus(): Int

    @Intrinsic("int_inc")
    public operator fun inc(): Int

    @Intrinsic("int_dec")
    public operator fun dec(): Int

    @Intrinsic("int_add")
    public operator fun plus(other: Int): Int

    @Intrinsic("int_sub")
    public operator fun minus(other: Int): Int

    @Intrinsic("int_mul")
    public operator fun times(other: Int): Int

    @Intrinsic("int_div")
    public operator fun div(other: Int): Int

    @Intrinsic("int_rem")
    public operator fun rem(other: Int): Int

    @Intrinsic("int_compare_to")
    public operator fun compareTo(other: Int): Int

    public override fun toString(): String = coreIntToString(this)

    public override fun hash(): Int = coreIntHash(this)
}

@Intrinsic("core_uint")
public struct UInt : ToString, Hash {
    public operator fun equals(other: UInt): Boolean = coreUIntEquals(this, other)

    @Intrinsic("uint_unary_plus")
    public operator fun unaryPlus(): UInt

    @Intrinsic("uint_inc")
    public operator fun inc(): UInt

    @Intrinsic("uint_dec")
    public operator fun dec(): UInt

    @Intrinsic("uint_add")
    public operator fun plus(other: UInt): UInt

    @Intrinsic("uint_sub")
    public operator fun minus(other: UInt): UInt

    @Intrinsic("uint_mul")
    public operator fun times(other: UInt): UInt

    @Intrinsic("uint_div")
    public operator fun div(other: UInt): UInt

    @Intrinsic("uint_rem")
    public operator fun rem(other: UInt): UInt

    @Intrinsic("uint_compare_to")
    public operator fun compareTo(other: UInt): Int

    public override fun toString(): String = coreUIntToString(this)

    public override fun hash(): Int = coreUIntHash(this)
}

@Intrinsic("core_boolean")
public struct Boolean : ToString, Hash {
    public operator fun equals(other: Boolean): Boolean = coreBooleanEquals(this, other)

    @Intrinsic("boolean_not")
    public operator fun not(): Boolean

    public override fun toString(): String = coreBooleanToString(this)

    public override fun hash(): Int = coreBooleanHash(this)
}

@Intrinsic("core_string")
public class String : ToString, Hash {
    public operator fun equals(other: String): Boolean = coreStringEquals(this, other)

    @Intrinsic("string_concat")
    public operator fun plus(other: String): String

    @Intrinsic("string_compare_to")
    public operator fun compareTo(other: String): Int

    public override fun toString(): String = this

    public override fun hash(): Int = coreStringHash(this)
}

@Intrinsic("core_array")
public class Array<T> {
    @Intrinsic("array_get")
    public operator fun get(index: Int): T

    @Intrinsic("array_to_mutable")
    public fun toMutableArray(): MutableArray<T>
}

@Intrinsic("core_mutable_array")
public class MutableArray<T> {
    @Intrinsic("mutable_array_get")
    public operator fun get(index: Int): T

    @Intrinsic("mutable_array_set")
    public operator fun set(index: Int, value: T)

    @Intrinsic("array_to_immutable")
    public fun toArray(): Array<T>
}

// Representation-level operations used by the ordinary source methods above.
// They are regular Scoop-ABI FFI declarations, not compiler capability hooks.
@Extern(name = "scoop_rt_int_equals", abi = "scoop")
internal fun coreIntEquals(left: Int, right: Int): Boolean

@Extern(name = "scoop_rt_uint_equals", abi = "scoop")
internal fun coreUIntEquals(left: UInt, right: UInt): Boolean

@Extern(name = "scoop_rt_bool_equals", abi = "scoop")
internal fun coreBooleanEquals(left: Boolean, right: Boolean): Boolean

@Extern(name = "scoop_rt_string_eq", abi = "scoop")
internal fun coreStringEquals(left: String, right: String): Boolean

@Extern(name = "scoop_rt_int_to_string", abi = "scoop")
internal fun coreIntToString(value: Int): String

@Extern(name = "scoop_rt_uint_to_string", abi = "scoop")
internal fun coreUIntToString(value: UInt): String

@Extern(name = "scoop_rt_bool_to_string", abi = "scoop")
internal fun coreBooleanToString(value: Boolean): String

@Extern(name = "scoop_rt_int_hash", abi = "scoop")
internal fun coreIntHash(value: Int): Int

@Extern(name = "scoop_rt_uint_hash", abi = "scoop")
internal fun coreUIntHash(value: UInt): Int

@Extern(name = "scoop_rt_bool_hash", abi = "scoop")
internal fun coreBooleanHash(value: Boolean): Int

@Extern(name = "scoop_rt_string_hash", abi = "scoop")
internal fun coreStringHash(value: String): Int
