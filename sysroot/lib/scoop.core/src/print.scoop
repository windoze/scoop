// Scoop sysroot: print/println compiled support source.

package scoop.core

import scoop.core.*

// `core.scoop` 保留 resolver/typecheck 可见的泛型签名；本文件提供可编译 body，
// 让 monomorphization 为每个具体 `T: ToString` 生成实例。

public fun <T> print(value: T): Unit where T: ToString {
    __scoop_print(value.toString())
}

public fun <T> println(value: T): Unit where T: ToString {
    __scoop_println(value.toString())
}
