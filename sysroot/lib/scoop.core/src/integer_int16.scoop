@Intrinsic("core_int16")
public struct Int16 :
    Add<Int16, Int16>,
    Sub<Int16, Int16>,
    Mul<Int16, Int16>,
    Div<Int16, Int16>,
    Rem<Int16, Int16>,
    UnaryPlus<Int16>,
    UnaryMinus<Int16>,
    Increment<Int16>,
    Decrement<Int16>,
    Compare<Int16>,
    RangeTo<Int16, IntRange>,
    RangeUntil<Int16, IntRange>,
    Equality<Int16>, ToString, Hash {
    @NoGC @Intrinsic("int16_to_float")
    public fun toFloat(): Float

    @NoGC @Intrinsic("int16_to_double")
    public fun toDouble(): Double

    @NoGC
    @Intrinsic("int16_equals")
    public operator fun equals(other: Int16): Boolean

    @NoGC
    public override fun equalTo(other: Int16): Boolean = this.equals(other)

    @NoGC
    @Intrinsic("int16_unary_plus")
    public override operator fun unaryPlus(): Int16

    @NoGC
    @Intrinsic("int16_unary_minus")
    public override operator fun unaryMinus(): Int16

    @NoGC
    @Intrinsic("int16_inc")
    public override operator fun inc(): Int16

    @NoGC
    @Intrinsic("int16_dec")
    public override operator fun dec(): Int16

    @NoGC
    @Intrinsic("int16_add")
    public override operator fun plus(other: Int16): Int16

    @NoGC
    @Intrinsic("int16_sub")
    public override operator fun minus(other: Int16): Int16

    @NoGC
    @Intrinsic("int16_mul")
    public override operator fun times(other: Int16): Int16

    @Intrinsic("int16_div")
    public override operator fun div(other: Int16): Int16

    @Intrinsic("int16_rem")
    public override operator fun rem(other: Int16): Int16

    @NoGC
    @Intrinsic("int16_compare_to")
    public override operator fun compareTo(other: Int16): Long

    @NoGC
    @Intrinsic("int16_and")
    public infix fun and(other: Int16): Int16

    @NoGC
    @Intrinsic("int16_or")
    public infix fun or(other: Int16): Int16

    @NoGC
    @Intrinsic("int16_xor")
    public infix fun xor(other: Int16): Int16

    @NoGC
    @Intrinsic("int16_inv")
    public fun inv(): Int16

    @NoGC
    @Intrinsic("int16_shl")
    public infix fun shl(count: Long): Int16

    @NoGC
    @Intrinsic("int16_shr")
    public infix fun shr(count: Long): Int16

    @NoGC
    @Intrinsic("int16_ushr")
    public infix fun ushr(count: Long): Int16

    @NoGC
    @Intrinsic("int16_to_int8")
    public fun toInt8(): Int8

    @NoGC
    @Intrinsic("int16_to_int16")
    public fun toInt16(): Int16

    @NoGC
    @Intrinsic("int16_to_int")
    public fun toInt32(): Int

    @NoGC
    @Intrinsic("int16_to_long")
    public fun toInt64(): Long

    @NoGC
    @Intrinsic("int16_to_uint8")
    public fun toUInt8(): UInt8

    @NoGC
    @Intrinsic("int16_to_uint16")
    public fun toUInt16(): UInt16

    @NoGC
    @Intrinsic("int16_to_uint")
    public fun toUInt32(): UInt

    @NoGC
    @Intrinsic("int16_to_ulong")
    public fun toUInt64(): ULong

    public override operator fun rangeTo(endpoint: Int16): IntRange =
        IntRange(this.toInt32(), endpoint.toInt32(), 1, false, true)

    public override operator fun rangeUntil(endpoint: Int16): IntRange =
        IntRange(this.toInt32(), endpoint.toInt32(), 1, false, false)

    public infix fun until(endpoint: Int16): IntRange =
        IntRange(this.toInt32(), endpoint.toInt32(), 1, false, false)

    public infix fun downTo(endpoint: Int16): IntRange =
        IntRange(this.toInt32(), endpoint.toInt32(), 1, true, true)

    public override fun toString(): String = coreLongToString(this.toInt64())

    public override fun hash(): Long = coreLongHash(this.toInt64())

    public companion object : Encodable<Int16>, Decodable<Int16> {
        public const val MIN_VALUE: Int16 = -32768
        public const val MAX_VALUE: Int16 = 32767

        public override fun encode(value: Int16, encoder: Encoder): Unit =
            encoder.singleValue().writeLong(value.toInt64())

        public override fun decode(decoder: Decoder): Int16 =
            decodeSigned(decoder, -32768L, 32767L).toInt16()
    }
}
