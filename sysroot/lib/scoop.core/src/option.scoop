// The Option type (spec 7.2). `T?` desugars to `Option<T>`, and the
// variant names `Some` / `None` are resolvable without a prefix
// (spec 4.2, 5.1).
public enum Option<T> {
    Some(T),
    None

    public companion object {
        public fun encoder(element: Encodable<T>): Encodable<Option<T>> = OptionEncoder<T>(element)

        public fun decoder(element: Decodable<T>): Decodable<Option<T>> = OptionDecoder<T>(element)
    }
}
