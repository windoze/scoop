    @Intrinsic("int_unary_minus")
    public operator fun unaryMinus(): UInt64
    @Intrinsic("int_unary_plus")
    public operator fun unaryPlus(): UInt64
    @Intrinsic("int_inc")
    public operator fun inc(): UInt64
    @Intrinsic("int_dec")
    public operator fun dec(): UInt64
    @Intrinsic("int_and")
    public operator fun and(other: UInt64): UInt64
    @Intrinsic("int_or")
    public operator fun or(other: UInt64): UInt64
    @Intrinsic("int_xor")
    public operator fun xor(other: UInt64): UInt64
    @Intrinsic("int_inv")
    public operator fun inv(): UInt64
    @Intrinsic("int_shl")
    public operator fun shl(amount: Int): UInt64
    @Intrinsic("int_shr")
    public operator fun shr(amount: Int): UInt64
    @Intrinsic("int_ushr")
    public operator fun ushr(amount: Int): UInt64
    @Intrinsic("int_lt")
    public operator fun lt(other: UInt64): Bool
    @Intrinsic("int_le")
    public operator fun le(other: UInt64): Bool
    @Intrinsic("int_gt")
    public operator fun gt(other: UInt64): Bool
    @Intrinsic("int_ge")
    public operator fun ge(other: UInt64): Bool
    @Intrinsic("int_eq")
    public operator fun equals(other: UInt64): Bool
    @Intrinsic("int_ne")
    public operator fun notEquals(other: UInt64): Bool
    @Intrinsic("int_compare_to")
    public operator fun compareTo(other: UInt64): Int
}

// Kotlin-like ranges/progressions（Appendix B.12）所需的核心类型表面。

// ---- print / println（泛型，编译时为每个 T: ToString 单态化）----
public fun <T> print(value: T): Unit where T: ToString {
    __scoop_print(value.toString())
}

public fun <T> println(value: T): Unit where T: ToString {
    __scoop_println(value.toString())
}

// ---- Option ----
public enum Option<T> {
    Some(val value: T),
    None
}

// ---- Continuation（spec §5.5）----
public interface Continuation<Resume, Answer, eff E = Pure> {
    public fun resume(value: Resume): Answer / E
}

// ---- RuntimeError ----
public enum RuntimeError {
    NullAssertionFailed,
    ClassCastFailed,
    ContinuationAlreadyResumed,
}

// ---- Built-in effect: Raise ----
public effect Raise<in E> {
    public fun raise(error: E): Nothing
}
