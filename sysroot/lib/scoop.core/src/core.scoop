// Scoop sysroot (early stage)
//
// 说明：
// - sysroot 是编译器内建 API 的"声明源"（便于 IDE/文档/规范一致）
// - 早期阶段这里只放最小集合，随着实现推进逐步补齐

package scoop.core

import scoop.unsafe.*

@Extern(name = "scoop_bool_to_string", abi = "scoop")
fun __scoop_bool_to_string(value: Bool): String

@Extern(name = "scoop_char_to_string", abi = "scoop")
fun __scoop_char_to_string(value: Char): String

@Extern(name = "scoop_int_to_string", abi = "scoop")
fun __scoop_int_to_string(value: Int): String

@Extern(name = "scoop_float32_to_string", abi = "scoop")
fun __scoop_float32_to_string(value: Float32): String

@Extern(name = "scoop_float64_to_string", abi = "scoop")
fun __scoop_float64_to_string(value: Float64): String

@Extern(name = "scoop_string_unsafe_slice_bytes", abi = "scoop")
fun __scoop_string_unsafe_slice_bytes(value: String, byteOffset: Int, byteLength: Int): String

// Root types
interface Any
sealed interface AnyRef
sealed interface AnyValue

// 基础接口：Hashable（spec §2.2.2 / std v1）。
//
// 说明：
// - 当前阶段 typecheck 尚未支持"普通成员函数调用"（class/interface methods），`receiver.hash()`
//   仍主要走"扩展函数调用"的最小子集；但 `where T: Hashable` 等约束已经会被验证；
// - 为避免在 early stage 对所有内建类型强制补齐成员实现，这里先提供一个默认实现（有 body → 非抽象）。
//   后续当虚方法/接口调用链路落地后，可再把默认实现收紧为更合理的实现策略。
interface Hashable {
    fun hash(): Int {
        return 0
    }
}

// ToString 接口：统一的文本转换表面。
//
// 说明：
// - 任何类型实现 `ToString` 即可被传入泛型 `print`/`println`（`where T: ToString`）。
// - 内建标量与 String 通过各自的 intrinsic type body method 实现。
// - 用户自定义类型只需在 class/struct 上声明 `: ToString` 并提供 `fun toString(): String` 即可。
// - 默认实现（有 body）用于避免 interface implementation check 在 early stage 报错；
//   后续可收紧为抽象方法。
interface ToString {
    fun toString(): String {
        return ""
    }
}

// Built-in scalar types（声明层 + intrinsic body methods）。
//
// 说明：
// - 这些类型的布局/语义由编译器与运行时固定；
// - `toString` 走普通 method body；operator/helper surface 走 method-level intrinsic 声明。
@Intrinsic
struct Bool : Hashable, ToString {
    override fun toString(): String {
        return __scoop_bool_to_string(this)
    }

    @Intrinsic("bool_and")
    fun and(other: Bool): Bool

    @Intrinsic("bool_or")
    fun or(other: Bool): Bool

    @Intrinsic("bool_xor")
    fun xor(other: Bool): Bool

    @Intrinsic("bool_eq")
    fun equals(other: Bool): Bool

    @Intrinsic("bool_ne")
    fun notEquals(other: Bool): Bool

    @Intrinsic("bool_not")
    fun not(): Bool
}

@Intrinsic
struct Char : Hashable, ToString {
    override fun toString(): String {
        return __scoop_char_to_string(this)
    }

    @Intrinsic("char_to_int")
    fun toInt(): Int

    @Intrinsic("char_hash")
    fun hash(): Int

    @Intrinsic("char_compare_to")
    fun compareTo(other: Char): Int

    @Intrinsic("char_equals")
    fun equals(other: Char): Bool

    @Intrinsic("char_plus_int")
    fun plus(offset: Int): Char

    @Intrinsic("char_minus_int")
    fun minus(offset: Int): Char

    @Intrinsic("char_minus_char")
    fun minus(other: Char): Int
}

@Intrinsic
struct Float64 : Hashable, ToString {
    override fun toString(): String {
        return __scoop_float64_to_string(this)
    }

    @Intrinsic
    fun toInt(): Int

    @Intrinsic("float_plus")
    fun plus(other: Float64): Float64

    @Intrinsic("float_minus")
    fun minus(other: Float64): Float64

    @Intrinsic("float_times")
    fun times(other: Float64): Float64

    @Intrinsic("float_div")
    fun div(other: Float64): Float64

    @Intrinsic("float_rem")
    fun rem(other: Float64): Float64

    @Intrinsic("float_unary_minus")
    fun unaryMinus(): Float64

    @Intrinsic("float_unary_plus")
    fun unaryPlus(): Float64

    @Intrinsic("float_lt")
    fun lt(other: Float64): Bool

    @Intrinsic("float_le")
    fun le(other: Float64): Bool

    @Intrinsic("float_gt")
    fun gt(other: Float64): Bool

    @Intrinsic("float_ge")
    fun ge(other: Float64): Bool

    @Intrinsic("float_eq")
    fun equals(other: Float64): Bool

    @Intrinsic("float_ne")
    fun notEquals(other: Float64): Bool

    @Intrinsic("float_compare_to")
    fun compareTo(other: Float64): Int

    @Intrinsic("float_abs")
    fun abs(): Float64

    @Intrinsic("float_is_nan")
    fun isNaN(): Bool

    @Intrinsic("float_is_infinite")
    fun isInfinite(): Bool

    @Intrinsic("float_hash")
    fun hash(): Int
}

@Intrinsic
struct Float32 : Hashable, ToString {
    override fun toString(): String {
        return __scoop_float32_to_string(this)
    }

    @Intrinsic
    fun toInt(): Int

    @Intrinsic("float_plus")
    fun plus(other: Float32): Float32

    @Intrinsic("float_minus")
    fun minus(other: Float32): Float32

    @Intrinsic("float_times")
    fun times(other: Float32): Float32

    @Intrinsic("float_div")
    fun div(other: Float32): Float32

    @Intrinsic("float_rem")
    fun rem(other: Float32): Float32

    @Intrinsic("float_unary_minus")
    fun unaryMinus(): Float32

    @Intrinsic("float_unary_plus")
    fun unaryPlus(): Float32

    @Intrinsic("float_lt")
    fun lt(other: Float32): Bool

    @Intrinsic("float_le")
    fun le(other: Float32): Bool

    @Intrinsic("float_gt")
    fun gt(other: Float32): Bool

    @Intrinsic("float_ge")
    fun ge(other: Float32): Bool

    @Intrinsic("float_eq")
    fun equals(other: Float32): Bool

    @Intrinsic("float_ne")
    fun notEquals(other: Float32): Bool

    @Intrinsic("float_compare_to")
    fun compareTo(other: Float32): Int

    @Intrinsic("float_abs")
    fun abs(): Float32

    @Intrinsic("float_is_nan")
    fun isNaN(): Bool

    @Intrinsic("float_is_infinite")
    fun isInfinite(): Bool

    @Intrinsic("float_hash")
    fun hash(): Int
}

@Intrinsic
class String : Hashable, ToString {
    override fun toString(): String {
        return this
    }

    fun length(): Int {
        return __scoop_string_length(this)
    }

    fun toInt(): Int {
        return __scoop_string_to_int(this)
    }

    fun concat(other: String): String {
        return __scoop_string_concat(this, other)
    }

    fun hash(): Int {
        return __scoop_string_hash(this)
    }

    fun isEmpty(): Bool {
        return __scoop_string_is_empty(this)
    }

    fun replace(old: String, new: String): String {
        return __scoop_string_replace(this, old, new)
    }

    fun charAt(index: Int): Int {
        return __scoop_string_char_at(this, index)
    }

    fun repeat(n: Int): String {
        return __scoop_string_repeat(this, n)
    }

    fun compareTo(other: String): Int {
        return __scoop_string_compare_to(this, other)
    }

    fun trimIndent(): String {
        return __scoop_string_trim_indent(this)
    }

    @Unsafe
    fun unsafeSliceBytes(byteOffset: Int, byteLength: Int): String {
        return __scoop_string_unsafe_slice_bytes(this, byteOffset, byteLength)
    }
}
typealias Double = Float64
// 泛型数组类型（compile-time + runtime 表面）。
//
// 说明：
// - layout 仍由编译器/runtime 固定；
// - `size/get/set` 等基础访问通过 method-level named intrinsic lowering 接到编译器的
//   array intrinsic 表，而不是再靠 `scoop.core.size/get/set` 的 extension + codegen 按名分流。
@Intrinsic
class Array<T> {
    @Intrinsic("array_size_inline")
    fun size(): Int

    @Intrinsic("array_get_inline")
    fun get(index: Int): T

    @Intrinsic("array_data_ptr_inline")
    fun __dataPtr(): UIntPtr
}

// 可变泛型数组类型（runtime 表面）。
//
// 说明：
// - `MutableArray<T>` 是 collections 的唯一可变集合底座；
// - 基础读写与 `Array<T>` 一样走 named intrinsic 表；真正涉及分配/搬移/GC 协作的路径仍由
//   stdlib helper + runtime substrate 承接。
@Intrinsic
class MutableArray<T> {
    @Intrinsic("array_size_outofline")
    fun size(): Int

    @Intrinsic("array_get_outofline")
    fun get(index: Int): T

    @Intrinsic("array_set_outofline")
    fun set(index: Int, value: T): Unit

    @Intrinsic("array_data_ptr_outofline")
    fun __dataPtr(): UIntPtr
}

@Extern(name = "scoop_mutable_array_new", abi = "scoop")
fun __scoop_mutable_array_new(
    elemKind: Int,
    elemSize: Int,
    elemAlign: Int,
    elemDesc: UIntPtr,
    capacity: Int,
): MutableArray<Any>

@Extern(name = "scoop_mutable_array_push_word", abi = "scoop")
fun __scoop_mutable_array_push_word(arr: MutableArray<Any>, value: UIntPtr): Unit

@Extern(name = "scoop_mutable_array_push_ref", abi = "scoop")
fun __scoop_mutable_array_push_ref(arr: MutableArray<Any>, value: Any): Unit

@Extern(name = "scoop_mutable_array_push_composite", abi = "scoop")
fun __scoop_mutable_array_push_composite(arr: MutableArray<Any>, slot: UIntPtr, elemSize: Int): Unit

@Extern(name = "scoop_mutable_array_freeze", abi = "scoop")
fun __scoop_mutable_array_freeze(arr: MutableArray<Any>): Array<Any>

@Extern(name = "scoop_mutable_array_to_array_data", abi = "scoop")
fun __scoop_mutable_array_to_array_data(arr: MutableArray<Any>): UIntPtr

fun <T> mutableArrayNew(capacity: Int = ARRAY_ELEM_KIND_WORD - ARRAY_ELEM_KIND_WORD): MutableArray<T> {
    val raw: MutableArray<Any> = __scoop_mutable_array_new(
        kindOf<T>(),
        sizeOf<T>(),
        alignOf<T>(),
        descOf<T>(),
        capacity,
    )
    return @Unsafe do { __scoop_unsafe_mutable_array_cast<T>(raw) }
}

fun <T> MutableArray<T>.push(value: T): Unit {
    val kind: Int = kindOf<T>()
    val raw: MutableArray<Any> = @Unsafe do { __scoop_unsafe_mutable_array_erase<T>(this) }

    if (kind == ARRAY_ELEM_KIND_WORD) {
        val word: UIntPtr = @Unsafe do { __scoop_unsafe_value_to_word<T>(value) }
        __scoop_mutable_array_push_word(raw, word)
        return
    }

    if (kind == ARRAY_ELEM_KIND_REF) {
        val refValue: Any = @Unsafe do { __scoop_unsafe_value_to_any<T>(value) }
        __scoop_mutable_array_push_ref(raw, refValue)
        return
    }

    if (kind == ARRAY_ELEM_KIND_COMPOSITE) {
        val slot: UIntPtr = @Unsafe do { __scoop_unsafe_value_slot<T>(value) }
        __scoop_mutable_array_push_composite(raw, slot, sizeOf<T>())
        return
    }
}

fun <T> MutableArray<T>.freeze(): Array<T> {
    val raw: Array<Any> = __scoop_mutable_array_freeze(@Unsafe do { __scoop_unsafe_mutable_array_erase<T>(this) })
    return @Unsafe do { __scoop_unsafe_array_cast<T>(raw) }
}

// Kotlin-like collections：List / MutableList（std v1）。
//
// 说明：
// - v0 先把 `List<T>`/`MutableList<T>` 作为 `Array<T>`/`MutableArray<T>` 的类型别名，
//   以便在不引入新布局/新 intrinsic 的前提下，先把常用 API 表面固定下来；
// - 后续若需要更强的语义区分（例如只读视图 vs 不可变值、或更丰富的接口层级），
//   可在保持现有别名兼容的前提下逐步演进（例如增加 `scoop.collections` 的接口表面）。
typealias List<T> = Array<T>
typealias MutableList<T> = MutableArray<T>

// 静态元数据列表（spec §5）。
//
// 说明：
// - 该类型用于承载反射 intrinsics（`fieldsOf`/`variantsOf`/...）返回的静态元数据集合；
// - v0 阶段先把它作为纯声明面，具体可迭代/索引语义由后续反射元数据 lowering 补齐。
class MetaList<T>
struct Unit
enum Nothing

// Built-in annotations（spec §15.5）。
//
// 说明：
// - annotation 是 compile-time marker surface，不是普通 runtime nominal type；
// - 这些注解由编译器识别并在不同子系统中被消费（typecheck/lowering/codegen/...）；
// - sysroot 在这里提供"声明面"，用于名字解析、类型检查与工具链可见性；
// - 当前阶段先补齐缺失的内建注解集合与 `AnnotationTarget` enum，
//   更完整的 meta-annotation 规则（`@Target/@Retention` 约束）由后续任务实现。

enum AnnotationTarget {
    Function,
    Property,
    Field,
    Param,
    Type,
    Constructor,
    LocalVariable,
    Expression,
    Module,
    TypeParam,
    EnumVariant,
}

annotation class TailRec
// `@AllowIntrinsic`：文件 / 模块级 gate。
//
// 说明：
// - `@Intrinsic` declaration surface 只允许 trusted `syslib` source 持有；
// - 用户源码和普通 `lib` cone 不能通过文件级注解打开 intrinsic 权限。
annotation class AllowIntrinsic
annotation class Deprecated(val message: String = "", val replaceWith: String = "")
// `@Suppress`：warning suppression surface。
//
// 说明：
// - 支持 expression / declaration / `@file:...` 三类 surface；
// - 当前稳定 warning code：`deprecated` / `enum-size-disparity` / `redundant-when-else`。
annotation class Suppress(vararg val warnings: String)
// `@Experimental(feature = "...")`：保留的 feature-gate marker surface。
//
// 说明：
// - 当前只保留 built-in marker 与参数校验，不接入任何具体 experimental feature；
// - 规范 use-site 形状固定为 `@Experimental(feature = "...")`。
annotation class Experimental(val feature: String)
// `@CLayout(aligned?, packed?)`（spec §15.5.2）：
// - `aligned`：可选的结构体整体对齐（0 表示未指定）
// - `packed`：可选的 pack 值（0 表示未指定；v0 仅支持 packed = 1）
annotation class CLayout(val aligned: Int = 0, val packed: Int = 0)
annotation class Target(val targets: AnnotationTarget)
annotation class Retention(val policy: String)
annotation class ThreadLocal
annotation class Global

fun abs(x: Int): Int {
    if (x < 0) {
        return -x
    }
    return x
}

// I/O（内部 runtime 映射）。
//
// 说明：
// - `__scoop_print` / `__scoop_println` 是 scoop ABI runtime 映射的内部函数；
// - 泛型 `print<T>` / `println<T>`（在 sysroot/lib/scoop.core/src/print.scoop 中定义）调用这些内部函数。
@Extern(name = "scoop_print", abi = "scoop")
fun __scoop_print(value: String): Unit
@Extern(name = "scoop_println", abi = "scoop")
fun __scoop_println(value: String): Unit

// GC pinning API（spec §15.10）。
//
// 说明：
// - 该 API 用于把某个 heap 对象标记为 pinned，供把对象地址交给外部系统（FFI/异步 I/O）时使用；
// - v0（非移动 mark-sweep）阶段 pin 的主要效果是：把对象视为额外 roots，避免在无 shadow stack 引用时被 sweep；
// - `Pinned` 是 Scoop 侧 pin handle，不是 ordinary `@Extern` 的长期 token surface；丢弃 handle 不会自动 unpin（资源泄漏）；每次 pin 必须配对一次 unpin。
@Intrinsic
object GC {
    // Stable GC handles（spec §15.10.1）。
    //
    // 说明：
    // - 用于把 heap 对象引用以"稳定 token"形式交给 native 长期持有（token 稳定，对象地址可变化）；
    // - `GcHandle.raw` 可作为 `UIntPtr` 经 `@Extern` 往返 native state；复制 `GcHandle` / `.raw`
    //   不会克隆底层 handle record，因此每次 `handleNew` 仍只允许一次 `handleDrop`；
    // - stale handle 的 runtime lookup 会失败；语言级 `handleGet` / `handleDrop` 会把它视为错误；
    // - ordinary `@Extern` / reactor / callback 的长期 round-trip 应通过 `GcHandle.raw`
    //   （word-sized `UIntPtr` token）；需要时再在 Scoop 侧重建 `GcHandle`；
    // - 该组函数由编译器以 intrinsic 方式 lowering 到 runtime `scoop_handle_*`。
    @Intrinsic @Unsafe
    fun handleNew(obj: Any): GcHandle

    @Intrinsic @NoGC @Unsafe
    fun handleGet(h: GcHandle): Any

    @Intrinsic @NoGC @Unsafe
    fun handleDrop(h: GcHandle): Unit

    @Intrinsic @NoGC @Unsafe
    fun pin(obj: Any): Pinned

    @Intrinsic @NoGC @Unsafe
    fun unpin(pinned: Pinned): Unit
}

// Opaque token. Representation is toolchain-defined but must be stably passable to native code.
struct GcHandle(val raw: UIntPtr)

// Value type handle. Exact fields are implementation-defined (spec §15.10).
// 仅用于短时裸地址借出；不承担 reactor / callback 的长期 wake-token 语义，也不能直接作为 ordinary `@Extern` ABI token。
struct Pinned(val value: Any)

// Static metadata（spec §5 / §10.4）。
//
// 说明：
// - 这些类型承载编译器发布的静态元数据：
//   - 反射 intrinsics（如 `fieldsOf<T>()`）会返回它们的 `MetaList<...>`；
//   - delegated properties lowering 会把 `PropertyMeta` 作为隐式参数传给 `getValue/setValue`（spec §10.4）。
// - 当前阶段已实现"可回归的最小集合"：
//   - `TypeMeta`：类型名 + kind + 注解列表
//   - `FieldMeta`：字段名 + 字段类型 + 字段序号 + 注解列表
//   - `VariantMeta`：enum variant 名 + 字段列表 + 序号 + 注解列表
//   - `ParamMeta`：函数参数名 + 参数类型 + 序号 + 注解列表
//   - `PropertyMeta`：属性名 + 属性类型 + owner 类型
// - 说明：注解参数值仅保证字面量、枚举值和 class literal 等静态参数可读；更复杂表达式与导出规则后续任务补齐。
enum TypeKind {
    Struct,
    Enum,
    Class,
    Interface,
    Effect,
    Tuple,
    Primitive,
}

struct TypeMeta {
    val name: String
    val kind: TypeKind
    val annotations: MetaList<AnnotationMeta>
}

struct FieldMeta {
    val name: String
    val type: TypeMeta
    val index: Int
    val annotations: MetaList<AnnotationMeta>
}

struct VariantMeta {
    val name: String
    val fields: MetaList<FieldMeta>
    val index: Int
    val annotations: MetaList<AnnotationMeta>
}

struct ParamMeta {
    val name: String
    val type: TypeMeta
    val index: Int
    val annotations: MetaList<AnnotationMeta>
}

struct PropertyMeta {
    val name: String
    val type: TypeMeta
    val owner: TypeMeta
}

// Function meta（spec §6.4）。
//
// 说明：
// - v0 阶段先只暴露"函数名"作为可构造的句柄，用于 `paramsOf(fn)` 等反射 intrinsics；
// - 更完整的 `FunctionMeta`（params/returnType/annotations）可在后续阶段升级，
//   但应保持"可用 name 构造句柄"这一能力（避免影响工具链/fixtures）。
struct FunctionMeta {
    val name: String
}

// Static annotation metadata（spec §15.6）。
//
// 说明：
// - 用于读取注解名与参数（`annotationsOf<T>()` 等）；参数值为静态注解参数；
// - v0 阶段先要求"注解名 + 静态参数"可回归：字面量/数组字面量/enum 常量/class literal；
// - 更复杂的表达式（例如函数调用、运行期依赖值）与跨 cone 导出规则后续补齐。
struct AnnotationMeta {
    val name: String
    val args: MetaList<AnnotationArgMeta>
}

struct AnnotationArgMeta {
    val name: String
    val value: Any
}

// Integers（spec §2.3.4 / runtime §3）
//
// word-sized：随 target 指针宽度变化（Swift 约定）。
@Intrinsic
struct Int : Hashable, ToString {
    override fun toString(): String {
        return __scoop_int_to_string(this)
    }

    @Intrinsic("int_plus")
    fun plus(other: Int): Int

    @Intrinsic("int_minus")
    fun minus(other: Int): Int

    @Intrinsic("int_times")
    fun times(other: Int): Int

    @Intrinsic("int_div")
    fun div(other: Int): Int

    @Intrinsic("int_rem")
    fun rem(other: Int): Int

    @Intrinsic("int_unary_minus")
    fun unaryMinus(): Int

    @Intrinsic("int_unary_plus")
    fun unaryPlus(): Int

    @Intrinsic("int_inc")
    fun inc(): Int

    @Intrinsic("int_dec")
    fun dec(): Int

    @Intrinsic("int_and")
    fun and(other: Int): Int

    @Intrinsic("int_or")
    fun or(other: Int): Int

    @Intrinsic("int_xor")
    fun xor(other: Int): Int

    @Intrinsic("int_inv")
    fun inv(): Int

    @Intrinsic("int_shl")
    fun shl(amount: Int): Int

    @Intrinsic("int_shr")
    fun shr(amount: Int): Int

    @Intrinsic("int_ushr")
    fun ushr(amount: Int): Int

    @Intrinsic("int_lt")
    fun lt(other: Int): Bool

    @Intrinsic("int_le")
    fun le(other: Int): Bool

    @Intrinsic("int_gt")
    fun gt(other: Int): Bool

    @Intrinsic("int_ge")
    fun ge(other: Int): Bool

    @Intrinsic("int_eq")
    fun equals(other: Int): Bool

    @Intrinsic("int_ne")
    fun notEquals(other: Int): Bool

    @Intrinsic("int_compare_to")
    fun compareTo(other: Int): Int

    @Intrinsic("int_hash")
    fun hash(): Int
}

struct UInt : Hashable {
    @Intrinsic("int_plus")
    fun plus(other: UInt): UInt

    @Intrinsic("int_minus")
    fun minus(other: UInt): UInt

    @Intrinsic("int_times")
    fun times(other: UInt): UInt

    @Intrinsic("int_div")
    fun div(other: UInt): UInt

    @Intrinsic("int_rem")
    fun rem(other: UInt): UInt

    @Intrinsic("int_unary_minus")
