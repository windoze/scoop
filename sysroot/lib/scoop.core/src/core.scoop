// Scoop sysroot (minimal) —— 语言必须的最小集合。
//
// 精简原则：只保留语言/编译器必需的类型与函数；辅助功能（progression、反射、原子、
// GC、Platform、sizeOf、delegates、sync、thread、collections、lang.string 扩展、runtime.test）
// 暂时移除，后续逐步加回。
//
// 保留：基础标量类型、Any/Hashable/ToString、String（字节级 substrate）、Array/MutableArray、
// Option、Continuation、RuntimeError、panic、println/print、UIntPtr。

package scoop.core

// ---- runtime extern 声明（@Extern(abi="scoop")）----
@Extern(name = "scoop_bool_to_string", abi = "scoop")
fun __scoop_bool_to_string(value: Bool): String

@Extern(name = "scoop_char_to_string", abi = "scoop")
fun __scoop_char_to_string(value: Char): String

@Extern(name = "scoop_int_to_string", abi = "scoop")
fun __scoop_int_to_string(value: Int): String

@Extern(name = "scoop_float32_to_string", abi = "scoop")
fun __scoop_float32_to_string(value: Float32): String

@Extern(name = "scoop_float64_to_string", abi = "scoop")
fun __scoop_float64_to_string(value: Float64): String

@Extern(name = "scoop_string_unsafe_slice_bytes", abi = "scoop")
fun __scoop_string_unsafe_slice_bytes(value: String, byteOffset: Int, byteLength: Int): String

@Extern(name = "scoop_print", abi = "scoop")
fun __scoop_print(value: String): Unit

@Extern(name = "scoop_println", abi = "scoop")
fun __scoop_println(value: String): Unit

@Extern(name = "scoop_panic", abi = "scoop")
public fun panic(message: String): Nothing

// ---- 根类型 ----
public interface Any

public interface Hashable {
    public fun hash(): Int {
        return 0
    }
}

public interface ToString {
    public fun toString(): String {
        return ""
    }
}

// ---- 基础标量类型（@Intrinsic 类型，intrinsic body methods）----
@Intrinsic
public struct Bool : Hashable, ToString {
    public override fun toString(): String {
        return __scoop_bool_to_string(this)
    }

    @Intrinsic("bool_and")
    public operator fun and(other: Bool): Bool

    @Intrinsic("bool_or")
    public operator fun or(other: Bool): Bool

    @Intrinsic("bool_xor")
    public operator fun xor(other: Bool): Bool

    @Intrinsic("bool_eq")
    public operator fun equals(other: Bool): Bool

    @Intrinsic("bool_ne")
    public operator fun not(): Bool
}

@Intrinsic
public struct Char : Hashable, ToString {
    public override fun toString(): String {
        return __scoop_char_to_string(this)
    }

    @Intrinsic("char_to_int")
    public fun toInt(): Int

    public override fun hash(): Int {
        return this.toInt()
    }

    @Intrinsic("char_compare_to")
    public operator fun compareTo(other: Char): Int

    @Intrinsic("char_equals")
    public operator fun equals(other: Char): Bool

    @Intrinsic("char_plus_int")
    public operator fun plus(offset: Int): Char

    @Intrinsic("char_minus_int")
    public operator fun minus(offset: Int): Char

    @Intrinsic("char_minus_char")
    public operator fun minus(other: Char): Int
}

@Intrinsic
public struct Float64 : Hashable, ToString {
    public override fun toString(): String {
        return __scoop_float64_to_string(this)
    }

    @Intrinsic("float_plus")
    public operator fun plus(other: Float64): Float64

    @Intrinsic("float_minus")
    public operator fun minus(other: Float64): Float64

    @Intrinsic("float_times")
    public operator fun times(other: Float64): Float64

    @Intrinsic("float_div")
    public operator fun div(other: Float64): Float64

    @Intrinsic("float_rem")
    public operator fun rem(other: Float64): Float64

    @Intrinsic("float_unary_minus")
    public operator fun unaryMinus(): Float64

    @Intrinsic("float_unary_plus")
    public operator fun unaryPlus(): Float64

    @Intrinsic("float_compare_to")
    public operator fun compareTo(other: Float64): Int

    @Intrinsic("float_equals")
    public operator fun equals(other: Float64): Bool

    @Intrinsic("float_to_int")
    public fun toInt(): Int
}

@Intrinsic
public struct Float32 : Hashable, ToString {
    public override fun toString(): String {
        return __scoop_float32_to_string(this)
    }

    @Intrinsic("float_plus")
    public operator fun plus(other: Float32): Float32

    @Intrinsic("float_minus")
    public operator fun minus(other: Float32): Float32

    @Intrinsic("float_times")
    public operator fun times(other: Float32): Float32

    @Intrinsic("float_div")
    public operator fun div(other: Float32): Float32

    @Intrinsic("float_rem")
    public operator fun rem(other: Float32): Float32

    @Intrinsic("float_unary_minus")
    public operator fun unaryMinus(): Float32

    @Intrinsic("float_unary_plus")
    public operator fun unaryPlus(): Float32

    @Intrinsic("float_compare_to")
    public operator fun compareTo(other: Float32): Int

    @Intrinsic("float_equals")
    public operator fun equals(other: Float32): Bool

    @Intrinsic("float_to_int")
    public fun toInt(): Int
}

// ---- String（字节级 substrate；算法在 string.scoop）----
public class String : Hashable, ToString {
    public override fun toString(): String {
        return this
    }

    public fun concat(other: String): String {
        return __scoop_string_concat(this, other)
    }

    @Unsafe
    public fun unsafeSliceBytes(byteOffset: Int, byteLength: Int): String {
        return __scoop_string_unsafe_slice_bytes(this, byteOffset, byteLength)
    }

    // 字节级 substrate（被 string.scoop 算法依赖）。
    // byteLength → runtime scoop_string_byte_length；getByte → runtime scoop_string_bytes + 索引 load。
    @Intrinsic("string_byte_length")
    public fun byteLength(): Int

    @Intrinsic("string_get_byte")
    public fun getByte(index: Int): Int
}

@Extern(name = "scoop_string_concat", abi = "scoop")
fun __scoop_string_concat(a: String, b: String): String

@Intrinsic("float64_to_int")
public fun Float64.toInt(): Int

@Intrinsic("float32_to_int")
public fun Float32.toInt(): Int

@Intrinsic("bool_to_string")
public fun Bool.toString(): String

@Intrinsic("char_to_string")
public fun Char.toString(): String

@Intrinsic("int_to_string")
public fun Int.toString(): String

@Intrinsic("float32_to_string")
public fun Float32.toString(): String

@Intrinsic("float64_to_string")
public fun Float64.toString(): String

// ---- Array / MutableArray ----
public class Array<T> {
    @Intrinsic("array_size_inline")
    public fun size(): Int

    @Intrinsic("array_get_inline")
    public operator fun get(index: Int): T

    @Intrinsic("array_data_ptr_inline")
    public fun __dataPtr(): UIntPtr
}

public class MutableArray<T> {
    @Intrinsic("array_size_outofline")
    public fun size(): Int

    @Intrinsic("array_set_outofline")
    public operator fun set(index: Int, value: T): Unit

    @Intrinsic("array_get_outofline")
    public operator fun get(index: Int): T
}

public struct MetaList<T>

// ---- Unit / Nothing ----
public struct Unit
public enum Nothing

// ---- UIntPtr（地址大小整数）----
@Intrinsic
public struct UIntPtr : Hashable, ToString {
    public override fun toString(): String {
        return __scoop_int_to_string(this.toInt())
    }

    @Intrinsic("int_plus")
    public operator fun plus(other: UIntPtr): UIntPtr

    @Intrinsic("int_to_int")
    public fun toInt(): Int
}

public struct Int : Hashable, ToString {
    public override fun toString(): String {
        return __scoop_int_to_string(this)
    }

    @Intrinsic("int_plus")
    public operator fun plus(other: Int): Int

    @Intrinsic("int_minus")
    public operator fun minus(other: Int): Int

    @Intrinsic("int_times")
    public operator fun times(other: Int): Int

    @Intrinsic("int_div")
    public operator fun div(other: Int): Int

    @Intrinsic("int_rem")
    public operator fun rem(other: Int): Int

    @Intrinsic("int_unary_minus")
    public operator fun unaryMinus(): Int

    @Intrinsic("int_unary_plus")
    public operator fun unaryPlus(): Int

    @Intrinsic("int_inc")
    public operator fun inc(): Int

    @Intrinsic("int_dec")
    public operator fun dec(): Int

    @Intrinsic("int_and")
    public operator fun and(other: Int): Int

    @Intrinsic("int_or")
    public operator fun or(other: Int): Int

    @Intrinsic("int_xor")
    public operator fun xor(other: Int): Int

    @Intrinsic("int_inv")
    public operator fun inv(): Int

    @Intrinsic("int_shl")
    public operator fun shl(amount: Int): Int

    @Intrinsic("int_shr")
    public operator fun shr(amount: Int): Int

    @Intrinsic("int_ushr")
    public operator fun ushr(amount: Int): Int

    @Intrinsic("int_lt")
    public operator fun lt(other: Int): Bool

    @Intrinsic("int_le")
    public operator fun le(other: Int): Bool

    @Intrinsic("int_gt")
    public operator fun gt(other: Int): Bool

    @Intrinsic("int_ge")
    public operator fun ge(other: Int): Bool

    @Intrinsic("int_eq")
    public operator fun equals(other: Int): Bool

    @Intrinsic("int_ne")
    public operator fun notEquals(other: Int): Bool

    @Intrinsic("int_compare_to")
    public operator fun compareTo(other: Int): Int

    @Intrinsic("int_hash")
    public fun hash(): Int
}

