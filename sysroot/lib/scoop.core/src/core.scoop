// Kotlin-like ranges/progressions（Appendix B.12）所需的核心类型表面。
struct IntProgression(val first: Int, val last: Int, val step: Int, val increasing: Bool)
struct LongProgression(val first: Long, val last: Long, val step: Long, val increasing: Bool)
struct UIntProgression(val first: UInt, val last: UInt, val step: UInt, val increasing: Bool)
struct ULongProgression(val first: ULong, val last: ULong, val step: ULong, val increasing: Bool)

// 标准别名（Kotlin/Swift 风格）。
typealias Byte = UInt8
typealias Short = Int16
typealias UShort = UInt16
typealias Long = Int64
typealias ULong = UInt64
typealias UIntPtr = UInt

fun __scoop_range_default_step(sample: Int): Int {
    return 1
}

fun __scoop_range_default_step(sample: Long): Long {
    return 1
}

fun __scoop_range_default_step(sample: UInt): UInt {
    return 1u
}

fun __scoop_range_default_step(sample: ULong): ULong {
    return 1UL
}

fun Int.rangeTo(endInclusive: Int, step: Int): IntProgression {
    return IntProgression {
        first: this,
        last: endInclusive,
        step: step,
        increasing: true,
    }
}

fun Int.downTo(endInclusive: Int, step: Int): IntProgression {
    return IntProgression {
        first: this,
        last: endInclusive,
        step: step,
        increasing: false,
    }
}

fun Int.until(endExclusive: Int): IntProgression {
    val one: Int = __scoop_range_default_step(this)
    return this.rangeTo(endExclusive - one, one)
}

fun <eff E = Pure> IntProgression.forEach(action: (Int) -> Unit / E): Unit / E {
    var cur: Int = this.first
    when (this.increasing) {
        true -> {
            while (cur <= this.last) {
                action(cur)
                if (cur == this.last) {
                    break
                }
                cur = cur + this.step
            }
        }
        false -> {
            while (cur >= this.last) {
                action(cur)
                if (cur == this.last) {
                    break
                }
                cur = cur - this.step
            }
        }
    }
    return ()
}

fun Long.rangeTo(endInclusive: Long, step: Long): LongProgression {
    return LongProgression {
        first: this,
        last: endInclusive,
        step: step,
        increasing: true,
    }
}

fun Long.downTo(endInclusive: Long, step: Long): LongProgression {
    return LongProgression {
        first: this,
        last: endInclusive,
        step: step,
        increasing: false,
    }
}

fun Long.until(endExclusive: Long): LongProgression {
    val one: Long = __scoop_range_default_step(this)
    return this.rangeTo(endExclusive - one, one)
}

fun <eff E = Pure> LongProgression.forEach(action: (Long) -> Unit / E): Unit / E {
    var cur: Long = this.first
    when (this.increasing) {
        true -> {
            while (cur <= this.last) {
                action(cur)
                if (cur == this.last) {
                    break
                }
                cur = cur + this.step
            }
        }
        false -> {
            while (cur >= this.last) {
                action(cur)
                if (cur == this.last) {
                    break
                }
                cur = cur - this.step
            }
        }
    }
    return ()
}

fun UInt.rangeTo(endInclusive: UInt, step: UInt): UIntProgression {
    return UIntProgression {
        first: this,
        last: endInclusive,
        step: step,
        increasing: true,
    }
}

fun UInt.downTo(endInclusive: UInt, step: UInt): UIntProgression {
    return UIntProgression {
        first: this,
        last: endInclusive,
        step: step,
        increasing: false,
    }
}

fun UInt.until(endExclusive: UInt): UIntProgression {
    val one: UInt = __scoop_range_default_step(this)
    if (endExclusive == 0u) {
        return UIntProgression {
            first: one,
            last: endExclusive,
            step: one,
            increasing: true,
        }
    }
    return this.rangeTo(endExclusive - one, one)
}

fun <eff E = Pure> UIntProgression.forEach(action: (UInt) -> Unit / E): Unit / E {
    var cur: UInt = this.first
    when (this.increasing) {
        true -> {
            while (cur <= this.last) {
                action(cur)
                if (cur == this.last) {
                    break
                }
                cur = cur + this.step
            }
        }
        false -> {
            while (cur >= this.last) {
                action(cur)
                if (cur == this.last) {
                    break
                }
                cur = cur - this.step
            }
        }
    }
    return ()
}

fun ULong.rangeTo(endInclusive: ULong, step: ULong): ULongProgression {
    return ULongProgression {
        first: this,
        last: endInclusive,
        step: step,
        increasing: true,
    }
}

fun ULong.downTo(endInclusive: ULong, step: ULong): ULongProgression {
    return ULongProgression {
        first: this,
        last: endInclusive,
        step: step,
        increasing: false,
    }
}

fun ULong.until(endExclusive: ULong): ULongProgression {
    val one: ULong = __scoop_range_default_step(this)
    if (endExclusive == 0UL) {
        return ULongProgression {
            first: one,
            last: endExclusive,
            step: one,
            increasing: true,
        }
    }
    return this.rangeTo(endExclusive - one, one)
}

fun <eff E = Pure> ULongProgression.forEach(action: (ULong) -> Unit / E): Unit / E {
    var cur: ULong = this.first
    when (this.increasing) {
        true -> {
            while (cur <= this.last) {
                action(cur)
                if (cur == this.last) {
                    break
                }
                cur = cur + this.step
            }
        }
        false -> {
            while (cur >= this.last) {
                action(cur)
                if (cur == this.last) {
                    break
                }
                cur = cur - this.step
            }
        }
    }
    return ()
}

// Compiler intrinsics（spec §15.7）。
//
// 说明：
// - 泛型反射 intrinsic 由编译器在运行期 lowering 中识别；
// - typecheck 的"跨文件泛型函数签名 lowering"也未补齐，因此这里先用一组 overload 作为最小可调用表面：
//   - `sizeOf(1)` / `sizeOf("s")`
// - 该声明仅用于工具链可见性与类型检查；实现由编译器在 codegen 阶段内建 lowering 提供。
@Intrinsic
fun sizeOf(value: Int): Int
@Intrinsic
fun sizeOf(value: String): Int

// Reflection intrinsics v0。
//
// 说明：
// - 这些函数只保留运行期 intrinsic surface；旧 compile-time evaluator 已删除。
// - 当前阶段 `fieldsOf<T>()` 返回 `FieldMeta` 列表。
@Intrinsic
fun <T> nameOf(): String
@Intrinsic
fun <T> sizeOf(): Int
@Intrinsic
fun <T> alignOf(): Int
@Intrinsic
fun <T> kindOf(): Int
@Intrinsic
fun <T> descOf(): UIntPtr
@Intrinsic
fun <T> fieldsOf(): MetaList<FieldMeta>
@Intrinsic
fun <T> variantsOf(): MetaList<VariantMeta>
@Intrinsic
fun <T> superTypesOf(): MetaList<TypeMeta>
@Intrinsic
fun <T> annotationsOf(): MetaList<AnnotationMeta>
@Intrinsic
fun paramsOf(fn: FunctionMeta): MetaList<ParamMeta>

val ARRAY_ELEM_KIND_WORD: Int = 1
val ARRAY_ELEM_KIND_REF: Int = 2
val ARRAY_ELEM_KIND_COMPOSITE: Int = 3

// Platform Introspection（spec §6.4）。
//
// 说明：
// - `Platform` 表示一个平台选择器（LLVM target triple + 拆分字段）；
// - `getPlatform()` 在运行期查询当前执行环境；
// - 当前阶段先只保证 host target 可回归，交叉编译与更严格校验后续补齐。
struct Platform {
    val triple: String
    val arch: String
    val vendor: String
    val os: String
    val env: String
}

@Intrinsic
fun getPlatform(): Platform

// Option / nullable sugar
enum Option<T> {
    Some(val value: T),
    None
}

// Continuation（spec §5.5）
//
// 说明：
// - `Continuation<Resume, Answer, eff E>` 是源码可见的 compiler-owned interface：
//   `Resume` 是 resume payload，`Answer` 是最近 delimiter 的结果类型，`E` 是 resumed-step
//   的 required effects；
// - 按 spec §5.3.1 / §5.5，源码层只保留普通方法调用 `k.resume(...)`；`resume(...): Answer`
//   在 resumed computation 正常完成最近 delimiter 时返回该 delimiter 的 answer type；
// - `E` 表示恢复该 continuation 可能执行的效果集合（required effects）。
// - `Continuation<Unit, Answer>` 允许 `k.resume()` 作为 `k.resume(())` 的 sugar；
//   更一般地，单一 `Unit` 参数 callable 允许 `f()` 作为 `f(())` 的 sugar；
// - 若 resume payload 是 tuple，应把 tuple 值作为单一实参传递，例如 `k.resume((a, b))`；
//   不再保留 tuple payload 扁平传参或专用 resume surface。
// - 用户态 handler surface 只保留 `Effect.op(args) -> expr` 与 `Effect.op(args), k -> expr`；
//   `-> resume` 已从语言语法移除，若编译器内部仍保留 tail-resume fast path，只能视为 lowering/codegen
//   优化分类而不是独立 surface。
// - 运行期语义 / one-shot 约束见 spec §5.5 与 `SCOOP_RUNTIME.md` 第 10 节。
interface Continuation<Resume, Answer, eff E = Pure> {
    fun resume(value: Resume): Answer / (E + Raise<RuntimeError>)
}

// Runtime errors expressed via `Raise<RuntimeError>` (spec §5.7).
enum RuntimeError {
    NullAssertionFailed,
    ClassCastFailed,
    ContinuationAlreadyResumed,
}

// Fatal trap runtime boundary.
//
// 说明：
// - `panic(message)` 用于表达“不应继续执行”的 fatal trap / invariant break；
// - 它返回 `Nothing`，因此类型检查与控制流分析会把它视为 bottom；
// - 当前 runtime 仍允许把它实现为 `exit(3)` / 等价立即终止，但该细节必须隐藏在
//   core / runtime 边界后，而不是继续暴露为用户直接调用的 process-style surface。
@Extern(name = "scoop_panic", abi = "scoop")
fun panic(message: String): Nothing

// Built-in effect: Raise
effect Raise<in E> {
    fun raise(error: E): Nothing
}

// Explicit heap cells for shared state. `RefCell` is single-threaded and
// mutable; `Box` is an immutable wrapper used when an extra heap indirection is
// required by library APIs such as atomic value snapshots.
class RefCell<T>(initial: T) {
    var value: T = initial
}

class Box<T>(val value: T)

fun __atomicBoolToInt(value: Bool): Int {
    if (value) {
        return 1
    }
    return 0
}

fun __atomicIntToBool(value: Int): Bool {
    return value != 0
}

class AtomicInt(initial: Int) {
    var raw: __AtomicInt = initial

    fun load(): Int {
        return @Unsafe do { __atomicIntLoad(this.raw) }
    }

    fun store(value: Int): Unit {
        @Unsafe do { __atomicIntStore(this.raw, value) }
    }

    fun cas(expected: Int, desired: Int): Bool {
        return @Unsafe do { __atomicIntCompareExchange(this.raw, expected, desired) }
    }

    fun exchange(value: Int): Int {
        var old: Int = this.load()
        while (!this.cas(old, value)) {
            old = this.load()
        }
        return old
    }
}

class AtomicBool(initial: Bool) {
    var raw: __AtomicInt = __atomicBoolToInt(initial)

    fun load(): Bool {
        return __atomicIntToBool(@Unsafe do { __atomicIntLoad(this.raw) })
    }

    fun store(value: Bool): Unit {
        @Unsafe do { __atomicIntStore(this.raw, __atomicBoolToInt(value)) }
    }

    fun cas(expected: Bool, desired: Bool): Bool {
        return @Unsafe do { __atomicIntCompareExchange(this.raw, __atomicBoolToInt(expected), __atomicBoolToInt(desired)) }
    }

    fun exchange(value: Bool): Bool {
        var old: Bool = this.load()
        while (!this.cas(old, value)) {
            old = this.load()
        }
        return old
    }
}

class Atomic<T>(initial: T) where T: AnyRef {
    var raw: T = initial

    fun load(): T {
        return @Unsafe do { __atomicRefLoad<T>(this.raw) }
    }

    fun store(value: T): Unit {
        @Unsafe do { __atomicRefStore<T>(this.raw, value) }
    }

    fun cas(expected: T, desired: T): Bool {
        return @Unsafe do { __atomicRefCompareExchange<T>(this.raw, expected, desired) }
    }

    fun exchange(value: T): T {
        var old: T = this.load()
        while (!this.cas(old, value)) {
            old = this.load()
        }
        return old
    }
}

class AtomicValue<T>(initial: T) where T: AnyValue {
    val raw: Atomic<scoop.core.Box<T>> = Atomic(scoop.core.Box(initial))

    fun snapshot(): scoop.core.Box<T> {
        return this.raw.load()
    }

    fun load(): T {
        return this.snapshot().value
    }

    fun store(value: T): Unit {
        this.raw.store(scoop.core.Box(value))
    }

    fun cas(expected: scoop.core.Box<T>, desired: T): Bool {
        return this.raw.cas(expected, scoop.core.Box(desired))
    }

    fun exchange(value: T): T {
        return this.raw.exchange(scoop.core.Box(value)).value
    }
}
