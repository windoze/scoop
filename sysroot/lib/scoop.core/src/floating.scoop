@Intrinsic("core_float")
public struct Float :
    Add<Float, Float>,
    Sub<Float, Float>,
    Mul<Float, Float>,
    Div<Float, Float>,
    Rem<Float, Float>,
    UnaryPlus<Float>,
    UnaryMinus<Float>,
    Increment<Float>,
    Decrement<Float>,
    Equals<Float>, Compare<Float>, ToString {
    public companion object : Encodable<Float>, Decodable<Float>, Inspectable<Float> {
        public override fun inspect(value: Float): ValueView =
            ValueObservation(typeInfo<Float>().type, None, { ValueShape.Scalar(ScalarValue.Float(value)) })

        public override fun encode(value: Float, encoder: Encoder): Unit =
            encoder.singleValue().writeFloat(value)

        public override fun decode(decoder: Decoder): Float =
            decoder.singleValue().readFloat()

        public const val NaN: Float = 0f / 0f
        public const val POSITIVE_INFINITY: Float = 1f / 0f
        public const val NEGATIVE_INFINITY: Float = -POSITIVE_INFINITY
        public const val MAX_VALUE: Float = 3.4028234663852886e38f
        public const val MIN_VALUE: Float = 1.401298464324817e-45f
        public const val MIN_NORMAL: Float = 1.1754943508222875e-38f

        public fun fromBits(bits: Int): Float {
            @Unsafe { return addressOf(bits).cast<Float>().load() }
        }
    }

    @NoGC
    public fun toBits(): Int {
        @Unsafe { return addressOf(this).cast<Int>().load() }
    }

    @NoGC @Intrinsic("float_unary_plus")
    public override operator fun unaryPlus(): Float

    @NoGC @Intrinsic("float_unary_minus")
    public override operator fun unaryMinus(): Float

    @NoGC @Intrinsic("float_inc")
    public override operator fun inc(): Float

    @NoGC @Intrinsic("float_dec")
    public override operator fun dec(): Float

    @NoGC @Intrinsic("float_plus")
    public override operator fun plus(other: Float): Float

    @NoGC @Intrinsic("float_minus")
    public override operator fun minus(other: Float): Float

    @NoGC @Intrinsic("float_times")
    public override operator fun times(other: Float): Float

    @NoGC @Intrinsic("float_div")
    public override operator fun div(other: Float): Float

    @NoGC @Intrinsic("float_rem")
    public override operator fun rem(other: Float): Float

    @NoGC @Intrinsic("float_equals")
    public override operator fun equals(other: Float): Boolean

    @NoGC @Intrinsic("float_is_nan")
    public fun isNaN(): Boolean

    @NoGC @Intrinsic("float_is_infinite")
    public fun isInfinite(): Boolean

    @NoGC @Intrinsic("float_is_finite")
    public fun isFinite(): Boolean

    @NoGC @Intrinsic("float_compare_to")
    public override operator fun compareTo(other: Float): Long

    @NoGC
    public fun ieeeCompare(other: Float): IeeeComparison {
        if (isNaN() || other.isNaN()) return IeeeComparison.Unordered
        val order = compareTo(other)
        if (order < 0L) return IeeeComparison.Less
        if (order > 0L) return IeeeComparison.Greater
        return IeeeComparison.Equal
    }

    @NoGC @Intrinsic("float_to_int8")
    public fun toInt8(): Int8

    @NoGC @Intrinsic("float_to_int16")
    public fun toInt16(): Int16

    @NoGC @Intrinsic("float_to_int")
    public fun toInt32(): Int

    @NoGC @Intrinsic("float_to_long")
    public fun toInt64(): Long

    @NoGC @Intrinsic("float_to_uint8")
    public fun toUInt8(): UInt8

    @NoGC @Intrinsic("float_to_uint16")
    public fun toUInt16(): UInt16

    @NoGC @Intrinsic("float_to_uint")
    public fun toUInt32(): UInt

    @NoGC @Intrinsic("float_to_ulong")
    public fun toUInt64(): ULong

    @NoGC @Intrinsic("float_to_float")
    public fun toFloat(): Float

    @NoGC @Intrinsic("float_to_double")
    public fun toDouble(): Double

    public override fun toString(): String = coreFloatToString(this)
}

@Intrinsic("core_double")
public struct Double :
    Add<Double, Double>,
    Sub<Double, Double>,
    Mul<Double, Double>,
    Div<Double, Double>,
    Rem<Double, Double>,
    UnaryPlus<Double>,
    UnaryMinus<Double>,
    Increment<Double>,
    Decrement<Double>,
    Equals<Double>, Compare<Double>, ToString {
    public companion object : Encodable<Double>, Decodable<Double>, Inspectable<Double> {
        public override fun inspect(value: Double): ValueView =
            ValueObservation(typeInfo<Double>().type, None, { ValueShape.Scalar(ScalarValue.Double(value)) })

        public override fun encode(value: Double, encoder: Encoder): Unit =
            encoder.singleValue().writeDouble(value)

        public override fun decode(decoder: Decoder): Double =
            decoder.singleValue().readDouble()

        public const val NaN: Double = 0.0 / 0.0
        public const val POSITIVE_INFINITY: Double = 1.0 / 0.0
        public const val NEGATIVE_INFINITY: Double = -POSITIVE_INFINITY
        public const val MAX_VALUE: Double = 1.7976931348623157e308
        public const val MIN_VALUE: Double = 4.9406564584124654e-324
        public const val MIN_NORMAL: Double = 2.2250738585072014e-308

        public fun fromBits(bits: Long): Double {
            @Unsafe { return addressOf(bits).cast<Double>().load() }
        }
    }

    @NoGC
    public fun toBits(): Long {
        @Unsafe { return addressOf(this).cast<Long>().load() }
    }

    @NoGC @Intrinsic("double_unary_plus")
    public override operator fun unaryPlus(): Double

    @NoGC @Intrinsic("double_unary_minus")
    public override operator fun unaryMinus(): Double

    @NoGC @Intrinsic("double_inc")
    public override operator fun inc(): Double

    @NoGC @Intrinsic("double_dec")
    public override operator fun dec(): Double

    @NoGC @Intrinsic("double_plus")
    public override operator fun plus(other: Double): Double

    @NoGC @Intrinsic("double_minus")
    public override operator fun minus(other: Double): Double

    @NoGC @Intrinsic("double_times")
    public override operator fun times(other: Double): Double

    @NoGC @Intrinsic("double_div")
    public override operator fun div(other: Double): Double

    @NoGC @Intrinsic("double_rem")
    public override operator fun rem(other: Double): Double

    @NoGC @Intrinsic("double_equals")
    public override operator fun equals(other: Double): Boolean

    @NoGC @Intrinsic("double_is_nan")
    public fun isNaN(): Boolean

    @NoGC @Intrinsic("double_is_infinite")
    public fun isInfinite(): Boolean

    @NoGC @Intrinsic("double_is_finite")
    public fun isFinite(): Boolean

    @NoGC @Intrinsic("double_compare_to")
    public override operator fun compareTo(other: Double): Long

    @NoGC
    public fun ieeeCompare(other: Double): IeeeComparison {
        if (isNaN() || other.isNaN()) return IeeeComparison.Unordered
        val order = compareTo(other)
        if (order < 0L) return IeeeComparison.Less
        if (order > 0L) return IeeeComparison.Greater
        return IeeeComparison.Equal
    }

    @NoGC @Intrinsic("double_to_int8")
    public fun toInt8(): Int8

    @NoGC @Intrinsic("double_to_int16")
    public fun toInt16(): Int16

    @NoGC @Intrinsic("double_to_int")
    public fun toInt32(): Int

    @NoGC @Intrinsic("double_to_long")
    public fun toInt64(): Long

    @NoGC @Intrinsic("double_to_uint8")
    public fun toUInt8(): UInt8

    @NoGC @Intrinsic("double_to_uint16")
    public fun toUInt16(): UInt16

    @NoGC @Intrinsic("double_to_uint")
    public fun toUInt32(): UInt

    @NoGC @Intrinsic("double_to_ulong")
    public fun toUInt64(): ULong

    @NoGC @Intrinsic("double_to_float")
    public fun toFloat(): Float

    @NoGC @Intrinsic("double_to_double")
    public fun toDouble(): Double

    public override fun toString(): String = coreDoubleToString(this)
}

public typealias Float32 = Float
public typealias Float64 = Double

@Extern(name = "scoop_rt_float_to_string", abi = "scoop")
internal fun coreFloatToString(value: Float): String

@Extern(name = "scoop_rt_double_to_string", abi = "scoop")
internal fun coreDoubleToString(value: Double): String
