@Target([AnnotationTarget.Field, AnnotationTarget.Property, AnnotationTarget.EnumVariant])
public annotation class Serialize(
    val rename: String = "",
    val required: Boolean = false,
    val emitNull: Boolean = false,
    val ignore: Boolean = false
)

public enum AnnotationTarget: Int {
    Class = 1,
    AnnotationClass = 2,
    EnumVariant = 3,
    Field = 4,
    Property = 5,
    Function = 6,
    Constructor = 7,
    ValueParameter = 8,
    PropertyGetter = 9,
    PropertySetter = 10,
    TypeAlias = 11,
    Type = 12
}

public annotation class Target(val allowed: Array<AnnotationTarget>)
public annotation class Repeatable
