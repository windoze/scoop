internal class OptionEncoder<T>(private val element: Encodable<T>) : Encodable<Option<T>> {
    public override fun encode(value: Option<T>, encoder: Encoder): Unit {
        val variants = encoder.keyed()
        when (value) {
            case Option.None -> { variants.field("None").keyed().end() }
            case Option.Some(item) -> {
                val elements = variants.field("Some").unkeyed()
                element.encode(item, elements.element())
                elements.end()
            }
        }
        variants.end()
    }
}
