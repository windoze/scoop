// Output functions (spec 14.4, M12 DESIGN section 4.3). `write` borrows the
// managed String directly through the Scoop ABI; print/println retain ordinary
// Any.toString() dispatch (vtable slot 2).

@Extern(name = "scoop_rt_write", abi = "scoop")
fun write(message: String)

fun print(message: Any) = write(message.toString())

fun println(message: Any) {
    write(message.toString())
    write("\n")
}
