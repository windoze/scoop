                if (value < endpoint) {
                    return false
                }
            } else {
                if (value <= endpoint) {
                    return false
                }
            }
            val distance = first - value
            return distance % stride == 0u
        }

        if (value < first) {
            return false
        }
        if (inclusive) {
            if (value > endpoint) {
                return false
            }
        } else {
            if (value >= endpoint) {
                return false
            }
