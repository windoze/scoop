internal class UIntRangeIterator internal constructor(
    private var current: UInt,
    private val endpoint: UInt,
    private val stride: UInt,
    private val descending: Boolean,
    private val inclusive: Boolean,
    private var exhausted: Boolean
) : Iterator<UInt> {
    public override fun next(): Option<UInt> {
        if (exhausted) {
            return None
        }

        if (descending) {
            if (inclusive) {
                if (current < endpoint) {
                    exhausted = true
                    return None
                }
            } else {
                if (current <= endpoint) {
                    exhausted = true
                    return None
                }
            }
        } else {
            if (inclusive) {
                if (current > endpoint) {
                    exhausted = true
                    return None
                }
            } else {
                if (current >= endpoint) {
                    exhausted = true
                    return None
                }
            }
        }

        val value = current
        val distance = if (descending) {
            current - endpoint
        } else {
            endpoint - current
        }
        if (inclusive) {
            if (stride <= distance) {
                if (descending) {
                    current = current - stride
                } else {
                    current = current + stride
                }
            } else {
                exhausted = true
            }
        } else {
            if (stride < distance) {
                if (descending) {
                    current = current - stride
                } else {
                    current = current + stride
                }
            } else {
                exhausted = true
            }
        }
        return Some(value)
    }
}

