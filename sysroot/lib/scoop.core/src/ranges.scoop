    public override operator fun iterator(): Iterator<UInt> =
        UIntRangeIterator(first, endpoint, stride, descending, inclusive, false)

    public infix fun step(value: UInt): UIntRange {
        if (value == 0u) {
            throw IllegalArgumentException()
        }
        return UIntRange(first, endpoint, value, descending, inclusive)
