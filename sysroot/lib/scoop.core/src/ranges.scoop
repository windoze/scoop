public class IntRange internal constructor(
    private val first: Int,
    private val endpoint: Int,
    private val stride: Int,
    private val descending: Boolean,
    private val inclusive: Boolean
) : Iterable<Int> {
    public override operator fun iterator(): Iterator<Int> =
        IntRangeIterator(first, endpoint, stride, descending, inclusive, false)

    public infix fun step(value: Int): IntRange {
        if (value <= 0) {
            throw IllegalArgumentException()
        }
        return IntRange(first, endpoint, value, descending, inclusive)
    }

    public operator fun contains(value: Int): Boolean {
        if (descending) {
            if (value > first) {
                return false
            }
            if (inclusive) {
                if (value < endpoint) {
                    return false
                }
            } else {
                if (value <= endpoint) {
                    return false
                }
            }
            val distance = first.toUInt32() - value.toUInt32()
            return distance % stride.toUInt32() == 0u
        }

        if (value < first) {
            return false
        }
        if (inclusive) {
            if (value > endpoint) {
                return false
            }
        } else {
            if (value >= endpoint) {
                return false
            }
        }
        val distance = value.toUInt32() - first.toUInt32()
        return distance % stride.toUInt32() == 0u
    }
}

internal class IntRangeIterator internal constructor(
    private var current: Int,
    private val endpoint: Int,
    private val stride: Int,
    private val descending: Boolean,
    private val inclusive: Boolean,
    private var exhausted: Boolean
) : Iterator<Int> {
    public override fun next(): Option<Int> {
        if (exhausted) {
            return None
        }

        if (descending) {
            if (inclusive) {
                if (current < endpoint) {
                    exhausted = true
                    return None
                }
            } else {
                if (current <= endpoint) {
                    exhausted = true
                    return None
                }
            }
        } else {
            if (inclusive) {
                if (current > endpoint) {
                    exhausted = true
                    return None
                }
            } else {
                if (current >= endpoint) {
                    exhausted = true
                    return None
                }
            }
        }

        val value = current
        val distance = if (descending) {
            current.toUInt32() - endpoint.toUInt32()
        } else {
            endpoint.toUInt32() - current.toUInt32()
        }
        val unsignedStride = stride.toUInt32()
        if (inclusive) {
            if (unsignedStride <= distance) {
                if (descending) {
                    current = current - stride
                } else {
                    current = current + stride
                }
            } else {
                exhausted = true
            }
        } else {
            if (unsignedStride < distance) {
                if (descending) {
                    current = current - stride
                } else {
                    current = current + stride
                }
            } else {
                exhausted = true
            }
        }
        return Some(value)
    }
}

