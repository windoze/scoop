// Scoop sysroot: sync surface.
//
// The public types are ordinary Scoop classes. Native resources are stored as
// raw `Ptr<T>` handles and released through `@ReleaseHook` as a best-effort GC
// fallback; explicit `destroy()` remains the deterministic early-release path.

package scoop.sync

import scoop.core.*
import scoop.unsafe.*

private struct __ScoopSyncMutexNative {}
private struct __ScoopSyncCondVarNative {}
private struct __ScoopSyncOnceNative {}

@Extern(name = "scoop_sync_mutex_native_create", abi = "c")
private fun __scoop_sync_mutex_create_native(): Ptr<__ScoopSyncMutexNative>

@Extern(name = "scoop_sync_mutex_native_lock", abi = "c")
private fun __scoop_sync_mutex_lock_native(raw: Ptr<__ScoopSyncMutexNative>): Unit

@Extern(name = "scoop_sync_mutex_native_unlock", abi = "c")
private fun __scoop_sync_mutex_unlock_native(raw: Ptr<__ScoopSyncMutexNative>): Unit

@Extern(name = "scoop_sync_mutex_native_destroy", abi = "c")
private fun __scoop_sync_mutex_destroy_native(raw: Ptr<__ScoopSyncMutexNative>): Unit

@Extern(name = "scoop_sync_mutex_native_null", abi = "c")
private fun __scoop_sync_mutex_null(): Ptr<__ScoopSyncMutexNative>

/// 互斥锁。底层平台资源由 raw native handle 承载。
@Experimental(feature = "releaseHook")
@ReleaseHook(name = "scoop.sync.__scoop_sync_mutex_destroy_native", args = ["rawHandle"])
public class Mutex(raw: Ptr<__ScoopSyncMutexNative>) {
    private var rawHandle: Ptr<__ScoopSyncMutexNative> = raw
}

/// 创建一个新的互斥锁。
public fun mutexCreate(): Mutex {
    val raw: Ptr<__ScoopSyncMutexNative> = @Unsafe do { __scoop_sync_mutex_create_native() }
    return Mutex(raw)
}

/// 加锁（可能阻塞）。
public fun Mutex.lock(): Unit {
    @Unsafe do { __scoop_sync_mutex_lock_native(this.rawHandle) }
}

/// 解锁。
public fun Mutex.unlock(): Unit {
    @Unsafe do { __scoop_sync_mutex_unlock_native(this.rawHandle) }
}

/// 显式提前释放平台资源；GC release hook 会看到空 handle 而成为 no-op。
public fun Mutex.destroy(): Unit {
    val raw: Ptr<__ScoopSyncMutexNative> = this.rawHandle
    @Unsafe do { __scoop_sync_mutex_destroy_native(raw) }
    this.rawHandle = @Unsafe do { __scoop_sync_mutex_null() }
}

@Extern(name = "scoop_sync_condvar_native_create", abi = "c")
private fun __scoop_sync_condvar_create_native(): Ptr<__ScoopSyncCondVarNative>

@Extern(name = "scoop_sync_condvar_native_wait", abi = "c")
private fun __scoop_sync_condvar_wait_native(
    condVar: Ptr<__ScoopSyncCondVarNative>,
    mutex: Ptr<__ScoopSyncMutexNative>
): Unit

@Extern(name = "scoop_sync_condvar_native_notify_one", abi = "c")
private fun __scoop_sync_condvar_notify_one_native(raw: Ptr<__ScoopSyncCondVarNative>): Unit

@Extern(name = "scoop_sync_condvar_native_notify_all", abi = "c")
private fun __scoop_sync_condvar_notify_all_native(raw: Ptr<__ScoopSyncCondVarNative>): Unit

@Extern(name = "scoop_sync_condvar_native_destroy", abi = "c")
private fun __scoop_sync_condvar_destroy_native(raw: Ptr<__ScoopSyncCondVarNative>): Unit

@Extern(name = "scoop_sync_condvar_native_null", abi = "c")
private fun __scoop_sync_condvar_null(): Ptr<__ScoopSyncCondVarNative>

/// 条件变量（与 `Mutex` 配对使用）。
@Experimental(feature = "releaseHook")
@ReleaseHook(name = "scoop.sync.__scoop_sync_condvar_destroy_native", args = ["rawHandle"])
public class CondVar(raw: Ptr<__ScoopSyncCondVarNative>) {
    private var rawHandle: Ptr<__ScoopSyncCondVarNative> = raw
}

/// 创建一个新的条件变量。
public fun condVarCreate(): CondVar {
    val raw: Ptr<__ScoopSyncCondVarNative> = @Unsafe do { __scoop_sync_condvar_create_native() }
    return CondVar(raw)
}

/// 在条件变量上等待；native 层保证原子 unlock-wait-relock。
public fun CondVar.wait(mutex: Mutex): Unit {
    @Unsafe do { __scoop_sync_condvar_wait_native(this.rawHandle, mutex.rawHandle) }
}

/// 唤醒一个等待者（若存在）。
public fun CondVar.notifyOne(): Unit {
    @Unsafe do { __scoop_sync_condvar_notify_one_native(this.rawHandle) }
}

/// 唤醒所有等待者（若存在）。
public fun CondVar.notifyAll(): Unit {
    @Unsafe do { __scoop_sync_condvar_notify_all_native(this.rawHandle) }
}

/// 显式提前释放平台资源；GC release hook 会看到空 handle 而成为 no-op。
public fun CondVar.destroy(): Unit {
    val raw: Ptr<__ScoopSyncCondVarNative> = this.rawHandle
    @Unsafe do { __scoop_sync_condvar_destroy_native(raw) }
    this.rawHandle = @Unsafe do { __scoop_sync_condvar_null() }
}

@Extern(name = "scoop_sync_once_native_create", abi = "c")
private fun __scoop_sync_once_create_native(): Ptr<__ScoopSyncOnceNative>

@Extern(name = "scoop_sync_once_native_is_done", abi = "c")
private fun __scoop_sync_once_is_done_native(raw: Ptr<__ScoopSyncOnceNative>): Int

@Extern(name = "scoop_sync_once_native_begin", abi = "c")
private fun __scoop_sync_once_begin_native(raw: Ptr<__ScoopSyncOnceNative>): Int

@Extern(name = "scoop_sync_once_native_complete", abi = "c")
private fun __scoop_sync_once_complete_native(raw: Ptr<__ScoopSyncOnceNative>): Unit

@Extern(name = "scoop_sync_once_native_destroy", abi = "c")
private fun __scoop_sync_once_destroy_native(raw: Ptr<__ScoopSyncOnceNative>): Unit

private fun __scoop_sync_once_done(raw: Ptr<__ScoopSyncOnceNative>): Bool {
    return @Unsafe do { __scoop_sync_once_is_done_native(raw) } != 0
}

/// 一次性初始化标记（thread-safe once）。
@Experimental(feature = "releaseHook")
@ReleaseHook(name = "scoop.sync.__scoop_sync_once_destroy_native", args = ["rawHandle"])
public class Once(raw: Ptr<__ScoopSyncOnceNative>, lock: Mutex, ready: CondVar) {
    private var rawHandle: Ptr<__ScoopSyncOnceNative> = raw
    private val mutex: Mutex = lock
    private val condVar: CondVar = ready
}

/// 创建一个新的 once 标记。
public fun onceCreate(): Once {
    val raw: Ptr<__ScoopSyncOnceNative> = @Unsafe do { __scoop_sync_once_create_native() }
    return Once(raw, mutexCreate(), condVarCreate())
}

/// 返回该 once 是否已完成。
public fun Once.isDone(): Bool {
    this.mutex.lock()
    val done: Bool = __scoop_sync_once_done(this.rawHandle)
    this.mutex.unlock()
    return done
}

/// 执行一次：若尚未完成，则运行 `block` 并把 once 标记为完成；否则直接返回。
public fun Once.run(block: () -> Unit): Unit {
    this.mutex.lock()
    val action: Int = @Unsafe do { __scoop_sync_once_begin_native(this.rawHandle) }
    if (action == 0) {
        this.mutex.unlock()
        return ()
    }
    if (action == 1) {
        while (!__scoop_sync_once_done(this.rawHandle)) {
            this.condVar.wait(this.mutex)
        }
        this.mutex.unlock()
        return ()
    }
    this.mutex.unlock()

    block()

    this.mutex.lock()
    @Unsafe do { __scoop_sync_once_complete_native(this.rawHandle) }
    this.condVar.notifyAll()
    this.mutex.unlock()
}
