// Scoop sysroot: unsafe primitives surface (spec §15.9.4)
//
// 说明：
// - 本文件仅提供“声明表面”，用于名字解析与类型检查；
// - 具体 lowering/ABI/运行期语义由后续 codegen/runtime 任务补齐；
// - 模块名固定为 `scoop.unsafe`，便于审计所有 unsafe primitive 的来源。

package scoop.unsafe

import scoop.core.*

/// 原始指针类型（intrinsic，编译器/后端固定语义）。
@Intrinsic
struct Ptr<T>

/// 原生函数指针（intrinsic，编译器/后端固定语义）。
///
/// 说明：
/// - 该类型仅承载“函数签名”这一编译期信息：`F` 必须是函数类型（例如 `(Int, Int) -> Int`）；
/// - 运行期表示为不透明的 native function address（GC-free，值语义）。
@Intrinsic
struct FunPtr<F>

// ---- Raw pointers（spec §15.9.4）----
//
// 说明：
// - 当前阶段 pointer API 以 “extension fun” 的形式提供，以便在 member call lowering
//   未完全覆盖的早期阶段也能通过 `p.load()`/`p.store(...)` 的点调用风格使用；
// - 这些 API 均为 intrinsic：sysroot 只提供声明表面；具体 lowering/ABI/运行期语义由
//   后续 codegen/runtime 任务补齐；
// - 所有 raw pointer 操作均为 `@NoGC @Unsafe`：只能在 unsafe context 使用。

/// Unsafe pointer casts. The caller must uphold all invariants.
@Intrinsic @NoGC @Unsafe
fun <U, T> Ptr<T>.cast(): Ptr<U>

/// Unsafe memory load. The caller must ensure the pointer is valid.
@Intrinsic @NoGC @Unsafe
fun <T> Ptr<T>.load(): T

/// Unsafe memory store. The caller must ensure the pointer is valid.
@Intrinsic @NoGC @Unsafe
fun <T> Ptr<T>.store(value: T): Unit

/// Pointer arithmetic in units of `T` (not bytes).
@Intrinsic @NoGC @Unsafe
fun <T> Ptr<T>.plus(offset: Int): Ptr<T>

/// Pointer arithmetic in units of `T` (not bytes).
@Intrinsic @NoGC @Unsafe
fun <T> Ptr<T>.minus(offset: Int): Ptr<T>

/// Address-of intrinsic: takes the address of a variable slot.
///
/// 约定：参数名 `var` 表示调用点实参必须是可寻址变量（lvalue）。
@Intrinsic @NoGC @Unsafe
fun <T> addressOf(var: T): Ptr<T>

/// Stack allocation intrinsic: allocates space for a GC-free `T` on the stack and returns its address.
@Intrinsic @NoGC @Unsafe
fun <T> stackAlloc(): Ptr<T>

// ---- Compat（迁移期旧名）----
//
// 说明：
// - 兼容早期阶段（T1009）以“自由函数”形态提供的 `addrOf/load/store`；
// - 新代码建议使用 `addressOf` 与 `Ptr<T>.load/store`。

@Intrinsic @NoGC @Unsafe
fun <T> addrOf(var: T): Ptr<T>

@Intrinsic @NoGC @Unsafe
fun <T> load(p: Ptr<T>): T

@Intrinsic @NoGC @Unsafe
fun <T> store(p: Ptr<T>, value: T): Unit

/// 指针 → UIntPtr（只能在 unsafe context 使用；spec §15.9.4）。
@Intrinsic @NoGC @Unsafe
fun <T> ptrToUIntPtr(p: Ptr<T>): UIntPtr

/// UIntPtr → 指针（只能在 unsafe context 使用；spec §15.9.4）。
@Intrinsic @NoGC @Unsafe
fun <T> uintPtrToPtr(addr: UIntPtr): Ptr<T>

// ---- Function pointers（spec §15.9.4）----
//
// 说明：
// - `FunPtr<F>` 的调用在语义上属于 unsafe 操作（可跳出语言内存/控制流模型），因此统一要求 `@Unsafe`；
// - ordinary `@Extern` 自身保持 effect-impermeable；若 native 需要把 effectful / deferred
//   capability 显式交还给 Scoop，应通过 `FunPtr<F>` / `UIntPtr` 这类 bridge token 建模，
//   再由后续 unsafe call 单独承担该控制流边界；
// - v0 阶段以 “extension fun invoke(...)” 的形式暴露，便于在早期实现中复用现有的扩展函数调用路径。

/// `FunPtr` → `UIntPtr`（只能在 unsafe context 使用）。
@Intrinsic @NoGC @Unsafe
fun <F> funPtrToUIntPtr(ptr: FunPtr<F>): UIntPtr

/// `UIntPtr` → `FunPtr`（只能在 unsafe context 使用）。
@Intrinsic @NoGC @Unsafe
fun <F> uintPtrToFunPtr(addr: UIntPtr): FunPtr<F>

/// `FunPtr<() -> R>.invoke()`（只能在 unsafe context 使用）。
@Intrinsic @NoGC @Unsafe
fun <R> FunPtr<() -> R>.invoke(): R

/// `FunPtr<(A) -> R>.invoke(a0)`（只能在 unsafe context 使用）。
@Intrinsic @NoGC @Unsafe
fun <A, R> FunPtr<(A) -> R>.invoke(a0: A): R

/// `FunPtr<(A, B) -> R>.invoke(a0, a1)`（只能在 unsafe context 使用）。
@Intrinsic @NoGC @Unsafe
fun <A, B, R> FunPtr<(A, B) -> R>.invoke(a0: A, a1: B): R

/// `FunPtr<T.() -> R>.invoke(receiver)`（只能在 unsafe context 使用）。
@Intrinsic @NoGC @Unsafe
fun <T, R> FunPtr<T.() -> R>.invoke(receiver: T): R

/// `FunPtr<T.(A) -> R>.invoke(receiver, a0)`（只能在 unsafe context 使用）。
@Intrinsic @NoGC @Unsafe
fun <T, A, R> FunPtr<T.(A) -> R>.invoke(receiver: T, a0: A): R

/// `FunPtr<T.(A, B) -> R>.invoke(receiver, a0, a1)`（只能在 unsafe context 使用）。
@Intrinsic @NoGC @Unsafe
fun <T, A, B, R> FunPtr<T.(A, B) -> R>.invoke(receiver: T, a0: A, a1: B): R

// ---- Internal atomics（FFI/runtime oriented）----
//
// 说明：
// - 这些类型/函数是 “sysroot/runtime 内部约定”，主要用于 runtime/FFI 的全局状态；
// - `__AtomicInt` 与 `Int` 具有相同的内存布局（typealias），以便在 codegen 侧直接生成 LLVM 原子指令；
// - raw pointers（`Ptr<T>`）的完整规范 API 已在本文件上方提供（`addressOf/stackAlloc/load/store/...`）；
// - 但原子操作仍采用“第一个实参必须是可寻址变量槽（lvalue）”的约束，由编译器在 codegen 阶段直接对该变量
//   的存储位置生成 atomic load/store/cmpxchg（避免引入新的原子内存布局或额外指针门禁点）。
// - 当前 memory order 固定为 SeqCst；若上层 runtime/stdlib 依赖更弱序，必须由新的 contract 明确发布。
// - 这些 primitive 只提供底层原子读写语义；如何把 CAS 失败解释成 trap、重试、阻塞或其它策略，属于上层 contract。

/// word-sized atomic integer. Same layout as `Int`.
typealias __AtomicInt = Int

/// atomic load (SeqCst). The first argument must be an lvalue slot.
@Intrinsic @NoGC @Unsafe
fun __atomicIntLoad(target: __AtomicInt): Int

/// atomic store (SeqCst). The first argument must be a mutable lvalue slot.
@Intrinsic @NoGC @Unsafe
fun __atomicIntStore(target: __AtomicInt, value: Int): Unit

/// atomic compare-exchange (SeqCst). Returns `true` when swapped.
@Intrinsic @NoGC @Unsafe
fun __atomicIntCompareExchange(target: __AtomicInt, expected: Int, desired: Int): Bool
