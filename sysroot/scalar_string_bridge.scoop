// Scalar String bridge helpers for compiled sysroot code.
//
// 说明：
// - 这些 helper 是过渡期 ordinary managed surface；P7-T02 会删除本文件。
// - runtime 边界现在走 scoop ABI `@Extern`，不再通过 scalar toString intrinsic bridge。

package scoop.core

import scoop.core.*

@Extern(name = "scoop_char_to_string", abi = "scoop")
fun __scoop_runtime_char_to_string_bridge(value: Char): String

@Extern(name = "scoop_int_to_string", abi = "scoop")
fun __scoop_runtime_int_to_string_bridge(value: Int): String

@Extern(name = "scoop_float32_to_string", abi = "scoop")
fun __scoop_runtime_float32_to_string_bridge(value: Float32): String

@Extern(name = "scoop_float64_to_string", abi = "scoop")
fun __scoop_runtime_float64_to_string_bridge(value: Float64): String

fun scoopAbiCharToString(value: Char): String {
    return __scoop_runtime_char_to_string_bridge(value)
}

fun scoopAbiIntToString(value: Int): String {
    return __scoop_runtime_int_to_string_bridge(value)
}

fun scoopAbiFloat32ToString(value: Float32): String {
    return __scoop_runtime_float32_to_string_bridge(value)
}

fun scoopAbiFloat64ToString(value: Float64): String {
    return __scoop_runtime_float64_to_string_bridge(value)
}
