// Scoop sysroot (early stage)
//
// 说明：
// - sysroot 是编译器内建 API 的“声明源”（便于 IDE/文档/规范一致）
// - 早期阶段这里只放最小集合，随着实现推进逐步补齐

package scoop.core

// Root types
interface Any

// Built-in scalar types（声明层）。
//
// 说明：
// - 这些类型的布局/语义由编译器与运行时固定；
// - sysroot 只提供“可见声明”，用于名字解析与工具链展示。
struct Bool
class String
struct Unit
enum Nothing

// I/O（最小表面，早期阶段）。
//
// 说明：
// - 目前仅作为 sysroot API 声明，让 resolver/typecheck 能识别 `print/println`；
// - 真实实现将由 runtime（C）提供（见 TODO：T0821/T0822）。
fun print(value: String): Unit
fun println(value: String): Unit
fun print(value: Int): Unit
fun println(value: Int): Unit

// GC / shadow stack（测试辅助）。
//
// 说明：
// - 该 API 仅用于 fixtures 回归 shadow stack 插桩（TODO T0816）；
// - 返回当前线程 shadow stack 中“非空 roots slot”的数量（不会执行真实 GC）。
fun __scoop_gc_debug_count_roots_current_thread(): Int

// GC（测试辅助）。
//
// 说明：
// - 该组 API 用于回归 v0 mark-sweep（TODO T0910）；并不承诺稳定的用户态 API；
// - `__scoop_gc_collect()` 手动触发一次 GC（仅扫描当前线程 roots）；
// - `__scoop_gc_debug_alloc_garbage(n)` 用于制造垃圾对象（不写入 roots）；
// - `__scoop_gc_debug_heap_object_count()` 用于验证 sweep 是否回收。
fun __scoop_gc_collect(): Unit
fun __scoop_gc_debug_heap_object_count(): Int
fun __scoop_gc_debug_alloc_garbage(count: Int): Unit

// GC pinning API（spec §15.10）。
//
// 说明：
// - 该 API 用于把某个 heap 对象标记为 pinned，供把对象地址交给外部系统（FFI/异步 I/O）时使用；
// - v0（非移动 mark-sweep）阶段 pin 的主要效果是：把对象视为额外 roots，避免在无 shadow stack 引用时被 sweep；
// - `Pinned<T>` 是值类型 handle：丢弃 handle 不会自动 unpin（资源泄漏）；每次 pin 必须配对一次 unpin。
@Intrinsic
object GC {
    @NoGC @Unsafe
    fun pin(obj: Any): Pinned

    @NoGC @Unsafe
    fun unpin(pinned: Pinned): Unit
}

// Value type handle. Exact fields are implementation-defined (spec §15.10).
struct Pinned(val value: Any)

// Effect runtime（测试辅助）。
//
// 说明：
// - 该组 API 仅用于回归 effect lowering/codegen 与 runtime ABI（TODO T0613+）；
// - 它们映射到 runtime 的 C 符号（`scoop_effect_*`），并不承诺稳定的用户态 API；
// - `opTag/payload` 的语义将在后续 lowering 中固定；当前阶段只要求“可读写可观测”。
fun __scoop_effect_is_active(): Int
fun __scoop_effect_set_active(): Unit
fun __scoop_effect_clear(): Unit

// perform slot v0：单 word 载荷（兼容 T0613）。
fun __scoop_effect_slot_write(opTag: Int, value: Int): Unit
fun __scoop_effect_slot_read_op_tag(): Int
fun __scoop_effect_slot_read_value(): Int

// perform slot v1：多 word 载荷（TODO T0630）。
fun __scoop_effect_slot_write2(opTag: Int, word0: Int, word1: Int): Unit
fun __scoop_effect_slot_read_len_words(): Int
fun __scoop_effect_slot_read_word(index: Int): Int

// Delegated property metadata（spec §10.4）。
//
// 说明：
// - `PropertyMeta` 未来会在 comptime/反射（spec §6.4）中变得更完整（见 TODO T1208）；
// - 当前阶段仅需要它作为 delegated property 的 `getValue/setValue` 签名中的占位类型（T0434b）。
struct PropertyMeta {
    val name: String
}

// Integers（spec §2.3.4 / runtime §3）
//
// word-sized：随 target 指针宽度变化（Swift 约定）。
struct Int
struct UInt

// fixed-width：用于 FFI/序列化等稳定布局场景。
struct Int8
struct Int16
struct Int32
struct Int64
struct UInt8
struct UInt16
struct UInt32
struct UInt64

// 标准别名（Kotlin/Swift 风格）。
typealias Byte = UInt8
typealias Short = Int16
typealias UShort = UInt16
typealias Long = Int64
typealias ULong = UInt64
typealias UIntPtr = UInt

// Compiler intrinsics（spec §15.7 / §6.4）。
//
// 说明：
// - 规范中的 `sizeOf<T>()` 是隐式 `const fun` 的反射 intrinsic；
// - 当前阶段（TODO T12xx）尚未实现 comptime 执行链路；同时 typecheck 的“跨文件泛型函数签名 lowering”
//   也未补齐，因此这里先用一组 overload 作为最小可调用表面：
//   - `sizeOf(1)` / `sizeOf("s")`
// - 该声明仅用于工具链可见性与类型检查；实现由编译器在 codegen 阶段内建 lowering 提供（见 TODO T1007）。
@Intrinsic
fun sizeOf(value: Int): Int
@Intrinsic
fun sizeOf(value: String): Int

// Option / nullable sugar
enum Option<T> {
    Some(val value: T),
    None
}

// Continuation（spec §5.5）
//
// 说明：
// - `Continuation<T, eff E>` 表示一个“等待被恢复”的计算片段；
// - `E` 表示恢复该 continuation 可能执行的效果集合（required effects）。
// - 当前阶段仅用于静态类型检查与 required-effects 传播；运行期语义/one-shot 约束由后续任务补齐。
class Continuation<T, eff E = Pure>

// Continuation / 线程（内部测试辅助）。
//
// 说明：
// - 该 API 用于回归“跨线程 resume”语义（spec §5.5 / TODO T0618）；
// - 当前阶段不提供调度器：该 helper 会创建一个新线程执行 `resume` 并 join 等待结束；
// - 仅作为 fixtures 的可执行落点，并不承诺稳定的用户态 API。
fun __scoop_thread_spawn_join_resume_u64(continuation: Continuation<Int>, value: Int): Unit

// Task（spec §5.3 / §5.7）
//
// 说明：
// - `Task<T>` 是异步计算的句柄类型；其具体运行期模型（executor/调度/取消）由 runtime 任务补齐；
// - 规范语义：Task 默认为 lazy：直到 `await`（或显式启动，例如 `spawn`）才要求执行。
// - 当前阶段先把它作为“可在类型系统中出现的名义类型”，用于 `await/spawn` 的最小建模（T0622）。
class Task<T>

// Built-in effect: Async（spec §5.7）
//
// 说明：
// - 规范中的 `await` 是 `Async` effect operation：`perform Async.await(task)`；
// - 当前实现仍处于早期阶段：并不提供真实的 executor/跨线程 resume；
// - 但 type system 需要先固定 `Task<T>` 与 `await` 的形状，供 required-effects 与 fixtures 回归使用（T0622）。
effect Async {
    fun <T> await(task: Task<T>): T
}

// Tasks / spawn/join（early stage, internal）。
//
// 说明：
// - 该组 API 仅用于 `spawn/join` 语法糖的最小可执行落点（T0620）；
// - 当前阶段先只支持 `Int` 结果，并不承诺稳定 ABI；
// - 后续会被 `Task<T>` + executor/runtime 原语替换（T0622/T0917）。
fun __scoop_task_spawn_int(value: Int): Task<Int>
fun __scoop_task_join_int(task: Task<Int>): Int

// Runtime errors expressed via `Raise<RuntimeError>` (spec §5.7).
enum RuntimeError {
    NullAssertionFailed,
    ClassCastFailed,
}

// Built-in effect: Raise
effect Raise<in E> {
    fun raise(error: E): Nothing
}
