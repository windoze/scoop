// Scoop sysroot：String 扩展方法
//
// T0143/P4-T02：从 stdlib/runtime 迁移到 sysroot，利用 T0120（byteLength/getByte）
// 和 T0121（unsafeSliceBytes）这组 byte-level substrate 构建 public String helpers。

package scoop.core

import scoop.core.*

// --- 内部：String 版 array builder（for split） ---

@Intrinsic
fun __scoop_array_builder_push_string(builder: Any, value: String): Unit

@Intrinsic
fun __scoop_array_builder_build_array_string(builder: Any): Array<String>

// `String.concat` still needs the allocation/copy substrate.  Public `String.concat`
// is ordinary sysroot code; only this audited bridge reaches the runtime symbol.
@Intrinsic("string_concat_bridge")
fun __scoop_runtime_string_concat_bridge(a: String, b: String): String

// --- 内部：remaining String helper implementations ---

fun __scoop_string_length(value: String): Int {
    return value.byteLength()
}

fun __scoop_string_to_int(value: String): Int {
    val len: Int = value.byteLength()
    var i: Int = 0

    while (i < len) {
        val byte: Int = value.getByte(i)
        var isWhitespace: Bool = false
        if (byte == 32) {
            isWhitespace = true
        } else if (byte >= 9) {
            if (byte <= 13) {
                isWhitespace = true
            }
        }
        if (isWhitespace) {
            i = i + 1
        } else {
            break
        }
    }

    var sign: Int = 1
    if (i < len) {
        val signByte: Int = value.getByte(i)
        if (signByte == 45) {
            sign = 0 - 1
            i = i + 1
        } else if (signByte == 43) {
            i = i + 1
        }
    }

    var result: Int = 0
    var sawDigit: Bool = false
    while (i < len) {
        val byte: Int = value.getByte(i)
        if (byte < 48) {
            break
        }
        if (byte > 57) {
            break
        }
        sawDigit = true
        result = (result * 10) + (byte - 48)
        i = i + 1
    }

    if (sawDigit == false) {
        return 0
    }
    return result * sign
}

fun __scoop_string_concat(a: String, b: String): String {
    return __scoop_runtime_string_concat_bridge(a, b)
}

fun __scoop_string_hash(value: String): Int {
    val len: Int = value.byteLength()
    if (len == 0) {
        return 0
    }

    var hash: Int = 0 - 3750763034362895579
    var i: Int = 0
    while (i < len) {
        hash = (hash ^ value.getByte(i)) * 1099511628211
        i = i + 1
    }
    return hash
}

fun __scoop_string_is_empty(value: String): Bool {
    return value.byteLength() == 0
}

fun __scoop_string_matches_at(value: String, offset: Int, needle: String): Bool {
    val len: Int = value.byteLength()
    val needleLen: Int = needle.byteLength()
    if (offset < 0) {
        return false
    }
    if (offset + needleLen > len) {
        return false
    }

    var i: Int = 0
    while (i < needleLen) {
        if (value.getByte(offset + i) != needle.getByte(i)) {
            return false
        }
        i = i + 1
    }
    return true
}

fun __scoop_string_replace(value: String, old: String, replacement: String): String {
    val len: Int = value.byteLength()
    val oldLen: Int = old.byteLength()
    if (len == 0) {
        return value
    }
    if (oldLen <= 0) {
        return value
    }

    var result: String = ""
    var i: Int = 0
    while (i < len) {
        if (__scoop_string_matches_at(value, i, old)) {
            result = result.concat(replacement)
            i = i + oldLen
        } else {
            result = result.concat(value.substring(i, i + 1))
            i = i + 1
        }
    }
    return result
}

fun __scoop_string_char_at(value: String, index: Int): Int {
    if (index < 0) {
        return 0 - 1
    }
    if (index >= value.byteLength()) {
        return 0 - 1
    }
    return value.getByte(index)
}

fun __scoop_string_repeat(value: String, n: Int): String {
    if (n <= 0) {
        return ""
    }

    var result: String = ""
    var i: Int = 0
    while (i < n) {
        result = result.concat(value)
        i = i + 1
    }
    return result
}

fun __scoop_string_compare_to(value: String, other: String): Int {
    val len: Int = value.byteLength()
    val otherLen: Int = other.byteLength()
    var minLen: Int = len
    if (otherLen < minLen) {
        minLen = otherLen
    }

    var i: Int = 0
    while (i < minLen) {
        val left: Int = value.getByte(i)
        val right: Int = other.getByte(i)
        if (left != right) {
            return left - right
        }
        i = i + 1
    }

    if (len < otherLen) {
        return 0 - 1
    }
    if (len > otherLen) {
        return 1
    }
    return 0
}

fun __scoop_string_is_indent_whitespace(byte: Int): Bool {
    if (byte == 32) {
        return true
    }
    return byte == 9
}

fun __scoop_string_is_blank_whitespace(byte: Int): Bool {
    if (byte == 32) {
        return true
    }
    if (byte == 9) {
        return true
    }
    return byte == 13
}

fun __scoop_string_content_line_end(value: String, start: Int, end: Int): Int {
    if (end > start) {
        if (value.getByte(end - 1) == 13) {
            return end - 1
        }
    }
    return end
}

fun __scoop_string_line_is_blank(value: String, start: Int, end: Int): Bool {
    var i: Int = start
    while (i < end) {
        if (__scoop_string_is_blank_whitespace(value.getByte(i)) == false) {
            return false
        }
        i = i + 1
    }
    return true
}

fun __scoop_string_trim_indent(value: String): String {
    val len: Int = value.byteLength()
    if (len == 0) {
        return value
    }

    var foundFirst: Bool = false
    var firstStart: Int = 0
    var lineStart: Int = 0
    var i: Int = 0
    while (i <= len) {
        if (i == len) {
            val lineEnd: Int = __scoop_string_content_line_end(value, lineStart, i)
            if (__scoop_string_line_is_blank(value, lineStart, lineEnd) == false) {
                firstStart = lineStart
                foundFirst = true
                break
            }
        } else if (value.getByte(i) == 10) {
            val lineEnd: Int = __scoop_string_content_line_end(value, lineStart, i)
            if (__scoop_string_line_is_blank(value, lineStart, lineEnd) == false) {
                firstStart = lineStart
                foundFirst = true
                break
            }
            lineStart = i + 1
        }
        i = i + 1
    }

    if (foundFirst == false) {
        return ""
    }

    var lastStart: Int = firstStart
    lineStart = firstStart
    i = firstStart
    while (i <= len) {
        if (i == len) {
            val lineEnd: Int = __scoop_string_content_line_end(value, lineStart, i)
            if (__scoop_string_line_is_blank(value, lineStart, lineEnd) == false) {
                lastStart = lineStart
            }
        } else if (value.getByte(i) == 10) {
            val lineEnd: Int = __scoop_string_content_line_end(value, lineStart, i)
            if (__scoop_string_line_is_blank(value, lineStart, lineEnd) == false) {
                lastStart = lineStart
            }
            lineStart = i + 1
        }
        i = i + 1
    }

    var minIndent: Int = len
    lineStart = firstStart
    i = firstStart
    while (i <= len) {
        if (i == len) {
            val lineEnd: Int = __scoop_string_content_line_end(value, lineStart, i)
            if (__scoop_string_line_is_blank(value, lineStart, lineEnd) == false) {
                var indent: Int = 0
                while (lineStart + indent < lineEnd) {
                    if (__scoop_string_is_indent_whitespace(value.getByte(lineStart + indent))) {
                        indent = indent + 1
                    } else {
                        break
                    }
                }
                if (indent < minIndent) {
                    minIndent = indent
                }
            }
        } else if (value.getByte(i) == 10) {
            val lineEnd: Int = __scoop_string_content_line_end(value, lineStart, i)
            if (__scoop_string_line_is_blank(value, lineStart, lineEnd) == false) {
                var indent: Int = 0
                while (lineStart + indent < lineEnd) {
                    if (__scoop_string_is_indent_whitespace(value.getByte(lineStart + indent))) {
                        indent = indent + 1
                    } else {
                        break
                    }
                }
                if (indent < minIndent) {
                    minIndent = indent
                }
            }
            lineStart = i + 1
        }
        if (lineStart > lastStart) {
            break
        }
        i = i + 1
    }

    var result: String = ""
    var needsNewline: Bool = false
    lineStart = firstStart
    i = firstStart
    while (i <= len) {
        if (i == len) {
            val lineEnd: Int = __scoop_string_content_line_end(value, lineStart, i)
            if (needsNewline) {
                result = result.concat("\n")
            }
            var drop: Int = 0
            while (drop < minIndent) {
                if (lineStart + drop < lineEnd) {
                    if (__scoop_string_is_indent_whitespace(value.getByte(lineStart + drop))) {
                        drop = drop + 1
                    } else {
                        break
                    }
                } else {
                    break
                }
            }
            val contentStart: Int = lineStart + drop
            if (__scoop_string_line_is_blank(value, contentStart, lineEnd) == false) {
                result = result.concat(value.substring(contentStart, lineEnd))
            }
            break
        } else if (value.getByte(i) == 10) {
            val lineEnd: Int = __scoop_string_content_line_end(value, lineStart, i)
            if (needsNewline) {
                result = result.concat("\n")
            }
            var drop: Int = 0
            while (drop < minIndent) {
                if (lineStart + drop < lineEnd) {
                    if (__scoop_string_is_indent_whitespace(value.getByte(lineStart + drop))) {
                        drop = drop + 1
                    } else {
                        break
                    }
                } else {
                    break
                }
            }
            val contentStart: Int = lineStart + drop
            if (__scoop_string_line_is_blank(value, contentStart, lineEnd) == false) {
                result = result.concat(value.substring(contentStart, lineEnd))
            }
            needsNewline = true
            if (lineStart == lastStart) {
                break
            }
            lineStart = i + 1
        }
        i = i + 1
    }

    return result
}

// --- String 扩展方法 ---

fun String.substring(start: Int, end: Int): String {
    val len: Int = this.byteLength()

    var s: Int = start
    if (s < 0) { s = 0 }
    if (s > len) { s = len }

    var e: Int = end
    if (e < s) { e = s }
    if (e > len) { e = len }

    val sliceLen: Int = e - s
    return @Unsafe do { this.unsafeSliceBytes(s, sliceLen) }
}

fun String.indexOf(substr: String): Int {
    val slen: Int = this.byteLength()
    val dlen: Int = substr.byteLength()

    if (dlen <= 0) {
        return 0
    }
    if (dlen > slen) {
        return 0 - 1
    }

    val limit: Int = slen - dlen
    var i: Int = 0
    while (i <= limit) {
        var j: Int = 0
        var matched: Bool = true
        while (j < dlen) {
            if (this.getByte(i + j) != substr.getByte(j)) {
                matched = false
                break
            }
            j = j + 1
        }
        if (matched) {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

fun String.contains(substr: String): Bool {
    return this.indexOf(substr) >= 0
}

fun String.startsWith(prefix: String): Bool {
    val slen: Int = this.byteLength()
    val plen: Int = prefix.byteLength()

    if (plen > slen) {
        return false
    }

    var i: Int = 0
    while (i < plen) {
        if (this.getByte(i) != prefix.getByte(i)) {
            return false
        }
        i = i + 1
    }
    return true
}

fun String.endsWith(suffix: String): Bool {
    val slen: Int = this.byteLength()
    val plen: Int = suffix.byteLength()

    if (plen > slen) {
        return false
    }

    val offset: Int = slen - plen
    var i: Int = 0
    while (i < plen) {
        if (this.getByte(offset + i) != suffix.getByte(i)) {
            return false
        }
        i = i + 1
    }
    return true
}

fun String.split(delimiter: String): Array<String> {
    val slen: Int = this.byteLength()
    val dlen: Int = delimiter.byteLength()

    val b: Any = __scoop_array_builder_new()

    if (slen <= 0) {
        val empty: String = @Unsafe do { this.unsafeSliceBytes(0, 0) }
        __scoop_array_builder_push_string(b, empty)
    } else if (dlen <= 0) {
        __scoop_array_builder_push_string(b, this)
    } else {
        var start: Int = 0
        var i: Int = 0
        val limit: Int = slen - dlen

        while (i <= limit) {
            var j: Int = 0
            var matched: Bool = true
            while (j < dlen) {
                if (this.getByte(i + j) != delimiter.getByte(j)) {
                    matched = false
                    break
                }
                j = j + 1
            }

            if (matched) {
                val segLen: Int = i - start
                val seg: String = @Unsafe do { this.unsafeSliceBytes(start, segLen) }
                __scoop_array_builder_push_string(b, seg)
                start = i + dlen
                i = start
            } else {
                i = i + 1
            }
        }

        val tailLen: Int = slen - start
        val tail: String = @Unsafe do { this.unsafeSliceBytes(start, tailLen) }
        __scoop_array_builder_push_string(b, tail)
    }

    return __scoop_array_builder_build_array_string(b)
}

fun String.trimStart(): String {
    val len: Int = this.byteLength()
    var start: Int = 0
    while (start < len) {
        val byte: Int = this.getByte(start)
        if (byte == 32) {
            start = start + 1
        } else if (byte >= 9) {
            if (byte <= 13) {
                start = start + 1
            } else {
                break
            }
        } else {
            break
        }
    }

    val sliceLen: Int = len - start
    return @Unsafe do { this.unsafeSliceBytes(start, sliceLen) }
}

fun String.trimEnd(): String {
    val len: Int = this.byteLength()
    var end: Int = len
    while (end > 0) {
        val byte: Int = this.getByte(end - 1)
        if (byte == 32) {
            end = end - 1
        } else if (byte >= 9) {
            if (byte <= 13) {
                end = end - 1
            } else {
                break
            }
        } else {
            break
        }
    }

    return @Unsafe do { this.unsafeSliceBytes(0, end) }
}

fun String.trim(): String {
    return this.trimStart().trimEnd()
}
