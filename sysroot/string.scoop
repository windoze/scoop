// Scoop sysroot：String 扩展方法
//
// T0143/P4-T02：从 stdlib/runtime 迁移到 sysroot，利用 T0120（byteLength/getByte）
// 和 T0121（unsafeSliceBytes）这组 byte-level substrate 构建 public String helpers。

package scoop.core

import scoop.core.*

// `String.concat` still needs the allocation/copy substrate. Public `String.concat`
// is ordinary sysroot code; only this scoop ABI declaration reaches the runtime symbol.
@Extern(name = "scoop_string_concat", abi = "scoop")
fun __scoop_string_concat_runtime(a: String, b: String): String

// --- 内部：migrated public String helper implementations ---

fun __scoop_string_length(value: String): Int {
    return value.byteLength()
}

fun __scoop_string_to_int(value: String): Int {
    val len: Int = value.byteLength()
    var i: Int = 0

    while (i < len) {
        val byte: Int = value.getByte(i)
        var isWhitespace: Bool = false
        if (byte == 32) {
            isWhitespace = true
        } else if (byte >= 9) {
            if (byte <= 13) {
                isWhitespace = true
            }
        }
        if (isWhitespace) {
            i = i + 1
        } else {
            break
        }
    }

    var sign: Int = 1
    if (i < len) {
        val signByte: Int = value.getByte(i)
        if (signByte == 45) {
            sign = 0 - 1
            i = i + 1
        } else if (signByte == 43) {
            i = i + 1
        }
    }

    var result: Int = 0
    var sawDigit: Bool = false
    while (i < len) {
        val byte: Int = value.getByte(i)
        if (byte < 48) {
            break
        }
        if (byte > 57) {
            break
        }
        sawDigit = true
        result = (result * 10) + (byte - 48)
        i = i + 1
    }

    if (sawDigit == false) {
        return 0
    }
    return result * sign
}

fun __scoop_string_concat(a: String, b: String): String {
    return __scoop_string_concat_runtime(a, b)
}

fun __scoop_string_hash(value: String): Int {
    val len: Int = value.byteLength()
    if (len == 0) {
        return 0
    }

    var hash: Int = 0 - 3750763034362895579
    var i: Int = 0
    while (i < len) {
        hash = (hash ^ value.getByte(i)) * 1099511628211
        i = i + 1
    }
    return hash
}

fun __scoop_string_is_empty(value: String): Bool {
    return value.byteLength() == 0
}

fun __scoop_string_matches_at(value: String, offset: Int, needle: String): Bool {
    val len: Int = value.byteLength()
    val needleLen: Int = needle.byteLength()
    if (offset < 0) {
        return false
    }
    if (offset + needleLen > len) {
        return false
    }

    var i: Int = 0
    while (i < needleLen) {
        if (value.getByte(offset + i) != needle.getByte(i)) {
            return false
        }
        i = i + 1
    }
    return true
}

fun __scoop_string_replace(value: String, old: String, replacement: String): String {
    val len: Int = value.byteLength()
    val oldLen: Int = old.byteLength()
    if (len == 0) {
        return value
    }
    if (oldLen <= 0) {
        return value
    }

    var result: String = ""
    var i: Int = 0
    while (i < len) {
        if (__scoop_string_matches_at(value, i, old)) {
            result = result.concat(replacement)
            i = i + oldLen
        } else {
            val ch: String = @Unsafe do { value.unsafeSliceBytes(i, 1) }
            result = result.concat(ch)
            i = i + 1
        }
    }
    return result
}

fun __scoop_string_char_at(value: String, index: Int): Int {
    if (index < 0) {
        return 0 - 1
    }
    if (index >= value.byteLength()) {
        return 0 - 1
    }
    return value.getByte(index)
}

fun __scoop_string_repeat(value: String, n: Int): String {
    if (n <= 0) {
        return ""
    }

    var result: String = ""
    var i: Int = 0
    while (i < n) {
        result = result.concat(value)
        i = i + 1
    }
    return result
}

fun __scoop_string_compare_to(value: String, other: String): Int {
    val len: Int = value.byteLength()
    val otherLen: Int = other.byteLength()
    var minLen: Int = len
    if (otherLen < minLen) {
        minLen = otherLen
    }

    var i: Int = 0
    while (i < minLen) {
        val left: Int = value.getByte(i)
        val right: Int = other.getByte(i)
        if (left != right) {
            return left - right
        }
        i = i + 1
    }

    if (len < otherLen) {
        return 0 - 1
    }
    if (len > otherLen) {
        return 1
    }
    return 0
}

fun __scoop_string_is_indent_whitespace(byte: Int): Bool {
    if (byte == 32) {
        return true
    }
    return byte == 9
}

fun __scoop_string_is_blank_whitespace(byte: Int): Bool {
    if (byte == 32) {
        return true
    }
    if (byte == 9) {
        return true
    }
    return byte == 13
}

fun __scoop_string_content_line_end(value: String, start: Int, end: Int): Int {
    if (end > start) {
        if (value.getByte(end - 1) == 13) {
            return end - 1
        }
    }
    return end
}

fun __scoop_string_line_is_blank(value: String, start: Int, end: Int): Bool {
    var i: Int = start
    while (i < end) {
        if (__scoop_string_is_blank_whitespace(value.getByte(i)) == false) {
            return false
        }
        i = i + 1
    }
    return true
}

fun __scoop_string_trim_indent(value: String): String {
    val len: Int = value.byteLength()
    if (len == 0) {
        return value
    }

    var foundFirst: Bool = false
    var firstStart: Int = 0
    var lineStart: Int = 0
    var i: Int = 0
    while (i <= len) {
        if (i == len) {
            val lineEnd: Int = __scoop_string_content_line_end(value, lineStart, i)
            if (__scoop_string_line_is_blank(value, lineStart, lineEnd) == false) {
                firstStart = lineStart
                foundFirst = true
                break
            }
        } else if (value.getByte(i) == 10) {
            val lineEnd: Int = __scoop_string_content_line_end(value, lineStart, i)
            if (__scoop_string_line_is_blank(value, lineStart, lineEnd) == false) {
                firstStart = lineStart
                foundFirst = true
                break
            }
            lineStart = i + 1
        }
        i = i + 1
    }

    if (foundFirst == false) {
        return ""
    }

    var lastStart: Int = firstStart
    lineStart = firstStart
    i = firstStart
    while (i <= len) {
        if (i == len) {
            val lineEnd: Int = __scoop_string_content_line_end(value, lineStart, i)
            if (__scoop_string_line_is_blank(value, lineStart, lineEnd) == false) {
                lastStart = lineStart
            }
        } else if (value.getByte(i) == 10) {
            val lineEnd: Int = __scoop_string_content_line_end(value, lineStart, i)
            if (__scoop_string_line_is_blank(value, lineStart, lineEnd) == false) {
                lastStart = lineStart
            }
            lineStart = i + 1
        }
        i = i + 1
    }

    var minIndent: Int = len
    lineStart = firstStart
    i = firstStart
    while (i <= len) {
        if (i == len) {
            val lineEnd: Int = __scoop_string_content_line_end(value, lineStart, i)
            if (__scoop_string_line_is_blank(value, lineStart, lineEnd) == false) {
                var indent: Int = 0
                while (lineStart + indent < lineEnd) {
                    if (__scoop_string_is_indent_whitespace(value.getByte(lineStart + indent))) {
                        indent = indent + 1
                    } else {
                        break
                    }
                }
                if (indent < minIndent) {
                    minIndent = indent
                }
            }
        } else if (value.getByte(i) == 10) {
            val lineEnd: Int = __scoop_string_content_line_end(value, lineStart, i)
            if (__scoop_string_line_is_blank(value, lineStart, lineEnd) == false) {
                var indent: Int = 0
                while (lineStart + indent < lineEnd) {
                    if (__scoop_string_is_indent_whitespace(value.getByte(lineStart + indent))) {
                        indent = indent + 1
                    } else {
                        break
                    }
                }
                if (indent < minIndent) {
                    minIndent = indent
                }
            }
            lineStart = i + 1
        }
        if (lineStart > lastStart) {
            break
        }
        i = i + 1
    }

    var result: String = ""
    var needsNewline: Bool = false
    lineStart = firstStart
    i = firstStart
    while (i <= len) {
        if (i == len) {
            val lineEnd: Int = __scoop_string_content_line_end(value, lineStart, i)
            if (needsNewline) {
                result = result.concat("\n")
            }
            var drop: Int = 0
            while (drop < minIndent) {
                if (lineStart + drop < lineEnd) {
                    if (__scoop_string_is_indent_whitespace(value.getByte(lineStart + drop))) {
                        drop = drop + 1
                    } else {
                        break
                    }
                } else {
                    break
                }
            }
            val contentStart: Int = lineStart + drop
            if (__scoop_string_line_is_blank(value, contentStart, lineEnd) == false) {
                val contentLen: Int = lineEnd - contentStart
                val content: String = @Unsafe do { value.unsafeSliceBytes(contentStart, contentLen) }
                result = result.concat(content)
            }
            break
        } else if (value.getByte(i) == 10) {
            val lineEnd: Int = __scoop_string_content_line_end(value, lineStart, i)
            if (needsNewline) {
                result = result.concat("\n")
            }
            var drop: Int = 0
            while (drop < minIndent) {
                if (lineStart + drop < lineEnd) {
                    if (__scoop_string_is_indent_whitespace(value.getByte(lineStart + drop))) {
                        drop = drop + 1
                    } else {
                        break
                    }
                } else {
                    break
                }
            }
            val contentStart: Int = lineStart + drop
            if (__scoop_string_line_is_blank(value, contentStart, lineEnd) == false) {
                val contentLen: Int = lineEnd - contentStart
                val content: String = @Unsafe do { value.unsafeSliceBytes(contentStart, contentLen) }
                result = result.concat(content)
            }
            needsNewline = true
            if (lineStart == lastStart) {
                break
            }
            lineStart = i + 1
        }
        i = i + 1
    }

    return result
}
