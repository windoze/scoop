// Scoop sysroot: print/println compiled support source.

package scoop.core

import scoop.core.*

// T0143：`core.scoop` 保留 resolver/typecheck 可见的泛型签名；本文件提供可编译 body，
// 让 monomorphization 为每个具体 `T: ToString` 生成实例。

fun <T> print(value: T): Unit where T: ToString {
    __scoop_print_string(value.toString())
}

fun <T> println(value: T): Unit where T: ToString {
    __scoop_println_string(value.toString())
}
