// Scoop sysroot: path surface（std v2，early stage）
//
// 说明：
// - 该模块提供标准库 `scoop.path` 的最小可执行表面（T1318d）。
// - 当前阶段先按 “host 平台分隔符规则” 实现：由 LLVM codegen 直接映射到 runtime C 符号。
// - 语义目标是“够用且可回归”，并不要求与 Kotlin/Java/NIO 完全一致。

package scoop.path

import scoop.core.*

/// 规范化路径分隔符并做最小归一化。
///
/// 当前实现约定（subset）：
/// - 折叠重复分隔符（例如 `a//b` → `a/b`）；
/// - 去掉末尾多余分隔符（例如 `a/b/` → `a/b`），但保留根路径（`/`）；
/// - 输出分隔符使用 host 平台默认分隔符（当前主要面向 POSIX：`/`）。
fun normalize(path: String): String

/// 拼接两个路径片段。
///
/// 约定（subset）：
/// - 若 `child` 为绝对路径（以分隔符开头），则直接返回 `normalize(child)`；
/// - 否则在 `base` 与 `child` 之间插入一个分隔符（必要时），再做 `normalize`。
fun join(base: String, child: String): String

/// 返回路径的最后一段（不包含分隔符）。
///
/// 约定（subset）：
/// - 会忽略末尾的分隔符；
/// - 根路径（`/`）的 basename 为 `/`。
fun basename(path: String): String

/// 返回路径的父目录部分。
///
/// 约定（subset）：
/// - 会忽略末尾的分隔符；
/// - 若不存在分隔符，则返回 `.`；
/// - 根路径（`/`）的 dirname 为 `/`。
fun dirname(path: String): String

