package scoop.tests.textbackend

import scoop.charset.normalizeNfc
import scoop.test.*
import scoop.text.*

@Test
private class NormalizationConformanceTests {
    @Test
    fun `Unicode 17 NFC conformance invariants cover every official vector`() {
        var checked = 0L
        var lineNumber = 0L
        for (line in unicodeData("NormalizationTest.txt").lineSequence()) {
            lineNumber += 1L
            val body = line.split('#')[0L].trim()
            if (body.length == 0L || body[0L] == '@') continue
            val fields = body.split(';')
            val source = scalarSequence(fields[0L])
            val nfc = scalarSequence(fields[1L])
            val nfd = scalarSequence(fields[2L])
            val nfkc = scalarSequence(fields[3L])
            val nfkd = scalarSequence(fields[4L])
            val detail = Some("NormalizationTest line " + lineNumber.toString())
            assertEquals(nfc, normalizeNfc(source), detail)
            assertEquals(nfc, normalizeNfc(nfc), detail)
            assertEquals(nfc, normalizeNfc(nfd), detail)
            assertEquals(nfkc, normalizeNfc(nfkc), detail)
            assertEquals(nfkc, normalizeNfc(nfkd), detail)
            checked += 1L
        }
        assertTrue(checked > 19000L)
    }
}
