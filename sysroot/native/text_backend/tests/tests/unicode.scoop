package scoop.tests.textbackend

import scoop.charset.*
import scoop.test.*
import scoop.text.*

@Test
private class UnicodeEditingConformanceTests {
    @Test
    fun `Unicode 17 grapheme boundaries cover every official vector`() {
        var checked = 0L
        var lineNumber = 0L
        for (line in unicodeData("GraphemeBreakTest.txt").lineSequence()) {
            lineNumber += 1L
            val body = line.split('#')[0L].trim()
            if (body.length == 0L) continue
            val text = StringBuilder()
            val expected = ArrayList<Long>()
            var position = 0L
            for (token in body.split(' ')) {
                if (token.length == 0L || token == "×") continue
                if (token == "÷") expected.add(position)
                else {
                    text.append(token.toInt(16).toChar())
                    position += 1L
                }
            }
            val actual = graphemeBoundaries(text.toString())
            val detail = Some("GraphemeBreakTest line " + lineNumber.toString())
            assertEquals(expected.size, actual.size, detail)
            for (index in 0L..<expected.size) assertEquals(expected[index], actual[index], detail)
            checked += 1L
        }
        assertEquals(766L, checked)
    }

    @Test
    fun `Unicode 17 default full case folding covers all C and F mappings`() {
        var checked = 0L
        var lineNumber = 0L
        for (line in unicodeData("CaseFolding.txt").lineSequence()) {
            lineNumber += 1L
            val body = line.split('#')[0L].trim()
            if (body.length == 0L) continue
            val fields = body.split(';')
            val status = fields[1L].trim()
            if (status != "C" && status != "F") continue
            val source = scalarSequence(fields[0L])
            val expected = scalarSequence(fields[2L])
            val detail = Some("CaseFolding line " + lineNumber.toString())
            assertEquals(expected, unicodeCasefold(source), detail)
            assertEquals(expected, unicodeCasefold(expected), detail)
            checked += 1L
        }
        assertEquals(1585L, checked)
    }
}
