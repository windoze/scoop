// Scoop sysroot: net surface（std v4，early stage）
//
// 说明：
// - 该模块提供标准库 `scoop.net` 的最小声明表面（T1320d）；
// - 当前阶段只固定 API 形状与失败/不支持语义：通过 capability gating + 返回值表达；
// - 真实 socket/DNS backend 将在后续任务中落地，并要求平台差异隔离在 runtime 的 backends 层。

package scoop.net

import scoop.core.*

/// TCP 连接句柄（opaque handle；语义由 std/runtime 约定）。
class TcpStream

/// TCP 监听句柄（opaque handle；语义由 std/runtime 约定）。
class TcpListener

/// capability gating：当前平台/构建是否支持 TCP sockets。
///
/// 返回值约定：
/// - `true`：平台提供可用的 TCP socket 能力；
/// - `false`：平台不支持（或当前构建未启用对应 backend）。
fun tcpIsSupported(): Bool

/// 建立到 `host:port` 的 TCP 连接。
///
/// 说明：
/// - `host` 在当前阶段被视为“抽象地址字符串”；不保证支持 DNS/IPv6 等更复杂能力；
/// - 更完整的地址模型（`SocketAddr`/`IpAddr`/`DnsName` 等）后续在 `std` 任务中逐步补齐。
///
/// 返回值约定：
/// - `Some(stream)`：连接成功；
/// - `None`：连接失败或平台不支持。
fun tcpConnect(host: String, port: Int): TcpStream?

/// 绑定 `host:port` 并开始监听。
///
/// 返回值约定：
/// - `Some(listener)`：监听成功；
/// - `None`：绑定失败或平台不支持。
fun tcpListen(host: String, port: Int): TcpListener?

/// 接受一个新连接（阻塞式）。
///
/// 返回值约定：
/// - `Some(stream)`：成功 accept；
/// - `None`：accept 失败、listener 已关闭，或平台不支持。
fun TcpListener.accept(): TcpStream?

/// 关闭 listener（幂等；失败语义由 backend 决定，当前阶段不暴露错误码）。
fun TcpListener.close(): Unit

/// 写入一段 UTF-8 文本到连接（不追加换行）。
///
/// 返回值约定：
/// - 0：成功；
/// - 非 0：失败或平台不支持。
fun TcpStream.writeUtf8(text: String): Int

/// 读取最多 `maxBytes` 字节并按 UTF-8 文本返回（不做 UTF-8 校验）。
///
/// 返回值约定：
/// - `Some(text)`：读取到数据；
/// - `None`：EOF/读取失败/平台不支持。
fun TcpStream.readUtf8(maxBytes: Int): String?

/// 关闭连接（幂等；失败语义由 backend 决定，当前阶段不暴露错误码）。
fun TcpStream.close(): Unit
