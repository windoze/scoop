// Scoop sysroot: standard delegates (spec §10.4)
//
// 说明：
// - 本文件仅提供“声明表面”，用于名字解析与类型检查；
// - 标准库的真实实现与线程安全/运行期语义由后续 runtime/stdlib 任务补齐。

package scoop.delegates

import scoop.core.*

/// 委托属性的只读接口（spec §10.4）。
interface ReadOnlyProperty<in T, out V> {
    fun getValue(thisRef: T, property: PropertyMeta): V
}

/// 委托属性的可写接口（spec §10.4）。
interface ReadWriteProperty<in T, V> : ReadOnlyProperty<T, V> {
    fun setValue(thisRef: T, property: PropertyMeta, value: V)
}

/// `lazy` 的线程安全策略（Kotlin-like，spec §10.4 示例）。
enum LazyThreadSafetyMode {
    None,
    Publication,
    Synchronized,
}

/// lazy：首次读取时计算并缓存（实现语义后续补齐）。
fun <V> lazy(initializer: () -> V): ReadOnlyProperty<Any, V>

/// lazy：指定线程安全策略（实现语义后续补齐）。
fun <V> lazy(mode: LazyThreadSafetyMode, initializer: () -> V): ReadOnlyProperty<Any, V>

/// observable：每次写入触发回调（实现语义后续补齐）。
fun <V> observable(initial: V, onChange: (V, V) -> Unit): ReadWriteProperty<Any, V>

/// vetoable：写入前触发回调，返回 false 时拒绝（实现语义后续补齐）。
fun <V> vetoable(initial: V, onChange: (V, V) -> Bool): ReadWriteProperty<Any, V>
