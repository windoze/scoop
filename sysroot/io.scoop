// Scoop sysroot: io surface（std v2，early stage）
//
// 说明：
// - 该模块提供标准库 `scoop.io` 的最小可执行表面（T1318e）。
// - 当前阶段以 “stdin/stdout/stderr 抽象” 的 API 形状为主：
//   - `Stdout.writeString`：向标准输出写入 UTF-8 字符串
//   - `Stderr.writeString`：向标准错误写入 UTF-8 字符串
//   - `Stdin.readLine`：从标准输入读取一行（去掉行尾换行），EOF 返回 `None`
// - 真实实现由 LLVM codegen 直接映射到 runtime C 符号（`scoop_io_*`）。

package scoop.io

import scoop.core.*

/// 向 stdout 写入 UTF-8 字符串（不追加换行）。
fun stdoutWriteString(value: String): Unit

/// 向 stderr 写入 UTF-8 字符串（不追加换行）。
fun stderrWriteString(value: String): Unit

/// 从 stdin 读取一行文本（去掉行尾 `\\n`/`\\r\\n`）。
///
/// 返回值约定：
/// - `None` 表示 EOF 或读取失败（早期阶段不区分错误类型）；
/// - `Some(String)` 表示读取成功；字符串数据按 UTF-8 字节序列承载。
fun stdinReadLine(): String?
