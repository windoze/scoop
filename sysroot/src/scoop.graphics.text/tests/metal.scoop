package scoop.graphics.text

import scoop.graphics.*
import scoop.graphics.native.*
import scoop.graphics.native.macos.MetalContext
import scoop.tests.graphics.TestMetalSurface
import scoop.test.*

@Test
private class MetalTextTest {
    @Test
    fun `independent text library draws into Metal through the scoped canvas bridge`() {
        testFonts().use {
            fonts -> Paragraph(fonts, "HHHH", TextStyle(["Test Sans"], 20.0)).use {
                paragraph -> paragraph.layout(80.0).use {
                    layout -> TestMetalSurface.create(160, 100).use {
                        objects -> @Unsafe
                        {
                            MetalContext.create(objects.device(), objects.queue()).use {
                                context -> @Unsafe
                                {
                                    context.target(objects.texture(), 160, 100, 2.0).use {
                                        target ->
                                        target.draw {
                                            canvas ->
                                            canvas.clear(Color.Transparent)
                                            canvas.translate(5.0, 4.0)
                                            canvas.clipRect(Rect(0.0, 0.0, 30.0, 25.0))
                                            canvas.drawText(layout, Point(2.0, 3.0))
                                            @Unsafe
                                            {
                                                captureGeometry(
                                                    canvas,
                                                    Rect(0.0, 0.0, 50.0, 50.0)
                                                ).use {
                                                    geometry ->
                                                    assertEquals(
                                                        Some(Point(1.0, 1.0)),
                                                        geometry.toLocal(Point(6.0, 5.0))
                                                    )
                                                    assertFalse(geometry.hitTest(Point(36.0, 5.0)))
                                                }
                                            }
                                        }
                                        target.submit()
                                        val pixels = target.readPixels()
                                        assertTrue(hasInk(pixels))
                                        for (y in 0 ..< 100)
                                            for (x in 0 ..< 160)
                                                if (
                                                    pixels[
                                                        ((y * 160 + x) * 4 + 3).toLong()
                                                    ].toUByte().toInt() >
                                                        0
                                                )
                                                    assertTrue(
                                                        x >= 14 && x < 70 && y >= 14 && y < 58
                                                    )
                                    }
                                    context.drain()
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
