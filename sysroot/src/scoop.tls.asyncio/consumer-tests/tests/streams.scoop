package scoop.tests.tls.asyncconsumer

import scoop.asyncio.*
import scoop.crypto.*
import scoop.crypto.x509.*
import scoop.tests.scoop.crypto.testdata.*
import scoop.platform.memory.NativeByteBuffer
import scoop.platform.net.*
import scoop.platform.system.OsString
import scoop.test.*
import scoop.tls.*
import scoop.tls.asyncio.*

/**
 * Exercises published asynchronous TLS wrappers with real event-loop and scope ownership.
 */
@Test
private class AsyncTlsConsumerTests {
    /**
     * Resolves localhost and round-trips TLS bytes between scoped client/server tasks,
     * validating resource retention and graceful close.
     */
    @Test
    fun `published async wrappers compose with M49 scopes and resource helpers`() {
        val loop: EventLoop = LibuvEventLoop()
        loop.run suspend { scope ->
            val root = Certificate.fromPem(rootPem())
            val leaf = Certificate.fromPem(serverPem())
            val chain = Certificate.fromPem(intermediatePem())
            val key = PrivateKey.fromPem(serverKeyPem())
            val store = TrustStore.fromCertificates([root])
            val clientConfig = TlsClientContext(store)
            val serverConfig = TlsServerContext([leaf, chain], key)
            root.close(); leaf.close(); chain.close(); key.close(); store.close()
            val listener = loop.listenTcp(SocketAddress(IpAddress.IPV4_LOOPBACK, 0))
            try {
                val serving = scope.launch suspend {
                    AsyncTlsStream.takeOwnershipAsServer(listener.accept(), serverConfig).useAsync suspend { server ->
                        NativeByteBuffer.allocate(1L).use suspend { bytes ->
                            server.readFully(bytes)
                            server.writeFully(bytes)
                            server.shutdownGracefully()
                        }
                    }
                }
                val addresses = loop.resolve(OsString.fromString("localhost"), listener.localAddress.port, Some(AddressFamily.Ipv4))
                assertTrue(addresses.size > 0L)
                AsyncTlsStream.takeOwnershipAsClient(loop.connectTcp(addresses[0L]), clientConfig, TlsPeerName.Dns("localhost")).useAsync suspend { client ->
                    NativeByteBuffer.allocate(1L).use suspend { bytes ->
                        bytes.writeByte(42)
                        client.writeFully(bytes)
                        client.flush()
                        bytes.clear()
                        client.readFully(bytes)
                        assertEquals(42.toByte(), bytes.getByte(0L))
                        client.shutdownGracefully()
                        assertTrue(client.isClosed)
                    }
                }
                serving.join()
            } finally { listener.close(); clientConfig.close(); serverConfig.close() }
        }
    }
}
