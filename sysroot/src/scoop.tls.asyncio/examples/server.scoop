//! dep: scoop:scoop.asyncio:0.1.0
//! dep: scoop:scoop.crypto:0.1.0
//! dep: scoop:scoop.platform:0.1.0
//! dep: scoop:scoop.tls:0.1.0
//! dep: scoop:scoop.tls.asyncio:0.1.0

import scoop.asyncio.*
import scoop.crypto.PrivateKey
import scoop.crypto.x509.Certificate
import scoop.platform.fs.*
import scoop.platform.memory.NativeByteBuffer
import scoop.platform.net.*
import scoop.text.toInt
import scoop.tls.*
import scoop.tls.asyncio.*

fun main(args: Array<String>): Int {
    if (args.size < 3L) {
        println("Usage: server CERT.pem KEY.pem [PORT]")
        return 2
    }
    val port =
        if (args.size > 3L)
            args[3L].toInt()
        else
            8444
    // Load server credentials before entering the event loop.
    Certificate.fromPem(Path.fromString(args[1L]).readText()).use {
        certificate -> PrivateKey.fromPem(Path.fromString(args[2L]).readText()).use {
            key -> TlsServerContext([certificate], key).use {
                context ->
                val loop: EventLoop = PlatformEventLoop()
                loop.run suspend {
                    _ -> loop.listenTcp(
                        SocketAddress(IpAddress.IPV4_LOOPBACK, port)
                    ).useAsync suspend {
                        listener ->
                        println(f"Listening on ${listener.localAddress.toString()}")
                        AsyncTlsStream.takeOwnershipAsServer(
                            listener.accept(),
                            context
                        ).useAsync suspend {
                            stream ->
                            val message = "Hello over async TLS!\n".toByteArray()
                            NativeByteBuffer.allocate(message.size).use suspend {
                                buffer ->
                                buffer.writeBytes(message)
                                stream.writeFully(buffer)
                            }
                            stream.flush()
                            stream.shutdownGracefully()
                        }
                    }
                }
            }
        }
    }
    return 0
}
