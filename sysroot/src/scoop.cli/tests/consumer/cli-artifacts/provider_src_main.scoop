package scoop.cli.tests.consumer.cli_artifacts.p2

import scoop.test.*
import scoop.cli.*
import scoop.cli.CliOption as NamedOption

@Target([AnnotationTarget.Type])
private annotation class Marker(val text: String)

public struct Arguments(
    @CliArgument(position = 0L, valueName = "FILE") @Serialize(rename = "wire-source") val source: String,
    @Serialize(ignore = true) val cache: Int = 42,
    @Serialize(required = true) @NamedOption(names = ["--output", "-o"], defaultText = "not optional") val output: String? = None,
    @Serialize(emitNull = true) val extra: @Marker("type only") String?,
    @DebugRedact val secret: String = "private"
) { public companion object : ValueEncoder<Arguments>, ValueDecoder<Arguments>, ValueInspector<Arguments> }

public class ClassArguments public constructor(public val code: Int = 3) {
    public companion object : ValueDecoder<ClassArguments>
}

public struct GenericArguments<T>(@NamedOption(names = ["--item", "-i"]) val value: T)
public class GenericCodec<T> public constructor(private val element: ValueDecoder<T>) : ValueDecoder<GenericArguments<T>>
public fun <T> genericSchema(): CliSchema<GenericArguments<T>> = Cli.schema(typeInfo<GenericArguments<T>>(), CliConfig("generic"))
public fun <T> genericParser(element: ValueDecoder<T>): CliParser<GenericArguments<T>> = CliParser(genericSchema<T>(), GenericCodec<T>(element))

public struct MaybeArguments<T>(val value: T?)
public class MaybeCodec<T> public constructor(private val element: ValueDecoder<T>) : ValueDecoder<MaybeArguments<T>>
