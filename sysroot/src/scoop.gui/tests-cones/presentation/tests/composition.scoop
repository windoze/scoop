package scoop.tests.gui.presentation

import scoop.graphics.*
import scoop.gui.*
import scoop.platform.time.MonotonicTimeSource
import scoop.test.*
import scoop.tests.gui.sampleWindowPixel
import scoop.time.Duration
import scoop.window.*

@Test
private class CompositionTest {
    @Test
    fun `transparent windows preserve premultiplied alpha through desktop composition`() {
        val probe = CompositionProbe()
        val host = GuiHost { owner, active, event -> probe.event(owner, active, event) }
        try {
            Application().run(host)
            assertTrue(probe.finished)
        } finally {
            host.close()
        }
    }
}

private class CompositionProbe {
    var front: Window? = None
    var backgroundPainted = false
    var frontPainted = false
    var settling = false
    var finished = false

    fun event(host: GuiHost, application: ActiveApplication, event: ApplicationEvent) {
        when (event) {
            case Resumed -> {
                val background = application.createWindow(attributes("Scoop GUI background", false))
                host.attach(background) {
                    frame ->
                    frame.canvas.clear(Color(0.0, 0.0, 1.0))
                    backgroundPainted = true
                }
                val foreground = application.createWindow(attributes("Scoop GUI transparent", true))
                front = Some(foreground)
                foreground.requestFocus()
                host.attach(foreground) {
                    frame ->
                    frame.canvas.clear(Color.Transparent)
                    frame.canvas.drawRect(
                        Rect(20.0, 20.0, 60.0, 80.0),
                        Paint(Color(1.0, 0.0, 0.0, 0.5))
                    )
                    frontPainted = true
                }
                waitFor(application, 5000L)
            }
            case AboutToWait -> {
                if (backgroundPainted && frontPainted && !settling) {
                    settling = true
                    waitFor(application, 250L)
                }
            }
            case NewEvents(StartCause.Deadline) -> {
                assertTrue(
                    settling,
                    Some("both windows must present before the composition deadline")
                )
                assertPixel(sampleWindowPixel(front!!, 110.0, 60.0), 0, 0, 255)
                assertPixel(sampleWindowPixel(front!!, 50.0, 60.0), 128, 0, 127)
                finished = true
                application.requestExit()
            }
            else -> {}
        }
    }

    private fun attributes(title: String, transparent: Boolean): WindowAttributes =
        WindowAttributes(
            title,
            LogicalSize(160.0, 120.0),
            decorations = false,
            resizable = false,
            transparent = transparent,
            position = Some(DesktopPosition(200.0, 200.0)),
            level = WindowLevel.AlwaysOnTop
        )

    private fun assertPixel(pixel: Long, red: Int, green: Int, blue: Int) {
        assertTrue(pixel >= 0L, Some("cannot sample the composed desktop"))
        assertChannel((pixel % 256L).toInt(), red)
        assertChannel((pixel / 256L % 256L).toInt(), green)
        assertChannel((pixel / 65536L).toInt(), blue)
    }

    private fun assertChannel(actual: Int, expected: Int) {
        assertTrue(
            actual >= expected - 3 && actual <= expected + 3,
            Some(
                "composed channel: expected " + expected.toString() + ", found " + actual.toString()
            )
        )
    }

    private fun waitFor(application: ActiveApplication, milliseconds: Long) {
        application.setControlFlow(
            ControlFlow.WaitUntil(
                MonotonicTimeSource.markNow() + Duration.milliseconds(milliseconds)
            )
        )
    }
}
