package scoop.gui

import scoop.time.*

public enum AnimationState {
    Idle, Running, Paused, Finished, Cancelled, Closed
}

private enum AnimationPlayback {
    Idle, Running(MotionRun, TimeMark), Paused(MotionRun, TimeMark, TimeMark),
    Finished(MotionRun), Cancelled, Closed
}

/** Persistent value state. Active runs are owned and sampled by one timeline. */
public class Animatable<T> internal constructor(
    private val timeline: AnimationTimeline,
    initial: T,
    private val converter: AnimationConverter<T>
): Closeable {
    private var current: T = initial
    private var goal: T = initial
    private var vector: AnimationVector = converter.toVector(initial)
    private var speed = AnimationVector()
    private var playback = AnimationPlayback.Idle
    private var callback: ((T) -> Unit)? = None
    init {
        vector.check()
    }
    public val value: T get() {
        timeline.checkThread();
        return current
    }
    public val target: T get() {
        timeline.checkThread();
        return goal
    }
    public val velocity: AnimationVector get() {
        timeline.checkThread();
        return speed
    }
    public val state: AnimationState get() {
        timeline.checkThread()
        return when (playback) {
            case Idle -> AnimationState.Idle
            case Running(_, _) -> AnimationState.Running
            case Paused(_, _, _) -> AnimationState.Paused
            case Finished(_) -> AnimationState.Finished
            case Cancelled -> AnimationState.Cancelled
            case Closed -> AnimationState.Closed
        }
    }
    /** Retargets from the current time and retains the current vector velocity for a spring. */
    public fun animateTo(
        target: T,
        spec: AnimationSpec = AnimationSpec.Tween(Duration.milliseconds(300L)),
        repeat: Repeat? = None,
        onFinished: ((T) -> Unit)? = None
    ) {
        checkOpen()
        val destination = converter.toVector(target)
        destination.check()
        val now = timeline.now()
        sample(now)
        val run = MotionRun(vector, destination, speed, spec, repeat)
        playback = AnimationPlayback.Running(run, now)
        goal = target
        callback = onFinished
        timeline.schedule(this)
        sample(now)
        timeline.changed()
    }
    public fun snapTo(value: T) {
        checkOpen()
        val next = converter.toVector(value)
        next.check()
        playback = AnimationPlayback.Idle
        callback = None
        current = value
        goal = value
        vector = next
        speed = AnimationVector()
        timeline.unschedule(this)
        timeline.changed()
    }
    public fun cancel() {
        timeline.checkThread()
        if (state == AnimationState.Closed)
            return
        sample(timeline.now())
        playback = AnimationPlayback.Cancelled
        callback = None
        speed = AnimationVector()
        timeline.unschedule(this)
        timeline.changed()
    }
    public fun pause() {
        checkOpen()
        val now = timeline.now()
        sample(now)
        when (playback) {
            case Running(run, start) -> {
                playback = AnimationPlayback.Paused(run, start, now)
                timeline.unschedule(this)
                timeline.changed()
            }
            else -> {}
        }
    }
    public fun resume() {
        checkOpen()
        when (playback) {
            case Paused(run, start, paused) -> {
                val now = timeline.now()
                playback = AnimationPlayback.Running(run, start + (now - paused))
                timeline.schedule(this)
                timeline.changed()
            }
            else -> {}
        }
    }
    /** Starts a new full segment toward the previous segment's origin. */
    public fun reverse() {
        checkOpen()
        val run =
            when (playback) {
                case Running(value, _) -> value
                case Paused(value, _, _) -> value
                case Finished(value) -> value
                else -> throw IllegalStateException(Some("no animation segment to reverse"))
            }
        animateTo(converter.fromVector(run.origin), run.spec, run.repeat, callback)
    }
    internal fun sample(time: TimeMark) {
        when (playback) {
            case Running(run, start) -> {
                val sampled = run.sample(durationSeconds(time - start))
                sampled.value.check()
                sampled.velocity.check()
                current = converter.fromVector(sampled.value)
                vector = converter.toVector(current)
                speed = sampled.velocity
                goal = converter.fromVector(sampled.target)
                if (sampled.finished) {
                    playback = AnimationPlayback.Finished(run)
                    timeline.unschedule(this)
                    when (callback) {
                        case Some(handler) -> timeline.finished {
                            when (playback) {
                                case Finished(currentRun) -> {
                                    if (currentRun === run)
                                        handler(current)
                                }
                                else -> {}
                            }
                        }
                        case None -> {}
                    }
                }
            }
            else -> {}
        }
    }
    private fun checkOpen() {
        timeline.checkOpen()
        if (state == AnimationState.Closed)
            throw IllegalStateException(Some("animation is closed"))
    }
    public override fun close() {
        timeline.checkThread()
        if (state == AnimationState.Closed)
            return
        playback = AnimationPlayback.Closed
        callback = None
        speed = AnimationVector()
        timeline.detached(this)
        timeline.changed()
    }
}
