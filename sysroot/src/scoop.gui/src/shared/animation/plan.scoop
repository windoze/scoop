package scoop.gui

import scoop.math.max
import scoop.math.min
import scoop.time.Duration

public enum AnimationSpec {
    Tween(val duration: Duration, val easing: Easing = Easing.Linear),
    Spring(
        val stiffness: Double = 150.0,
        val dampingRatio: Double = 0.8,
        val displacementThreshold: Double = 0.001,
        val velocityThreshold: Double = 0.001
    )
}

public enum RepeatMode {
    Restart, Reverse
}

public class Repeat public constructor(
    public val iterations: Long? = None,
    public val mode: RepeatMode = RepeatMode.Restart
)

internal struct MotionSample(val value: AnimationVector, val velocity: AnimationVector)

internal struct RunSample(
    val value: AnimationVector,
    val velocity: AnimationVector,
    val target: AnimationVector,
    val finished: Boolean
)

internal interface MotionPlan {
    val duration: Double
    fun sample(seconds: Double): MotionSample
}

private class TweenPlan(
    private val from: AnimationVector,
    private val to: AnimationVector,
    public override val duration: Double,
    private val easing: Easing
): MotionPlan {
    public override fun sample(seconds: Double): MotionSample {
        if (seconds >= duration)
            return MotionSample(to, AnimationVector())
        val fraction = min(1.0, max(0.0, seconds / duration))
        val distance = to.subtract(from)
        return MotionSample(
            from.add(distance.scale(easing.transform(fraction))),
            distance.scale(easing.slope(fraction) / duration)
        )
    }
}

internal fun durationSeconds(value: Duration): Double =
    value.floorSeconds.toDouble() + value.nanosecondsOfSecond.toDouble() / 1000000000.0

internal fun motionPlan(
    from: AnimationVector,
    to: AnimationVector,
    velocity: AnimationVector,
    spec: AnimationSpec
): MotionPlan {
    from.check();
    to.check();
    velocity.check();
    to.subtract(from).check()
    return when (spec) {
        case Tween(duration, easing) -> {
            requireAnimation(duration >= Duration.ZERO, "negative animation duration")
            TweenPlan(from, to, durationSeconds(duration), easing)
        }
        case Spring(stiffness, damping, displacement, speed) -> springPlan(
            from,
            to,
            velocity,
            stiffness,
            damping,
            displacement,
            speed
        )
    }
}

/** A whole repeated run is sampled directly; missed cycles never run callback loops. */
internal class MotionRun(
    val origin: AnimationVector,
    val destination: AnimationVector,
    velocity: AnimationVector,
    val spec: AnimationSpec,
    val repeat: Repeat?
) {
    private val first = motionPlan(origin, destination, velocity, spec)
    private val forward = motionPlan(origin, destination, AnimationVector(), spec)
    private val backward = motionPlan(destination, origin, AnimationVector(), spec)
    private val iterations: Long? =
        when (repeat) {
            case Some(value) -> value.iterations;
            case None -> Some(1L)
        }
    private val reverse =
        when (repeat) {
            case Some(value) -> value.mode == RepeatMode.Reverse;
            case None -> false
        }
    init {
        when (iterations) {
            case Some(value) -> requireAnimation(value > 0L, "repeat count must be positive");
            case None -> {}
        }
        when (repeat) {
            case Some(_) -> requireAnimation(
                first.duration > 0.0 && forward.duration > 0.0,
                "zero duration cannot repeat"
            );
            case None -> {}
        }
    }
    fun sample(seconds: Double): RunSample {
        when (iterations) {
            case Some(count) -> {
                val end = first.duration + (count - 1L).toDouble() * forward.duration
                if (seconds >= end) {
                    val finalValue =
                        if (reverse && count % 2L == 0L)
                            origin
                        else
                            destination
                    return RunSample(finalValue, AnimationVector(), finalValue, true)
                }
            }
            case None -> {}
        }
        if (seconds < first.duration) {
            val value = first.sample(seconds)
            return RunSample(value.value, value.velocity, destination, false)
        }
        val elapsed = seconds - first.duration
        val position = elapsed % forward.duration
        val reversed = reverse && elapsed % (2.0 * forward.duration) < forward.duration
        val plan =
            if (reversed)
                backward
            else
                forward
        val value = plan.sample(position)
        return RunSample(
            value.value,
            value.velocity,
            if (reversed)
                origin
            else
                destination,
            false
        )
    }
}
