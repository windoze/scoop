package scoop.examples.gui

import scoop.graphics.Point
import scoop.gui.*
import scoop.test.*
import scoop.time.*

private class DragClock: TimeSource {
    private var reading = Duration.ZERO
    public override fun markNow(): TimeMark = TimeMark(this, reading)
    fun at(milliseconds: Long): TimeMark {
        reading = Duration.milliseconds(milliseconds)
        return markNow()
    }
}

@Test
private class DemoDragTest {
    @Test
    fun `focus loss outside the window returns home without waiting for a release`() {
        val clock = DragClock()
        val redraws = ArrayList<Int>()
        AnimationTimeline(clock, { redraws.add(1) }).use {
            timeline ->
            val home = Point(180.0, 184.0)
            val position = timeline.value(home)
            val drag = DemoDrag(position, home)
            val outside = Point(960.0, -80.0)
            drag.press(home)
            drag.move(outside)
            assertEquals(outside, position.value)
            drag.cancel(GuiWindowState.Open)
            assertEquals(home, position.target)
            assertEquals(AnimationState.Running, position.state)
            timeline.advanceTo(clock.at(100L))
            assertTrue(position.value != outside)
            val returning = position.value
            val requests = redraws.size
            drag.move(Point(1000.0, -120.0))
            drag.release()
            drag.cancel(GuiWindowState.Open)
            assertEquals(returning, position.value)
            assertEquals(requests, redraws.size)
            timeline.advanceTo(clock.at(30000L))
            assertEquals(home, position.value)
            assertFalse(timeline.hasWork)

            drag.press(home)
            drag.move(Point(200.0, 204.0))
            assertEquals(Point(200.0, 204.0), position.value)
            drag.release()
            timeline.advanceTo(clock.at(60000L))
            assertEquals(home, position.value)
            assertFalse(timeline.hasWork)
        }
    }

    @Test
    fun `closing a dragged window clears the gesture without starting another animation`() {
        val clock = DragClock()
        AnimationTimeline(clock).use {
            timeline ->
            val home = Point(180.0, 184.0)
            val outside = Point(960.0, -80.0)
            val position = timeline.value(home)
            val drag = DemoDrag(position, home)
            drag.press(home)
            drag.move(outside)
            drag.cancel(GuiWindowState.Closing)
            assertEquals(outside, position.value)
            assertFalse(timeline.hasWork)
            timeline.close()
            drag.cancel(GuiWindowState.Closed)
            drag.move(home)
            drag.release()
            assertEquals(AnimationState.Closed, position.state)
        }
    }
}
