package scoop.gui

import scoop.graphics.*
import scoop.platform.concurrent.currentThreadId
import scoop.platform.time.MonotonicTimeSource
import scoop.test.*
import scoop.tests.gui.ViewProbe
import scoop.time.Duration
import scoop.window.*
import scoop.window.native.*

@Test
private class GuiHostTest {
    @Test
    fun `native frame opportunities preserve input views and retire windows safely`() {
        val application = Application(ApplicationOptions(LastWindowPolicy.Exit))
        val probe = HostProbe()
        val host = GuiHost { owner, active, event -> probe.event(owner, active, event) }
        try {
            application.run(host)
            assertTrue(probe.finished)
            assertTrue(probe.firstFrames >= 2)
            assertTrue(probe.secondFrames >= 2)
            assertTrue(probe.repainted)
            assertTrue(host.isClosed)
            assertEquals(WindowState.Destroyed, probe.first!!.state)
            assertEquals(WindowState.Destroyed, probe.second!!.state)
        } catch (error: Throwable) {
            printFailure(error)
            throw error
        } finally {
            host.close()
            probe.release()
        }
    }
}

private fun printFailure(error: Throwable) {
    if (error is Exception)
        println(error.message ?: "GUI exception")
    if (error is AssertionFailure)
        println(error.message ?: "GUI assertion")
    if (error is ResourceUseException) {
        printFailure(error.primaryFailure)
        printFailure(error.cleanupFailure)
    }
}

private enum HostPhase {
    Start, Settle, Idle, Hidden, Resize, Closing, Reattach, Done
}

private class HostProbe {
    val thread = currentThreadId()
    var phase = HostPhase.Start
    var first: Window? = None
    var second: Window? = None
    var guiFirst: GuiWindow? = None
    var guiSecond: GuiWindow? = None
    var firstView: ViewProbe? = None
    var secondView: ViewProbe? = None
    var firstFrames = 0
    var secondFrames = 0
    var idleFirst = 0
    var idleSecond = 0
    var secondAfterClose = false
    var repainted = false
    var finished = false

    fun event(host: GuiHost, application: ActiveApplication, event: ApplicationEvent) {
        assertEquals(thread, currentThreadId())
        when (event) {
            case Resumed -> start(host, application)
            case NewEvents(StartCause.Deadline) -> deadline(application)
            case AboutToWait -> {
                if (phase == HostPhase.Start && firstFrames >= 2 && secondFrames >= 1) {
                    phase = HostPhase.Settle
                    waitFor(application, 200L)
                }
                if (phase == HostPhase.Closing && secondAfterClose) {
                    assertEquals(GuiWindowState.Closed, guiFirst!!.state)
                    assertTrue(firstView!!.restored())
                    guiSecond!!.close()
                    assertTrue(secondView!!.restored())
                    phase = HostPhase.Reattach
                    guiFirst =
                        Some(
                            host.attach(first!!) {
                                frame ->
                                frame.canvas.clear(Color(0.0, 0.5, 0.0))
                                repainted = true
                                // Destroying the native window during a borrowed frame must abort it.
                                first!!.requestDestroy()
                            }
                        )
                    waitFor(application, 5000L)
                }
            }
            case Window(id, WindowEvent.Destroyed) -> {
                if (id == first!!.id && phase == HostPhase.Reattach) {
                    assertTrue(repainted)
                    assertEquals(GuiWindowState.Closed, guiFirst!!.state)
                    assertTrue(firstView!!.restored())
                    phase = HostPhase.Done
                    second!!.requestDestroy()
                }
            }
            case Exiting -> {
                finished = phase == HostPhase.Done
            }
            else -> {}
        }
    }

    private fun start(host: GuiHost, application: ActiveApplication) {
        val a =
            application.createWindow(
                WindowAttributes(
                    "Scoop GUI first",
                    LogicalSize(320.0, 180.0),
                    position = Some(DesktopPosition(100.0, 150.0))
                )
            )
        val b =
            application.createWindow(
                WindowAttributes(
                    "Scoop GUI second",
                    LogicalSize(260.0, 160.0),
                    position = Some(DesktopPosition(460.0, 150.0))
                )
            )
        first = Some(a)
        second = Some(b)
        a.setWindowLevel(WindowLevel.AlwaysOnTop)
        b.setWindowLevel(WindowLevel.AlwaysOnTop)
        a.requestFocus()
        firstView = Some(observe(a))
        secondView = Some(observe(b, true))
        guiFirst = Some(host.attach(a) { frame -> paintFirst(frame) })
        guiSecond = Some(host.attach(b) { frame -> paintSecond(frame) })
        assertFailsWith<IllegalStateException> { host.attach(a) { _ -> fail() } }
        waitFor(application, 5000L)
    }
    private fun observe(window: Window, customLayer: Boolean = false): ViewProbe {
        @Unsafe
        {
            return window.acquireNativeWindow().use {
                lease -> @Unsafe
                {
                    return@use when (lease.handle) {
                        case AppKit(_, view) -> ViewProbe(view, customLayer)
                    }
                }
            }
        }
    }
    private fun paintFirst(frame: FrameContext) {
        assertEquals(thread, currentThreadId())
        firstFrames += 1
        checkView(firstView!!, first!!)
        frame.canvas.clear(Color.White)
        frame.canvas.drawRect(Rect(8.0, 8.0, 40.0, 30.0), Paint(Color(1.0, 0.0, 0.0)))
        if (firstFrames == 1) {
            frame.window.requestFrame()
            frame.window.requestFrame()
        }
        if (phase == HostPhase.Resize && frame.size == Size(360.0, 200.0)) {
            phase = HostPhase.Closing
            frame.window.close()
            assertEquals(GuiWindowState.Closing, frame.window.state)
            guiSecond!!.requestFrame()
        }
    }
    private fun paintSecond(frame: FrameContext) {
        secondFrames += 1
        checkView(secondView!!, second!!)
        frame.canvas.clear(Color(0.0, 0.0, 1.0))
        if (phase == HostPhase.Closing)
            secondAfterClose = true
    }
    private fun checkView(probe: ViewProbe, window: Window) {
        val metrics = window.metrics!!
        assertTrue(
            probe.matches(
                metrics.physicalSize.width,
                metrics.physicalSize.height,
                metrics.scaleFactor
            )
        )
    }
    private fun deadline(application: ActiveApplication) {
        when (phase) {
            case Settle -> {
                idleFirst = firstFrames
                idleSecond = secondFrames
                phase = HostPhase.Idle
                waitFor(application, 150L)
            }
            case Idle -> {
                assertEquals(idleFirst, firstFrames)
                assertEquals(idleSecond, secondFrames)
                first!!.setVisible(false)
                guiFirst!!.requestFrame()
                phase = HostPhase.Hidden
                waitFor(application, 100L)
            }
            case Hidden -> {
                assertEquals(idleFirst, firstFrames)
                phase = HostPhase.Resize
                first!!.requestSize(LogicalSize(360.0, 200.0))
                first!!.setVisible(true)
                first!!.requestFocus()
                waitFor(application, 5000L)
            }
            else -> fail(
                Some(
                    "GUI native frame deadline expired: first=" +
                        firstFrames.toString() +
                        ", second=" +
                        secondFrames.toString()
                )
            )
        }
    }
    private fun waitFor(application: ActiveApplication, milliseconds: Long) {
        application.setControlFlow(
            ControlFlow.WaitUntil(
                MonotonicTimeSource.markNow() + Duration.milliseconds(milliseconds)
            )
        )
    }
    fun release() {
        firstView?.close()
        secondView?.close()
    }
}
