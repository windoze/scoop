package scoop.window

/** Mutable creation attributes, copied before creating the native object. */
public class WindowAttributes public constructor(
    public var title: String = "Scoop",
    public var size: LogicalSize = LogicalSize(800.0, 600.0),
    public var visible: Boolean = true,
    public var decorations: Boolean = true,
    public var resizable: Boolean = true,
    public var transparent: Boolean = false,
    public var requestActivation: Boolean = true,
    public var constraints: WindowSizeConstraints = WindowSizeConstraints(),
    public var position: DesktopPosition? = None,
    public var resizeIncrements: LogicalSize? = None,
    public var buttons: WindowButtons = WindowButtons(),
    public var level: WindowLevel = WindowLevel.Normal,
    public var theme: Theme? = None,
    public var blur: Boolean = false,
    public var contentProtected: Boolean = false
) {
    internal var titlebarFlags: Int = 0
    internal var applicationId: String = "scoop"
    internal var applicationInstance: String = "scoop"
}

/** An explicitly destroyed native window owned by its application's thread. */
public class Window internal constructor(internal val owner: WindowOwner) {
    public val id: WindowId get() = owner.id
    public val state: WindowState get() {
        owner.application.checkThread();
        return owner.phase
    }
    public val metrics: WindowMetrics? get() {
        owner.application.checkThread();
        return owner.metrics
    }
    /** Coalesces a redraw until this window can draw; never calls a handler recursively. */
    public fun requestRedraw() {
        owner.requireOpen();
        owner.dirty = true;
        owner.application.mailbox.wake()
    }
    /** Starts Closing; existing leases delay the eventual Destroyed event. */
    public fun requestDestroy() {
        owner.application.checkThread();
        owner.close()
    }
    /** Requests a content size; native geometry notifications report the observed result. */
    public fun requestSize(size: LogicalSize): RequestStatus {
        owner.requireOpen();
        checkSize(size);
        owner.constraints.check(size)
        size.toPhysical(1.0)
        @Unsafe
        {
            return owner.result(
                nativeWindowSize(owner.pointer!!, size.width, size.height),
                "request size"
            )
        }
    }
    public fun setTitle(title: String) {
        owner.requireOpen()
        checkNativeText(title)
        @Unsafe
        {
            title.withUtf8Bytes {
                pointer,
                count -> @Unsafe
                {
                    owner.result(nativeWindowTitle(owner.pointer!!, pointer, count), "set title")
                }
            }
        }
    }
    public fun setVisible(visible: Boolean): RequestStatus {
        owner.requireOpen()
        @Unsafe
        {
            val status =
                owner.result(
                    nativeWindowVisible(
                        owner.pointer!!,
                        if (visible)
                            1
                        else
                            0
                    ),
                    "set visibility"
                )
            owner.configure(nativeWindowSnapshot(owner.pointer!!))
            if (status != RequestStatus.Unsupported)
                owner.renderVisible = visible
            owner.application.mailbox.wake()
            return status
        }
    }
    /** Requests activation, with focus confirmed by native events. */
    public fun requestFocus(): RequestStatus {
        owner.requireOpen()
        @Unsafe
        {
            return owner.result(nativeWindowFocus(owner.pointer!!), "request focus")
        }
    }
    public val isVisible: Boolean get() = owner.snapshot().visible != 0
    public val isFocused: Boolean get() = owner.snapshot().focused != 0
    public val isOccluded: Boolean get() = owner.snapshot().occluded != 0
    public val observedTheme: Theme? get() =
        when (owner.snapshot().dark) {
            0 -> Some(Theme.Light)
            1 -> Some(Theme.Dark)
            else -> None
        }
    public val desktopPosition: DesktopPosition? get() {
        val value = owner.snapshot();
        if (value.positionKnown == 0)
            return None
        return Some(DesktopPosition(value.x, value.y))
    }
    public val outerBounds: DesktopRect? get() {
        val value = owner.snapshot();
        if (value.positionKnown == 0)
            return None
        return Some(
            DesktopRect(DesktopPosition(value.x, value.y), value.outerWidth, value.outerHeight)
        )
    }
    /** Arms native frame pacing before the renderer's actual buffer submission. */
    public fun prePresentNotify() {
        owner.requireOpen()
        val snapshot = owner.snapshot()
        if (
            !owner.renderVisible ||
                snapshot.configured ==
                0 ||
                snapshot.visible ==
                0 ||
                !snapshot.metrics().physicalSize.isDrawable
        )
            throw WindowException(
                "pre-present requires a drawable window",
                WindowErrorKind.InvalidState,
                owner.application.backend
            )
        @Unsafe
        {
            owner.result(nativeWindowPrePresent(owner.pointer!!), "pre-present")
        }
    }
}

internal fun checkNativeText(text: String) {
    for (byte in text.toByteArray())
        requireWindow(byte != 0, "native text contains NUL")
}

internal class WindowOwner(val application: ApplicationOwner, val id: WindowId, native: Ptr<Unit>) {
    var constraints: WindowSizeConstraints = WindowSizeConstraints()
    var buttons: WindowButtons = WindowButtons()
    var pointer: Ptr<Unit>? = Some(native)
    var phase: WindowState = WindowState.Open
    var metrics: WindowMetrics? = None
    var dirty: Boolean = false
    var renderVisible: Boolean = false
    var closingDelivered: Boolean = false
    var leases: Long = 0L
    var generation: Long = 0L
    fun configure(value: NativeSnapshot) {
        generation = value.generation
        if (value.configured == 0) {
            phase = WindowState.PendingConfigure
            metrics = None
        } else {
            phase = WindowState.Open
            metrics = Some(value.metrics())
        }
    }
    fun result(status: Int, operation: String): RequestStatus =
        when (status) {
            0 -> RequestStatus.Applied
            1 -> RequestStatus.Requested
            2 -> RequestStatus.Unsupported
            else -> throw application.nativeError(operation)
        }
    fun readyToDraw(): Boolean {
        if (phase != WindowState.Open)
            return false
        val published = metrics ?: return false
        val value = snapshot()
        return value.configured !=
            0 &&
            value.redrawReady !=
            0 &&
            value.visible !=
            0 &&
            value.occluded ==
            0 &&
            value.pixelWidth >
            0.0 &&
            value.pixelHeight >
            0.0 &&
            published.logicalSize.width ==
            value.width &&
            published.logicalSize.height ==
            value.height &&
            published.physicalSize.width.toDouble() ==
            value.pixelWidth &&
            published.physicalSize.height.toDouble() ==
            value.pixelHeight &&
            published.scaleFactor ==
            value.scale
    }
    fun requireOpen() {
        application.checkThread()
        if (phase != WindowState.Open && phase != WindowState.PendingConfigure)
            throw WindowException("window operation", WindowErrorKind.InvalidState)
    }
    fun snapshot(): NativeSnapshot {
        requireOpen();
        @Unsafe
        {
            return nativeWindowSnapshot(pointer!!)
        }
    }
    fun close() {
        if (phase == WindowState.Closing || phase == WindowState.Destroyed)
            return
        phase = WindowState.Closing
        dirty = false
        application.mailbox.wake()
    }
}
