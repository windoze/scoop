package scoop.window

internal fun ApplicationOwner.pump(stage: Int) {
    if (pumping) {
        mailbox.wake();
        return
    }
    pumping = true
    try {
        for (control in mailbox.takeControls()) {
            try {
                control()
            } catch (error: Throwable) {
                recordFailure(error);
                beginExit()
            }
        }
        val events = ArrayList<ApplicationEvent>()
        @Unsafe
        {
            var count = 0
            while (count < 64) {
                val pointer = nativeNextEvent(native!!) ?: break
                try {
                    events.add(copyNativeEvent(pointer))
                } finally {
                    nativeEventRelease(pointer)
                }
                count += 1
            }
            if (count == 64)
                mailbox.wake()
        }
        val business = mailbox.takeBusiness()
        val redraw = ArrayList<WindowOwner>()
        for (window in windows) {
            if (window.phase == WindowState.Open && window.dirty) {
                val value = window.snapshot()
                if (
                    value.visible !=
                        0 &&
                        value.occluded ==
                        0 &&
                        value.pixelWidth >
                        0.0 &&
                        value.pixelHeight >
                        0.0
                ) {
                    window.dirty = false
                    redraw.add(window)
                }
            }
        }
        val initial = !initialized
        initialized = true
        val hasBatch =
            initial ||
                stage ==
                1 ||
                events.size >
                0L ||
                business.size >
                0L ||
                redraw.size >
                0L ||
                flow ==
                ControlFlow.Poll
        if (!exiting && hasBatch) {
            val cause =
                if (initial)
                    StartCause.Init
                else
                    if (stage == 1)
                        StartCause.Deadline
                    else
                        if (flow == ControlFlow.Poll)
                            StartCause.Poll
                        else
                            StartCause.Wake
            if (stage == 1)
                flow = ControlFlow.Wait
            deliver(ApplicationEvent.NewEvents(cause))
            if (initial)
                deliver(ApplicationEvent.Resumed)
            for (event in events)
                dispatchNative(event)
            for (block in business)
                deliverBusiness(block)
            for (window in redraw)
                deliverWindow(window, WindowEvent.RedrawRequested)
            deliver(ApplicationEvent.AboutToWait)
        }
        drainShutdown()
        if (!exiting && flow == ControlFlow.Poll)
            mailbox.wake()
    } finally {
        pumping = false
    }
}

internal fun ApplicationOwner.deliverBusiness(block: () -> Unit) {
    if (exiting)
        return
    val invocation: () -> Unit =
        {
            if (!exiting) {
                dispatchDepth += 1
                try {
                    block()
                }
                catch (error: Throwable) {
                    recordFailure(error);
                    beginExit()
                }
                finally {
                    dispatchDepth -= 1;
                    if (exiting)
                        mailbox.wake()
                }
            }
        }
    when (attachment) {
        case Some(value) -> if (!value.post(invocation))
            beginExit()
        case None -> invocation()
    }
}

internal fun ApplicationOwner.deliver(event: ApplicationEvent) {
    deliverBusiness { handler!!.onEvent(active, event) }
}

internal fun ApplicationOwner.deliverWindow(window: WindowOwner, event: WindowEvent) {
    deliverBusiness {
        if (window.phase == WindowState.Open) {
            var ready = true
            when (event) {
                case GeometryChanged(value) -> window.metrics = Some(value);
                case RedrawRequested -> {
                    val value = window.snapshot()
                    ready =
                        value.visible !=
                            0 &&
                            value.occluded ==
                            0 &&
                            value.pixelWidth >
                            0.0 &&
                            value.pixelHeight >
                            0.0
                    if (!ready)
                        window.dirty = true
                }
                else -> {}
            }
            if (ready)
                handler!!.onEvent(active, ApplicationEvent.Window(window.id, event))
        }
    }
}

internal fun ApplicationOwner.dispatchNative(event: ApplicationEvent) {
    when (event) {
        case Window(identity, notification) -> {
            val window = findWindow(identity.value) ?: return
            deliverWindow(window, notification)
        }
        case MonitorsChanged -> {
            refreshMonitors();
            deliver(event)
        }
        else -> deliver(event)
    }
}
