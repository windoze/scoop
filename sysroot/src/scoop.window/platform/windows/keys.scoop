package scoop.window

// Win32 set-1 scan codes include the E0 prefix in bit 8; logical keys use VK values.
internal fun platformPhysicalKey(code: Long): PhysicalKey =
    when (code) {
        1L -> PhysicalKey.Code(KeyCode.Escape)
        2L -> PhysicalKey.Code(KeyCode.Digit1)
        3L -> PhysicalKey.Code(KeyCode.Digit2)
        4L -> PhysicalKey.Code(KeyCode.Digit3)
        5L -> PhysicalKey.Code(KeyCode.Digit4)
        6L -> PhysicalKey.Code(KeyCode.Digit5)
        7L -> PhysicalKey.Code(KeyCode.Digit6)
        8L -> PhysicalKey.Code(KeyCode.Digit7)
        9L -> PhysicalKey.Code(KeyCode.Digit8)
        10L -> PhysicalKey.Code(KeyCode.Digit9)
        11L -> PhysicalKey.Code(KeyCode.Digit0)
        12L -> PhysicalKey.Code(KeyCode.Minus)
        13L -> PhysicalKey.Code(KeyCode.Equal)
        14L -> PhysicalKey.Code(KeyCode.Backspace)
        15L -> PhysicalKey.Code(KeyCode.Tab)
        16L -> PhysicalKey.Code(KeyCode.KeyQ)
        17L -> PhysicalKey.Code(KeyCode.KeyW)
        18L -> PhysicalKey.Code(KeyCode.KeyE)
        19L -> PhysicalKey.Code(KeyCode.KeyR)
        20L -> PhysicalKey.Code(KeyCode.KeyT)
        21L -> PhysicalKey.Code(KeyCode.KeyY)
        22L -> PhysicalKey.Code(KeyCode.KeyU)
        23L -> PhysicalKey.Code(KeyCode.KeyI)
        24L -> PhysicalKey.Code(KeyCode.KeyO)
        25L -> PhysicalKey.Code(KeyCode.KeyP)
        26L -> PhysicalKey.Code(KeyCode.BracketLeft)
        27L -> PhysicalKey.Code(KeyCode.BracketRight)
        28L -> PhysicalKey.Code(KeyCode.Enter)
        29L -> PhysicalKey.Code(KeyCode.ControlLeft)
        30L -> PhysicalKey.Code(KeyCode.KeyA)
        31L -> PhysicalKey.Code(KeyCode.KeyS)
        32L -> PhysicalKey.Code(KeyCode.KeyD)
        33L -> PhysicalKey.Code(KeyCode.KeyF)
        34L -> PhysicalKey.Code(KeyCode.KeyG)
        35L -> PhysicalKey.Code(KeyCode.KeyH)
        36L -> PhysicalKey.Code(KeyCode.KeyJ)
        37L -> PhysicalKey.Code(KeyCode.KeyK)
        38L -> PhysicalKey.Code(KeyCode.KeyL)
        39L -> PhysicalKey.Code(KeyCode.Semicolon)
        40L -> PhysicalKey.Code(KeyCode.Quote)
        41L -> PhysicalKey.Code(KeyCode.Backquote)
        42L -> PhysicalKey.Code(KeyCode.ShiftLeft)
        43L -> PhysicalKey.Code(KeyCode.Backslash)
        44L -> PhysicalKey.Code(KeyCode.KeyZ)
        45L -> PhysicalKey.Code(KeyCode.KeyX)
        46L -> PhysicalKey.Code(KeyCode.KeyC)
        47L -> PhysicalKey.Code(KeyCode.KeyV)
        48L -> PhysicalKey.Code(KeyCode.KeyB)
        49L -> PhysicalKey.Code(KeyCode.KeyN)
        50L -> PhysicalKey.Code(KeyCode.KeyM)
        51L -> PhysicalKey.Code(KeyCode.Comma)
        52L -> PhysicalKey.Code(KeyCode.Period)
        53L -> PhysicalKey.Code(KeyCode.Slash)
        54L -> PhysicalKey.Code(KeyCode.ShiftRight)
        55L -> PhysicalKey.Code(KeyCode.NumpadMultiply)
        56L -> PhysicalKey.Code(KeyCode.AltLeft)
        57L -> PhysicalKey.Code(KeyCode.Space)
        58L -> PhysicalKey.Code(KeyCode.CapsLock)
        59L -> PhysicalKey.Code(KeyCode.F1)
        60L -> PhysicalKey.Code(KeyCode.F2)
        61L -> PhysicalKey.Code(KeyCode.F3)
        62L -> PhysicalKey.Code(KeyCode.F4)
        63L -> PhysicalKey.Code(KeyCode.F5)
        64L -> PhysicalKey.Code(KeyCode.F6)
        65L -> PhysicalKey.Code(KeyCode.F7)
        66L -> PhysicalKey.Code(KeyCode.F8)
        67L -> PhysicalKey.Code(KeyCode.F9)
        68L -> PhysicalKey.Code(KeyCode.F10)
        69L -> PhysicalKey.Code(KeyCode.NumLock)
        70L -> PhysicalKey.Code(KeyCode.ScrollLock)
        71L -> PhysicalKey.Code(KeyCode.Numpad7)
        72L -> PhysicalKey.Code(KeyCode.Numpad8)
        73L -> PhysicalKey.Code(KeyCode.Numpad9)
        74L -> PhysicalKey.Code(KeyCode.NumpadSubtract)
        75L -> PhysicalKey.Code(KeyCode.Numpad4)
        76L -> PhysicalKey.Code(KeyCode.Numpad5)
        77L -> PhysicalKey.Code(KeyCode.Numpad6)
        78L -> PhysicalKey.Code(KeyCode.NumpadAdd)
        79L -> PhysicalKey.Code(KeyCode.Numpad1)
        80L -> PhysicalKey.Code(KeyCode.Numpad2)
        81L -> PhysicalKey.Code(KeyCode.Numpad3)
        82L -> PhysicalKey.Code(KeyCode.Numpad0)
        83L -> PhysicalKey.Code(KeyCode.NumpadDecimal)
        86L -> PhysicalKey.Code(KeyCode.IntlBackslash)
        87L -> PhysicalKey.Code(KeyCode.F11)
        88L -> PhysicalKey.Code(KeyCode.F12)
        100L -> PhysicalKey.Code(KeyCode.F13)
        101L -> PhysicalKey.Code(KeyCode.F14)
        102L -> PhysicalKey.Code(KeyCode.F15)
        103L -> PhysicalKey.Code(KeyCode.F16)
        104L -> PhysicalKey.Code(KeyCode.F17)
        105L -> PhysicalKey.Code(KeyCode.F18)
        106L -> PhysicalKey.Code(KeyCode.F19)
        107L -> PhysicalKey.Code(KeyCode.F20)
        112L -> PhysicalKey.Code(KeyCode.Lang1)
        115L -> PhysicalKey.Code(KeyCode.IntlRo)
        121L -> PhysicalKey.Code(KeyCode.Lang2)
        125L -> PhysicalKey.Code(KeyCode.IntlYen)
        284L -> PhysicalKey.Code(KeyCode.NumpadEnter)
        285L -> PhysicalKey.Code(KeyCode.ControlRight)
        288L -> PhysicalKey.Code(KeyCode.AudioVolumeMute)
        302L -> PhysicalKey.Code(KeyCode.AudioVolumeDown)
        304L -> PhysicalKey.Code(KeyCode.AudioVolumeUp)
        309L -> PhysicalKey.Code(KeyCode.NumpadDivide)
        311L -> PhysicalKey.Code(KeyCode.PrintScreen)
        312L -> PhysicalKey.Code(KeyCode.AltRight)
        325L -> PhysicalKey.Code(KeyCode.Pause)
        327L -> PhysicalKey.Code(KeyCode.Home)
        328L -> PhysicalKey.Code(KeyCode.ArrowUp)
        329L -> PhysicalKey.Code(KeyCode.PageUp)
        331L -> PhysicalKey.Code(KeyCode.ArrowLeft)
        333L -> PhysicalKey.Code(KeyCode.ArrowRight)
        335L -> PhysicalKey.Code(KeyCode.End)
        336L -> PhysicalKey.Code(KeyCode.ArrowDown)
        337L -> PhysicalKey.Code(KeyCode.PageDown)
        338L -> PhysicalKey.Code(KeyCode.Insert)
        339L -> PhysicalKey.Code(KeyCode.Delete)
        347L -> PhysicalKey.Code(KeyCode.SuperLeft)
        348L -> PhysicalKey.Code(KeyCode.SuperRight)
        349L -> PhysicalKey.Code(KeyCode.ContextMenu)
        else -> PhysicalKey.Unidentified(NativeKeyCode.WindowsScanCode(code.toUInt()))
    }

internal fun platformNamedKey(scan: Long, virtual: Long): NamedKey? =
    when (virtual) {
        8L -> Some(NamedKey.Backspace)
        9L -> Some(NamedKey.Tab)
        12L -> Some(NamedKey.Clear)
        13L -> Some(NamedKey.Enter)
        16L -> Some(NamedKey.Shift)
        17L -> Some(NamedKey.Control)
        18L -> Some(NamedKey.Alt)
        19L -> Some(NamedKey.Pause)
        20L -> Some(NamedKey.CapsLock)
        21L -> Some(NamedKey.Kana)
        27L -> Some(NamedKey.Escape)
        32L -> Some(NamedKey.Space)
        33L -> Some(NamedKey.PageUp)
        34L -> Some(NamedKey.PageDown)
        35L -> Some(NamedKey.End)
        36L -> Some(NamedKey.Home)
        37L -> Some(NamedKey.ArrowLeft)
        38L -> Some(NamedKey.ArrowUp)
        39L -> Some(NamedKey.ArrowRight)
        40L -> Some(NamedKey.ArrowDown)
        44L -> Some(NamedKey.PrintScreen)
        45L -> Some(NamedKey.Insert)
        46L -> Some(NamedKey.Delete)
        47L -> Some(NamedKey.Help)
        91L -> Some(NamedKey.Super)
        92L -> Some(NamedKey.Super)
        93L -> Some(NamedKey.ContextMenu)
        112L -> Some(NamedKey.F1)
        113L -> Some(NamedKey.F2)
        114L -> Some(NamedKey.F3)
        115L -> Some(NamedKey.F4)
        116L -> Some(NamedKey.F5)
        117L -> Some(NamedKey.F6)
        118L -> Some(NamedKey.F7)
        119L -> Some(NamedKey.F8)
        120L -> Some(NamedKey.F9)
        121L -> Some(NamedKey.F10)
        122L -> Some(NamedKey.F11)
        123L -> Some(NamedKey.F12)
        124L -> Some(NamedKey.F13)
        125L -> Some(NamedKey.F14)
        126L -> Some(NamedKey.F15)
        127L -> Some(NamedKey.F16)
        128L -> Some(NamedKey.F17)
        129L -> Some(NamedKey.F18)
        130L -> Some(NamedKey.F19)
        131L -> Some(NamedKey.F20)
        144L -> Some(NamedKey.NumLock)
        145L -> Some(NamedKey.ScrollLock)
        160L -> Some(NamedKey.Shift)
        161L -> Some(NamedKey.Shift)
        162L -> Some(NamedKey.Control)
        163L -> Some(NamedKey.Control)
        164L -> Some(NamedKey.Alt)
        165L -> Some(NamedKey.Alt)
        173L -> Some(NamedKey.AudioVolumeMute)
        174L -> Some(NamedKey.AudioVolumeDown)
        175L -> Some(NamedKey.AudioVolumeUp)
        else -> None
    }

internal fun platformUnknownLogicalKey(scan: Long, virtual: Long): NativeKeyCode =
    NativeKeyCode.WindowsVirtualKey(virtual.toUInt())

internal fun platformKeyLocation(code: Long): KeyLocation =
    when (code) {
        42L, 29L, 56L, 347L -> KeyLocation.Left
        54L, 285L, 312L, 348L -> KeyLocation.Right
        55L, 69L, 71L, 72L, 73L, 74L, 75L, 76L, 77L, 78L, 79L, 80L, 81L, 82L, 83L, 284L, 309L -> KeyLocation.Numpad
        else -> KeyLocation.Standard
    }

internal fun platformModifiers(flags: Long): Modifiers =
    Modifiers(
        flags.and(1L) != 0L,
        flags.and(2L) != 0L,
        flags.and(4L) != 0L,
        flags.and(8L) != 0L,
        flags.and(16L) != 0L,
        false,
        sides(flags, 256L, 512L),
        sides(flags, 1024L, 2048L),
        sides(flags, 4096L, 8192L),
        sides(flags, 16384L, 32768L),
        Some(flags.and(32L) != 0L),
        Some(flags.and(64L) != 0L)
    )

private fun sides(flags: Long, left: Long, right: Long): ModifierSides =
    ModifierSides(Some(flags.and(left) != 0L), Some(flags.and(right) != 0L))
