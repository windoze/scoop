package scoop.window.native

import scoop.window.*

@Unsafe
internal fun installReadableWatch(
    owner: ApplicationOwner,
    descriptor: Int,
    ready: () -> Unit
): ApplicationWatch {
    throw IllegalArgumentException(Some("Win32 requires a Windows event HANDLE"))
}

@Unsafe
internal fun installWindowsWatch(
    owner: ApplicationOwner,
    event: Ptr<Unit>,
    ready: () -> Unit
): ApplicationWatch =
    owner.registerWatch(
        fun(identity: Long): NativeWatchResult {
            @Unsafe
            {
                return nativeWatchCreate(owner.native!!, identity, event)
            }
        },
        ready
    )

@Extern(name = "scoop_window_watch_create")
private fun nativeWatchCreate(
    application: Ptr<Unit>,
    identity: Long,
    event: Ptr<Unit>
): NativeWatchResult
