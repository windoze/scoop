package scoop.window

// XKB keycodes use the Linux evdev positions plus the protocol's eight-code offset.
internal fun platformPhysicalKey(code: Long): PhysicalKey =
    when (code) {
        9L -> PhysicalKey.Code(KeyCode.Escape)
        10L -> PhysicalKey.Code(KeyCode.Digit1)
        11L -> PhysicalKey.Code(KeyCode.Digit2)
        12L -> PhysicalKey.Code(KeyCode.Digit3)
        13L -> PhysicalKey.Code(KeyCode.Digit4)
        14L -> PhysicalKey.Code(KeyCode.Digit5)
        15L -> PhysicalKey.Code(KeyCode.Digit6)
        16L -> PhysicalKey.Code(KeyCode.Digit7)
        17L -> PhysicalKey.Code(KeyCode.Digit8)
        18L -> PhysicalKey.Code(KeyCode.Digit9)
        19L -> PhysicalKey.Code(KeyCode.Digit0)
        20L -> PhysicalKey.Code(KeyCode.Minus)
        21L -> PhysicalKey.Code(KeyCode.Equal)
        22L -> PhysicalKey.Code(KeyCode.Backspace)
        23L -> PhysicalKey.Code(KeyCode.Tab)
        24L -> PhysicalKey.Code(KeyCode.KeyQ)
        25L -> PhysicalKey.Code(KeyCode.KeyW)
        26L -> PhysicalKey.Code(KeyCode.KeyE)
        27L -> PhysicalKey.Code(KeyCode.KeyR)
        28L -> PhysicalKey.Code(KeyCode.KeyT)
        29L -> PhysicalKey.Code(KeyCode.KeyY)
        30L -> PhysicalKey.Code(KeyCode.KeyU)
        31L -> PhysicalKey.Code(KeyCode.KeyI)
        32L -> PhysicalKey.Code(KeyCode.KeyO)
        33L -> PhysicalKey.Code(KeyCode.KeyP)
        34L -> PhysicalKey.Code(KeyCode.BracketLeft)
        35L -> PhysicalKey.Code(KeyCode.BracketRight)
        36L -> PhysicalKey.Code(KeyCode.Enter)
        37L -> PhysicalKey.Code(KeyCode.ControlLeft)
        38L -> PhysicalKey.Code(KeyCode.KeyA)
        39L -> PhysicalKey.Code(KeyCode.KeyS)
        40L -> PhysicalKey.Code(KeyCode.KeyD)
        41L -> PhysicalKey.Code(KeyCode.KeyF)
        42L -> PhysicalKey.Code(KeyCode.KeyG)
        43L -> PhysicalKey.Code(KeyCode.KeyH)
        44L -> PhysicalKey.Code(KeyCode.KeyJ)
        45L -> PhysicalKey.Code(KeyCode.KeyK)
        46L -> PhysicalKey.Code(KeyCode.KeyL)
        47L -> PhysicalKey.Code(KeyCode.Semicolon)
        48L -> PhysicalKey.Code(KeyCode.Quote)
        49L -> PhysicalKey.Code(KeyCode.Backquote)
        50L -> PhysicalKey.Code(KeyCode.ShiftLeft)
        51L -> PhysicalKey.Code(KeyCode.Backslash)
        52L -> PhysicalKey.Code(KeyCode.KeyZ)
        53L -> PhysicalKey.Code(KeyCode.KeyX)
        54L -> PhysicalKey.Code(KeyCode.KeyC)
        55L -> PhysicalKey.Code(KeyCode.KeyV)
        56L -> PhysicalKey.Code(KeyCode.KeyB)
        57L -> PhysicalKey.Code(KeyCode.KeyN)
        58L -> PhysicalKey.Code(KeyCode.KeyM)
        59L -> PhysicalKey.Code(KeyCode.Comma)
        60L -> PhysicalKey.Code(KeyCode.Period)
        61L -> PhysicalKey.Code(KeyCode.Slash)
        62L -> PhysicalKey.Code(KeyCode.ShiftRight)
        63L -> PhysicalKey.Code(KeyCode.NumpadMultiply)
        64L -> PhysicalKey.Code(KeyCode.AltLeft)
        65L -> PhysicalKey.Code(KeyCode.Space)
        66L -> PhysicalKey.Code(KeyCode.CapsLock)
        67L -> PhysicalKey.Code(KeyCode.F1)
        68L -> PhysicalKey.Code(KeyCode.F2)
        69L -> PhysicalKey.Code(KeyCode.F3)
        70L -> PhysicalKey.Code(KeyCode.F4)
        71L -> PhysicalKey.Code(KeyCode.F5)
        72L -> PhysicalKey.Code(KeyCode.F6)
        73L -> PhysicalKey.Code(KeyCode.F7)
        74L -> PhysicalKey.Code(KeyCode.F8)
        75L -> PhysicalKey.Code(KeyCode.F9)
        76L -> PhysicalKey.Code(KeyCode.F10)
        79L -> PhysicalKey.Code(KeyCode.Numpad7)
        80L -> PhysicalKey.Code(KeyCode.Numpad8)
        81L -> PhysicalKey.Code(KeyCode.Numpad9)
        82L -> PhysicalKey.Code(KeyCode.NumpadSubtract)
        83L -> PhysicalKey.Code(KeyCode.Numpad4)
        84L -> PhysicalKey.Code(KeyCode.Numpad5)
        85L -> PhysicalKey.Code(KeyCode.Numpad6)
        86L -> PhysicalKey.Code(KeyCode.NumpadAdd)
        87L -> PhysicalKey.Code(KeyCode.Numpad1)
        88L -> PhysicalKey.Code(KeyCode.Numpad2)
        89L -> PhysicalKey.Code(KeyCode.Numpad3)
        90L -> PhysicalKey.Code(KeyCode.Numpad0)
        91L -> PhysicalKey.Code(KeyCode.NumpadDecimal)
        94L -> PhysicalKey.Code(KeyCode.IntlBackslash)
        95L -> PhysicalKey.Code(KeyCode.F11)
        96L -> PhysicalKey.Code(KeyCode.F12)
        97L -> PhysicalKey.Code(KeyCode.IntlRo)
        104L -> PhysicalKey.Code(KeyCode.NumpadEnter)
        105L -> PhysicalKey.Code(KeyCode.ControlRight)
        106L -> PhysicalKey.Code(KeyCode.NumpadDivide)
        108L -> PhysicalKey.Code(KeyCode.AltRight)
        110L -> PhysicalKey.Code(KeyCode.Home)
        111L -> PhysicalKey.Code(KeyCode.ArrowUp)
        112L -> PhysicalKey.Code(KeyCode.PageUp)
        113L -> PhysicalKey.Code(KeyCode.ArrowLeft)
        114L -> PhysicalKey.Code(KeyCode.ArrowRight)
        115L -> PhysicalKey.Code(KeyCode.End)
        116L -> PhysicalKey.Code(KeyCode.ArrowDown)
        117L -> PhysicalKey.Code(KeyCode.PageDown)
        119L -> PhysicalKey.Code(KeyCode.Delete)
        121L -> PhysicalKey.Code(KeyCode.AudioVolumeMute)
        122L -> PhysicalKey.Code(KeyCode.AudioVolumeDown)
        123L -> PhysicalKey.Code(KeyCode.AudioVolumeUp)
        125L -> PhysicalKey.Code(KeyCode.NumpadEqual)
        129L -> PhysicalKey.Code(KeyCode.NumpadComma)
        130L -> PhysicalKey.Code(KeyCode.Lang1)
        131L -> PhysicalKey.Code(KeyCode.Lang2)
        132L -> PhysicalKey.Code(KeyCode.IntlYen)
        133L -> PhysicalKey.Code(KeyCode.SuperLeft)
        134L -> PhysicalKey.Code(KeyCode.SuperRight)
        135L -> PhysicalKey.Code(KeyCode.ContextMenu)
        146L -> PhysicalKey.Code(KeyCode.Help)
        191L -> PhysicalKey.Code(KeyCode.F13)
        192L -> PhysicalKey.Code(KeyCode.F14)
        193L -> PhysicalKey.Code(KeyCode.F15)
        194L -> PhysicalKey.Code(KeyCode.F16)
        195L -> PhysicalKey.Code(KeyCode.F17)
        196L -> PhysicalKey.Code(KeyCode.F18)
        197L -> PhysicalKey.Code(KeyCode.F19)
        198L -> PhysicalKey.Code(KeyCode.F20)
        472L -> PhysicalKey.Code(KeyCode.Fn)
        else -> PhysicalKey.Unidentified(platformNativeKeyCode(code))
    }

internal fun platformNamedKey(event: NativeEvent): NamedKey? =
    when (event.c) {
        65293L -> Some(NamedKey.Enter)
        65421L -> Some(NamedKey.Enter)
        65289L -> Some(NamedKey.Tab)
        65056L -> Some(NamedKey.Tab)
        32L -> Some(NamedKey.Space)
        65288L -> Some(NamedKey.Backspace)
        65307L -> Some(NamedKey.Escape)
        65505L -> Some(NamedKey.Shift)
        65506L -> Some(NamedKey.Shift)
        65507L -> Some(NamedKey.Control)
        65508L -> Some(NamedKey.Control)
        65513L -> Some(NamedKey.Alt)
        65514L -> Some(NamedKey.Alt)
        65515L -> Some(NamedKey.Super)
        65516L -> Some(NamedKey.Super)
        65509L -> Some(NamedKey.CapsLock)
        65361L -> Some(NamedKey.ArrowLeft)
        65363L -> Some(NamedKey.ArrowRight)
        65362L -> Some(NamedKey.ArrowUp)
        65364L -> Some(NamedKey.ArrowDown)
        65535L -> Some(NamedKey.Delete)
        65360L -> Some(NamedKey.Home)
        65367L -> Some(NamedKey.End)
        65365L -> Some(NamedKey.PageUp)
        65366L -> Some(NamedKey.PageDown)
        65386L -> Some(NamedKey.Help)
        65383L -> Some(NamedKey.ContextMenu)
        65291L -> Some(NamedKey.Clear)
        269025043L -> Some(NamedKey.AudioVolumeUp)
        269025041L -> Some(NamedKey.AudioVolumeDown)
        269025042L -> Some(NamedKey.AudioVolumeMute)
        65328L -> Some(NamedKey.Eisu)
        65325L -> Some(NamedKey.Kana)
        65470L -> Some(NamedKey.F1)
        65471L -> Some(NamedKey.F2)
        65472L -> Some(NamedKey.F3)
        65473L -> Some(NamedKey.F4)
        65474L -> Some(NamedKey.F5)
        65475L -> Some(NamedKey.F6)
        65476L -> Some(NamedKey.F7)
        65477L -> Some(NamedKey.F8)
        65478L -> Some(NamedKey.F9)
        65479L -> Some(NamedKey.F10)
        65480L -> Some(NamedKey.F11)
        65481L -> Some(NamedKey.F12)
        65482L -> Some(NamedKey.F13)
        65483L -> Some(NamedKey.F14)
        65484L -> Some(NamedKey.F15)
        65485L -> Some(NamedKey.F16)
        65486L -> Some(NamedKey.F17)
        65487L -> Some(NamedKey.F18)
        65488L -> Some(NamedKey.F19)
        65489L -> Some(NamedKey.F20)
        else -> None
    }

internal fun platformNativeKeyCode(code: Long): NativeKeyCode = NativeKeyCode.Xkb(code.toUInt())

internal fun platformKeyLocation(code: Long): KeyLocation =
    when (code) {
        50L, 37L, 64L, 133L -> KeyLocation.Left
        62L, 105L, 108L, 134L -> KeyLocation.Right
        86L, 82L, 63L, 106L, 91L, 125L, 104L, 129L, 90L, 87L, 88L, 89L, 83L, 84L, 85L, 79L, 80L, 81L -> KeyLocation.Numpad
        else -> KeyLocation.Standard
    }

internal fun platformModifiers(flags: Long): Modifiers =
    Modifiers(
        flags.and(1L) != 0L,
        flags.and(2L) != 0L,
        flags.and(4L) != 0L,
        flags.and(8L) != 0L,
        flags.and(16L) != 0L,
        false,
        linuxSides(flags, 1L, 65536L, 131072L),
        linuxSides(flags, 2L, 262144L, 524288L),
        linuxSides(flags, 4L, 1048576L, 2097152L),
        linuxSides(flags, 8L, 4194304L, 8388608L),
        Some(flags.and(32L) != 0L),
        Some(flags.and(64L) != 0L)
    )

private fun linuxSides(flags: Long, aggregate: Long, left: Long, right: Long): ModifierSides {
    if (flags.and(aggregate) == 0L)
        return ModifierSides(Some(false), Some(false))
    if (flags.and(left.or(right)) == 0L)
        return ModifierSides(None, None)
    return ModifierSides(Some(flags.and(left) != 0L), Some(flags.and(right) != 0L))
}
