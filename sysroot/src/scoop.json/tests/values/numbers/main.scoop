package scoop.json.tests.values.numbers

import scoop.test.*
import scoop.json.*

object Capture : ValueDecoder<Array<JsonValue>> {
    public override fun decode(decoder: Decoder): Array<JsonValue> {
        val sequence = decoder.keyed().required("a/~").unkeyed()
        val large = sequence.element()
        rejectDecode("/a~1~0/0") { ULong.decode(large) }
        val first = JsonValue.Companion.decode(large)
        val exponent = sequence.element()
        rejectDecode("/a~1~0/1") { Double.decode(exponent) }
        val second = JsonValue.Companion.decode(exponent)
        sequence.end()
        gcCollect()
        check(Json.encodeToString(JsonValue.Companion.decode(large), JsonValue.Companion) == "18446744073709551616")
        return [first, second]
    }
}

private fun exercise() {
    for (text in ["18446744073709551616", "0.12345678901234567890123456789", "1e400", "-0", "-12.3400E+007"]) {
        val saved = Json.decodeFromString(text, JsonValue.Companion)
        gcCollect()
        check(Json.encodeToString(saved, JsonValue.Companion) == text)
        check(Json.encodeToString(Json.encodeToValue(saved, JsonValue.Companion), JsonValue.Companion) == text)
    }
    val values = Json.decodeFromString("{\"a/~\":[18446744073709551616,1e400]}", Capture)
    rejectDecode("") { Json.decodeFromValue(values[0L], Long.Companion) }
    rejectDecode("") { Json.decodeFromValue(values[1L], Double.Companion) }
    check(Json.encodeToString(values, Array<JsonValue>.encoder(JsonValue.Companion)) == "[18446744073709551616,1e400]")
    val decimal = Json.decodeFromString("0.12345678901234567890123456789", JsonValue.Companion)
    check(Json.decodeFromValue(decimal, Double.Companion) == 0.12345678901234568)
    check(Json.decodeFromValue(Json.decodeFromString("-0", JsonValue.Companion), Double.Companion).toBits() == (-0.0).toBits())

}

@Test
private class ApiTests {
    @Test
    fun behavior() { exercise() }

    @Test
    fun floatingRoundTrips() {
        var bits = 17uL
        var index = 0
        while (index < 2048) {
            bits = bits * 6364136223846793005uL + 1442695040888963407uL
            val double = Double.fromBits(bits.toLong())
            if (double.isFinite()) {
                val text = Json.encodeToString(double, Double.Companion)
                assertEquals(double.toBits(), Json.decodeFromString(text, Double.Companion).toBits())
            }
            val float = Float.fromBits(bits.shr(32L).toInt())
            if (float.isFinite()) {
                val text = Json.encodeToString(float, Float.Companion)
                assertEquals(float.toBits(), Json.decodeFromString(text, Float.Companion).toBits())
            }
            index += 1
        }
    }

    @Test
    fun parserBufferBoundaries() {
        for (length in [254L, 255L, 256L, 257L, 1024L]) {
            val text = "1." + String.fromChars(Array<Char>(length - 2L) { _ -> '0' })
            assertEquals(1.0, Json.decodeFromString(text, Double.Companion))
            assertEquals(1.0f, Json.decodeFromString(text, Float.Companion))
        }
    }
}
