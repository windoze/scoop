package scoop.json.tests.decoding.scalars

import scoop.test.*
import scoop.json.Json

object TextReader : ValueDecoder<String> {
    public override fun decode(decoder: Decoder): String {
        val first = decoder.singleValue()
        check(!first.isNull())
        reject("") { first.readLong() }
        reject("") { decoder.keyed() }
        reject("") { decoder.unkeyed() }
        reject("") { first.readNull() }
        gcCollect()
        val result = first.readString()
        check(result == decoder.singleValue().readString())
        check(!first.isNull())
        return result
    }
}

object NullReader : ValueDecoder<Boolean> {
    public override fun decode(decoder: Decoder): Boolean {
        val scalar = decoder.singleValue()
        check(scalar.isNull())
        reject("") { scalar.readString() }
        scalar.readNull()
        scalar.readNull()
        return decoder.singleValue().isNull()
    }
}

object WideReader : ValueDecoder<ULong> {
    public override fun decode(decoder: Decoder): ULong {
        reject("") { Long.decode(decoder) }
        val result = ULong.decode(decoder)
        check(result == ULong.decode(decoder))
        return result
    }
}

object FloatingReader : ValueDecoder<Double> {
    public override fun decode(decoder: Decoder): Double {
        reject("") { Long.decode(decoder) }
        reject("") { Float.decode(decoder) }
        return Double.decode(decoder)
    }
}

private fun exercise() {
    check(Json.decodeFromString("\"stable 雪\"", TextReader) == "stable 雪")
    check(Json.decodeFromString("null", NullReader))
    check(Json.decodeFromString("18446744073709551615", WideReader) == 18446744073709551615UL)
    check(Json.decodeFromString("1e100", FloatingReader) == 1e100)
    val boolean = ValueDecoderFunction<Boolean>({ decoder ->
        val scalar = decoder.singleValue()
        check(!scalar.isNull())
        reject("") { scalar.readLong() }
        check(scalar.readBoolean() == scalar.readBoolean())
        scalar.readBoolean()
    })
    check(Json.decodeFromString("true", boolean))

}

@Test
private class ApiTests {
    @Test
    fun behavior() { exercise() }
}
