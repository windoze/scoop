package scoop.json.tests.decoding.records

import scoop.test.*
import scoop.json.Json

object RecordReader : ValueDecoder<Long> {
    public override fun decode(decoder: Decoder): Long {
        check(!decoder.singleValue().isNull())
        reject("") { decoder.singleValue().readString() }
        val first = decoder.keyed()
        val second = decoder.keyed()
        check(first.keys.size == 3L)
        (first.keys as ArrayList<String>).add("not-an-input-key")
        check(first.keys.size == 3L && second.keys.size == 3L)
        reject("/missing~1~0") { first.required("missing/~") }
        check(when (first.optional("missing/~")) { case None -> true; else -> false })
        check(when (first.optional("missing/~")) { case None -> true; else -> false })
        val nullValue = first.required("null")
        val text = first.required("text")
        val number = second.required("id")
        check(when (second.optional("null")) {
            case Some(child) -> child.singleValue().isNull()
            case None -> false
        })
        first.end()
        first.end()
        reject("/text") { Long.decode(text) }
        gcCollect()
        check(String.decode(text) == "retained")
        check(String.decode(first.required("text")) == "retained")
        check(nullValue.singleValue().isNull())
        check(Long.decode(number) == Long.decode(second.required("id")))
        second.end()
        return Long.decode(first.required("id"))
    }
}

private fun exercise() {
    check(Json.decodeFromString("{\"id\":7,\"null\":null,\"text\":\"retained\"}", RecordReader) == 7L)
    val ignore = ValueDecoderFunction<Long>({ decoder -> 42L })
    check(Json.decodeFromString("{\"unused\":[1,{\"nested\":true}]}", ignore) == 42L)
    reject("/unused/1") { Json.decodeFromString("{\"unused\":[1,]}", ignore) }
    reject("/unused/x") { Json.decodeFromString("{\"unused\":{\"x\":1,\"x\":2}}", ignore) }
    reject("") { Json.decodeFromString("{} true", ignore) }

}

@Test
private class ApiTests {
    @Test
    fun behavior() { exercise() }
}
