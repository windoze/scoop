package scoop.json.tests.consumer.list_encoding_artifacts.p1

import scoop.test.*

public fun <T> sequence(element: ValueEncoder<T>): ValueEncoder<List<T>> = SequenceEncoder<T>(element)
private class SequenceEncoder<T>(private val element: ValueEncoder<T>) : ValueEncoder<List<T>> {
    public override fun encode(value: List<T>, encoder: Encoder) { encodeList(value, element, encoder) }
}
public fun <T> capture(): (List<T>, ValueEncoder<T>, Encoder) -> Unit = ::encodeList
