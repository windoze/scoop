package scoop.json.tests.consumer.derived_encoding_variants

import scoop.test.*
import scoop.json.Json

fun check(value: Boolean, location: SourceLocation = currentSourceLocation()) {
    assertTrue(value, location = location)
}

public enum Choice<T> {
    @Serialize(rename = "nothing") Empty,
    Pair(T, Int),
    Record { value: T, count: Int },
    Named(@Serialize(rename = "item") val value: T, @Serialize(ignore = true) val ignored: Any, val count: Int = 2)
    public companion object {
        public fun encoder(element: ValueEncoder<T>): ValueEncoder<Choice<T>> = ChoiceEncoder<T>(element)
    }
}
public class ChoiceEncoder<T>(private val element: ValueEncoder<T>) : ValueEncoder<Choice<T>>

public enum Tree {
    Leaf,
    Branch(val node: Node)
    public companion object : ValueEncoder<Tree>
}
public class Node public constructor(public val child: Tree) {
    public companion object : ValueEncoder<Node>
}
public struct Wrapper<T>(val value: T)
public class WrapperEncoder<T>(private val element: ValueEncoder<T>) : ValueEncoder<Wrapper<T>>

private fun exerciseConsumer() {
    val codec = Choice<String>.Companion.encoder(String.Companion)
    val empty: Choice<String> = Choice<String>.Empty
    check(Json.encodeToString(empty, codec) == "{\"nothing\":{}}")
    check(Json.encodeToString(Choice<String>.Pair("one", 1), codec) == "{\"Pair\":[\"one\",1]}")
    val record = Choice<String>.Record(value = "two", count = 2)
    check(Json.encodeToString(record, codec) == "{\"Record\":{\"value\":\"two\",\"count\":2}}")
    val named = Choice<String>.Named("three", 99)
    check(Json.encodeToString(named, codec) == "{\"Named\":{\"item\":\"three\",\"count\":2}}")
    check(Json.encodeToString(Wrapper<Choice<String>>(named), WrapperEncoder<Choice<String>>(codec)) == "{\"value\":{\"Named\":{\"item\":\"three\",\"count\":2}}}")
    val tree = Tree.Branch(Node(Tree.Leaf))
    check(Json.encodeToString(tree, Tree.Companion) == "{\"Branch\":{\"node\":{\"child\":{\"Leaf\":{}}}}}")

}

@Test
private class ConsumerTests {
    @Test
    fun behavior() { exerciseConsumer() }
}
