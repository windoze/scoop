package scoop.json.tests.consumer.unit_encoding_artifacts.p0

import scoop.test.*
import scoop.json.Json
import scoop.json.tests.consumer.unit_encoding_artifacts.p2.Box
import scoop.json.tests.consumer.unit_encoding_artifacts.p2.unitFromProvider
import scoop.json.tests.consumer.unit_encoding_artifacts.p2.erase
import scoop.json.tests.consumer.unit_encoding_artifacts.p2.expose
import scoop.json.tests.consumer.unit_encoding_artifacts.p2.makeBox
import scoop.json.tests.consumer.unit_encoding_artifacts.p2.unitEncoder
import scoop.json.tests.consumer.unit_encoding_artifacts.p1.peerUnit
import scoop.json.tests.consumer.unit_encoding_artifacts.p1.peerEncoding
import scoop.json.tests.consumer.unit_encoding_artifacts.p1.peerBox

private fun check(value: Boolean, code: Int, location: SourceLocation = currentSourceLocation()) {
    assertTrue(value, location = location)
}

private class UsesReference(private val body: (Unit, Encoder) -> Unit) : ValueEncoder<Unit> {
    public override fun encode(value: Unit, encoder: Encoder) { body(value, encoder) }
}

private fun exerciseConsumer() {
    val providerValue = unitFromProvider()
    check(!(providerValue is ValueEncoder<Unit>), 1)
    check(Json.encodeToString(providerValue as Unit, UnitEncoder) == "null", 2)
    check(peerUnit() is Unit && erase(Unit) is Unit, 3)
    check(Json.encodeToString(Unit, peerEncoding()) == "null", 4)
    check(Json.encodeToString(Unit, expose<Unit>(UnitEncoder)) == "null", 5)
    val other = peerBox()
    check(other is Box<Unit> && !(erase(other) is ValueEncoder<Box<Unit>>), 6)
    val boxCodec = Box<Unit>.Companion.encoder(UnitEncoder)
    check(Json.encodeToString(other as Box<Unit>, boxCodec) == "{\"value\":null}", 7)
    check(Json.encodeToString(makeBox(Unit), boxCodec) == "{\"value\":null}", 8)
    check(Json.encodeToString(Unit, UsesReference(unitEncoder())) == "null", 9)
    check(Json.decodeFromString("null", UnitDecoder) == Unit, 10)

}

@Test
private class ConsumerTests {
    @Test
    fun behavior() { exerciseConsumer() }
}
