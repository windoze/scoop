package scoop.json.tests.consumer.container_decoding_option

import scoop.test.*
import scoop.json.Json

private var reads: Int = 0

private object Counted : ValueDecoder<Int> {
    public override fun decode(decoder: Decoder): Int {
        reads += 1
        return Int.Companion.decode(decoder)
    }
}

private fun check(value: Boolean, code: Int, location: SourceLocation = currentSourceLocation()) {
    assertTrue(value, location = location)
}

private fun <T> reject(text: String, codec: ValueDecoder<T>, path: String) {
    try { Json.decodeFromString(text, codec) }
    catch (error: DecodingException) {
        check(error.path == path, 90)
        return
    }
    throw IllegalStateException(Some("expected an Option decoding failure"))
}

private fun exerciseConsumer() {
    val codec = Option<Int>.Companion.decoder(Counted)
    check(Json.decodeFromString("null", codec) == None && reads == 0, 1)
    check(Json.decodeFromString("42", codec)!! == 42 && reads == 1, 2)
    val nested = Option<Option<Int>>.decoder(codec)
    check(Json.decodeFromString("null", nested) == None, 4)
    check(Json.decodeFromString("7", nested)!!!! == 7, 5)
    check(reads == 2, 6)
    reject("{}", codec, "")
    reject("[]", codec, "")
    reject("[1,2]", codec, "")
    reject("2147483648", codec, "")
    reject("false", nested, "")

}

@Test
private class ConsumerTests {
    @Test
    fun behavior() { exerciseConsumer() }
}
