package scoop.json.tests.consumer.baseline_chat

import scoop.test.*
struct ChatChunk(
    val id: String,
    @Serialize(rename = "object") val kind: String,
    val created: Long,
    val model: String,
    val choices: Array<ChunkChoice>,
    val usage: ChatUsage? = None
) {
    companion object : ValueEncoder<ChatChunk>, ValueDecoder<ChatChunk> {}
}
struct ChunkChoice(
    val index: Long,
    val delta: ChatDelta,
    @Serialize(required = true) val finish_reason: String?,
    val logprobs: ChatLogprobs? = None
) {
    companion object : ValueEncoder<ChunkChoice>, ValueDecoder<ChunkChoice> {}
}
struct ChatDelta(
    val role: String? = None,
    val content: String? = None,
    val refusal: String? = None,
    val tool_calls: Array<CallDelta>? = None
) {
    companion object : ValueEncoder<ChatDelta>, ValueDecoder<ChatDelta> {}
}
struct CallDelta(
    val index: Long,
    val id: String? = None,
    val type: String? = None,
    val function: FunctionDelta? = None
) {
    companion object : ValueEncoder<CallDelta>, ValueDecoder<CallDelta> {}
}
struct FunctionDelta(val name: String? = None, val arguments: String? = None) {
    companion object : ValueEncoder<FunctionDelta>, ValueDecoder<FunctionDelta> {}
}
