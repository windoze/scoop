package scoop.json.tests.consumer.baseline_chat

import scoop.test.*
enum ChatPart {
    Text(TextPart), Image(ChatImage), Audio(ChatAudio), File(ChatFile), Refusal(RefusalPart)
    companion object : ValueEncoder<ChatPart>, ValueDecoder<ChatPart> {
        public override fun encode(value: ChatPart, encoder: Encoder) {
            val fields = encoder.keyed()
            when (value) {
                case ChatPart.Text(payload) -> {
                    String.encode("text", fields.field("type"))
                    TextPart.Companion.encode(payload, encoder)
                }
                case ChatPart.Image(payload) -> {
                    String.encode("image_url", fields.field("type"))
                    ChatImage.Companion.encode(payload, encoder)
                }
                case ChatPart.Audio(payload) -> {
                    String.encode("input_audio", fields.field("type"))
                    ChatAudio.Companion.encode(payload, encoder)
                }
                case ChatPart.File(payload) -> {
                    String.encode("file", fields.field("type"))
                    ChatFile.Companion.encode(payload, encoder)
                }
                case ChatPart.Refusal(payload) -> {
                    String.encode("refusal", fields.field("type"))
                    RefusalPart.Companion.encode(payload, encoder)
                }
            }
            fields.end()
        }
        public override fun decode(decoder: Decoder): ChatPart {
            val fields = decoder.keyed()
            return when (String.decode(fields.required("type"))) {
                case "text" -> ChatPart.Text(TextPart.Companion.decode(decoder))
                case "image_url" -> ChatPart.Image(ChatImage.Companion.decode(decoder))
                case "input_audio" -> ChatPart.Audio(ChatAudio.Companion.decode(decoder))
                case "file" -> ChatPart.File(ChatFile.Companion.decode(decoder))
                case "refusal" -> ChatPart.Refusal(RefusalPart.Companion.decode(decoder))
                else -> throw DecodingException(fields.required("type").path, "unknown ChatPart branch")
            }
        }
    }
}

enum ChatContent {
    Text(String), Blocks(Array<ChatPart>)
    companion object : ValueEncoder<ChatContent>, ValueDecoder<ChatContent> {
        public override fun encode(value: ChatContent, encoder: Encoder) {
            when (value) {
                case ChatContent.Text(text) -> String.encode(text, encoder)
                case ChatContent.Blocks(payload) -> Array<ChatPart>.encoder(ChatPart.Companion).encode(payload, encoder)
            }
        }
        public override fun decode(decoder: Decoder): ChatContent {
            var text: String? = None
            try { text = Some(String.decode(decoder)) }
            catch (error: DecodingException) { text = None }
            if (text != None) { return ChatContent.Text(text!!) }
            return ChatContent.Blocks(Array<ChatPart>.decoder(ChatPart.Companion).decode(decoder))
        }
    }
}
