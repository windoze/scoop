package scoop.json.tests.consumer.baseline_cone

import scoop.test.*
import scoop.text.*

fun digit(value: Char): Boolean = value >= '0' && value <= '9'
fun letter(value: Char): Boolean = (value >= 'a' && value <= 'z') || (value >= 'A' && value <= 'Z')
fun coordinatePart(value: String): Boolean {
    for (part in value.split('.')) {
        if (part.charLength == 0L || part.getCharAt(0L) < 'a' || part.getCharAt(0L) > 'z') { return false }
        for (character in part) {
            if (!(character >= 'a' && character <= 'z') && !digit(character) && character != '-') { return false }
        }
    }
    return true
}
fun version(value: String): Boolean {
    val build = value.split('+')
    if (build.size > 2L) { return false }
    if (build.size == 2L && !versionIdentifiers(build[1L], false)) { return false }
    val release = build[0L].split('-', 2L)
    if (release.size == 2L && !versionIdentifiers(release[1L], true)) { return false }
    val numbers = release[0L].split('.')
    if (numbers.size != 3L) { return false }
    for (number in numbers) {
        if (number.charLength == 0L || (number.charLength > 1L && number.getCharAt(0L) == '0')) { return false }
        for (character in number) { if (!digit(character)) { return false } }
        if (number.toULongOrNone() == None) { return false }
    }
    return true
}
fun versionIdentifiers(value: String, prerelease: Boolean): Boolean {
    for (part in value.split('.')) {
        if (part.charLength == 0L) { return false }
        var numeric = true
        for (character in part) {
            if (!letter(character) && !digit(character) && character != '-') { return false }
            if (!digit(character)) { numeric = false }
        }
        if (prerelease && numeric && part.charLength > 1L && part.getCharAt(0L) == '0') { return false }
    }
    return true
}
fun relativePath(value: String): Boolean {
    if (value.charLength == 0L || value.startsWith('/')) { return false }
    var depth = 0L
    for (part in value.split('/')) {
        if (part == "" || part == ".") { continue }
        if (part == "..") {
            depth -= 1L
            if (depth < 0L) { return false }
        } else {
            if (depth == 0L && part.charLength >= 2L && letter(part.getCharAt(0L)) && part.getCharAt(1L) == ':') { return false }
            depth += 1L
        }
    }
    for (character in value) {
        if (character == '\\' || character == '\u0000' || character == '*' || character == '?' || character == '[' || character == ']') { return false }
    }
    return true
}
fun libraryName(value: String): Boolean {
    if (value.charLength == 0L || value.byteLength > 255L || value == "." || value == "..") { return false }
    if (value.getCharAt(0L) == ' ' || value.getCharAt(value.charLength - 1L) == ' ') { return false }
    for (character in value) {
        if (character.code < 32 || character.code == 127 || character == '/' || character == '\\') { return false }
    }
    return true
}
