package scoop.json.tests.consumer.api_style_codecs

import scoop.test.*
import scoop.json.Json
import scoop.json.JsonValue

private fun check(value: Boolean, location: SourceLocation = currentSourceLocation()) {
    assertTrue(value, location = location)
}

struct Message(val count: Int, val text: String) {
    companion object : ValueEncoder<Message>, ValueDecoder<Message>, ValueInspector<Message>
}

private fun <T> roundTrip(value: T, encoder: ValueEncoder<T>, decoder: ValueDecoder<T>): T =
    Json.decodeFromString(Json.encodeToString(value, encoder), decoder)

private fun exerciseConsumer() {
    val value = Message(3, "雪")
    val encoder: ValueEncoder<Message> = Message.Companion
    val decoder: ValueDecoder<Message> = Message.Companion
    val inspector: ValueInspector<Message> = Message.Companion
    check(roundTrip(value, encoder, decoder) == value)
    val parsed = Json.encodeToValue(value = value, codec = encoder)
    val text = Json.encodeToString(value = parsed, codec = JsonValue.Companion)
    check(text == "{\"count\":3,\"text\":\"雪\"}")
    check(Json.decodeFromValue<Message>(value = parsed, codec = decoder) == value)
    val reloaded = Json.decodeFromString<JsonValue>(text = text, codec = JsonValue.Companion)
    check(Json.decodeFromValue(reloaded, decoder) == value)
    check(DebugPrinter.format(inspector.inspect(value)) == "Message(count=3, text=\"雪\")")

    val stringEncoder: ValueEncoder<String> = ValueEncoderFunction<String>({ value, output ->
        output.singleValue().writeString("prefix:" + value)
    })
    val stringDecoder: ValueDecoder<String> = ValueDecoderFunction<String>({ input ->
        input.singleValue().readString()
    })
    val stringInspector: ValueInspector<String> = ValueInspectorFunction<String>({ value ->
        String.inspect("observed:" + value)
    })
    check(roundTrip("item", stringEncoder, stringDecoder) == "prefix:item")
    check(DebugPrinter.format(stringInspector.inspect("item")) == "\"observed:item\"")
    val items = Json.decodeFromString("[\"a\",\"b\"]", Array<String>.decoder(stringDecoder))
    check(Json.encodeToString(items, Array<String>.encoder(stringEncoder)) == "[\"prefix:a\",\"prefix:b\"]")

    val failure = IllegalStateException(Some("codec failed"))
    val failing = ValueDecoderFunction<Message>({ _ -> throw failure })
    try {
        Json.decodeFromValue(parsed, failing)
        throw IllegalArgumentException()
    } catch (caught: IllegalStateException) {
        check(caught === failure)
    }

}

@Test
private class ConsumerTests {
    @Test
    fun behavior() { exerciseConsumer() }
}
