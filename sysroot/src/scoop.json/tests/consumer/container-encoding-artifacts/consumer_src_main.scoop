package scoop.json.tests.consumer.container_encoding_artifacts.p0

import scoop.test.*
import scoop.json.Json
import scoop.json.tests.consumer.container_encoding_artifacts.p1.coding
import scoop.json.tests.consumer.container_encoding_artifacts.p1.erase
import scoop.json.tests.consumer.container_encoding_artifacts.p1.eraseList
import scoop.json.tests.consumer.container_encoding_artifacts.p1.capture
import scoop.json.tests.consumer.container_encoding_artifacts.p1.shared
import scoop.json.tests.consumer.container_encoding_artifacts.p1.Envelope
import scoop.json.tests.consumer.container_encoding_artifacts.p2.nested
import scoop.json.tests.consumer.container_encoding_artifacts.p2.independent

private fun check(value: Boolean, code: Int, location: SourceLocation = currentSourceLocation()) {
    assertTrue(value, location = location)
}
private class Captured<T>(private val write: (T, Encoder) -> Unit) : ValueEncoder<T> {
    public override fun encode(value: T, encoder: Encoder) { write(value, encoder) }
}
private struct Opaque()

private fun exerciseConsumer() {
    val integers = Array<Int>(3L) { index -> index.toInt() + 1 }
    check(Json.encodeToString(integers, coding(Int.Companion)) == "[1,2,3]", 1)
    check(Json.encodeToString(Some(Unit), Captured(capture(UnitEncoder))) == "null", 2)
    val erased = erase(MutableArray<String>(2L) { _ -> "界" })
    check(!(erased is ValueEncoder<MutableArray<String>>), 3)
    check(Json.encodeToString(erased as MutableArray<String>, MutableArray<String>.encoder(String.Companion))
        == "[\"界\",\"界\"]", 4)
    val list = ArrayList<Int>()
    list.add(7)
    val erasedList = eraseList(list)
    check(!(erasedList is ValueEncoder<ArrayList<Int>>), 5)
    check(Json.encodeToString(erasedList as ArrayList<Int>, ArrayList<Int>.encoder(Int.Companion)) == "[7]", 6)
    check(!(erase(MutableArray<Opaque>(0L) { _ -> Opaque() }) is ValueEncoder<MutableArray<Opaque>>), 7)
    check(!(eraseList(ArrayList<Opaque>()) is ValueEncoder<ArrayList<Opaque>>), 8)
    val expected = "[null,1]"
    val codec = Array<Option<Int>>.encoder(Option<Int>.encoder(Int.Companion))
    check(Json.encodeToString(shared(), codec) == expected, 9)
    check(Json.encodeToString(nested(), codec) == expected, 10)
    val fromPeer = independent()
    check(!(fromPeer is ValueEncoder<Array<Option<Int>>>), 11)
    check(Json.encodeToString(fromPeer as Array<Option<Int>>, codec) == expected, 12)
    val local = Array<Option<Int>>(2L) { index -> if (index == 0L) { None } else { Some(1) } }
    check(Json.encodeToString(local, codec) == expected, 13)
    check(Json.encodeToString(Envelope(integers, Some(4)), Envelope<Int>.encoder(Int.Companion))
        == "{\"items\":[1,2,3],\"last\":4}", 14)
    val restored = Json.decodeFromString(Json.encodeToString(shared(), codec), Array<Option<Int>>.decoder(
        Option<Int>.decoder(Int.Companion)))
    check(Json.encodeToString(restored, codec) == expected, 15)

}

@Test
private class ConsumerTests {
    @Test
    fun behavior() { exerciseConsumer() }
}
