package scoop.json.tests.consumer.container_encoding_artifacts.p1

import scoop.test.*

public fun <T> coding(element: ValueEncoder<T>): ValueEncoder<Array<T>> = Array<T>.encoder(element)
public fun <T> erase(values: MutableArray<T>): Any = values
public fun <T> eraseList(values: ArrayList<T>): Any = values
public fun <T> capture(element: ValueEncoder<T>): (Option<T>, Encoder) -> Unit {
    val codec = Option<T>.encoder(element)
    return codec::encode
}
public fun shared(): Array<Option<Int>> = Array<Option<Int>>(2L) { index ->
    if (index == 0L) { None } else { Some(1) }
}
public struct Envelope<T>(val items: Array<T>, val last: Option<T>) {
    public companion object {
        public fun encoder(element: ValueEncoder<T>): ValueEncoder<Envelope<T>> = EnvelopeEncoder<T>(element)
    }
}
private class EnvelopeEncoder<T>(private val element: ValueEncoder<T>) : ValueEncoder<Envelope<T>>
