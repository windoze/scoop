package scoop.json.tests.consumer.container_decoding_artifacts.p1

import scoop.test.*

public fun <T> arrayDecoder(element: ValueDecoder<T>): ValueDecoder<Array<T>> = Array<T>.decoder(element)

public fun integers(): ValueDecoder<Array<Int>> = arrayDecoder(Int.Companion)

public fun <T> nested(element: ValueDecoder<T>): ValueDecoder<Option<MutableArray<ArrayList<T>>>> =
    Option<MutableArray<ArrayList<T>>>.decoder(
        MutableArray<ArrayList<T>>.decoder(ArrayList<T>.decoder(element))
    )
