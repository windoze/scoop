package scoop.json.tests.consumer.container_decoding_sequences

import scoop.test.*
import scoop.json.Json

private fun check(value: Boolean, code: Int, location: SourceLocation = currentSourceLocation()) {
    assertTrue(value, location = location)
}

private fun <T> reject(text: String, codec: ValueDecoder<T>, path: String) {
    try { Json.decodeFromString(text, codec) }
    catch (error: DecodingException) {
        check(error.path == path, 90)
        return
    }
    throw IllegalStateException(Some("expected a sequence decoding failure"))
}

private fun <T> read(text: String, element: ValueDecoder<T>): Array<T> =
    Json.decodeFromString(text, Array<T>.Companion.decoder(element))

private fun exerciseConsumer() {
    val integers = Array<Int>.Companion.decoder(Int.Companion)
    check(Json.decodeFromString("[]", integers).size == 0L, 1)
    val values = Json.decodeFromString("[1,-2,2147483647]", integers)
    check(values.size == 3L && values[1L] == -2 && values[2L] == 2147483647, 2)
    val strings = read("[\"one\",\"中文\",\"\\uD83D\\uDE42\"]", String.Companion)
    check(strings[1L] == "中文" && strings[2L] == "🙂", 3)
    val mutableCodec = MutableArray<Long>.decoder(Long.Companion)
    val mutable = Json.decodeFromString("[3,9223372036854775807]", mutableCodec)
    mutable[0L] = 4L
    check(mutable[0L] == 4L && mutable[1L] == 9223372036854775807L, 4)
    check(Json.decodeFromString("[]", mutableCodec).size == 0L, 5)
    val listCodec = ArrayList<Char>.Companion.decoder(Char.Companion)
    val list = Json.decodeFromString("[\"a\",\"🙂\"]", listCodec)
    list.add('界')
    check(list.size == 3L && list[1L] == '🙂' && list[2L] == '界', 6)
    check(Json.decodeFromString("[]", listCodec).size == 0L, 7)
    val unsigned = read("[18446744073709551615]", ULong.Companion)
    check(unsigned[0L] == 18446744073709551615uL, 8)
    val rows = Json.decodeFromString("[[1,2],[],[3]]", Array<Array<Int>>.decoder(integers))
    check(rows.size == 3L && rows[0L][1L] == 2 && rows[1L].size == 0L, 9)
    reject("{}", integers, "")
    reject("[1,null]", integers, "/1")
    reject("[1,2147483648]", integers, "/1")
    reject("[1.0]", mutableCodec, "/0")
    reject("[\"ab\"]", listCodec, "/0")
    reject("[[1],[false]]", Array<Array<Int>>.decoder(integers), "/1/0")
    val constant = Array<Int>.decoder(ValueDecoderFunction<Int>({ _ -> 1 }))
    check(Json.decodeFromString("[7]", constant)[0L] == 1, 10)

}

@Test
private class ConsumerTests {
    @Test
    fun behavior() { exerciseConsumer() }
}
