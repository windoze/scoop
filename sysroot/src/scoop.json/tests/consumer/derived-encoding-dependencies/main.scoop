package scoop.json.tests.consumer.derived_encoding_dependencies

import scoop.test.*
import scoop.json.Json

fun check(value: Boolean, location: SourceLocation = currentSourceLocation()) {
    assertTrue(value, location = location)
}

class Offset(private val amount: Int) : ValueEncoder<Int> {
    public override fun encode(value: Int, encoder: Encoder) {
        Int.encode(value + amount, encoder)
    }
}
struct Pair<A, B>(val first: A, val second: B)
class PairEncoder<A, B>(private val first: ValueEncoder<A>, private val second: ValueEncoder<B>)
    : ValueEncoder<Pair<A, B>>

struct Packet<T>(val parts: (T, Option<T>, Unit), val values: Array<T>)
struct PacketEncoder<T>(val element: ValueEncoder<T>) : ValueEncoder<Packet<T>>

struct Leaf(val value: Int) {
    public companion object : ValueEncoder<Leaf>
}
object LeafOverride : ValueEncoder<Leaf> {
    public override fun encode(value: Leaf, encoder: Encoder) { Int.encode(-100, encoder) }
}
struct Wrapper(val value: Leaf)
class WrapperEncoder(private val leaf: ValueEncoder<Leaf>) : ValueEncoder<Wrapper>

class Node(public val children: Array<Node>) {
    public companion object : ValueEncoder<Node>
}
object NodeOverride : ValueEncoder<Node> {
    public override fun encode(value: Node, encoder: Encoder) { Int.encode(-200, encoder) }
}
class NodeEncoder(private val child: ValueEncoder<Node>) : ValueEncoder<Node>

private fun exerciseConsumer() {
    val pair = Pair<Int, Int>(1, 2)
    val pairEncoder = PairEncoder<Int, Int>(Offset(10), Offset(20))
    check(Json.encodeToString(pair, pairEncoder) == "{\"first\":11,\"second\":22}")
    val packet = Packet<Int>((5, Some(6), Unit), Array<Int>(1L) { _ -> 7 })
    check(Json.encodeToString(packet, PacketEncoder<Int>(Offset(10))) ==
        "{\"parts\":[15,16,null],\"values\":[17]}")
    check(Json.encodeToString(Wrapper(Leaf(1)), WrapperEncoder(LeafOverride)) == "{\"value\":-100}")
    val node = Node(Array<Node>(1L) { _ -> Node(Array<Node>(0L) { _ -> throw IllegalStateException(None) }) })
    check(Json.encodeToString(node, NodeEncoder(NodeOverride)) == "{\"children\":[-200]}")
    check(Json.encodeToString(node, Node.Companion) == "{\"children\":[{\"children\":[]}]}")
    orderingCases()

}

@Test
private class ConsumerTests {
    @Test
    fun behavior() { exerciseConsumer() }
}
