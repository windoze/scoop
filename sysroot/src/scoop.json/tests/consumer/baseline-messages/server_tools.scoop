package scoop.json.tests.consumer.baseline_messages

import scoop.test.*
import scoop.json.*

enum ServerCall {
    Search(SearchUse), Fetch(FetchUse), Code(CodeUse)
    companion object : ValueEncoder<ServerCall>, ValueDecoder<ServerCall> {
        public override fun encode(value: ServerCall, encoder: Encoder) {
            val fields = encoder.keyed()
            when (value) {
                case ServerCall.Search(payload) -> {
                    String.encode("web_search", fields.field("name"))
                    SearchUse.Companion.encode(payload, encoder)
                }
                case ServerCall.Fetch(payload) -> {
                    String.encode("web_fetch", fields.field("name"))
                    FetchUse.Companion.encode(payload, encoder)
                }
                case ServerCall.Code(payload) -> {
                    String.encode("code_execution", fields.field("name"))
                    CodeUse.Companion.encode(payload, encoder)
                }
            }
            fields.end()
        }
        public override fun decode(decoder: Decoder): ServerCall {
            val fields = decoder.keyed()
            return when (String.decode(fields.required("name"))) {
                case "web_search" -> ServerCall.Search(SearchUse.Companion.decode(decoder))
                case "web_fetch" -> ServerCall.Fetch(FetchUse.Companion.decode(decoder))
                case "code_execution" -> ServerCall.Code(CodeUse.Companion.decode(decoder))
                else -> throw DecodingException(fields.required("name").path, "unknown server tool")
            }
        }
    }
}
struct SearchUse(val id: String, val input: SearchInput) {
    companion object : ValueEncoder<SearchUse>, ValueDecoder<SearchUse> {}
}
struct SearchInput(val query: String) {
    companion object : ValueEncoder<SearchInput>, ValueDecoder<SearchInput> {}
}
struct FetchUse(val id: String, val input: FetchInput) {
    companion object : ValueEncoder<FetchUse>, ValueDecoder<FetchUse> {}
}
struct FetchInput(val url: String) {
    companion object : ValueEncoder<FetchInput>, ValueDecoder<FetchInput> {}
}
struct CodeUse(val id: String, val input: CodeInput) {
    companion object : ValueEncoder<CodeUse>, ValueDecoder<CodeUse> {}
}
struct CodeInput(val code: String) {
    companion object : ValueEncoder<CodeInput>, ValueDecoder<CodeInput> {}
}
struct ServerUse(val call: ServerCall) {
    companion object : ValueEncoder<ServerUse>, ValueDecoder<ServerUse> {
        public override fun encode(value: ServerUse, encoder: Encoder) { ServerCall.Companion.encode(value.call, encoder) }
        public override fun decode(decoder: Decoder): ServerUse = ServerUse(ServerCall.Companion.decode(decoder))
    }
}
