package scoop.json.tests.consumer.baseline_messages

import scoop.test.*
import scoop.json.*

struct TextBlock(val text: String, val cache_control: CacheControl? = None, val citations: Array<Citation>? = None) {
    companion object : ValueEncoder<TextBlock>, ValueDecoder<TextBlock> {}
}
struct ImageBlock(val source: Source) {
    companion object : ValueEncoder<ImageBlock>, ValueDecoder<ImageBlock> {}
}
struct DocumentBlock(
    val source: Source,
    val title: String? = None,
    val context: String? = None,
    val citations: CitationConfig? = None
) {
    companion object : ValueEncoder<DocumentBlock>, ValueDecoder<DocumentBlock> {}
}
struct ThinkingBlock(val thinking: String, val signature: String) {
    companion object : ValueEncoder<ThinkingBlock>, ValueDecoder<ThinkingBlock> {}
}
struct RedactedBlock(val data: String) {
    companion object : ValueEncoder<RedactedBlock>, ValueDecoder<RedactedBlock> {}
}
struct ToolUse(val id: String, val name: String, val input: JsonValue) {
    companion object : ValueEncoder<ToolUse>, ValueDecoder<ToolUse> {}
}
struct ToolResult(val tool_use_id: String, val content: Content? = None, val is_error: Boolean = false) {
    companion object : ValueEncoder<ToolResult>, ValueDecoder<ToolResult> {}
}
struct SearchResultBlock(val tool_use_id: String, val content: SearchResults) {
    companion object : ValueEncoder<SearchResultBlock>, ValueDecoder<SearchResultBlock> {}
}
struct FetchResultBlock(val tool_use_id: String, val content: FetchResult) {
    companion object : ValueEncoder<FetchResultBlock>, ValueDecoder<FetchResultBlock> {}
}
struct CodeResultBlock(val tool_use_id: String, val content: CodeResult) {
    companion object : ValueEncoder<CodeResultBlock>, ValueDecoder<CodeResultBlock> {}
}
struct SearchBlock(
    val source: String,
    val title: String,
    val content: Array<TextOnly>,
    val citations: CitationConfig? = None
) {
    companion object : ValueEncoder<SearchBlock>, ValueDecoder<SearchBlock> {}
}
struct UploadBlock(val file_id: String) {
    companion object : ValueEncoder<UploadBlock>, ValueDecoder<UploadBlock> {}
}
struct CitationConfig(val enabled: Boolean) {
    companion object : ValueEncoder<CitationConfig>, ValueDecoder<CitationConfig> {}
}
struct CacheControl(val type: String, val ttl: String? = None) {
    companion object : ValueEncoder<CacheControl>, ValueDecoder<CacheControl> {}
}
