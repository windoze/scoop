package scoop.json.tests.consumer.baseline_messages

import scoop.test.*
enum CacheMiss {
    Model(CacheChanged), System(CacheChanged), Tools(CacheChanged), Messages(CacheChanged), NotFound, Unavailable
    companion object : ValueEncoder<CacheMiss>, ValueDecoder<CacheMiss> {
        public override fun encode(value: CacheMiss, encoder: Encoder) {
            val fields = encoder.keyed()
            when (value) {
                case CacheMiss.Model(payload) -> {
                    String.encode("model_changed", fields.field("type"))
                    CacheChanged.Companion.encode(payload, encoder)
                }
                case CacheMiss.System(payload) -> {
                    String.encode("system_changed", fields.field("type"))
                    CacheChanged.Companion.encode(payload, encoder)
                }
                case CacheMiss.Tools(payload) -> {
                    String.encode("tools_changed", fields.field("type"))
                    CacheChanged.Companion.encode(payload, encoder)
                }
                case CacheMiss.Messages(payload) -> {
                    String.encode("messages_changed", fields.field("type"))
                    CacheChanged.Companion.encode(payload, encoder)
                }
                case CacheMiss.NotFound -> {
                    String.encode("previous_message_not_found", fields.field("type"))
                }
                case CacheMiss.Unavailable -> {
                    String.encode("unavailable", fields.field("type"))
                }
            }
            fields.end()
        }
        public override fun decode(decoder: Decoder): CacheMiss {
            val fields = decoder.keyed()
            return when (String.decode(fields.required("type"))) {
                case "model_changed" -> CacheMiss.Model(CacheChanged.Companion.decode(decoder))
                case "system_changed" -> CacheMiss.System(CacheChanged.Companion.decode(decoder))
                case "tools_changed" -> CacheMiss.Tools(CacheChanged.Companion.decode(decoder))
                case "messages_changed" -> CacheMiss.Messages(CacheChanged.Companion.decode(decoder))
                case "previous_message_not_found" -> CacheMiss.NotFound
                case "unavailable" -> CacheMiss.Unavailable
                else -> throw DecodingException(fields.required("type").path, "unknown CacheMiss branch")
            }
        }
    }
}
struct CacheChanged(val cache_missed_input_tokens: Long) {
    companion object : ValueEncoder<CacheChanged>, ValueDecoder<CacheChanged> {}
}
