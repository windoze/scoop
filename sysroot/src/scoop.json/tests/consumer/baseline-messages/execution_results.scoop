package scoop.json.tests.consumer.baseline_messages

import scoop.test.*
struct FetchedDocument(val url: String, val content: FetchedContent, val retrieved_at: String? = None) {
    companion object : ValueEncoder<FetchedDocument>, ValueDecoder<FetchedDocument> {}
}
struct FetchedContent(
    val type: String,
    val source: Source,
    val title: String? = None,
    val citations: CitationConfig? = None
) {
    companion object : ValueEncoder<FetchedContent>, ValueDecoder<FetchedContent> {}
}
struct ServerError(val error_code: String) {
    companion object : ValueEncoder<ServerError>, ValueDecoder<ServerError> {}
}
enum FetchResult {
    Document(FetchedDocument), Error(ServerError)
    companion object : ValueEncoder<FetchResult>, ValueDecoder<FetchResult> {
        public override fun encode(value: FetchResult, encoder: Encoder) {
            val fields = encoder.keyed()
            when (value) {
                case FetchResult.Document(payload) -> {
                    String.encode("web_fetch_result", fields.field("type"))
                    FetchedDocument.Companion.encode(payload, encoder)
                }
                case FetchResult.Error(payload) -> {
                    String.encode("web_fetch_tool_result_error", fields.field("type"))
                    ServerError.Companion.encode(payload, encoder)
                }
            }
            fields.end()
        }
        public override fun decode(decoder: Decoder): FetchResult {
            val fields = decoder.keyed()
            return when (String.decode(fields.required("type"))) {
                case "web_fetch_result" -> FetchResult.Document(FetchedDocument.Companion.decode(decoder))
                case "web_fetch_tool_result_error" -> FetchResult.Error(ServerError.Companion.decode(decoder))
                else -> throw DecodingException(fields.required("type").path, "unknown FetchResult branch")
            }
        }
    }
}
struct CodeOutput(val stdout: String, val stderr: String, val return_code: Long, val content: Array<CodeFile>) {
    companion object : ValueEncoder<CodeOutput>, ValueDecoder<CodeOutput> {}
}
struct EncryptedOutput(
    val encrypted_stdout: String,
    val stderr: String,
    val return_code: Long,
    val content: Array<CodeFile>
) {
    companion object : ValueEncoder<EncryptedOutput>, ValueDecoder<EncryptedOutput> {}
}
enum CodeResult {
    Output(CodeOutput), Encrypted(EncryptedOutput), Error(ServerError)
    companion object : ValueEncoder<CodeResult>, ValueDecoder<CodeResult> {
        public override fun encode(value: CodeResult, encoder: Encoder) {
            val fields = encoder.keyed()
            when (value) {
                case CodeResult.Output(payload) -> {
                    String.encode("code_execution_result", fields.field("type"))
                    CodeOutput.Companion.encode(payload, encoder)
                }
                case CodeResult.Encrypted(payload) -> {
                    String.encode("encrypted_code_execution_result", fields.field("type"))
                    EncryptedOutput.Companion.encode(payload, encoder)
                }
                case CodeResult.Error(payload) -> {
                    String.encode("code_execution_tool_result_error", fields.field("type"))
                    ServerError.Companion.encode(payload, encoder)
                }
            }
            fields.end()
        }
        public override fun decode(decoder: Decoder): CodeResult {
            val fields = decoder.keyed()
            return when (String.decode(fields.required("type"))) {
                case "code_execution_result" -> CodeResult.Output(CodeOutput.Companion.decode(decoder))
                case "encrypted_code_execution_result" -> CodeResult.Encrypted(EncryptedOutput.Companion.decode(decoder))
                case "code_execution_tool_result_error" -> CodeResult.Error(ServerError.Companion.decode(decoder))
                else -> throw DecodingException(fields.required("type").path, "unknown CodeResult branch")
            }
        }
    }
}
