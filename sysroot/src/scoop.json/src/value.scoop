package scoop.json

/**
 * An opaque JSON value tree for carrying a nested value without knowing its application type. Its
 * codec requires a JSON encoder or decoder and preserves JSON number tokens.
 */
public class JsonValue internal constructor(internal val node: JsonNode) {
    /**
     * The codec for embedding an opaque [JsonValue] in a JSON document.
     */
    public companion object : ValueEncoder<JsonValue>, ValueDecoder<JsonValue> {
        /**
         * Copies the stored JSON tree into a JSON encoder. Other encoder implementations produce
         * [EncodingException].
         */
        public override fun encode(value: JsonValue, encoder: Encoder) {
            if (encoder !is JsonEncoder) {
                throw EncodingException(encoder.path, "JsonValue requires a JSON encoder")
            }
            encodeJsonNode(value.node, encoder)
        }

        /**
         * Retains the current subtree of a JSON decoder. Other decoder implementations produce
         * [DecodingException].
         */
        public override fun decode(decoder: Decoder): JsonValue {
            if (decoder !is JsonDecoder) {
                throw DecodingException(decoder.path, "JsonValue requires a JSON decoder")
            }
            return JsonValue(decoder.value)
        }
    }
}

internal fun encodeJsonNode(node: JsonNode, encoder: JsonEncoder) {
    when (node) {
        case JsonNode.Null -> encoder.singleValue().writeNull()
        case JsonNode.BooleanValue(value) -> encoder.singleValue().writeBoolean(value)
        case JsonNode.Text(text) -> encoder.singleValue().writeString(text)
        case JsonNode.Number(text) -> {
            encoder.singleValue()
            encoder.writeNumberToken(text)
        }
        case JsonNode.Record(members) -> {
            val fields = encoder.keyed()
            for (member in members) {
                encodeJsonNode(member.value, fields.field(member.name) as JsonEncoder)
            }
            fields.end()
        }
        case JsonNode.Sequence(elements) -> {
            val sequence = encoder.unkeyed()
            for (element in elements) {
                encodeJsonNode(element, sequence.element() as JsonEncoder)
            }
            sequence.end()
        }
    }
}
