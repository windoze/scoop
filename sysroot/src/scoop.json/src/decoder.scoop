package scoop.json

internal class JsonDecoder(internal val value: JsonNode, public override val path: String)
    : Decoder, SingleValueDecodingContainer {
    public override fun keyed(): KeyedDecodingContainer {
        return when (value) {
            case JsonNode.Record(members) -> JsonKeyedDecoder(this, members)
            else -> { throw DecodingException(path, "expected an object") }
        }
    }

    public override fun unkeyed(): UnkeyedDecodingContainer {
        return when (value) {
            case JsonNode.Sequence(elements) -> JsonUnkeyedDecoder(this, elements)
            else -> { throw DecodingException(path, "expected an array") }
        }
    }

    public override fun singleValue(): SingleValueDecodingContainer = this

    public override fun isNull(): Boolean {
        return when (value) {
            case JsonNode.Null -> true
            else -> false
        }
    }

    public override fun readBoolean(): Boolean {
        return when (value) {
            case JsonNode.BooleanValue(result) -> result
            else -> { throw DecodingException(path, "expected a Boolean") }
        }
    }

    public override fun readString(): String {
        return when (value) {
            case JsonNode.Text(result) -> result
            else -> { throw DecodingException(path, "expected a String") }
        }
    }

    public override fun readNull() {
        when (value) {
            case JsonNode.Null -> { return }
            else -> { throw DecodingException(path, "expected null") }
        }
    }

    private fun number(expected: String): String {
        return when (value) {
            case JsonNode.Number(text) -> text
            else -> { throw DecodingException(path, expected) }
        }
    }

    public override fun readLong(): Long {
        val text = number("expected an integer")
        val negative = text.getCharAt(0L) == '-'
        val magnitude = integerMagnitude(text, negative, path)
        if (negative) {
            if (magnitude > 9223372036854775808UL) {
                throw DecodingException(path, "integer is out of range")
            }
            return -magnitude.toLong()
        }
        if (magnitude > 9223372036854775807UL) {
            throw DecodingException(path, "integer is out of range")
        }
        return magnitude.toLong()
    }

    public override fun readULong(): ULong {
        val text = number("expected an integer")
        if (text.getCharAt(0L) == '-') { throw DecodingException(path, "expected an unsigned integer") }
        return integerMagnitude(text, false, path)
    }

    public override fun readFloat(): Float {
        return when (parseFloat(number("expected a number"))) {
            case Some(result) -> result
            case None -> { throw DecodingException(path, "Float is out of range") }
        }
    }

    public override fun readDouble(): Double {
        return when (parseDouble(number("expected a number"))) {
            case Some(result) -> result
            case None -> { throw DecodingException(path, "Double is out of range") }
        }
    }
}

internal fun integerMagnitude(text: String, negative: Boolean, path: String): ULong {
    var result: ULong = 0UL
    var first: Boolean = true
    for (character in text) {
        if (first && negative) {
            first = false
            continue
        }
        first = false
        if (character < '0' || character > '9') {
            throw DecodingException(path, "expected an integer without fraction or exponent")
        }
        val digit = (character.code - 48).toULong()
        if (result > (18446744073709551615UL - digit) / 10UL) {
            throw DecodingException(path, "integer is out of range")
        }
        result = result * 10UL + digit
    }
    return result
}
