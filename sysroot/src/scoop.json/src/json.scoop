package scoop.json

public object Json {
    public fun <T> encodeToString(value: T, codec: ValueEncoder<T>): String =
        renderJson(encodeToValue(value, codec).node)

    public fun <T> decodeFromString(text: String, codec: ValueDecoder<T>): T =
        decodeFromValue(JsonValue(JsonParser(text).parse()), codec)

    public fun <T> encodeToValue(value: T, codec: ValueEncoder<T>): JsonValue {
        val encoder = JsonEncoder("")
        codec.encode(value, encoder)
        return JsonValue(encoder.result())
    }

    public fun <T> decodeFromValue(value: JsonValue, codec: ValueDecoder<T>): T =
        codec.decode(JsonDecoder(value.node, ""))
}

internal enum JsonNode {
    Null,
    BooleanValue(Boolean),
    Number(String),
    Text(String),
    Record(ArrayList<JsonMember>),
    Sequence(ArrayList<JsonNode>)
}

internal struct JsonMember(val name: String, val value: JsonNode)

internal fun childPath(path: String, name: String): String {
    val result = StringBuilder().append(path).append("/")
    for (character in name) {
        when (character) {
            case '~' -> { result.append("~0") }
            case '/' -> { result.append("~1") }
            else -> { result.append(character) }
        }
    }
    return result.toString()
}
