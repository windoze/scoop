package scoop.math

import scoop.math.min as numericMin
import scoop.math.max as numericMax

/** Clears the sign bit, retaining every other bit including NaN payloads. */
public fun abs(x: Float): Float = Float.fromBits(x.toBits() and Int.MAX_VALUE)

/** Copies only the sign bit from sign into magnitude. */
public fun copySign(magnitude: Float, sign: Float): Float =
    Float.fromBits((magnitude.toBits() and Int.MAX_VALUE) or (sign.toBits() and Int.MIN_VALUE))

/** Returns signed one, preserving signed zero and propagating NaN. */
public fun signum(x: Float): Float =
    if (x.isNaN() || x == 0f)
        x
    else
        copySign(1f, x)

/** Returns the smaller value, propagating NaN and ordering negative zero first. */
public fun min(a: Float, b: Float): Float {
    if (a.isNaN())
        return a
    if (b.isNaN())
        return b
    if (a == 0f && b == 0f)
        return Float.fromBits(a.toBits() or b.toBits())
    return if (a <= b)
        a
    else
        b
}

/** Returns the larger value, propagating NaN and ordering negative zero first. */
public fun max(a: Float, b: Float): Float {
    if (a.isNaN())
        return a
    if (b.isNaN())
        return b
    if (a == 0f && b == 0f)
        return Float.fromBits(a.toBits() and b.toBits())
    return if (a >= b)
        a
    else
        b
}

/** Clamps to inclusive numeric bounds; NaN or reversed bounds throw. */
public fun clamp(value: Float, min: Float, max: Float): Float {
    if (
        min.isNaN() ||
            max.isNaN() ||
            min >
            max ||
            (min == 0f && max == 0f && min.toBits() == 0 && max.toBits() < 0)
    )
        throw IllegalArgumentException(Some("invalid floating bounds"))
    return numericMin(numericMax(value, min), max)
}

/** Returns the adjacent representable value toward positive infinity. */
public fun nextUp(x: Float): Float {
    if (x.isNaN() || x == Float.POSITIVE_INFINITY)
        return x
    if (x == 0f)
        return Float.MIN_VALUE
    return Float.fromBits(
        x.toBits() +
            (
                if (x < 0f)
                    -1
                else
                    1
            )
    )
}

/** Returns the adjacent representable value toward negative infinity. */
public fun nextDown(x: Float): Float {
    if (x.isNaN() || x == Float.NEGATIVE_INFINITY)
        return x
    if (x == 0f)
        return -Float.MIN_VALUE
    return Float.fromBits(
        x.toBits() +
            (
                if (x < 0f)
                    1
                else
                    -1
            )
    )
}

/** Returns the neighbor toward direction; equal inputs return direction including its zero sign. */
public fun nextAfter(x: Float, direction: Float): Float {
    if (x.isNaN())
        return x
    if (direction.isNaN())
        return direction
    if (x == direction)
        return direction
    return if (x < direction)
        nextUp(x)
    else
        nextDown(x)
}

/** Returns the unbiased exponent; zero/subnormal and nonfinite values use boundary sentinels. */
public fun getExponent(x: Float): Int = ((x.toBits() ushr 23L) and 0xff).toInt() - 127

/** Returns the spacing at the magnitude of x, with IEEE zero and nonfinite handling. */
public fun ulp(x: Float): Float {
    if (x.isNaN() || x.isInfinite())
        return abs(x)
    val exponent = getExponent(x)
    if (exponent < -126)
        return Float.MIN_VALUE
    val power = exponent - 23
    return if (power >= -126)
        Float.fromBits((power + 127).toInt() shl 23L)
    else
        Float.fromBits(1 shl (power - (-149)).toLong())
}

/** Rounds to the nearest integer with ties toward positive infinity; overflow saturates and NaN becomes zero. */
public fun round(x: Float): Int {
    if (!x.isFinite())
        return x.toInt()
    val lower = floor(x)
    return (
        if (x - lower >= 0.5f)
            lower + 1f
        else
            lower
    ).toInt()
}

/** Converts angle units using a coefficient rounded directly to the operand precision. */
public fun toRadians(x: Float): Float =
    x * 0.017453292519943295769236907684886127134428718885417254560971914401710091146034494f

/** Converts angle units using a coefficient rounded directly to the operand precision. */
public fun toDegrees(x: Float): Float =
    x * 57.295779513082320876798154814105170332405472466564321549160243861202847148321553f

/** Evaluates sin at the operand precision using the target math library. */
public fun sin(x: Float): Float {
    @Unsafe
    {
        return nativeSin(x)
    }
}

