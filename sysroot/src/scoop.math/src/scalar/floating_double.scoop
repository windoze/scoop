package scoop.math

import scoop.math.min as numericMin
import scoop.math.max as numericMax

/** Clears the sign bit, retaining every other bit including NaN payloads. */
public fun abs(x: Double): Double = Double.fromBits(x.toBits() and Long.MAX_VALUE)

/** Copies only the sign bit from sign into magnitude. */
public fun copySign(magnitude: Double, sign: Double): Double =
    Double.fromBits((magnitude.toBits() and Long.MAX_VALUE) or (sign.toBits() and Long.MIN_VALUE))

/** Returns signed one, preserving signed zero and propagating NaN. */
public fun signum(x: Double): Double =
    if (x.isNaN() || x == 0.0)
        x
    else
        copySign(1.0, x)

/** Returns the smaller value, propagating NaN and ordering negative zero first. */
public fun min(a: Double, b: Double): Double {
    if (a.isNaN())
        return a
    if (b.isNaN())
        return b
    if (a == 0.0 && b == 0.0)
        return Double.fromBits(a.toBits() or b.toBits())
    return if (a <= b)
        a
    else
        b
}

/** Returns the larger value, propagating NaN and ordering negative zero first. */
public fun max(a: Double, b: Double): Double {
    if (a.isNaN())
        return a
    if (b.isNaN())
        return b
    if (a == 0.0 && b == 0.0)
        return Double.fromBits(a.toBits() and b.toBits())
    return if (a >= b)
        a
    else
        b
}

/** Clamps to inclusive numeric bounds; NaN or reversed bounds throw. */
public fun clamp(value: Double, min: Double, max: Double): Double {
    if (
        min.isNaN() ||
            max.isNaN() ||
            min >
            max ||
            (min == 0.0 && max == 0.0 && min.toBits() == 0L && max.toBits() < 0L)
    )
        throw IllegalArgumentException(Some("invalid floating bounds"))
    return numericMin(numericMax(value, min), max)
}

/** Returns the adjacent representable value toward positive infinity. */
public fun nextUp(x: Double): Double {
    if (x.isNaN() || x == Double.POSITIVE_INFINITY)
        return x
    if (x == 0.0)
        return Double.MIN_VALUE
    return Double.fromBits(
        x.toBits() +
            (
                if (x < 0.0)
                    -1L
                else
                    1L
            )
    )
}

/** Returns the adjacent representable value toward negative infinity. */
public fun nextDown(x: Double): Double {
    if (x.isNaN() || x == Double.NEGATIVE_INFINITY)
        return x
    if (x == 0.0)
        return -Double.MIN_VALUE
    return Double.fromBits(
        x.toBits() +
            (
                if (x < 0.0)
                    1L
                else
                    -1L
            )
    )
}

/** Returns the neighbor toward direction; equal inputs return direction including its zero sign. */
public fun nextAfter(x: Double, direction: Double): Double {
    if (x.isNaN())
        return x
    if (direction.isNaN())
        return direction
    if (x == direction)
        return direction
    return if (x < direction)
        nextUp(x)
    else
        nextDown(x)
}

/** Returns the unbiased exponent; zero/subnormal and nonfinite values use boundary sentinels. */
public fun getExponent(x: Double): Int = ((x.toBits() ushr 52L) and 0x7ffL).toInt() - 1023

/** Returns the spacing at the magnitude of x, with IEEE zero and nonfinite handling. */
public fun ulp(x: Double): Double {
    if (x.isNaN() || x.isInfinite())
        return abs(x)
    val exponent = getExponent(x)
    if (exponent < -1022)
        return Double.MIN_VALUE
    val power = exponent - 52
    return if (power >= -1022)
        Double.fromBits((power + 1023).toLong() shl 52L)
    else
        Double.fromBits(1L shl (power - (-1074)).toLong())
}

/** Rounds to the nearest integer with ties toward positive infinity; overflow saturates and NaN becomes zero. */
public fun round(x: Double): Long {
    if (!x.isFinite())
        return x.toLong()
    val lower = floor(x)
    return (
        if (x - lower >= 0.5)
            lower + 1.0
        else
            lower
    ).toLong()
}

/** Converts angle units using a coefficient rounded directly to the operand precision. */
public fun toRadians(x: Double): Double =
    x * 0.017453292519943295769236907684886127134428718885417254560971914401710091146034494

/** Converts angle units using a coefficient rounded directly to the operand precision. */
public fun toDegrees(x: Double): Double =
    x * 57.295779513082320876798154814105170332405472466564321549160243861202847148321553

/** Evaluates sin at the operand precision using the target math library. */
public fun sin(x: Double): Double {
    @Unsafe
    {
        return nativeSin(x)
    }
}

