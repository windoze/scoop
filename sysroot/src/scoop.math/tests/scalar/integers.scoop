    @Test
    fun wideProducts() {
        assertEquals(1uL, multiplyHigh(0xffffffffffffffffuL, 2uL))
        assertEquals(0xfffffffffffffffeuL, multiplyHigh(ULong.MAX_VALUE, ULong.MAX_VALUE))
        assertEquals(0L, multiplyHigh(-1L, -1L))
        assertEquals(-1L, multiplyHigh(-1L, 2L))
        assertEquals(0x4000000000000000L, multiplyHigh(Long.MIN_VALUE, Long.MIN_VALUE))
        assertEquals(4611686018427387904L, multiplyFull(Int.MIN_VALUE, Int.MIN_VALUE))
        assertEquals(18446744065119617025uL, multiplyFull(UInt.MAX_VALUE, UInt.MAX_VALUE))
        assertFailsWith<ArithmeticException> { toIntExact(Long.MAX_VALUE) }
        assertEquals(Int.MIN_VALUE, toIntExact(-2147483648L))
    }
}
