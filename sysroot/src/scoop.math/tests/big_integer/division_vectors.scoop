package scoop.math.tests.big_integer

import scoop.math.*
import scoop.test.*

// Exact integer vectors generated with Python 3 int, seed 20261026.
@Test
private class BigIntegerDivisionVectors {
    private fun check(a: String, b: String, quotient: String, remainder: String, product: String) {
        val left = a.toBigInteger()
        val right = b.toBigInteger()
        val result = left.divideAndRemainder(right)
        assertEquals(quotient, result._1.toString())
        assertEquals(remainder, result._2.toString())
        assertEquals(product, (left * right).toString())
        assertEquals(left, result._1 * right + result._2)
        assertEquals(left, left + right - right)
        assertEquals(left, (left * right) / right)
    }

    @Test
    fun normalizedLongDivision() {
