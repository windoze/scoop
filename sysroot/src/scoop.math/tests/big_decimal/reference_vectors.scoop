package scoop.math.tests.big_decimal

import scoop.math.*
import scoop.test.*

// Python decimal/libmpdec reference vectors, seed 20261026. Positive powers are evaluated at
// 2000 digits exactly; negative powers divide one by that exact result at target precision.
private fun vector(a: String, b: String, precision: Long, mode: RoundingMode, exponent: Long, add: String, multiply: String, divide: String, power: String) {
    val left = decimal(a)
    val right = decimal(b)
    val context = MathContext(precision, mode)
    assertEquals(decimal(add), left.plus(right, context))
    assertEquals(decimal(multiply), left.times(right, context))
    assertEquals(decimal(divide), left.div(right, context))
    assertEquals(decimal(power), left.pow(exponent, context))
}

