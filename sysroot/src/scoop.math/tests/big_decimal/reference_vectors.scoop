    @Test
    fun squareRootsAgainstIndependentReference() {
        assertEquals(decimal("0.00009"), decimal("8.574240152288467410410633040979497492965E-9").sqrt(MathContext(1L)))
        assertEquals(decimal("27591.91531682116"), decimal("761313790.8506301888823195682601147395185").sqrt(MathContext(16L)))
        assertEquals(decimal("5E+15"), decimal("28107002255943776514851019561510.94756665").sqrt(MathContext(1L)))
        assertEquals(decimal("0.0003571950"), decimal("1.275882982497167976641723002006237028507E-7").sqrt(MathContext(7L)))
        assertEquals(decimal("5E-9"), decimal("2.861094801288814686651010615436735373341E-17").sqrt(MathContext(1L)))
        assertEquals(decimal("5E+20"), decimal("2.457719350405289483254564501592241484414E+41").sqrt(MathContext(1L)))
        assertEquals(decimal("3.927061149412045E+29"), decimal("1.542180927122145224788529941408997347883E+59").sqrt(MathContext(16L)))
        assertEquals(decimal("5E-11"), decimal("2.915320334868451571309147996452792630489E-21").sqrt(MathContext(1L)))
        assertEquals(decimal("1.94E-8"), decimal("3.755153476185231178523044320176494839918E-16").sqrt(MathContext(3L)))
        assertEquals(decimal("0.0003"), decimal("7.097167790143184679042244216121840642131E-8").sqrt(MathContext(1L)))
        assertEquals(decimal("6E+22"), decimal("4.201159087307089516550541660070837697077E+45").sqrt(MathContext(1L)))
        assertEquals(decimal("9E+31"), decimal("7.624928857017462147362881302638829771920E+63").sqrt(MathContext(1L)))
        assertEquals(decimal("3.000444E-11"), decimal("9.002666828910119203491966905970793926124E-22").sqrt(MathContext(7L)))
        assertEquals(decimal("6.636122285987943560128405590564070E-16"), decimal("4.403811899458584977735673208012080955068E-31").sqrt(MathContext(34L)))
        assertEquals(decimal("85734410044916010372053106.81799968"), decimal("7.350389065749795299621155191158742880990E+51").sqrt(MathContext(34L)))
        assertEquals(decimal("8E+24"), decimal("5.974899101767101942834840331534003683628E+49").sqrt(MathContext(1L)))
        assertEquals(decimal("129581.0911645223"), decimal("16791259187.38823491330697834956082860636").sqrt(MathContext(16L)))
        assertEquals(decimal("768341359136705421407.8159921438674"), decimal("5.903484441600397395529864374937933720924E+41").sqrt(MathContext(34L)))
        assertEquals(decimal("98833850063744451.62859954046132578"), decimal("9768129918422719145249880497478071.902785").sqrt(MathContext(34L)))
        assertEquals(decimal("9.677875E+30"), decimal("9.366125677707718562536935782565166808037E+61").sqrt(MathContext(7L)))
    }
}
