package scoop.llm.client.tests.generatecontent

import scoop.json.*
import scoop.llm.client.*
import scoop.test.*

private fun generateContentSettings(options: LlmGenerationOptions): JsonValue = encodeGenerateContent(LlmRequest([Message([Text("q")])], options = options))

@Test
private class GenerateContentOptionsTest {
    @Test
    fun `generateContent options preserve zero empty stop schema and explicit reasoning`() {
        val schema = Json.parse("{\"type\":\"object\",\"properties\":{\"n\":{\"type\":\"integer\"}},\"required\":[\"n\"]}")
        val config = generateContentSettings(LlmGenerationOptions(temperature = Some(0.0), topP = Some(0.0), topK = Some(0UL),
            maxOutputTokens = Some(0UL), candidates = Some(2UL), stop = Some([]), reasoning = Some(ReasoningOptions(enabled = Some(false))),
            output = JsonSchema(schema)))["generationConfig"]!!
        assertEquals(0.0, config["temperature"]!!.asDouble())
        assertEquals(0.0, config["topP"]!!.asDouble())
        assertEquals(0L, config["topK"]!!.asLong())
        assertEquals(0L, config["maxOutputTokens"]!!.asLong())
        assertEquals(2L, config["candidateCount"]!!.asLong())
        assertEquals(0L, config["stopSequences"]!!.size)
        assertEquals(0L, config["thinkingConfig"]!!["thinkingBudget"]!!.asLong())
        assertFalse(config["thinkingConfig"]!!.containsKey("includeThoughts"))
        assertEquals(Json.stringify(schema), Json.stringify(config["responseFormat"]!!["text"]!!["schema"]!!))
        val level = generateContentSettings(LlmGenerationOptions(reasoning = Some(ReasoningOptions(effort = Some("low")))))
        assertEquals("LOW", level["generationConfig"]!!["thinkingConfig"]!!["thinkingLevel"]!!.asString())
        val budget = generateContentSettings(LlmGenerationOptions(reasoning = Some(ReasoningOptions(budgetTokens = Some(17UL)))))
        assertEquals(17L, budget["generationConfig"]!!["thinkingConfig"]!!["thinkingBudget"]!!.asLong())
        assertEquals("APPLICATION_JSON", generateContentSettings(LlmGenerationOptions(output = JsonObject))["generationConfig"]!!["responseFormat"]!!["text"]!!["mimeType"]!!.asString())
    }

    @Test
    fun `generateContent reports unsupported controls and contradictory reasoning at public paths`() {
        for ((options, path) in [
            (LlmGenerationOptions(temperature = Some(2.1)), "temperature"),
            (LlmGenerationOptions(topP = Some(-0.1)), "topP"),
            (LlmGenerationOptions(stop = Some(["1", "2", "3", "4", "5", "6"])), "stop"),
            (LlmGenerationOptions(parallelToolCalls = Some(false)), "parallelToolCalls"),
            (LlmGenerationOptions(reasoning = Some(ReasoningOptions(enabled = Some(true)))), "reasoning/enabled"),
            (LlmGenerationOptions(reasoning = Some(ReasoningOptions(Some(false), Some("low")))), "reasoning/enabled"),
            (LlmGenerationOptions(reasoning = Some(ReasoningOptions(effort = Some("low"), budgetTokens = Some(1UL)))), "reasoning/budgetTokens"),
            (LlmGenerationOptions(reasoning = Some(ReasoningOptions(effort = Some("none")))), "reasoning/effort"),
            (LlmGenerationOptions(output = JsonSchema(Json.parse("{}"), name = "custom")), "output/name"),
            (LlmGenerationOptions(output = JsonSchema(Json.parse("{}"), strict = Some(false))), "output/strict")])
            assertGenerateContentRequestFailure(LlmRequest([Message([Text("q")])], options = options), "/options/" + path)
    }
}
