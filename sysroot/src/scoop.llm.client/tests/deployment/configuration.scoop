package scoop.llm.client.tests.deployment

import scoop.llm.client.*
import scoop.test.*
import scoop.url.Url

@Test
private class AzureDeploymentConfigurationTest {
    @Test
    fun `Azure deployment keeps protocol selection explicit and direct defaults unchanged`() {
        val provider = Providers.openAiChat()
        val direct = LlmEndpoint(provider, LlmAuth.none())
        assertSame(provider, direct.provider)
        assertEquals(provider.defaultBaseUrl!!.toString(), direct.baseUrl.toString())
        assertTrue(when (direct.deployment) { case Direct -> true; else -> false })
        val resource = Url.parse("https://resource.openai.azure.com/gateway")
        val legacy = LlmEndpoint(provider, LlmAuth.none(), Some(resource),
            deployment = AzureOpenAiLegacy("2024-10-21"))
        assertSame(provider, legacy.provider)
        assertEquals(resource.toString(), legacy.baseUrl.toString())
        for (id in ["deployment-a", "organization/model:variant", "deployment-b"])
            assertEquals(id, legacy.model(id).id)
        assertFailsWith<IllegalArgumentException> { legacy.model(""); Unit }
    }

    @Test
    fun `Azure deployment rejects missing resource version conflicting query and non Chat protocols`() {
        val provider = Providers.openAiChat()
        val resource = Some(Url.parse("https://resource.openai.azure.com"))
        assertFailsWith<IllegalArgumentException> {
            val invalid = LlmEndpoint(provider, LlmAuth.none(), deployment = AzureOpenAiLegacy("2024-10-21")); Unit
        }
        assertFailsWith<IllegalArgumentException> {
            val invalid = LlmEndpoint(provider, LlmAuth.none(), resource, deployment = AzureOpenAiLegacy("")); Unit
        }
        assertFailsWith<IllegalArgumentException> {
            val invalid = LlmEndpoint(provider, LlmAuth.none(), Some(Url.parse("https://resource.openai.azure.com?api%2Dversion=old")),
                deployment = AzureOpenAiLegacy("2024-10-21")); Unit
        }
        for (other in [Providers.openAiResponses(), Providers.anthropicMessages(), Providers.geminiGenerateContent()]) {
            assertFailsWith<IllegalArgumentException> {
                val invalid = LlmEndpoint(other, LlmAuth.none(), resource, deployment = AzureOpenAiLegacy("2024-10-21")); Unit
            }
        }
    }
}
