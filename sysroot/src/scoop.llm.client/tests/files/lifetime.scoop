package scoop.llm.client.tests.files

import scoop.asyncio.*
import scoop.http.*
import scoop.http.asyncio.AsyncHttp1Connection
import scoop.http.client.*
import scoop.llm.client.*
import scoop.llm.client.tests.client.*
import scoop.test.*

@Test
private class FileLifetimeTest {
    @Test
    fun `client close interrupts file content reads and preserves borrowed HTTP ownership`() {
        withLlmServer suspend { _, scope, listener, endpoint ->
            val started = LlmGate()
            val release = LlmGate()
            val serving = scope.launch suspend {
                AsyncHttp1Connection.takeOwnershipAsServer(listener.accept(), scope).useAsync suspend { connection ->
                    connection.receiveRequest()!!.body.readAllBytes(4096L)
                    connection.sendResponse(HttpResponseHead(HttpVersion.Http11, 200U), Http1BodyFraming.Chunked).useAsync suspend { output ->
                        output.flush(); release.await()
                    }
                }
            }
            try {
                HttpClient.open(scope, HttpClientConfig(observer = Some(HttpObserver(suspend { event ->
                    if (event.kind == HttpCallEventKind.ResponseHeaders) started.signal()
                })))).useAsync suspend { http ->
                    val client = LlmClient.open(scope, Some(http))
                    val finished = FinishedCalls()
                    val reading = scope.launch suspend {
                        expectLlmFailure<LlmClientClosedException> suspend {
                            client.downloadFile(endpoint, "file", LlmCallOptions(onFinished = Some(suspend { value -> finished.record(value) }))); Unit
                        }
                        Unit
                    }
                    started.await()
                    client.close()
                    reading.join()
                    assertFalse(http.isClosed)
                    assertEquals(1L, finished.values.size)
                    assertEquals(LlmCallOutcome.Failed, finished.values[0].outcome)
                    assertTrue(finished.values[0].attempts[0].response.receivedAt != None)
                    assertEquals(None, finished.values[0].attempts[0].response.completedAt)
                }
            } finally { release.signal() }
            serving.join()
        }
    }

    @Test
    fun `file content limits close response reads and report one failed completion`() {
        withLlmServer suspend { _, scope, listener, endpoint ->
            val serving = scope.launch suspend {
                AsyncHttp1Connection.takeOwnershipAsServer(listener.accept(), scope).useAsync suspend { connection ->
                    connection.receiveRequest()!!.body.readAllBytes(4096L)
                    sendLlmReply(connection, 200U, "too large")
                }
            }
            val finished = FinishedCalls()
            withLlmClient suspend { client ->
                val error = expectLlmFailure<ReadLimitException> suspend {
                    client.downloadFile(endpoint, "file", LlmCallOptions(maxResponseBytes = 2L,
                        onFinished = Some(suspend { value -> finished.record(value) }))); Unit
                }
                assertEquals(2L, error.maxBytes)
            }
            serving.join()
            assertEquals(1L, finished.values.size)
            assertEquals(LlmCallOutcome.Failed, finished.values[0].outcome)
            assertEquals(1L, finished.values[0].attempts.size)
            assertEquals(Some(200U), finished.values[0].attempts[0].status)
            assertEquals(None, finished.values[0].attempts[0].response.completedAt)
        }
    }
}
