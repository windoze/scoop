package scoop.llm.client.tests.files.gemini

import scoop.asyncio.*
import scoop.http.*
import scoop.http.asyncio.AsyncHttp1Connection
import scoop.json.*
import scoop.llm.client.*
import scoop.llm.client.tests.client.*
import scoop.llm.client.tests.files.*
import scoop.test.*
import scoop.time.Duration
import scoop.url.*

@Test
private class GeminiFileNetworkTest {
    @Test
    fun `Gemini file HTTP operations preserve multipart authentication retries explicit paging registration and timing`() {
        for (provider in [Providers.geminiGenerateContent(), Providers.geminiInteractions()]) {
            withLlmServer suspend { _, scope, listener, original ->
                val version = if (provider.protocol.dialectId == GeminiInteractionsDialect().id) "v1" else "v1beta"
                val retry = version == "v1beta"
                val auth = RecordingAuth()
                val endpoint = LlmEndpoint(provider, auth, Some(original.baseUrl.toBuilder().setEncodedPath("/gateway/" + version)
                    .setQueryParameters(UrlQuery().add("tenant", Some("one"))).build()))
                val raw = "{\"name\":\"files/one\",\"uri\":\"https://example.test/file/one\",\"state\":{}}"
                val payload = "synthetic file".toByteArray()
                val serving = scope.launch suspend {
                    AsyncHttp1Connection.takeOwnershipAsServer(listener.accept(), scope).useAsync suspend { connection ->
                        for (index in (if (retry) [0L, 1L, 2L, 3L, 4L, 5L, 6L] else [1L, 2L, 3L, 4L, 5L, 6L])) {
                            val request = connection.receiveRequest() ?: return@useAsync
                            val authIndex = index - (if (retry) 0L else 1L)
                            val target = when (request.head.target) { case Http1(bytes) -> String.fromUtf8(bytes); else -> fail() }
                            val path = if (index < 2L) "/gateway/upload/" + version + "/files" else "/gateway/" + version + "/files" +
                                (if (index == 2L || index == 6L) "/one" else if (index == 5L) ":register" else "")
                            val query = if (index < 2L) "&uploadType=multipart" else if (index == 3L) "&pageSize=1"
                                else if (index == 4L) "&pageSize=1&pageToken=next%20%2F%3F" else ""
                            assertEquals(path + "?tenant=one" + query, target)
                            assertEquals(if (index < 2L || index == 5L) "POST" else if (index == 6L) "DELETE" else "GET", String.fromUtf8(request.head.method))
                            val bytes = request.body.readAllBytes(4096L)
                            assertLlmBytes(auth.requests[authIndex].body, bytes)
                            assertEquals(target, auth.requests[authIndex].url.httpRequestTarget())
                            assertEquals("Bearer attempt-" + (authIndex + 1L).toString(), String.fromUtf8(request.head.fields.findAll("Authorization".toByteArray())[0].value))
                            if (index < 2L) {
                                val mime = String.fromUtf8(request.head.fields.findAll("Content-Type".toByteArray())[0].value)
                                assertEquals(mime, String.fromUtf8(auth.requests[authIndex].fields.findAll("Content-Type".toByteArray())[0].value))
                                val parts = readFileForm(bytes, mime)
                                assertEquals("{\"file\":{\"displayName\":\"sample.txt\"}}", String.fromUtf8(parts[0].body.toByteArray()))
                                assertLlmBytes(payload, parts[1].body.toByteArray())
                                if (index == 1L && retry) assertLlmBytes(auth.requests[0].body, bytes)
                            } else if (index == 5L) {
                                assertEquals("{\"uris\":[\"gs://bucket/a b\"]}", String.fromUtf8(bytes))
                                assertEquals("application/json", String.fromUtf8(request.head.fields.findAll("Content-Type".toByteArray())[0].value))
                            } else assertEquals(0L, bytes.size)
                            if (index == 0L) sendLlmReply(connection, 503U, "{\"error\":{\"code\":503,\"status\":\"UNAVAILABLE\"}}")
                            else if (index == 1L) sendLlmReply(connection, 200U, "{\"file\":" + raw + "}")
                            else if (index == 2L) sendLlmReply(connection, 200U, raw)
                            else if (index == 3L) sendLlmReply(connection, 200U, "{\"files\":[" + raw + "],\"nextPageToken\":\"next /?\"}")
                            else if (index == 4L) sendLlmReply(connection, 200U, "{}")
                            else if (index == 5L) sendLlmReply(connection, 200U, "{\"files\":[{\"name\":\"files/registered\"}],\"extra\":true}")
                            else sendLlmReply(connection, 200U, "{}")
                        }
                    }
                }
                val finished = FinishedCalls()
                withLlmClient suspend { client ->
                    val options = LlmCallOptions(retries = LlmRetryOptions(maxRetries = 1L, initialDelay = Duration.ZERO),
                        onFinished = Some(suspend { value -> finished.record(value) }))
                    val uploaded = Json.decodeFromString<LlmFileResult>(Json.encodeToString(client.uploadFile(endpoint,
                        LlmFileUpload("sample.txt", payload, "text/plain"), options)))
                    assertEquals("files/one", uploaded.file.id)
                    assertEquals(if (retry) 2L else 1L, uploaded.metadata.attempts.size)
                    val retrieved = client.retrieveFile(endpoint, uploaded.file.id, options)
                    assertEquals(raw, Json.stringify(retrieved.file.native))
                    val first = client.listFiles(endpoint, geminiFilesQuery(Some(1UL)), options)
                    assertEquals(uploaded.file.id, first.page.files[0].id)
                    val next = client.listFiles(endpoint, geminiFilesQuery(Some(1UL), Some(first.page.native["nextPageToken"]!!.asString())), options)
                    assertEquals(0L, next.page.files.size)
                    val registered = Json.decodeFromString<LlmFileListResult>(Json.encodeToString(client.registerFiles(endpoint, ["gs://bucket/a b"], options)))
                    assertEquals("files/registered", registered.page.files[0].id)
                    assertTrue(when (registered.page.files[0].reference) { case None -> true; case Some(_) -> false })
                    val deleted = client.deleteFile(endpoint, retrieved.file.id, options)
                    assertEquals("{}", String.fromUtf8(deleted.native))
                    for (metadata in [uploaded.metadata, retrieved.metadata, first.metadata, next.metadata, registered.metadata, deleted.metadata])
                        assertFileTiming(metadata)
                }
                serving.join()
                assertEquals(if (retry) 7L else 6L, auth.requests.size)
                assertEquals(6L, finished.values.size)
            }
        }
    }

    @Test
    fun `Gemini unavailable file operations and invalid upload addresses fail before authentication`() {
        withLlmServer suspend { _, _, _, original ->
            val auth = RecordingAuth()
            withLlmClient suspend { client ->
                for (operation in [0L, 1L, 2L]) {
                    val endpoint = LlmEndpoint(if (operation == 1L) Providers.openAiResponses() else Providers.geminiGenerateContent(), auth,
                        Some(if (operation == 2L) original.baseUrl.toBuilder().setEncodedPath("/").build() else original.baseUrl))
                    val finished = FinishedCalls()
                    val options = LlmCallOptions(onFinished = Some(suspend { value -> finished.record(value) }))
                    val error = expectLlmFailure<LlmRequestException> suspend {
                        if (operation == 0L) client.downloadFile(endpoint, "files/x", options)
                        else if (operation == 1L) client.registerFiles(endpoint, ["gs://bucket/x"], options)
                        else client.uploadFile(endpoint, LlmFileUpload("x", []), options)
                        Unit
                    }
                    assertEquals(if (operation == 2L) "/endpoint/baseUrl" else "/provider", error.path)
                    assertEquals(1L, finished.values.size)
                    assertEquals(0L, finished.values[0].attempts.size)
                }
            }
            assertEquals(0L, auth.requests.size)
        }
    }
}
