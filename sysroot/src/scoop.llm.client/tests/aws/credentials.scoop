package scoop.llm.client.tests.client

import scoop.asyncio.*
import scoop.llm.client.*
import scoop.test.*
import scoop.time.Duration
import scoop.url.Url

@Test
private class AwsSigV4CredentialsTest {
    @Test
    fun `AWS SigV4 credential failure and suspended cancellation keep requests unsent`() {
        val loop: EventLoop = LibuvEventLoop()
        loop.run suspend { _ ->
            withLlmClient suspend { client ->
                val finished = FinishedCalls()
                val failure = Exception(Some("credential source failed"))
                val auth = LlmAuth.awsSigV4("us-east-1", suspend { throw failure })
                val model = LlmEndpoint(Providers.bedrockConverse(), auth, Some(Url.parse("http://127.0.0.1:1"))).model("m")
                val error = expectLlmFailure<Exception> suspend {
                    client.generate(model, sampleRequest, LlmCallOptions(onFinished = Some(suspend { metadata -> finished.record(metadata) }))); Unit
                }
                assertSame(failure, error)
                assertEquals(None, finished.values[0L].attempts[0L].request.sentAt)
                expectLlmFailure<CancellationException> suspend {
                    coroutineScope suspend { scope ->
                        val entered = LlmGate()
                        val suspended = LlmAuth.awsSigV4("us-east-1", suspend { entered.signal(); currentEventLoop().sleep(Duration.seconds(60L)); awsExampleCredentials })
                        val pending = LlmEndpoint(Providers.bedrockConverse(), suspended, Some(model.endpoint.baseUrl)).model("m")
                        scope.launch suspend {
                            client.generate(pending, sampleRequest, LlmCallOptions(onFinished = Some(suspend { metadata -> finished.record(metadata) }))); Unit
                        }
                        entered.await()
                        scope.job.cancel()
                    }
                }
                assertEquals(2L, finished.values.size)
                assertEquals(LlmCallOutcome.Cancelled, finished.values[1L].outcome)
                assertEquals(None, finished.values[1L].attempts[0L].request.sentAt)
            }
        }
    }
}
