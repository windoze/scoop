package scoop.llm.client.tests.responses.session

import scoop.asyncio.*
import scoop.http.*
import scoop.http.asyncio.*
import scoop.llm.client.*
import scoop.llm.client.tests.client.*
import scoop.test.*
import scoop.time.Duration

@Test
private class ResponsesSessionHandshakeTest {
    @Test
    fun `Responses session handshake retries authenticated GET and reports only handshake timing`() {
        withLlmServer suspend { _, scope, listener, base ->
            val auth = RecordingAuth()
            val endpoint = LlmEndpoint(Providers.openAiResponses(), auth, Some(base.baseUrl))
            val done = LlmGate()
            val serving = scope.launch suspend {
                for (attempt in [1L, 2L]) {
                    AsyncHttp1Connection.takeOwnershipAsServer(listener.accept(), scope).useAsync suspend { connection ->
                        val request = connection.receiveRequest()!!
                        assertEquals(0L, request.body.readAllBytes(0L).size)
                        assertEquals("Bearer attempt-" + attempt.toString(),
                            String.fromUtf8(request.head.fields.findAll("Authorization".toByteArray())[0L].value))
                        val target = when (request.head.target) { case Http1(bytes) -> String.fromUtf8(bytes); else -> fail() }
                        assertEquals("/v1/responses", target)
                        if (attempt == 1L) sendLlmReply(connection, 429U, "{\"error\":{\"message\":\"busy\",\"code\":\"rate_limit_exceeded\"}}",
                            [HttpField("Connection".toByteArray(), "close".toByteArray())])
                        else {
                            val head = WebSocketHandshake.parse(request.head).response(
                                fields = [HttpField("x-request-id".toByteArray(), "handshake-2".toByteArray())])
                            connection.sendResponse(head).useAsync suspend { writer -> writer.finish() }
                            AsyncWebSocketSession.takeOwnership(connection.takeTransport(), scope, HttpRole.Server)
                                .useAsync suspend { _ -> done.await() }
                        }
                    }
                }
            }
            val finished = FinishedCalls()
            try {
                withLlmClient suspend { client ->
                    client.withResponsesSession(endpoint, LlmCallOptions(
                        retries = LlmRetryOptions(1L, Duration.ZERO, Duration.ZERO),
                        onFinished = Some(suspend { metadata -> finished.record(metadata) }))) suspend { session ->
                        assertEquals(2L, auth.requests.size)
                        for (request in auth.requests) {
                            assertEquals("GET", request.method)
                            assertEquals(0L, request.body.size)
                            assertEquals("http", request.url.scheme!!)
                        }
                        assertEquals(1L, finished.values.size)
                        assertSame(session.handshake, finished.values[0L])
                        val attempts = session.handshake.attempts
                        assertEquals(2L, attempts.size)
                        assertEquals(Some(429U), attempts[0L].status)
                        assertEquals(Some(101U), attempts[1L].status)
                        assertEquals(Some("handshake-2"), attempts[1L].requestId)
                        assertTrue(attempts[1L].request.sentAt != None && attempts[1L].response.receivedAt != None)
                        assertEquals(None, attempts[1L].responseId)
                        assertEquals(None, attempts[1L].usage.tokens.totalTokens)
                    }
                }
            } finally { done.signal() }
            serving.join()
        }
    }

    @Test
    fun `Responses session handshake callback failure closes the accepted socket`() {
        withResponsesPeer(suspend { socket -> socket.awaitClosed() }) suspend { _, _, endpoint ->
            withLlmClient suspend { client ->
                val failure = SessionCallbackFailure()
                val observed = expectLlmFailure<SessionCallbackFailure> suspend {
                    client.openResponsesSession(endpoint, LlmCallOptions(onFinished = Some(suspend { metadata ->
                        assertEquals(LlmCallOutcome.Completed, metadata.outcome)
                        throw failure
                    }))); Unit
                }
                assertTrue(observed === failure)
                assertFalse(client.isClosed)
            }
        }
    }
}

private class SessionCallbackFailure : Exception(Some("test callback failure"))
