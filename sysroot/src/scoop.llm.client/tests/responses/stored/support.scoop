package scoop.llm.client.tests.client

import scoop.json.*
import scoop.llm.client.*
import scoop.test.*

internal val storedResponseTools: Array<ToolDefinition> = [ClientFunction(ToolKey("count"), "count", Json.parse("{}")),
    Server(ToolKey("search"), WebSearch())]
internal val storedResponseOutput = "[" +
    "{\"type\":\"reasoning\",\"id\":\"reason\",\"summary\":[],\"encrypted_content\":\"opaque\"}," +
    "{\"type\":\"web_search_call\",\"id\":\"search\",\"status\":\"completed\",\"action\":{\"type\":\"search\",\"query\":\"topic\"}}," +
    "{\"type\":\"message\",\"id\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"output_text\",\"text\":\"ready\"}]}," +
    "{\"type\":\"function_call\",\"id\":\"function\",\"call_id\":\"call\",\"name\":\"count\",\"arguments\":\"{}\"}]"

internal fun storedResponseBody(status: String, output: String = "[]", id: String = "resp_actual"): String = Json.stringify(
    JsonObjectBuilder().add("object", JsonValue.fromString("response")).add("id", JsonValue.fromString(id))
        .add("model", JsonValue.fromString("actual-model")).add("created_at", JsonValue.fromLong(100L))
        .add("status", JsonValue.fromString(status)).add("output", Json.parse(output))
        .add("usage", if (status == "completed") Json.parse("{\"input_tokens\":9,\"output_tokens\":2,\"total_tokens\":11}") else JsonValue.nullValue())
        .build())

internal fun assertStoredOperationTiming(metadata: LlmCallMetadata, responseId: String = "resp_actual") {
    assertEquals(LlmCallOutcome.Completed, metadata.outcome)
    val attempt = metadata.attempts[metadata.attempts.size - 1L]
    assertEquals(Some(responseId), attempt.responseId)
    assertTrue(attempt.request.sentAt != None)
    assertTrue(attempt.response.receivedAt != None)
    assertTrue(attempt.response.completedAt != None)
    assertEquals(None, attempt.response.firstEventAt)
    assertEquals(None, attempt.response.firstOutputAt)
    assertEquals(None, attempt.response.firstTextAt)
    assertEquals(None, attempt.usage.tokens.inputTokens)
    assertEquals(None, attempt.usage.tokens.outputTokens)
    assertEquals(None, attempt.outputTokensPerSecond)
}
