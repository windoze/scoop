package scoop.llm.client.tests.ollama

import scoop.json.*
import scoop.llm.client.*
import scoop.test.*

@Test
private class OllamaUsageTest {
    @Test
    fun `Ollama exact token counts include cache while native server durations do not fabricate local timing`() {
        val raw = ollamaBody(extra = ",\"prompt_eval_count\":9007199254740993,\"prompt_eval_cached_count\":3,\"eval_count\":7," +
            "\"total_duration\":100,\"load_duration\":0,\"prompt_eval_duration\":40,\"eval_duration\":60,\"future\":1e400")
        val response = Json.decodeFromString<LlmResponse>(Json.encodeToString(ollamaDecode(raw)))
        val tokens = response.usage.tokens
        assertEquals(Some(9007199254740993L), tokens.inputTokens)
        assertEquals(Some(9007199254740990L), tokens.nonCachedInputTokens)
        assertEquals(Some(9007199254741000L), tokens.totalTokens)
        assertEquals(Some(3L), tokens.cacheReadTokens)
        assertEquals(None, tokens.cacheWriteTokens)
        assertEquals(None, tokens.reasoningTokens)
        assertEquals(0L, tokens.modality.size)
        assertEquals(7L, response.usage.native!!.size)
        assertFalse(response.usage.native!!.containsKey("message"))
        assertFalse(response.usage.native!!.containsKey("model"))
        assertEquals(0L, response.usage.native!!["load_duration"]!!.asLong())
        assertEquals(100L, response.usage.native!!["total_duration"]!!.asLong())
        assertEquals(None, response.createdAt)
        assertEquals("1e400", response.native!!["future"]!!.asNumberToken())
    }

    @Test
    fun `Ollama missing null and zero counters keep distinct accounting meanings`() {
        for (extra in ["", ",\"prompt_eval_count\":null,\"prompt_eval_cached_count\":null,\"eval_count\":null", ",\"total_duration\":100"]) {
            val response = ollamaDecode(ollamaBody(extra = extra))
            assertEquals(None, response.usage.tokens.totalTokens)
            assertEquals(None, response.usage.tokens.inputTokens)
            assertEquals(None, response.usage.tokens.nonCachedInputTokens)
            if (extra == "") assertFalse(llmPresent(response.usage.native))
        }
        val noCache = ollamaDecode(ollamaBody(extra = ",\"prompt_eval_count\":12,\"eval_count\":1")).usage.tokens
        assertEquals(None, noCache.nonCachedInputTokens)
        assertEquals(Some(13L), noCache.totalTokens)
        val noInput = OllamaChatDialect().readUsage(Json.parse("{\"prompt_eval_cached_count\":7}"))
        assertEquals(Some(7L), noInput.cacheReadTokens)
        assertEquals(None, noInput.inputTokens)
        val zero = OllamaChatDialect().readUsage(Json.parse("{\"prompt_eval_count\":0,\"prompt_eval_cached_count\":0,\"eval_count\":0}"))
        assertEquals(Some(0L), zero.nonCachedInputTokens)
        assertEquals(Some(0L), zero.totalTokens)
        assertEquals(Some(0L), zero.cacheReadTokens)
    }

    @Test
    fun `Ollama rejects invalid negative overflowing and inconsistent token reports at root paths`() {
        for ((extra, path) in [("\"prompt_eval_count\":-1", "prompt_eval_count"), ("\"prompt_eval_count\":1.5", "prompt_eval_count"),
            ("\"eval_count\":\"7\"", "eval_count"), ("\"eval_count\":9223372036854775808", "eval_count"),
            ("\"prompt_eval_cached_count\":-1", "prompt_eval_cached_count"),
            ("\"prompt_eval_count\":2,\"prompt_eval_cached_count\":3", "prompt_eval_cached_count"),
            ("\"prompt_eval_count\":9223372036854775807,\"eval_count\":1", "eval_count")])
            assertOllamaFailure(ollamaBody(extra = "," + extra), "/" + path)
    }
}
