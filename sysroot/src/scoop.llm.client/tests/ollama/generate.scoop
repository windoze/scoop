package scoop.llm.client.tests.client

import scoop.asyncio.*
import scoop.http.*
import scoop.http.asyncio.AsyncHttp1Connection
import scoop.json.*
import scoop.llm.client.*
import scoop.llm.client.tests.ollama.*
import scoop.test.*
import scoop.time.Instant
import scoop.url.Url

@Test
private class OllamaGenerateTest {
    @Test
    fun `Ollama generation mock verifies explicit stream mode deployed route cache usage history and timestamps`() {
        withLlmServer suspend { _, scope, listener, original ->
            val endpoint = LlmEndpoint(Providers.ollamaChat(), LlmAuth.none(),
                Some(Url.parse(original.baseUrl.toString() + "/ollama?deployment=test")))
            val reply = ollamaBody("ok", extra = ",\"created_at\":\"2026-10-25T00:00:00Z\",\"prompt_eval_count\":12,\"prompt_eval_cached_count\":8,\"eval_count\":1,\"total_duration\":1000")
            val serving = scope.launch suspend {
                AsyncHttp1Connection.takeOwnershipAsServer(listener.accept(), scope).useAsync suspend { connection ->
                    val request = connection.receiveRequest()!!
                    val target = when (request.head.target) { case Http1(bytes) -> String.fromUtf8(bytes); else -> fail() }
                    assertEquals("/v1/ollama/chat?deployment=test", target)
                    assertEquals(0L, request.head.fields.findAll("Authorization".toByteArray()).size)
                    val body = Json.parse(String.fromUtf8(request.body.readAllBytes(4096L)))
                    assertEquals(3L, body.size)
                    assertFalse(body["stream"]!!.asBoolean())
                    assertEquals("local:model", body["model"]!!.asString())
                    assertEquals("hello 世界", body["messages"]!![0L]["content"]!!.asString())
                    sendLlmReply(connection, 200U, Json.stringify(reply))
                }
            }
            withLlmClient suspend { client ->
                val result = client.generate(endpoint.model("local:model"), sampleRequest)
                assertEquals("ok", result.text)
                assertEquals(Some(12L), result.response.usage.tokens.inputTokens)
                assertEquals(Some(4L), result.response.usage.tokens.nonCachedInputTokens)
                assertEquals(Some(13L), result.response.usage.tokens.totalTokens)
                assertEquals(Some(Instant.parse("2026-10-25T00:00:00Z")), result.response.createdAt)
                assertEquals(LlmCallOutcome.Completed, result.metadata.outcome)
                assertEquals(1L, result.metadata.attempts.size)
                val attempt = result.metadata.attempts[0L]
                assertEquals(None, attempt.responseId)
                assertTrue(attempt.request.sentAt != None && attempt.response.receivedAt != None)
                assertTrue(attempt.response.completedAt != None)
                val saved = Json.decodeFromString<LlmResult>(Json.encodeToString(result))
                assertEquals(result.metadata.startedAt, saved.metadata.startedAt)
                assertEquals("assistant", ollamaEncode(LlmRequest(saved.toInput()))["messages"]!![0L]["role"]!!.asString())
            }
            serving.join()
        }
    }
}
