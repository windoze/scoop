package scoop.llm.client.tests.messages

import scoop.json.*
import scoop.llm.client.*
import scoop.test.*

@Test
private class MessagesStreamTextTest {
    @Test
    fun `Messages stream interleaves text thinking signatures and citations with stable locations`() {
        val decoder = messagesStream()
        messagesStartBlock(decoder, 0L, "{\"type\":\"thinking\",\"thinking\":\"a\",\"signature\":\"s\",\"future\":true}")
        messagesStartBlock(decoder, 1L, "{\"type\":\"text\",\"text\":\"hello\"}")
        val text = messagesDelta(decoder, 1L, "{\"type\":\"text_delta\",\"text\":\" world\"}")
        assertTrue(text.hasOutput); assertTrue(text.hasText)
        when (text.events[0L]) { case TextDelta(value) -> assertEquals(1L, value.location.itemIndex); else -> fail() }
        val thinking = messagesDelta(decoder, 0L, "{\"type\":\"thinking_delta\",\"thinking\":\"b\"}")
        assertTrue(thinking.hasOutput); assertFalse(thinking.hasText)
        messagesDelta(decoder, 0L, "{\"type\":\"signature_delta\",\"signature\":\"ig\"}")
        val citation = messagesDelta(decoder, 1L, "{\"type\":\"citations_delta\",\"citation\":{\"type\":\"web_search_result_location\",\"url\":\"https://example.com\",\"title\":\"source\",\"encrypted_index\":\"opaque\"}}")
        when (citation.events[0L]) {
            case Citation(location, part, value) -> {
                assertEquals(1L, location.itemIndex); assertEquals(0L, part)
                assertEquals("/content/1/citations/0", value.source.id)
                assertTrue(when (value.range) { case None -> true; case Some(_) -> false })
            }
            else -> fail()
        }
        messagesStopBlock(decoder, 1L); messagesStopBlock(decoder, 0L)
        messagesStartBlock(decoder, 2L, "{\"type\":\"redacted_thinking\",\"data\":\"opaque\"}")
        messagesStopBlock(decoder, 2L)
        messagesFinish(decoder)
        val response = Json.decodeFromString<LlmResponse>(Json.encodeToString(decoder.response()))
        assertEquals("hello world", response.text)
        assertEquals(Some("m1"), response.id); assertEquals(Some("actual"), response.model)
        val history = messagesHistory(response)["content"]!!
        assertEquals("ab", history[0L]["thinking"]!!.asString())
        assertEquals("sig", history[0L]["signature"]!!.asString())
        assertTrue(history[0L]["future"]!!.asBoolean())
        assertEquals("opaque", history[1L]["citations"]!![0L]["encrypted_index"]!!.asString())
        assertEquals("opaque", history[2L]["data"]!!.asString())
        assertTrue(when (response.native) { case None -> true; case Some(_) -> false })
        Json.decodeFromString<LlmStreamUpdate>(Json.encodeToString(citation))
    }

    @Test
    fun `Messages stream usage remains partial through candidate end and merges server totals`() {
        val decoder = messagesStream(usage = "{\"input_tokens\":5,\"cache_read_input_tokens\":3,\"output_tokens\":1,\"server_tool_use\":{\"web_search_requests\":1}}")
        assertTrue(decoder.usage.tokens.inputTokens == None)
        messagesStartBlock(decoder, 0L, "{\"type\":\"text\",\"text\":\"x\"}")
        messagesStopBlock(decoder, 0L)
        messagesEvent(decoder, "message_delta", "\"delta\":{\"stop_reason\":\"end_turn\"},\"usage\":{\"input_tokens\":7,\"cache_creation_input_tokens\":0,\"output_tokens\":4,\"server_tool_use\":{\"web_fetch_requests\":2}}")
        assertFalse(decoder.isFinished)
        assertEquals(UsageCompleteness.Partial, decoder.usage.completeness)
        assertEquals(Some(14L), decoder.usage.tokens.totalTokens)
        messagesEvent(decoder, "message_delta", "\"delta\":{\"stop_reason\":\"end_turn\"},\"usage\":{\"input_tokens\":null,\"output_tokens\":6}")
        messagesEvent(decoder, "message_stop")
        assertEquals(Some(16L), decoder.usage.tokens.totalTokens)
        assertEquals(UsageCompleteness.Final, decoder.usage.completeness)
        val raw = decoder.response().usage.native!!["server_tool_use"]!!
        assertEquals(1L, raw["web_search_requests"]!!.asLong()); assertEquals(2L, raw["web_fetch_requests"]!!.asLong())
    }

    @Test
    fun `Messages empty output and event-only retention preserve completion without inventing tokens`() {
        for (retention in [StreamRetention.Result, StreamRetention.EventsOnly]) {
            val decoder = messagesStream(retention, usage = "{}")
            assertTrue(messagesEvent(decoder, "ping").isKeepAlive)
            messagesFinish(decoder)
            assertTrue(decoder.isFinished)
            assertTrue(decoder.usage.tokens.totalTokens == None)
            if (retention == StreamRetention.Result) {
                assertEquals(0L, decoder.response().candidate(0L).items.size)
                assertEquals(0L, messagesHistory(decoder.response())["content"]!!.size)
            } else assertEquals(LlmOutputFailure.ResultNotRetained, assertFailsWith<LlmOutputException> { decoder.response(); Unit }.reason)
        }
    }
}
