package scoop.llm.client.tests.client

import scoop.asyncio.*
import scoop.http.*
import scoop.http.asyncio.AsyncHttp1Connection
import scoop.llm.client.*
import scoop.platform.memory.NativeByteBuffer
import scoop.platform.net.*
import scoop.test.*
import scoop.url.Url

internal val sampleRequest = LlmRequest([Message([Text("hello 世界")])])
internal val sampleReply = "{\"id\":\"answer-1\",\"choices\":[{\"index\":0,\"message\":{\"role\":\"assistant\",\"content\":\"hello\"},\"finish_reason\":\"stop\"}],\"usage\":{\"prompt_tokens\":8,\"completion_tokens\":3,\"total_tokens\":11}}"

internal fun withLlmServer(block: suspend (EventLoop, CoroutineScope, AsyncTcpListener, LlmEndpoint) -> Unit) {
    val loop: EventLoop = LibuvEventLoop()
    loop.run suspend { scope ->
        loop.listenTcp(SocketAddress(IpAddress.IPV4_LOOPBACK, 0)).useAsync suspend { listener ->
            val url = Url.parse("http://127.0.0.1:" + listener.localAddress.port.toString() + "/v1")
            block(loop, scope, listener, LlmEndpoint(Providers.openAiChat(), LlmAuth.none(), Some(url)))
        }
    }
}

internal suspend fun sendLlmReply(connection: AsyncHttp1Connection, status: UInt, body: String, fields: Array<HttpField> = []) {
    val bytes = body.toByteArray()
    connection.sendResponse(HttpResponseHead(HttpVersion.Http11, status, Some("test".toByteArray()), fields),
        Http1BodyFraming.Length(bytes.size)).useAsync suspend { output ->
        NativeByteBuffer.allocate(bytes.size).use suspend { buffer ->
            buffer.writeBytes(bytes)
            output.writeFully(buffer)
        }
        output.finish()
    }
}

internal suspend fun <E : Throwable> expectLlmFailure(block: suspend () -> Unit): E {
    try { block() }
    catch (error: Throwable) { if (error is E) return error; throw error }
    fail(Some("expected LLM failure"))
}

internal class FinishedCalls {
    val values = ArrayList<LlmCallMetadata>()
    suspend fun record(value: LlmCallMetadata) { values.add(value) }
}

internal fun assertLlmBytes(expected: Array<Byte>, actual: Array<Byte>) {
    assertEquals(expected.size, actual.size)
    var index = 0L
    while (index < expected.size) { assertEquals(expected[index], actual[index]); index += 1L }
}

internal class LlmGate {
    private var ready = false
    private var waiting: Continuation<Unit>? = None
    fun signal() {
        ready = true
        val current = waiting
        waiting = None
        current?.resume(Unit)
    }
    suspend fun await() {
        suspendCoroutine<Unit> { continuation ->
            if (ready) continuation.resume(Unit) else waiting = Some(continuation)
        }
    }
}

internal class RecordingAuth : LlmAuth {
    val requests = ArrayList<LlmAuthRequest>()
    public override suspend fun fields(request: LlmAuthRequest): Array<HttpField> {
        requests.add(request)
        return [HttpField("Authorization".toByteArray(), ("Bearer attempt-" + requests.size.toString()).toByteArray())]
    }
}
