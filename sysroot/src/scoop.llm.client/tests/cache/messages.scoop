package scoop.llm.client.tests.cache

import scoop.json.*
import scoop.llm.client.*
import scoop.test.*
import scoop.time.Duration

@Test
private class MessagesCacheTest {
    @Test
    fun `cache lifetime Messages splits reported writes without extending every breakpoint from total reads`() {
        val reports = messagesCacheReports("{\"input_tokens\":1,\"output_tokens\":1,\"cache_read_input_tokens\":20,\"cache_creation_input_tokens\":10,\"cache_creation\":{\"ephemeral_5m_input_tokens\":4,\"ephemeral_1h_input_tokens\":6}}")
        assertEquals(3L, reports.size)
        assertEquals(CacheOperation.Read, reports[0L].operation)
        assertEquals(Some(20L), reports[0L].tokens)
        assertEquals(Some(true), reports[0L].refreshesLifetime)
        assertEquals(CacheLifetimeKind.MinimumRetention, reports[0L].lifetimes[0L].kind)
        assertEquals(CacheScope.Unknown, reports[0L].scope)
        assertEquals(Some(4L), reports[1L].tokens)
        assertEquals(Duration.minutes(5L), reports[1L].lifetimes[0L].duration)
        assertEquals(CacheLifetimeKind.Expiration, reports[1L].lifetimes[0L].kind)
        assertEquals(Some(6L), reports[2L].tokens)
        assertEquals(Duration.hours(1L), reports[2L].lifetimes[0L].duration)
        assertEquals(CacheLifetimeAnchor.RequestStart, reports[2L].lifetimes[0L].anchor)
    }

    @Test
    fun `cache lifetime Messages keeps missing partial and future write buckets conservative`() {
        assertEquals(0L, messagesCacheReports("{}").size)
        val zero = messagesCacheReports("{\"cache_read_input_tokens\":0,\"cache_creation_input_tokens\":0}")
        assertEquals(Some(0L), zero[0L].tokens)
        assertEquals(Some(0L), zero[1L].tokens)
        for (details in ["{\"ephemeral_5m_input_tokens\":4}", "{\"ephemeral_5m_input_tokens\":4,\"ephemeral_1h_input_tokens\":5}",
            "{\"ephemeral_5m_input_tokens\":-1,\"ephemeral_1h_input_tokens\":11}", "{\"ephemeral_5m_input_tokens\":0.5,\"ephemeral_1h_input_tokens\":9}"]) {
            val reports = messagesCacheReports("{\"cache_creation_input_tokens\":10,\"cache_creation\":" + details + "}")
            assertEquals(1L, reports.size)
            assertEquals(Some(10L), reports[0L].tokens)
            assertEquals(CacheLifetimeKind.MinimumRetention, reports[0L].lifetimes[0L].kind)
        }
        val future = messagesCacheReports("{\"cache_read_input_tokens\":2,\"cache_creation_input_tokens\":10,\"cache_creation\":{\"future_ttl_input_tokens\":10}}")
        assertEquals(0L, future[0L].lifetimes.size)
        assertEquals(0L, future[1L].lifetimes.size)
    }

    @Test
    fun `cache lifetime other dialects report known cache amounts without borrowing service rules`() {
        val usage = LlmUsage(TokenUsage(cacheReadTokens = Some(0L), cacheWriteTokens = Some(7L)))
        for (provider in [Providers.deepSeekChat(), Providers.geminiGenerateContent(), Providers.geminiInteractions(), Providers.ollamaChat()]) {
            val protocol = provider.protocol
            val reports = protocol.cacheObserver(Json.parse("{\"prompt_cache_options\":{\"ttl\":\"12h\"}}")).observe(usage)
            assertEquals(2L, reports.size)
            assertEquals(protocol.dialectId, reports[0L].dialect)
            assertEquals(Some(0L), reports[0L].tokens)
            assertEquals(0L, reports[0L].lifetimes.size)
            assertEquals(None, reports[1L].reportedExpiresAt)
            assertEquals(0L, reports[1L].lifetimes.size)
        }
    }
}

private fun messagesCacheReports(usage: String): Array<CacheReport> {
    val protocol = Providers.anthropicMessages().protocol
    val request = LlmRequest([Message([Text("q")])])
    val response = protocol.decodeResponse(Json.parse("{\"type\":\"message\",\"role\":\"assistant\",\"content\":[],\"stop_reason\":\"end_turn\",\"usage\":" + usage + "}"), request)
    return protocol.cacheObserver(protocol.encodeRequest("model", request)).observe(response.usage)
}
