package scoop.llm.client.tests.cache

import scoop.json.Json
import scoop.llm.client.*
import scoop.test.*
import scoop.time.*

@Test
private class CacheEstimateTest {
    @Test
    fun `cache lifetime estimates preserve the request origin and monotonic intervals across wall clock rollback`() {
        val sent = LlmTimePoint(Instant.parse("2026-10-25T10:00:00Z"), Duration.seconds(2L))
        val observed = LlmTimePoint(Instant.parse("2026-10-25T09:00:00Z"), Duration.minutes(4L) + sent.elapsed)
        val report = CacheReport("written", AnthropicMessagesDialect().id, Write, Some(100L),
            lifetimes = [CacheLifetime(Duration.minutes(5L), Expiration, RequestStart)])
        val attempt = LlmAttemptMetadata(1L, LlmRequestTiming(Some(sent)), cacheObservations = [CacheObservation(report, observed)])
        val estimate = Json.decodeFromString<CacheLifetimeEstimate>(Json.encodeToString(attempt.estimateCacheLifetime(0L)!!))
        assertEquals(Instant.parse("2026-10-25T10:05:00Z"), estimate.earliestAt)
        assertEquals(Instant.parse("2026-10-25T10:09:00Z"), estimate.latestAt)
        assertEquals(observed.at, estimate.observed.at)
        val (early, late) = estimate.remainingAtOffset(observed.elapsed)
        assertEquals(Duration.minutes(1L), early)
        assertEquals(Duration.minutes(5L), late)
        val (expired, latest) = estimate.remainingAtOffset(sent.elapsed + Duration.minutes(10L))
        assertEquals(Duration.minutes(-5L), expired)
        assertEquals(Duration.minutes(-1L), latest)
        val (wallEarly, wallLate) = estimate.remainingAtInstant(Instant.parse("2026-10-25T10:04:00Z"))
        assertEquals(early, wallEarly); assertEquals(late, wallLate)
    }

    @Test
    fun `cache lifetime does not invent a write timestamp from a read or a missing positive count`() {
        val point = LlmTimePoint(Instant.fromEpochSeconds(100L), Duration.seconds(1L))
        val dialect = OpenAiResponsesDialect().id
        val maximum = CacheLifetime(Duration.hours(24L), MaximumRetention, Write)
        for (count in [None, Some(0L), Some(2L)]) {
            val report = CacheReport("read", dialect, Read, count, lifetimes = [maximum])
            val attempt = LlmAttemptMetadata(1L, LlmRequestTiming(Some(point)), cacheObservations = [CacheObservation(report, point)])
            assertFalse(llmPresent(attempt.estimateCacheLifetime(0L)))
        }
        for (count in [None, Some(0L)]) {
            val report = CacheReport("written", dialect, Write, count, lifetimes = [maximum])
            val attempt = LlmAttemptMetadata(1L, LlmRequestTiming(Some(point)), cacheObservations = [CacheObservation(report, point)])
            assertFalse(llmPresent(attempt.estimateCacheLifetime(0L)))
        }
        val report = CacheReport("written", dialect, Write, Some(2L), lifetimes = [maximum])
        assertFalse(llmPresent(LlmAttemptMetadata(1L, cacheObservations = [CacheObservation(report, point)]).estimateCacheLifetime(0L)))
        val unknown = CacheReport("unknown", dialect, Write, Some(2L), lifetimes = [CacheLifetime(Duration.minutes(30L), TypicalRetention, Unknown)])
        assertFalse(llmPresent(LlmAttemptMetadata(1L, LlmRequestTiming(Some(point)), cacheObservations = [CacheObservation(unknown, point)]).estimateCacheLifetime(0L)))
    }

    @Test
    fun `cache lifetime codecs preserve reported expiration scope zero and old metadata defaults`() {
        val at = Instant.fromEpochSeconds(100L)
        val point = LlmTimePoint(at, Duration.ZERO)
        val report = CacheReport("read", AnthropicMessagesDialect().id, Read, Some(0L), CacheScope.Resource("cached-resource"),
            reportedExpiresAt = Some(at + Duration.hours(1L)))
        val saved = Json.decodeFromString<LlmAttemptMetadata>(Json.encodeToString(LlmAttemptMetadata(1L,
            LlmRequestTiming(Some(point)), cacheObservations = [CacheObservation(report, point)])))
        assertEquals(Some(0L), saved.cacheObservations[0L].report.tokens)
        assertEquals(CacheScope.Resource("cached-resource"), saved.cacheObservations[0L].report.scope)
        assertEquals(report.reportedExpiresAt, saved.cacheObservations[0L].report.reportedExpiresAt)
        assertFalse(llmPresent(saved.estimateCacheLifetime(0L)))
        assertEquals(0L, Json.decodeFromString<LlmAttemptMetadata>("{\"number\":1}").cacheObservations.size)
    }

    @Test
    fun `cache lifetime rejects reversed rules and declines out of range estimates`() {
        assertFailsWith<IllegalArgumentException> { val rule = CacheLifetime(Duration.seconds(-1L), Expiration, RequestStart); Unit }
        assertFailsWith<IllegalArgumentException> {
            val rule = CacheLifetime(Duration.minutes(5L), TypicalRetention, Read, Some(Duration.minutes(4L))); Unit
        }
        val point = LlmTimePoint(Instant.MAX, Duration.ZERO)
        val report = CacheReport("written", AnthropicMessagesDialect().id, Write, Some(1L),
            lifetimes = [CacheLifetime(Duration.seconds(1L), Expiration, RequestStart)])
        val attempt = LlmAttemptMetadata(1L, LlmRequestTiming(Some(point)), cacheObservations = [CacheObservation(report, point)])
        assertFalse(llmPresent(attempt.estimateCacheLifetime(0L)))
    }
}
