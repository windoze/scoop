package scoop.llm.client.tests.client

import scoop.asyncio.*
import scoop.http.*
import scoop.http.asyncio.AsyncHttp1Connection
import scoop.json.*
import scoop.llm.client.*
import scoop.llm.client.tests.converse.*
import scoop.test.*
import scoop.url.Url

@Test
private class ConverseGenerateTest {
    @Test
    fun `Converse generation mock verifies deployment model path bearer auth usage and actual timestamps`() {
        withLlmServer suspend { _, scope, listener, original ->
            val endpoint = LlmEndpoint(Providers.bedrockConverse(), LlmAuth.bearer("mock-only"),
                Some(Url.parse(original.baseUrl.toString() + "/proxy?deployment=test")))
            val reply = converseBody("[{\"text\":\"ok\"}]", usage = Some(
                "{\"inputTokens\":5,\"cacheReadInputTokens\":3,\"cacheWriteInputTokens\":2,\"outputTokens\":1,\"totalTokens\":11}"))
            val serving = scope.launch suspend {
                AsyncHttp1Connection.takeOwnershipAsServer(listener.accept(), scope).useAsync suspend { connection ->
                    val request = connection.receiveRequest()!!
                    val target = when (request.head.target) { case Http1(bytes) -> String.fromUtf8(bytes); else -> fail() }
                    assertEquals("/v1/proxy/model/unlisted%2Fmodel%3Aversion/converse?deployment=test", target)
                    assertEquals("Bearer mock-only", String.fromUtf8(request.head.fields.findAll("Authorization".toByteArray())[0L].value))
                    val body = Json.parse(String.fromUtf8(request.body.readAllBytes(4096L)))
                    assertEquals(1L, body.size)
                    assertEquals("hello 世界", body["messages"]!![0L]["content"]!![0L]["text"]!!.asString())
                    sendLlmReply(connection, 200U, Json.stringify(reply))
                }
            }
            withLlmClient suspend { client ->
                val result = client.generate(endpoint.model("unlisted/model:version"), sampleRequest)
                assertEquals("ok", result.text)
                assertEquals(Some(10L), result.response.usage.tokens.inputTokens)
                assertEquals(Some(5L), result.response.usage.tokens.nonCachedInputTokens)
                assertEquals(Some(11L), result.response.usage.tokens.totalTokens)
                assertEquals(LlmCallOutcome.Completed, result.metadata.outcome)
                assertEquals(1L, result.metadata.attempts.size)
                val attempt = result.metadata.attempts[0L]
                assertEquals(None, attempt.responseId)
                assertTrue(attempt.request.sentAt != None && attempt.response.receivedAt != None)
                assertTrue(attempt.response.completedAt != None)
                val saved = Json.decodeFromString<LlmResult>(Json.encodeToString(result))
                assertEquals(result.metadata.startedAt, saved.metadata.startedAt)
                when (saved.toInput()[0L]) { case History(value) -> assertEquals(1L, value.items.size); else -> fail() }
            }
            serving.join()
        }
    }
}
