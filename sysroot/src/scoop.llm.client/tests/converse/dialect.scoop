package scoop.llm.client.tests.converse

import scoop.json.JsonValue
import scoop.llm.client.*
import scoop.test.*

@Test
private class ConverseDialectTest {
    @Test
    fun `Converse service interpretation stays bound to its protocol and explicit system tool names`() {
        val dialect = BedrockConverseDialect()
        assertEquals(ApiProtocolId("converse"), dialect.id.protocol)
        assertEquals(ServerToolKind.WebSearch, dialect.serverToolKind("nova_grounding"))
        assertEquals(ServerToolKind.CodeExecution, dialect.serverToolKind("nova_code_interpreter"))
        assertEquals(ServerToolKind.Native, dialect.serverToolKind("future_tool"))
        assertEquals(Some("nova_code_interpreter"), dialect.serverResultName("nova_code_interpreter_result"))
        assertEquals(None, dialect.serverResultName("unknown_result"))
        assertFailsWith<IllegalArgumentException> { val protocol = ConverseProtocol(ForeignConverseDialect()); Unit }
    }
}

private class ForeignConverseDialect : ConverseDialect {
    public override val id: DialectId = GeminiInteractionsDialect().id
    public override fun readUsage(value: JsonValue): TokenUsage = TokenUsage()
}
