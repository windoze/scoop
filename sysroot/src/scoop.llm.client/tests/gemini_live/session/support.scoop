package scoop.llm.client.tests.geminilive.session

import scoop.asyncio.*
import scoop.http.*
import scoop.http.asyncio.*
import scoop.json.*
import scoop.llm.client.*
import scoop.llm.client.tests.client.*
import scoop.platform.net.*
import scoop.test.*
import scoop.url.Url

internal fun withLivePeer(peer: suspend (AsyncWebSocketSession, JsonValue) -> Unit,
    block: suspend (EventLoop, CoroutineScope, LlmEndpoint) -> Unit, confirm: Boolean = true) {
    val loop: EventLoop = LibuvEventLoop()
    loop.run suspend { scope ->
        loop.listenTcp(SocketAddress(IpAddress.IPV4_LOOPBACK, 0)).useAsync suspend { listener ->
            val done = LlmGate()
            val serving = scope.launch suspend {
                AsyncHttp1Connection.takeOwnershipAsServer(listener.accept(), scope).useAsync suspend { connection ->
                    val request = connection.receiveRequest()!!
                    assertEquals(0L, request.body.readAllBytes(0L).size)
                    val target = when (request.head.target) { case Http1(bytes) -> String.fromUtf8(bytes); else -> fail() }
                    assertEquals("/custom/live?route=one", target)
                    connection.sendResponse(WebSocketHandshake.parse(request.head).response()).useAsync suspend { writer -> writer.finish() }
                    AsyncWebSocketSession.takeOwnership(connection.takeTransport(), scope, HttpRole.Server).useAsync suspend { socket ->
                        val setup = readLiveCommand(socket)
                        assertEquals(1L, setup.size)
                        assertTrue(setup.containsKey("setup"))
                        if (confirm) socket.sendBinary("{\"setupComplete\":{\"sessionId\":\"server-session\"},\"future\":[false,null]}".toByteArray())
                        peer(socket, setup)
                        done.await()
                    }
                }
            }
            val endpoint = LlmEndpoint(Providers.geminiLive(), LlmAuth.none(),
                Some(Url.parse("http://127.0.0.1:" + listener.localAddress.port.toString() + "/custom/live?route=one")))
            try { block(loop, scope, endpoint) }
            finally { done.signal() }
            serving.join()
        }
    }
}

internal suspend fun readLiveCommand(socket: AsyncWebSocketSession): JsonValue =
    socket.receive()!!.useAsync suspend { message -> Json.parse(message.readText()) }

internal fun livePrimaryFailure(error: Throwable): Throwable =
    if (error is ResourceUseException) livePrimaryFailure(error.primaryFailure) else error
