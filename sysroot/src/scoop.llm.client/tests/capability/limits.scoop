package scoop.llm.client

import scoop.json.Json
import scoop.test.*

@Test
private class CapabilityLimitsTest {
    @Test
    fun `ULong limits preserve the full range zero and unknown values`() {
        val original = MediaLimits(maxBytesPerItem = Some(ULong.MAX_VALUE), maxItemsPerRequest = Some(0UL),
            maxDurationMillisecondsPerItem = Some(120000UL), maxWidthPixels = Some(4096UL))
        val limits = Json.decodeFromString<MediaLimits>(Json.encodeToString(original))
        assertEquals(Some(ULong.MAX_VALUE), limits.maxBytesPerItem)
        assertEquals(Some(0UL), limits.maxItemsPerRequest)
        assertEquals(Some(120000UL), limits.maxDurationMillisecondsPerItem)
        assertEquals(Some(4096UL), limits.maxWidthPixels)
        assertEquals(None, limits.maxPagesPerItem)
        assertEquals(None, limits.maxHeightPixels)
        val model = Json.decodeFromString<ModelLimits>(Json.encodeToString(ModelLimits(
            contextWindowTokens = Some(ULong.MAX_VALUE), maxInputTokens = Some(9223372036854775808UL), maxOutputTokens = Some(0UL))))
        assertEquals(Some(0UL), model.maxOutputTokens)
        assertEquals(Some(ULong.MAX_VALUE), model.contextWindowTokens)
        assertEquals(Some(9223372036854775808UL), model.maxInputTokens)
        assertEquals(None, model.maxCandidates)
    }

    @Test
    fun `ULong limits reject negative and overflowing JSON at decoding`() {
        for (number in ["-1", "18446744073709551616"]) {
            val mediaError = assertFailsWith<DecodingException> {
                val invalid = Json.decodeFromString<MediaLimits>("{\"maxBytesPerItem\":" + number + "}"); Unit
            }
            assertEquals("/maxBytesPerItem", mediaError.path)
            val modelError = assertFailsWith<DecodingException> {
                val invalid = Json.decodeFromString<ModelCapabilities>("{\"limits\":{\"maxCandidates\":" + number + "}}"); Unit
            }
            assertEquals("/limits/maxCandidates", modelError.path)
        }
    }
}
