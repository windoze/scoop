package scoop.llm.client.tests.interactions.stored

import scoop.asyncio.*
import scoop.http.*
import scoop.http.asyncio.AsyncHttp1Connection
import scoop.http.client.*
import scoop.json.*
import scoop.llm.client.*
import scoop.llm.client.tests.client.*
import scoop.llm.client.tests.interactions.*
import scoop.test.*
import scoop.url.Url

@Test
private class StoredInteractionsNetworkTest {
    @Test
    fun `stored Interactions mock creates reads cancels and deletes with saved tools and actual timing`() {
        withLlmServer suspend { _, scope, listener, original ->
            val auth = RecordingAuth()
            val endpoint = LlmEndpoint(Providers.geminiInteractions(), auth,
                Some(Url.parse(original.baseUrl.toString() + "/gateway?tenant=a%2Fb&flag")))
            val methods = ["POST", "GET", "POST", "DELETE"]
            val serving = scope.launch suspend {
                AsyncHttp1Connection.takeOwnershipAsServer(listener.accept(), scope).useAsync suspend { connection ->
                    for (index in [0L, 1L, 2L, 3L]) {
                        val incoming = connection.receiveRequest()!!
                        val target = when (incoming.head.target) { case Http1(bytes) -> String.fromUtf8(bytes); else -> fail() }
                        val suffix = if (index == 0L) "" else "/interaction-1" + (if (index == 2L) "/cancel" else "")
                        assertEquals("/v1/gateway/interactions" + suffix + "?tenant=a%2Fb&flag", target)
                        assertEquals(methods[index], String.fromUtf8(incoming.head.method))
                        assertEquals("Bearer attempt-" + (index + 1L).toString(),
                            String.fromUtf8(incoming.head.fields.findAll("Authorization".toByteArray())[0].value))
                        val bytes = incoming.body.readAllBytes(8192L)
                        if (index == 0L) assertTrue(Json.parse(String.fromUtf8(bytes))["background"]!!.asBoolean())
                        else {
                            assertEquals(0L, bytes.size)
                            assertEquals(0L, incoming.head.fields.findAll("Content-Type".toByteArray()).size)
                        }
                        assertLlmBytes(bytes, auth.requests[index].body)
                        assertEquals(methods[index], auth.requests[index].method)
                        assertEquals(target, auth.requests[index].url.httpRequestTarget())
                        val body = when (index) {
                            case 0L -> storedInteractionBody("in_progress", Some("[]"))
                            case 1L -> storedInteractionBody("requires_action", Some(storedInteractionSteps))
                            case 2L -> storedInteractionBody("cancelled")
                            else -> ""
                        }
                        sendLlmReply(connection, 200U, body)
                    }
                }
            }
            val observations = ArrayList<HttpAttemptMetrics>()
            HttpClient.open(scope, HttpClientConfig(observer = Some(HttpObserver(suspend { event ->
                if (event.kind == HttpCallEventKind.Completed) observations.add(event.metrics)
            })))).useAsync suspend { http ->
                val finished = FinishedCalls()
                val options = LlmCallOptions(onFinished = Some(suspend { metadata -> finished.record(metadata) }))
                withLlmClient(Some(http)) suspend { client ->
                    val created = client.generate(endpoint.model("caller-model"), LlmRequest(sampleRequest.input,
                        extensions = [DialectExtension(endpoint.provider.protocol.dialectId, Json.parse("{\"background\":true}"))]), options)
                    assertEquals(LlmCompletion.Incomplete, created.response.candidate(0L).completion)
                    val fetched = client.retrieveInteraction(endpoint, created.response.id!!, interactionsRequest().tools, options)
                    val restored = Json.decodeFromString<LlmResult>(Json.encodeToString(fetched))
                    assertEquals("ready", restored.text)
                    assertEquals(Some(11L), restored.response.usage.tokens.totalTokens)
                    assertEquals(1L, restored.clientToolCalls.size)
                    val input = ArrayList<LlmInputItem>()
                    for (item in restored.toInput()) input.add(item)
                    input.add(ToolResult(restored.clientToolCalls[0].reference, [Text("found")]))
                    val replay = endpoint.provider.protocol.encodeRequest("next-model", LlmRequest(input.toArray(), tools = interactionsRequest().tools))
                    assertEquals("opaque", replay["input"]!![0]["signature"]!!.asString())
                    assertEquals("call-1", replay["input"]!![3]["call_id"]!!.asString())
                    val cancelled = client.cancelInteraction(endpoint, created.response.id!!, options = options)
                    assertEquals(LlmCompletion.Incomplete, cancelled.response.candidate(0L).completion)
                    assertEquals(0L, cancelled.clientToolCalls.size)
                    assertTrue(when (cancelled.response.candidate(0L).history) { case None -> true; else -> false })
                    val deleted = Json.decodeFromString<InteractionsDeletionResult>(
                        Json.encodeToString(client.deleteInteraction(endpoint, created.response.id!!, options)))
                    assertEquals(0L, deleted.native.size)
                    for (metadata in [restored.metadata, cancelled.metadata]) assertInteractionOperationTiming(metadata)
                    assertInteractionOperationTiming(deleted.metadata, None)
                    assertEquals(4L, finished.values.size)
                    for (index in [0L, 1L, 2L, 3L]) {
                        assertEquals(observations[index].requestHeadersAtUtc, finished.values[index].attempts[0].request.sentAt)
                        assertEquals(observations[index].finalResponseHeadersAtUtc, finished.values[index].attempts[0].response.receivedAt)
                    }
                }
                assertFalse(http.isClosed)
            }
            serving.join()
        }
    }
}
