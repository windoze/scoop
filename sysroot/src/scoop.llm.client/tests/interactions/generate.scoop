package scoop.llm.client.tests.client

import scoop.asyncio.*
import scoop.http.*
import scoop.http.asyncio.AsyncHttp1Connection
import scoop.json.*
import scoop.llm.client.*
import scoop.llm.client.tests.interactions.*
import scoop.test.*
import scoop.url.Url

@Test
private class InteractionsGenerateTest {
    @Test
    fun `Interactions generation mock verifies deployment auth exact request usage and actual timestamps`() {
        withLlmServer suspend { _, scope, listener, original ->
            val endpoint = LlmEndpoint(Providers.geminiInteractions(), LlmAuth.header("x-goog-api-key", "mock-only"),
                Some(Url.parse(original.baseUrl.toString() + "/proxy?deployment=test")))
            val reply = interactionsBody("[{\"type\":\"model_output\",\"content\":[{\"type\":\"text\",\"text\":\"ok\"}]}]",
                usage = Some("{\"total_input_tokens\":5,\"total_output_tokens\":2,\"total_thought_tokens\":0,\"total_tokens\":7}"))
            val serving = scope.launch suspend {
                AsyncHttp1Connection.takeOwnershipAsServer(listener.accept(), scope).useAsync suspend { connection ->
                    val request = connection.receiveRequest()!!
                    val target = when (request.head.target) { case Http1(bytes) -> String.fromUtf8(bytes); else -> fail() }
                    assertEquals("/v1/proxy/interactions?deployment=test", target)
                    assertEquals("mock-only", String.fromUtf8(request.head.fields.findAll("x-goog-api-key".toByteArray())[0L].value))
                    val body = Json.parse(String.fromUtf8(request.body.readAllBytes(4096L)))
                    assertEquals(2L, body.size)
                    assertEquals("unlisted/model:version", body["model"]!!.asString())
                    assertEquals("user_input", body["input"]!![0L]["type"]!!.asString())
                    sendLlmReply(connection, 200U, Json.stringify(reply))
                }
            }
            withLlmClient suspend { client ->
                val result = client.generate(endpoint.model("unlisted/model:version"), sampleRequest)
                assertEquals("ok", result.text)
                assertEquals(Some(7L), result.response.usage.tokens.totalTokens)
                assertEquals(LlmCallOutcome.Completed, result.metadata.outcome)
                assertEquals(1L, result.metadata.attempts.size)
                val attempt = result.metadata.attempts[0L]
                assertEquals(Some("interaction-1"), attempt.responseId)
                assertTrue(attempt.request.sentAt != None && attempt.response.receivedAt != None)
                assertTrue(attempt.response.completedAt != None)
                val saved = Json.decodeFromString<LlmResult>(Json.encodeToString(result))
                assertEquals(result.response.createdAt, saved.response.createdAt)
                when (saved.toInput()[0L]) { case History(value) -> assertEquals(1L, value.items.size); else -> fail() }
            }
            serving.join()
        }
    }
}
