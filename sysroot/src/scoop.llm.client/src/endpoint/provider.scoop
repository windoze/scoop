package scoop.llm.client

import scoop.url.Url

/** A named, fixed protocol/dialect combination; credentials belong to the endpoint. */
public class LlmProvider public constructor(
    public val name: String,
    public val protocol: LlmGenerationProtocol,
    public val defaultBaseUrl: Url? = None
)

/** Common combinations and deployment defaults, without a model-name router. */
public object Providers {
    public fun ollamaChat(): LlmProvider = LlmProvider("ollama-chat", OllamaChatProtocol(OllamaChatDialect()),
        Some(Url.parse("http://localhost:11434/api")))
    public fun cohereChat(): LlmProvider = LlmProvider("cohere-chat-v2", CohereChatProtocol(CohereChatDialect()),
        Some(Url.parse("https://api.cohere.com/v2")))
    public fun bedrockConverse(): LlmProvider = LlmProvider("bedrock-converse", ConverseProtocol(BedrockConverseDialect()))
    public fun geminiInteractions(): LlmProvider = LlmProvider("gemini-interactions",
        InteractionsProtocol(GeminiInteractionsDialect()), Some(Url.parse("https://generativelanguage.googleapis.com/v1")))
    public fun geminiGenerateContent(): LlmProvider = LlmProvider("gemini-generate-content",
        GenerateContentProtocol(GeminiGenerateContentDialect()), Some(Url.parse("https://generativelanguage.googleapis.com/v1beta")))
    public fun openAiResponses(): LlmProvider = LlmProvider("openai-responses", ResponsesProtocol(OpenAiResponsesDialect()),
        Some(Url.parse("https://api.openai.com/v1")))
    public fun openAiChat(): LlmProvider = LlmProvider("openai-chat", ChatProtocol(OpenAiChatDialect()),
        Some(Url.parse("https://api.openai.com/v1")))
    public fun deepSeekChat(topPMode: DeepSeekTopPMode = Unknown): LlmProvider = LlmProvider("deepseek-chat", ChatProtocol(DeepSeekChatDialect(topPMode)),
        Some(Url.parse("https://api.deepseek.com")))
    public fun anthropicMessages(version: AnthropicMessagesVersion = V20261021, defaultMaxOutputTokens: Long = 4096L): LlmProvider =
        LlmProvider("anthropic-messages", MessagesProtocol(AnthropicMessagesDialect(version, defaultMaxOutputTokens)),
            Some(Url.parse("https://api.anthropic.com/v1")))
}
