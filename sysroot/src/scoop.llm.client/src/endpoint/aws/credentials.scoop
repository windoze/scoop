package scoop.llm.client

import scoop.http.HttpField
import scoop.platform.time.SystemClock

/** One application-supplied credential snapshot; intentionally not serializable. */
public class AwsSigV4Credentials public constructor(
    public val accessKeyId: String,
    public val secretAccessKey: String,
    public val sessionToken: String? = None
) {
    init {
        requireAwsScopePart(accessKeyId)
        if (secretAccessKey.length == 0L || sessionToken == Some(""))
            throw IllegalArgumentException(Some("AWS credentials must not be empty"))
    }
}

internal class AwsSigV4LlmAuth(val region: String, val credentials: suspend () -> AwsSigV4Credentials,
    val service: String) : LlmAuth {
    init { requireAwsScopePart(region); requireAwsScopePart(service) }

    public override suspend fun fields(request: LlmAuthRequest): Array<HttpField> {
        val current = credentials()
        return signAwsLlmRequest(request, current, region, service, SystemClock.now())
    }
}

private fun requireAwsScopePart(value: String) {
    if (value.length == 0L) throw IllegalArgumentException(Some("AWS credential scope component must not be empty"))
    for (character in value) {
        if (character.code < 33 || character.code > 126 || character == '/' || character == ',' || character == '=')
            throw IllegalArgumentException(Some("invalid AWS credential scope component"))
    }
}
