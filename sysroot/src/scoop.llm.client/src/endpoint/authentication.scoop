package scoop.llm.client

import scoop.http.HttpField
import scoop.url.Url

/** The immutable representation authenticated for this attempt and then sent without re-encoding. */
public class LlmAuthRequest public constructor(
    public val method: String,
    public val url: Url,
    public val fields: Array<HttpField>,
    public val body: Array<Byte>
)

public interface LlmAuth {
    public suspend fun fields(request: LlmAuthRequest): Array<HttpField>
    public companion object {
        public fun none(): LlmAuth = NoLlmAuth()
        public fun bearer(token: String): LlmAuth = BearerLlmAuth(token)
        public fun bearer(token: suspend () -> String): LlmAuth = CallbackHeaderLlmAuth("Authorization", token, "Bearer ")
        public fun header(name: String, value: String): LlmAuth = HeaderLlmAuth(name, value)
        public fun header(name: String, value: suspend () -> String): LlmAuth = CallbackHeaderLlmAuth(name, value)
        public fun awsSigV4(region: String, credentials: suspend () -> AwsSigV4Credentials,
            service: String = "bedrock"): LlmAuth = AwsSigV4LlmAuth(region, credentials, service)
    }
}

private class HeaderLlmAuth(name: String, value: String) : LlmAuth {
    private val field: HttpField = HttpField(name.toByteArray(), value.toByteArray(), neverIndex = true)
    init { if (value.length == 0L) throw IllegalArgumentException(Some("authentication header must not be empty")) }
    public override suspend fun fields(request: LlmAuthRequest): Array<HttpField> = [field]
}

private class NoLlmAuth : LlmAuth {
    public override suspend fun fields(request: LlmAuthRequest): Array<HttpField> = []
}

private class BearerLlmAuth(token: String) : LlmAuth {
    private val field: HttpField = HttpField("Authorization".toByteArray(), ("Bearer " + token).toByteArray(), neverIndex = true)
    init { if (token.length == 0L) throw IllegalArgumentException(Some("bearer token must not be empty")) }
    public override suspend fun fields(request: LlmAuthRequest): Array<HttpField> = [field]
}

private class CallbackHeaderLlmAuth(val name: String, val value: suspend () -> String, val prefix: String = "") : LlmAuth {
    public override suspend fun fields(request: LlmAuthRequest): Array<HttpField> {
        val token = value()
        if (token.length == 0L) throw IllegalArgumentException(Some("authentication header must not be empty"))
        return [HttpField(name.toByteArray(), (prefix + token).toByteArray(), neverIndex = true)]
    }
}
