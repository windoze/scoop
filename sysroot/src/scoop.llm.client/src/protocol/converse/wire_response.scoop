package scoop.llm.client

import scoop.json.*

internal class ConverseBody public constructor(public val output: JsonValue, public val stopReason: String,
    public val usage: JsonValue? = None) {
    public companion object : ValueDecoder<ConverseBody>
}

internal class ConverseMessage public constructor(public val role: String, public val content: Array<JsonValue>) {
    public companion object : ValueDecoder<ConverseMessage>
}

internal class ConverseToolUse public constructor(public val toolUseId: String, public val name: String,
    public val input: JsonValue, public val type: String? = None) {
    public companion object : ValueDecoder<ConverseToolUse>
}

internal class ConverseToolResult public constructor(public val toolUseId: String, public val content: Array<JsonValue>,
    public val status: String? = None, public val type: String? = None) {
    public companion object : ValueDecoder<ConverseToolResult>
}

internal fun <T> decodeConverseValue(value: JsonValue, path: String): T where T.Companion : ValueDecoder<T> {
    try { return Json.decodeFromValue<T>(value) }
    catch (error: DecodingException) { throw DecodingException(path + error.path, error.message ?: "invalid Converse field") }
}

internal fun converseUnion(value: JsonValue, path: String): (String, JsonValue) {
    if (value.kind != JsonValueKind.Object || value.size != 1L)
        throw DecodingException(path, "Converse union must have exactly one member")
    return value.members()[0L]
}

internal fun converseNonempty(value: String, path: String) {
    if (value.length == 0L) throw DecodingException(path, "expected a nonempty string")
}
