package scoop.llm.client

import scoop.json.*

internal fun encodeDeepSeekResponsesSearch(dialect: DialectId, tool: ServerTool, extensions: Array<DialectExtension>, path: String): JsonValue {
    val configuration = when (tool) {
        case WebSearch(options) -> {
            if (llmPresent(options.allowedDomains)) throw LlmRequestException(path + "/tool/options/allowedDomains", "DeepSeek search has no domain filter mapping")
            if (llmPresent(options.excludedDomains)) throw LlmRequestException(path + "/tool/options/excludedDomains", "DeepSeek search has no domain exclusion mapping")
            if (llmPresent(options.location)) throw LlmRequestException(path + "/tool/options/location", "DeepSeek search has no location mapping")
            if (options.includeSources != None) throw LlmRequestException(path + "/tool/options/includeSources", "DeepSeek Responses does not implement include")
            JsonObjectBuilder().build()
        }
        case Native(native) -> {
            requireLlmOwner(native.dialect, dialect, path + "/tool/dialect")
            if (native.kind != "web_search") throw LlmRequestException(path + "/tool/kind", "DeepSeek Responses only maps web_search server tools")
            if (native.version != None) throw LlmRequestException(path + "/tool/version", "DeepSeek web_search has no explicit version mapping")
            native.configuration
        }
    }
    val value = mergeLlmExtensions(llmTypedObject("web_search").build(), [DialectExtension(dialect, configuration)], dialect, ["type"], path + "/tool")
    return mergeLlmExtensions(value, extensions, dialect, ["type"], path)
}
