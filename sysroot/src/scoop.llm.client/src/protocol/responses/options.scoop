package scoop.llm.client

import scoop.json.*

internal fun encodeResponsesOptions(dialect: DialectId, request: LlmRequest): JsonValue {
    val result = encodeResponsesGenerationOptions(request.options)
    encodeResponsesTools(result, dialect, request)
    return result.build()
}

internal fun encodeResponsesGenerationOptions(options: LlmGenerationOptions, allowDefaultEnabled: Boolean = false): JsonObjectBuilder {
    if (options.topK != None) throw LlmRequestException("/options/topK", "Responses has no top-k setting")
    if (llmPresent(options.stop)) throw LlmRequestException("/options/stop", "Responses has no stop sequence setting")
    if (options.candidates != None && options.candidates != Some(1UL))
        throw LlmRequestException("/options/candidates", "Responses returns one candidate")
    val result = JsonObjectBuilder()
    addResponsesSampling(result, "temperature", options.temperature, 2.0, "/options/temperature")
    addResponsesSampling(result, "top_p", options.topP, 1.0, "/options/topP")
    if (options.maxOutputTokens != None) result.add("max_output_tokens", JsonValue.fromULong(options.maxOutputTokens!!))
    if (options.parallelToolCalls != None) result.add("parallel_tool_calls", JsonValue.fromBoolean(options.parallelToolCalls!!))
    val effort = responsesReasoningEffort(options.reasoning, allowDefaultEnabled)
    if (effort != None) result.add("reasoning", JsonObjectBuilder().add("effort", JsonValue.fromString(effort!!)).build())
    encodeResponsesOutputFormat(result, options.output)
    return result
}

private fun addResponsesSampling(result: JsonObjectBuilder, name: String, value: Double?, maximum: Double, path: String) {
    val setting = value ?: return
    if (setting < 0.0 || setting > maximum) throw LlmRequestException(path, "Responses sampling value is out of range")
    result.add(name, JsonValue.fromDouble(setting))
}

internal fun responsesReasoningEffort(reasoning: ReasoningOptions?, allowDefaultEnabled: Boolean = false): String? {
    val options = reasoning ?: return None
    if (options.budgetTokens != None) throw LlmRequestException("/options/reasoning/budgetTokens", "Responses has no reasoning token budget")
    val effort = options.effort
    if (effort != None) {
        val value = effort!!
        if (value != "none" && value != "minimal" && value != "low" && value != "medium" && value != "high" && value != "xhigh" && value != "max")
            throw LlmRequestException("/options/reasoning/effort", "unsupported reasoning effort")
        if (options.enabled != None && options.enabled!! != (value != "none"))
            throw LlmRequestException("/options/reasoning/enabled", "reasoning enabled conflicts with effort")
        return effort
    }
    if (options.enabled == Some(true) && !allowDefaultEnabled)
        throw LlmRequestException("/options/reasoning/enabled", "Responses needs an explicit effort to enable reasoning")
    return if (options.enabled == Some(false)) Some("none") else None
}

private fun encodeResponsesOutputFormat(result: JsonObjectBuilder, output: OutputFormat) {
    val format = when (output) {
        case Text -> return
        case JsonObject -> llmTypedObject("json_object").build()
        case JsonSchema(schema, name, description, strict) -> {
            requireLlmToolName(name, 64L, "/options/output/name")
            val value = llmTypedObject("json_schema").add("name", JsonValue.fromString(name)).add("schema", schema)
            if (description != None) value.add("description", JsonValue.fromString(description!!))
            if (strict != None) value.add("strict", JsonValue.fromBoolean(strict!!))
            value.build()
        }
    }
    result.add("text", JsonObjectBuilder().add("format", format).build())
}
