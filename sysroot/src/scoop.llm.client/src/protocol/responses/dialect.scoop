package scoop.llm.client

import scoop.json.*

/** Responses-specific interpretation; state belongs to each response or stream decoder. */
public interface ResponsesDialect {
    public val id: DialectId
    public val supportsWebSocket: Boolean
    public val supportsStoredResponses: Boolean get() = false
    public fun encodeOptions(request: LlmRequest): JsonValue
    public fun encodeContent(content: Array<ContentPart>, path: String, role: String? = None): JsonValue
    public fun readReasoning(item: JsonValue, path: String): Array<OutputPart>
    public fun readUsage(usage: JsonValue): TokenUsage
    public fun historyItems(items: Array<JsonValue>): Array<JsonValue>
    public fun decodeError(status: UInt, body: Array<Byte>, truncated: Boolean): LlmServiceException
}

public class OpenAiResponsesDialect public constructor() : ResponsesDialect {
    public override val id: DialectId = DialectId(ApiProtocolId("responses"), "openai-responses")
    public override val supportsWebSocket: Boolean = true
    public override val supportsStoredResponses: Boolean = true
    public override fun encodeOptions(request: LlmRequest): JsonValue = encodeResponsesOptions(id, request)
    public override fun encodeContent(content: Array<ContentPart>, path: String, role: String?): JsonValue = encodeResponsesContent(id, content, path)
    public override fun readReasoning(item: JsonValue, path: String): Array<OutputPart> = readResponsesReasoning(id, item, path)
    public override fun readUsage(usage: JsonValue): TokenUsage = readResponsesUsage(usage)
    public override fun historyItems(items: Array<JsonValue>): Array<JsonValue> = items

    public override fun decodeError(status: UInt, body: Array<Byte>, truncated: Boolean): LlmServiceException {
        val value = parseLlmServiceError(body, truncated)
        val error = when (value) { case Some(root) -> if (root.kind == JsonValueKind.Object) root["error"] else None; case None -> None }
        val code = llmServiceErrorString(error, "code")
        return LlmServiceException(id, status, body, truncated, code, value,
            status == 429U && code == Some("rate_limit_exceeded"),
            llmServiceErrorString(error, "message") ?: "Responses service rejected the request")
    }
}
