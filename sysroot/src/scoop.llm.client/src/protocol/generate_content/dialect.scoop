package scoop.llm.client

import scoop.json.JsonValue

/** Provider options and accounting within the generateContent wire protocol. */
public interface GenerateContentDialect {
    public fun modelCatalog(): LlmModelCatalog? = None
    public fun fileApi(): LlmFileApi? = None
    public fun tokenCounter(): LlmTokenCounter? = None
    public val id: DialectId
    public fun encodeOptions(request: LlmRequest): JsonValue
    public fun readUsage(value: JsonValue): TokenUsage
    public fun decodeError(status: UInt, body: Array<Byte>, truncated: Boolean): LlmServiceException
}

public class GeminiGenerateContentDialect public constructor() : GenerateContentDialect {
    public override fun modelCatalog(): LlmModelCatalog? = Some(GeminiModelCatalog(id))
    public override fun fileApi(): LlmFileApi? = Some(GeminiFileApi(id, false))
    public override val id: DialectId = DialectId(ApiProtocolId("generate-content"), "gemini-generate-content")
    public override fun tokenCounter(): LlmTokenCounter? = Some(GenerateContentTokenCounter(this))
    public override fun encodeOptions(request: LlmRequest): JsonValue = encodeGenerateContentOptions(request)
    public override fun readUsage(value: JsonValue): TokenUsage = readGenerateContentUsage(value)
    public override fun decodeError(status: UInt, body: Array<Byte>, truncated: Boolean): LlmServiceException =
        readGeminiServiceError(id, status, body, truncated)
}
