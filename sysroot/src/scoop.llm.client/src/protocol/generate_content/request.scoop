package scoop.llm.client

import scoop.json.*

internal fun encodeGenerateContentRequest(dialect: GenerateContentDialect, model: String, request: LlmRequest): JsonValue {
    if (model.length == 0L) throw LlmRequestException("/modelId", "model ID must not be empty")
    val contents = ArrayList<JsonValue>()
    val results = ArrayList<JsonValue>()
    var index = 0L
    for (item in request.input) {
        val path = "/input/" + index.toString()
        when (item) {
            case ToolResult(call, content, isError, extensions) ->
                results.add(encodeGenerateContentToolResult(dialect.id, call, content, isError, extensions, request.tools, path))
            case Message(content, role, extensions) -> {
                flushGenerateContentResults(contents, results)
                val name = when (role) {
                    case User -> "user"
                    case Assistant -> "model"
                    else -> throw LlmRequestException(path + "/role", "generateContent instructions belong to request.system")
                }
                val message = JsonObjectBuilder().add("role", JsonValue.fromString(name))
                    .add("parts", encodeGenerateContentParts(dialect.id, content, path + "/content")).build()
                contents.add(mergeLlmExtensions(message, extensions, dialect.id, ["role", "parts"], path))
            }
            case History(history) -> {
                flushGenerateContentResults(contents, results)
                appendGenerateContentHistory(contents, history, dialect.id, path + "/history")
            }
        }
        index += 1L
    }
    flushGenerateContentResults(contents, results)
    if (contents.size == 0L) throw LlmRequestException("/input", "generateContent requires conversation content")
    val body = JsonObjectBuilder().add("contents", JsonValue.fromArray(contents))
    if (request.system.size != 0L) body.add("systemInstruction", JsonObjectBuilder()
        .add("parts", encodeGenerateContentParts(dialect.id, request.system, "/system", true)).build())
    val options = dialect.encodeOptions(request)
    if (options.size != 0L) body.add("generationConfig", options)
    encodeGenerateContentTools(body, dialect.id, request)
    return mergeGenerateContentExtensions(body.build(), request.extensions, dialect.id)
}

private fun flushGenerateContentResults(contents: ArrayList<JsonValue>, results: ArrayList<JsonValue>) {
    if (results.size == 0L) return
    contents.add(JsonObjectBuilder().add("role", JsonValue.fromString("user")).add("parts", JsonValue.fromArray(results)).build())
    results.clear()
}

private fun appendGenerateContentHistory(contents: ArrayList<JsonValue>, history: LlmHistory, dialect: DialectId, path: String) {
    requireLlmOwner(history.dialect, dialect, path + "/dialect")
    if (llmPresent(history.context)) throw LlmRequestException(path + "/context", "generateContent has no implicit history context")
    var index = 0L
    for (item in history.items) {
        val itemPath = path + "/items/" + index.toString()
        if (item.kind != JsonValueKind.Object) throw LlmRequestException(itemPath, "history requires Content objects")
        val parts = item["parts"] ?: throw LlmRequestException(itemPath + "/parts", "history Content requires parts")
        if (parts.kind != JsonValueKind.Array) throw LlmRequestException(itemPath + "/parts", "history parts must be an array")
        for (part in parts.elements()) if (part.kind != JsonValueKind.Object)
            throw LlmRequestException(itemPath + "/parts", "history parts must be objects")
        contents.add(item)
        index += 1L
    }
}
