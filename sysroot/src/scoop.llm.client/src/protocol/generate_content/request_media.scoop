package scoop.llm.client

import scoop.http.HttpMediaType
import scoop.io.encoding.Base64
import scoop.json.*

internal fun encodeGenerateContentMedia(dialect: DialectId, source: MediaSource, kind: String, filename: String?, path: String): JsonValue {
    val rawMime = when (source) { case Bytes(_, mime) -> mime; case Url(_, mime) -> mime; case FileReference(_, mime) -> mime }
    val mime = HttpMediaType.parseOrNone(rawMime) ?: throw LlmRequestException(path + "/mimeType", "invalid media type")
    if (mime.type == "*" || mime.subtype == "*" || (kind == "document" && mime.type != "text" && mime.type != "application") ||
        (kind != "document" && mime.type != kind)) throw LlmRequestException(path + "/mimeType", "media type does not match content kind")
    val body = JsonObjectBuilder().add("mimeType", JsonValue.fromString(rawMime))
    val (field, value) = when (source) {
        case Bytes(bytes, _) -> ("inlineData", body.add("data", JsonValue.fromString(Base64.Default.encode(bytes))).build())
        case Url(url, _) -> {
            if (url.scheme == None) throw LlmRequestException(path + "/url", "media URI must be absolute")
            ("fileData", body.add("fileUri", JsonValue.fromString(url.toString())).build())
        }
        case FileReference(reference, _) -> {
            requireLlmOwner(reference.dialect, dialect, path + "/reference/dialect")
            val raw = reference.value
            if (raw.kind != JsonValueKind.Object) throw LlmRequestException(path + "/reference/value", "file reference requires a fileData object")
            val uri = raw["fileUri"] ?: throw LlmRequestException(path + "/reference/value/fileUri", "missing file URI")
            if (uri.kind != JsonValueKind.String || uri.asString().length == 0L)
                throw LlmRequestException(path + "/reference/value/fileUri", "file URI must be a nonempty string")
            val previous = raw["mimeType"]
            if (llmPresent(previous)) {
                if (previous!!.kind != JsonValueKind.String)
                    throw LlmRequestException(path + "/reference/value/mimeType", "invalid file reference MIME type")
                val previousMime = HttpMediaType.parseOrNone(previous!!.asString())
                    ?: throw LlmRequestException(path + "/reference/value/mimeType", "invalid file reference MIME type")
                if (previousMime.type == "*" || previousMime.subtype == "*")
                    throw LlmRequestException(path + "/reference/value/mimeType", "file reference MIME type must be concrete")
                if (!MediaFormat(previous!!.asString(), MediaForm.FileReference).matches(MediaFormat(rawMime, MediaForm.FileReference)))
                    throw LlmRequestException(path + "/mimeType", "MIME type differs from file reference")
                ("fileData", raw)
            } else {
                for ((name, value) in raw.members()) body.add(name, value)
                ("fileData", body.build())
            }
        }
    }
    val named = if (filename == None) value else {
        val previous = value["displayName"]
        if (llmPresent(previous) && (previous!!.kind != JsonValueKind.String || previous!!.asString() != filename!!))
            throw LlmRequestException(path, "filename differs from file reference displayName")
        val result = JsonObjectBuilder()
        for ((name, entry) in value.members()) if (name != "displayName") result.add(name, entry)
        result.add("displayName", JsonValue.fromString(filename!!)).build()
    }
    return JsonObjectBuilder().add(field, named).build()
}
