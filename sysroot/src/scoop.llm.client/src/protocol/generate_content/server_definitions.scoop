package scoop.llm.client

import scoop.json.*

internal fun encodeGenerateContentServerTool(dialect: DialectId, tool: ServerTool, extensions: Array<DialectExtension>, path: String): (String, JsonValue) {
    val (kind, configuration, managed): (String, JsonValue, Array<String>) = when (tool) {
        case WebSearch(options) -> {
            val at = path + "/tool/options/"
            if (llmPresent(options.allowedDomains)) throw LlmRequestException(at + "allowedDomains", "googleSearch has no allowed-domain filter")
            if (llmPresent(options.excludedDomains)) throw LlmRequestException(at + "excludedDomains", "googleSearch has no excluded-domain filter")
            if (llmPresent(options.location)) throw LlmRequestException(at + "location", "googleSearch location uses coordinates, not this location format")
            if (options.includeSources != None) throw LlmRequestException(at + "includeSources", "grounding sources have no inclusion switch")
            ("googleSearch", JsonObjectBuilder().build(), ["searchTypes", "search_types"])
        }
        case Native(native) -> {
            requireLlmOwner(native.dialect, dialect, path + "/tool/dialect")
            if (native.version != None) throw LlmRequestException(path + "/tool/version", "generateContent tools have no explicit version field")
            val kind = native.kind
            if (kind != "googleSearch" && kind != "googleSearchRetrieval" && kind != "codeExecution" && kind != "urlContext" &&
                kind != "fileSearch" && kind != "googleMaps" && kind != "mcpServers")
                throw LlmRequestException(path + "/tool/kind", "unknown generateContent server tool kind")
            (kind, native.configuration, [])
        }
    }
    val value = mergeLlmExtensions(configuration, extensions, dialect, managed, path)
    return (kind, JsonObjectBuilder().add(kind, if (kind == "mcpServers") JsonValue.fromArray([value]) else value).build())
}
