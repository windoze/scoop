package scoop.llm.client

import scoop.json.*
import scoop.time.Duration

internal class OpenAiCacheSelection(val modern: Boolean, val durations: Array<Duration>? = None)

internal fun selectOpenAiCacheLifetimes(request: JsonValue, chat: Boolean): OpenAiCacheSelection {
    val breakpoints = openAiCacheBreakpoints(request, chat)
    val present = request.containsKey("prompt_cache_options")
    if (!present && breakpoints.size == 0L) return OpenAiCacheSelection(false)
    val options = cacheObjectField(Some(request), "prompt_cache_options")
    if (present && !llmPresent(options)) return OpenAiCacheSelection(true)
    val root = options ?: JsonObjectBuilder().build()
    val mode = if (!root.containsKey("mode")) Some("implicit") else cacheStringField(Some(root), "mode")
    if (mode != Some("implicit") && mode != Some("explicit")) return OpenAiCacheSelection(true)
    val defaultTtl = openAiCacheDuration(root, Duration.minutes(30L), !chat) ?: return OpenAiCacheSelection(true)
    val selected = ArrayList<Duration>()
    if (mode == Some("implicit")) selected.add(defaultTtl)
    for (point in breakpoints) {
        if (point.kind != JsonValueKind.Object || cacheStringField(Some(point), "mode") != Some("explicit"))
            return OpenAiCacheSelection(true)
        selected.add(openAiCacheDuration(point, defaultTtl, !chat) ?: return OpenAiCacheSelection(true))
    }
    return OpenAiCacheSelection(true, Some(selected.toArray()))
}

private fun openAiCacheDuration(options: JsonValue, inherited: Duration, extended: Boolean): Duration? {
    if (!options.containsKey("ttl")) return Some(inherited)
    return when (cacheStringField(Some(options), "ttl")) {
        case Some("30m") -> Some(Duration.minutes(30L))
        case Some("12h") -> if (extended) Some(Duration.hours(12L)) else None
        else -> None
    }
}

/** Visit content containers, never tool arguments or arbitrary native JSON objects. */
private fun openAiCacheBreakpoints(request: JsonValue, chat: Boolean): Array<JsonValue> {
    val result = ArrayList<JsonValue>()
    val items = request[if (chat) "messages" else "input"] ?: return []
    if (items.kind != JsonValueKind.Array) return []
    for (item in items.elements()) {
        if (item.kind != JsonValueKind.Object) continue
        val type = cacheStringField(Some(item), "type")
        val field = if (chat || type == Some("message") || (type == None && item.containsKey("role"))) "content"
            else if (type == Some("function_call_output")) "output" else continue
        val content = item[field] ?: continue
        if (content.kind != JsonValueKind.Array) continue
        for (part in content.elements()) {
            if (part.kind != JsonValueKind.Object) continue
            val point = part["prompt_cache_breakpoint"] ?: continue
            result.add(point)
        }
    }
    return result.toArray()
}
