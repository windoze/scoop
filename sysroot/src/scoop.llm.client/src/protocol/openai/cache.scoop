package scoop.llm.client

import scoop.json.JsonValue
import scoop.time.Duration

internal fun openAiCacheObserver(dialect: DialectId, encoded: JsonValue): LlmCacheObserver {
    val selection = selectOpenAiCacheLifetimes(encoded, dialect.protocol == ApiProtocolId("chat-completions"))
    val retention = cacheStringField(Some(encoded), "prompt_cache_retention")
    if (!selection.modern) return legacyOpenAiCacheObserver(dialect, retention)
    val read = ArrayList<CacheLifetime>()
    val write = ArrayList<CacheLifetime>()
    val selected = selection.durations ?: return OpenAiCacheObserver(dialect, [], [])
    var minimum: Duration? = None
    var allThirty = selected.size != 0L
    for (ttl in selected) {
        if (minimum == None || ttl < minimum!!) minimum = Some(ttl)
        if (ttl != Duration.minutes(30L)) allThirty = false
    }
    if (minimum != None) write.add(CacheLifetime(minimum!!, MinimumReadPricing, Write))
    if (allThirty) read.add(CacheLifetime(Duration.minutes(30L), MinimumReadPricing, Read))
    return OpenAiCacheObserver(dialect, read.toArray(), write.toArray(), if (allThirty) Some(true) else None)
}

private class OpenAiCacheObserver(val dialect: DialectId, val read: Array<CacheLifetime>, val write: Array<CacheLifetime>,
    val refresh: Boolean? = None) : LlmCacheObserver {
    public override fun observe(usage: LlmUsage): Array<CacheReport> {
        val result = ArrayList<CacheReport>()
        if (usage.tokens.cacheReadTokens != None)
            result.add(CacheReport("read", dialect, Read, usage.tokens.cacheReadTokens, lifetimes = read, refreshesLifetime = refresh))
        if (usage.tokens.cacheWriteTokens != None)
            result.add(CacheReport("write", dialect, Write, usage.tokens.cacheWriteTokens, lifetimes = write))
        return result.toArray()
    }
}

private fun legacyOpenAiCacheObserver(dialect: DialectId, retention: String?): LlmCacheObserver {
    val read = ArrayList<CacheLifetime>()
    val write = ArrayList<CacheLifetime>()
    if (retention == Some("in_memory")) {
        read.add(CacheLifetime(Duration.minutes(5L), TypicalRetention, Read, Some(Duration.minutes(10L))))
        write.add(CacheLifetime(Duration.minutes(5L), TypicalRetention, Write, Some(Duration.minutes(10L))))
    } else if (retention == Some("24h")) {
        val typical = CacheLifetime(Duration.minutes(30L), TypicalRetention, Unknown)
        read.add(typical); write.add(typical)
    }
    val maximum = openAiMaximumRetention(retention)
    if (llmPresent(maximum)) { read.add(maximum!!); write.add(maximum!!) }
    return OpenAiCacheObserver(dialect, read.toArray(), write.toArray())
}

private fun openAiMaximumRetention(retention: String?): CacheLifetime? = when (retention) {
    case Some("in_memory") -> Some(CacheLifetime(Duration.hours(1L), MaximumRetention, Unknown))
    case Some("24h") -> Some(CacheLifetime(Duration.hours(24L), MaximumRetention, Unknown))
    else -> None
}
