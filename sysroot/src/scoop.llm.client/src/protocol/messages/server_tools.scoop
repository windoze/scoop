package scoop.llm.client

import scoop.json.*

internal fun readMessagesServerCall(dialect: DialectId, call: MessagesToolUse, raw: JsonValue,
    tools: Array<ToolDefinition>, path: String): ServerToolActivity {
    if (call.input.kind != JsonValueKind.Object) throw DecodingException(path + "/input", "server tool input must be a JSON object")
    val binding = resolveMessagesTool(tools, dialect, call.name, true)
    val key = when (binding) { case Some(value) -> Some(value.key); case None -> None }
    val kind = if (call.name == "web_search") ServerToolKind.WebSearch else ServerToolKind.Native
    return ServerToolActivity(kind, InProgress, key, Some(call.id), Some(call.input), native = Some(raw))
}

internal fun readMessagesSearchResult(dialect: DialectId, raw: JsonValue, tools: Array<ToolDefinition>,
    calls: ArrayList<MessagesCallIdentity>, path: String): ServerToolActivity {
    val value = decodeMessagesValue<MessagesSearchResult>(raw, path)
    if (value.toolUseId.length == 0L) throw DecodingException(path + "/tool_use_id", "empty server tool result ID")
    var key: ToolKey? = None
    for (call in calls) {
        if (call.id != value.toolUseId) continue
        if (!call.server || call.name != "web_search")
            throw DecodingException(path + "/tool_use_id", "search result refers to another kind of call")
        val binding = resolveMessagesTool(tools, dialect, call.name, true)
        key = when (binding) { case Some(tool) -> Some(tool.key); case None -> None }
    }
    val result = ArrayList<OutputPart>()
    val sources = ArrayList<LlmSource>()
    val status = when (value.content.kind) {
        case Array -> {
            var index = 0L
            for (entry in value.content.elements()) {
                val entryPath = path + "/content/" + index.toString()
                val kind = decodeMessagesValue<MessagesBlockType>(entry, entryPath).type
                if (kind == "web_search_result") sources.add(readMessagesUrlSource(entry, entryPath))
                result.add(OutputPart.Native(dialect, entry))
                index += 1L
            }
            ServerToolStatus.Completed
        }
        case Object -> {
            val kind = decodeMessagesValue<MessagesBlockType>(value.content, path + "/content").type
            result.add(OutputPart.Native(dialect, value.content))
            if (kind == "web_search_tool_result_error") {
                decodeMessagesValue<MessagesSearchError>(value.content, path + "/content")
                ServerToolStatus.Failed
            } else ServerToolStatus.Unknown
        }
        else -> throw DecodingException(path + "/content", "search result content must be an array or object")
    }
    return ServerToolActivity(ServerToolKind.WebSearch, status, key, Some(value.toolUseId),
        result = result.toArray(), sources = sources.toArray(), native = Some(raw))
}

private class MessagesSearchError public constructor(@Serialize(rename = "error_code") public val errorCode: String) {
    public companion object : ValueDecoder<MessagesSearchError>
}
