package scoop.llm.client

import scoop.json.*
import scoop.time.Duration

internal class MessagesCacheObserver(val dialect: DialectId) : LlmCacheObserver {
    public override fun observe(usage: LlmUsage): Array<CacheReport> {
        val result = ArrayList<CacheReport>()
        val five = Duration.minutes(5L)
        val hour = Duration.hours(1L)
        val details = cacheObjectField(usage.native, "cache_creation")
        var future = false
        when (details) {
            case Some(value) -> for (key in value.keys()) {
                if (key != "ephemeral_5m_input_tokens" && key != "ephemeral_1h_input_tokens") future = true
            }
            case None -> {}
        }
        val minimum: Array<CacheLifetime> = if (future) [] else [CacheLifetime(five, MinimumRetention, RequestStart)]
        if (usage.tokens.cacheReadTokens != None)
            result.add(CacheReport("read", dialect, Read, usage.tokens.cacheReadTokens, lifetimes = minimum, refreshesLifetime = Some(true)))
        val total = usage.tokens.cacheWriteTokens
        if (total == None) return result.toArray()
        val short = cacheCountField(details, "ephemeral_5m_input_tokens")
        val long = cacheCountField(details, "ephemeral_1h_input_tokens")
        if (!future && short != None && long != None && short!! <= Long.MAX_VALUE - long!! && short!! + long!! == total!!) {
            result.add(CacheReport("write:5m", dialect, Write, short, lifetimes = [CacheLifetime(five, Expiration, RequestStart)]))
            result.add(CacheReport("write:1h", dialect, Write, long, lifetimes = [CacheLifetime(hour, Expiration, RequestStart)]))
        } else result.add(CacheReport("write", dialect, Write, total, lifetimes = minimum))
        return result.toArray()
    }
}
