package scoop.llm.client

import scoop.json.*

internal fun encodeMessagesRequest(dialect: MessagesDialect, model: String, request: LlmRequest, stream: Boolean): JsonValue {
    if (model.length == 0L) throw LlmRequestException("/modelId", "model ID must not be empty")
    val messages = ArrayList<JsonValue>()
    val results = ArrayList<JsonValue>()
    var index = 0L
    for (item in request.input) {
        val path = "/input/" + index.toString()
        when (item) {
            case ToolResult(call, content, isError, extensions) -> {
                requireLlmOwner(call.dialect, dialect.id, path + "/call/dialect")
                val callId = requireLlmToolCallId(call.id, path + "/call/id")
                val block = llmTypedObject("tool_result").add("tool_use_id", JsonValue.fromString(callId))
                    .add("content", dialect.encodeContent(content, "user", path + "/content"))
                    .add("is_error", JsonValue.fromBoolean(isError)).build()
                results.add(mergeLlmExtensions(block, extensions, dialect.id, ["type", "tool_use_id", "content", "is_error"], path))
            }
            case Message(content, role, extensions) -> {
                flushMessagesToolResults(messages, results)
                val wireRole = when (role) {
                    case User -> "user"
                    case Assistant -> "assistant"
                    case System -> "system"
                    case Developer -> throw LlmRequestException(path + "/role", "Messages has no developer role")
                }
                if (wireRole == "system" && messages.size == 0L && content.size != 0L)
                    throw LlmRequestException(path + "/role", "initial Messages instructions belong in request.system")
                val message = messagesMessage(wireRole, dialect.encodeContent(content, wireRole, path + "/content"))
                messages.add(mergeLlmExtensions(message, extensions, dialect.id, ["role", "content"], path))
            }
            case History(history) -> {
                flushMessagesToolResults(messages, results)
                appendMessagesHistory(messages, history, dialect.id, path + "/history")
            }
        }
        index += 1L
    }
    flushMessagesToolResults(messages, results)
    if (messages.size == 0L) throw LlmRequestException("/input", "Messages requires at least one input message")
    val body = JsonObjectBuilder().add("model", JsonValue.fromString(model)).add("messages", JsonValue.fromArray(messages))
    if (request.system.size != 0L) body.add("system", dialect.encodeContent(request.system, "system", "/system"))
    for ((name, value) in dialect.encodeOptions(request).members()) {
        if (name == "model" || name == "messages" || name == "system" || name == "stream")
            throw LlmRequestException("/options", "dialect options cannot override Messages routing or stream mode")
        body.add(name, value)
    }
    if (stream) body.add("stream", JsonValue.fromBoolean(true))
    return mergeLlmExtensions(body.build(), request.extensions, dialect.id, ["model", "messages", "system", "stream", "max_tokens",
        "temperature", "top_p", "top_k", "stop_sequences", "tools", "tool_choice", "thinking", "output_config"], "")
}

internal fun messagesMessage(role: String, content: JsonValue): JsonValue = JsonObjectBuilder()
    .add("role", JsonValue.fromString(role)).add("content", content).build()

private fun flushMessagesToolResults(messages: ArrayList<JsonValue>, results: ArrayList<JsonValue>) {
    if (results.size == 0L) return
    messages.add(messagesMessage("user", JsonValue.fromArray(results)))
    results.clear()
}

private fun appendMessagesHistory(messages: ArrayList<JsonValue>, history: LlmHistory, dialect: DialectId, path: String) {
    requireLlmOwner(history.dialect, dialect, path + "/dialect")
    if (llmPresent(history.context)) throw LlmRequestException(path + "/context", "Messages has no separate history context field")
    var index = 0L
    for (message in history.items) {
        val itemPath = path + "/items/" + index.toString()
        if (message.kind != JsonValueKind.Object) throw LlmRequestException(itemPath, "Messages history requires an assistant message")
        val role = message["role"] ?: throw LlmRequestException(itemPath + "/role", "missing history role")
        if (role.kind != JsonValueKind.String || role.asString() != "assistant")
            throw LlmRequestException(itemPath + "/role", "Messages history requires an assistant role")
        val content = message["content"] ?: throw LlmRequestException(itemPath + "/content", "missing history content")
        if (content.kind != JsonValueKind.Array && content.kind != JsonValueKind.String)
            throw LlmRequestException(itemPath + "/content", "history content must be an array or string")
        messages.add(message)
        index += 1L
    }
}
