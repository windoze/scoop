package scoop.llm.client

import scoop.json.JsonValue

/** Messages content blocks combined with one explicitly selected dialect. */
public class MessagesProtocol public constructor(public val dialect: MessagesDialect) {
    public val dialectId: DialectId get() = dialect.id
    init {
        if (dialect.id.protocol != ApiProtocolId("messages"))
            throw IllegalArgumentException(Some("Messages dialect belongs to another API protocol"))
    }

    public fun decodeResponse(value: JsonValue, request: LlmRequest): LlmResponse {
        try {
            val body = decodeMessagesValue<MessagesResponseBody>(value, "")
            if (body.type != "message") throw DecodingException("/type", "expected a Messages response")
            if (body.role != "assistant") throw DecodingException("/role", "expected an assistant message")
            val (completion, reason) = messagesCompletion(body.stopReason)
            val items = readMessagesBlocks(dialect, body.content, request.tools, completion == LlmCompletion.Complete)
            val history = LlmHistory(dialect.id, [dialect.historyMessage(value, "")])
            val candidate = LlmCandidate(0L, items, completion, reason, Some(history))
            val usage = when (body.usage) {
                case Some(raw) -> LlmUsage(dialect.readUsage(raw), Final, Some(raw))
                case None -> LlmUsage(completeness = Final)
            }
            return LlmResponse(dialect.id, [candidate], body.id, body.model, usage = usage, native = Some(value))
        } catch (error: DecodingException) {
            throw LlmProtocolException(dialect.id, error.path, error.message ?: "invalid Messages response", value)
        }
    }
}

internal fun messagesCompletion(reason: String): (LlmCompletion, LlmFinishReason) = when (reason) {
    case "end_turn" -> (LlmCompletion.Complete, LlmFinishReason.Stop)
    case "stop_sequence" -> (LlmCompletion.Complete, LlmFinishReason.Stop)
    case "tool_use" -> (LlmCompletion.Complete, LlmFinishReason.ToolCalls)
    case "max_tokens" -> (LlmCompletion.Incomplete, LlmFinishReason.Length)
    case "model_context_window_exceeded" -> (LlmCompletion.Incomplete, LlmFinishReason.Length)
    case "pause_turn" -> (LlmCompletion.Incomplete, LlmFinishReason.Pause)
    case "refusal" -> (LlmCompletion.Refused, LlmFinishReason.Refusal)
    else -> (LlmCompletion.Incomplete, LlmFinishReason.Other(reason))
}
