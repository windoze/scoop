package scoop.llm.client

import scoop.bytes.ByteArrayBuilder
import scoop.io.encoding.Base64
import scoop.json.JsonObjectBuilder
import scoop.json.JsonValue

/** Known native fields have explicit merge rules; unknown fields remain event fragments. */
internal class ChatStreamAudio public constructor(public val location: LlmItemLocation, private val retention: StreamRetention) {
    private var id: String? = None
    private var expires: Long? = None
    private val data: ByteArrayBuilder = ByteArrayBuilder()
    private val transcript: StringBuilder = StringBuilder()
    private var hasData: Boolean = false
    private var hasTranscript: Boolean = false
    public var historyAvailable: Boolean = true

    public fun accept(raw: JsonValue, batch: ChatStreamBatch, path: String) {
        val fields = decodeChatValue<ChatStreamAudioFields>(raw, path)
        id = chatStreamIdentity(id, fields.id, path + "/id")
        if (fields.expiresAt != None) expires = fields.expiresAt
        if (fields.data != None) {
            hasData = true
            val bytes = Base64.Default.withPadding(Base64.PaddingOption.Optional).decodeOrNone(fields.data!!) ?:
                throw DecodingException(path + "/data", "invalid Base64 audio chunk")
            if (retention == StreamRetention.Result) data.append(bytes)
            batch.observe(fields.data!!)
        }
        if (fields.transcript != None) {
            hasTranscript = true
            if (retention == StreamRetention.Result) transcript.append(fields.transcript!!)
            batch.observe(fields.transcript!!)
        }
        batch.native("chat.audio.delta", raw, Some(location), false)
        val extra = chatStreamUnknown(raw, ["id", "data", "transcript", "expires_at"])
        if (extra.size != 0L) {
            historyAvailable = false
            batch.native("chat.audio.unknown", extra, Some(location))
        }
    }

    public fun wire(path: String): JsonValue {
        val audioId = id ?: throw DecodingException(path + "/id", "audio ended without an ID")
        val result = JsonObjectBuilder().add("id", JsonValue.fromString(audioId))
        if (hasData) result.add("data", JsonValue.fromString(Base64.Default.encode(data.toByteArray())))
        if (hasTranscript) result.add("transcript", JsonValue.fromString(transcript.toString()))
        if (expires != None) result.add("expires_at", JsonValue.fromLong(expires!!))
        return result.build()
    }
    public fun release() { data.clear(); transcript.clear() }
}

internal class ChatStreamLegacyFunction public constructor(public val location: LlmItemLocation, private val retention: StreamRetention) {
    private var name: String? = None
    private val arguments: StringBuilder = StringBuilder()
    public var historyAvailable: Boolean = true

    public fun accept(raw: JsonValue, batch: ChatStreamBatch, path: String) {
        val fields = decodeChatValue<ChatStreamFunctionFields>(raw, path)
        name = chatStreamIdentity(name, fields.name, path + "/name")
        if (fields.arguments != None) {
            if (retention == StreamRetention.Result) arguments.append(fields.arguments!!)
            batch.observe(fields.arguments!!)
        }
        batch.native("chat.function_call.delta", raw, Some(location), false)
        val extra = chatStreamUnknown(raw, ["name", "arguments"])
        if (extra.size != 0L) {
            historyAvailable = false
            batch.native("chat.function_call.unknown", extra, Some(location))
        }
    }
    public fun wire(path: String): JsonValue {
        val functionName = name ?: throw DecodingException(path + "/name", "function call ended without a name")
        return JsonObjectBuilder().add("name", JsonValue.fromString(functionName))
            .add("arguments", JsonValue.fromString(arguments.toString())).build()
    }
    public fun release() { arguments.clear() }
}
