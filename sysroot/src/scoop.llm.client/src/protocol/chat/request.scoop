package scoop.llm.client

import scoop.json.*

internal fun encodeChatRequest(dialect: ChatDialect, model: String, request: LlmRequest, stream: Boolean): JsonValue {
    if (model.length == 0L) throw LlmRequestException("/modelId", "model ID must not be empty")
    val messages = ArrayList<JsonValue>()
    if (request.system.size != 0L) messages.add(encodeChatMessage(dialect, "system", request.system, [], "/system", "/system"))
    var index = 0L
    for (item in request.input) {
        val path = "/input/" + index.toString()
        when (item) {
            case Message(content, role, extensions) -> {
                val wireRole = when (role) { case User -> "user"; case Assistant -> "assistant"; case System -> "system"; case Developer -> "developer" }
                messages.add(encodeChatMessage(dialect, wireRole, content, extensions, path, path + "/content"))
            }
            case ToolResult(call, content, isError, extensions) -> {
                requireChatOwner(call.dialect, dialect.id, path + "/call/dialect")
                requireChatNoContext(call.context, path + "/call/context")
                if (call.id.length == 0L) throw LlmRequestException(path + "/call/id", "Chat tool call ID must not be empty")
                if (isError) throw LlmRequestException(path + "/isError", "Chat has no tool-result error flag")
                val body = JsonObjectBuilder().add("role", JsonValue.fromString("tool"))
                    .add("tool_call_id", JsonValue.fromString(call.id))
                    .add("content", dialect.encodeContent(content, "tool", path + "/content")).build()
                messages.add(mergeChatExtensions(body, extensions, dialect.id, chatMessageFields(), path))
            }
            case History(history) -> appendChatHistory(messages, history, dialect.id, path + "/history")
        }
        index += 1L
    }
    if (messages.size == 0L) throw LlmRequestException("/input", "Chat requires at least one message")
    val result = JsonObjectBuilder().add("model", JsonValue.fromString(model)).add("messages", JsonValue.fromArray(messages))
    val options = dialect.encodeOptions(request)
    for ((name, value) in options.members()) {
        if (name == "model" || name == "messages" || name == "stream" || name == "stream_options")
            throw LlmRequestException("/options", "dialect options cannot override Chat routing or stream mode")
        result.add(name, value)
    }
    if (stream) {
        result.add("stream", JsonValue.fromBoolean(true))
        result.add("stream_options", JsonObjectBuilder().add("include_usage", JsonValue.fromBoolean(true)).build())
    }
    return mergeChatExtensions(result.build(), request.extensions, dialect.id, [
        "model", "messages", "stream", "stream_options", "tools", "tool_choice", "functions", "function_call",
        "temperature", "top_p", "top_k", "n", "max_tokens", "max_completion_tokens", "stop", "parallel_tool_calls",
        "reasoning_effort", "thinking", "response_format", "web_search_options"
    ], "")
}

private fun encodeChatMessage(dialect: ChatDialect, role: String, content: Array<ContentPart>,
    extensions: Array<DialectExtension>, path: String, contentPath: String): JsonValue {
    val message = JsonObjectBuilder().add("role", JsonValue.fromString(role))
        .add("content", dialect.encodeContent(content, role, contentPath)).build()
    return mergeChatExtensions(message, extensions, dialect.id, chatMessageFields(), path)
}

private fun chatMessageFields(): Array<String> = ["role", "content", "tool_calls", "tool_call_id", "function_call", "reasoning_content"]

private fun appendChatHistory(messages: ArrayList<JsonValue>, history: LlmHistory, dialect: DialectId, path: String) {
    requireChatOwner(history.dialect, dialect, path + "/dialect")
    requireChatNoContext(history.context, path + "/context")
    var index = 0L
    for (message in history.items) {
        val itemPath = path + "/items/" + index.toString()
        if (message.kind != JsonValueKind.Object) throw LlmRequestException(itemPath, "Chat history item must be an assistant message")
        val role = message["role"] ?: throw LlmRequestException(itemPath + "/role", "Chat history role is missing")
        if (role.kind != JsonValueKind.String || role.asString() != "assistant")
            throw LlmRequestException(itemPath + "/role", "Chat history requires an assistant role")
        messages.add(message)
        index += 1L
    }
}

private fun requireChatNoContext(context: JsonValue?, path: String): Unit = when (context) {
    case Some(_) -> throw LlmRequestException(path, "Chat has no separate context field")
    case None -> Unit
}
