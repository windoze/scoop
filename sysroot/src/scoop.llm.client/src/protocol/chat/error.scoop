package scoop.llm.client

import scoop.json.*

internal fun decodeChatError(dialect: DialectId, status: UInt, body: Array<Byte>, truncated: Boolean, deepSeek: Boolean): LlmServiceException {
    val value = parseLlmServiceError(body, truncated)
    val error = when (value) { case Some(root) -> if (root.kind == JsonValueKind.Object) root["error"] else None; case None -> None }
    val code = llmServiceErrorString(error, "code")
    val message = llmServiceErrorString(error, "message") ?: "Chat service rejected the request"
    val retryable = if (deepSeek) status == 429U || status == 503U else status == 429U && code == Some("rate_limit_exceeded")
    return LlmServiceException(dialect, status, body, truncated, code, value, retryable, message)
}
