package scoop.llm.client

import scoop.json.*

internal class OpenRouterArrayStream public constructor(
    private val dialect: DialectId, private val field: String,
    private val location: LlmItemLocation, private val retention: StreamRetention
) : ChatStreamFieldDecoder {
    public override val fields: Array<String> = [field]
    private val items: ArrayList<JsonValue> = ArrayList<JsonValue>()
    private var raw: JsonValue = JsonValue.nullValue()

    public override fun accept(delta: JsonValue, path: String): LlmStreamUpdate {
        val incoming = delta[field]!!
        if (retention == StreamRetention.Result) {
            if (incoming.kind == JsonValueKind.Array) {
                if (raw.kind != JsonValueKind.Array) items.clear()
                for (item in incoming.elements()) items.add(item)
            } else if (incoming.kind != JsonValueKind.Null) items.clear()
            if (incoming.kind != JsonValueKind.Null) raw = incoming
        }
        val event = LlmNativeEvent(dialect, "chat." + field + ".delta", JsonObjectBuilder().add(field, incoming).build(), Some(location))
        val hasOutput = field == "images" && incoming.kind != JsonValueKind.Null &&
            (incoming.kind != JsonValueKind.Array || incoming.size != 0L)
        return LlmStreamUpdate([LlmEvent.Native(event)], hasOutput)
    }

    public override fun finish(): ChatStreamFieldResult {
        val value = if (raw.kind == JsonValueKind.Array) JsonValue.fromArray(items) else raw
        val wire = JsonObjectBuilder().add(field, value).build()
        items.clear(); raw = JsonValue.nullValue()
        return ChatStreamFieldResult(LlmOutputItem.Native(dialect, wire), wire)
    }
}

internal class OpenRouterAudioStream public constructor(
    private val dialect: DialectId, location: LlmItemLocation, private val retention: StreamRetention
) : ChatStreamFieldDecoder {
    public override val fields: Array<String> = ["audio"]
    private val audio: ChatStreamAudio = ChatStreamAudio(location, retention, false)
    private var present: Boolean = false

    public override fun accept(delta: JsonValue, path: String): LlmStreamUpdate {
        val raw = delta["audio"]!!
        val batch = LlmStreamBatch(dialect, retention, ArrayList<LlmNativeEvent>())
        if (raw.kind != JsonValueKind.Null) { present = true; audio.accept(raw, batch, path + "/audio") }
        return batch.build()
    }

    public override fun finish(): ChatStreamFieldResult {
        val raw = if (present) audio.wire("/delta/audio") else JsonValue.nullValue()
        val fields = JsonObjectBuilder().add("audio", raw).build()
        audio.release()
        return ChatStreamFieldResult(LlmOutputItem.Native(dialect, fields), fields, audio.historyAvailable)
    }
}
