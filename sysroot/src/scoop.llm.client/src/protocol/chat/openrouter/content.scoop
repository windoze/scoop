package scoop.llm.client

import scoop.json.*

internal fun encodeOpenRouterContent(dialect: DialectId, content: Array<ContentPart>, role: String, path: String): JsonValue {
    if (content.size == 1L) when (content[0L]) {
        case Text(text, extensions) -> { if (extensions.size == 0L) return JsonValue.fromString(text) }
        else -> {}
    }
    val parts = ArrayList<JsonValue>(); var index = 0L
    for (part in content) {
        val at = path + "/" + index.toString()
        val value = when (part) {
            case Document(source, filename, extensions) -> {
                requireOpenRouterMediaRole(role, at)
                val file = JsonObjectBuilder().add("file_data", JsonValue.fromString(openRouterMediaUrl(source, at + "/source")))
                if (filename != None) file.add("filename", JsonValue.fromString(filename!!))
                extendOpenRouterMedia(llmTypedObject("file").add("file", file.build()).build(), extensions, dialect, at)
            }
            case Video(source, extensions) -> {
                requireOpenRouterMediaRole(role, at)
                val video = JsonObjectBuilder().add("url", JsonValue.fromString(openRouterMediaUrl(source, at + "/source"))).build()
                extendOpenRouterMedia(llmTypedObject("video_url").add("video_url", video).build(), extensions, dialect, at)
            }
            case Audio(source, extensions) -> {
                requireOpenRouterMediaRole(role, at)
                extendOpenRouterMedia(encodeOpenRouterAudio(source, at + "/source"), extensions, dialect, at)
            }
            else -> encodeChatPart(dialect, part, role, false, at)
        }
        parts.add(value); index += 1L
    }
    return JsonValue.fromArray(parts)
}

private fun requireOpenRouterMediaRole(role: String, path: String) {
    if (role != "user") throw LlmRequestException(path, "OpenRouter media input requires a user message")
}

private fun extendOpenRouterMedia(value: JsonValue, extensions: Array<DialectExtension>, dialect: DialectId, path: String): JsonValue =
    mergeLlmExtensions(value, extensions, dialect, ["type", "file", "video_url", "input_audio"], path)
