package scoop.llm.client

import scoop.json.*

internal fun encodeInteractionsServer(dialect: DialectId, definition: ServerTool, extensions: Array<DialectExtension>,
    path: String): (String, JsonValue) {
    val (kind, configuration, managed): (String, JsonValue, Array<String>) = when (definition) {
        case WebSearch(options) -> {
            val at = path + "/tool/options/"
            if (llmPresent(options.allowedDomains)) throw LlmRequestException(at + "allowedDomains", "google_search has no allowed-domain filter")
            if (llmPresent(options.excludedDomains)) throw LlmRequestException(at + "excludedDomains", "google_search has no excluded-domain filter")
            if (llmPresent(options.location)) throw LlmRequestException(at + "location", "google_search has no matching location option")
            if (options.includeSources != None) throw LlmRequestException(at + "includeSources", "google_search has no source inclusion switch")
            ("google_search", JsonObjectBuilder().add("search_types", Json.encodeToValue(["web_search"])).build(), ["type", "search_types"])
        }
        case Native(native) -> {
            requireLlmOwner(native.dialect, dialect, path + "/tool/dialect")
            if (native.version != None) throw LlmRequestException(path + "/tool/version", "Interactions tools have no version field")
            val type = native.kind
            if (type != "google_search" && type != "code_execution" && type != "url_context" && type != "file_search" &&
                type != "google_maps" && type != "mcp_server")
                throw LlmRequestException(path + "/tool/kind", "unknown Interactions server tool kind")
            if (native.configuration.containsKey("type"))
                throw LlmRequestException(path + "/tool/configuration/type", "native configuration cannot override the tool kind")
            (type, native.configuration, ["type"])
        }
    }
    val value = llmTypedObject(kind)
    for ((name, item) in configuration.members()) value.add(name, item)
    return (kind, mergeLlmExtensions(value.build(), extensions, dialect, managed, path))
}
