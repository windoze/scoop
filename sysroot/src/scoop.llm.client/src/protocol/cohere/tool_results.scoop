package scoop.llm.client

import scoop.json.*

internal fun encodeCohereToolResult(dialect: DialectId, call: ClientToolCallReference, content: Array<ContentPart>,
    isError: Boolean, extensions: Array<DialectExtension>, path: String): JsonValue {
    requireLlmOwner(call.dialect, dialect, path + "/call/dialect")
    val id = requireLlmToolCallId(call.id, path + "/call/id")
    if (llmPresent(call.context)) {
        val context = call.context!!
        if (context.kind != JsonValueKind.Object) throw LlmRequestException(path + "/call/context", "Cohere result context requires a function call")
        val type = context["type"]
        if (!llmPresent(type) || type!!.kind != JsonValueKind.String || type!!.asString() != "function")
            throw LlmRequestException(path + "/call/context/type", "Cohere result context requires a function call")
        val original = context["id"]
        if (!llmPresent(original) || original!!.kind != JsonValueKind.String || original!!.asString() != id)
            throw LlmRequestException(path + "/call/id", "call ID differs from the original function call")
    }
    if (isError) throw LlmRequestException(path + "/isError", "Cohere has no tool result error flag")
    val result = JsonObjectBuilder().add("role", JsonValue.fromString("tool")).add("tool_call_id", JsonValue.fromString(id))
        .add("content", encodeCohereContent(dialect, content, "tool", path + "/content")).build()
    return mergeLlmExtensions(result, extensions, dialect, cohereMessageFields(), path)
}
