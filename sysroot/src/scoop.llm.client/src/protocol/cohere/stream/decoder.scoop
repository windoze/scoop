package scoop.llm.client

import scoop.json.*

internal class CohereStreamDecoder public constructor(
    public val dialect: CohereDialect, public val request: LlmRequest, public val retention: StreamRetention
) : LlmSseDecoder {
    public val contents = ArrayList<CohereStreamContent>()
    public val calls = ArrayList<CohereStreamTool>()
    public val citations = ArrayList<CohereStreamCitation>()
    public val slots = ArrayList<CohereStreamSlot>()
    public val nativeEvents = ArrayList<LlmNativeEvent>()
    public var plan: CohereStreamContent? = None
    public var planPresent: Boolean = false
    public var message: JsonValue? = None
    public var historyAvailable: Boolean = true
    public var started: Boolean = false
    public var finished: Boolean = false
    public var id: String? = None
    public var currentUsage = LlmUsage()
    public var candidate: LlmCandidate? = None
    private var failed: Boolean = false
    public val retain: Boolean get() = retention == StreamRetention.Result

    public override val isFinished: Boolean get() = finished && !failed
    public override val responseId: String? get() = id
    public override val usage: LlmUsage get() = currentUsage

    public override fun accept(event: String, data: String): LlmStreamUpdate {
        try {
            if (finished || failed) throw LlmStreamProtocolException(dialect.id, "stream is no longer accepting events", Some(data))
            val raw = try { Json.parse(data) }
                catch (error: DecodingException) { throw LlmStreamProtocolException(dialect.id, "invalid stream JSON", Some(data)) }
            val batch = LlmStreamBatch(dialect.id, retention, nativeEvents)
            try {
                val type = decodeCohereValue<CohereKind>(raw, "").type
                cohereNonempty(type, "/type")
                if (event != "" && event != "message" && event != type)
                    throw DecodingException("/type", "SSE event name disagrees with Cohere event type")
                val known = dispatchCohereStream(this, type, raw, batch)
                val extra = llmStreamUnknown(raw, known)
                if (extra.size != 0L) batch.native(type, extra)
            } catch (error: DecodingException) {
                throw LlmProtocolException(dialect.id, error.path, error.message ?: "invalid Cohere stream", raw)
            }
            return batch.build()
        } catch (error: Throwable) { failed = true; throw error }
    }

    public fun requireActive() {
        if (!started) throw DecodingException("/type", "content event before message-start")
    }

    public override fun endInput(): LlmStreamUpdate {
        if (!isFinished) {
            failed = true
            throw LlmStreamProtocolException(dialect.id, "Cohere stream ended without message-end")
        }
        return LlmStreamUpdate([])
    }

    public override fun response(): LlmResponse {
        if (!isFinished) throw LlmOutputException(Incomplete, "stream has not finished successfully")
        if (!retain) throw LlmOutputException(ResultNotRetained, "stream result was not retained")
        return LlmResponse(dialect.id, [candidate!!], id = id, usage = currentUsage, nativeEvents = nativeEvents.toArray())
    }
}
