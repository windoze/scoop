package scoop.llm.client

import scoop.json.*

internal class CohereCall public constructor(public val id: String, public val type: String,
    public val function: JsonValue? = None) {
    public companion object : ValueDecoder<CohereCall>
}

internal class CohereFunction public constructor(public val name: String? = None, public val arguments: String? = None) {
    public companion object : ValueDecoder<CohereFunction>
}

internal fun appendCohereToolCalls(items: ArrayList<LlmOutputItem>, dialect: DialectId, calls: Array<JsonValue>,
    tools: Array<ToolDefinition>, reason: String) {
    val ids = ArrayList<String>()
    var index = 0L
    for (raw in calls) {
        val path = "/message/tool_calls/" + index.toString()
        val call = decodeCohereValue<CohereCall>(raw, path)
        cohereNonempty(call.id, path + "/id")
        cohereNonempty(call.type, path + "/type")
        for (previous in ids) if (previous == call.id) throw DecodingException(path + "/id", "duplicate tool call ID")
        ids.add(call.id)
        items.add(readCohereToolCall(dialect, raw, call, tools, reason, path))
        index += 1L
    }
}

private fun readCohereToolCall(dialect: DialectId, raw: JsonValue, call: CohereCall, tools: Array<ToolDefinition>,
    reason: String, path: String): LlmOutputItem {
    if (call.type != "function" || !llmPresent(call.function)) return LlmOutputItem.Native(dialect, raw)
    val function = decodeCohereValue<CohereFunction>(call.function!!, path + "/function")
    when (function.name) { case Some(name) -> cohereNonempty(name, path + "/function/name"); case None -> {} }
    if (function.name == None || function.arguments == None) return LlmOutputItem.Native(dialect, raw)
    val key = resolveCohereFunction(tools, function.name!!) ?: return LlmOutputItem.Native(dialect, raw)
    return cohereFunctionItem(dialect, key, call.id, raw, function.arguments!!, reason == "TOOL_CALL")
}

internal fun cohereFunctionItem(dialect: DialectId, key: ToolKey, id: String, raw: JsonValue,
    arguments: String, complete: Boolean): LlmOutputItem {
    val input = if (!complete) ClientToolInput.Incomplete(arguments)
        else try { ClientToolInput.JsonArguments(JsonToolArguments(arguments)) }
        catch (error: DecodingException) { ClientToolInput.Invalid(arguments, error.message ?: "invalid function arguments") }
    return LlmOutputItem.ClientToolCall(ClientToolCall(ClientToolCallReference(dialect, key, Some(id), Some(raw)), input))
}

internal fun resolveCohereFunction(tools: Array<ToolDefinition>, name: String): ToolKey? {
    var found: ToolKey? = None
    for (tool in tools) {
        val matches = when (tool) { case ClientFunction(_, wireName, _, _, _, _) -> wireName == name; else -> false }
        if (!matches) continue
        if (found != None) return None
        found = Some(tool.key)
    }
    return found
}
