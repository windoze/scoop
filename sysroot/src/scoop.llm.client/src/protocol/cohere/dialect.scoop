package scoop.llm.client

import scoop.json.JsonValue

/** Service accounting within the independent Cohere Chat v2 wire protocol. */
public interface CohereDialect {
    public fun modelCatalog(): LlmModelCatalog? = None
    public val id: DialectId
    public fun encodeOptions(request: LlmRequest): JsonValue
    public fun readUsage(value: JsonValue): TokenUsage
    public fun decodeError(status: UInt, body: Array<Byte>, truncated: Boolean): LlmServiceException
}

public class CohereChatDialect public constructor() : CohereDialect {
    public override fun modelCatalog(): LlmModelCatalog? = Some(CohereModelCatalog(id))
    public override val id: DialectId = DialectId(ApiProtocolId("cohere-chat-v2"), "cohere-chat-v2")
    public override fun encodeOptions(request: LlmRequest): JsonValue = encodeCohereOptions(id, request)
    public override fun readUsage(value: JsonValue): TokenUsage = readCohereUsage(value)
    public override fun decodeError(status: UInt, body: Array<Byte>, truncated: Boolean): LlmServiceException =
        decodeCohereError(id, status, body, truncated)
}
