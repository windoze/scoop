package scoop.llm.client

import scoop.json.*

internal fun encodeOllamaRequest(dialect: OllamaDialect, model: String, request: LlmRequest, stream: Boolean): JsonValue {
    if (model.length == 0L) throw LlmRequestException("/modelId", "model ID must not be empty")
    val messages = ArrayList<JsonValue>()
    if (request.system.size != 0L) messages.add(encodeOllamaMessage(dialect.id, "system", request.system, [], "/system", "/system"))
    var index = 0L
    for (item in request.input) {
        val path = "/input/" + index.toString()
        when (item) {
            case Message(content, role, extensions) -> {
                val name = when (role) {
                    case User -> "user"
                    case Assistant -> "assistant"
                    case System -> "system"
                    case Developer -> throw LlmRequestException(path + "/role", "Ollama has no developer message role")
                }
                messages.add(encodeOllamaMessage(dialect.id, name, content, extensions, path, path + "/content"))
            }
            case History(history) -> appendOllamaHistory(messages, history, dialect.id, path + "/history")
            case ToolResult(call, content, isError, extensions) ->
                messages.add(encodeOllamaToolResult(dialect.id, call, content, isError, extensions, request.tools, path))
        }
        index += 1L
    }
    val body = JsonObjectBuilder().add("model", JsonValue.fromString(model)).add("messages", JsonValue.fromArray(messages))
        .add("stream", JsonValue.fromBoolean(stream))
    for ((name, value) in dialect.encodeOptions(request).members()) {
        if (name == "model" || name == "messages" || name == "stream")
            throw LlmRequestException("/options", "dialect options cannot override Ollama routing, messages or stream mode")
        body.add(name, value)
    }
    return mergeOllamaExtensions(body.build(), request.extensions, dialect.id)
}

private fun encodeOllamaMessage(dialect: DialectId, role: String, content: Array<ContentPart>,
    extensions: Array<DialectExtension>, path: String, contentPath: String): JsonValue {
    val message = JsonObjectBuilder().add("role", JsonValue.fromString(role))
    encodeOllamaContent(message, dialect, content, contentPath)
    return mergeLlmExtensions(message.build(), extensions, dialect, ollamaMessageFields(), path)
}

internal fun ollamaMessageFields(): Array<String> = ["role", "content", "images", "tool_calls", "tool_name", "tool_call_id"]

private fun appendOllamaHistory(messages: ArrayList<JsonValue>, history: LlmHistory, dialect: DialectId, path: String) {
    requireLlmOwner(history.dialect, dialect, path + "/dialect")
    if (llmPresent(history.context)) throw LlmRequestException(path + "/context", "Ollama history has no implicit server state")
    var index = 0L
    for (item in history.items) {
        val itemPath = path + "/items/" + index.toString()
        if (item.kind != JsonValueKind.Object) throw LlmRequestException(itemPath, "history requires assistant messages")
        val role = item["role"] ?: throw LlmRequestException(itemPath + "/role", "missing history role")
        if (role.kind != JsonValueKind.String || role.asString() != "assistant")
            throw LlmRequestException(itemPath + "/role", "history requires assistant messages")
        messages.add(item)
        index += 1L
    }
}
