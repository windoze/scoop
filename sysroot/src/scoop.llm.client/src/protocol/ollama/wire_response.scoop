package scoop.llm.client

import scoop.json.*
import scoop.time.Instant

internal class OllamaBody public constructor(public val model: String, public val message: JsonValue, public val done: Boolean,
    @Serialize(rename = "done_reason") public val doneReason: String? = None,
    @Serialize(rename = "created_at") public val createdAt: Instant? = None) {
    public companion object : ValueDecoder<OllamaBody>
}

internal class OllamaMessage public constructor(public val role: String, public val content: String,
    public val thinking: String? = None, @Serialize(rename = "tool_calls") public val toolCalls: Array<JsonValue>? = None) {
    public companion object : ValueDecoder<OllamaMessage>
}

internal fun <T> decodeOllamaValue(value: JsonValue, path: String): T where T.Companion : ValueDecoder<T> {
    try { return Json.decodeFromValue<T>(value) }
    catch (error: DecodingException) { throw DecodingException(path + error.path, error.message ?: "invalid Ollama field") }
}

internal fun ollamaNonempty(value: String, path: String) {
    if (value.length == 0L) throw DecodingException(path, "expected a nonempty string")
}
