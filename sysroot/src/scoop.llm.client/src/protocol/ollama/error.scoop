package scoop.llm.client

internal fun decodeOllamaError(dialect: DialectId, status: UInt, body: Array<Byte>, truncated: Boolean): LlmServiceException {
    val value = parseLlmServiceError(body, truncated)
    val message = llmServiceErrorString(value, "error")
    return LlmServiceException(dialect, status, body, truncated, native = value, retryable = status == 429U && message != None,
        message = message ?: "Ollama service rejected the request")
}
