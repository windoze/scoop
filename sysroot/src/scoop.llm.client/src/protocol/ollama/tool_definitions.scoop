package scoop.llm.client

import scoop.json.*

internal fun encodeOllamaTools(result: JsonObjectBuilder, dialect: DialectId, request: LlmRequest) {
    val values = ArrayList<JsonValue>()
    val names = ArrayList<String>()
    var index = 0L
    for (tool in request.tools) {
        val path = "/tools/" + index.toString()
        when (tool) {
            case ClientFunction(_, name, parameters, description, strict, extensions) -> {
                if (strict != None) throw LlmRequestException(path + "/strict", "Ollama functions have no strict setting")
                for (previous in names) if (previous == name) throw LlmRequestException(path + "/name", "duplicate Ollama function name")
                names.add(name)
                val function = JsonObjectBuilder().add("name", JsonValue.fromString(name)).add("parameters", parameters)
                if (description.length != 0L) function.add("description", JsonValue.fromString(description))
                values.add(llmTypedObject("function").add("function", mergeLlmExtensions(function.build(), extensions, dialect,
                    ["type", "name", "description", "parameters", "strict"], path)).build())
            }
            else -> throw LlmRequestException(path, "Ollama Chat requires client functions")
        }
        index += 1L
    }
    if (request.options.toolChoice != ToolChoice.Auto) throw LlmRequestException("/options/toolChoice", "Ollama has no tool choice field")
    if (values.size != 0L) result.add("tools", JsonValue.fromArray(values))
}
