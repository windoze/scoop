package scoop.llm.client

import scoop.time.Duration

public enum CacheLifetimeKind {
    Expiration, MinimumRetention, MinimumReadPricing, MaximumRetention, TypicalRetention
    public companion object : ValueEncoder<CacheLifetimeKind>, ValueDecoder<CacheLifetimeKind>
}

public enum CacheLifetimeAnchor {
    RequestStart, Read, Write, Unknown
    public companion object : ValueEncoder<CacheLifetimeAnchor>, ValueDecoder<CacheLifetimeAnchor>
}

/** A service rule; minimum pricing coverage and maximum retention are not expiry promises. */
public class CacheLifetime public constructor(
    public val duration: Duration,
    public val kind: CacheLifetimeKind,
    public val anchor: CacheLifetimeAnchor,
    public val upperDuration: Duration? = None
) {
    init {
        if (duration < Duration.ZERO) throw IllegalArgumentException(Some("cache lifetime must not be negative"))
        if (upperDuration != None && upperDuration!! < duration)
            throw IllegalArgumentException(Some("cache lifetime range is reversed"))
    }
    public companion object : ValueEncoder<CacheLifetime>, ValueDecoder<CacheLifetime>
}

internal fun sameCacheReport(first: CacheReport, second: CacheReport): Boolean {
    if (first.key != second.key || first.dialect != second.dialect || first.operation != second.operation ||
        first.tokens != second.tokens || first.scope != second.scope || first.refreshesLifetime != second.refreshesLifetime ||
        first.reportedExpiresAt != second.reportedExpiresAt || first.lifetimes.size != second.lifetimes.size) return false
    var index = 0L
    for (rule in first.lifetimes) {
        val other = second.lifetimes[index]
        if (rule.duration != other.duration || rule.kind != other.kind || rule.anchor != other.anchor || rule.upperDuration != other.upperDuration)
            return false
        index += 1L
    }
    return true
}
