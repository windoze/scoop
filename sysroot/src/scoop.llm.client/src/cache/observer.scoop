package scoop.llm.client

/** Pure accounting interpretation prepared from the actual encoded generation request. */
public interface LlmCacheObserver {
    public fun observe(usage: LlmUsage): Array<CacheReport>
}

internal class DefaultCacheObserver(val dialect: DialectId) : LlmCacheObserver {
    public override fun observe(usage: LlmUsage): Array<CacheReport> {
        val result = ArrayList<CacheReport>()
        if (usage.tokens.cacheReadTokens != None) result.add(CacheReport("read", dialect, Read, usage.tokens.cacheReadTokens))
        if (usage.tokens.cacheWriteTokens != None) result.add(CacheReport("write", dialect, Write, usage.tokens.cacheWriteTokens))
        return result.toArray()
    }
}

internal fun updateCacheObservations(previous: Array<CacheObservation>, reports: Array<CacheReport>, point: LlmTimePoint): Array<CacheObservation> {
    val result = ArrayList<CacheObservation>()
    for (report in reports) {
        for (existing in result) if (existing.report.key == report.key)
            throw IllegalArgumentException(Some("duplicate cache report key"))
        var observed = point
        for (existing in previous) {
            if (sameCacheReport(existing.report, report)) { observed = existing.observed; break }
        }
        result.add(CacheObservation(report, observed))
    }
    return result.toArray()
}
