package scoop.llm.client

import scoop.time.Instant

public enum CacheOperation {
    Read, Write
    public companion object : ValueEncoder<CacheOperation>, ValueDecoder<CacheOperation>
}

/** A known affected scope, not merely a requested breakpoint or routing key. */
public enum CacheScope {
    Unknown, Prefix(String), Resource(String)
    public companion object : ValueEncoder<CacheScope>, ValueDecoder<CacheScope>
}

/** Stable keys identify one accounting portion within an attempt, never a global cache entry. */
public class CacheReport public constructor(
    public val key: String,
    public val dialect: DialectId,
    public val operation: CacheOperation,
    public val tokens: Long? = None,
    public val scope: CacheScope = Unknown,
    public val lifetimes: Array<CacheLifetime> = [],
    public val refreshesLifetime: Boolean? = None,
    public val reportedExpiresAt: Instant? = None
) {
    init {
        if (key.length == 0L) throw IllegalArgumentException(Some("cache report key must not be empty"))
        requireTokenCount(tokens, "cache tokens")
    }
    public companion object : ValueEncoder<CacheReport>, ValueDecoder<CacheReport>
}

/** An immutable report paired with the local point where that report was first observed. */
public class CacheObservation public constructor(public val report: CacheReport, public val observed: LlmTimePoint) {
    public companion object : ValueEncoder<CacheObservation>, ValueDecoder<CacheObservation>
}
