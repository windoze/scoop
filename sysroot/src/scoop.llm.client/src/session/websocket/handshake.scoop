package scoop.llm.client

import scoop.asyncio.useAsync
import scoop.http.client.*
import scoop.url.Url

internal suspend fun openLlmWebSocketHandshake(state: LlmWebSocketState, scope: CoroutineScope,
    options: LlmCallOptions, webSocketOptions: HttpWebSocketOptions, prepare: () -> Url,
    initialize: suspend (LlmCallState, HttpWebSocketSession) -> Unit): (LlmWebSocketConnection, LlmCallMetadata) {
    val acquired = LlmWebSocketAcquired()
    try {
        return executeLlmCall<LlmWebSocketConnection>(state.call.client, options) suspend { call ->
            val url = prepare()
            val socket = performLlmWebSocketHandshake(call, state.endpoint, url, options, webSocketOptions)
            acquired.value = Some(socket)
            scope.launch suspend {
                var failure: Throwable? = None
                try { socket.awaitClosed(); failure = socket.failure }
                catch (error: Throwable) { failure = Some(error) }
                state.socketEnd(failure)
            }
            try { initialize(state.call, socket) }
            catch (error: Throwable) { acquired.closeAfter(error) }
            LlmWebSocketConnection(state, socket)
        }
    } catch (error: Throwable) { acquired.closeAfter(error) }
}

private class LlmWebSocketAcquired {
    var value: HttpWebSocketSession? = None
    suspend fun closeAfter(error: Throwable): Nothing {
        val socket = value; value = None
        try { socket?.close() }
        catch (cleanup: Throwable) { throw ResourceUseException(error, cleanup) }
        throw error
    }
}

private suspend fun performLlmWebSocketHandshake(call: LlmCallState, endpoint: LlmEndpoint, url: Url,
    options: LlmCallOptions, webSocketOptions: HttpWebSocketOptions): HttpWebSocketSession {
    val httpUrl = url.toBuilder().setScheme(Some(if (url.scheme == Some("ws")) "http" else "https")).build()
    var retry = 0L
    var backoff = options.retries.initialDelay
    while (true) {
        ensureActive()
        val attempt = LlmAttemptState(call, retry + 1L)
        val rejection = try {
            val fields = awaitLlmAuth(endpoint, HttpRequest.get(httpUrl, endpoint.fields), [])
            ensureActive()
            val request = HttpWebSocketRequest(url, fields, llmHttpCallOptions(call.client.http, options, attempt))
            when (call.client.http.openWebSocket(request, webSocketOptions)) {
                case Opened(socket) -> {
                    identifyLlmRequest(socket.head.fields, attempt)
                    attempt.completeOperation()
                    return socket
                }
                case Rejected(response, cause) -> response.useAsync suspend { _ ->
                    if (response.status < 300U) throw cause
                    readLlmRejection(response, endpoint, options, attempt)!!
                }
            }
        } finally { call.attempts.add(attempt.snapshot()) }
        if (!rejection.retryable || retry >= options.retries.maxRetries) throw rejection
        ensureActive()
        call.client.loop.sleep(if (attempt.retryAfter > backoff) attempt.retryAfter else backoff)
        retry += 1L
        backoff = if (backoff > options.retries.maxDelay - backoff) options.retries.maxDelay else backoff + backoff
    }
}
