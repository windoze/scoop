package scoop.llm.client

import scoop.json.JsonObjectBuilder
import scoop.json.JsonValue
import scoop.json.JsonValueKind

internal class LlmStreamBatch public constructor(
    private val dialect: DialectId, private val retention: StreamRetention,
    private val retained: ArrayList<LlmNativeEvent>
) {
    public val events: ArrayList<LlmEvent> = ArrayList<LlmEvent>()
    public var hasOutput: Boolean = false
    public var hasText: Boolean = false
    public var isKeepAlive: Boolean = false

    public fun observe(text: String, plain: Boolean = false) {
        if (text.length == 0L) return
        hasOutput = true
        if (plain) hasText = true
    }

    public fun native(event: String, value: JsonValue, location: LlmItemLocation? = None, retain: Boolean = true) {
        val entry = LlmNativeEvent(dialect, event, value, location)
        events.add(LlmEvent.Native(entry))
        if (retain && retention == StreamRetention.Result) retained.add(entry)
    }

    public fun build(): LlmStreamUpdate = LlmStreamUpdate(events.toArray(), hasOutput, hasText, isKeepAlive)
}

internal fun llmStreamIdentity(previous: String?, incoming: String?, path: String): String? {
    if (previous != None && incoming != None && previous != incoming)
        throw DecodingException(path, "stream identity changed")
    return if (incoming != None) incoming else previous
}

internal fun llmStreamUnknown(value: JsonValue, known: Array<String>): JsonValue {
    val result = JsonObjectBuilder()
    for ((name, field) in value.members()) {
        var recognized = false
        for (key in known) { if (key == name) recognized = true }
        if (!recognized) result.add(name, field)
    }
    return result.build()
}

/** Usage is a cumulative report. Missing or null fields never erase an earlier reported count. */
internal fun mergeLlmStreamUsage(previous: JsonValue, incoming: JsonValue): JsonValue {
    if (incoming.kind == JsonValueKind.Null) return previous
    if (previous.kind != JsonValueKind.Object || incoming.kind != JsonValueKind.Object) return incoming
    val result = JsonObjectBuilder()
    for ((name, value) in previous.members()) {
        val replacement = incoming[name]
        result.add(name, when (replacement) {
            case Some(next) -> mergeLlmStreamUsage(value, next)
            case None -> value
        })
    }
    for ((name, value) in incoming.members()) {
        if (!previous.containsKey(name)) result.add(name, value)
    }
    return result.build()
}
