package scoop.llm.client

import scoop.http.*
import scoop.http.client.*
import scoop.url.Url

internal suspend fun prepareLlmHttpRequest(http: HttpClient, endpoint: LlmEndpoint, url: Url, bytes: Array<Byte>,
    options: LlmCallOptions, attempt: LlmAttemptState, method: String = "POST"): HttpRequest {
    val body = if (bytes.size == 0L) RequestBody.Empty else RequestBody.fromByteArray(bytes, Some(HttpMediaType.parse("application/json")))
    val prepared = HttpRequest(url, method, endpoint.fields, body)
    val authentication = awaitLlmAuth(endpoint, prepared, bytes)
    ensureActive()
    return HttpRequest(url, method, authentication, body, llmHttpCallOptions(http, options, attempt))
}

internal fun llmHttpCallOptions(http: HttpClient, options: LlmCallOptions, attempt: LlmAttemptState): HttpCallOptions {
    val base = http.defaultTimeouts
    val timeouts = HttpTimeoutOptions(total = None, poolAcquire = base.poolAcquire, responseHeaders = options.timeouts.responseHeaders,
        resolve = base.resolve, connect = base.connect, tlsHandshake = base.tlsHandshake, readIdle = options.timeouts.readIdle,
        writeIdle = options.timeouts.writeIdle, proxyHandshake = base.proxyHandshake)
    return HttpCallOptions(timeouts = Some(timeouts), redirects = Some(HttpRedirectOptions(enabled = false)),
        retries = Some(HttpRetryOptions(maxRetries = 0L)), authentication = Some(HttpAuthenticationOptions()),
        useCookies = false, cacheMode = HttpCacheMode.Bypass,
        observer = Some(HttpObserver(suspend { event -> attempt.observe(event.metrics) })))
}

internal suspend fun awaitLlmAuth(endpoint: LlmEndpoint, request: HttpRequest, bytes: Array<Byte>): Array<HttpField> {
    val fields = ArrayList<HttpField>()
    for (field in request.fields) fields.add(field)
    val added = endpoint.authentication.fields(LlmAuthRequest(request.method, request.url, request.fields, bytes))
    for (field in added) {
        for (existing in fields) {
            if (existing.hasName(field.name)) throw IllegalArgumentException(Some("LLM authentication field duplicates a request field"))
        }
        fields.add(field)
    }
    return fields.toArray()
}
