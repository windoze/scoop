package scoop.llm.client

import scoop.platform.time.MonotonicTimeSource
import scoop.time.Duration

internal suspend fun <T> executeLlmCall(client: LlmClientState, options: LlmCallOptions,
    operation: suspend (LlmCallState) -> T): (T, LlmCallMetadata) {
    val caller = currentJobOrNone()
    return nonCancellableScope suspend { lifetime ->
        val call = LlmCallState(client, lifetime.job)
        context(call) {
            try { return@nonCancellableScope runLlmCall(call, caller, options, operation) }
            finally { call.contextActive = false; removeLlmCall(client, call) }
        }
    }
}

private suspend fun <T> runLlmCall(call: LlmCallState, caller: Job?, options: LlmCallOptions,
    operation: suspend (LlmCallState) -> T): (T, LlmCallMetadata) {
    var response: T? = None
    var failure: Throwable? = None
    val listener = caller?.invokeOnCancellation { reason -> call.stop(reason) }
    try {
        registerLlmCall(call.client, call)
        response = Some(coroutineScope suspend { scope ->
            call.bind(scope.job)
            ensureActive()
            val timer = when (options.timeouts.total) {
                case Some(limit) -> Some(scope.launch suspend {
                    val remaining = limit - (MonotonicTimeSource.markNow() - call.started)
                    if (remaining > Duration.ZERO) call.client.loop.sleep(remaining)
                    call.timeout(limit)
                })
                case None -> None
            }
            try {
                ensureActive()
                return@coroutineScope operation(call)
            } finally {
                timer?.cancel()
                nonCancellableScope suspend { _ -> timer?.join(); Unit }
            }
        })
    } catch (error: Throwable) { failure = Some(error) }
    finally { listener?.dispose() }
    val selected = call.finish(failure)
    val outcome = when (selected) {
        case None -> LlmCallOutcome.Completed
        case Some(error) -> if (error is CancellationException) LlmCallOutcome.Cancelled else LlmCallOutcome.Failed
    }
    val metadata = LlmCallMetadata(call.id, call.startedAt, call.attempts.toArray(), Some(call.point()), outcome)
    try { options.onFinished?.invoke(metadata) }
    catch (callback: Throwable) {
        when (selected) { case Some(error) -> throw ResourceUseException(error, callback); case None -> throw callback }
    }
    when (selected) { case Some(error) -> throw error; case None -> return (response!!, metadata) }
}
