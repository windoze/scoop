package scoop.llm.client

import scoop.json.JsonValue
import scoop.url.Url

internal suspend fun <T> performLlmJsonRequest(call: LlmCallState, endpoint: LlmEndpoint, url: Url, bytes: Array<Byte>,
    options: LlmCallOptions, method: String = "POST", decode: (JsonValue, LlmAttemptState) -> T): T {
    var retry = 0L
    var backoff = options.retries.initialDelay
    while (true) {
        ensureActive()
        val attempt = LlmAttemptState(call, retry + 1L)
        val result = try { executeLlmAttempt<T>(call.client.http, endpoint, url, bytes, options, attempt, method, decode) }
        finally { call.attempts.add(attempt.snapshot()) }
        val rejection = when (result) { case Success(response) -> return response; case Rejected(error) -> error }
        if (!rejection.retryable || retry >= options.retries.maxRetries) throw rejection
        ensureActive()
        val delay = if (attempt.retryAfter > backoff) attempt.retryAfter else backoff
        call.client.loop.sleep(delay)
        retry += 1L
        backoff = if (backoff > options.retries.maxDelay - backoff) options.retries.maxDelay else backoff + backoff
    }
}
