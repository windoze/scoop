package scoop.llm.client

import scoop.asyncio.*
import scoop.http.client.HttpClient
import scoop.http.client.HttpWebSocketOptions

/** A reusable generation client with explicit ownership of calls and optional HTTP transport. */
public class LlmClient private constructor(internal val state: LlmClientState) : AsyncCloseable {
    public companion object {
        public suspend fun open(scope: CoroutineScope, httpClient: HttpClient? = None): LlmClient {
            scope.job.ensureActive()
            ensureActive()
            val http = httpClient ?: HttpClient.open(scope)
            val owned = when (httpClient) { case None -> true; case Some(_) -> false }
            val state = LlmClientState(currentEventLoop(), http, owned)
            try {
                startLlmOwner(state, scope)
                scope.job.ensureActive()
                ensureActive()
                if (!state.lock.withLock { state.adopted }) throw LlmClientClosedException()
                return LlmClient(state)
            } catch (error: Throwable) {
                try {
                    if (state.lock.withLock { state.adopted }) closeLlmClient(state)
                    else if (owned) http.close()
                } catch (cleanup: Throwable) { throw ResourceUseException(error, cleanup) }
                throw error
            }
        }
    }

    public val isClosed: Boolean get() = state.lock.withLock { state.closed }

    public suspend fun generate(model: LlmModel, request: LlmRequest, options: LlmCallOptions = LlmCallOptions()): LlmResult =
        generateLlm(state, model, request, options)

    public suspend fun countTokens(model: LlmModel, request: LlmRequest, options: LlmCallOptions = LlmCallOptions()): LlmTokenCountResult =
        countLlmTokens(state, model, request, options)

    public suspend fun compactResponse(model: LlmModel, request: LlmRequest,
        options: LlmCallOptions = LlmCallOptions()): ResponsesCompactionResult = compactLlmResponse(state, model, request, options)

    public suspend fun retrieveResponse(endpoint: LlmEndpoint, responseId: String, tools: Array<ToolDefinition> = [],
        include: Array<String> = [], options: LlmCallOptions = LlmCallOptions()): LlmResult =
        readStoredLlmResponse(state, endpoint, responseId, tools, include, options, false)

    public suspend fun cancelResponse(endpoint: LlmEndpoint, responseId: String, tools: Array<ToolDefinition> = [],
        options: LlmCallOptions = LlmCallOptions()): LlmResult =
        readStoredLlmResponse(state, endpoint, responseId, tools, [], options, true)

    public suspend fun deleteResponse(endpoint: LlmEndpoint, responseId: String,
        options: LlmCallOptions = LlmCallOptions()): ResponsesDeletionResult =
        deleteStoredLlmResponse(state, endpoint, responseId, options)

    public suspend fun openStream(model: LlmModel, request: LlmRequest, options: LlmCallOptions = LlmCallOptions(),
        retention: StreamRetention = EventsOnly): LlmStream = openLlmStream(state, model, request, options, retention)

    public suspend fun <T> withStream(model: LlmModel, request: LlmRequest, options: LlmCallOptions = LlmCallOptions(),
        retention: StreamRetention = EventsOnly, block: suspend (LlmStream) -> T): T =
        openStream(model, request, options, retention).useAsync(block)

    public suspend fun openResponsesSession(endpoint: LlmEndpoint, handshakeOptions: LlmCallOptions = LlmCallOptions(),
        webSocketOptions: HttpWebSocketOptions = HttpWebSocketOptions()): ResponsesSession =
        openResponsesSessionState(state, endpoint, handshakeOptions, webSocketOptions)

    public suspend fun <T> withResponsesSession(endpoint: LlmEndpoint, handshakeOptions: LlmCallOptions = LlmCallOptions(),
        webSocketOptions: HttpWebSocketOptions = HttpWebSocketOptions(), block: suspend (ResponsesSession) -> T): T =
        openResponsesSession(endpoint, handshakeOptions, webSocketOptions).useAsync(block)

    public override suspend fun close() { closeLlmClient(state) }
}

/** The same client and request API with scoped opening and cleanup. */
public suspend fun <T> withLlmClient(httpClient: HttpClient? = None, block: suspend (LlmClient) -> T): T =
    coroutineScope suspend { scope -> LlmClient.open(scope, httpClient).useAsync(block) }
