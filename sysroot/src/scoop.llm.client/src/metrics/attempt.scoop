package scoop.llm.client

import scoop.time.Duration

/** Timing and usage for one attempt; retries retain separate send and receive observations. */
public class LlmAttemptMetadata public constructor(
    public val number: Long,
    public val request: LlmRequestTiming = LlmRequestTiming(),
    public val response: LlmResponseTiming = LlmResponseTiming(),
    public val status: UInt? = None,
    public val requestId: String? = None,
    public val responseId: String? = None,
    public val usage: LlmUsage = LlmUsage(),
    public val http: LlmHttpTiming = LlmHttpTiming(),
    public val cacheObservations: Array<CacheObservation> = []
) {
    @Serialize(ignore = true) public val timeToHeaders: Duration? = pointDuration(request.sent, response.received)
    @Serialize(ignore = true) public val timeToFirstOutput: Duration? = pointDuration(request.sent, response.firstOutput)
    @Serialize(ignore = true) public val timeToFirstText: Duration? = pointDuration(request.sent, response.firstText)
    @Serialize(ignore = true) public val responseLatency: Duration? = pointDuration(request.sent, response.completed)

    init {
        if (number < 1L) throw IllegalArgumentException(Some("attempt number must be positive"))
    }

    /** End-to-end output throughput; absent data and zero elapsed time remain unknown. */
    public val outputTokensPerSecond: Double? get() {
        if (usage.completeness != UsageCompleteness.Final) return None
        val count = usage.tokens.outputTokens ?: return None
        val elapsed = responseLatency ?: return None
        if (elapsed == Duration.ZERO) return None
        val seconds = elapsed.floorSeconds.toDouble() + elapsed.nanosecondsOfSecond.toDouble() / 1000000000.0
        return Some(count.toDouble() / seconds)
    }

    public companion object : ValueEncoder<LlmAttemptMetadata>, ValueDecoder<LlmAttemptMetadata>

    public fun estimateCacheLifetime(observationIndex: Long, lifetimeIndex: Long = 0L): CacheLifetimeEstimate? {
        val observation = cacheObservations[observationIndex]
        if (observation.report.lifetimes.size == 0L && lifetimeIndex == 0L) return None
        return estimateLlmCacheLifetime(observation, request, lifetimeIndex)
    }
}
