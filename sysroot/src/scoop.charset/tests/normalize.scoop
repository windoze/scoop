package scoop.charset

import scoop.io.encoding.Base64
import scoop.test.*

@Test
private class CharsetNormalizationTest {
    @Test
    fun `NFC composes and reorders canonical text with Hangul and composition exclusions`() {
        for (pair in [
            ("e\u{0301}", "é"),
            ("a\u{0315}\u{0300}", "à\u{0315}"),
            ("\u{212B}", "Å"),
            ("\u{0344}", "\u{0308}\u{0301}"),
            ("\u{1100}\u{1161}\u{11A8}", "각"),
            ("\u{1D15E}", "\u{1D157}\u{1D165}")
        ]) {
            val (input, expected) = pair
            assertEquals(expected, normalizeNfc(input))
            assertEquals(expected, normalizeNfc(expected))
        }
    }

    @Test
    fun `NFC preserves compatibility characters case embedded NUL and BOM`() {
        for (text in ["", "ﬀ①Ａ", "Aßİ", "\u{0000}", "x\u{FEFF}y"]) assertEquals(text, normalizeNfc(text))
        val input = "\u{FEFF}\u{0000}e\u{0301}\u{0000}"
        assertEquals("\u{FEFF}\u{0000}é\u{0000}", normalizeNfc(input))
        assertEquals("\u{FEFF}\u{0000}e\u{0301}\u{0000}", input)
        assertEquals(normalizeNfc("a\u{0301}\u{0323}"), normalizeNfc("a\u{0323}\u{0301}"))
    }

    @Test
    fun `normalized credentials combine with charset conversion and Base64`() {
        val user = normalizeNfc("Jose\u{0301}")
        val password = normalizeNfc("pa\u{0308}ss")
        val text = user + ":" + password
        assertEquals("José:päss", text)
        assertEquals("Sm9zw6k6cMOkc3M=", Base64.Default.encode(Charset.Utf8.encode(text)))
        assertEquals(text, Charset.Utf16LE.decode(Charset.Utf16LE.encode(text)))
        assertEquals(text, Charset.Iso8859_1.decode(Charset.Iso8859_1.encode(text)))
    }
}

