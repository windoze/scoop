//! dep: scoop:scoop.charset:0.1.0

import scoop.charset.*

fun main() {
    val decomposed = "Jose\u{0301}"
    val normalized = normalizeNfc(decomposed)
    println(normalized)
    println(f"before=${decomposed.length}, after=${normalized.length}")

    for (cluster in graphemes("A👩‍💻e\u{0301}")) {
        println(cluster)
    }
}
