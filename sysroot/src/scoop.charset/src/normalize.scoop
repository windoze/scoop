package scoop.charset

/**
 * Returns Unicode text in canonical composition form NFC.
 */
public fun normalizeNfc(text: String): String {
    @Unsafe {
        val input = text.toByteArray()
        val result = input.withDataPointer { data, size ->
            @Unsafe { return@withDataPointer charsetNormalizeNfc(data, size) }
        }
        try {
            if (result.code != 0) {
                throw CharsetException("normalize NFC", "UTF-8", "UTF-8", CharsetFailureKind.Backend, None,
                    if (result.backend == 0) None else Some(result.backend),
                    "Rust text backend could not normalize NFC")
            }
            val output = Array<Byte>(result.size) { index -> @Unsafe { return@Array result.data!!.load(index) } }
            return String.fromUtf8(output)
        } finally { normalizedTextFree(result.data, result.size) }
    }
}

@Extern(name = "scoop_charset_normalize_nfc")
private fun charsetNormalizeNfc(data: Ptr<Byte>, size: Long): NativeCharsetText

@Extern(name = "scoop_text_free")
private fun normalizedTextFree(data: Ptr<Byte>?, size: Long)

