package scoop.charset

import scoop.platform.memory.NativeByteBuffer

/**
 * A stateful native converter between two encodings. Close it after use, including after a
 * conversion failure.
 *
 * Calls must not overlap. Once final input is accepted, no further nonempty input may be supplied;
 * continue draining output until [CharsetState.Finished].
 */
public class CharsetTranscoder public constructor(
    /**
     * The encoding of bytes read from the input buffer.
     */
    public val source: Charset,
        /**
         * The encoding of bytes appended to the output buffer.
         */
        public val destination: Charset,
    options: CharsetTranscodeOptions = CharsetTranscodeOptions()
) : Closeable {
    private var handle: ULong = createCharset(source, destination, options)
    private var ending: Boolean = false
    private var finished: Boolean = false
    private var failed: Boolean = false
    private val busy: AtomicBoolean = AtomicBoolean(false)

    /**
     * Converts readable input into writable output and advances both buffers by the returned byte
     * counts. Set `endInput` for the final input; repeat calls as requested by [CharsetStep.state]
     * until finished.
     *
     * @throws IllegalStateException The converter is closed, failed, already in use, or receives
     * input after completion.
     * @throws CharsetException Conversion violates the selected text or BOM policy.
     */
    public fun process(input: NativeByteBuffer, output: NativeByteBuffer, endInput: Boolean = false): CharsetStep {
        enter()
        try {
            if (handle == 0UL || failed) throw IllegalStateException(Some("transcoder is closed or failed"))
            val count = input.readableBytes
            if (ending && count > 0L) throw IllegalStateException(Some("charset input has ended"))
            if (finished) return CharsetStep(0L, 0L, CharsetState.Finished)
            val step = processCharset(handle, input, output, endInput || ending)
            if (endInput && step.consumed == count) ending = true
            if (step.code != 0) {
                failed = true
                checkCharset(step.code, step.backend, "transcode", source.name, destination.name, Some(step.offset))
            }
            val state = when (step.status) {
                case 0 -> CharsetState.NeedInput
                case 1 -> CharsetState.NeedOutput
                case 2 -> CharsetState.Finished
                else -> throw IllegalStateException(Some("invalid charset progress"))
            }
            finished = state == CharsetState.Finished
            return CharsetStep(step.consumed, step.produced, state)
        } finally { busy.store(false) }
    }

    private fun enter() {
        if (!busy.compareAndSet(false, true)) throw IllegalStateException(Some("transcoder is already in use"))
    }

    /**
     * Releases the native conversion state. Repeated closes are allowed, but a close must not
     * overlap a conversion call.
     */
    public override fun close() {
        enter()
        try {
            val owned = handle
            handle = 0UL
            if (owned != 0UL) @Unsafe { charsetFree(owned) }
        } finally { busy.store(false) }
    }

    release { if (handle != 0UL) @Unsafe { charsetFree(handle) } }
}
