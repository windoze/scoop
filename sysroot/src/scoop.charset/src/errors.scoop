package scoop.charset

/**
 * The text, option, or backend category of a failed conversion.
 */
public enum CharsetFailureKind {
    /**
     * The source contains invalid byte sequences for its encoding.
     */
    MalformedInput,
        /**
         * Final input ends partway through an encoded sequence.
         */
        IncompleteInput,
        /**
         * The destination encoding cannot represent a source character.
         */
        UnmappableCharacter,
        /**
         * The selected decoding policy requires an initial BOM that is absent.
         */
        MissingBom,
        /**
         * An initial BOM conflicts with the selected encoding or byte order.
         */
        ConflictingBom,
        /**
         * The selected encoding and conversion options are incompatible.
         */
        InvalidOptions,
        /**
         * The native converter could not complete the requested operation.
         */
        Backend
}

/**
 * A requested name or alias is not supported by the conversion backend.
 */
public class UnsupportedCharsetException public constructor(
    /**
     * The unsupported name supplied by the caller.
     */
    public val name: String) :
    Exception(Some("unsupported charset: " + name))

/**
 * A conversion failure carrying the operation, source and destination encodings, failure kind, and
 * available byte-offset/backend details.
 */
public class CharsetException public constructor(
    /**
     * The conversion operation that failed.
     */
    public val operation: String,
        /**
         * The source encoding name used for the operation.
         */
        public val source: String,
        /**
         * The destination encoding name used for the operation.
         */
        public val destination: String,
    /**
     * The structured category of the conversion failure.
     */
    public val kind: CharsetFailureKind,
        /**
         * The input byte offset associated with the failure, when available.
         */
        public val offset: Long?,
    /**
     * The native backend error code, when available.
     */
    public val backendCode: Int?,
        /**
         * A human-readable explanation of the conversion failure.
         */
        public val detail: String
) : Exception(Some(operation + ": " + detail))

internal fun checkCharset(code: Int, backend: Int, operation: String, source: String, destination: String, offset: Long? = None) {
    if (code == 0) return
    val kind = when (code) {
        case 3 -> CharsetFailureKind.MalformedInput
        case 4 -> CharsetFailureKind.UnmappableCharacter
        case 5 -> CharsetFailureKind.IncompleteInput
        case 6 -> CharsetFailureKind.MissingBom
        case 7 -> CharsetFailureKind.ConflictingBom
        case 8 -> CharsetFailureKind.InvalidOptions
        else -> CharsetFailureKind.Backend
    }
    val detail = when (kind) {
        case MalformedInput -> "invalid byte sequence"
        case IncompleteInput -> "incomplete byte sequence at end of input"
        case UnmappableCharacter -> "character cannot be represented in the destination charset"
        case MissingBom -> "a byte order mark or an explicit default byte order is required"
        case ConflictingBom -> "byte order mark conflicts with the selected byte order"
        case InvalidOptions -> "BOM or byte order option does not apply to the selected charset"
        case Backend -> "libiconv failed with code " + backend.toString()
    }
    throw CharsetException(operation, source, destination, kind, offset,
        if (backend == 0) None else Some(backend), detail)
}
