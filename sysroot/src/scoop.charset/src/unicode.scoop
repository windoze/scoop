package scoop.charset

/** Returns extended-grapheme boundaries as scalar indices, including both ends. */
public fun graphemeBoundaries(text: String): Array<Long> {
    val input = text.toByteArray()
    val breaks = MutableArray<Byte>(input.size) { 0.toByte() }
    @Unsafe {
        input.withDataPointer { data, size ->
            @Unsafe {
                breaks.withDataPointer { output, _ ->
                    @Unsafe {
                        checkCharset(nativeGraphemeBreaks(data, size, output), 0,
                            "segment graphemes", "UTF-8", "UTF-8")
                    }
                }
            }
        }
    }
    val result = ArrayList<Long>()
    var scalar = 0L
    var offset = 0L
    for (character in text) {
        if (breaks[offset] != 0) result.add(scalar)
        scalar += 1L
        offset += character.toString().byteLength
    }
    result.add(scalar)
    return result.toArray()
}

/** Splits text into independent extended-grapheme strings. */
public fun graphemes(text: String): Array<String> {
    val boundaries = graphemeBoundaries(text)
    return Array<String>(boundaries.size - 1L) { index -> text.slice(boundaries[index], boundaries[index + 1L]) }
}

/** Returns non-CJK terminal scalar width, or -1 for a control character including NUL. */
public fun unicodeScalarWidth(character: Char): Int {
    @Unsafe { return nativeScalarWidth(character.code) }
}

/** Tests Unicode Alphabetic or Decimal_Number without using the process locale. */
public fun isUnicodeAlphanumeric(character: Char): Boolean {
    @Unsafe { return nativeAlphanumeric(character.code) }
}

/** Applies root-locale lowercase with full string context and multi-scalar mappings. */
public fun unicodeLowercase(text: String): String = convertCase(text, 0)
/** Applies root-locale uppercase with full string context and multi-scalar mappings. */
public fun unicodeUppercase(text: String): String = convertCase(text, 1)
/** Applies locale-independent Unicode full case folding for caseless matching. */
public fun unicodeCasefold(text: String): String = convertCase(text, 2)

private fun convertCase(text: String, mode: Int): String {
    @Unsafe {
        val input = text.toByteArray()
        val result = input.withDataPointer { data, size -> @Unsafe { return@withDataPointer nativeCase(data, size, mode) } }
        try {
            checkCharset(result.code, result.backend, "convert Unicode case", "UTF-8", "UTF-8")
            val output = Array<Byte>(result.size) { index -> @Unsafe { return@Array result.data!!.load(index) } }
            return String.fromUtf8(output)
        } finally { charsetTextFree(result.data, result.size) }
    }
}

@Extern(name = "scoop_charset_grapheme_breaks")
private fun nativeGraphemeBreaks(data: Ptr<Byte>, size: Long, breaks: Ptr<Byte>): Int
@Extern(name = "scoop_charset_scalar_width")
private fun nativeScalarWidth(scalar: Int): Int
@Extern(name = "scoop_charset_alphanumeric")
private fun nativeAlphanumeric(scalar: Int): Boolean
@Extern(name = "scoop_charset_case")
private fun nativeCase(data: Ptr<Byte>, size: Long, mode: Int): NativeCharsetText
