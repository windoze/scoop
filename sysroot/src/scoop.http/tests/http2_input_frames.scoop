package scoop.http

import scoop.bytes.ByteArrayBuilder
import scoop.test.*

@Test private class Http2InputFrameProgressTests {
    @Test fun `padding priority and CONTINUATION count toward their own stream while control and extensions do not`() {
        Http2Session.server().use { server ->
            val block = headerBlock2(rawRequestFields2([HttpField("x-name".toByteArray(), "value".toByteArray())]))
            val padding = Array<Byte>(2L) { _ -> 0.toByte() }
            val firstPayload = ByteArrayBuilder().append(2.toByte()).append(Array<Byte>(5L) { _ -> 0.toByte() })
                .append(Array<Byte>(10L) { index -> block[index] }).append(padding).toByteArray()
            val first = frame2(1, 40, 1, firstPayload)
            val continuation = frame2(9, 4, 1, Array<Byte>(block.size - 10L) { index -> block[index + 10L] })
            val other = frame2(1, 4, 3, headerBlock2(rawRequestFields2()))
            val data = frame2(0, 8, 1, ByteArrayBuilder().append(2.toByte()).append("ab".toByteArray()).append(padding).toByteArray())
            val otherData = frame2(0, 1, 3, "z".toByteArray())
            val trailer = frame2(1, 5, 1, headerBlock2([HttpField("x-end".toByteArray(), "yes".toByteArray())]))
            val ping = frame2(6, 0, 0, Array<Byte>(8L) { _ -> 0.toByte() })
            val extension = frame2(99, 0, 0, "ignored opaque extension".toByteArray())
            val wire = ByteArrayBuilder().append(clientPreface2()).append(first).append(continuation).append(ping)
                .append(other).append(data).append(extension).append(otherData).append(trailer).toByteArray()
            val progress = inputProgress2(server, wire, wire.size)
            assertEquals(first.size + continuation.size + data.size + trailer.size, inputTotal2(progress, 1))
            assertEquals(other.size + otherData.size, inputTotal2(progress, 3))
            for (part in progress) assertTrue(part.streamId == 1 || part.streamId == 3)
            val events = events2(server)
            assertEquals(2L, requests2(events).size)
            assertEquals("ab", String.fromUtf8(data2(events, 1)))
            assertEquals("z", String.fromUtf8(data2(events, 3)))
            assertEquals(1, ends2(events, 1))
            assertEquals(1, ends2(events, 3))
        }
    }

    @Test fun `ignored data after reset cannot hide the next valid stream input`() {
        Http2Session.server().use { server ->
            receive2(server, clientPreface2())
            receive2(server, frame2(1, 4, 1, headerBlock2(rawRequestFields2())))
            server.reset(1)
            output2(server)
            events2(server)
            val ignored = frame2(0, 0, 1, Array<Byte>(131L) { _ -> 65.toByte() })
            val valid = frame2(1, 5, 3, headerBlock2(rawRequestFields2()))
            val wire = ByteArrayBuilder().append(ignored).append(valid).toByteArray()
            val progress = inputProgress2(server, wire, wire.size)
            assertEquals(0L, inputTotal2(progress, 1))
            assertEquals(valid.size, inputTotal2(progress, 3))
            assertEquals(1L, requests2(events2(server)).size)
        }
    }

    @Test fun `a normally closed native stream still returns its final response input progress`() {
        Http2Session.client().use { client ->
            val id = client.submitRequest(request2())
            output2(client)
            receive2(client, frame2(4, 0, 0, ArrayList<Byte>()))
            val wire = frame2(1, 5, id, headerBlock2([HttpField(":status".toByteArray(), "200".toByteArray())]))
            val progress = inputProgress2(client, wire, wire.size)
            val events = events2(client)
            assertEquals(1L, responses2(events).size)
            assertTrue(closed2(events, id, 0U))
            client.close()
            assertEquals(wire.size, inputTotal2(progress, id))
        }
    }
}
