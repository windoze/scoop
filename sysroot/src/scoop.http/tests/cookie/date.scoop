package scoop.http

import scoop.test.*
import scoop.time.Instant

@Test
private class HttpCookieDateTests {
    @Test
    fun `Cookie dates use token order flexible separators and fixed two digit years`() {
        val expected = Instant.parse("1994-11-06T08:49:37Z")
        for (text in ["Sun, 06 Nov 1994 08:49:37 GMT", "wrong-weekday, 6-Nov-94 8:49:37 ignored-zone",
            "08:49:37 06th NOVember 1994year", "Nov/6/1994/08:49:37", "06,Nov,1994,08:49:37more",
            "Sun Nov  6 08:49:37 1994", "1994 Nov 06 08:49:37", "06 Nov 1994 08:49:37:99"]) {
            assertEquals(expected, HttpCookieDate.parse(text), Some(text))
        }
        for ((year, expectedYear) in [("69", "2069"), ("70", "1970"), ("00", "2000"), ("99", "1999"), ("0069", "2069")]) {
            assertEquals(Instant.parse(expectedYear + "-01-01T00:00:00Z"), HttpCookieDate.parse("1 Jan " + year + " 0:0:0"))
        }
        assertEquals(expected, HttpCookieDate.parse("6 Nov 1994 08:49:37 25:99:99 31 Jan 2099"))
    }

    @Test
    fun `Cookie calendar checks reject invalid first matches missing fields and leap seconds`() {
        for (value in ["", "6 Nov 1994", "6 Whatever 1994 08:49:37", "0 Jan 2000 00:00:00", "31 Feb 2000 00:00:00",
            "29 Feb 1900 00:00:00", "1 Jan 1600 00:00:00", "1 Jan 12345 00:00:00", "1 Jan 1 00:00:00",
            "1 Jan 2000 24:00:00", "1 Jan 2000 00:60:00", "1 Jan 2000 00:00:60", "001 Jan 2000 00:00:00",
            "1 Jan 2000 001:00:00", "1 Jan 2000 00:00:001", "31 Feb 2000 00:00:00 1 Jan 2001 00:00:00"]) {
            assertEquals("Expires", assertFailsWith<HttpFieldParseException> { HttpCookieDate.parse(value) }.field)
            assertTrue(HttpCookieDate.parseOrNone(value) == None, Some(value))
        }
        assertEquals(Instant.parse("2000-02-29T00:00:00Z"), HttpCookieDate.parse("29 Feb 2000 00:00:00"))
        assertEquals(0L, assertFailsWith<HttpFieldParseException> { HttpCookieDate.parse("31 Feb 2000 00:00:00") }.byteOffset)
    }

    @Test
    fun `formatting covers the Cookie year range without weakening HTTP dates`() {
        for (text in ["1601-01-01T00:00:00Z", "1899-12-31T23:59:59Z", "1970-01-01T00:00:00Z", "9999-12-31T23:59:59Z"]) {
            val time = Instant.parse(text)
            assertEquals(time, HttpCookieDate.parse(HttpCookieDate.format(time)))
        }
        assertEquals("Thu, 01 Jan 1970 00:00:00 GMT", HttpCookieDate.format(Instant.fromEpochSeconds(0L, 999999999L)))
        assertFailsWith<IllegalArgumentException> { HttpCookieDate.format(Instant.parse("1600-12-31T23:59:59Z")) }
        assertFailsWith<IllegalArgumentException> { HttpDate.format(Instant.parse("1899-12-31T23:59:59Z")) }
    }
}
