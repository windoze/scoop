// Official PSL vectors: CC0; see sysroot/vendor/publicsuffix/test_psl.txt.
package scoop.http

import scoop.idna.Idna
import scoop.test.*

@Test
private class PublicSuffixVectorTests {
    @Test
    fun `bundled data matches the official registrable domain vectors`() {
        val list = PublicSuffixList.bundled()
        assertEquals("2026-10-17_18-52-06_UTC", list.version!!)
        assertEquals("52b71b3c4576ff77450cc7ebcfc7f34a916af3f9", list.revision!!)
        assertEquals(10398L, list.ruleCount)
        for ((input, expected) in officialPublicSuffixVectors()) {
            val result = list.lookupOrNone(input)
            val actual = when (result) { case None -> None; case Some(match) -> match.registrableDomain }
            val canonical = when (expected) { case None -> None; case Some(name) -> Some(Idna.toAscii(name)) }
            assertTrue(actual == canonical, Some(input))
        }
        assertEquals("github.io", list.lookup("a.github.io").publicSuffix)
        assertTrue(list.lookup("a.github.io").isPrivate)
        assertEquals("io", list.lookup("a.github.io", includePrivate = false).publicSuffix)
        gcCollect()
        assertEquals("example.co.uk", list.lookup("www.example.co.uk").registrableDomain!!)
    }
}

