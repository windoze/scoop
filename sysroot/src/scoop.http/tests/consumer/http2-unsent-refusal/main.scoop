package scoop.http.tests.consumer.http2_unsent_refusal

import scoop.test.*
import scoop.http.*
import scoop.platform.concurrent.Thread

private fun exercise(initial: Boolean) {
    Http2Session.client().use { client ->
        Http2Session.server().use { server ->
            val accepted = if (initial) 0 else client.submitRequest(refusedRequest("GET"))
            refusedDrive(client, server)
            refusedEvents(client); refusedEvents(server)
            val pending = client.submitRequest(refusedRequest("POST"), false)
            val empty = client.submitRequest(refusedRequest("HEAD"))
            refusedWrite(client, pending, "body")
            client.finish(pending, [HttpField("x-trailer".toByteArray(), "pending".toByteArray())])
            server.goAway(lastStreamId = Some(accepted))
            refusedTransfer(server, client)
            refusedTransfer(client, server)
            val events = refusedEvents(client)
            var closed = 0L; var goaway = 0L
            for (event in events) when (event) {
                case StreamClosed(id, code) -> {
                    refusedCheck((id == pending || id == empty) && code == 7U)
                    closed += 1L
                }
                case GoAway(last, _, _, outgoing) -> { refusedCheck(!outgoing && last == accepted); goaway += 1L }
                case Failure(_) -> refusedCheck(false)
                else -> {}
            }
            refusedCheck(closed == 2L && goaway == 1L)
            refusedCheck(!client.hasPendingOutput(pending) && !client.hasPendingOutput(empty))
            for (event in refusedEvents(server)) when (event) {
                case Request(_, _) -> refusedCheck(false)
                else -> {}
            }
            if (!initial) {
                server.submitResponse(accepted, HttpResponseHead(HttpVersion.Http2, 200U), false)
                refusedWrite(server, accepted, "done")
                server.finish(accepted)
                refusedDrive(client, server)
                var bytes = 0L; var ends = 0L
                for (event in refusedEvents(client)) when (event) {
                    case Data(id, value) -> { refusedCheck(id == accepted); bytes += value.size }
                    case End(id) -> { refusedCheck(id == accepted); ends += 1L }
                    case Failure(_) -> refusedCheck(false)
                    else -> {}
                }
                refusedCheck(bytes == 4L && ends == 1L)
                client.consume(accepted, 4L)
            }
            client.reset(pending)
            gcCollect()
        }
    }
}

private fun exerciseConsumer() {
    Thread.start { exercise(false); exercise(true) }.use { thread ->
        exercise(false); exercise(true)
        thread.join()
    }

}

@Test
private class ConsumerTests {
    @Test
    fun behavior() { exerciseConsumer() }
}
