package scoop.http.tests.consumer.http_field_operations

import scoop.test.*
import scoop.http.*
import scoop.platform.concurrent.Thread
import scoop.platform.memory.NativeByteBuffer

private fun check(value: Boolean) { if (!value) throw IllegalStateException() }

private fun exercise(wire: Array<Byte>) {
    val fields = ArrayList<HttpField>()
    val ended = ArrayList<Boolean>()
    Http1Decoder.client().use { decoder ->
        decoder.expectResponse("HEAD".toByteArray())
        NativeByteBuffer.allocate(3L).use { input ->
            var offset = 0L
            while (offset < wire.size) {
                val count = if (wire.size - offset < 3L) wire.size - offset else 3L
                input.clear(); input.writeBytes(wire, offset, count)
                check(decoder.receive(input) == count)
                offset += count
                while (true) {
                    val event = decoder.nextEvent()
                    when (event) {
                        case None -> break
                        case Some(_) -> when (event!!) {
                            case Response(head) -> for (field in head.fields) fields.add(field)
                            case End(keepAlive) -> ended.add(keepAlive)
                            case Data(_) -> throw IllegalStateException()
                            else -> {}
                        }
                    }
                }
            }
            decoder.endInput()
        }
    }
    check(ended.size == 1L && ended[0L])
    check(parseHttpContentLength(fields) == Some(42L))
    val coding = parseHttpTokenFields(fields, "Content-Encoding")
    check(coding.size == 2L && coding[0L] == "gzip" && coding[1L] == "br")
    val selected = ArrayList<HttpField>()
    for (field in fields) {
        field.validate()
        if (!field.hasName("Content-Length".toByteArray())) selected.add(field)
    }
    check(parseHttpContentLength(selected) == None)
    check(isHttpToken("M-SEARCH") && !isHttpToken("BAD METHOD"))
    check(HttpMediaType.parse(fields.findAll("Content-Type".toByteArray())[0L].value).subtype == "json")
    try {
        parseHttpContentLength([HttpField("Content-Length".toByteArray(), "1,2".toByteArray())])
        throw IllegalStateException()
    } catch (error: HttpFieldParseException) { check(error.byteOffset == 2L) }
}

private fun exerciseConsumer() {
    val wire = ("HTTP/1.1 200 OK\r\nContent-Length: 42\r\nContent-Type: application/json\r\n" +
        "Content-Encoding: GZip,\r\ncontent-encoding: BR\r\n\r\n").toByteArray()
    Thread.start { exercise(wire) }.use { first ->
        Thread.start { exercise(wire) }.use { second -> first.join(); second.join() }
    }

}

@Test
private class ConsumerTests {
    @Test
    fun behavior() { exerciseConsumer() }
}
