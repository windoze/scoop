package scoop.http.tests.consumer.sse_decoder

import scoop.test.*
import scoop.bytes.ByteArrayBuilder
import scoop.http.*
import scoop.platform.memory.NativeByteBuffer
import scoop.text.hexToByteArray

fun responseBytes(): Array<Byte> {
    val body = ByteArrayBuilder()
    body.append(("\u{FEFF}id:one\ndata: 雪\r\ndata:hello\r\n\r\n" +
        "id\n\ndata:after\n\nretry: 25\nevent:update\ndata:").toByteArray())
    body.append("e282".hexToByteArray())
    body.append("\n\nid:pending\ndata:incomplete\n".toByteArray())
    return Http1Encoder(HttpRole.Server).use { encoder -> NativeByteBuffer.allocate(body.size).use { input ->
        input.writeBytes(body.toByteArray())
        val output = ByteArrayBuilder()
        output.append(encoder.beginResponse(HttpResponseHead(HttpVersion.Http11, 200U, None,
            [HttpMediaType("text", "event-stream").toHttpField()]), "GET".toByteArray(), Http1BodyFraming.Chunked))
        while (input.readableBytes > 0L) output.append(encoder.writeBody(input, if (input.readableBytes > 3L) 3L else input.readableBytes))
        output.append(encoder.finish())
        output.toByteArray()
    } }
}
