package scoop.http.tests.consumer.cache_control

import scoop.test.*
import scoop.http.*
import scoop.platform.memory.NativeByteBuffer
import scoop.time.Instant
import scoop.time.Duration

private fun exerciseConsumer() {
    val wire = ("HTTP/1.1 304 Not Modified\r\nCache-Control: max-age=\"120\", no-cache=\"X-Session, Set-Cookie\"\r\n" +
        "cache-control: immutable, x-note=\"a,b\"\r\nDate: Sun, 18 Oct 2026 11:22:33 GMT\r\nContent-Length: 987\r\n\r\n").toByteArray()
    val heads = ArrayList<HttpResponseHead>()
    Http1Decoder.client().use { decoder ->
        decoder.expectResponse("GET".toByteArray())
        NativeByteBuffer.allocate(1L).use { input ->
            var ends = 0L
            for (byte in wire) {
                input.clear(); input.writeByte(byte)
                if (decoder.receive(input) != 1L) throw IllegalStateException()
                while (true) {
                    val next = decoder.nextEvent()
                    when (next) {
                        case None -> break
                        case Some(_) -> when (next!!) {
                            case Response(head) -> heads.add(head)
                            case End(_) -> ends += 1L
                            case Data(_) -> throw IllegalStateException()
                            else -> {}
                        }
                    }
                }
            }
            decoder.endInput()
            if (ends != 1L) throw IllegalStateException()
            Unit
        }
        Unit
    }
    if (heads.size != 1L || heads[0L].status != 304U) throw IllegalStateException()
    val fields = heads[0L].fields
    val cache = HttpCacheControl.parseFields(fields)
    gcCollect()
    if (cache.originalValues.size != 2L || cache.directives.size != 4L || !cache.contains("IMMUTABLE")) throw IllegalStateException()
    val excluded = cache.single("no-cache")!!.fieldNames()
    if (excluded.size != 2L || excluded[0L] != "x-session" || excluded[1L] != "set-cookie") throw IllegalStateException()
    if (String.fromUtf8(cache.single("x-note")!!.value!!) != "a,b") throw IllegalStateException()
    val now = Instant.parse("2026-10-18T11:22:33Z")
    val date = HttpDate.parse(fields.findAll("date".toByteArray())[0L].value, now)
    if (date + Duration.seconds(cache.single("max-age")!!.deltaSeconds()) != Instant.parse("2026-10-18T11:24:33Z"))
        throw IllegalStateException()
    if (String.fromUtf8(cache.toHttpField().value) != "max-age=120, no-cache=\"X-Session, Set-Cookie\", immutable, x-note=\"a,b\"")
        throw IllegalStateException()
    if (HttpCacheControl.parse("max-age=999999999999999999999999999999").single("max-age")!!.deltaSeconds() != Long.MAX_VALUE)
        throw IllegalStateException()

}

@Test
private class ConsumerTests {
    @Test
    fun behavior() { exerciseConsumer() }
}
