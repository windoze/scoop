package scoop.http.tests.consumer.websocket_frames

import scoop.test.*
import scoop.bytes.ByteArrayBuilder
import scoop.http.*
import scoop.platform.memory.NativeByteBuffer

fun encodeFrame(encoder: WebSocketFrameEncoder, head: WebSocketFrameHead, bytes: List<Byte>): Array<Byte> {
    val result = ByteArrayBuilder().append(encoder.beginFrame(head))
    NativeByteBuffer.allocate(bytes.size).use { input ->
        input.writeBytes(bytes)
        while (input.readableBytes > 0L)
            result.append(encoder.writePayload(input, if (input.readableBytes < 7L) input.readableBytes else 7L))
        encoder.finishFrame()
    }
    return result.toByteArray()
}

private fun drain(decoder: WebSocketFrameDecoder, events: ArrayList<WebSocketFrameEvent>) {
    while (true) {
        val next = decoder.nextEvent()
        when (next) { case Some(_) -> events.add(next!!); case None -> return }
    }
}

fun readEvents(decoder: WebSocketFrameDecoder, bytes: List<Byte>, chunk: Long, eof: Boolean): Array<WebSocketFrameEvent> {
    val events = ArrayList<WebSocketFrameEvent>()
    NativeByteBuffer.allocate(chunk).use { input ->
        var offset = 0L
        while (offset < bytes.size) {
            input.clear()
            val count = if (bytes.size - offset < chunk) bytes.size - offset else chunk
            input.writeBytes(bytes, offset, count)
            while (input.readableBytes > 0L) {
                val used = decoder.receive(input)
                val before = events.size
                drain(decoder, events)
                check(used != 0L || events.size != before)
            }
            offset += count
        }
        if (eof) { decoder.endInput(); drain(decoder, events) }
        Unit
    }
    return events.toArray()
}

class FrameRecord(val head: WebSocketFrameHead, val data: Array<Byte>)

fun records(events: List<WebSocketFrameEvent>): Array<FrameRecord> {
    val result = ArrayList<FrameRecord>()
    var head: WebSocketFrameHead? = None
    val data = ByteArrayBuilder()
    for (event in events) {
        when (event) {
            case FrameStarted(value) -> { head = Some(value); data.clear() }
            case Data(bytes) -> data.append(bytes)
            case FrameEnded -> { result.add(FrameRecord(head!!, data.toByteArray())); head = None }
            case Ping(bytes) -> result.add(FrameRecord(WebSocketFrameHead(WebSocketOpcode.Ping, bytes.size), bytes))
            case Pong(bytes) -> result.add(FrameRecord(WebSocketFrameHead(WebSocketOpcode.Pong, bytes.size), bytes))
            case Close(value) -> {
                val bytes = value.toByteArray()
                result.add(FrameRecord(WebSocketFrameHead(WebSocketOpcode.Close, bytes.size), bytes))
            }
            case End -> {}
        }
    }
    return result.toArray()
}
