package scoop.http

import scoop.collections.emptyList
import scoop.test.*

@Test
private class HttpRangeTests {
    @Test
    fun `range parsing preserves order and duplicates while resolving RFC examples`() {
        for ((text, first, last) in [("bytes=0-499", 0L, 499L), ("bytes=500-999", 500L, 999L),
            ("bytes=-500", 9500L, 9999L), ("bytes=9500-", 9500L, 9999L)]) {
            val resolved = HttpRange.parse(text).resolve(10000L)
            assertTrue(resolved.isSatisfiable)
            assertEquals(1L, resolved.ranges.size)
            assertRange(resolved.ranges[0L], first, last)
        }
        val original = "\tByTeS=\t,000-009, , -2, 5-,0-9,, \t"
        val parsed = HttpRange.parse(original)
        assertEquals(original, String.fromUtf8(parsed.originalValue!!))
        assertEquals("bytes=0-9,-2,5-,0-9", parsed.toString())
        val resolved = parsed.resolve(10L)
        assertEquals(4L, resolved.ranges.size)
        assertRange(resolved.ranges[0L], 0L, 9L)
        assertRange(resolved.ranges[1L], 8L, 9L)
        assertRange(resolved.ranges[2L], 5L, 9L)
        assertRange(resolved.ranges[3L], 0L, 9L)
        assertEquals("Range", String.fromUtf8(parsed.toHttpField().name))
        assertEquals(parsed.toString(), String.fromUtf8(parsed.toHttpField().value))
    }

    @Test
    fun `empty representations distinguish a satisfiable suffix from no selected bytes`() {
        for (text in ["bytes=0-0", "bytes=0-,-0", "bytes=-0"]) {
            val result = HttpRange.parse(text).resolve(0L)
            assertFalse(result.isSatisfiable)
            assertEquals(0L, result.ranges.size)
        }
        for (text in ["bytes=-1", "bytes=0-0,-1", "bytes=-9223372036854775807"]) {
            val result = HttpRange.parse(text).resolve(0L)
            assertTrue(result.isSatisfiable)
            assertEquals(0L, result.ranges.size)
        }
        val partial = HttpRange.parse("bytes=10-99,-0,3-99,-99").resolve(10L)
        assertTrue(partial.isSatisfiable)
        assertEquals(2L, partial.ranges.size)
        assertRange(partial.ranges[0L], 3L, 9L)
        assertRange(partial.ranges[1L], 0L, 9L)
    }

    @Test
    fun `maximum endpoints clip before length arithmetic and input snapshots stay immutable`() {
        val resolved = HttpRange.parse("bytes=0-9223372036854775807,-9223372036854775807").resolve(Long.MAX_VALUE)
        assertEquals(2L, resolved.ranges.size)
        for (range in resolved.ranges) assertRange(range, 0L, Long.MAX_VALUE - 1L)
        assertEquals(Long.MAX_VALUE, resolved.ranges[0L].length)
        assertFalse(HttpRange.parse("bytes=9223372036854775807-").resolve(Long.MAX_VALUE).isSatisfiable)
        val input = MutableArray<HttpByteRange>(1L) { _ -> HttpByteRange.From(1L) }
        val snapshot = HttpRange(input)
        input[0L] = HttpByteRange.Suffix(2L)
        assertEquals("bytes=1-", snapshot.toString())
        val data = "bytes=0-1".toByteArray()
        val mutable = MutableArray<Byte>(data.size) { index -> data[index] }
        val parsed = HttpRange.parse(mutable)
        mutable[0L] = 120.toByte()
        assertEquals("bytes=0-1", String.fromUtf8(parsed.originalValue!!))
    }

    @Test
    fun `invalid syntax numbers and constructors fail at their own boundary`() {
        for (text in ["", "bytes=", "bytes= , , ", "octets=0-1", "bytes =0-1", "bytes=0 -1", "bytes=0- 1",
            "bytes=+1-", "bytes=--1", "bytes=-", "bytes=0-1-2", "bytes=0-1 4-5", "bytes=9-8",
            "bytes=0-1,x", "bytes=0-1\r\n", "bytes=0-1;2-3"]) {
            assertEquals("Range", assertFailsWith<HttpFieldParseException> { HttpRange.parse(text) }.field)
            assertTrue(when (HttpRange.parseOrNone(text)) { case None -> true; case Some(_) -> false })
        }
        assertEquals(24L, assertFailsWith<HttpFieldParseException> { HttpRange.parse("bytes=9223372036854775808-") }.byteOffset)
        assertEquals(25L, assertFailsWith<HttpFieldParseException> { HttpRange.parse("bytes=-9223372036854775808") }.byteOffset)
        assertFailsWith<IllegalArgumentException> { HttpRange(emptyList<HttpByteRange>()) }
        for (range in [HttpByteRange.From(-1L), HttpByteRange.FromTo(3L, 2L), HttpByteRange.Suffix(-1L)]) {
            assertFailsWith<IllegalArgumentException> { HttpRange([range]) }
        }
        assertFailsWith<IllegalArgumentException> { HttpRange.parse("bytes=0-").resolve(-1L) }
    }
}

private fun assertRange(range: HttpResolvedRange, first: Long, last: Long) {
    assertEquals(first, range.first)
    assertEquals(last, range.last)
    assertEquals(last - first + 1L, range.length)
}
