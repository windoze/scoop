package scoop.http

import scoop.test.*

@Test
private class HttpCredentialsTests {
    @Test
    fun `Basic and Bearer tokens preserve case padding and field direction`() {
        val token = "QWxhZGRpbjpvcGVuIHNlc2FtZQ=="
        val basic = HttpCredentials.withToken68("Basic", token)
        assertEquals("basic", basic.scheme)
        assertEquals(token, HttpCredentials.parse(basic.toAuthorizationField().value).token68!!)
        assertEquals("Authorization", String.fromUtf8(basic.toAuthorizationField().name))
        val bearer = HttpCredentials.parse("\tBearer aB9_~+/== \t")
        assertEquals("aB9_~+/==", bearer.token68!!)
        assertEquals("Proxy-Authorization", String.fromUtf8(bearer.toProxyAuthorizationField().name))
        assertEquals(0L, bearer.parameters.size)
        assertEquals("negotiate", String.fromUtf8(HttpCredentials("Negotiate").toByteArray()))
    }

    @Test
    fun `Digest credentials retain required quoted values and token arguments`() {
        val credentials = HttpCredentials("Digest", [HttpParameter("username", "Mufasa".toByteArray(), quoted = true),
            HttpParameter("realm", "http-auth@example.org".toByteArray(), quoted = true),
            HttpParameter("uri", "/dir/index.html".toByteArray(), quoted = true),
            HttpParameter("algorithm", "SHA-256".toByteArray()), HttpParameter("nc", "00000001".toByteArray())])
        val parsed = HttpCredentials.parse(credentials.toByteArray())
        assertEquals("digest", parsed.scheme)
        assertEquals("Mufasa", String.fromUtf8(parsed.parameter("USERNAME")!!.value))
        assertTrue(parsed.parameter("username")!!.wasQuoted)
        assertFalse(parsed.parameter("algorithm")!!.wasQuoted)
        assertEquals("00000001", String.fromUtf8(parsed.parameter("nc")!!.value))
        assertEquals(0L, HttpCredentials.parse("Digest , , ").parameters.size)
        assertEquals(1L, HttpCredentials.parse("Digest , a = \"\", , ").parameters.size)
    }

    @Test
    fun `credentials reject multiple schemes and invalid public constructor input`() {
        for (value in ["", "Basic,", "Basic a==,", "Basic a, Bearer b", "Digest realm=x, Basic realm=y",
            "Bearer a==b", "Digest a=x, A=y", "Basic\ta==", "Digest a=\"\n\""]) {
            assertEquals("Proxy-Authorization", assertFailsWith<HttpFieldParseException> {
                HttpCredentials.parse(value, "Proxy-Authorization")
            }.field)
            assertTrue(when (HttpCredentials.parseOrNone(value)) { case None -> true; case Some(_) -> false })
        }
        assertFailsWith<IllegalArgumentException> { HttpCredentials.withToken68("Basic", "not valid") }
        assertFailsWith<IllegalArgumentException> { HttpCredentials("Digest", [HttpParameter("n", [0.toByte()])]) }
        assertFailsWith<IllegalArgumentException> { HttpCredentials("Digest", [HttpParameter("N", "1".toByteArray()), HttpParameter("n", "2".toByteArray())]) }
    }
}
