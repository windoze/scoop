package scoop.http

import scoop.charset.*
import scoop.text.*
import scoop.url.PercentEncoding
import scoop.url.UrlParseException

/**
 * Decoded extended-parameter text together with its language tag and selected charset.
 */
public class HttpExtendedValue internal constructor(
    /**
     * The decoded Unicode value.
     */
    public val text: String,
        /**
         * The embedded language tag, possibly empty.
         */
        public val language: String,
        /**
         * The charset used to decode the extended value.
         */
        public val charset: Charset
)

internal fun httpAttributeByte(c: Int): Boolean = httpTokenByte(c) && c != 42 && c != 39 && c != 37

private fun extendedFailure(parameter: HttpParameter, offset: Long, detail: String, cause: Throwable? = None): Nothing =
    throw HttpFieldParseException(parameter.sourceField, parameter.valueOffset + offset, detail, cause)

internal fun decodeHttpExtended(parameter: HttpParameter, allowIso88591: Boolean): HttpExtendedValue {
    if (!parameter.name.endsWith("*")) throw IllegalArgumentException(Some("extended parameter name must end with '*'"))
    if (parameter.wasQuoted) extendedFailure(parameter, 0L, "extended parameter cannot use quoted-string")
    var index = 0L
    for (byte in parameter.value) {
        if (byte.toUByte().toInt() >= 128) extendedFailure(parameter, index, "extended parameter requires ASCII encoding syntax")
        index += 1L
    }
    val raw = String.fromUtf8(parameter.value)
    val first = raw.indexOf('\'')
    if (first <= 0L) extendedFailure(parameter, 0L, "extended parameter requires charset and language separators")
    val rest = raw.substring(first + 1L)
    val relative = rest.indexOf('\'')
    if (relative < 0L) extendedFailure(parameter, raw.charLength, "extended parameter has no value separator")
    val language = rest.substring(0L, relative)
    if (!httpLanguageTag(language)) extendedFailure(parameter, first + 1L, "invalid extended parameter language")
    val source = when (raw.substring(0L, first).lowercaseAscii()) {
        case "utf-8" -> Charset.Utf8
        case "iso-8859-1" -> {
            if (!allowIso88591) extendedFailure(parameter, 0L, "ISO-8859-1 extended parameters require explicit compatibility")
            Charset.Iso8859_1
        }
        else -> extendedFailure(parameter, 0L, "unsupported extended parameter charset")
    }
    val start = first + relative + 2L
    val encoded = raw.substring(start)
    index = 0L
    for (char in encoded) {
        if (char != '%' && !httpAttributeByte(char.code)) extendedFailure(parameter, start + index, "invalid extended parameter character")
        index += 1L
    }
    val bytes = try { PercentEncoding.decode(encoded) }
        catch (error: UrlParseException) { extendedFailure(parameter, start + (error.offset ?: 0L), error.detail, Some(error)) }
    val text = try { source.decode(bytes, CharsetDecodeOptions(bom = CharsetBomPolicy.Preserve)) }
        catch (error: CharsetException) {
            if (error.kind != CharsetFailureKind.MalformedInput && error.kind != CharsetFailureKind.IncompleteInput) throw error
            val offset = encodedByteOffset(encoded, error.offset ?: 0L)
            extendedFailure(parameter, start + offset, error.detail, Some(error))
        }
    return HttpExtendedValue(text, language, source)
}

private fun encodedByteOffset(encoded: String, offset: Long): Long {
    var position = 0L
    var decoded = 0L
    while (position < encoded.charLength && decoded < offset) {
        position += if (encoded.getCharAt(position) == '%') 3L else 1L
        decoded += 1L
    }
    return position
}
