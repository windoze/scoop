package scoop.http

import scoop.datetime.UtcOffset
import scoop.time.Instant

public object HttpDate {
    public fun format(value: Instant): String = httpDateText(value, 1900, "HTTP date")

    public fun parse(value: List<Byte>, reference: Instant, caseInsensitive: Boolean = false): Instant =
        parseHttpDate(HttpFieldReader("HTTP-date", value), reference, caseInsensitive)
    public fun parse(value: String, reference: Instant, caseInsensitive: Boolean = false): Instant =
        parse(value.toByteArray(), reference, caseInsensitive)
    public fun parseOrNone(value: List<Byte>, reference: Instant, caseInsensitive: Boolean = false): Instant? {
        try { return Some(parse(value, reference, caseInsensitive)) }
        catch (_: HttpFieldParseException) { return None }
    }
    public fun parseOrNone(value: String, reference: Instant, caseInsensitive: Boolean = false): Instant? =
        parseOrNone(value.toByteArray(), reference, caseInsensitive)
}

internal fun httpDateText(value: Instant, minimumYear: Int, field: String): String {
    val time = value.toLocalDateTime(UtcOffset.ZERO)
    if (time.year < minimumYear || time.year > 9999)
        throw IllegalArgumentException(Some(field + " year must be " + minimumYear.toString() + "..9999"))
    val weekday = httpDateWeekdays[time.date.dayOfWeek.isoDayNumber.toLong() - 1L]
    return weekday + ", " + dateTwoDigits(time.dayOfMonth) + " " + httpDateMonths[time.monthNumber.toLong() - 1L] + " " +
        time.year.toString() + " " + dateTwoDigits(time.hour) + ":" + dateTwoDigits(time.minute) + ":" + dateTwoDigits(time.second) + " GMT"
}

private fun dateTwoDigits(value: Int): String = if (value < 10) "0" + value.toString() else value.toString()

internal val httpDateWeekdays: Array<String> = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
internal val httpDateLongWeekdays: Array<String> = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"]
internal val httpDateMonths: Array<String> = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
