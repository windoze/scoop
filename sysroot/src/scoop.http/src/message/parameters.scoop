package scoop.http

import scoop.bytes.ByteArrayBuilder
import scoop.collections.HashSet
import scoop.text.lowercaseAscii

public class HttpParameter internal constructor(
    public val name: String, public val value: Array<Byte>, public val wasQuoted: Boolean,
    internal val valueOffset: Long
) {
    public constructor(name: String, value: List<Byte>) : this(httpNormalizedToken(name), checkedHttpParameter(value), false, 0L) {}
}

private fun checkedHttpParameter(value: List<Byte>): Array<Byte> {
    val bytes = value.toArray()
    for (byte in bytes) if (!httpQuotedByte(byte.toUByte().toInt()))
        throw IllegalArgumentException(Some("invalid HTTP parameter byte"))
    return bytes
}

internal fun uniqueHttpParameters(parameters: List<HttpParameter>): Array<HttpParameter> {
    val copied = parameters.toArray()
    val names = HashSet<String>()
    for (parameter in copied) {
        if (!names.add(parameter.name)) throw IllegalArgumentException(Some("duplicate HTTP parameter " + parameter.name))
    }
    return copied
}

internal fun findHttpParameter(parameters: List<HttpParameter>, name: String): HttpParameter? {
    val normalized = name.lowercaseAscii()
    for (parameter in parameters) if (parameter.name == normalized) return Some(parameter)
    return None
}

internal fun encodeHttpParameters(primary: String, parameters: List<HttpParameter>): Array<Byte> {
    val output = ByteArrayBuilder()
    output.append(primary.toByteArray())
    for (parameter in parameters) {
        output.append("; ".toByteArray()); output.append(parameter.name.toByteArray()); output.append(61.toByte())
        if (!parameter.wasQuoted && httpToken(parameter.value)) output.append(parameter.value)
        else {
            output.append(34.toByte())
            for (byte in parameter.value) {
                if (byte == 34.toByte() || byte == 92.toByte()) output.append(92.toByte())
                output.append(byte)
            }
            output.append(34.toByte())
        }
    }
    return output.toByteArray()
}
