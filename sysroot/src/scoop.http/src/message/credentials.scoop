package scoop.http

import scoop.collections.emptyList

public class HttpCredentials private constructor(private val content: HttpAuthValue) {
    public constructor(scheme: String, parameters: List<HttpParameter> = emptyList<HttpParameter>())
        : this(httpAuthWithParameters(scheme, parameters)) {}

    public val scheme: String get() = content.scheme
    public val token68: String? get() = content.token68
    public val parameters: Array<HttpParameter> get() = content.parameters
    public fun parameter(name: String): HttpParameter? = findHttpParameter(parameters, name)
    public fun toByteArray(): Array<Byte> = content.toByteArray()
    public fun toAuthorizationField(): HttpField = HttpField("Authorization".toByteArray(), toByteArray())
    public fun toProxyAuthorizationField(): HttpField = HttpField("Proxy-Authorization".toByteArray(), toByteArray())

    public companion object {
        public fun withToken68(scheme: String, token68: String): HttpCredentials =
            HttpCredentials(httpAuthWithToken68(scheme, token68))

        public fun parse(value: List<Byte>, fieldName: String = "Authorization"): HttpCredentials {
            val reader = HttpFieldReader(fieldName, value)
            reader.skipOws()
            val result = HttpCredentials(readHttpAuthValue(reader, false))
            if (!reader.ended) reader.fail("expected a single credentials value")
            return result
        }
        public fun parse(value: String, fieldName: String = "Authorization"): HttpCredentials =
            parse(value.toByteArray(), fieldName)
        public fun parseOrNone(value: List<Byte>, fieldName: String = "Authorization"): HttpCredentials? {
            try { return Some(parse(value, fieldName)) }
            catch (_: HttpFieldParseException) { return None }
        }
        public fun parseOrNone(value: String, fieldName: String = "Authorization"): HttpCredentials? =
            parseOrNone(value.toByteArray(), fieldName)
    }
}
