package scoop.http

public fun isHttpToken(value: List<Byte>): Boolean = httpToken(value)
public fun isHttpToken(value: String): Boolean = httpToken(value.toByteArray())

public fun HttpField.hasName(name: List<Byte>): Boolean = httpAsciiEqual(this.name, name)

public fun HttpField.validate() {
    if (!httpToken(name)) throw IllegalArgumentException(Some("invalid ordinary HTTP field name"))
    requireHttpValue(value)
}

public fun parseHttpTokenFields(fields: List<HttpField>, name: String): Array<String> {
    if (!isHttpToken(name)) throw IllegalArgumentException(Some("invalid HTTP field name"))
    val result = ArrayList<String>()
    for (field in fields.findAll(name.toByteArray())) {
        for (value in HttpFieldReader(name, field.value).tokenList()) result.add(value)
    }
    return result.toArray()
}

public fun parseHttpContentLength(fields: List<HttpField>): Long? {
    var length: Long? = None
    for (field in fields.findAll("Content-Length".toByteArray())) {
        val reader = HttpFieldReader("Content-Length", field.value)
        reader.skipOws()
        while (true) {
            val offset = reader.position
            val value = reader.decimal()
            when (length) {
                case Some(expected) -> if (value != expected) reader.failAt(offset, "conflicting Content-Length values")
                case None -> length = Some(value)
            }
            reader.skipOws()
            if (reader.ended) break
            reader.expect(44)
            reader.skipOws()
        }
    }
    return length
}
