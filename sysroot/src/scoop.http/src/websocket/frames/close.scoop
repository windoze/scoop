package scoop.http

import scoop.bytes.ByteArrayBuilder
import scoop.charset.*

/**
 * A validated optional close status and UTF-8 reason. Serialization enforces legal wire codes and
 * the control-frame payload limit.
 */
public class WebSocketClose public constructor(
    /**
     * The optional wire close status code.
     */
    public val code: UInt? = None,
    /**
     * The close reason text, requiring a status code when nonempty.
     */
    public val reason: String = "") {
    init {
        if (code == None && reason.byteLength > 0L)
            throw IllegalArgumentException(Some("WebSocket close reason requires a code"))
        if (code != None && !webSocketCloseCode(code!!)) throw IllegalArgumentException(Some("invalid WebSocket close code"))
        if (reason.byteLength > 123L) throw IllegalArgumentException(Some("WebSocket close reason exceeds 123 UTF-8 bytes"))
    }

    /**
     * Serializes a legal status and UTF-8 reason within the control-frame payload limit.
     */
    public fun toByteArray(): Array<Byte> {
        val result = ByteArrayBuilder()
        when (code) {
            case Some(value) -> {
                result.append((value shr 8L).toByte()).append((value and 255U).toByte())
                result.append(reason.toByteArray())
            }
            case None -> {}
        }
        return result.toByteArray()
    }

    /**
     * Parsing validated close-frame payloads.
     */
    public companion object {
        /**
         * Validates payload length, close code, and UTF-8 reason, then returns the decoded close
         * value.
         */
        public fun parse(data: List<Byte>): WebSocketClose {
            val bytes = data.toArray()
            if (bytes.size == 0L) return WebSocketClose()
            if (bytes.size == 1L || bytes.size > 125L) webSocketFrameError("invalid Close payload length")
            val code = (bytes[0L].toUByte().toUInt() shl 8L) or bytes[1L].toUByte().toUInt()
            val reason = try {
                Charset.Utf8.decode(Array<Byte>(bytes.size - 2L) { index -> bytes[index + 2L] },
                    CharsetDecodeOptions(bom = CharsetBomPolicy.Preserve))
            } catch (error: CharsetException) { throw WebSocketFrameException(1007U, "invalid Close reason UTF-8", cause = Some(error)) }
            try { return WebSocketClose(Some(code), reason) }
            catch (_: IllegalArgumentException) { webSocketFrameError("invalid Close status code") }
        }
    }
}

private fun webSocketCloseCode(code: UInt): Boolean =
    (code >= 3000U && code <= 4999U) || code == 1000U || code == 1001U || code == 1002U || code == 1003U ||
    (code >= 1007U && code <= 1014U)
