package scoop.http

/**
 * The data or control operation encoded by a WebSocket frame.
 */
public enum WebSocketOpcode { 
    /**
     * Continues an already-started fragmented data message.
     */
    Continuation, 
    /**
     * Starts a UTF-8 text message.
     */
    Text, 
    /**
     * Starts a binary message.
     */
    Binary, 
    /**
     * Carries the connection close status and reason.
     */
    Close, 
    /**
     * Carries a ping control payload.
     */
    Ping, 
    /**
     * Carries a pong control payload.
     */
    Pong }
/**
 * The logical type of a complete or fragmented data message.
 */
public enum WebSocketMessageType { 
    /**
     * Message bytes must form valid UTF-8 after decompression.
     */
    Text, 
    /**
     * Message bytes have no implicit text encoding.
     */
    Binary }

/**
 * Frame opcode, nonnegative payload length, FIN flag, and compressed-message flag.
 */
public class WebSocketFrameHead public constructor(
    /**
     * The frame operation.
     */
    public val opcode: WebSocketOpcode, 
        /**
         * The exact nonnegative payload byte count.
         */
        public val payloadLength: Long,
    /**
     * The FIN bit, ending a data message when true.
     */
    public val isFinal: Boolean = true, 
        /**
         * The RSV1 compressed-message marker, legal only in negotiated message positions.
         */
        public val isCompressed: Boolean = false
) {
    init { if (payloadLength < 0L) throw IllegalArgumentException(Some("negative WebSocket frame length")) }
}

/**
 * Nonnegative per-frame and per-message byte limits with a positive emitted chunk size.
 */
public class WebSocketFrameLimits public constructor(
    /**
     * Maximum accepted frame payload bytes.
     */
    public val maxFrameBytes: Long = 16777216L, 
        /**
         * Maximum accepted message bytes under the frame parser's message accounting.
         */
        public val maxMessageBytes: Long = 67108864L,
    /**
     * Maximum emitted data-chunk bytes; must be positive.
     */
    public val dataChunkBytes: Long = 8192L
) {
    init {
        if (maxFrameBytes < 0L || maxMessageBytes < 0L || dataChunkBytes <= 0L)
            throw IllegalArgumentException(Some("invalid WebSocket frame limits"))
    }
}

/**
 * Parsed frame boundaries, data chunks, complete control payloads, and terminal input state.
 */
public enum WebSocketFrameEvent {
    /**
     * Begins a data frame with its decoded head.
     */
    FrameStarted(WebSocketFrameHead), 
        /**
         * An owned, unmasked data payload chunk; compressed bytes still require inflation.
         */
        Data(Array<Byte>), 
        /**
         * The announced frame payload has ended.
         */
        FrameEnded,
    /**
     * A complete ping control payload.
     */
    Ping(Array<Byte>), 
        /**
         * A complete pong control payload.
         */
        Pong(Array<Byte>), 
        /**
         * A validated close-frame payload.
         */
        Close(WebSocketClose), 
        /**
         * The decoder reached its terminal input state.
         */
        End
}

/**
 * A framing, message, or UTF-8 failure with the appropriate WebSocket close code and optional byte
 * offset.
 */
public class WebSocketFrameException public constructor(
    /**
     * The WebSocket close code appropriate for this failure.
     */
    public val closeCode: UInt, 
        /**
         * The protocol failure explanation.
         */
        public val detail: String, 
        /**
         * The zero-based input byte position, when available.
         */
        public val byteOffset: Long? = None,
    /**
     * The underlying failure, when available.
     */
    public val cause: Throwable? = None
) : Exception(Some("WebSocket frame: " + detail))

internal fun webSocketControl(opcode: WebSocketOpcode): Boolean = when (opcode) {
    case Close -> true
    case Ping -> true
    case Pong -> true
    else -> false
}

internal fun webSocketFrameError(detail: String): Nothing = throw WebSocketFrameException(1002U, detail)
