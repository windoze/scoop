package scoop.http

import scoop.platform.memory.NativeByteBuffer

/**
 * An owned in-memory HTTP/2 session. Serialize calls, drain events and output, and acknowledge
 * received DATA only after consumption. It owns no network transport.
 */
public class Http2Session private constructor(private var handle: ULong,
    /**
     * The fixed client/server role of this codec.
     */
    public val role: HttpRole) : Closeable {
    /**
     * Factories for explicitly owned client/server codec instances.
     */
    public companion object {
        /**
         * Creates a client codec with the selected receive options and local limits.
         */
        public fun client(options: Http2ReceiveOptions = Http2ReceiveOptions(), limits: Http2Limits = Http2Limits(),
            settings: Http2Settings = Http2Settings()): Http2Session = create(HttpRole.Client, options, limits, settings)

        /**
         * Creates a server codec with the selected receive options and local limits.
         */
        public fun server(options: Http2ReceiveOptions = Http2ReceiveOptions(), limits: Http2Limits = Http2Limits(),
            settings: Http2Settings = Http2Settings()): Http2Session = create(HttpRole.Server, options, limits, settings)

        /**
         * Creates a client session after an accepted h2c upgrade, using exactly the SETTINGS sent
         * in the request. Stream 1 represents that completed HTTP/1 request.
         */
        public fun upgradedClient(requestMethod: List<Byte>, settings: Http2Settings = Http2Settings(),
            options: Http2ReceiveOptions = Http2ReceiveOptions(), limits: Http2Limits = Http2Limits()): Http2Session =
            upgrade(HttpRole.Client, requestMethod, http2SettingsPayload(settings), options, limits, settings)

        /**
         * Creates a server session after the complete HTTP/1 upgrade request body, applying the
         * decoded peer SETTINGS payload.
         */
        public fun upgradedServer(requestMethod: List<Byte>, settingsPayload: List<Byte>,
            options: Http2ReceiveOptions = Http2ReceiveOptions(), limits: Http2Limits = Http2Limits(),
            settings: Http2Settings = Http2Settings()): Http2Session =
            upgrade(HttpRole.Server, requestMethod, settingsPayload.toArray(), options, limits, settings)

        private fun upgrade(role: HttpRole, requestMethod: List<Byte>, payload: Array<Byte>,
            options: Http2ReceiveOptions, limits: Http2Limits, settings: Http2Settings): Http2Session {
            val method = requestMethod.toArray()
            requireHttp1Method(method)
            if (httpBytesEqual(method, "CONNECT".toByteArray()))
                throw IllegalArgumentException(Some("h2c upgrade cannot use CONNECT"))
            val session = create(role, options, limits, settings, true)
            try { session.applyUpgrade(payload, httpBytesEqual(method, "HEAD".toByteArray())); return session }
            catch (error: Throwable) { session.close(); throw error }
        }

        private fun create(role: HttpRole, options: Http2ReceiveOptions, limits: Http2Limits,
            settings: Http2Settings, upgrading: Boolean = false): Http2Session {
            val config = http2Config(options, limits)
            val values = http2Settings(settings)
            @Unsafe {
                val native = http2New(if (role == HttpRole.Server) 1 else 0, config, values, if (upgrading) 1 else 0)
                if (native == 0UL) throw http2Failure("create HTTP/2 session", -901, "cannot allocate HTTP/2 session")
                return Http2Session(native, role)
            }
        }
    }

    /**
     * Whether its state has been released.
     */
    public val isClosed: Boolean get() = handle == 0UL
    /**
     * Whether the session currently expects further peer input.
     */
    public val wantsRead: Boolean get() { @Unsafe { return http2Wants(nativeHandle(), 0) != 0 } }
    /**
     * Whether the backend currently has output work to drive.
     */
    public val wantsWrite: Boolean get() { @Unsafe { return http2Wants(nativeHandle(), 1) != 0 } }
    /**
     * The currently buffered output byte count.
     */
    public val bufferedOutputBytes: Long get() { @Unsafe { return http2Buffered(nativeHandle()) } }

    /**
     * Tests whether the specified positive stream ID still has queued output.
     */
    public fun hasPendingOutput(streamId: Int): Boolean {
        if (streamId <= 0) throw IllegalArgumentException(Some("invalid HTTP/2 stream ID"))
        @Unsafe { return http2Pending(nativeHandle(), streamId) != 0 }
    }

    private fun nativeHandle(): ULong {
        if (handle == 0UL) throw IllegalStateException(Some("HTTP/2 session is closed"))
        return handle
    }

    @Unsafe private fun check(code: Int, operation: String, id: Int = 0, scope: HttpFailureScope = HttpFailureScope.Operation) {
        if (code < 0) throw http2Failure(operation, code, String.fromCString(http2Error(nativeHandle())), id, scope)
    }

    private fun applyUpgrade(payload: Array<Byte>, head: Boolean) {
        @Unsafe {
            val code = payload.withDataPointer { pointer, size ->
                @Unsafe { return@withDataPointer http2Upgrade(nativeHandle(), pointer, size, if (head) 1 else 0) }
            }
            check(code, "upgrade HTTP/2 session")
        }
    }

    /**
     * Consumes up to count readable input bytes, advancing the buffer by the returned count. Drain
     * queued events after feeding input.
     */
    public fun receive(buffer: NativeByteBuffer, count: Long = buffer.readableBytes): Long =
        receiveBytes(nativeHandle(), buffer, count, false)

    /**
     * Consumes input and returns total and per-stream input progress for this call.
     */
    public fun receiveWithProgress(buffer: NativeByteBuffer, count: Long = buffer.readableBytes): Http2ReceiveResult {
        val owned = nativeHandle()
        val received = receiveBytes(owned, buffer, count, true)
        if (received == 0L) return Http2ReceiveResult(0L, ArrayList<Http2InputProgress>().toArray())
        @Unsafe { return Http2ReceiveResult(received, http2ReadInputProgress(owned)) }
    }

    private fun receiveBytes(owned: ULong, buffer: NativeByteBuffer, count: Long, capture: Boolean): Long {
        if (count < 0L || count > buffer.readableBytes) throw IllegalArgumentException(Some("invalid HTTP/2 input count"))
        if (count == 0L) return 0L
        @Unsafe {
            val step = buffer.withReadableBytes { pointer, _ ->
                @Unsafe { return@withReadableBytes http2Receive(owned, pointer!!, count, if (capture) 1 else 0) }
            }
            buffer.skip(step.count)
            check(step.code, "receive HTTP/2", 0, HttpFailureScope.Connection)
            return step.count
        }
    }

    /**
     * Copies up to count outgoing bytes into the writable buffer and advances its writer position.
     */
    public fun takeOutput(buffer: NativeByteBuffer, count: Long = buffer.writableBytes): Long =
        takeOutputChunk(buffer, count).count

    /**
     * Copies an output chunk and returns its byte count, stream ID, and category.
     */
    public fun takeOutputChunk(buffer: NativeByteBuffer, count: Long = buffer.writableBytes): Http2OutputChunk {
        val owned = nativeHandle()
        if (count < 0L || count > buffer.writableBytes) throw IllegalArgumentException(Some("invalid HTTP/2 output capacity"))
        if (count == 0L) return Http2OutputChunk(0L, 0, Http2OutputKind.Control)
        @Unsafe {
            val borrow = buffer.borrowWritable(count)
            val step = try { http2Output(owned, borrow.pointer()!!, count) }
                catch (error: Throwable) { borrow.complete(0L); throw error }
            borrow.complete(step.count)
            check(step.code, "produce HTTP/2 output", 0, HttpFailureScope.Connection)
            val kind = when (step.kind) {
                case 0 -> Http2OutputKind.Control
                case 1 -> Http2OutputKind.Headers
                case 2 -> Http2OutputKind.Data
                else -> throw IllegalStateException(Some("invalid native HTTP/2 output kind"))
            }
            return Http2OutputChunk(step.count, step.streamId, kind)
        }
    }

    /**
     * Queues a request and returns its new stream ID. Set endStream=false before writing a body or
     * trailers.
     */
    public fun submitRequest(head: HttpRequestHead, endStream: Boolean = true): Int {
        val owned = nativeHandle()
        val fields = http2RequestFields(head)
        try {
            @Unsafe {
                val id = http2Request(owned, fields.handle, if (endStream) 1 else 0, fields.length)
                check(id, "submit HTTP/2 request")
                return id
            }
        } finally { fields.close() }
    }

    /**
     * Queues response headers for a stream; set endStream=false when body or trailers follow.
     */
    public fun submitResponse(streamId: Int, head: HttpResponseHead, endStream: Boolean = true) {
        val owned = nativeHandle()
        val fields = http2ResponseFields(head)
        try { @Unsafe { check(http2Response(owned, streamId, fields.handle, head.status.toInt(),
            if (endStream) 1 else 0, fields.length), "submit HTTP/2 response", streamId) } }
        finally { fields.close() }
    }

    /**
     * Queues body bytes and advances by the accepted count. Short writes or zero require draining
     * output and/or receiving window updates.
     */
    public fun writeBody(streamId: Int, buffer: NativeByteBuffer, count: Long = buffer.readableBytes): Long {
        val owned = nativeHandle()
        if (count < 0L || count > buffer.readableBytes) throw IllegalArgumentException(Some("invalid HTTP/2 body count"))
        @Unsafe {
            val step = buffer.withReadableBytes { pointer, _ ->
                @Unsafe { return@withReadableBytes http2Write(owned, streamId, pointer, count) }
            }
            buffer.skip(step.count)
            check(step.code, "write HTTP/2 body", streamId)
            return step.count
        }
    }

    /**
     * Ends this stream's outgoing body, optionally with trailers; queued bytes still need to be
     * drained.
     */
    public fun finish(streamId: Int, trailers: List<HttpField> = ArrayList<HttpField>()) {
        val owned = nativeHandle()
        val fields = Http2Fields()
        try {
            fields.addRegular(trailers, true)
            @Unsafe { check(http2Finish(owned, streamId, fields.handle), "finish HTTP/2 body", streamId) }
        } finally { fields.close() }
    }

    /**
     * Acknowledges DATA bytes actually read or discarded by the application so flow-control credit
     * can be returned.
     */
    public fun consume(streamId: Int, count: Long) {
        @Unsafe { check(http2Consume(nativeHandle(), streamId, count), "consume HTTP/2 body", streamId) }
    }

    /**
     * Queues RST_STREAM and abandons the stream's unconsumed body; the default code is CANCEL.
     */
    public fun reset(streamId: Int, code: UInt = 8U) {
        if (streamId <= 0) throw IllegalArgumentException(Some("invalid HTTP/2 stream ID"))
        @Unsafe { check(http2Reset(nativeHandle(), streamId, code), "reset HTTP/2 stream", streamId) }
    }

    /**
     * Queues GOAWAY with optional debug bytes and last accepted stream ID; output still needs to
     * be drained.
     */
    public fun goAway(code: UInt = 0U, debugData: List<Byte> = ArrayList<Byte>(), lastStreamId: Int? = None) {
        val owned = nativeHandle()
        val last = lastStreamId ?: -1
        if (lastStreamId != None && last < 0) throw IllegalArgumentException(Some("invalid last HTTP/2 stream ID"))
        @Unsafe {
            val result = debugData.toArray().withDataPointer { pointer, size ->
                @Unsafe { return@withDataPointer http2Goaway(owned, last, code, pointer, size) }
            }
            check(result, "submit HTTP/2 GOAWAY")
        }
    }

    /**
     * Reports transport EOF and validates whether the protocol input ended cleanly.
     */
    public fun endInput() { @Unsafe { check(http2End(nativeHandle()), "finish HTTP/2 input", 0, HttpFailureScope.Connection) } }

    /**
     * Removes the next queued event, or returns None when none is ready.
     */
    public fun nextEvent(): Http2Event? {
        @Unsafe {
            val event = http2Next(nativeHandle())
            if (event == 0UL) return None
            try { return Some(http2ReadEvent(event)) }
            finally { httpEventFree(event) }
        }
    }

    /**
     * Releases codec state without sending, finishing, or closing a transport.
     */
    public override fun close() {
        val owned = handle
        handle = 0UL
        if (owned != 0UL) @Unsafe { http2Free(owned) }
    }
}
