package scoop.http

internal enum SseOutputPhase { Prefix, Value, NextField, End, Finished }

internal class SseOutput(private var fields: Array<SseOutputField>) {
    private var phase: SseOutputPhase = if (fields.size == 0L) SseOutputPhase.End else SseOutputPhase.Prefix
    private var field: Long = 0L
    private var prefixAt: Long = 0L
    private var input: Iterator<Char>? = if (fields.size == 0L) None else Some(fields[0L].value.iterator())
    private var skipLf: Boolean = false
    private var pending: Array<Byte> = []
    private var pendingAt: Long = 0L
    val finished: Boolean get() = phase == SseOutputPhase.Finished && pendingAt == pending.size

    fun nextByte(): Byte? {
        if (pendingAt < pending.size) { val value = pending[pendingAt]; pendingAt += 1L; return Some(value) }
        while (true) {
            when (phase) {
                case Prefix -> {
                    val prefix = fields[field].prefix
                    if (prefixAt < prefix.size) { val value = prefix[prefixAt]; prefixAt += 1L; return Some(value) }
                    phase = SseOutputPhase.Value
                }
                case Value -> {
                    val next = input!!.next()
                    if (next == None) { phase = SseOutputPhase.NextField; return Some(10.toByte()) }
                    val value = next!!
                    if (skipLf) { skipLf = false; if (value == '\n') continue }
                    if (value == '\r' || value == '\n') {
                        skipLf = value == '\r'
                        prefixAt = 0L
                        phase = SseOutputPhase.Prefix
                        return Some(10.toByte())
                    }
                    if (value.code < 128) return Some(value.code.toByte())
                    pending = value.toString().toByteArray()
                    pendingAt = 1L
                    return Some(pending[0L])
                }
                case NextField -> {
                    field += 1L
                    if (field == fields.size) phase = SseOutputPhase.End
                    else {
                        input = Some(fields[field].value.iterator())
                        prefixAt = 0L; skipLf = false
                        phase = SseOutputPhase.Prefix
                    }
                }
                case End -> { phase = SseOutputPhase.Finished; return Some(10.toByte()) }
                case Finished -> return None
            }
        }
    }

    fun close() { fields = []; input = None; pending = []; pendingAt = 0L }
}
