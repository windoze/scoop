package scoop.http

import scoop.platform.memory.NativeByteBuffer
import scoop.text.indexOf

public class SseDecoder public constructor(limits: SseLimits = SseLimits(), initialLastEventId: String = "") : Closeable {
    private val state: SseState = SseState(limits, initialLastEventId)
    private val busy: AtomicBoolean = AtomicBoolean(false)
    private var closed: Boolean = false
    private var parseFailure: Throwable? = None

    init {
        if (initialLastEventId.indexOf('\u0000') >= 0L || initialLastEventId.indexOf('\r') >= 0L || initialLastEventId.indexOf('\n') >= 0L)
            throw IllegalArgumentException(Some("invalid initial SSE event ID"))
    }

    public val isClosed: Boolean get() = closed
    public val isFinished: Boolean get() = state.ended && !state.hasPending
    public val lastEventId: String get() = state.lastEventId
    public val retryMilliseconds: Long? get() = state.retryMilliseconds
    public val failure: Throwable? get() = parseFailure

    public fun receive(buffer: NativeByteBuffer, count: Long = buffer.readableBytes): Long = withUse {
        requireOpen()
        if (state.ended) throw IllegalStateException(Some("SSE input has ended"))
        if (count < 0L) throw IllegalArgumentException(Some("negative SSE input count"))
        if (count > buffer.readableBytes) throw IndexOutOfBoundsException()
        if (count == 0L || state.hasPending) return@withUse 0L
        @Unsafe {
            val borrow = buffer.borrowReadable(count)
            var consumed = 0L
            try {
                val pointer = borrow.pointer()!!
                while (consumed < count && !state.hasPending) {
                    val byte = pointer.load(consumed)
                    consumed += 1L
                    state.accept(byte)
                }
                return@withUse consumed
            } catch (error: Throwable) {
                parseFailure = Some(error)
                state.discardIncomplete()
                throw error
            } finally { borrow.complete(consumed) }
        }
    }

    public fun nextEvent(): SseEvent? = withUse {
        requireOpen()
        val result = state.pending
        state.pending = None
        result
    }

    public fun endInput() {
        withUse {
            requireOpen()
            if (!state.ended) { state.ended = true; state.discardIncomplete() }
            Unit
        }
    }

    public override fun close() {
        withUse {
            if (!closed) {
                closed = true
                state.discardIncomplete()
                state.pending = None
            }
            Unit
        }
    }

    private fun requireOpen() {
        if (closed) throw IllegalStateException(Some("SSE decoder is closed"))
        when (parseFailure) { case Some(_) -> throw IllegalStateException(Some("SSE decoder has failed")); case None -> {} }
    }

    private fun <T> withUse(block: () -> T): T {
        if (!busy.compareAndSet(false, true)) throw IllegalStateException(Some("SSE decoder is already in use"))
        try { return block() }
        finally { busy.store(false) }
    }
}
