package scoop.http

@Extern(name = "scoop_http2_new") internal fun http2New(server: Int, config: NativeHttp2Config, settings: NativeHttp2Settings, upgrading: Int): ULong
@Extern(name = "scoop_http2_free") internal fun http2Free(handle: ULong)
@Extern(name = "scoop_http2_error") internal fun http2Error(handle: ULong): Ptr<Byte>
@Extern(name = "scoop_http2_receive") internal fun http2Receive(handle: ULong, data: Ptr<Byte>, size: Long): NativeHttpStep
@Extern(name = "scoop_http2_output") internal fun http2Output(handle: ULong, data: Ptr<Byte>, capacity: Long): NativeHttpStep
@Extern(name = "scoop_http2_wants") internal fun http2Wants(handle: ULong, write: Int): Int
@Extern(name = "scoop_http2_pending") internal fun http2Pending(handle: ULong, id: Int): Int
@Extern(name = "scoop_http2_buffered") internal fun http2Buffered(handle: ULong): Long
@Extern(name = "scoop_http2_next") internal fun http2Next(handle: ULong): ULong
@Extern(name = "scoop_http2_end") internal fun http2End(handle: ULong): Int
@Extern(name = "scoop_http2_goaway") internal fun http2Goaway(handle: ULong, last: Int, code: UInt, data: Ptr<Byte>, size: Long): Int
@Extern(name = "scoop_http2_upgrade") internal fun http2Upgrade(handle: ULong, data: Ptr<Byte>, size: Long, head: Int): Int

@Extern(name = "scoop_http2_fields_new") internal fun http2FieldsNew(): ULong
@Extern(name = "scoop_http2_fields_free") internal fun http2FieldsFree(handle: ULong)
@Extern(name = "scoop_http2_field_add") internal fun http2FieldAdd(handle: ULong, name: Ptr<Byte>, nameSize: Long, value: Ptr<Byte>, valueSize: Long, neverIndex: Int): Int
@Extern(name = "scoop_http2_request") internal fun http2Request(handle: ULong, fields: ULong, end: Int, length: Long): Int
@Extern(name = "scoop_http2_response") internal fun http2Response(handle: ULong, id: Int, fields: ULong, status: Int, end: Int, length: Long): Int
@Extern(name = "scoop_http2_write") internal fun http2Write(handle: ULong, id: Int, data: Ptr<Byte>?, size: Long): NativeHttpStep
@Extern(name = "scoop_http2_finish") internal fun http2Finish(handle: ULong, id: Int, fields: ULong): Int
@Extern(name = "scoop_http2_consume") internal fun http2Consume(handle: ULong, id: Int, count: Long): Int
@Extern(name = "scoop_http2_reset") internal fun http2Reset(handle: ULong, id: Int, code: UInt): Int

internal fun http2Failure(operation: String, code: Int, detail: String, streamId: Int = 0,
    scope: HttpFailureScope = HttpFailureScope.Operation): HttpException =
    HttpException(operation, HttpProtocol.Http2, scope, streamId, "nghttp2 1.70.0", code, detail)
