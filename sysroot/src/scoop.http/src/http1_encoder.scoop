package scoop.http

import scoop.bytes.ByteArrayBuilder
import scoop.platform.memory.NativeByteBuffer
import scoop.text.*

public enum Http1BodyFraming { Empty, Length(Long), Chunked, Eof }

public class Http1Encoder public constructor(public val role: HttpRole) : Closeable {
    private var closed: Boolean = false
    private var active: Boolean = false
    private var closing: Boolean = false
    private var switched: Boolean = false
    private var framing: Http1BodyFraming = Http1BodyFraming.Empty
    private var remaining: Long = 0L

    public val isClosed: Boolean get() = closed
    public val isMessageOpen: Boolean get() = active
    public val mustClose: Boolean get() = closing
    public val isSwitched: Boolean get() = switched

    private fun requireOpen() {
        if (closed) throw IllegalStateException(Some("HTTP/1 encoder is closed"))
    }

    private fun requireBegin(expected: HttpRole) {
        requireOpen()
        if (role != expected || active || closing) throw IllegalStateException(Some("cannot begin another HTTP/1 message here"))
    }

    private fun begin(output: ByteArrayBuilder, fields: Array<HttpField>, version: HttpVersion,
        mode: Http1BodyFraming, kind: Http1HeadKind): Array<Byte> {
        val close = appendHttp1Headers(output, fields, version, mode, kind)
        val bytes = output.toByteArray()
        active = true
        framing = mode
        remaining = when (mode) { case Length(count) -> count; else -> 0L }
        closing = close
        switched = kind == Http1HeadKind.Switch
        return bytes
    }

    public fun beginRequest(head: HttpRequestHead, body: Http1BodyFraming = Http1BodyFraming.Empty): Array<Byte> {
        requireBegin(HttpRole.Client)
        requireHttp1Method(head.method)
        val target = when (head.target) {
            case Http1(bytes) -> bytes
            else -> throw IllegalArgumentException(Some("HTTP/1 requires a raw request target"))
        }
        if (target.size == 0L) throw IllegalArgumentException(Some("HTTP request target is empty"))
        for (byte in target) {
            val value = byte.toUByte().toInt()
            if (value <= 32 || value == 127) throw IllegalArgumentException(Some("invalid HTTP request target byte"))
        }
        val output = ByteArrayBuilder()
        output.append(head.method).append(32.toByte()).append(target).append(32.toByte())
            .append((http1VersionText(head.version) + "\r\n").toByteArray())
        return begin(output, head.fields, head.version, body, Http1HeadKind.Request)
    }

    public fun beginResponse(head: HttpResponseHead, requestMethod: List<Byte>,
        body: Http1BodyFraming = Http1BodyFraming.Empty): Array<Byte> {
        requireBegin(HttpRole.Server)
        val method = requestMethod.toArray()
        requireHttp1Method(method)
        val kind = http1ResponseKind(head, method)
        val output = ByteArrayBuilder()
        output.append((http1VersionText(head.version) + " " + head.status.toString() + " ").toByteArray())
        when (head.reason) {
            case Some(reason) -> { requireHttpValue(reason); output.append(reason) }
            case None -> {}
        }
        output.append("\r\n".toByteArray())
        return begin(output, head.fields, head.version, body, kind)
    }

    public fun writeBody(buffer: NativeByteBuffer, count: Long = buffer.readableBytes): Array<Byte> {
        requireOpen()
        if (!active) throw IllegalStateException(Some("HTTP/1 message has not begun"))
        if (count < 0L || count > buffer.readableBytes) throw IllegalArgumentException(Some("invalid HTTP body count"))
        if (count == 0L) return "".toByteArray()
        when (framing) {
            case Empty -> throw IllegalStateException(Some("this HTTP message has no body"))
            case Length(_) -> {
                if (count > remaining) throw IllegalArgumentException(Some("HTTP body exceeds Content-Length"))
            }
            else -> {}
        }
        val output = ByteArrayBuilder()
        if (framing == Http1BodyFraming.Chunked) output.append((count.toString(16) + "\r\n").toByteArray())
        @Unsafe {
            val bytes = buffer.withReadableBytes { pointer, _ ->
                @Unsafe { return@withReadableBytes httpBytes(NativeHttpBytes(pointer, count)) }
            }
            output.append(bytes)
        }
        if (framing == Http1BodyFraming.Chunked) output.append("\r\n".toByteArray())
        val result = output.toByteArray()
        buffer.skip(count)
        when (framing) { case Length(_) -> remaining -= count; else -> {} }
        return result
    }

    public fun finish(trailers: List<HttpField> = ArrayList<HttpField>()): Array<Byte> {
        requireOpen()
        if (!active) throw IllegalStateException(Some("HTTP/1 message has not begun"))
        if (remaining != 0L) throw IllegalStateException(Some("HTTP body ended before Content-Length"))
        val output = ByteArrayBuilder()
        if (framing == Http1BodyFraming.Chunked) {
            output.append("0\r\n".toByteArray())
            for (field in trailers) {
                if (httpAsciiEqual(field.name, "content-length".toByteArray()) || httpAsciiEqual(field.name, "transfer-encoding".toByteArray()))
                    throw IllegalArgumentException(Some("HTTP trailer cannot change body framing"))
                appendHttp1Field(output, field)
            }
            output.append("\r\n".toByteArray())
        } else if (trailers.size != 0L) throw IllegalArgumentException(Some("HTTP/1 trailers require chunked framing"))
        val result = output.toByteArray()
        active = false
        return result
    }

    public override fun close() { closed = true; active = false }
}
