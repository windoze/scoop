package scoop.http

import scoop.bytes.ByteArrayBuilder
import scoop.collections.emptyList
import scoop.Result
import scoop.time.Instant
import scoop.url.Url

public class HttpSetCookie private constructor(
    public val pair: HttpCookiePair, public val attributes: Array<HttpCookieAttribute>, public val originalValue: Array<Byte>?
) {
    public constructor(pair: HttpCookiePair, attributes: List<HttpCookieAttribute> = emptyList<HttpCookieAttribute>())
        : this(pair, attributes.toArray(), None) {}

    private val interpreted: CookieAttributes = interpretCookieAttributes(attributes)
    public val expires: Instant? get() = interpreted.expires
    public val maxAgeSeconds: Long? get() = interpreted.maxAge
    public val domain: Array<Byte>? get() = interpreted.domain
    public val path: Array<Byte>? get() = interpreted.path
    public val secure: Boolean get() = interpreted.secure
    public val httpOnly: Boolean get() = interpreted.httpOnly
    public val sameSite: HttpCookieSameSite get() = interpreted.sameSite

    public fun expiryFrom(now: Instant, maxLifetimeSeconds: Long = 34560000L): Instant? =
        cookieExpiry(expires, maxAgeSeconds, now, maxLifetimeSeconds)
    public fun resolve(url: Url, now: Instant, suffixes: PublicSuffixList, maxLifetimeSeconds: Long = 34560000L): Result<HttpCookie, HttpCookieRejection> =
        resolveHttpCookie(this, url, now, suffixes, maxLifetimeSeconds)

    public fun toByteArray(): Array<Byte> {
        val output = ByteArrayBuilder()
        if (pair.name.size == 0L && pair.value.size > 0L) output.append(61.toByte())
        output.append(pair.toByteArray())
        for (attribute in attributes) { output.append("; ".toByteArray()); output.append(attribute.toByteArray()) }
        return output.toByteArray()
    }
    public fun toHttpField(): HttpField = HttpField("Set-Cookie".toByteArray(), toByteArray(), neverIndex = true)

    public companion object {
        public fun parse(value: List<Byte>): HttpSetCookie {
            val reader = cookieFieldReader("Set-Cookie", value)
            val pair = HttpCookiePair.read(reader)
            val attributes = ArrayList<HttpCookieAttribute>()
            while (!reader.ended) {
                reader.expect(59)
                attributes.add(HttpCookieAttribute.read(reader))
            }
            return HttpSetCookie(pair, attributes.toArray(), Some(reader.bytes))
        }
        public fun parse(value: String): HttpSetCookie = parse(value.toByteArray())
        public fun parseOrNone(value: List<Byte>): HttpSetCookie? {
            try { return Some(parse(value)) }
            catch (_: HttpFieldParseException) { return None }
        }
        public fun parseOrNone(value: String): HttpSetCookie? = parseOrNone(value.toByteArray())
    }
}
