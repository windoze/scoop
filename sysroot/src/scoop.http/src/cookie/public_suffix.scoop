package scoop.http

import scoop.collections.*
import scoop.idna.*
import scoop.text.*
import scoop.url.UrlOrigin

/**
 * The normalized domain, effective public suffix, optional registrable domain, and matched rule
 * metadata.
 */
public class PublicSuffixMatch internal constructor(
    /**
     * The normalized ASCII domain without a trailing dot.
     */
    public val domain: String, 
        /**
         * The effective public suffix selected by the rule set.
         */
        public val publicSuffix: String, 
        /**
         * The public suffix plus one preceding label, or None if no such label exists.
         */
        public val registrableDomain: String?,
    /**
     * The selected exact, wildcard, or exception rule, when explicitly present.
     */
    public val rule: String?, 
        /**
         * Whether the selected rule came from the private section.
         */
        public val isPrivate: Boolean
)

/**
 * An in-memory public-suffix rule set supporting exact, wildcard, exception, and optional
 * private-section rules. Lookup performs no network update.
 */
public class PublicSuffixList internal constructor(
    private val rules: Map<String, Int>, 
        /**
         * The number of parsed suffix rules.
         */
        public val ruleCount: Long,
    /**
     * The version marker supplied by the rule-list text, if present.
     */
    public val version: String?, 
        /**
         * The revision marker supplied by the rule-list text, if present.
         */
        public val revision: String?
) {
    /**
     * Applies suffix rules to a normalized DNS name; URL-origin overloads return None for IP
     * hosts. Private rules are included by default.
     */
    public fun lookup(domain: String, includePrivate: Boolean = true): PublicSuffixMatch =
        lookupAscii(Idna.toAscii(domain), includePrivate)
    /**
     * Applies suffix rules to a normalized DNS name; URL-origin overloads return None for IP
     * hosts. Private rules are included by default.
     */
    public fun lookup(name: IdnaName, includePrivate: Boolean = true): PublicSuffixMatch =
        lookupAscii(name.ascii, includePrivate)
    /**
     * Applies suffix rules to a normalized DNS name; URL-origin overloads return None for IP
     * hosts. Private rules are included by default.
     */
    public fun lookup(origin: UrlOrigin, includePrivate: Boolean = true): PublicSuffixMatch? = when (origin.host) {
        case Dns(name) -> Some(lookupAscii(name, includePrivate))
        case Ipv4(_) -> None
        case Ipv6(_) -> None
    }
    /**
     * Returns None for invalid domain input, otherwise performs suffix lookup with the selected
     * private-rule policy.
     */
    public fun lookupOrNone(domain: String, includePrivate: Boolean = true): PublicSuffixMatch? {
        val ascii = Idna.toAsciiOrNone(domain)
        if (ascii == None || ascii!! == ".") return None
        return Some(lookupAscii(ascii!!, includePrivate))
    }

    private fun lookupAscii(input: String, includePrivate: Boolean): PublicSuffixMatch {
        val domain = if (input.endsWith(".")) input.slice(0L, input.length - 1L) else input
        if (domain.length == 0L) throw IllegalArgumentException(Some("public suffix lookup requires a host name"))
        val labels = domain.split('.')
        var selected = labels.size - 1L
        var rule: String? = None
        var privateRule = false
        var exception = -1L
        var exceptionPrivate = false
        var suffix = ""
        var index = labels.size - 1L
        while (index >= 0L) {
            suffix = labels[index] + (if (suffix.length == 0L) "" else "." + suffix)
            val flags = rules.getOrDefault(suffix, 0) and (if (includePrivate) 63 else 7)
            if ((flags and 36) != 0) { exception = index; exceptionPrivate = (flags and 4) == 0 }
            if ((flags and 9) != 0 && index <= selected) {
                selected = index; rule = Some(suffix); privateRule = (flags and 1) == 0
            }
            if ((flags and 18) != 0 && index > 0L && index - 1L < selected) {
                selected = index - 1L; rule = Some("*." + suffix); privateRule = (flags and 2) == 0
            }
            index -= 1L
        }
        if (exception >= 0L) {
            selected = exception + 1L
            rule = Some("!" + publicSuffixTail(labels, exception))
            privateRule = exceptionPrivate
        } else if (rule == None) {
            val flags = rules.getOrDefault("", 0) and (if (includePrivate) 18 else 2)
            if (flags != 0) { rule = Some("*"); privateRule = (flags and 2) == 0 }
        }
        return PublicSuffixMatch(domain, publicSuffixTail(labels, selected),
            if (selected == 0L) None else Some(publicSuffixTail(labels, selected - 1L)), rule, privateRule)
    }

    /**
     * Rule-list parsing and access to the bundled snapshot.
     */
    public companion object {
        /**
         * Parses public-suffix list text, including section metadata and wildcard/exception rules.
         */
        public fun parse(text: String): PublicSuffixList = parsePublicSuffixList(text)
        /**
         * Parses the public-suffix snapshot bundled with the library; it does not fetch network
         * updates.
         */
        public fun bundled(): PublicSuffixList {
            @Unsafe { return parse(String.fromUtf8(httpBytes(httpPublicSuffixData()))) }
        }
    }
}

private fun publicSuffixTail(labels: List<String>, start: Long): String {
    val output = StringBuilder()
    for (index in start..<labels.size) {
        if (index > start) output.append(".")
        output.append(labels[index])
    }
    return output.toString()
}

@Extern(name = "scoop_http_public_suffix_data") internal fun httpPublicSuffixData(): NativeHttpBytes
