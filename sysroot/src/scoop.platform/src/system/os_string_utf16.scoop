package scoop.platform.system

import scoop.bytes.ByteArrayBuilder

internal fun encodeOsUtf16(units: List<UShort>): Array<Byte> {
    val result = ByteArrayBuilder()
    var index = 0L
    while (index < units.size) {
        var point = units[index].toInt()
        index += 1L
        if (point >= 0xd800 && point <= 0xdbff && index < units.size) {
            val next = units[index].toInt()
            if (next >= 0xdc00 && next <= 0xdfff) {
                point = 0x10000 + (point - 0xd800) * 1024 + next - 0xdc00
                index += 1L
            }
        }
        if (point < 0x80) {
            result.append(point.toByte())
        } else
            if (point < 0x800) {
                result.append((0xc0 or (point shr 6)).toByte())
                result.append((0x80 or (point and 0x3f)).toByte())
            } else
                if (point < 0x10000) {
                    result.append((0xe0 or (point shr 12)).toByte())
                    result.append((0x80 or ((point shr 6) and 0x3f)).toByte())
                    result.append((0x80 or (point and 0x3f)).toByte())
                } else {
                    result.append((0xf0 or (point shr 18)).toByte())
                    result.append((0x80 or ((point shr 12) and 0x3f)).toByte())
                    result.append((0x80 or ((point shr 6) and 0x3f)).toByte())
                    result.append((0x80 or (point and 0x3f)).toByte())
                }
    }
    return result.toByteArray()
}

internal fun decodeOsUtf16(bytes: Array<Byte>): Array<UShort> {
    val result = ArrayList<UShort>()
    var index = 0L
    var previousHigh = -1L
    while (index < bytes.size) {
        val start = index
        val first = bytes[index].toUByte().toInt()
        val(width, minimum, initial) =
            if (first < 0x80) {
                (1L, 0, first)
            } else
                if (first >= 0xc2 && first <= 0xdf) {
                    (2L, 0x80, first and 0x1f)
                } else
                    if (first >= 0xe0 && first <= 0xef) {
                        (3L, 0x800, first and 0x0f)
                    } else
                        if (first >= 0xf0 && first <= 0xf4) {
                            (4L, 0x10000, first and 0x07)
                        } else {
                            throw CharacterCodingException(start)
                        }
        var point = initial
        if (bytes.size - start < width)
            throw CharacterCodingException(start)
        index += 1L
        while (index < start + width) {
            val next = bytes[index].toUByte().toInt()
            if (next < 0x80 || next > 0xbf)
                throw CharacterCodingException(start)
            point = (point shl 6) or (next and 0x3f)
            index += 1L
        }
        if (point < minimum || point > 0x10ffff)
            throw CharacterCodingException(start)
        // Adjacent surrogate byte sequences must use the scalar's four-byte encoding.
        if (previousHigh >= 0L && point >= 0xdc00 && point <= 0xdfff)
            throw CharacterCodingException(previousHigh)
        previousHigh =
            if (point >= 0xd800 && point <= 0xdbff)
                start
            else
                -1L
        if (point < 0x10000) {
            result.add(point.toUShort())
        } else {
            result.add((0xd800 + ((point - 0x10000) shr 10)).toUShort())
            result.add((0xdc00 + ((point - 0x10000) and 0x3ff)).toUShort())
        }
    }
    return result.toArray()
}
