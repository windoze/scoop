package scoop.platform.system

/**
 * A portable classification of operating-system failures, with native details retained separately.
 */
public enum PlatformErrorKind {
    /**
     * The requested resource does not exist.
     */
    NotFound,
    /**
         * The operation requires an absent destination.
         */
    AlreadyExists,
    /**
         * Access was denied.
         */
    PermissionDenied,
    /**
         * A required path component is not a directory.
         */
    NotDirectory,
    /**
         * The selected entry is a directory where a file is required.
         */
    IsDirectory,
    /**
     * The native operation rejected its arguments.
     */
    InvalidInput,
    /**
         * The native operation could not allocate required memory.
         */
    NoMemory,
    /**
         * The storage destination has insufficient space.
         */
    NoSpace,
    /**
         * The output pipe has no reader.
         */
    BrokenPipe,
    /**
         * The remote endpoint refused the connection.
         */
    ConnectionRefused,
    /**
         * The connection was reset.
         */
    ConnectionReset,
    /**
     * The requested local address is already in use.
     */
    AddressInUse,
    /**
         * The requested address is unavailable on this host.
         */
    AddressUnavailable,
    /**
         * The native operation timed out.
         */
    TimedOut,
    /**
         * A native wait was interrupted.
         */
    Interrupted,
    /**
         * The operation cannot progress without waiting.
         */
    WouldBlock,
    /**
         * The requested operation is unsupported.
         */
    Unsupported,
    /**
         * A native failure outside the portable categories.
         */
    Other
}

/**
 * Identifies how a native error code must be interpreted.
 */
public enum NativeErrorDomain {
    /**
     * A POSIX errno value.
     */
    PosixErrno,
    /**
     * A native address-resolution error code.
     */
    AddressResolution,
    /**
     * A Win32 error code captured from the failing operation.
     */
    Win32,
    /**
     * A Windows Sockets error code captured from the failing operation.
     */
    Winsock
}

/**
 * A native error domain and code with optional underlying system code.
 */
public struct NativeError(
    val domain: NativeErrorDomain,
    val code: Int,
    val systemCode: Int? = None
) {
    /**
     * The portable classification corresponding to this native error.
     */
    public val kind: PlatformErrorKind get() {
        @Unsafe
        {
            val domainCode =
                when (domain) {
                    case PosixErrno -> 0
                    case AddressResolution -> 1
                    case Win32 -> 2
                    case Winsock -> 3
                }
            val category = nativeErrorKind(domainCode, code, systemCode ?: 0)
            return errorKind(category)
        }
    }
}

/**
 * A platform-operation failure with portable kind, optional native error, and native-byte path or
 * operation context.
 */
public class PlatformException public constructor(
    /**
     * The operation that failed.
     */
    public val operation: String,
    /**
     * The portable failure category.
     */
    public val kind: PlatformErrorKind,
    /**
     * The original native error, when available.
     */
    public val nativeError: NativeError? = None,
    /**
     * An optional native-byte path or other operation-specific context.
     */
    public val context: OsString? = None
): Exception(Some(platformErrorMessage(operation, nativeError, context)))

private fun platformErrorMessage(
    operation: String,
    error: NativeError?,
    context: OsString?
): String {
    var message = operation + " failed"
    if (error != None)
        message += " (native code " + error!!.code.toString() + ")"
    if (context != None)
        message += ": " + context!!.display()
    return message
}

private fun errorKind(category: Int): PlatformErrorKind =
    when (category) {
        case 1 -> PlatformErrorKind.NotFound
        case 2 -> PlatformErrorKind.AlreadyExists
        case 3 -> PlatformErrorKind.PermissionDenied
        case 4 -> PlatformErrorKind.NotDirectory
        case 5 -> PlatformErrorKind.IsDirectory
        case 6 -> PlatformErrorKind.InvalidInput
        case 7 -> PlatformErrorKind.NoMemory
        case 8 -> PlatformErrorKind.NoSpace
        case 9 -> PlatformErrorKind.BrokenPipe
        case 10 -> PlatformErrorKind.ConnectionRefused
        case 11 -> PlatformErrorKind.ConnectionReset
        case 12 -> PlatformErrorKind.AddressInUse
        case 13 -> PlatformErrorKind.AddressUnavailable
        case 14 -> PlatformErrorKind.TimedOut
        case 15 -> PlatformErrorKind.Interrupted
        case 16 -> PlatformErrorKind.WouldBlock
        case 17 -> PlatformErrorKind.Unsupported
        else -> PlatformErrorKind.Other
    }

@GCLeaf
@Extern(name = "scoop_platform_error_kind")
private fun nativeErrorKind(domain: Int, code: Int, systemCode: Int): Int
