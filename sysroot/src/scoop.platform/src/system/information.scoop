package scoop.platform.system

import scoop.platform.fs.copyNativeString
import scoop.platform.io.checkNative
import scoop.platform.io.failNative
import scoop.platform.memory.nativeMemoryFree

/**
 * The operating-system family selected by the compilation target.
 */
public enum OperatingSystem {
    /**
     * The Darwin operating-system family.
     */
    Darwin,
    /**
     * The Linux operating-system family.
     */
    Linux }
/**
 * The processor architecture selected by the compilation target.
 */
public enum Architecture {
    /**
     * The 64-bit Arm architecture.
     */
    Aarch64,
    /**
     * The 64-bit x86 architecture.
     */
    X86_64 }

/**
 * The operating-system family of the compiled target.
 */
public val operatingSystem: OperatingSystem = currentOperatingSystem()
/**
 * The architecture of the compiled target.
 */
public val architecture: Architecture = currentArchitecture()

private fun currentOperatingSystem(): OperatingSystem {
    @Unsafe { return if (nativeOperatingSystem() == 0) OperatingSystem.Darwin else OperatingSystem.Linux }
}

private fun currentArchitecture(): Architecture {
    @Unsafe { return if (nativeArchitecture() == 0) Architecture.Aarch64 else Architecture.X86_64 }
}

/**
 * The number of logical processors reported by the operating system.
 */
public val logicalProcessorCount: Long get() {
    @Unsafe {
        val (count, error) = nativeProcessorCount()
        return checkNative(count, error, "logical processor count")
    }
}

/**
 * Returns the operating system's version description.
 */
public fun systemVersion(): String {
    @Unsafe {
        val (pointer, error) = nativeSystemVersion()
        if (pointer == None) failNative("system version", error)
        try { return copyNativeString(pointer!!).decodeUtf8() }
        finally { nativeMemoryFree(pointer!!) }
    }
}

@GCLeaf @Extern(name = "scoop_platform_operating_system")
private fun nativeOperatingSystem(): Int
@GCLeaf @Extern(name = "scoop_platform_architecture")
private fun nativeArchitecture(): Int
@Extern(name = "scoop_platform_processor_count", captureErrno = true)
private fun nativeProcessorCount(): (Long, Int)
@Extern(name = "scoop_platform_system_version", captureErrno = true)
private fun nativeSystemVersion(): (Ptr<Byte>?, Int)
