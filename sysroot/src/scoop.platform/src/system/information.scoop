package scoop.platform.system

/**
 * The number of logical processors reported by the operating system.
 */
public val logicalProcessorCount: Long get() {
    @Unsafe
    {
        val result = nativeProcessorCount()
        if (result.count < 0L)
            failOperatingSystem("logical processor count", result.error)
        return result.count
    }
}

@CLayout
private struct NativeProcessorCount(val count: Long, val error: Int)

@Extern(name = "scoop_platform_processor_count")
private fun nativeProcessorCount(): NativeProcessorCount
