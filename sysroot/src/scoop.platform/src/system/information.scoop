package scoop.platform.system

import scoop.platform.fs.copyNativeString
import scoop.platform.io.checkNative
import scoop.platform.io.failNative
import scoop.platform.memory.nativeMemoryFree

/**
 * The number of logical processors reported by the operating system.
 */
public val logicalProcessorCount: Long get() {
    @Unsafe
    {
        val(count, error) = nativeProcessorCount()
        return checkNative(count, error, "logical processor count")
    }
}

/**
 * Returns the operating system's version description.
 */
public fun systemVersion(): String {
    @Unsafe
    {
        val(pointer, error) = nativeSystemVersion()
        if (pointer == None)
            failNative("system version", error)
        try {
            return copyNativeString(pointer!!).decodeUtf8()
        }
        finally {
            nativeMemoryFree(pointer!!)
        }
    }
}

@Extern(name = "scoop_platform_processor_count", captureErrno = true)
private fun nativeProcessorCount(): (Long, Int)

@Extern(name = "scoop_platform_system_version", captureErrno = true)
private fun nativeSystemVersion(): (Ptr<Byte>?, Int)
