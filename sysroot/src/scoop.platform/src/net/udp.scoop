package scoop.platform.net

import scoop.platform.io.*
import scoop.platform.memory.NativeByteBuffer
import scoop.platform.system.*

/**
 * A received datagram's sender, delivered byte count, and whether its payload was truncated.
 */
public struct Datagram(val source: SocketAddress, val count: Long, val truncated: Boolean)

private class ReceiveResult {
    var value: NativeDatagram? = None
}

/**
 * An owned blocking datagram socket preserving message boundaries.
 */
public class UdpSocket private constructor(private val owner: SocketOwner): Closeable {
    /**
     * Queries the actual bound UDP endpoint.
     */
    public fun localAddress(): SocketAddress = owner.socketAddress(false)
    /**
     * Whether this owned resource has been closed.
     */
    public val isClosed: Boolean get() = owner.isClosed

    /**
     * Binds UDP sockets with explicit address-reuse selection.
     */
    public companion object {
        /**
         * Binds an owned UDP socket to the specified endpoint.
         */
        public fun bind(address: SocketAddress, reuseAddress: Boolean = false): UdpSocket {
            val owner = SocketOwner()
            val socket = UdpSocket(owner)
            @Unsafe
            {
                owner.adopt(
                    nativeSocketBind(nativeAddress(address), true, reuseAddress, 0),
                    "UDP bind"
                )
            }
            return socket
        }
    }

    /**
     * Sends one datagram from count readable bytes and advances the buffer by the sent count.
     */
    public fun sendTo(
        buffer: NativeByteBuffer,
        destination: SocketAddress,
        count: Long = buffer.readableBytes
    ): Long =
        owner.withHandle {
            descriptor ->
            requireTransfer(count, buffer.readableBytes)
            @Unsafe
            {
                val sent =
                    buffer.withReadableBytes {
                        pointer,
                        _ -> @Unsafe
                        {
                            return@withReadableBytes nativeSend(
                                descriptor,
                                pointer,
                                count,
                                nativeAddress(destination)
                            ).checked("UDP send")
                        }
                    }
                buffer.skip(sent)
                if (sent != count)
                    throw PlatformException("incomplete UDP send", PlatformErrorKind.Other)
                return@withHandle sent
            }
        }

    /**
     * Receives one datagram into the writable region, returning sender, byte count, and truncation
     * status.
     */
    public fun receiveFrom(buffer: NativeByteBuffer, count: Long = buffer.writableBytes): Datagram =
        owner.withHandle {
            descriptor ->
            requireTransfer(count, buffer.writableBytes)
            if (count == 0L)
                throw IllegalArgumentException(Some("UDP receive requires positive capacity"))
            val received = ReceiveResult()
            @Unsafe
            {
                buffer.withWritableBytes {
                    pointer,
                    _ -> @Unsafe
                    {
                        val result = nativeReceive(descriptor, pointer!!, count)
                        checkSocketError("UDP receive", result.error)
                        received.value = Some(result.packet)
                        return@withWritableBytes result.packet.count
                    }
                }
            }
            val packet = received.value!!
            Datagram(socketAddress(packet.source, 0), packet.count, packet.truncated)
        }

    /**
     * Closes the owned native descriptor; subsequent I/O through this owner is invalid.
     */
    public override fun close() {
        owner.close()
    }
}

@Extern(name = "scoop_platform_udp_send")
private fun nativeSend(
    descriptor: NativeSocketHandle,
    bytes: Ptr<Byte>?,
    count: Long,
    destination: NativeSocketAddress
): NativeSocketResult

@Extern(name = "scoop_platform_udp_receive")
private fun nativeReceive(
    descriptor: NativeSocketHandle,
    bytes: Ptr<Byte>,
    count: Long
): NativeSocketReceived
