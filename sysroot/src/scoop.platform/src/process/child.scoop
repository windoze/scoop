package scoop.platform.process

import scoop.platform.fs.File
import scoop.platform.io.*
import scoop.platform.system.*

/**
 * Distinguishes normal process exit from signal termination.
 */
public enum ExitStatus {
    /**
     * The process exited with this status code.
     */
    Exited(val code: Int),
    /**
     * The process terminated because of this native signal.
     */
    Signaled(val signal: Int) }
/**
 * Collected stdout, stderr, and final status from process communication.
 */
public struct ProcessOutput(val stdout: Array<Byte>, val stderr: Array<Byte>, val status: ExitStatus)

/**
 * An owned child process and any untaken pipe endpoints. Close closes retained pipes and waits for
 * termination; it does not automatically kill a running process.
 */
public class ChildProcess internal constructor(inputPipe: Boolean, outputPipe: Boolean, errorPipe: Boolean) : Closeable {
    private var process: Int = -1
    private var result: ExitStatus? = None
    private var waitFailure: Throwable? = None
    private var closed: Boolean = false
    private val active: AtomicLong = AtomicLong(0L)
    private val configured: Array<Boolean> = [inputPipe, outputPipe, errorPipe]
    private var input: PipeSink? = if (inputPipe) Some(PipeSink(File.newOwner())) else None
    private var output: PipeSource? = if (outputPipe) Some(PipeSource(File.newOwner())) else None
    private var error: PipeSource? = if (errorPipe) Some(PipeSource(File.newOwner())) else None
    /**
     * A borrowed view of the child's input pipe, or None when it is not available.
     */
    public val stdin: ByteSink? get() = input?.borrowed()
    /**
     * A borrowed view of the child's output pipe, or None when it is not available.
     */
    public val stdout: ByteSource? get() = output?.borrowed()
    /**
     * A borrowed view of the child's error pipe, or None when it is not available.
     */
    public val stderr: ByteSource? get() = error?.borrowed()
    /**
     * Whether this owned resource has been closed.
     */
    public val isClosed: Boolean get() = closed

    internal fun adopt(descriptors: MutableArray<Int>) {
        process = descriptors[0L]
        input?.file?.adoptDescriptor(descriptors[1L])
        output?.file?.adoptDescriptor(descriptors[2L])
        error?.file?.adoptDescriptor(descriptors[3L])
    }

    /**
     * Transfers ownership of the child's input pipe to the caller and removes it from automatic
     * child cleanup.
     */
    public fun takeStdin(): PipeSink? { val taken = input; input = None; return taken }
    /**
     * Transfers ownership of the child's output pipe to the caller and removes it from automatic
     * child cleanup.
     */
    public fun takeStdout(): PipeSource? { val taken = output; output = None; return taken }
    /**
     * Transfers ownership of the child's error pipe to the caller and removes it from automatic
     * child cleanup.
     */
    public fun takeStderr(): PipeSource? { val taken = error; error = None; return taken }

    /**
     * Waits for termination and returns the final status.
     */
    public fun wait(): ExitStatus = observe(false)!!
    /**
     * Returns a final status if available, or None while the child is still running.
     */
    public fun tryWait(): ExitStatus? = observe(true)

    private fun <R> withProcess(block: (Int) -> R): R {
        active.fetchAdd(1L, MemoryOrder.Relaxed)
        try { return block(process) }
        finally { active.fetchSub(1L, MemoryOrder.Relaxed) }
    }

    private fun observe(noHang: Boolean): ExitStatus? {
        when (waitFailure) { case Some(failure) -> throw failure; case None -> {} }
        when (result) { case Some(_) -> return result; case None -> {} }
        @Unsafe {
            val (status, code) = withProcess { pid ->
                @Unsafe { return@withProcess nativeWait(pid, noHang) }
            }
            if (status == -2L) return None
            if (status < 0L) {
                val error = NativeError(NativeErrorDomain.PosixErrno, code)
                val failure = PlatformException("wait", error.kind, Some(error))
                if (status == -3L) { process = -1; waitFailure = Some(failure) }
                throw failure
            }
            process = -1
            result = Some(if (status < 256L) ExitStatus.Exited(status.toInt())
                          else ExitStatus.Signaled((status - 256L).toInt()))
        }
        return result
    }

    /**
     * Requests ordinary process termination.
     */
    public fun terminate() { signal(false) }
    /**
     * Requests forced process termination.
     */
    public fun kill() { signal(true) }
    private fun signal(force: Boolean) {
        if (process < 0) return
        @Unsafe {
            val (status, code) = withProcess { pid ->
                @Unsafe { return@withProcess nativeSignal(pid, force) }
            }
            checkNativeStatus(status, code, if (force) "kill" else "terminate")
        }
    }

    /**
     * Feeds optional input while draining stdout and stderr, then waits and returns their
     * collected bytes and status.
     */
    public fun communicate(input: List<Byte>? = None): ProcessOutput {
        if (closed) throw IllegalStateException(Some("process is closed"))
        when (input) {
            case Some(_) -> if (!configured[0L]) throw IllegalArgumentException(Some("input requires stdin pipe"))
            case None -> {}
        }
        if ((configured[0L] && (this.input?.isClosed ?: true)) ||
            (configured[1L] && (output?.isClosed ?: true)) ||
            (configured[2L] && (error?.isClosed ?: true))) {
            throw IllegalStateException(Some("process pipe was already taken or closed"))
        }
        val snapshot: Array<Byte>? = when (input) {
            case Some(bytes) -> Some(bytes.toArray())
            case None -> None
        }
        val pipes = ProcessPipes(takeStdin(), takeStdout(), takeStderr())
        try {
            val (stdout, stderr) = pipes.transfer(snapshot)
            val status = wait()
            return ProcessOutput(stdout, stderr, status)
        } catch (failure: Throwable) {
            var reported = failure
            try { pipes.close() } catch (cleanup: Throwable) { reported = ResourceUseException(reported, cleanup) }
            try { kill() } catch (cleanup: Throwable) { reported = ResourceUseException(reported, cleanup) }
            try { wait() } catch (cleanup: Throwable) { reported = ResourceUseException(reported, cleanup) }
            throw reported
        }
    }

    /**
     * Closes retained pipe endpoints and waits for the child, preserving cleanup failures. Taken
     * endpoints remain the caller's responsibility.
     */
    public override fun close() {
        if (closed) return
        if (active.load(MemoryOrder.Relaxed) != 0L) throw IllegalStateException(Some("process operation is active"))
        var failure: Throwable? = None
        val endpoints: Array<File?> = [takeStdin()?.file, takeStdout()?.file, takeStderr()?.file]
        for (endpoint in endpoints) {
            try { endpoint?.close() }
            catch (error: Throwable) { failure = Some(combineProcessFailure(failure, error)) }
        }
        try { wait(); closed = true }
        catch (error: Throwable) { failure = Some(combineProcessFailure(failure, error)) }
        when (failure) { case Some(error) -> throw error; case None -> {} }
    }

    release { if (process >= 0) { @Unsafe { nativeAbandon(process) } } }
}

internal fun combineProcessFailure(previous: Throwable?, next: Throwable): Throwable = when (previous) {
    case Some(error) -> ResourceUseException(error, next)
    case None -> next
}

@Extern(name = "scoop_platform_process_wait", captureErrno = true)
private fun nativeWait(process: Int, noHang: Boolean): (Long, Int)
@Extern(name = "scoop_platform_process_signal", captureErrno = true)
private fun nativeSignal(process: Int, force: Boolean): (Int, Int)
@Extern(name = "scoop_platform_process_abandon")
private fun nativeAbandon(process: Int)
