package scoop.platform.process

import scoop.bytes.ByteArrayBuilder
import scoop.collections.Map
import scoop.platform.fs.*
import scoop.platform.system.OsString

internal class SpawnInput internal constructor(
    executable: Path,
    arguments: Array<OsString>,
    environment: Map<OsString, OsString>,
    private val directory: Path
) {
    private val argumentCount: Long = arguments.size + 1L
    private val environmentCount: Long = environment.size
    private val argumentBytes: Array<Byte> = packArguments(executable, arguments)
    private val environmentBytes: Array<Byte> = packEnvironment(environment)

    internal fun spawn(
        path: Path,
        input: Stdio,
        output: Stdio,
        error: Stdio,
        merge: Boolean,
        result: MutableArray<NativeFileHandle>
    ): (Int, Int) =
        withRedirect(input) inputScope@{
            inputFd -> withRedirect(output) outputScope@{
                outputFd -> withRedirect(error) errorScope@{
                    errorFd ->
                    val redirects: Array<NativeStdio> =
                        [
                            inputFd,
                            outputFd,
                            if (merge)
                                NativeStdio(4, NativeFileHandle(ULong.MAX_VALUE))
                            else
                                errorFd
                        ]
                    @Unsafe
                    {
                        return@errorScope path.withNativePath pathScope@{
                            executable -> @Unsafe
                            {
                                return@pathScope directory.withNativePath directoryScope@{
                                    cwd -> @Unsafe
                                    {
                                        return@directoryScope argumentBytes.withDataPointer argumentScope@{
                                            argv,
                                            _ -> @Unsafe
                                            {
                                                return@argumentScope environmentBytes.withDataPointer environmentScope@{
                                                    envp,
                                                    _ -> @Unsafe
                                                    {
                                                        return@environmentScope redirects.withDataPointer redirectScope@{
                                                            fds,
                                                            _ -> @Unsafe
                                                            {
                                                                return@redirectScope result.withDataPointer resultScope@{
                                                                    values,
                                                                    _ -> @Unsafe
                                                                    {
                                                                        return@resultScope nativeSpawn(
                                                                            executable,
                                                                            argv,
                                                                            argumentCount,
                                                                            envp,
                                                                            environmentCount,
                                                                            cwd,
                                                                            fds,
                                                                            values
                                                                        )
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
}

private fun <R> withRedirect(value: Stdio, block: (NativeStdio) -> R): R =
    when (value) {
        case Stdio.Inherit -> block(NativeStdio(0, NativeFileHandle(ULong.MAX_VALUE)))
        case Stdio.Null -> block(NativeStdio(1, NativeFileHandle(ULong.MAX_VALUE)))
        case Stdio.Pipe -> block(NativeStdio(2, NativeFileHandle(ULong.MAX_VALUE)))
        case Stdio.Redirect(file) -> file.withHandle { handle -> block(NativeStdio(3, handle)) }
    }

private fun appendString(builder: ByteArrayBuilder, value: OsString) {
    val bytes = value.toByteArray()
    for (byte in bytes) {
        if (byte == 0)
            throw IllegalArgumentException(Some("process string contains NUL"))
    }
    builder.append(bytes)
    builder.append(0.toByte())
}

private fun packArguments(executable: Path, arguments: Array<OsString>): Array<Byte> {
    if (executable.toOsString().toByteArray().size == 0L)
        throw IllegalArgumentException(Some("empty executable"))
    if (arguments.size == Long.MAX_VALUE)
        throw ArithmeticException()
    val builder = ByteArrayBuilder()
    appendString(builder, executable.toOsString())
    for (argument in arguments)
        appendString(builder, argument)
    return builder.toByteArray()
}

private fun packEnvironment(environment: Map<OsString, OsString>): Array<Byte> {
    val builder = ByteArrayBuilder()
    for ((name, value) in environment) {
        val bytes = name.toByteArray()
        if (bytes.size == 0L)
            throw IllegalArgumentException(Some("empty environment name"))
        for (byte in bytes) {
            if (byte == 0 || byte == 61)
                throw IllegalArgumentException(Some("invalid environment name"))
        }
        builder.append(bytes)
        builder.append(61.toByte())
        appendString(builder, value)
    }
    return builder.toByteArray()
}

@Extern(name = "scoop_platform_process_spawn", captureErrno = true)
private fun nativeSpawn(
    executable: Ptr<Byte>,
    arguments: Ptr<Byte>,
    argumentCount: Long,
    environment: Ptr<Byte>,
    environmentCount: Long,
    directory: Ptr<Byte>,
    redirects: Ptr<NativeStdio>,
    result: Ptr<NativeFileHandle>
): (Int, Int)

@CLayout
private struct NativeStdio(val kind: Int, val handle: NativeFileHandle)
