package scoop.platform.process

import scoop.collections.Map
import scoop.collections.toMap
import scoop.platform.env.currentDirectory
import scoop.platform.env.environment as currentEnvironment
import scoop.platform.fs.*
import scoop.platform.io.*
import scoop.platform.system.*

/**
 * The standard-stream routing chosen when spawning a child process.
 */
public enum Stdio {
    /**
     * Inherit the parent's corresponding standard stream.
     */
    Inherit,
    /**
     * Connect the stream to the platform null device.
     */
    Null,
    /**
     * Create a pipe exposed through ChildProcess.
     */
    Pipe,
    /**
     * Redirect through the supplied open file descriptor.
     */
    Redirect(val file: File)
}

/**
 * A process launch description with copied argument/environment data, an explicit working
 * directory, and standard-stream routing. Arguments are passed directly without shell
 * interpretation.
 */
public class Command public constructor(
    /**
     * The executable path selected for spawning.
     */
    public val executable: Path,
    arguments: Array<OsString> = [],
    environment: Map<OsString, OsString> = currentEnvironment(),
    /**
     * The child's initial working directory.
     */
    public val workingDirectory: Path = currentDirectory(),
    /**
     * The child standard-input routing.
     */
    public val stdin: Stdio = Stdio.Inherit,
    /**
     * The child standard-output routing.
     */
    public val stdout: Stdio = Stdio.Inherit,
    /**
     * The child standard-error routing when not merged.
     */
    public val stderr: Stdio = Stdio.Inherit,
    /**
     * Whether stderr is redirected to the child's selected stdout.
     */
    public val mergeError: Boolean = false
) {
    /**
     * The independent argument snapshot passed to the child.
     */
    public val arguments: Array<OsString> = Array<OsString>(arguments.size) { arguments[it] }
    /**
     * The environment snapshot supplied to the child.
     */
    public val environment: Map<OsString, OsString> = environment.toMap()

    init {
        if (mergeError) {
            when (stderr) {
                case Stdio.Inherit -> {}
                case _ -> throw IllegalArgumentException(
                    Some("merged stderr cannot be redirected separately")
                )
            }
        }
    }

    // Starts the process; PATH lookup is opt-in.
    /**
     * Starts an owned child process. PATH lookup occurs only when searchPath is requested.
     */
    public fun spawn(searchPath: Boolean = false): ChildProcess = start(searchPath)

    private fun start(search: Boolean): ChildProcess {
        val packed = SpawnInput(executable, arguments, environment, workingDirectory)
        val child = ChildProcess(isPipe(stdin), isPipe(stdout), isPipe(stderr))
        val result = MutableArray<NativeFileHandle>(3L) { NativeFileHandle(ULong.MAX_VALUE) }
        var denied: PlatformException? = None
        var missing: PlatformException? = None
        val paths =
            if (search)
                searchCandidates(executable, environment)
            else
                Array<Path>(1L) { executable }
        for (path in paths) {
            val(status, code) = packed.spawn(path, stdin, stdout, stderr, mergeError, result)
            if (status >= 0) {
                child.adopt(status, result)
                return child
            }
            val error = NativeError(NativeErrorDomain.PosixErrno, code)
            val failure =
                PlatformException("spawn", error.kind, Some(error), Some(path.toOsString()))
            if (!search)
                throw failure
            when (error.kind) {
                case PlatformErrorKind.PermissionDenied -> denied = Some(failure)
                case PlatformErrorKind.NotFound -> missing = Some(failure)
                case PlatformErrorKind.NotDirectory -> missing = Some(failure)
                case _ -> throw failure
            }
        }
        throw denied ?: missing!!
    }
}

internal fun isPipe(value: Stdio): Boolean =
    when (value) {
        case Stdio.Pipe -> true
        case _ -> false
    }

private fun searchCandidates(executable: Path, environment: Map<OsString, OsString>): Array<Path> {
    val name = executable.toOsString().toByteArray()
    for (byte in name) {
        if (byte == 47)
            return [executable]
    }
    val path =
        (
            environment[OsString.fromString("PATH")] ?: OsString.fromString("/bin:/usr/bin")
        ).toByteArray()
    val result = ArrayList<Path>()
    var start = 0L
    var index = 0L
    while (index <= path.size) {
        if (index == path.size || path[index] == 58) {
            val from = start
            val length = index - start
            val directory =
                Path.fromOsString(OsString.fromByteArray(Array<Byte>(length) { path[from + it] }))
            result.add(directory.resolve(executable))
            start = index + 1L
        }
        index += 1L
    }
    return Array<Path>(result.size) { result[it] }
}
