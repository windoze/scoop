package scoop.platform.env

import scoop.collections.LinkedHashMap
import scoop.collections.Map
import scoop.collections.toMap
import scoop.platform.fs.*
import scoop.platform.system.OsString

/**
 * Returns an independent value snapshot, distinguishing absence from an empty string.
 * Names and values retain the operating system's native encoding.
 */
public fun environmentVariable(name: String): OsString? =
    environmentVariable(OsString.fromString(name))

/**
 * Returns an independent value snapshot, distinguishing absence from an empty string.
 * Windows name lookup follows the system's case-insensitive rules.
 */
public fun environmentVariable(name: OsString): OsString? {
    val bytes = name.toByteArray()
    if (bytes.size == 0L)
        throw IllegalArgumentException(Some("empty environment name"))
    for (byte in bytes) {
        if (byte == 0 || byte == 61)
            throw IllegalArgumentException(Some("invalid environment name"))
    }
    @Unsafe
    {
        return name.withPlatformString {
            pointer -> @Unsafe
            {
                return@withPlatformString nativeEnvironmentValue(pointer).takeOptionalString(
                    "environment variable",
                    Some(name)
                )
            }
        }
    }
}

/**
 * Returns an immutable snapshot with the original spelling of environment names. Map key
 * equality remains OsString equality, including on Windows.
 */
public fun environment(): Map<OsString, OsString> {
    val result = LinkedHashMap<OsString, OsString>()
    @Unsafe
    {
        val bytes = nativeEnvironment().takeString("environment").toByteArray()
        var start = 0L
        while (start < bytes.size) {
            var end = start
            while (end < bytes.size && bytes[end] != 0)
                end += 1L
            var separator = start
            while (separator < end && bytes[separator] != 61)
                separator += 1L
            if (separator > start && separator < end) {
                val first = start
                val split = separator
                val name = OsString.fromByteArray(Array<Byte>(split - first) { bytes[first + it] })
                val value =
                    OsString.fromByteArray(Array<Byte>(end - split - 1L) { bytes[split + 1L + it] })
                if (!result.containsKey(name))
                    result.put(name, value)
            }
            start = end + 1L
        }
        return result.toMap()
    }
}

/** Queries the actual current working directory, without consulting PWD. */
public fun currentDirectory(): Path {
    @Unsafe
    {
        return nativeCurrentDirectory().takePath("current directory")
    }
}

/**
 * Queries the user's home directory. Windows prefers USERPROFILE then the process user's
 * profile; POSIX prefers HOME then the current uid's passwd record.
 */
public fun homeDirectory(): Path? {
    @Unsafe
    {
        return when (nativeHomeDirectory().takeOptionalString("home directory")) {
            case Some(value) -> Some(Path.fromOsString(value))
            case None -> None
        }
    }
}

@Extern(name = "scoop_platform_environment_value_result")
private fun nativeEnvironmentValue(name: Ptr<Byte>): NativeOsString

@Extern(name = "scoop_platform_environment_result")
private fun nativeEnvironment(): NativeOsString

@Extern(name = "scoop_platform_current_directory_result")
private fun nativeCurrentDirectory(): NativeOsString

@Extern(name = "scoop_platform_home_directory_result")
private fun nativeHomeDirectory(): NativeOsString
