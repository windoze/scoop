package scoop.platform.io

import scoop.platform.memory.NativeByteBuffer
import scoop.platform.fs.*
import scoop.platform.system.*

internal fun readFileHandle(
    fd: NativeFileHandle,
    buffer: NativeByteBuffer,
    count: Long,
    context: OsString? = None
): Long {
    requireTransfer(count, buffer.writableBytes)
    if (count == 0L)
        return 0L
    @Unsafe
    {
        return buffer.withWritableBytes {
            pointer,
            _ -> @Unsafe
            {
                return@withWritableBytes nativeFileRead(fd, pointer!!, count).checked(
                    "read",
                    context
                )
            }
        }
    }
}

internal fun writeFileHandle(
    fd: NativeFileHandle,
    buffer: NativeByteBuffer,
    count: Long,
    context: OsString? = None
): Long {
    requireTransfer(count, buffer.readableBytes)
    if (count == 0L)
        return 0L
    @Unsafe
    {
        val written =
            buffer.withReadableBytes {
                pointer,
                _ -> @Unsafe
                {
                    return@withReadableBytes nativeFileWrite(fd, pointer!!, count).checked(
                        "write",
                        context
                    )
                }
            }
        if (written == 0L)
            throw WriteZeroException()
        buffer.skip(written)
        return written
    }
}
