package scoop.platform.io

import scoop.platform.fs.*
import scoop.platform.memory.NativeByteBuffer

private class StandardSource: ByteSource {
    public override fun readInto(buffer: NativeByteBuffer, count: Long): Long {
        requireTransfer(count, buffer.writableBytes)
        if (count == 0L)
            return 0L
        return readFileHandle(standardHandle(0), buffer, count)
    }
}

private class StandardSink(private val stream: Int): ByteSink {
    public override fun writeFrom(buffer: NativeByteBuffer, count: Long): Long {
        requireTransfer(count, buffer.readableBytes)
        if (count == 0L)
            return 0L
        return writeFileHandle(standardHandle(stream), buffer, count)
    }
    public override fun flush() {}
}

/**
 * A borrowed view of the process standard input stream; it does not expose ownership of the
 * process descriptor.
 */
public val standardInput: ByteSource = StandardSource()

/**
 * A borrowed view of the process standard output stream; it does not expose ownership of the
 * process descriptor.
 */
public val standardOutput: ByteSink = StandardSink(1)

/**
 * A borrowed view of the process standard error stream; it does not expose ownership of the
 * process descriptor.
 */
public val standardError: ByteSink = StandardSink(2)

/**
 * Returns a separately owned duplicate of standard input, which the caller must close.
 */
public fun duplicateStandardInput(): File = File.duplicateHandle(standardHandle(0))

/**
 * Returns a separately owned duplicate of standard output, which the caller must close.
 */
public fun duplicateStandardOutput(): File = File.duplicateHandle(standardHandle(1))

/**
 * Returns a separately owned duplicate of standard error, which the caller must close.
 */
public fun duplicateStandardError(): File = File.duplicateHandle(standardHandle(2))

private fun standardHandle(stream: Int): NativeFileHandle {
    @Unsafe
    {
        return nativeFileStandard(stream).checked("standard stream")
    }
}
