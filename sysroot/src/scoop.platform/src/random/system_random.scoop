package scoop.platform.random

import scoop.platform.io.requireTransfer
import scoop.platform.memory.NativeByteBuffer
import scoop.platform.system.*
import scoop.random.Random

/**
 * A random source backed by the operating system, independent of deterministic seeded generators.
 */
public object SystemRandom: Random {
    /**
     * Returns the requested number of random bits from the operating-system source.
     */
    public override fun nextBits(bitCount: Int): Int {
        if (bitCount < 0 || bitCount > 32)
            throw IllegalArgumentException(Some("invalid random bit count"))
        if (bitCount == 0)
            return 0
        val bytes = nextBytes(4L)
        var result = 0u
        for (byte in bytes)
            result = (result shl 8) or byte.toUByte().toUInt()
        return (result shr (32L - bitCount.toLong())).toInt()
    }

    /**
     * Returns new random bytes or fills the specified mutable-array range, depending on the
     * overload.
     */
    public override fun nextBytes(size: Long): Array<Byte> {
        if (size < 0L)
            throw IllegalArgumentException(Some("negative byte count"))
        val array = MutableArray<Byte>(size) { 0.toByte() }
        nextBytes(array)
        return array.toArray()
    }

    /**
     * Returns new random bytes or fills the specified mutable-array range, depending on the
     * overload.
     */
    public override fun nextBytes(
        array: MutableArray<Byte>,
        fromIndex: Long,
        toIndex: Long
    ): MutableArray<Byte> {
        if (fromIndex < 0L || toIndex < 0L || fromIndex > array.size || toIndex > array.size)
            throw IndexOutOfBoundsException()
        if (fromIndex > toIndex)
            throw IllegalArgumentException(Some("reversed byte range"))
        if (fromIndex == toIndex)
            return array
        @Unsafe
        {
            array.withDataPointer {
                pointer,
                _ -> @Unsafe
                {
                    var offset = fromIndex
                    while (offset < toIndex)
                        offset += entropy(pointer + offset, toIndex - offset)
                }
            }
        }
        return array
    }

    /**
     * Appends count operating-system random bytes to the buffer's writable region.
     */
    public fun fill(buffer: NativeByteBuffer, count: Long = buffer.writableBytes): Long {
        requireTransfer(count, buffer.writableBytes)
        var remaining = count
        while (remaining > 0L) {
            val requested = remaining
            @Unsafe
            {
                val written =
                    buffer.withWritableBytes {
                        pointer,
                        _ -> @Unsafe
                        {
                            return@withWritableBytes entropy(pointer!!, requested)
                        }
                    }
                remaining -= written
            }
        }
        return count
    }
}

@Unsafe
private fun entropy(pointer: Ptr<Byte>, count: Long): Long {
    val result = nativeEntropy(pointer, count)
    if (result.count < 0L) {
        val domain =
            if (operatingSystem == OperatingSystem.Windows)
                NativeErrorDomain.NtStatus
            else
                NativeErrorDomain.PosixErrno
        val error = NativeError(domain, result.error)
        throw PlatformException("system entropy", error.kind, Some(error))
    }
    return result.count
}

@CLayout
private struct NativeEntropy(val count: Long, val error: Int)

@Extern(name = "scoop_platform_entropy")
private fun nativeEntropy(pointer: Ptr<Byte>, count: Long): NativeEntropy
