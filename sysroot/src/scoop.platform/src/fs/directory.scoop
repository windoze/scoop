package scoop.platform.fs

import scoop.platform.system.failOperatingSystem
import scoop.platform.system.OsString

/**
 * One directory entry's native name and path relative to the enumerated directory.
 */
public struct DirectoryEntry(val name: OsString, val path: Path)

/**
 * An owned, single-pass directory cursor implementing both Iterable and Iterator. Close it when
 * finished or when abandoning enumeration.
 */
public class DirectoryEntries private constructor(private val path: Path)
: Iterable<DirectoryEntry>, Iterator<DirectoryEntry>, Closeable {
    private var directory: Ptr<Unit>? = None
    private var finished: Boolean = false
    private var active: Boolean = false
    /**
     * Whether the directory handle has been closed.
     */
    public val isClosed: Boolean get() = directory == None

    /**
     * Directory cursor construction used by path enumeration.
     */
    public companion object {
        internal fun open(path: Path): DirectoryEntries {
            val result = DirectoryEntries(path)
            @Unsafe
            {
                val opened =
                    path.withPlatformPath {
                        name -> @Unsafe
                        {
                            return@withPlatformPath nativeDirectoryOpen(name)
                        }
                    }
                if (opened.error != 0)
                    failOperatingSystem("open directory", opened.error, Some(path.toOsString()))
                result.directory = opened.owner
            }
            return result
        }
    }

    /**
     * Returns this same single-pass cursor; it does not restart directory enumeration.
     */
    public override operator fun iterator(): Iterator<DirectoryEntry> = this

    /**
     * Returns the next entry, or None when enumeration is exhausted.
     */
    public override fun next(): DirectoryEntry? {
        if (finished)
            return None
        if (directory == None)
            throw IllegalStateException(Some("directory is closed"))
        if (active)
            throw IllegalStateException(Some("directory operation is active"))
        active = true
        try {
            @Unsafe
            {
                val entry = nativeDirectoryNext(directory!!)
                if (entry.error != 0)
                    failOperatingSystem("read directory", entry.error, Some(path.toOsString()))
                if (entry.name == None) {
                    finished = true
                    closeNative()
                    return None
                }
                val name = copyPlatformString(entry.name!!, entry.length)
                return Some(DirectoryEntry(name, path.resolve(Path.fromOsString(name))))
            }
        } finally {
            active = false
        }
    }

    private fun closeNative() {
        val owned = directory
        directory = None
        when (owned) {
            case Some(pointer) -> @Unsafe
            {
                nativeDirectoryClose(pointer).checked("close directory", Some(path.toOsString()))
            }
            case None -> {}
        }
    }

    /**
     * Closes the directory enumeration handle.
     */
    public override fun close() {
        if (directory == None)
            return
        if (active)
            throw IllegalStateException(Some("directory operation is active"))
        closeNative()
    }

    release {
        when (directory) {
            case Some(pointer) -> @Unsafe
            {
                nativeDirectoryClose(pointer)
            }
            case None -> {}
        }
    }
}

@CLayout
private struct NativeDirectoryOpened(val owner: Ptr<Unit>?, val error: Int)

@CLayout
private struct NativeDirectoryEntry(val name: Ptr<Byte>?, val length: Long, val error: Int)

@Extern(name = "scoop_platform_directory_owner_open")
private fun nativeDirectoryOpen(path: Ptr<Byte>): NativeDirectoryOpened

@Extern(name = "scoop_platform_directory_owner_next")
private fun nativeDirectoryNext(directory: Ptr<Unit>): NativeDirectoryEntry

@Extern(name = "scoop_platform_directory_owner_close")
private fun nativeDirectoryClose(directory: Ptr<Unit>): NativeFileResult
