package scoop.platform.fs

import scoop.bytes.ByteArrayBuilder
import scoop.platform.system.OsString
import scoop.platform.system.byteContentsEqual
import scoop.platform.system.byteContentsHash

/**
 * An immutable native byte path with no embedded NUL. Lexical operations do not access the
 * filesystem or resolve symbolic links; equality compares stored bytes.
 */
public class Path private constructor(private val bytes: Array<Byte>): Equals<Path>, Hash {
    private val syntax: PathSyntax = pathSyntax(bytes)
    /**
     * Whether the path is fully qualified under the compilation target's rules.
     */
    public val isAbsolute: Boolean get() = syntax.isAbsolute

    /**
     * The last non-separator component, or None for a root, empty path, dot, or dot-dot component.
     */
    public val fileName: OsString? get() {
        val end = endWithoutSeparators()
        if (end == syntax.rootEnd)
            return None
        val start = componentStart(end)
        val name =
            OsString.fromByteArray(Array<Byte>(end - start) { index -> bytes[start + index] })
        if (name == OsString.fromString(".") || name == OsString.fromString(".."))
            return None
        return Some(name)
    }

    /**
     * The lexical parent when one exists; this does not query the filesystem.
     */
    public val parent: Path? get() {
        val end = endWithoutSeparators()
        if (end == syntax.rootEnd)
            return None
        var start = componentStart(end)
        while (start > syntax.rootEnd && syntax.isSeparator(bytes[start - 1L]))
            start -= 1L
        val count =
            if (start == syntax.rootEnd && syntax.rootEnd > syntax.prefixLength)
                syntax.prefixLength + 1L
            else
                start
        return Some(Path(Array<Byte>(count) { index -> bytes[index] }))
    }

    private fun endWithoutSeparators(): Long {
        var end = bytes.size
        while (end > syntax.rootEnd && syntax.isSeparator(bytes[end - 1L]))
            end -= 1L
        return end
    }

    private fun componentStart(end: Long): Long {
        var start = end
        while (start > syntax.rootEnd && !syntax.isSeparator(bytes[start - 1L]))
            start -= 1L
        return start
    }

    /**
     * Returns nonempty components after the target's native path prefix and root.
     */
    public fun components(): Array<OsString> {
        val parts = ArrayList<OsString>()
        var cursor = syntax.rootEnd
        while (cursor < bytes.size) {
            if (syntax.isSeparator(bytes[cursor])) {
                cursor += 1L;
                continue
            }
            val start = cursor
            while (cursor < bytes.size && !syntax.isSeparator(bytes[cursor]))
                cursor += 1L
            parts.add(
                OsString.fromByteArray(
                    Array<Byte>(cursor - start) { index -> bytes[start + index] }
                )
            )
        }
        return parts.toArray()
    }

    /**
     * Joins a relative child to this path. A prefixed or absolute child replaces the base; a
     * Windows rooted child retains the base's prefix.
     */
    public fun resolve(child: Path): Path {
        if (child.isAbsolute || child.syntax.prefixLength > 0L || bytes.size == 0L)
            return child
        if (child.bytes.size == 0L)
            return this
        val result = ByteArrayBuilder()
        if (child.syntax.hasRoot) {
            result.append(Array<Byte>(syntax.prefixLength) { index -> bytes[index] })
            appendChild(result, child)
            return Path(result.toByteArray())
        }
        result.append(bytes)
        if (
            !syntax.isSeparator(bytes[bytes.size - 1L]) &&
                !(syntax.prefixLength == bytes.size && !syntax.hasRoot)
        )
            result.append(syntax.separator)
        appendChild(result, child)
        return Path(result.toByteArray())
    }

    private fun appendChild(result: ByteArrayBuilder, child: Path) {
        if (syntax.verbatim && !child.syntax.verbatim) {
            result.append(
                Array<Byte>(child.bytes.size) {
                    index ->
                    val byte = child.bytes[index]
                    if (child.syntax.isSeparator(byte))
                        syntax.separator
                    else
                        byte
                }
            )
        } else
            result.append(child.bytes)
    }

    /**
     * Removes redundant separators and dot components and folds lexical dot-dot pairs. It does not
     * follow links or guarantee equivalence through symbolic links.
     */
    public fun normalizeLexically(): Path {
        if (syntax.verbatim)
            return this
        val dot = OsString.fromString(".")
        val up = OsString.fromString("..")
        val parts = ArrayList<OsString>()
        for (part in components()) {
            if (part == dot)
                continue
            if (part == up) {
                if (parts.size > 0L && parts[parts.size - 1L] != up)
                    parts.removeAt(parts.size - 1L)
                else
                    if (!syntax.hasRoot)
                        parts.add(part)
            } else
                parts.add(part)
        }
        val result = ByteArrayBuilder()
        for (byte in Array<Byte>(syntax.prefixLength) { index -> bytes[index] }) {
            result.append(
                if (syntax.isSeparator(byte))
                    syntax.separator
                else
                    byte
            )
        }
        if (syntax.hasRoot)
            result.append(syntax.separator)
        val prefix = result.size
        for (part in parts) {
            if (result.size > prefix)
                result.append(syntax.separator)
            result.append(part.toByteArray())
        }
        if (result.size == 0L)
            result.append(46.toByte())
        return Path(result.toByteArray())
    }

    /**
     * Copies the stored path bytes into an operating-system string.
     */
    public fun toOsString(): OsString = OsString.fromByteArray(bytes)
    /**
     * Decodes the stored bytes as strict UTF-8, rejecting malformed encoding.
     */
    public fun decodeUtf8(): String = toOsString().decodeUtf8()
    /**
     * Decodes stored bytes with replacement for malformed UTF-8.
     */
    public fun decodeUtf8Lossy(): String = toOsString().decodeUtf8Lossy()
    /**
     * Returns a lossy UTF-8 presentation suitable for displaying native names.
     */
    public fun display(): String = decodeUtf8Lossy()
    /**
     * Compares the exact stored byte sequences.
     */
    public override operator fun equals(other: Path): Boolean =
        byteContentsEqual(bytes, other.bytes)
    /**
     * Hashes the stored bytes consistently with equality.
     */
    public override fun hash(): Long = byteContentsHash(bytes)

    /**
     * Creates independent native-byte values from text or existing native bytes.
     */
    public companion object {
        /**
         * Encodes a Unicode path as UTF-8 and rejects embedded NUL.
         */
        public fun fromString(value: String): Path = fromOsString(OsString.fromString(value))
        /**
         * Copies a native path after rejecting embedded NUL bytes.
         */
        public fun fromOsString(value: OsString): Path {
            val bytes = value.toByteArray()
            for (byte in bytes) {
                if (byte == 0)
                    throw IllegalArgumentException(Some("path contains NUL"))
            }
            return Path(bytes)
        }
    }
}
