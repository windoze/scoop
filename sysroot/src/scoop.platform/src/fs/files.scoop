package scoop.platform.fs

import scoop.platform.io.*
import scoop.platform.memory.NativeByteBuffer
import scoop.platform.memory.nativeMemoryFree
import scoop.platform.native.decodeFileMetadata
import scoop.platform.native.requireFileMode
import scoop.platform.native.temporaryPathPattern
import scoop.platform.env.temporaryDirectory
import scoop.platform.system.*

public fun Path.readAllBytes(): Array<Byte> = File.open(this).use { it.readAllBytes() }
public fun Path.readText(): String = File.open(this).use { it.readText() }
public fun Path.readTextLossy(): String = File.open(this).use { it.readTextLossy() }

public fun Path.writeAllBytes(bytes: List<Byte>, append: Boolean = false) {
    val input = bytes.toArray()
    File.open(this, outputOptions(append)).use { it.writeAllBytes(input) }
}

public fun Path.writeText(text: String, append: Boolean = false) {
    File.open(this, outputOptions(append)).use { it.writeText(text) }
}

public fun Path.copyTo(destination: Path, replaceExisting: Boolean = false): Long {
    return File.open(this).use { input ->
        val options = OpenOptions(read = false, write = true, create = true, createNew = !replaceExisting)
        File.open(destination, options).use { output ->
            input.withDescriptor { sourceFd ->
                output.withDescriptor { destinationFd ->
                    @Unsafe {
                        val (same, error) = nativeSameFile(sourceFd, destinationFd)
                        checkNativeStatus(same, error, "compare files", Some(destination.toOsString()))
                        if (same != 0) throw IllegalArgumentException(Some("cannot copy a file onto itself"))
                    }
                }
            }
            output.truncate(0L)
            input.copyTo(output)
        }
    }
}

public fun Path.moveTo(destination: Path, replaceExisting: Boolean = false) {
    @Unsafe {
        this.withNativePath { from ->
            @Unsafe {
                destination.withNativePath { to ->
                    @Unsafe {
                        val (status, error) = nativePathMove(from, to, replaceExisting)
                        checkNativeStatus(status, error, "move", Some(destination.toOsString()))
                    }
                }
            }
        }
    }
}

public fun Path.metadata(followLinks: Boolean = true): FileMetadata {
    @Unsafe {
        return this.withNativePath { pointer ->
            @Unsafe {
                val (data, error) = nativeMetadata(-1, Some(pointer), followLinks)
                return@withNativePath decodeFileMetadata(data, error, Some(this.toOsString()))
            }
        }
    }
}

public fun Path.exists(followLinks: Boolean = true): Boolean {
    try { this.metadata(followLinks); return true }
    catch (error: PlatformException) {
        if (error.kind == PlatformErrorKind.NotFound || error.kind == PlatformErrorKind.NotDirectory) return false
        throw error
    }
}

public fun Path.createDirectory(mode: Int = 0x1ff) {
    requireFileMode(mode)
    @Unsafe {
        this.withNativePath { pointer ->
            @Unsafe {
                val (status, error) = nativePathMkdir(pointer, mode)
                checkNativeStatus(status, error, "create directory", Some(this.toOsString()))
            }
        }
    }
}

public fun Path.createDirectories(mode: Int = 0x1ff) {
    try { this.createDirectory(mode); return }
    catch (error: PlatformException) {
        if (error.kind == PlatformErrorKind.AlreadyExists) {
            if (this.metadata().kind == FileKind.Directory) return
            throw error
        }
        if (error.kind != PlatformErrorKind.NotFound || this.parent == None) throw error
    }
    this.parent!!.createDirectories(mode)
    try { this.createDirectory(mode) }
    catch (error: PlatformException) {
        if (error.kind != PlatformErrorKind.AlreadyExists || this.metadata().kind != FileKind.Directory) throw error
    }
}

public fun Path.delete() {
    @Unsafe {
        this.withNativePath { pointer ->
            @Unsafe {
                val (status, error) = nativePathDelete(pointer)
                checkNativeStatus(status, error, "delete", Some(this.toOsString()))
            }
        }
    }
}

public fun Path.deleteRecursively() {
    if (this.metadata(followLinks = false).kind == FileKind.Directory) {
        this.entries().use { directory -> for (entry in directory) entry.path.deleteRecursively() }
    }
    this.delete()
}

public fun Path.entries(): DirectoryEntries = DirectoryEntries.open(this)

public fun Path.createSymbolicLink(target: Path) {
    @Unsafe {
        this.withNativePath { name ->
            @Unsafe {
                target.withNativePath { destination ->
                    @Unsafe {
                        val (status, error) = nativePathSymlink(name, destination)
                        checkNativeStatus(status, error, "create symbolic link", Some(this.toOsString()))
                    }
                }
            }
        }
    }
}

public fun Path.readSymbolicLink(): Path {
    return NativeByteBuffer.allocate(256L).use { buffer ->
        @Unsafe {
            return@use this.withNativePath { name ->
                @Unsafe {
                    while (true) {
                        buffer.clear()
                        val count = buffer.withWritableBytes { pointer, capacity ->
                            @Unsafe {
                                val (read, error) = nativePathReadlink(name, pointer!!, capacity)
                                return@withWritableBytes checkNative(read, error, "read symbolic link", Some(this.toOsString()))
                            }
                        }
                        if (count < buffer.capacity) return@withNativePath Path.fromOsString(OsString.fromByteArray(buffer.readBytes(count)))
                        if (buffer.capacity == Long.MAX_VALUE) throw ArithmeticException()
                        val needed = buffer.capacity + 1L
                        buffer.clear()
                        buffer.ensureWritable(needed)
                    }
                }
            }
        }
    }
}

public fun Path.canonicalize(): Path {
    @Unsafe {
        return this.withNativePath { name ->
            @Unsafe {
                val (pointer, error) = nativePathRealpath(name)
                if (pointer == None) failNative("canonicalize", error, Some(this.toOsString()))
                try { return@withNativePath Path.fromOsString(copyNativeString(pointer!!)) }
                finally { nativeMemoryFree(pointer!!) }
            }
        }
    }
}

public fun createTempFile(parent: Path? = None, prefix: String = "scoop-"): Path = temporaryPath(parent, prefix, false)
public fun createTempDirectory(parent: Path? = None, prefix: String = "scoop-"): Path = temporaryPath(parent, prefix, true)


private fun outputOptions(append: Boolean): OpenOptions =
    OpenOptions(read = false, write = true, create = true, append = append, truncate = !append)

private fun temporaryPath(parent: Path?, prefix: String, directory: Boolean): Path {
    val base = parent ?: temporaryDirectory()
    val pattern = temporaryPathPattern(base, prefix).toOsString().toByteArray()
    @Unsafe {
        if (pattern.size == Long.MAX_VALUE) throw ArithmeticException()
        val writable = MutableArray<Byte>(pattern.size + 1L) { index -> if (index == pattern.size) 0.toByte() else pattern[index] }
        return writable.withDataPointer { pointer, _ ->
            @Unsafe {
                val (status, error) = nativePathTemporary(pointer, directory)
                checkNativeStatus(status, error, "create temporary path", Some(base.toOsString()))
                return@withDataPointer Path.fromOsString(copyNativeString(pointer))
            }
        }
    }
}

@Extern(name = "scoop_platform_path_mkdir", captureErrno = true)
private fun nativePathMkdir(path: Ptr<Byte>, mode: Int): (Int, Int)
@Extern(name = "scoop_platform_path_delete", captureErrno = true)
private fun nativePathDelete(path: Ptr<Byte>): (Int, Int)
@Extern(name = "scoop_platform_path_move", captureErrno = true)
private fun nativePathMove(source: Ptr<Byte>, destination: Ptr<Byte>, replace: Boolean): (Int, Int)
@Extern(name = "scoop_platform_path_symlink", captureErrno = true)
private fun nativePathSymlink(link: Ptr<Byte>, target: Ptr<Byte>): (Int, Int)
@Extern(name = "scoop_platform_path_readlink", captureErrno = true)
private fun nativePathReadlink(path: Ptr<Byte>, buffer: Ptr<Byte>, capacity: Long): (Long, Int)
@Extern(name = "scoop_platform_path_realpath", captureErrno = true)
private fun nativePathRealpath(path: Ptr<Byte>): (Ptr<Byte>?, Int)
@Extern(name = "scoop_platform_temporary_directory")
internal fun nativeTemporaryDirectory(): Ptr<Byte>
@Extern(name = "scoop_platform_path_temporary", captureErrno = true)
private fun nativePathTemporary(pattern: Ptr<Byte>, directory: Boolean): (Int, Int)
