package scoop.platform.fs

import scoop.platform.native.NativeFileMetadata
import scoop.time.Instant

public enum FileKind { Regular, Directory, SymbolicLink, BlockDevice, CharacterDevice, Fifo, Socket, Other }

public struct FileMetadata(
    val kind: FileKind, val size: Long, val permissions: Int,
    val accessedAt: Instant, val modifiedAt: Instant, val changedAt: Instant, val createdAt: Instant?
)

@Extern(name = "scoop_platform_file_metadata", captureErrno = true)
internal fun nativeMetadata(fd: Int, path: Ptr<Byte>?, follow: Boolean): (NativeFileMetadata, Int)
