package scoop.platform.fs

import scoop.platform.system.OsString

/**
 * Borrows a NUL-terminated native encoding for the callback. Embedded NUL is rejected and the
 * pointer must not escape.
 */
@Unsafe
public fun <R> OsString.withNativeString(block: (Ptr<Byte>) -> R): R {
    val source = toByteArray()
    for (byte in source) {
        if (byte == 0) throw IllegalArgumentException(Some("native string contains NUL"))
    }
    if (source.size == Long.MAX_VALUE) throw ArithmeticException()
    val bytes = Array<Byte>(source.size + 1L) { index -> if (index == source.size) 0.toByte() else source[index] }
    return bytes.withDataPointer { pointer, _ -> block(pointer) }
}

/**
 * Borrows the path as a NUL-terminated native byte string for the callback only.
 */
@Unsafe
public fun <R> Path.withNativePath(block: (Ptr<Byte>) -> R): R = toOsString().withNativeString(block)

/**
 * Copies a readable NUL-terminated native byte string into OsString. The unsafe caller must keep
 * the full region valid.
 */
@Unsafe
public fun copyNativeString(pointer: Ptr<Byte>): OsString {
    val length = nativeStringLength(pointer)
    return OsString.fromByteArray(Array<Byte>(length) { index -> @Unsafe { return@Array pointer.load(index) } })
}

@GCLeaf @Extern(name = "scoop_platform_string_length")
private fun nativeStringLength(pointer: Ptr<Byte>): Long
