package scoop.platform.concurrent

import scoop.platform.io.failNative
import scoop.time.Duration

/**
 * A native condition variable associated with one mutex. Wait while holding that mutex and recheck
 * the application predicate after waking.
 */
public class ConditionVariable public constructor(
    /**
     * The mutex released during waiting and reacquired before return.
     */
    public val mutex: Mutex
): Disposable {
    private var native: Ptr<Unit>? = None
    private val active: AtomicLong = AtomicLong(0L)
    /**
     * Whether native condition-variable state has been released.
     */
    public val isDisposed: Boolean get() = native == None

    init {
        native =
            mutex.withNative {
                _ -> @Unsafe
                {
                    val(created, error) = nativeConditionCreate()
                    if (created == None)
                        failNative("create condition variable", error)
                    return@withNative created
                }
            }
    }

    private fun <R> withNative(block: (Ptr<Unit>) -> R): R {
        if (native == None)
            throw IllegalStateException(Some("condition variable is disposed"))
        active.fetchAdd(1L, MemoryOrder.Relaxed)
        try {
            return block(native!!)
        }
        finally {
            active.fetchSub(1L, MemoryOrder.Relaxed)
        }
    }

    /**
     * Atomically releases the held mutex while waiting, then reacquires it. The timed overload
     * returns false on timeout; a wake does not prove the application predicate.
     */
    public fun await() {
        wait(None)
    }
    /**
     * Atomically releases the held mutex while waiting, then reacquires it. The timed overload
     * returns false on timeout; a wake does not prove the application predicate.
     */
    public fun await(timeout: Duration): Boolean {
        if (timeout.floorSeconds < 0L)
            throw IllegalArgumentException(Some("negative condition timeout"))
        return wait(Some(timeout))
    }

    private fun wait(timeout: Duration?): Boolean =
        withNative {
            condition -> mutex.withNative lockScope@{
                lock -> @Unsafe
                {
                    val result =
                        nativeConditionWait(
                            condition,
                            lock,
                            timeout != None,
                            timeout?.floorSeconds ?: 0L,
                            timeout?.nanosecondsOfSecond ?: 0
                        )
                    return@lockScope result.check("condition wait") == 0
                }
            }
        }

    /**
     * Wakes one eligible waiter; callers must still protect the shared predicate with the
     * associated mutex.
     */
    public fun signal() {
        notify(false)
    }
    /**
     * Wakes all eligible waiters so they can recheck their predicates.
     */
    public fun broadcast() {
        notify(true)
    }
    private fun notify(all: Boolean) {
        withNative {
            pointer -> @Unsafe
            {
                nativeConditionSignal(pointer, all).check("condition notification")
            }
        }
    }

    /**
     * Destroys the condition variable; disposal with an active wait is rejected.
     */
    public override fun dispose() {
        if (native == None)
            return
        if (active.load(MemoryOrder.Relaxed) != 0L)
            throw IllegalStateException(Some("condition wait is active"))
        @Unsafe
        {
            nativeConditionDestroy(native!!).check("dispose condition variable")
            native = None
        }
    }

    release {
        when (native) {
            case Some(pointer) -> @Unsafe
            {
                nativeConditionDestroy(pointer)
            }
            case None -> {}
        }
    }
}

@Extern(name = "scoop_platform_condition_create", captureErrno = true)
private fun nativeConditionCreate(): (Ptr<Unit>?, Int)

@Extern(name = "scoop_platform_condition_wait")
private fun nativeConditionWait(
    condition: Ptr<Unit>,
    mutex: Ptr<Unit>,
    timed: Boolean,
    seconds: Long,
    nanoseconds: Int
): NativeSyncResult

@Extern(name = "scoop_platform_condition_signal")
private fun nativeConditionSignal(condition: Ptr<Unit>, all: Boolean): NativeSyncResult

@Extern(name = "scoop_platform_condition_destroy")
private fun nativeConditionDestroy(condition: Ptr<Unit>): NativeSyncResult
