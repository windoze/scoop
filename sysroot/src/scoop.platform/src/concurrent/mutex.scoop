package scoop.platform.concurrent

import scoop.platform.io.failNative

/**
 * An owned native mutex. Pair lock/unlock on the owning thread or use withLock; dispose only when
 * no operation or held lock remains.
 */
public class Mutex: Disposable {
    private var native: Ptr<Unit>? = None
    private val active: AtomicLong = AtomicLong(0L)
    /**
     * Whether the native mutex has been released.
     */
    public val isDisposed: Boolean get() = native == None

    public constructor() {
        @Unsafe
        {
            val(pointer, error) = nativeMutexCreate()
            if (pointer == None)
                failNative("create mutex", error)
            native = pointer
        }
    }

    internal fun <R> withNative(block: (Ptr<Unit>) -> R): R {
        if (native == None)
            throw IllegalStateException(Some("mutex is disposed"))
        active.fetchAdd(1L, MemoryOrder.Relaxed)
        try {
            return block(native!!)
        }
        finally {
            active.fetchSub(1L, MemoryOrder.Relaxed)
        }
    }

    /**
     * Blocks until this thread acquires the mutex.
     */
    public fun lock() {
        withNative {
            pointer -> @Unsafe
            {
                nativeMutexLock(pointer, false).check("mutex lock")
            }
        }
    }

    /**
     * Attempts acquisition without blocking and returns whether this thread acquired the mutex.
     */
    public fun tryLock(): Boolean =
        withNative {
            pointer -> @Unsafe
            {
                return@withNative nativeMutexLock(pointer, true).check("mutex try lock") == 0
            }
        }

    /**
     * Releases the mutex held by this thread.
     */
    public fun unlock() {
        withNative {
            pointer -> @Unsafe
            {
                nativeMutexUnlock(pointer).check("mutex unlock")
            }
        }
    }

    /**
     * Runs the block under the mutex and unlocks on both normal and exceptional exit.
     */
    public fun <T> withLock(block: () -> T): T {
        lock()
        try {
            return block()
        }
        finally {
            unlock()
        }
    }

    /**
     * Destroys the native mutex when it is no longer in use.
     */
    public override fun dispose() {
        if (native == None)
            return
        if (active.load(MemoryOrder.Relaxed) != 0L)
            throw IllegalStateException(Some("mutex operation is active"))
        @Unsafe
        {
            nativeMutexDestroy(native!!).check("dispose mutex")
            native = None
        }
    }

    release {
        when (native) {
            case Some(pointer) -> @Unsafe
            {
                nativeMutexDestroy(pointer)
            }
            case None -> {}
        }
    }
}

@Extern(name = "scoop_platform_mutex_create", captureErrno = true)
private fun nativeMutexCreate(): (Ptr<Unit>?, Int)

@Extern(name = "scoop_platform_mutex_lock")
private fun nativeMutexLock(mutex: Ptr<Unit>, attempt: Boolean): NativeSyncResult

@Extern(name = "scoop_platform_mutex_unlock")
private fun nativeMutexUnlock(mutex: Ptr<Unit>): NativeSyncResult

@Extern(name = "scoop_platform_mutex_destroy")
private fun nativeMutexDestroy(mutex: Ptr<Unit>): NativeSyncResult
