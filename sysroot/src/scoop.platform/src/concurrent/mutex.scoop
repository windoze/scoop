package scoop.platform.concurrent

import scoop.platform.io.checkNativeStatus
import scoop.platform.io.failNative

public class Mutex : Disposable {
    private var native: Ptr<Unit>? = None
    private val active: AtomicLong = AtomicLong(0L)
    public val isDisposed: Boolean get() = native == None

    public constructor() {
        @Unsafe {
            val (pointer, error) = nativeMutexCreate()
            if (pointer == None) failNative("create mutex", error)
            native = pointer
        }
    }

    internal fun <R> withNative(block: (Ptr<Unit>) -> R): R {
        if (native == None) throw IllegalStateException(Some("mutex is disposed"))
        active.fetchAdd(1L, MemoryOrder.Relaxed)
        try { return block(native!!) }
        finally { active.fetchSub(1L, MemoryOrder.Relaxed) }
    }

    public fun lock() {
        withNative { pointer ->
            @Unsafe {
                val (status, error) = nativeMutexLock(pointer, false)
                checkNativeStatus(status, error, "mutex lock")
            }
        }
    }

    public fun tryLock(): Boolean = withNative { pointer ->
        @Unsafe {
            val (status, error) = nativeMutexLock(pointer, true)
            checkNativeStatus(status, error, "mutex try lock")
            return@withNative status == 0
        }
    }

    public fun unlock() {
        withNative { pointer ->
            @Unsafe {
                val (status, error) = nativeMutexUnlock(pointer)
                checkNativeStatus(status, error, "mutex unlock")
            }
        }
    }

    public fun <T> withLock(block: () -> T): T {
        lock()
        try { return block() }
        finally { unlock() }
    }

    public override fun dispose() {
        if (native == None) return
        if (active.load(MemoryOrder.Relaxed) != 0L) throw IllegalStateException(Some("mutex operation is active"))
        @Unsafe {
            val (status, error) = nativeMutexDestroy(native!!)
            checkNativeStatus(status, error, "dispose mutex")
            native = None
        }
    }

    release {
        when (native) {
            case Some(pointer) -> @Unsafe { nativeMutexDestroy(pointer) }
            case None -> {}
        }
    }
}

@Extern(name = "scoop_platform_mutex_create", captureErrno = true)
private fun nativeMutexCreate(): (Ptr<Unit>?, Int)
@Extern(name = "scoop_platform_mutex_lock", captureErrno = true)
private fun nativeMutexLock(mutex: Ptr<Unit>, attempt: Boolean): (Int, Int)
@Extern(name = "scoop_platform_mutex_unlock", captureErrno = true)
private fun nativeMutexUnlock(mutex: Ptr<Unit>): (Int, Int)
@Extern(name = "scoop_platform_mutex_destroy", captureErrno = true)
private fun nativeMutexDestroy(mutex: Ptr<Unit>): (Int, Int)
