package scoop.platform.concurrent

import scoop.platform.system.*

@CLayout
internal struct NativeSyncResult(val status: Int, val code: Int) {
    fun check(operation: String): Int {
        if (status < 0) {
            val domain =
                if (operatingSystem == OperatingSystem.Windows)
                    NativeErrorDomain.Win32
                else
                    NativeErrorDomain.PosixErrno
            val error = NativeError(domain, code)
            throw PlatformException(operation, error.kind, Some(error))
        }
        return status
    }
}
