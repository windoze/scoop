package scoop.platform.env

import scoop.collections.MutableMap
import scoop.platform.fs.*
import scoop.platform.fs.Path
import scoop.platform.system.OsString
import scoop.test.*

@Test
private class EnvironmentTest {
    @Test
    fun `arguments and environment are independent raw snapshots`() {
        assertTrue(arguments().size > 0L)
        val values = environment()
        assertFalse(values is MutableMap<OsString, OsString>)
        for ((name, value) in values)
            assertEquals(value, environmentVariable(name)!!)
        val again = environment()
        assertEquals(values.size, again.size)
        for ((name, value) in values)
            assertEquals(value, again[name]!!)
    }

    @Test
    fun `environment names reject empty equals and NUL`() {
        assertFailsWith<IllegalArgumentException> { environmentVariable("") }
        assertFailsWith<IllegalArgumentException> { environmentVariable("a=b") }
        assertFailsWith<IllegalArgumentException> { environmentVariable("a\u0000b") }
        assertFailsWith<IllegalArgumentException> {
            environmentVariable(OsString.fromByteArray(Array<Byte>(1L) { 0.toByte() }))
        }
    }

    @Test
    fun `current directory queries actual cwd`() {
        assertEquals(Path.fromString(".").canonicalize(), currentDirectory().canonicalize())
    }
}
