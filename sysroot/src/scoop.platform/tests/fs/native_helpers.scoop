package scoop.platform.fs

import scoop.platform.system.OsString
import scoop.platform.native.fileOpenFlags
import scoop.test.*

@Test
private class NativePathHelperTest {
    @Test
    fun `public native strings keep raw bytes terminated and reject embedded NUL`() {
        val bytes: Array<Byte> = [97, -1, 98]
        val text = OsString.fromByteArray(bytes)
        @Unsafe {
            val last = text.withNativeString { pointer ->
                @Unsafe {
                    gcCollect()
                    assertEquals(-1.toByte(), pointer.load(1L))
                    assertEquals(0.toByte(), pointer.load(3L))
                    return@withNativeString pointer.load(2L)
                }
            }
            assertEquals(98.toByte(), last)
            Path.fromOsString(text).withNativePath { pointer -> @Unsafe {
                assertEquals(97.toByte(), pointer.load())
            } }
        }
        val invalid: Array<Byte> = [97, 0, 98]
        assertFailsWith<IllegalArgumentException> {
            @Unsafe { OsString.fromByteArray(invalid).withNativeString { _ -> fail(Some("NUL reached native callback")) } }
        }
    }

    @Test
    fun `open options expose the validated helper flags`() {
        assertEquals(1, fileOpenFlags(OpenOptions()))
        assertEquals(27, fileOpenFlags(OpenOptions(write = true, create = true, createNew = true)))
        assertEquals(6, fileOpenFlags(OpenOptions(read = false, write = true, append = true)))
        assertFailsWith<IllegalArgumentException> { fileOpenFlags(OpenOptions(read = false)) }
        assertFailsWith<IllegalArgumentException> { fileOpenFlags(OpenOptions(write = true, append = true, truncate = true)) }
        assertFailsWith<IllegalArgumentException> { fileOpenFlags(OpenOptions(mode = 0x1000)) }
    }

    @Test
    fun `native string copies preserve raw bytes and outlive their input storage`() {
        val values: Array<Byte> = [97, -1, 98, 0]
        val input = MutableArray<Byte>(4L) { index -> values[index] }
        @Unsafe {
            val snapshot = input.withDataPointer { pointer, _ -> @Unsafe {
                return@withDataPointer copyNativeString(pointer)
            } }
            input[0L] = 120
            input[1L] = 0
            gcCollect()
            val expected: Array<Byte> = [97, -1, 98]
            assertEquals(OsString.fromByteArray(expected), snapshot)
            input[0L] = 0
            input.withDataPointer { pointer, _ -> @Unsafe {
                assertEquals(OsString.fromString(""), copyNativeString(pointer))
            } }
        }
    }
}
