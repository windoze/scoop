package scoop.ui.component

import scoop.graphics.*
import scoop.graphics.text.*
import scoop.test.*
import scoop.tests.textfonts.testSansBytes
import scoop.ui.LayoutDirection
import scoop.ui.style.*
import scoop.ui.style.macos.macosTheme
import scoop.ui.style.material.materialTheme
import scoop.ui.style.fluent.fluentTheme
import scoop.ui.text.TextEditorState

@Test
private class TextFieldStyleTest {
    @Test
    fun `validation follows all palettes while explicit field overrides remain authoritative`() {
        val focused = InteractionVisual(focusVisible = true)
        val visual = SurfaceVisual(SurfaceKind.Plain, focused)
        val error = InteractionVisual(invalid = true)
        val errorVisual = SurfaceVisual(SurfaceKind.Plain, error)
        val bounds = Rect(0.0, 0.0, 240.0, 80.0)
        val themes =
            [
                macosTheme(),
                materialTheme(),
                fluentTheme(),
                macosTheme(ThemeMode.Dark),
                materialTheme(ThemeMode.Dark),
                fluentTheme(ThemeMode.Dark)
            ]
        val style = textFieldStyle()
        for (theme in themes) {
            val ordinary = theme.surfaceGeometry(bounds, visual, style.options(focused))
            val invalid = theme.surfaceGeometry(bounds, errorVisual, style.options(error))
            val invalidEdges = invalid.style.border!!.resolve(LayoutDirection.Ltr)
            assertEquals(theme.tokens.palette.destructive.background, invalidEdges.left.color)
            assertEquals(
                theme.tokens.palette.destructive.background.withAlpha(0.72),
                invalid.ring!!.border.color
            )
            assertTrue(
                ordinary.style.border!!.resolve(LayoutDirection.Ltr).left.color !=
                    invalidEdges.left.color
            )
            val explicit =
                textFieldStyle {
                    surface {
                        this.padding = Some(Insets.all(4.0))
                        style { this.border(Some(Border.all(3.0, Color.White))) }
                        this.validation = Some(OutlineStyle(Color.Black, 1.0, 3.0))
                    }
                    states { disabled { this.border(None) } }
                }
            val overridden = theme.surfaceGeometry(bounds, errorVisual, explicit.options(error))
            assertEquals(Some(Border.all(3.0, Color.White)), overridden.style.border)
            assertEquals(Color.Black, overridden.ring!!.border.color)
            assertEquals(Rect(7.0, 7.0, 226.0, 66.0), overridden.content)
            val disabled = InteractionVisual(enabled = false, invalid = true)
            assertEquals(
                None,
                theme.surfaceGeometry(
                    bounds,
                    SurfaceVisual(SurfaceKind.Plain, disabled),
                    explicit.options(disabled)
                ).style.border
            )
        }
    }

    @Test
    fun `row sizing uses actual font metrics and rejects invalid row counts`() {
        val model = TextEditorState()
        assertEquals(4L, TextareaProps(model).rows)
        assertFailsWith<IllegalArgumentException> { TextareaProps(model, rows = 0L) }
        assertFailsWith<IllegalArgumentException> { TextareaProps(model, rows = -1L) }
        FontCollection(false).use {
            fonts ->
            fonts.register(testSansBytes, "Field Test")
            val cache = TextFieldLineHeight()
            val small =
                textStyle {
                    this.families = ["Field Test"]
                    this.fontSize = 12.0
                }
            val large =
                textStyle {
                    this.families = ["Field Test"]
                    this.fontSize = 24.0
                }
            val first = cache.measure(fonts, small)
            assertTrue(first > 0.0)
            assertEquals(first, cache.measure(fonts, small))
            val second = cache.measure(fonts, large)
            assertEquals(first * 2.0, second)
            assertEquals(first, cache.measure(fonts, small))
            assertFalse(fonts.isClosed)
        }
    }
}
