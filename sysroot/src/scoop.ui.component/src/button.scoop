package scoop.ui.component

import scoop.graphics.*
import scoop.graphics.text.*
import scoop.ui.*
import scoop.ui.style.*
import scoop.ui.text.InlineView

public enum ButtonContent {
    Label(LabelProps), Custom(View), Resolved((ActionContentStyle) -> View)
}

public class ButtonProps public constructor(
    public val content: ButtonContent,
    public val onClick: () -> Unit,
    public val enabled: Boolean = true,
    public val style: ButtonStyle = buttonStyle(),
    public val theme: ThemeSource? = None,
    public val focus: FocusOptions = FocusOptions(),
    public val invalid: Boolean = false,
    public val variant: ButtonVariant = ButtonVariant.Default,
    public val size: ButtonSize = ButtonSize.Default
)

public class Button public constructor(private val props: Props<ButtonProps>): Component {
    private val control = state<PressControl?>(None)
    private val themes = ThemeAccess()
    private val text = ActionTextStyle()
    public override fun onMount(scope: ComponentScope) {
        themes.mount(props.value.theme)
        val area = scope.createArea(focusable = true)
        val focus = scope.focusTarget(area, props.value.focus)
        val press = scope.press(area, PressOptions(props.value.enabled)) { props.value.onClick() }
        scope.routeChildren(area)
        control.value = Some(PressControl(area, focus, press))
    }
    public override fun render(): View {
        val input = props.value
        val theme = themes.read(input.theme)
        val interaction =
            when (control.value) {
                case Some(value) -> value.press.interaction
                case None -> InteractionState()
            }
        val visual =
            SurfaceVisual(input.style.kind, interaction.asVisual(input.enabled, input.invalid))
        val shape = ActionShape.Button(input.size)
        val base =
            text.resolve(
                theme.tokens.typography.action,
                actionTextColor(theme, shape, input.variant, visual),
                input.style.text,
                actionFontScale(shape),
                actionLineHeight(shape)
            )
        return element(
            ActionInkProps(
                theme,
                shape,
                input.variant,
                input.style,
                visual,
                ActionBehavior.Press(control, input.onClick, input.focus)
            ),
            { current -> ActionInk(current) },
            [
                actionContent(
                    input.content,
                    actionContentStyle(base, shape, input.variant, visual.interaction)
                )
            ]
        )
    }
}

public fun button(
    text: String,
    onClick: () -> Unit,
    configure: ButtonBuilder.() -> Unit = {}
): View = makeTextButton(text, onClick, configure)

public fun button(
    text: StyledText,
    onClick: () -> Unit,
    configure: StyledButtonBuilder.() -> Unit = {}
): View = makeStyledButton(text, onClick, configure)

public fun button(
    content: View,
    onClick: () -> Unit,
    configure: ContentButtonBuilder.() -> Unit = {}
): View = makeContentButton(content, onClick, configure)

public fun button(
    content: (ActionContentStyle) -> View,
    onClick: () -> Unit,
    configure: ContentButtonBuilder.() -> Unit = {}
): View = makeResolvedButton(content, onClick, configure)
