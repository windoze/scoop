package scoop.ui.component

import scoop.graphics.*
import scoop.graphics.text.*
import scoop.ui.*
import scoop.ui.text.*
import scoop.ui.style.ThemeSource

public enum LabelText {
    Plain(String, SpanStyle?), Styled(StyledText)
}

public class LabelProps public constructor(
    public val text: LabelText,
    public val fonts: FontCollection? = None,
    public val settings: ParagraphStyle? = None,
    public val inlines: Array<InlineView> = [],
    public val theme: ThemeSource? = None,
    public val baseStyle: TextStyle? = None,
    public val underline: Color? = None
)

/** A normal component; text measurement and ownership belong to the public ParagraphHost. */
public class Label public constructor(private val props: Props<LabelProps>): Component {
    private var plain: PlainLabel? = None
    private val themes = ThemeAccess()
    public override fun onMount(scope: ComponentScope) {
        when (props.value.text) {
            case Plain(_, _) -> when (props.value.baseStyle) {
                case None -> themes.mount(props.value.theme)
                case Some(_) -> {}
            }
            case Styled(_) -> {}
        }
    }
    public override fun render(): View {
        val input = props.value
        val content =
            when (input.text) {
                case Plain(text, style) -> plainContent(
                    text,
                    input.baseStyle ?: themes.read(input.theme).tokens.typography.body,
                    style
                )
                case Styled(content) -> content
            }
        return element(
            LabelInkProps(content, input),
            { current -> LabelInk(current) },
            inlineChildren(content, input.inlines)
        )
    }
    private fun plainContent(text: String, base: TextStyle, style: SpanStyle?): StyledText {
        when (plain) {
            case Some(previous) -> {
                if (
                    previous.text ==
                        text &&
                        previous.base ===
                        base &&
                        sameSpanStyle(previous.localStyle, style)
                )
                    return previous.content
            }
            case None -> {}
        }
        val resolved =
            when (style) {
                case Some(value) -> value.resolve(base);
                case None -> base
            }
        val next =
            PlainLabel(
                text,
                base,
                style,
                styledText {
                    this.text(text)
                    this.style = resolved
                }
            )
        plain = Some(next)
        return next.content
    }
}

public fun label(text: String, configure: PlainLabelBuilder.() -> Unit = {}): View =
    makePlainLabel(text, configure)

public fun label(content: StyledText, configure: StyledLabelBuilder.() -> Unit = {}): View =
    makeStyledLabel(content, configure)

private class PlainLabel(
    val text: String,
    val base: TextStyle,
    val localStyle: SpanStyle?,
    val content: StyledText
)

private class LabelInkProps(val content: StyledText, val input: LabelProps)

private class LabelInk(private val props: Props<LabelInkProps>): Element {
    private var scope: ComponentScope? = None
    private var paragraph: ParagraphHost? = None
    private var ownedFonts: FontCollection? = None
    private var fonts: FontCollection? = None
    public override fun onMount(scope: ComponentScope) {
        this.scope = Some(scope)
        paragraph = Some(scope.resource { ParagraphHost() })
    }
    public override fun update() {
        fonts =
            Some(
                when (props.value.input.fonts) {
                    case Some(value) -> value
                    case None -> {
                        when (ownedFonts) {
                            case Some(value) -> value
                            case None -> {
                                val value = scope!!.resource { FontCollection() }
                                ownedFonts = Some(value)
                                value
                            }
                        }
                    }
                }
            )
    }
    public override fun measure(context: MeasureContext, constraints: Constraints): LayoutMetrics {
        val value = props.value
        return paragraph!!.measure(
            context,
            constraints,
            fonts!!,
            value.content,
            value.input.settings,
            value.input.inlines
        )
    }
    public override fun scene(context: SceneContext) {
        paragraph!!.scene(context)
        when (props.value.input.underline) {
            case Some(color) -> {
                val boxes =
                    paragraph!!.layout.selection(TextRange(0L, props.value.content.text.byteLength))
                context.draw {
                    paint -> for (box in boxes)
                        paint.canvas.drawRect(
                            Rect(
                                box.rect.x,
                                box.rect.y + box.rect.height - 1.0,
                                box.rect.width,
                                1.0
                            ),
                            Paint(color)
                        )
                }
            }
            case None -> {}
        }
    }
}
