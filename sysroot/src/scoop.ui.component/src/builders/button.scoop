package scoop.ui.component

import scoop.graphics.text.*
import scoop.ui.*
import scoop.ui.style.ThemeSource
import scoop.ui.text.InlineView

/** Button input is published through Props, including the current click callback. */
public open class ContentButtonBuilder internal constructor() {
    public var enabled: Boolean = true
    public var invalid: Boolean = false
    public var variant: ButtonVariant = ButtonVariant.Default
    public var size: ButtonSize = ButtonSize.Default
    public var style: ButtonStyle = buttonStyle()
    public var theme: ThemeSource? = None
    public var key: ViewKey = ViewKey.Position
    public var focus: FocusOptions = FocusOptions()

    public fun style(configure: ButtonStyleBuilder.() -> Unit): Unit {
        style = style.copy(configure)
    }

    public fun focus(configure: FocusOptionsBuilder.() -> Unit): Unit {
        focus = focus.copy(configure)
    }
}

public open class ButtonBuilder internal constructor(): ContentButtonBuilder() {
    public var fonts: FontCollection? = None
    internal fun properties(label: LabelProps, onClick: () -> Unit): ButtonProps =
        ButtonProps(
            ButtonContent.Label(label),
            onClick,
            enabled,
            style,
            theme,
            focus,
            invalid,
            variant,
            size
        )

    internal fun snapshot(text: String, onClick: () -> Unit): ButtonProps =
        properties(
            LabelProps(
                LabelText.Plain(text, None),
                fonts,
                Some(paragraphStyle { alignment = TextAlignment.Center })
            ),
            onClick
        )
}

/** Extra paragraph and inline options for a complete styled label. */
public class StyledButtonBuilder internal constructor(): ButtonBuilder() {
    public var settings: ParagraphStyle? = None
    public var inlines: Array<InlineView> = []

    public fun settings(configure: ParagraphStyleBuilder.() -> Unit): Unit {
        settings = Some((settings ?: paragraphStyle()).copy(configure))
    }

    internal fun snapshot(text: StyledText, onClick: () -> Unit): ButtonProps =
        properties(LabelProps(LabelText.Styled(text), fonts, settings, inlines), onClick)
}

internal fun makeTextButton(
    text: String,
    onClick: () -> Unit,
    configure: ButtonBuilder.() -> Unit
): View {
    val builder = ButtonBuilder()
    builder.configure()
    return buttonView(builder.snapshot(text, onClick), builder.key)
}

internal fun makeStyledButton(
    text: StyledText,
    onClick: () -> Unit,
    configure: StyledButtonBuilder.() -> Unit
): View {
    val builder = StyledButtonBuilder()
    builder.configure()
    return buttonView(builder.snapshot(text, onClick), builder.key)
}

private fun buttonView(input: ButtonProps, key: ViewKey): View =
    component(input, { props -> Button(props) }, key)

internal fun makeContentButton(
    content: View,
    onClick: () -> Unit,
    configure: ContentButtonBuilder.() -> Unit
): View {
    val builder = ContentButtonBuilder()
    builder.configure()
    return buttonView(
        ButtonProps(
            ButtonContent.Custom(content),
            onClick,
            builder.enabled,
            builder.style,
            builder.theme,
            builder.focus,
            builder.invalid,
            builder.variant,
            builder.size
        ),
        builder.key
    )
}

internal fun makeResolvedButton(
    content: (ActionContentStyle) -> View,
    onClick: () -> Unit,
    configure: ContentButtonBuilder.() -> Unit
): View {
    val builder = ContentButtonBuilder()
    builder.configure()
    return buttonView(
        ButtonProps(
            ButtonContent.Resolved(content),
            onClick,
            builder.enabled,
            builder.style,
            builder.theme,
            builder.focus,
            builder.invalid,
            builder.variant,
            builder.size
        ),
        builder.key
    )
}
