package scoop.ui.component

import scoop.graphics.*
import scoop.surface.*
import scoop.ui.*
import scoop.ui.style.*
import scoop.ui.style.Theme
import scoop.window.*

internal class ScrollControlProps(
    val state: ScrollState,
    val axes: ScrollAxes,
    val lineStep: Double,
    val chain: ScrollChain,
    val scrollbars: ScrollbarVisibility,
    val scrollbar: ScrollbarOptions,
    val enabled: Boolean,
    val focus: FocusOptions,
    val paintCache: PaintCachePolicy,
    val theme: Theme
)

/** Shared input, range publication and themed bars for eager and lazy viewports. */
internal class ScrollControl(
    private val scope: ComponentScope,
    private val props: () -> ScrollControlProps
) {
    private val painters = scope.resource { ThemePainterCache() }
    val viewport = scope.scrollViewport(props().state)
    private val area =
        scope.createArea(focusable = true) { context, event -> handle(context, event) }
    private val focus = scope.focusTarget(area, props().focus)
    private val horizontal = ScrollBarControl(scope, props, area, Orientation.Horizontal)
    private val vertical = ScrollBarControl(scope, props, area, Orientation.Vertical)
    private var direction = scope.layoutDirection

    init {
        area.scope.defaultAction = { context, event -> handle(context, event) }
        scope.routeChildren(area)
    }
    fun update() {
        val value = props()
        requireComponent(
            value.lineStep.isFinite() && value.lineStep > 0.0,
            "invalid scroll line step"
        )
        viewport.state = value.state
        viewport.paintCache = value.paintCache
        focus.options = value.focus
        area.scope.enabled = value.enabled
        horizontal.update()
        vertical.update()
        painters.get(value.theme)
    }
    fun layout(
        viewportSize: Size,
        contentSize: Size,
        adjustment: ScrollAdjustment? = None
    ): ScrollSnapshot = viewport.layout(viewportSize, contentSize, adjustment)
    fun scene(
        context: SceneContext,
        snapshot: ScrollSnapshot,
        contentOrigin: Point = Point(0.0, 0.0)
    ) {
        val value = props()
        val size = snapshot.viewport
        val presentedDirection = context.layoutDirection
        context.onFrameComplete {
            frame -> if (frame.submission == FrameSubmission.Accepted && scope.isMounted)
                direction = presentedDirection
        }
        val bounds = Rect(0.0, 0.0, size.width, size.height)
        context.place(area, bounds)
        viewport.present(context, Some { content -> content.children() }, contentOrigin)
        val painter = painters.get(value.theme)
        val input = value
        val thickness = value.theme.scrollbarMetrics(input.scrollbar).thickness
        val barWidth = upperBound(thickness, size.width)
        val barHeight = upperBound(thickness, size.height)
        val hasX =
            input.axes.horizontal &&
                showScrollbar(input.scrollbars, snapshot.maximum.x) &&
                barHeight >
                0.0 &&
                size.width >
                0.0
        val hasY =
            input.axes.vertical &&
                showScrollbar(input.scrollbars, snapshot.maximum.y) &&
                barWidth >
                0.0 &&
                size.height >
                0.0
        horizontal.scene(
            context,
            snapshot,
            if (hasX)
                Some(
                    Rect(
                        0.0,
                        size.height - barHeight,
                        size.width -
                            (
                                if (hasY)
                                    barWidth
                                else
                                    0.0
                            ),
                        barHeight
                    )
                )
            else
                None,
            painter
        )
        vertical.scene(
            context,
            snapshot,
            if (hasY)
                Some(
                    Rect(
                        size.width - barWidth,
                        0.0,
                        barWidth,
                        size.height -
                            (
                                if (hasX)
                                    barHeight
                                else
                                    0.0
                            )
                    )
                )
            else
                None,
            painter
        )
        if (area.isFocusActive && size.width > 2.0 && size.height > 2.0) {
            context.draw {
                paint -> paint.canvas.drawRect(
                    Rect(1.0, 1.0, size.width - 2.0, size.height - 2.0),
                    Paint(value.theme.tokens.palette.ring, PaintingStyle.Stroke, 2.0)
                )
            }
        }
    }
    private fun handle(context: RoutedEventContext, event: InputEvent) {
        if (context.phase == RoutedPhase.Notification) {
            when (event) {
                case FocusChanged(_) -> {
                    if (scope.isMounted)
                        scope.requestFrame()
                }
                else -> {}
            }
            return
        }
        if (context.phase != RoutedPhase.Default || !props().enabled)
            return
        val input = props()
        val state = props().state
        when (event) {
            case Pointer(InputPointerEvent.Wheel(_, _, _, _)) -> {
                state.cancelAnimation()
                context.consumeScroll(input.lineStep) {
                    amount ->
                    val consumed =
                        state.scrollBy(
                            Point(
                                if (input.axes.horizontal)
                                    -amount.x
                                else
                                    0.0,
                                if (input.axes.vertical)
                                    -amount.y
                                else
                                    0.0
                            ),
                            ScrollOrigin.User
                        )
                    Point(-consumed.x, -consumed.y)
                }
                if (input.chain == ScrollChain.Contain)
                    context.preventDefault()
            }
            case Keyboard(key) -> {
                if (context.target === area.scope && scrollKey(state, input.axes, direction, key))
                    context.consume()
            }
            else -> {}
        }
    }
}

private fun scrollKey(
    state: ScrollState,
    axes: ScrollAxes,
    direction: LayoutDirection,
    key: KeyEvent
): Boolean {
    val modifiers = key.modifiers
    if (
        key.state !=
            ElementState.Pressed ||
            key.synthetic ||
            modifiers.control ||
            modifiers.alt ||
            modifiers.shift ||
            modifiers.superKey ||
            modifiers.function
    )
        return false
    val current = state.snapshot
    val reversed = !axes.vertical && direction == LayoutDirection.Rtl
    val step =
        if (axes.vertical)
            Point(0.0, current.viewport.height)
        else
            Point(
                if (reversed)
                    -current.viewport.width
                else
                    current.viewport.width,
                0.0
            )
    when (key.logicalKey) {
        case Named(NamedKey.PageUp) -> state.scrollBy(Point(-step.x, -step.y), ScrollOrigin.User)
        case Named(NamedKey.PageDown) -> state.scrollBy(step, ScrollOrigin.User)
        case Named(NamedKey.Home) -> state.scrollTo(
            if (reversed)
                current.maximum
            else
                Point(0.0, 0.0),
            ScrollOrigin.User
        )
        case Named(NamedKey.End) -> state.scrollTo(
            if (reversed)
                Point(0.0, 0.0)
            else
                current.maximum,
            ScrollOrigin.User
        )
        else -> return false
    }
    return true
}
