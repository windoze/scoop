package scoop.ui.component

import scoop.graphics.*
import scoop.surface.Animatable
import scoop.ui.*
import scoop.ui.style.*

public class CheckboxProps public constructor(
    public val checked: Binding<Boolean>,
    public val enabled: Boolean = true,
    public val style: CheckboxStyle = checkboxStyle(),
    public val theme: ThemeSource? = None,
    public val focus: FocusOptions = FocusOptions(),
    public val invalid: Boolean = false,
    public val labelTarget: FieldTarget? = None
)

public class Checkbox public constructor(private val props: Props<CheckboxProps>): Component {
    private val control = state<PressControl?>(None)
    private val themes = ThemeAccess()
    public override fun onMount(scope: ComponentScope) {
        themes.mount(props.value.theme)
        val area = scope.createArea(focusable = true)
        val focus = scope.focusTarget(area, props.value.focus)
        val press =
            scope.press(area, PressOptions(props.value.enabled, false)) {
                val binding = props.value.checked
                binding.value = !binding.value
            }
        control.value = Some(PressControl(area, focus, press))
    }
    public override fun render(): View {
        val input = props.value
        val theme = themes.read(input.theme)
        val checked = input.checked.value
        val interaction =
            when (control.value) {
                case Some(value) -> value.press.interaction
                case None -> InteractionState()
            }
        val visual = interaction.asVisual(input.enabled, input.invalid)
        return element(
            CheckboxInkProps(
                input,
                theme,
                checked,
                control,
                visual,
                input.style.options(theme, visual, checked),
                input.style.padding ?: Insets.all(theme.tokens.spacing.small),
                {
                    val binding = props.value.checked
                    binding.value = !binding.value
                }
            ),
            { current -> CheckboxInk(current) }
        )
    }
}

public fun checkbox(checked: Binding<Boolean>, configure: CheckboxBuilder.() -> Unit = {}): View =
    makeCheckbox(checked, configure)

public fun checkbox(
    initialChecked: Boolean = false,
    configure: CheckboxBuilder.() -> Unit = {}
): View = makeOwnedCheckbox(initialChecked, configure)

internal fun makeCheckbox(checked: Binding<Boolean>, configure: CheckboxBuilder.() -> Unit): View {
    val builder = CheckboxBuilder()
    builder.configure()
    return component(builder.snapshot(checked), { props -> Checkbox(props) }, builder.key)
}

internal fun makeOwnedCheckbox(
    initialChecked: Boolean,
    configure: CheckboxBuilder.() -> Unit
): View {
    val builder = CheckboxBuilder()
    builder.configure()
    return component(
        OwnedCheckboxProps(
            initialChecked,
            builder.enabled,
            builder.style,
            builder.theme,
            builder.focus,
            builder.invalid,
            builder.labelTarget
        ),
        { props -> OwnedCheckbox(props) },
        builder.key
    )
}

private class OwnedCheckboxProps(
    val initial: Boolean,
    val enabled: Boolean,
    val style: CheckboxStyle,
    val theme: ThemeSource?,
    val focus: FocusOptions,
    val invalid: Boolean,
    val labelTarget: FieldTarget?
)

private class OwnedCheckbox(private val props: Props<OwnedCheckboxProps>): Component {
    private val checked = state(props.value.initial)
    public override fun render(): View =
        checkbox(checked.binding()) {
            this.enabled = this @OwnedCheckbox.props.value.enabled
            this.style = this @OwnedCheckbox.props.value.style
            this.theme = this @OwnedCheckbox.props.value.theme
            this.focus = this @OwnedCheckbox.props.value.focus
            this.invalid = this @OwnedCheckbox.props.value.invalid
            this.labelTarget = this @OwnedCheckbox.props.value.labelTarget
        }
}

private class CheckboxInkProps(
    val input: CheckboxProps,
    val theme: Theme,
    val checked: Boolean,
    val control: State<PressControl?>,
    val visual: InteractionVisual,
    val options: CheckboxOptions,
    val padding: Insets,
    val activate: () -> Unit
)

private class CheckboxDrawing(val geometry: CheckboxGeometry, val visual: CheckboxVisual)

private class CheckboxInk(private val props: Props<CheckboxInkProps>): Element {
    private var motion: InteractionMotion? = None
    private var selection: Animatable<Double>? = None
    private var painters: ThemePainterCache? = None
    private var drawing: CheckboxDrawing? = None
    private var field: FieldLink? = None
    public override fun onMount(scope: ComponentScope) {
        val control = props.value.control.value!!
        field = Some(scope.resource { FieldLink(scope, control.area, control.focus) })
        painters = Some(scope.resource { ThemePainterCache() })
        motion = Some(InteractionMotion(scope, props.value.visual))
        selection =
            Some(
                scope.animation(
                    if (props.value.checked)
                        1.0
                    else
                        0.0
                )
            )
    }
    public override fun update() {
        val value = props.value
        val control = value.control.value!!
        control.press.update(PressOptions(value.input.enabled, false), value.activate)
        control.area.scope.enabled = value.input.enabled
        control.focus.options = value.input.focus
        field!!.update(value.input.labelTarget, value.input.enabled, value.activate)
        val specs = value.theme.tokens.motion
        motion!!.update(
            value.visual,
            specs.resolve(value.input.style.transition.resolve(specs.hover)),
            specs.resolve(value.input.style.transition.resolve(specs.press))
        )
        changeProgress(
            selection!!,
            if (value.checked)
                1.0
            else
                0.0,
            if (value.input.enabled)
                specs.resolve(value.input.style.selectionTransition.resolve(specs.selection))
            else
                None
        )
        painters!!.get(value.theme)
    }
    public override fun measure(context: MeasureContext, constraints: Constraints): LayoutMetrics {
        val value = props.value
        val metrics = value.theme.checkboxMetrics(value.options, context.layoutDirection)
        val padding = value.padding.totals()
        val size =
            constraints.constrain(
                Size(
                    lowerBound(metrics.suggestedSize.width, metrics.minimumSize.width) +
                        padding.width,
                    lowerBound(metrics.suggestedSize.height, metrics.minimumSize.height) +
                        padding.height
                )
            )
        val preferred = lowerBound(metrics.suggestedSize.width, metrics.minimumSize.width)
        val width = lowerBound(size.width - padding.width, 0.0)
        val height = lowerBound(size.height - padding.height, 0.0)
        val side = upperBound(preferred, upperBound(width, height))
        val bounds =
            Rect(
                value.padding.left + (width - side) / 2.0,
                value.padding.top + (height - side) / 2.0,
                side,
                side
            )
        val visual =
            CheckboxVisual(
                if (value.checked)
                    CheckMark.On
                else
                    CheckMark.Off,
                motion!!.sample(value.visual),
                Some(selection!!.value)
            )
        val geometry =
            value.theme.checkboxGeometry(bounds, visual, value.options, context.layoutDirection)
        drawing = Some(CheckboxDrawing(geometry, visual))
        return LayoutMetrics(size)
    }
    public override fun scene(context: SceneContext) {
        val value = drawing!!
        context.draw {
            paint -> painters!!.get(props.value.theme).drawCheckbox(
                paint.canvas,
                value.geometry,
                value.visual
            )
        }
        context.place(
            props.value.control.value!!.area,
            Rect(0.0, 0.0, context.size.width, context.size.height)
        )
    }
}
