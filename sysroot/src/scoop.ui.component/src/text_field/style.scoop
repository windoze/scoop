package scoop.ui.component

import scoop.graphics.*
import scoop.graphics.text.SpanStyle
import scoop.ui.style.*

public class TextFieldStyle internal constructor(
    public val surface: SurfaceOptions = surfaceOptions(),
    public val text: SpanStyle? = None,
    public val placeholder: SpanStyle? = None,
    public val description: SpanStyle? = None,
    public val states: InteractionStyles = interactionStyles(),
    public val selectionColor: Color? = None,
    public val inactiveSelectionColor: Color? = None,
    public val caretColor: Color? = None,
    public val markedColor: Color? = None,
    public val caretWidth: Double = 1.0,
    public val scrollbar: ScrollbarOptions = scrollbarOptions()
) {
    public fun copy(configure: TextFieldStyleBuilder.() -> Unit = {}): TextFieldStyle =
        configureTextFieldStyle(this, configure)

    internal fun options(visual: InteractionVisual): SurfaceOptions {
        val localStyle = states.apply(surface.style, visual)
        return surface.copy { this.style = localStyle }
    }
}
