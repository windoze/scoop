package scoop.ui.component

import scoop.graphics.text.*
import scoop.ui.*
import scoop.ui.style.*
import scoop.ui.text.*

internal class TextFieldInput(
    val state: TextEditorState,
    val placeholder: String,
    val invalid: Boolean,
    val description: String,
    val fonts: FontCollection?,
    val style: TextFieldStyle,
    val theme: ThemeSource?,
    val focus: FocusOptions,
    val options: TextEditOptions,
    val rows: Long,
    val scrollbars: ScrollbarVisibility,
    val onEdited: (TextEditorState) -> Unit,
    val onSubmit: (TextEditorState) -> Unit,
    val labelTarget: FieldTarget?
)

/** Shares composition while keeping the two public component identities distinct. */
internal class TextFieldRenderer {
    private val themes = ThemeAccess()
    private val mounted: State<TextEditHost?> = state(None)
    private val body = ActionTextStyle()
    private val hint = ActionTextStyle()
    private val description = ActionTextStyle()
    fun mount(theme: ThemeSource?) {
        themes.mount(theme)
    }
    fun render(input: TextFieldInput): View {
        val snapshot = input.state.inputState
        val interaction =
            when (mounted.value) {
                case Some(host) -> host.interaction
                case None -> TextEditInteraction()
            }
        val visual =
            SurfaceVisual(
                SurfaceKind.Plain,
                InteractionVisual(
                    input.options.enabled,
                    interaction.hovered,
                    focusVisible = interaction.focusVisible,
                    invalid = input.invalid
                )
            )
        val theme = themes.read(input.theme)
        val palette = theme.tokens.palette
        val text =
            body.resolve(
                theme.tokens.typography.body,
                theme.surfaceTextColor(visual),
                input.style.text
            )
        val placeholder =
            hint.resolve(
                theme.tokens.typography.body,
                palette.muted.foreground,
                input.style.placeholder
            )
        val children: Array<View> =
            if (input.description.byteLength == 0L)
                []
            else
                [
                    component(
                        LabelProps(
                            LabelText.Plain(input.description, None),
                            input.fonts,
                            baseStyle =
                                Some(
                                    description.resolve(
                                        theme.tokens.typography.caption,
                                        if (!input.options.enabled)
                                            palette.disabledText
                                        else
                                            if (input.invalid)
                                                palette.destructive.background
                                            else
                                                palette.muted.foreground,
                                        input.style.description
                                    )
                                )
                        ),
                        { props -> Label(props) }
                    )
                ]
        return element(
            TextFieldInkProps(
                input,
                theme,
                visual,
                input.style.options(visual.interaction),
                text,
                placeholder,
                mounted
            ),
            { props -> TextFieldInk(props) },
            children
        )
    }
}

internal class TextFieldInkProps(
    val input: TextFieldInput,
    val theme: Theme,
    val visual: SurfaceVisual,
    val surface: SurfaceOptions,
    val text: TextStyle,
    val placeholder: TextStyle,
    val mounted: State<TextEditHost?>
)
