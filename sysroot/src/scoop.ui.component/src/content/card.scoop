package scoop.ui.component

import scoop.graphics.*
import scoop.graphics.text.*
import scoop.ui.*
import scoop.ui.component.column as panelColumn
import scoop.ui.style.*

public enum CardSize {
    Default, Sm
}

public class CardProps public constructor(
    public val content: View,
    public val title: PanelContent? = None,
    public val description: PanelContent? = None,
    public val header: View? = None,
    public val action: View? = None,
    public val footer: View? = None,
    public val size: CardSize = CardSize.Default,
    public val headerSeparator: Boolean = false,
    public val fonts: FontCollection? = None,
    public val theme: ThemeSource? = None,
    public val style: StyleOverride = styleOverride()
)

public class Card public constructor(private val props: Props<CardProps>): Component {
    private val themes = ThemeAccess()
    private val titles = ActionTextStyle()
    private val descriptions = ActionTextStyle()
    public override fun onMount(scope: ComponentScope) {
        themes.mount(props.value.theme)
    }
    public override fun render(): View {
        val input = props.value
        val theme = themes.read(input.theme)
        val palette = theme.tokens.palette
        val density = theme.tokens.typography.body.fontSize / 14.0
        val spacing =
            (
                if (input.size == CardSize.Sm)
                    12.0
                else
                    16.0
            ) *
                density
        val titleStyle =
            titles.resolve(
                theme.tokens.typography.action,
                palette.card.foreground,
                None,
                if (input.size == CardSize.Sm)
                    1.0
                else
                    16.0 / 14.0,
                Some(1.375)
            )
        val descriptionStyle =
            descriptions.resolve(theme.tokens.typography.body, palette.muted.foreground, None)
        val hasHeader =
            panelPresent(input.header) ||
                panelPresent(input.title) ||
                panelPresent(input.description) ||
                panelPresent(input.action)
        val headerText =
            panelColumn {
                when (input.header) {
                    case Some(value) -> this.add(panelSlot(value, 0L));
                    case None -> {}
                }
                when (input.title) {
                    case Some(value) -> this.add(
                        panelSlot(panelCaption(value, titleStyle, input.fonts), 1L)
                    );
                    case None -> {}
                }
                when (input.description) {
                    case Some(value) -> this.add(
                        panelSlot(panelCaption(value, descriptionStyle, input.fonts), 2L)
                    );
                    case None -> {}
                }
                this.spacing = 4.0 * density
                this.alignment = CrossAlignment.Stretch
            }
        val header =
            panelAside(
                if (
                    panelPresent(input.header) ||
                        panelPresent(input.title) ||
                        panelPresent(input.description)
                )
                    Some(headerText)
                else
                    None,
                input.action,
                spacing,
                theme.tokens.typography.body.fontSize * 8.0
            )
        val content =
            panelColumn {
                if (hasHeader)
                    this.add(
                        panelFrame(
                            header,
                            Insets(
                                spacing,
                                spacing,
                                spacing,
                                if (input.headerSeparator)
                                    spacing
                                else
                                    0.0
                            ),
                            styleOverride {
                                if (input.headerSeparator)
                                    this.border(Some(bottomBorder(palette.border)))
                            },
                            key = ViewKey.Number(0L)
                        )
                    )
                this.add(
                    panelFrame(
                        input.content,
                        Insets(
                            spacing,
                            if (hasHeader)
                                0.0
                            else
                                spacing,
                            spacing,
                            if (!panelPresent(input.footer))
                                spacing
                            else
                                0.0
                        ),
                        key = ViewKey.Number(1L)
                    )
                )
                when (input.footer) {
                    case Some(value) -> this.add(
                        panelFrame(
                            value,
                            Insets.all(spacing),
                            styleOverride {
                                this.background(
                                    Some(
                                        Paint(
                                            palette.muted.background.withAlpha(
                                                palette.muted.background.alpha * 0.5
                                            )
                                        )
                                    )
                                );
                                this.border(Some(topBorder(palette.border)))
                            },
                            key = ViewKey.Number(2L)
                        )
                    )
                    case None -> {}
                }
                this.spacing = spacing
                this.alignment = CrossAlignment.Stretch
            }
        return panelFrame(
            content,
            visual =
                styleOverride {
                    this.background(Some(Paint(palette.card.background)))
                    this.border(
                        Some(
                            Border.all(
                                1.0,
                                palette.background.foreground.withAlpha(
                                    palette.background.foreground.alpha * 0.1
                                )
                            )
                        )
                    )
                    this.corners(Corners.all(theme.tokens.corners.large))
                    this.clipContent(true)
                }.then(input.style)
        )
    }
}

public class CardBuilder internal constructor(): PanelBuilder() {
    public var header: View? = None
    public var action: View? = None
    public var footer: View? = None
    public var size: CardSize = CardSize.Default
    public var headerSeparator: Boolean = false
    public fun header(content: View): Unit {
        header = Some(content)
    }
    public fun action(content: View): Unit {
        action = Some(content)
    }
    public fun footer(content: View): Unit {
        footer = Some(content)
    }
}

public fun card(content: View, configure: CardBuilder.() -> Unit = {}): View =
    makeCard(content, configure)

internal fun makeCard(content: View, configure: CardBuilder.() -> Unit): View {
    val builder = CardBuilder()
    builder.configure()
    return component(
        CardProps(
            content,
            builder.title,
            builder.description,
            builder.header,
            builder.action,
            builder.footer,
            builder.size,
            builder.headerSeparator,
            builder.fonts,
            builder.theme,
            builder.style
        ),
        { current -> Card(current) },
        builder.key
    )
}
