package scoop.ui.component

import scoop.graphics.text.*
import scoop.time.Duration
import scoop.ui.*
import scoop.ui.style.ThemeSource
import scoop.ui.text.*

public class TextareaProps public constructor(
    public val state: TextEditorState,
    public val placeholder: String = "",
    public val rows: Long = 4L,
    public val wrap: Boolean = true,
    public val tab: TextTabBehavior = TextTabBehavior.Navigate,
    public val submit: TextSubmitKeys = TextSubmitKeys.PrimaryEnter,
    public val enabled: Boolean = true,
    public val readOnly: Boolean = false,
    public val invalid: Boolean = false,
    public val description: String = "",
    public val fonts: FontCollection? = None,
    public val style: TextFieldStyle = textFieldStyle(),
    public val theme: ThemeSource? = None,
    public val focus: FocusOptions = FocusOptions(),
    public val direction: TextDirection? = None,
    public val alignment: TextAlignment = TextAlignment.Start,
    public val scrollbars: ScrollbarVisibility = ScrollbarVisibility.Auto,
    public val paintCache: PaintCachePolicy = PaintCachePolicy.None,
    public val caretBlink: Duration = Duration.milliseconds(500L),
    public val onEdited: (TextEditorState) -> Unit = { _ -> Unit },
    public val onSubmit: (TextEditorState) -> Unit = { _ -> Unit },
    public val policy: TextEditPolicy = textEditPolicy(),
    public val projection: TextProjection = textProjection(),
    public val copy: TextCopyPolicy = TextCopyPolicy.Default,
    public val labelTarget: FieldTarget? = None
) {
    init {
        requireComponent(rows > 0L, "text field rows must be positive")
    }
}

/** A fixed-row viewport; text, selection and history live in the shared editor model. */
public class Textarea public constructor(private val props: Props<TextareaProps>): Component {
    private val field = TextFieldRenderer()
    public override fun onMount(scope: ComponentScope) {
        field.mount(props.value.theme)
    }
    public override fun render(): View {
        val input = props.value
        return field.render(
            TextFieldInput(
                input.state,
                input.placeholder,
                input.invalid,
                input.description,
                input.fonts,
                input.style,
                input.theme,
                input.focus,
                TextEditOptions(
                    multiline = true,
                    wrap = input.wrap,
                    readOnly = input.readOnly,
                    enabled = input.enabled,
                    tab = input.tab,
                    submit = input.submit,
                    direction = input.direction,
                    alignment = input.alignment,
                    paintCache = input.paintCache,
                    caretBlink = input.caretBlink,
                    policy = input.policy,
                    projection = input.projection,
                    copy = input.copy
                ),
                input.rows,
                input.scrollbars,
                input.onEdited,
                input.onSubmit,
                input.labelTarget
            )
        )
    }
}

public fun textarea(state: TextEditorState, configure: TextareaBuilder.() -> Unit = {}): View =
    makeTextarea(state, configure)
