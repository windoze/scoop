package scoop.examples.ui.download

import scoop.graphics.*
import scoop.graphics.text.*
import scoop.http.client.*
import scoop.platform.fs.Path
import scoop.surface.*
import scoop.time.Duration
import scoop.ui.*
import scoop.ui.component.*
import scoop.ui.style.*
import scoop.window.ApplicationProxy

internal class DownloadPanel(
    private val jobs: CoroutineScope,
    private val client: HttpClient,
    private val workers: ChecksumWorkers,
    private val proxy: ApplicationProxy,
    val model: DownloadModel,
    private val request: HttpRequest,
    private val destination: Path,
    private val fonts: FontCollection
): Component {
    var controller: DownloadController? = None
    var clicks: Int by state(0)
    private val themes = currentThemeSource()
    public override fun onMount(scope: ComponentScope) {
        controller =
            Some(scope.resource { DownloadController(jobs, client, workers, proxy, model) })
    }
    public override fun render(): View {
        val value = model.snapshot.value
        val theme = themes.current.value
        val text =
            when (value.progress.total) {
                case Some(total) -> f"${value.progress.bytes} / ${total} bytes"
                case None -> f"${value.progress.bytes} bytes · total unknown"
            }
        return frame(
            column {
                this.label("Download + background SHA-256") {
                    this.style =
                        Some(
                            spanStyle {
                                this.fontSize = Some(24.0)
                                this.weight = Some(700)
                            }
                        )
                    this.fonts = Some(this @DownloadPanel.fonts)
                }
                this.label(phaseText(value.phase)) { this.fonts = Some(this @DownloadPanel.fonts) }
                this.label(text) { this.fonts = Some(this @DownloadPanel.fonts) }
                this.add(
                    element(
                        ProgressInput(value, theme.tokens.palette),
                        { props -> ProgressBar(props) }
                    )
                )
                this.row {
                    this.button(
                        "Start / Restart",
                        {
                            this @DownloadPanel.controller!!.start(
                                this @DownloadPanel.request,
                                this @DownloadPanel.destination
                            )
                        }
                    ) { this.fonts = Some(this @DownloadPanel.fonts) }
                    this.button("Cancel", { this @DownloadPanel.controller!!.cancel() }) {
                        this.enabled =
                            value.phase ==
                                DownloadPhase.Running ||
                                value.phase ==
                                DownloadPhase.Verifying
                        this.fonts = Some(this @DownloadPanel.fonts)
                    }
                    this.button(
                        f"Clicks: ${this @DownloadPanel.clicks}",
                        { this @DownloadPanel.clicks += 1 }
                    ) { this.fonts = Some(this @DownloadPanel.fonts) }
                    this.spacing = 10.0
                }
                this.label(
                    value.error ?:
                        when (value.digest) {
                            case Some(digest) -> "SHA-256: " + digest
                            case None -> "Try the click counter during download or background verification."
                        }
                ) { this.fonts = Some(this @DownloadPanel.fonts) }
                this.spacing = 10.0
            }
        ) {
            this.padding = Some(Insets.all(16.0))
            this.alignment = Alignment(AxisAlignment.Start, AxisAlignment.Start)
            this.style =
                styleOverride {
                    this.background(Some(Paint(theme.tokens.palette.background.background)))
                    this.clipContent(true)
                }
        }
    }
}

private class ProgressInput(val snapshot: DownloadSnapshot, val colors: ThemePalette)

private class ProgressBar(private val props: Props<ProgressInput>): Element {
    private var amount: Animatable<Double>? = None
    private var target = 0.0
    public override fun onMount(scope: ComponentScope) {
        target = props.value.snapshot.fraction ?: 0.0
        amount = Some(scope.animation(target))
    }
    public override fun update() {
        val value = props.value.snapshot
        val next = value.fraction ?: 0.0
        if (
            (value.phase != DownloadPhase.Running && value.phase != DownloadPhase.Verifying) ||
                value.fraction ==
                None
        ) {
            target = next
            if (amount!!.state == AnimationState.Running || amount!!.value != next)
                amount!!.snapTo(next)
            return
        }
        if (next == target)
            return
        target = next
        amount!!.animateTo(next, AnimationSpec.Tween(Duration.milliseconds(100L)))
    }
    public override fun measure(context: MeasureContext, constraints: Constraints): LayoutMetrics =
        LayoutMetrics(constraints.constrain(Size(constraints.maxWidth ?: 360.0, 12.0)))
    public override fun scene(context: SceneContext) {
        context.draw {
            paint ->
            val value = props.value
            paint.canvas.drawRect(
                Rect(0.0, 0.0, paint.size.width, paint.size.height),
                Paint(value.colors.border)
            )
            when (value.snapshot.fraction) {
                case Some(_) -> paint.canvas.drawRect(
                    Rect(0.0, 0.0, paint.size.width * amount!!.value, paint.size.height),
                    Paint(value.colors.accent)
                )
                case None -> if (value.snapshot.phase == DownloadPhase.Running)
                    paint.canvas.drawRect(
                        Rect(
                            paint.size.width * 0.35,
                            0.0,
                            paint.size.width * 0.3,
                            paint.size.height
                        ),
                        Paint(value.colors.accent)
                    )
            }
        }
    }
}
