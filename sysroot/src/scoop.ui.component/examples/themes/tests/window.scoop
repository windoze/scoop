package scoop.examples.ui.themes

import scoop.graphics.*
import scoop.graphics.native.withSkiaCanvas
import scoop.graphics.text.*
import scoop.platform.time.MonotonicTimeSource
import scoop.test.*
import scoop.tests.graphics.readNativePixel
import scoop.tests.surface.*
import scoop.tests.textfonts.testSansBytes
import scoop.time.Duration
import scoop.ui.*
import scoop.ui.style.*
import scoop.ui.style.macos.macosTheme
import scoop.ui.style.material.materialTheme
import scoop.ui.style.fluent.fluentTheme
import scoop.window.*
import scoop.window.Theme as WindowTheme

@Test
private class ShowcaseWindowTest {
    @Test
    fun `the complete showcase follows native theme notifications switches styles and stops frames`() {
        val probe = ShowcaseProbe()
        val host = UiHost { owner, active, event -> probe.event(owner, active, event) }
        try {
            context(probe.model.source) {
                host.use { owner -> Application().run(owner) }
            }
            assertTrue(probe.finished)
            assertTrue(host.isClosed)
            assertEquals(1, probe.creates)
            assertFalse(probe.fonts.isClosed)
            assertTrue(probe.view!!.restored())
            assertFalse(probe.frames!!.snapshot().attached)
        } catch (error: Throwable) {
            println(f"showcase phase=${probe.phase}, paints=${probe.paints}")
            reportWindowFailure(error)
            throw error
        } finally {
            host.close()
            probe.view?.close()
            probe.frames?.close()
            probe.fonts.close()
        }
    }
}

private fun reportWindowFailure(error: Throwable) {
    if (error is ResourceUseException) {
        reportWindowFailure(error.primaryFailure);
        reportWindowFailure(error.cleanupFailure)
    }
    else
        if (error is AssertionFailure)
            println(
                f"${error.kind} at ${error.location.file}:${error.location.line}: ${
                    error.message ?: ""
                }"
            )
        else
            if (error is Exception)
                println(error.message ?: "showcase failure")
}

private class ShowcaseProbe {
    val model = ShowcaseModel()
    val fonts = FontCollection(false)
    init {
        for (theme in [macosTheme(), materialTheme(), fluentTheme()]) {
            for (family in theme.tokens.typography.action.families)
                fonts.register(testSansBytes, family)
        }
    }
    var window: Window? = None
    var view: ViewProbe? = None
    var frames: FrameProbe? = None
    var finished = false
    var phase = 0
    var creates = 0
    var measures = 0
    var paints = 0
    var pixel = -1L
    private var afterPaint = 0
    private var quiet: FrameSnapshot? = None
    private var quietPaints = 0
    private var quietMeasures = 0

    fun event(host: UiHost, active: ActiveApplication, event: ApplicationEvent) {
        when (event) {
            case Resumed -> {
                val native =
                    active.createWindow(
                        WindowAttributes(
                            "Scoop theme showcase test",
                            LogicalSize(1120.0, 670.0),
                            theme = Some(WindowTheme.Light)
                        )
                    )
                window = Some(native)
                native.setWindowLevel(WindowLevel.AlwaysOnTop)
                model.systemTheme(native.observedTheme)
                view = Some(observeWindow(native))
                frames = Some(observeFrames(native))
                host.attach(native, { ObservedShowcase(this) })
                waitFor(active, 25000L)
            }
            case Window(_, WindowEvent.ThemeChanged(value)) -> model.systemTheme(value)
            case AboutToWait -> advance(active)
            case NewEvents(StartCause.Deadline) -> deadline(active)
            case Window(_, WindowEvent.Destroyed) -> {
                finished = phase == 90;
                active.requestExit()
            }
            else -> {}
        }
    }
    private fun ready(): Boolean {
        if (paints <= afterPaint || pixel < 0L)
            return false
        val color = model.source.current.value.tokens.palette.canvas
        val channels = [pixel % 256L, pixel / 256L % 256L, pixel / 65536L]
        val values = [color.red, color.green, color.blue]
        for (i in 0L until 3L) {
            val error = channels[i].toDouble() - values[i] * 255.0
            if (error < -1.0 || error > 1.0)
                return false
        }
        return true
    }
    private fun advance(active: ActiveApplication) {
        if (phase >= 9 || !ready())
            return
        afterPaint = paints
        when (phase) {
            case 0 -> {
                window!!.requestTheme(Some(WindowTheme.Dark));
                phase = 1
            }
            case 1 -> {
                assertEquals(ThemeMode.Dark, model.source.current.value.tokens.mode)
                model.select(ThemeChoice.Material);
                phase = 2
            }
            case 2 -> {
                model.select(ThemeChoice.Fluent);
                phase = 3
            }
            case 3 -> {
                model.selectMode(ModeChoice.Light);
                phase = 4
            }
            case 4 -> {
                model.select(ThemeChoice.MacOS);
                phase = 5
            }
            case 5 -> {
                model.select(ThemeChoice.Material);
                phase = 6
            }
            case 6 -> {
                model.select(ThemeChoice.Fluent);
                phase = 7
            }
            case 7 -> {
                model.selectMode(ModeChoice.System);
                phase = 8
            }
            case 8 -> {
                assertEquals(ThemeMode.Dark, model.source.current.value.tokens.mode)
                model.shadow.value = true
                model.glow.value = true
                model.blur.value = true
                model.enabled.value = false
                phase = 9
                waitFor(active, 400L)
            }
            else -> {}
        }
    }
    private fun deadline(active: ActiveApplication) {
        when (phase) {
            case 9 -> {
                assertTrue(ready())
                val current = frames!!.snapshot()
                assertFalse(current.required)
                assertTrue(current.paused)
                quiet = Some(current)
                quietPaints = paints
                quietMeasures = measures
                phase = 10
                waitFor(active, 180L)
            }
            case 10 -> {
                assertEquals(quiet!!, frames!!.snapshot())
                assertEquals(quietPaints, paints)
                assertEquals(quietMeasures, measures)
                phase = 90
                window!!.requestDestroy()
            }
            else -> fail(
                Some(
                    f"showcase deadline at phase ${phase}, presents=${
                        frames!!.snapshot().presentations
                    }"
                )
            )
        }
    }
    private fun waitFor(active: ActiveApplication, milliseconds: Long) {
        active.setControlFlow(
            ControlFlow.WaitUntil(
                MonotonicTimeSource.markNow() + Duration.milliseconds(milliseconds)
            )
        )
    }
}

private class ObservedShowcase(private val probe: ShowcaseProbe): Component {
    public override fun render(): View =
        element(
            { ShowcaseCanvas(probe) },
            [
                component(
                    {
                        probe.creates += 1
                        Showcase(probe.model, probe.fonts)
                    }
                )
            ]
        )
}

private class ShowcaseCanvas(private val probe: ShowcaseProbe): Element {
    public override fun measure(context: MeasureContext, constraints: Constraints): LayoutMetrics {
        probe.measures += 1
        val result = context.measureChild(0L, constraints)
        context.placeChild(0L, Point(0.0, 0.0))
        return result
    }
    public override fun paint(context: PaintContext) {
        context.paintChildren()
        probe.paints += 1
        @Unsafe
        {
            context.canvas.withSkiaCanvas {
                native -> @Unsafe
                {
                    probe.pixel = readNativePixel(native, 1.0, 1.0)
                }
            }
        }
    }
}
