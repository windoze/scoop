package scoop.crypto

import scoop.crypto.native.*

/**
 * The supported AES-GCM key sizes. Both variants require a 12-byte nonce and produce a 16-byte
 * authentication tag.
 */
public enum AeadAlgorithm {
    /**
     * AES-GCM with a 16-byte key.
     */
    Aes128Gcm,
    /**
     * AES-GCM with a 32-byte key.
     */
    Aes256Gcm }
/**
 * Ciphertext and its separate 16-byte GCM authentication tag; the nonce and associated data are
 * supplied separately.
 */
public struct AeadCiphertext(val ciphertext: Array<Byte>, val tag: Array<Byte>)

private fun aeadCode(algorithm: AeadAlgorithm, key: SecretKey, nonce: List<Byte>): Int {
    val size = if (algorithm == AeadAlgorithm.Aes128Gcm) 16L else 32L
    if (key.size != size) throw IllegalArgumentException(Some("AES-GCM key length does not match algorithm"))
    if (nonce.size != 12L) throw IllegalArgumentException(Some("AES-GCM nonce must contain 12 bytes"))
    return if (algorithm == AeadAlgorithm.Aes128Gcm) 0 else 1
}

/**
 * Encrypts and authenticates plaintext and associated data with AES-GCM. The caller must use a
 * fresh nonce for each encryption under the same key. Key size and 12-byte nonce length are
 * checked.
 */
public fun encrypt(algorithm: AeadAlgorithm, key: SecretKey, nonce: List<Byte>, plaintext: List<Byte>, aad: List<Byte> = Array<Byte>(0L) { _ -> 0.toByte() }): AeadCiphertext {
    val code = aeadCode(algorithm, key, nonce)
    val bytes = transform(code, true, key, nonce, aad, plaintext, Array<Byte>(0L) { _ -> 0.toByte() })!!
    val count = bytes.size - 16L
    return AeadCiphertext(Array<Byte>(count) { index -> bytes[index] },
        Array<Byte>(16L) { index -> bytes[count + index] })
}

// Authenticates and decrypts; only an authentication mismatch returns None.
/**
 * Authenticates before returning plaintext. Only authentication mismatch returns None; invalid
 * sizes and backend failures throw.
 */
public fun decryptOrNone(algorithm: AeadAlgorithm, key: SecretKey, nonce: List<Byte>, encrypted: AeadCiphertext, aad: List<Byte> = Array<Byte>(0L) { _ -> 0.toByte() }): Array<Byte>? {
    val code = aeadCode(algorithm, key, nonce)
    if (encrypted.tag.size != 16L) throw IllegalArgumentException(Some("AES-GCM tag must contain 16 bytes"))
    return transform(code, false, key, nonce, aad, encrypted.ciphertext, encrypted.tag)
}

private fun transform(code: Int, encrypting: Boolean, key: SecretKey, nonce: List<Byte>, aad: List<Byte>, input: List<Byte>, tag: List<Byte>): Array<Byte>? {
    val iv = nonce.toArray()
    val associated = aad.toArray()
    val bytes = input.toArray()
    val auth = tag.toArray()
    val handle = key.nativeHandle()
    @Unsafe { return iv.withDataPointer { ivPointer, _ ->
        @Unsafe { return@withDataPointer associated.withDataPointer { aadPointer, aadCount ->
            @Unsafe { return@withDataPointer bytes.withDataPointer { dataPointer, count ->
                @Unsafe { return@withDataPointer auth.withDataPointer { tagPointer, _ ->
                    @Unsafe {
                        val result = nativeAead(code, if (encrypting) 1 else 0, handle,
                            ivPointer, aadPointer, aadCount, dataPointer, count,
                            if (encrypting) None else Some(tagPointer))
                        val owned = cryptoValue(result, "AES-GCM")
                        return@withDataPointer if (owned == 0UL) None else Some(consumeCryptoBytes(owned))
                    }
                } }
            } }
        } }
    } }
}
