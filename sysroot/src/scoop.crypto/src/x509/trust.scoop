package scoop.crypto.x509

import scoop.Result
import scoop.crypto.native.*
import scoop.time.Instant

/**
 * The intended certificate usage checked during chain validation.
 */
public enum CertificatePurpose {
    /**
     * Require suitability for a TLS server.
     */
    ServerAuth,
    /**
     * Require suitability for a TLS client.
     */
    ClientAuth,
    /**
     * Apply chain validation without a server/client usage restriction.
     */
    Any }
/**
 * A normal chain-validation rejection, including backend code, failing chain depth, and
 * explanatory text.
 */
public struct CertificateValidationFailure(val code: Long, val depth: Int, val detail: String)

/**
 * An owned set of explicit trust anchors. It does not implicitly load host operating-system trust
 * settings.
 */
public class TrustStore private constructor(private var handle: ULong) : Closeable {
    /**
     * Creates a trust store from explicit certificate anchors.
     */
    public companion object {
        /**
         * Parses PEM anchors into a new trust store and closes temporary certificate handles.
         */
        public fun fromPem(text: String): TrustStore {
            val certificates = parseCertificatesPem(text)
            try { return fromCertificates(certificates) }
            finally { for (certificate in certificates) certificate.close() }
        }

        /**
         * Creates a store retaining the supplied anchors independently; the caller keeps ownership
         * of its certificate handles.
         */
        public fun fromCertificates(anchors: List<Certificate>): TrustStore {
            @Unsafe {
                val store = TrustStore(cryptoValue(storeNew(), "create trust store"))
                try {
                    for (anchor in anchors) cryptoValue(storeAdd(store.handle, certificateHandle(anchor)), "add trust anchor")
                    return store
                } catch (error: Throwable) { store.close(); throw error }
            }
        }
    }

    internal fun nativeHandle(): ULong {
        if (handle == 0UL) throw IllegalStateException(Some("trust store is closed"))
        return handle
    }

    /**
     * Validates a certificate at the supplied time for the requested purpose, with optional
     * intermediates and expected peer identity. Ordinary rejection returns a failure Result;
     * native-operation failure throws.
     */
    public fun verify(certificate: Certificate, at: Instant, purpose: CertificatePurpose,
        intermediates: List<Certificate> = ArrayList<Certificate>(),
        identity: PeerIdentity? = None): Result<Unit, CertificateValidationFailure> {
        val store = nativeHandle()
        val usage = when (purpose) { case ServerAuth -> 0; case ClientAuth -> 1; case Any -> 2 }
        val (kind, name) = when (identity) {
            case Some(_) -> peerIdentityData(identity!!)
            case None -> (-1, Array<Byte>(0L) { _ -> 0.toByte() })
        }
        val chain = Array<ULong>(intermediates.size) { index -> @Unsafe { return@Array certificateHandle(intermediates[index]) } }
        @Unsafe {
            val leaf = certificateHandle(certificate)
            return chain.withDataPointer { chainPointer, count ->
                @Unsafe { return@withDataPointer name.withDataPointer { namePointer, size ->
                    @Unsafe {
                        val result = certificateVerify(leaf, store, chainPointer, count, at.epochSeconds, usage,
                            kind, if (kind < 0) None else Some(namePointer), size)
                        cryptoValue(CryptoResult(0UL, result.error), "verify certificate")
                        if (result.code == 0L) return@withDataPointer Result.Success<Unit, CertificateValidationFailure>(Unit)
                        return@withDataPointer Result.Failure<Unit, CertificateValidationFailure>(CertificateValidationFailure(
                            result.code, result.depth, String.fromCString(verifyMessage(result.code))))
                    }
                } }
            }
        }
    }

    /**
     * Releases the native trust store; repeated closes are harmless.
     */
    public override fun close() {
        val owned = handle
        handle = 0UL
        if (owned != 0UL) @Unsafe { storeFree(owned) }
    }
}
