package scoop.surface

import scoop.graphics.*
import scoop.platform.time.MonotonicTimeSource
import scoop.window.*

internal class InputRecord(
    val name: String,
    val event: InputEvent,
    val target: InputScope,
    val position: Point?,
    val phase: RoutedPhase
)

internal class InputLog {
    val events = ArrayList<InputRecord>()
    val ime = ArrayList<Boolean>()
    val carets = ArrayList<Rect>()
    val caretUpdates = ArrayList<ImeCaret>()
    var invalidations = 0
    fun trace(): String {
        var result = ""
        for (record in events) {
            if (result.byteLength != 0L)
                result += ","
            result += record.name + "/" + inputKind(record.event)
        }
        return result
    }
    fun record(name: String, context: RoutedEventContext, event: InputEvent) {
        events.add(InputRecord(name, event, context.target, context.localPosition, context.phase))
    }
}

internal class InputRig(val log: InputLog = InputLog()): Closeable {
    val router =
        InputRouter(
            true,
            { log.invalidations += 1 },
            { value -> log.ime.add(value) },
            {
                value ->
                log.caretUpdates.add(value)
                when (value.rect) {
                    case Some(rect) -> log.carets.add(rect);
                    case None -> {}
                }
                true
            }
        )
    val surface = RasterSurface(300, 200)
    fun area(
        name: String,
        focusable: Boolean = false,
        text: Boolean = false,
        parent: InputScope? = None
    ): InputArea =
        router.createArea(focusable, text, parent) {
            context,
            event -> log.record(name, context, event)
        }
    fun frame(block: (InputFrame, Canvas) -> Unit) {
        router.beginFrame().use {
            frame ->
            surface.draw { canvas -> block(frame, canvas) }
            router.publish(frame)
        }
    }
    fun pointer(event: PointerEvent) {
        router.event(WindowEvent.Pointer(event))
    }
    fun move(x: Double, y: Double) {
        pointer(PointerEvent.Moved(inputPointer(x, y)))
    }
    fun button(x: Double, y: Double, state: ElementState, button: MouseButton = MouseButton.Left) {
        pointer(PointerEvent.Button(inputPointer(x, y), button, state, 1))
    }
    fun wheel(
        x: Double,
        y: Double,
        delta: ScrollDelta = ScrollDelta.LineDelta(0.0, 1.0),
        phase: ScrollPhase = ScrollPhase.None,
        momentum: ScrollPhase = ScrollPhase.None,
        scale: Double = 1.0
    ) {
        pointer(PointerEvent.Wheel(inputPointer(x, y, scale), delta, phase, momentum))
    }
    public override fun close() {
        val failure = cleanupFailure(None) { router.close() }
        throwFailure(cleanupFailure(failure) { surface.close() })
    }
}

internal fun inputModifiers(): Modifiers =
    Modifiers(
        false,
        false,
        false,
        false,
        false,
        false,
        ModifierSides(None, None),
        ModifierSides(None, None),
        ModifierSides(None, None),
        ModifierSides(None, None)
    )

internal fun inputPointer(x: Double, y: Double, scale: Double = 1.0): PointerState =
    PointerState(
        LogicalPosition(x, y),
        PhysicalPosition(x * scale, y * scale),
        scale,
        inputModifiers(),
        InputTime.Observed(MonotonicTimeSource.markNow())
    )

internal fun inputKey(synthetic: Boolean = false): KeyEvent =
    KeyEvent(
        PhysicalKey.Code(KeyCode.KeyA),
        LogicalKey.Character("a"),
        KeyLocation.Standard,
        ElementState.Pressed,
        false,
        inputModifiers(),
        synthetic,
        inputObservation()
    )

internal fun inputKind(event: InputEvent): String =
    when (event) {
        case Pointer(InputPointerEvent.Entered(_)) -> "enter"
        case Pointer(InputPointerEvent.Left(_)) -> "leave"
        case Pointer(InputPointerEvent.Moved(_)) -> "move"
        case Pointer(InputPointerEvent.Button(_, _, ElementState.Pressed, _)) -> "down"
        case Pointer(InputPointerEvent.Button(_, _, ElementState.Released, _)) -> "up"
        case Pointer(InputPointerEvent.Wheel(_, _, _, _)) -> "wheel"
        case Pointer(InputPointerEvent.Cancelled(_, _)) -> "cancel"
        case Pointer(InputPointerEvent.ScrollCancelled(_, _)) -> "scroll-cancel"
        case Keyboard(_) -> "key"
        case ModifiersChanged(_) -> "modifiers"
        case TextInput(TextInputEvent.Enabled(_)) -> "enabled"
        case TextInput(TextInputEvent.Disabled(_)) -> "disabled"
        case TextInput(TextInputEvent.Edit(_)) -> "edit"
        case FocusChanged(value) -> if (value)
            "focus"
        else
            "blur"
        case FocusVisibilityChanged(value) -> if (value)
            "focus-visible"
        else
            "focus-hidden"
    }
