package scoop.tests.surface.errors

import scoop.graphics.*
import scoop.surface.*
import scoop.platform.time.MonotonicTimeSource
import scoop.test.*
import scoop.tests.surface.*
import scoop.time.Duration
import scoop.window.*

@Test
private class SurfaceErrorTest {
    @Test
    fun `a throwing painter closes all surfaces and leases before native shutdown`() {
        val application = Application()
        val probe = ErrorProbe()
        val host = SurfaceHost { owner, active, event -> probe.event(owner, active, event) }
        try {
            assertFailsWith<IllegalArgumentException> { application.run(host) }
            assertTrue(host.isClosed)
            assertEquals(2, probe.destroyed)
            assertTrue(probe.painted)
            assertTrue(probe.view!!.restored())
            assertFalse(application.proxy().post { _ -> fail() })
        } finally {
            host.close()
            probe.view?.close()
        }
    }
}

private class ErrorProbe {
    var view: ViewProbe? = None
    var destroyed = 0
    var painted = false
    fun event(host: SurfaceHost, application: ActiveApplication, event: ApplicationEvent) {
        when (event) {
            case Resumed -> {
                val first =
                    application.createWindow(
                        WindowAttributes("Scoop Surface error", LogicalSize(320.0, 180.0))
                    )
                first.setWindowLevel(WindowLevel.AlwaysOnTop)
                first.requestFocus()
                view = Some(observeWindow(first))
                host.attach(first) {
                    frame ->
                    painted = true
                    frame.canvas.saveLayer(0.5)
                    frame.canvas.clear(Color.Black)
                    throw IllegalArgumentException(Some("painter failed"))
                }
                host.attach(application.createWindow(WindowAttributes(visible = false))) {
                    _ -> fail()
                }
                application.setControlFlow(
                    ControlFlow.WaitUntil(MonotonicTimeSource.markNow() + Duration.seconds(5L))
                )
            }
            case Window(_, WindowEvent.Destroyed) -> destroyed += 1
            case NewEvents(StartCause.Deadline) -> fail(Some("Surface error test deadline expired"))
            else -> {}
        }
    }
}
