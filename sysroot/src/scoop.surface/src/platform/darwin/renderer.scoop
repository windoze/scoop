package scoop.surface

import scoop.graphics.*
import scoop.graphics.native.RenderTarget
import scoop.graphics.native.macos.MetalContext
import scoop.window.*
import scoop.window.native.*

internal fun createRendererHost(): RendererHost {
    @Unsafe
    {
        val native = macHostCreate() ?: throw GraphicsException("create Metal device and queue")
        try {
            return MacRendererHost(
                native,
                MetalContext.create(macHostObject(native, 0), macHostObject(native, 1))
            )
        }
        catch (error: Throwable) {
            macHostClose(native);
            throw error
        }
    }
}

private class MacRendererHost(
    private val native: Ptr<Unit>,
    private val context: MetalContext
): RendererHost {
    private var closed = false
    public override fun create(window: Window, proxy: ApplicationProxy): WindowRenderer {
        if (closed)
            throw IllegalStateException(Some("renderer host is closed"))
        @Unsafe
        {
            val lease = window.acquireNativeWindow()
            try {
                val view =
                    when (lease.handle) {
                        case AppKit(_, view) -> view
                    }
                val renderer = MacWindowRenderer(window, proxy, lease, context)
                renderer.install(native, view)
                return renderer
            } catch (error: Throwable) {
                lease.close();
                throw error
            }
        }
    }
    public override fun close() {
        if (closed)
            return
        closed = true
        val failure = cleanupFailure(None) { context.close() }
        @Unsafe
        {
            macHostClose(native)
        }
        throwFailure(failure)
    }
}

private class MacWindowRenderer(
    private val window: Window,
    private val proxy: ApplicationProxy,
    private val lease: NativeWindowLease,
    private val context: MetalContext
): WindowRenderer {
    private var native: Ptr<Unit>? = None
    private var callback: ForeignCallback<(Ptr<Unit>, Int) -> Int>? = None
    private var metrics: WindowMetrics? = None
    private var wanted = false

    @Unsafe
    fun install(host: Ptr<Unit>, view: Ptr<Unit>) {
        val registration =
            foreignCallback<(Ptr<Unit>, Int) -> Int>(
                { reason: Int -> notify(reason) },
                0,
                ForeignCallbackMode.Reusable
            )
        try {
            native =
                Some(
                    macSurfaceCreate(host, view, registration.function, registration.context) ?:
                        throw GraphicsException("install CAMetalLayer and display link")
                )
            callback = Some(registration)
        } catch (error: Throwable) {
            releaseForeignCallback(registration);
            throw error
        }
    }
    private fun notify(reason: Int): Int {
        if (native == None)
            return 0
        val accepted =
            proxy.post {
                _ -> if (
                    native != None && (reason == 2 || wanted) && window.state == WindowState.Open
                )
                    window.requestRedraw()
            }
        return if (accepted)
            1
        else
            0
    }
    private fun checkCallback() {
        @Unsafe
        {
            when (callback) {
                case Some(value) -> throwFailure(foreignCallbackFailure(value))
                case None -> throw IllegalStateException(Some("window renderer is closed"))
            }
        }
    }
    private fun pointer(): Ptr<Unit> {
        checkCallback()
        return native ?: throw IllegalStateException(Some("window renderer is closed"))
    }
    public override fun configure(value: WindowMetrics) {
        @Unsafe
        {
            macResult(
                macSurfaceConfigure(
                    pointer(),
                    value.physicalSize.width,
                    value.physicalSize.height,
                    value.scaleFactor
                ),
                "configure Metal surface"
            )
        }
        metrics = Some(value)
    }
    public override fun setFrameDemand(required: Boolean) {
        wanted = required
        when (native) {
            case Some(value) -> @Unsafe
            {
                macResult(macSurfaceDemand(value, required), "set Metal frame demand")
            }
            case None -> {
                if (required)
                    throw IllegalStateException(Some("window renderer is closed"))
            }
        }
        if (required)
            checkCallback()
    }
    public override fun acquire(): FrameAcquisition {
        val configuration = metrics ?: return FrameAcquisition.Deferred
        @Unsafe
        {
            val result = macSurfaceAcquire(pointer())
            if (result.status < 0)
                throw GraphicsException("acquire Metal drawable")
            if (result.pointer == None)
                return FrameAcquisition.Deferred
            val frame = result.pointer!!
            try {
                val target =
                    context.target(
                        macFrameTexture(frame),
                        configuration.physicalSize.width,
                        configuration.physicalSize.height,
                        configuration.scaleFactor
                    )
                return FrameAcquisition.Ready(MacFrame(window, frame, target))
            } catch (error: Throwable) {
                macFrameClose(frame);
                throw error
            }
        }
    }
    public override fun close() {
        val previous = native
        native = None
        wanted = false
        var failure: Throwable? = None
        when (previous) {
            case Some(value) -> {
                failure =
                    cleanupFailure(failure) {
                        @Unsafe
                        {
                            macResult(macSurfaceClose(value), "close Metal surface")
                        }
                    }
            }
            case None -> {}
        }
        @Unsafe
        {
            when (callback) {
                case Some(value) -> {
                    callback = None
                    failure =
                        cleanupFailure(failure) {
                            @Unsafe
                            {
                                throwFailure(foreignCallbackFailure(value))
                            }
                        }
                    releaseForeignCallback(value)
                }
                case None -> {}
            }
        }
        lease.close()
        throwFailure(failure)
    }
}

private class MacFrame(
    private val window: Window,
    private val native: Ptr<Unit>,
    private val target: RenderTarget
): RenderFrame {
    private var submitted = false
    private var closed = false
    private fun checkOpen() {
        if (closed || submitted)
            throw IllegalStateException(Some("frame has ended"))
    }
    public override fun draw(block: (Canvas) -> Unit) {
        checkOpen();
        target.draw(block)
    }
    public override fun submit(): Boolean {
        checkOpen()
        if (window.state != WindowState.Open)
            return false
        target.submit()
        window.prePresentNotify()
        @Unsafe
        {
            val result = macFramePresent(native)
            if (result < 0)
                throw GraphicsException("present Metal drawable")
            submitted = true
            return result == 1
        }
    }
    public override fun close() {
        if (closed)
            return
        closed = true
        var failure: Throwable? = None
        if (!submitted)
            failure = cleanupFailure(failure) { target.abort() }
        failure = cleanupFailure(failure) { target.close() }
        @Unsafe
        {
            macFrameClose(native)
        }
        throwFailure(failure)
    }
}

private fun macResult(result: Int, operation: String) {
    if (result != 1)
        throw GraphicsException(operation)
}

@CLayout
private struct MacAcquiredFrame(val pointer: Ptr<Unit>?, val status: Int)

@Extern(name = "scoop_surface_metal_host_create")
private fun macHostCreate(): Ptr<Unit>?

@Extern(name = "scoop_surface_metal_host_object")
private fun macHostObject(host: Ptr<Unit>, kind: Int): Ptr<Unit>

@Extern(name = "scoop_surface_metal_host_close")
private fun macHostClose(host: Ptr<Unit>)

@Extern(name = "scoop_surface_metal_surface_create")
private fun macSurfaceCreate(
    host: Ptr<Unit>,
    view: Ptr<Unit>,
    callback: FunPtr<(Ptr<Unit>, Int) -> Int>,
    context: Ptr<Unit>
): Ptr<Unit>?

@Extern(name = "scoop_surface_metal_surface_configure")
private fun macSurfaceConfigure(surface: Ptr<Unit>, width: Int, height: Int, scale: Double): Int

@Extern(name = "scoop_surface_metal_surface_demand")
private fun macSurfaceDemand(surface: Ptr<Unit>, required: Boolean): Int

@Extern(name = "scoop_surface_metal_surface_acquire")
private fun macSurfaceAcquire(surface: Ptr<Unit>): MacAcquiredFrame

@Extern(name = "scoop_surface_metal_surface_close")
private fun macSurfaceClose(surface: Ptr<Unit>): Int

@Extern(name = "scoop_surface_metal_frame_texture")
private fun macFrameTexture(frame: Ptr<Unit>): Ptr<Unit>

@Extern(name = "scoop_surface_metal_frame_present")
private fun macFramePresent(frame: Ptr<Unit>): Int

@Extern(name = "scoop_surface_metal_frame_close")
private fun macFrameClose(frame: Ptr<Unit>)
