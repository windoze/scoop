package scoop.surface

import scoop.graphics.*
import scoop.time.TimeMark

/** One owner-thread frame; its Canvas is valid only while the painter runs. */
public class FrameContext internal constructor(
    public val window: SurfaceWindow,
    public val canvas: Canvas,
    public val size: Size,
    public val time: TimeMark,
    private val input: InputFrame
) {
    /** Keeps this frame's input collector while borrowing an isolated child canvas. */
    public fun <T> withState(block: (FrameContext) -> T): T =
        canvas.withState { child -> block(FrameContext(window, child, size, time, input)) }

    public fun place(area: InputArea, shape: Rect, parent: InputArea? = None) {
        input.place(canvas, area, shape, parent)
    }
    public fun place(area: InputArea, shape: Path, parent: InputArea? = None) {
        input.place(canvas, area, shape, parent)
    }
}
