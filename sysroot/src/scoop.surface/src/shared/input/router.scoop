package scoop.surface

import scoop.graphics.*
import scoop.platform.concurrent.currentThreadId
import scoop.platform.time.MonotonicTimeSource
import scoop.window.*

internal enum ImeSession {
    Off, Opening(InputArea), On(InputArea), Closing(InputArea)
}

/** Shared routing state; the window adapter supplies only invalidation and IME operations. */
internal class InputRouter(
    internal var osFocused: Boolean,
    private val invalidate: () -> Unit,
    internal val imeAllowed: (Boolean) -> Unit,
    internal val imeCursor: (Rect) -> Unit
): Closeable {
    private val thread = currentThreadId()
    internal var closed = false
    internal var scene = AreaScene([])
    private val owned = ArrayList<InputArea>()
    private val retired = ArrayList<AreaScene>()
    private var depth = 0
    private var draining = false
    internal var pending = false
    internal var pointer: PointerState? = None
    internal var inside = false
    internal var hover: Array<InputArea> = []
    internal var pressed: Array<InputArea>? = None
    internal val buttons = ArrayList<MouseButton>()
    internal var logicalFocus: InputArea? = None
    internal var activeFocus: InputArea? = None
    internal var ime = ImeSession.Off
    internal var imeCaret: Rect? = None

    fun createArea(
        focusable: Boolean,
        textInput: Boolean,
        handler: (InputArea, AreaEvent) -> InputResult
    ): InputArea {
        checkOpen()
        val result = InputArea(this, focusable || textInput, textInput, handler)
        owned.add(result)
        return result
    }
    fun beginFrame(): InputFrame {
        checkOpen();
        return InputFrame(this)
    }
    fun publish(frame: InputFrame) {
        checkOpen()
        requireInput(frame.owner === this, "input frame belongs to another window")
        val next = frame.take()
        try {
            retired.add(scene)
        }
        catch (error: Throwable) {
            throwFailure(cleanupFailure(Some(error)) { next.close() });
            throw error
        }
        scene = next
        pending = true
        drain()
    }
    fun changed() {
        checkThread()
        if (closed)
            return
        pending = true
        dispatch { invalidate() }
    }
    fun geometryChanged() {
        imeCaret = None;
        changed()
    }
    fun detached(area: InputArea) {
        var index = 0L
        while (index < owned.size) {
            if (owned[index] === area) {
                owned.removeAt(index);
                break
            }
            index += 1L
        }
        changed()
    }
    fun event(event: WindowEvent) {
        checkThread()
        if (closed)
            return
        dispatch {
            when (event) {
                case Pointer(value) -> pointerEvent(value)
                case Focused(value) -> {
                    osFocused = value
                    pending = true
                    if (!value)
                        cancelPress(
                            AreaCancelReason.Window(PointerCancelReason.FocusLost),
                            inputObservation(),
                            true
                        )
                }
                case Keyboard(value) -> routeFocused(AreaEvent.Keyboard(value))
                case ModifiersChanged(value) -> routeFocused(AreaEvent.ModifiersChanged(value))
                case TextInput(value) -> textEvent(value)
                else -> {}
            }
        }
    }
    internal fun deliver(
        area: InputArea,
        event: AreaEvent,
        terminal: Boolean = false,
        inactive: Boolean = false
    ): InputResult {
        if (!terminal && (closed || area.closed || (!inactive && scene.path(area).size == 0L)))
            return InputResult.Ignored
        return area.handler(area, event)
    }
    internal fun dispatch(block: () -> Unit) {
        checkThread()
        depth += 1
        var failure: Throwable? = None
        try {
            block()
        } catch (error: Throwable) {
            failure = Some(error)
        }
        depth -= 1
        if (depth == 0)
            failure = cleanupFailure(failure) { drain() }
        throwFailure(failure)
    }
    private fun drain() {
        if (depth != 0 || draining)
            return
        draining = true
        var failure: Throwable? = None
        try {
            while (pending) {
                pending = false
                if (closed) {
                    finishClose();
                    break
                }
                reconcilePress()
                if (closed)
                    continue
                reconcileFocus()
                if (closed)
                    continue
                refreshHover(inputObservation())
            }
        } catch (error: Throwable) {
            failure = Some(error)
        }
        draining = false
        for (old in retired)
            failure = cleanupFailure(failure) { old.close() }
        retired.clear()
        throwFailure(failure)
    }
    private fun finishClose() {
        val time = inputObservation()
        var failure = cleanupFailure(None) { cancelPress(AreaCancelReason.Closed, time, true) }
        failure = cleanupFailure(failure) { replaceHover([], time) }
        val previous = activeFocus
        logicalFocus = None
        activeFocus = None
        when (previous) {
            case Some(area) -> failure =
                cleanupFailure(failure) { deliver(area, AreaEvent.FocusChanged(false), true) };
            case None -> {}
        }
        val session = ime
        ime = ImeSession.Off
        imeCaret = None
        when (session) {
            case Off -> {};
            else -> failure = cleanupFailure(failure) { imeAllowed(false) }
        }
        failure = cleanupFailure(failure) { scene.close() }
        scene = AreaScene([])
        owned.clear()
        throwFailure(failure)
    }
    internal fun checkThread() {
        if (thread != currentThreadId())
            throw IllegalStateException(Some("input requires its owner thread"))
    }
    internal fun checkOpen() {
        checkThread()
        if (closed)
            throw IllegalStateException(Some("input router is closed"))
    }
    public override fun close() {
        checkThread()
        if (closed)
            return
        dispatch {
            closed = true
            for (area in owned)
                area.closed = true
            pending = true
        }
    }
}

internal fun inputObservation(): InputTime = InputTime.Observed(MonotonicTimeSource.markNow())
