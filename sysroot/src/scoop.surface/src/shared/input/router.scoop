package scoop.surface

import scoop.graphics.*
import scoop.platform.concurrent.currentThreadId
import scoop.platform.time.MonotonicTimeSource
import scoop.window.*

internal enum ImeSession {
    Off, Opening(InputArea), On(InputArea), Closing(InputArea)
}

/** Shared routing state; the window adapter supplies only invalidation and IME operations. */
internal class InputRouter(
    internal var osFocused: Boolean,
    private val invalidate: () -> Unit,
    internal val imeAllowed: (Boolean) -> Unit,
    internal val imeCursor: (ImeCaret) -> Boolean
): Closeable {
    private val thread = currentThreadId()
    internal var closed = false
    internal var scene = AreaScene([])
    private val owned = ArrayList<InputScope>()
    internal val rootScope = InputScope(this, None, None, { _, _ -> Unit })
    private val retired = ArrayList<AreaScene>()
    private val retiredScopes = ArrayList<InputScope>()
    private var depth = 0
    private var draining = false
    internal var pending = false
    internal var pointer: PointerState? = None
    internal var inside = false
    internal var hover: Array<InputScope> = []
    internal var pressed: Array<InputScope>? = None
    internal var pointerClaim: InputScope? = None
    internal var scrollRoute: InputScrollRoute? = None
    internal val buttons = ArrayList<MouseButton>()
    internal var logicalFocus: InputArea? = None
    internal var activeFocus: InputArea? = None
    internal var activeFocusVisible = false
    internal var focusRevision = 0uL
    internal val boundaries = ArrayList<InputBoundary>()
    internal var pendingBoundaryChange = false
    internal var boundaryRevision = 0uL
    internal var ime = ImeSession.Off
    internal var imeCaret: ImeCaret? = None
    internal var imeConnection: TextInputConnection? = None
    internal var imeRequest = 0UL
    internal var caretFrameValid = false
    internal val activityObservers = ArrayList<InputActivityObserver>()
    internal val pointerObservers = ArrayList<WindowPointerObserver>()
    private var activityDirty = false

    init {
        owned.add(rootScope)
    }

    fun createArea(
        focusable: Boolean,
        textInput: Boolean,
        parent: InputScope?,
        handler: (RoutedEventContext, InputEvent) -> Unit
    ): InputArea {
        checkOpen()
        val result =
            InputArea(this, focusable || textInput, textInput, acceptParent(parent), handler)
        owned.add(result.scope)
        return result
    }
    fun createScope(
        parent: InputScope?,
        handler: (RoutedEventContext, InputEvent) -> Unit
    ): InputScope {
        checkOpen()
        val result = InputScope(this, None, Some(acceptParent(parent)), handler)
        owned.add(result)
        return result
    }
    private fun acceptParent(parent: InputScope?): InputScope {
        val result = parent ?: rootScope
        requireInput(result.owner === this, "input parent belongs to another window")
        result.checkOpen()
        return result
    }
    fun reparent(scope: InputScope, parent: InputScope?) {
        if (scope === rootScope) {
            when (parent) {
                case Some(_) -> throw IllegalArgumentException(
                    Some("window input root cannot be reparented")
                )
                case None -> {}
            }
            return
        }
        val next = acceptParent(parent)
        var cursor: InputScope? = Some(next)
        while (true) {
            val current = cursor ?: break
            requireInput(current !== scope, "input parent would create a cycle")
            cursor = current.ancestor
        }
        if (!sameScope(scope.ancestor, Some(next))) {
            scope.ancestor = Some(next)
            changed()
        }
    }
    fun beginFrame(): InputFrame {
        checkOpen();
        return InputFrame(this)
    }
    fun publish(frame: InputFrame) {
        checkOpen()
        requireInput(frame.owner === this, "input frame belongs to another window")
        val next = frame.take()
        try {
            retired.add(scene)
        }
        catch (error: Throwable) {
            throwFailure(cleanupFailure(Some(error)) { next.close() });
            throw error
        }
        scene = next
        caretFrameValid = true
        pending = true
        activityDirty = true
        drain()
    }
    fun changed() {
        checkThread()
        if (closed)
            return
        pending = true
        dispatch { invalidate() }
    }
    fun geometryChanged() {
        imeCaret = None;
        caretFrameValid = false
        changed()
    }
    fun detached(scope: InputScope) {
        retiredScopes.add(scope)
        var index = 0L
        while (index < owned.size) {
            if (owned[index] === scope) {
                owned.removeAt(index);
                break
            }
            index += 1L
        }
        changed()
    }
    fun event(event: WindowEvent) {
        checkThread()
        if (closed)
            return
        val snapshot = pointerObservers.toArray()
        val observation =
            when (event) {
                case Pointer(value) -> Some(PointerObservation.Pointer(value))
                case Focused(false) -> Some(PointerObservation.FocusLost)
                else -> None
            }
        var failure =
            cleanupFailure(None) {
                dispatch {
                    when (event) {
                        case Pointer(value) -> pointerEvent(value)
                        case Focused(value) -> {
                            osFocused = value
                            pending = true
                            if (!value)
                                cancelPointerInput(
                                    InputCancelReason.Window(PointerCancelReason.FocusLost),
                                    inputObservation()
                                )
                        }
                        case Keyboard(value) -> routeFocused(InputEvent.Keyboard(value))
                        case ModifiersChanged(value) -> notifyFocused(
                            InputEvent.ModifiersChanged(value)
                        )
                        case TextInput(value) -> textEvent(value)
                        else -> {}
                    }
                }
            }
        if (!closed) {
            when (observation) {
                case Some(value) -> failure =
                    cleanupFailure(failure) { deliverPointerObservation(snapshot, value) }
                case None -> {}
            }
        }
        throwFailure(failure)
    }
    internal fun dispatch(block: () -> Unit) {
        checkThread()
        depth += 1
        activityDirty = true
        var failure: Throwable? = None
        try {
            block()
        } catch (error: Throwable) {
            failure = Some(error)
        }
        depth -= 1
        if (depth == 0)
            failure = cleanupFailure(failure) { drain() }
        throwFailure(failure)
    }
    private fun drain() {
        if (depth != 0 || draining)
            return
        draining = true
        var failure: Throwable? = None
        try {
            while (pending || activityDirty) {
                if (closed) {
                    finishClose();
                    break
                }
                if (pending) {
                    pending = false
                    val boundaryChange = pendingBoundaryChange
                    pendingBoundaryChange = false
                    reconcilePress(boundaryChange)
                    if (closed)
                        continue
                    reconcileScroll()
                    if (closed)
                        continue
                    reconcileFocus()
                    if (closed)
                        continue
                    refreshHover(inputObservation())
                }
                if (!pending) {
                    activityDirty = false
                    notifyActivity()
                }
            }
        } catch (error: Throwable) {
            failure = Some(error)
        }
        draining = false
        for (old in retired)
            failure = cleanupFailure(failure) { old.close() }
        retired.clear()
        for (scope in retiredScopes)
            scope.retireEventHandlers()
        retiredScopes.clear()
        throwFailure(failure)
    }
    private fun finishClose() {
        val time = inputObservation()
        var failure = cleanupFailure(None) { cancelPointerInput(InputCancelReason.Closed, time) }
        failure = cleanupFailure(failure) { replaceHover([], time) }
        val previous = activeFocus
        logicalFocus = None
        activeFocus = None
        activeFocusVisible = false
        when (previous) {
            case Some(area) -> failure =
                cleanupFailure(failure) {
                    notify(area.scope, InputEvent.FocusChanged(false), terminal = true)
                };
            case None -> {}
        }
        val session = ime
        ime = ImeSession.Off
        imeCaret = None
        imeConnection = None
        caretFrameValid = false
        when (session) {
            case Off -> {};
            else -> failure = cleanupFailure(failure) { imeAllowed(false) }
        }
        failure =
            cleanupFailure(failure) {
                deliverPointerObservation(
                    pointerObservers.toArray(),
                    PointerObservation.Closed,
                    terminal = true
                )
            }
        for (observer in pointerObservers)
            observer.closed = true
        pointerObservers.clear()
        failure = cleanupFailure(failure) { scene.close() }
        scene = AreaScene([])
        for (scope in owned)
            scope.retireEventHandlers()
        owned.clear()
        throwFailure(failure)
    }
    internal fun checkThread() {
        if (thread != currentThreadId())
            throw IllegalStateException(Some("input requires its owner thread"))
    }
    internal fun checkOpen() {
        checkThread()
        if (closed)
            throw IllegalStateException(Some("input router is closed"))
    }
    public override fun close() {
        checkThread()
        if (closed)
            return
        dispatch {
            closed = true
            for (scope in owned) {
                scope.closed = true
                scope.retireDefaultActions()
            }
            for (observer in activityObservers)
                observer.closed = true
            activityObservers.clear()
            for (boundary in boundaries)
                boundary.closed = true
            boundaries.clear()
            pending = true
        }
    }
}

internal fun inputObservation(): InputTime = InputTime.Observed(MonotonicTimeSource.markNow())
