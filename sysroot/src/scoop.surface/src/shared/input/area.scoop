package scoop.surface

import scoop.graphics.Rect
import scoop.graphics.Point

/** Stable input identity; geometry is supplied by each successfully submitted frame. */
public class InputArea internal constructor(
    internal val owner: InputRouter,
    focusable: Boolean,
    textInput: Boolean,
    parent: InputScope,
    handler: (RoutedEventContext, InputEvent) -> Unit
): Closeable {
    internal var caret: Rect? = None
    internal var caretRevision: Long? = None
    internal var textInputRevision = 0UL
    private var acceptsFocus = focusable
    private var acceptsText = textInput
    internal var lastFocusRequest: ULong? = None
    internal var lastFocusOrigin = FocusOrigin.Programmatic
    private var visibility = FocusVisibility.Automatic
    public val scope: InputScope = InputScope(owner, Some(this), Some(parent), handler)
    internal val closed: Boolean get() = scope.closed
    private var ignored = false
    public val focusable: Boolean get() {
        owner.checkThread()
        return acceptsFocus
    }
    public var textInput: Boolean
    get() {
        owner.checkThread();
        return acceptsText
    }
    set(value) {
        checkOpen()
        if (acceptsText != value) {
            acceptsText = value
            if (value)
                acceptsFocus = true
            owner.changed()
        }
    }
    public val isClosed: Boolean get() {
        owner.checkThread();
        return closed
    }
    public val hasFocus: Boolean get() {
        owner.checkThread();
        return sameArea(owner.logicalFocus, Some(this))
    }
    public val isFocusActive: Boolean get() {
        owner.checkThread();
        return sameArea(owner.activeFocus, Some(this))
    }
    public val focusOrigin: FocusOrigin get() {
        owner.checkThread()
        return lastFocusOrigin
    }
    public var focusVisibility: FocusVisibility
    get() {
        owner.checkThread();
        return visibility
    }
    set(value) {
        checkOpen()
        if (visibility != value) {
            visibility = value
            owner.changed()
        }
    }
    public val isFocusVisible: Boolean get() {
        owner.checkThread()
        return !closed &&
            isFocusActive &&
            when (visibility) {
                case Automatic -> textInput || lastFocusOrigin != FocusOrigin.Pointer
                case Always -> true
                case Never -> false
            }
    }
    /** Window sequence of the last successful focus request, including pointer focus. */
    public val focusRevision: ULong? get() {
        owner.checkThread()
        return if (closed)
            None
        else
            lastFocusRequest
    }
    public val windowBounds: Rect? get() {
        owner.checkThread()
        if (closed)
            return None
        val placement = owner.scene.find(this) ?: return None
        return Some(placement.geometry.bounds)
    }
    /** Latest observed window pointer mapped through the currently committed geometry. */
    public val pointerPosition: Point? get() {
        owner.checkThread()
        if (closed || !owner.inside)
            return None
        val pointer = owner.pointer ?: return None
        val placement = owner.scene.find(this) ?: return None
        return placement.geometry.toLocal(
            Point(pointer.logicalPosition.x, pointer.logicalPosition.y)
        )
    }
    public val visibleBounds: Rect? get() {
        owner.checkThread()
        if (closed)
            return None
        val placement = owner.scene.find(this) ?: return None
        return placement.geometry.visibleBounds
    }
    /** The clipped caret from a successful frame that still matches the current document. */
    public val visibleCaretBounds: Rect? get() {
        owner.checkThread()
        return if (closed)
            None
        else
            owner.currentCaret(this).rect
    }
    /** Maps a window point through the current successful placement. */
    public fun toLocal(windowPoint: Point): Point? {
        owner.checkThread()
        if (closed)
            return None
        val placement = owner.scene.find(this) ?: return None
        return placement.geometry.toLocal(windowPoint)
    }
    /** Maps a local subregion without exposing a borrowed geometry object. */
    public fun toWindow(localRect: Rect): Rect? {
        owner.checkThread()
        if (closed)
            return None
        val placement = owner.scene.find(this) ?: return None
        if (placement.geometry.toLocal(Point(0.0, 0.0)) == None)
            return None
        return Some(placement.geometry.toWindow(localRect))
    }
    public val canFocus: Boolean get() {
        owner.checkThread()
        return !closed && focusable && owner.path(scope).size > 0L && visibleBounds != None
    }
    public var ignoreSelf: Boolean
    get() {
        owner.checkThread();
        return ignored
    }
    set(value) {
        checkOpen();
        if (ignored != value) {
            ignored = value;
            owner.changed()
        }
    }
    /** Returns false when this area has no active placement or does not accept focus. */
    public fun requestFocus(origin: FocusOrigin = FocusOrigin.Programmatic): Boolean {
        checkOpen();
        return owner.focus(this, origin)
    }
    public fun clearFocus() {
        checkOpen()
        if (hasFocus)
            owner.clearFocus()
        else
            owner.reserveFocusRequest()
    }
    /** Returns whether this area already owns the native cycle being retired. */
    public fun restartTextInput(): Boolean {
        checkOpen()
        return owner.restartTextInput(this)
    }
    /** Stages a value for the next placement; None withdraws unavailable geometry. */
    public fun setCaret(rect: Rect?, revision: Long? = None) {
        checkOpen()
        when (revision) {
            case Some(value) -> requireInput(value >= 0L, "negative text revision");
            case None -> {}
        }
        when (rect) {
            case Some(value) -> requireInput(
                value.x.isFinite() &&
                    value.y.isFinite() &&
                    value.width.isFinite() &&
                    value.height.isFinite() &&
                    value.width >=
                    0.0 &&
                    value.height >=
                    0.0 &&
                    (value.x + value.width).isFinite() &&
                    (value.y + value.height).isFinite(),
                "invalid area caret rectangle"
            )
            case None -> {}
        }
        if (caret != rect || caretRevision != revision) {
            caret = rect
            caretRevision = revision
            owner.changed()
        }
    }
    internal fun checkOpen() {
        scope.checkOpen()
    }
    public override fun close() {
        scope.close()
    }
}

internal fun sameArea(left: InputArea?, right: InputArea?): Boolean =
    when (left) {
        case Some(a) -> when (right) {
            case Some(b) -> a === b;
            case None -> false
        }
        case None -> when (right) {
            case Some(_) -> false;
            case None -> true
        }
    }

internal fun requireInput(condition: Boolean, message: String) {
    if (!condition)
        throw IllegalArgumentException(Some(message))
}
