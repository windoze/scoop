package scoop.surface

import scoop.window.*

internal fun InputRouter.reserveFocusRequest(): ULong {
    checkOpen()
    focusRevision += 1uL
    return focusRevision
}

internal fun InputRouter.focus(area: InputArea, origin: FocusOrigin): Boolean {
    checkOpen()
    requireInput(area.owner === this, "input area belongs to another window")
    reserveFocusRequest()
    if (!area.canFocus)
        return false
    area.lastFocusRequest = Some(focusRevision)
    val visible = area.isFocusVisible
    area.lastFocusOrigin = origin
    if (!sameArea(logicalFocus, Some(area))) {
        logicalFocus = Some(area)
        changed()
    } else
        if (visible != area.isFocusVisible)
            changed()
    return true
}

internal fun InputRouter.clearFocus() {
    reserveFocusRequest()
    logicalFocus = None;
    changed()
}

internal fun InputRouter.reconcileFocus() {
    when (logicalFocus) {
        case Some(area) -> {
            if (path(area.scope).size == 0L)
                logicalFocus = None
        }
        case None -> {}
    }
    val next =
        if (osFocused)
            logicalFocus
        else
            None
    val ownerChanged = !sameArea(next, activeFocus)
    if (ownerChanged) {
        val previous = activeFocus
        activeFocus = next
        when (previous) {
            case Some(area) -> notify(area.scope, InputEvent.FocusChanged(false), terminal = true);
            case None -> {}
        }
        when (next) {
            case Some(area) -> notify(area.scope, InputEvent.FocusChanged(true));
            case None -> {}
        }
    }
    val visible = next?.isFocusVisible ?: false
    if (visible != activeFocusVisible) {
        activeFocusVisible = visible
        if (!ownerChanged) {
            when (next) {
                case Some(area) -> notify(area.scope, InputEvent.FocusVisibilityChanged(visible))
                case None -> {}
            }
        }
    }
    if (!closed)
        reconcileIme()
}

internal fun InputRouter.routeFocused(event: InputEvent) {
    if (!osFocused)
        return
    val chain = focusedPath()
    when (event) {
        case Keyboard(key) -> {
            when (activeFocus) {
                case Some(area) -> if (
                    !key.synthetic &&
                        key.state ==
                        ElementState.Pressed &&
                        area.lastFocusOrigin !=
                        FocusOrigin.Keyboard
                ) {
                    val visible = area.isFocusVisible
                    area.lastFocusOrigin = FocusOrigin.Keyboard
                    if (visible != area.isFocusVisible)
                        changed()
                }
                case None -> {}
            }
            route(deliveries(chain), event, key.time)
        }
        else -> throw IllegalArgumentException(Some("only keyboard input uses focused routing"))
    }
}

private fun InputRouter.focusedPath(): Array<InputScope> =
    when (activeFocus) {
        case Some(area) -> {
            val current = path(area.scope)
            if (current.size == 0L)
                path(inputRoot)
            else
                current
        }
        case None -> path(inputRoot)
    }

internal fun InputRouter.notifyFocused(event: InputEvent) {
    if (!osFocused)
        return
    val chain = focusedPath()
    val time = inputObservation()
    var failure: Throwable? = None
    for (scope in chain)
        failure = cleanupFailure(failure) { notify(scope, event, time, Some(chain[0L])) }
    throwFailure(failure)
}

internal fun InputRouter.restartTextInput(area: InputArea): Boolean {
    val owned = sameArea(imeOwner(ime), Some(area))
    area.textInputRevision += 1UL
    changed()
    return owned
}

internal fun InputRouter.textEvent(event: TextInputEvent) {
    val previous = imeOwner(ime)
    when (event) {
        case Enabled(connection) -> {
            when (ime) {
                case Opening(area) -> ime = ImeSession.On(area)
                case Closing(_) -> {
                    if (imeConnection != None && imeConnection != connection)
                        return
                }
                else -> return
            }
            imeConnection = connection
            pending = true
        }
        case Disabled(connection) -> {
            if (imeConnection != None && imeConnection != connection)
                return
            ime = ImeSession.Off;
            imeCaret = None;
            imeConnection = None
            pending = true
        }
        case Edit(batch) -> {
            when (batch.origin) {
                case Some(origin) -> if (imeConnection != Some(origin.connection))
                    return
                case None -> {}
            }
            when (previous) {
                case Some(area) -> if (area.caretRevision != None) {
                    imeCaret = None
                    pending = true
                }
                case None -> {}
            }
        }
    }
    when (previous) {
        case Some(area) -> notify(area.scope, InputEvent.TextInput(event), inactive = true)
        case None -> {}
    }
}

private fun InputRouter.reconcileIme() {
    val desired =
        when (activeFocus) {
            case Some(area) -> if (area.textInput && !area.closed && path(area.scope).size > 0L)
                Some(area)
            else
                None
            case None -> None
        }
    when (ime) {
        case Off -> {
            when (desired) {
                case Some(area) -> {
                    publishCaret(area)
                    ime = ImeSession.Opening(area)
                    imeRequest = area.textInputRevision
                    imeAllowed(true)
                }
                case None -> {}
            }
        }
        case Opening(area) -> continueIme(area, desired)
        case On(area) -> continueIme(area, desired)
        case Closing(_) -> {}
    }
}

private fun InputRouter.continueIme(area: InputArea, desired: InputArea?) {
    if (sameArea(Some(area), desired) && imeRequest == area.textInputRevision)
        publishCaret(area)
    else {
        ime = ImeSession.Closing(area);
        imeAllowed(false)
    }
}

private fun imeOwner(session: ImeSession): InputArea? =
    when (session) {
        case Off -> None
        case Opening(area) -> Some(area)
        case On(area) -> Some(area)
        case Closing(area) -> Some(area)
    }
