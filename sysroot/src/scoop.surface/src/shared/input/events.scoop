package scoop.surface

import scoop.window.*

/** Native state is retained; time can describe a later geometry-driven hover transition. */
public struct InputPointer(val state: PointerState, val time: InputTime)

public enum InputCancelReason {
    Window(
        PointerCancelReason
    ), AreaChanged, BoundaryChanged, ScrollInterrupted, Claimed, ClaimCancelled, Closed
}

/** Pixel distances are logical; line distances retain their native unit. */
public enum InputScrollDelta {
    Lines(Double, Double), Pixels(Double, Double)
}

public enum InputPointerEvent {
    Entered(InputPointer), Left(InputTime), Moved(InputPointer),
    Button(InputPointer, MouseButton, ElementState, Int),
    Wheel(InputPointer, InputScrollDelta, ScrollPhase, ScrollPhase),
    Cancelled(InputCancelReason, InputTime), ScrollCancelled(InputCancelReason, InputTime)
}

/** Snapshot for the current input domain's first-button decision, before route delivery. */
public struct InputPress(
    val target: InputScope,
    val pointer: InputPointer,
    val button: MouseButton,
    val clickCount: Int
)

/** Text transactions and focus/hover transitions are delivered directly to their owner. */
public enum InputEvent {
    Pointer(InputPointerEvent), Keyboard(KeyEvent), ModifiersChanged(Modifiers),
    TextInput(TextInputEvent), FocusChanged(Boolean), FocusVisibilityChanged(Boolean)
}

public enum FocusOrigin {
    Pointer, Keyboard, Programmatic
}

public enum FocusVisibility {
    Automatic, Always, Never
}

public enum RoutedPhase {
    Capture, Target, Bubble, Default, Notification
}
