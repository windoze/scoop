package scoop.surface

import scoop.graphics.Color
import scoop.graphics.Point
import scoop.graphics.Size
import scoop.platform.concurrent.currentThreadId
import scoop.platform.time.MonotonicTimeSource
import scoop.time.*

private class AnimationEntry(val owner: Closeable, val sample: (TimeMark) -> Unit)

/** Shared owner-thread animation clock, driven by Surface frames or explicit offline sampling. */
public class AnimationTimeline public constructor(
    private val source: TimeSource = MonotonicTimeSource,
    private val invalidate: () -> Unit = {}
): Closeable {
    private val thread = currentThreadId()
    private var closed = false
    private var frame: TimeMark? = None
    private var previous: TimeMark? = None
    private val owned = ArrayList<AnimationEntry>()
    private val active = ArrayList<AnimationEntry>()
    private val completions = ArrayList<() -> Unit>()
    public val isClosed: Boolean get() = closed
    public val hasWork: Boolean get() {
        checkThread();
        return active.size > 0L || completions.size > 0L
    }

    public fun value(initial: Double): Animatable<Double> =
        value(initial, AnimationConverters.DoubleValue)
    public fun value(initial: Point): Animatable<Point> =
        value(initial, AnimationConverters.PointValue)
    public fun value(initial: Size): Animatable<Size> =
        value(initial, AnimationConverters.SizeValue)
    public fun value(initial: Color): Animatable<Color> =
        value(initial, AnimationConverters.ColorValue)
    public fun <T> value(initial: T, converter: AnimationConverter<T>): Animatable<T> {
        checkOpen()
        val result = Animatable(this, initial, converter)
        owned.add(AnimationEntry(result, { time -> result.sample(time) }))
        return result
    }
    /** Advances all values once; completions run after the sampling pass. */
    public fun advanceTo(time: TimeMark) {
        withFrame(time) {}
        if (!closed)
            invalidate()
    }
    internal fun <T> withFrame(time: TimeMark, block: () -> T): T {
        checkOpen()
        if (frame != None)
            throw IllegalStateException(Some("animation sampling is not reentrant"))
        checkTime(time)
        frame = Some(time)
        try {
            for (animation in active.toArray()) {
                if (closed)
                    break
                animation.sample(time)
            }
            val callbacks = completions.toArray()
            completions.clear()
            for (callback in callbacks) {
                if (closed)
                    break
                callback()
            }
            return block()
        } finally {
            frame = None
        }
    }
    internal fun now(): TimeMark {
        checkOpen()
        when (frame) {
            case Some(value) -> return value;
            case None -> {}
        }
        val result = source.markNow()
        checkTime(result)
        return result
    }
    private fun checkTime(time: TimeMark) {
        requireAnimation(time.source === source, "animation clock source mismatch")
        when (previous) {
            case Some(value) -> requireAnimation(time >= value, "animation time moved backwards");
            case None -> {}
        }
        previous = Some(time)
    }
    internal fun changed() {
        if (!closed)
            invalidate()
    }
    internal fun schedule(animation: Closeable) {
        checkOpen()
        for (existing in active)
            if (existing.owner === animation)
                return
        for (entry in owned) {
            if (entry.owner === animation) {
                active.add(entry)
                return
            }
        }
        throw IllegalStateException(Some("animation is not owned by this timeline"))
    }
    internal fun unschedule(animation: Closeable) {
        removeDriver(active, animation)
    }
    internal fun detached(animation: Closeable) {
        unschedule(animation);
        removeDriver(owned, animation)
    }
    internal fun finished(callback: () -> Unit) {
        if (!closed)
            completions.add(callback)
    }
    internal fun checkThread() {
        if (thread != currentThreadId())
            throw IllegalStateException(Some("animation requires its owner thread"))
    }
    internal fun checkOpen() {
        checkThread()
        if (closed)
            throw IllegalStateException(Some("animation timeline is closed"))
    }
    public override fun close() {
        checkThread()
        if (closed)
            return
        closed = true
        completions.clear()
        for (animation in owned.toArray())
            animation.owner.close()
        active.clear()
        owned.clear()
    }
}

private fun removeDriver(values: ArrayList<AnimationEntry>, wanted: Closeable) {
    var index = 0L
    while (index < values.size) {
        if (values[index].owner === wanted) {
            values.removeAt(index);
            return
        }
        index += 1L
    }
}
