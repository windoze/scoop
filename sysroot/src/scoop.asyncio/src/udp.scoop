package scoop.asyncio

import scoop.platform.memory.NativeByteBuffer
import scoop.platform.net.*

/**
 * An owned datagram socket preserving message boundaries; each receive describes one datagram.
 */
public interface AsyncUdpSocket: AsyncCloseable {
    /**
     * The actual bound UDP endpoint.
     */
    public val localAddress: SocketAddress
    /**
     * Sends one datagram from count readable buffer bytes to the destination.
     */
    public suspend fun sendTo(
        buffer: NativeByteBuffer,
        destination: SocketAddress,
        count: Long
    ): Long
    /**
     * Receives one datagram into at most count writable bytes and reports its source and
     * truncation status.
     */
    public suspend fun receiveFrom(buffer: NativeByteBuffer, count: Long): Datagram
}

internal class UdpSocket(
    private val owner: OwnedEndpoint,
    public override val localAddress: SocketAddress
): AsyncUdpSocket {
    public override suspend fun sendTo(
        buffer: NativeByteBuffer,
        destination: SocketAddress,
        count: Long
    ): Long = sendUdp(owner, buffer, destination, count)
    public override suspend fun receiveFrom(buffer: NativeByteBuffer, count: Long): Datagram =
        receiveUdp(owner, buffer, count)
    public override suspend fun close() {
        owner.close()
    }
}

internal suspend fun bindUdpOnLoop(
    loop: LoopOwner,
    address: SocketAddress,
    reuse: Boolean
): AsyncUdpSocket {
    val job = loop.requireJob()
    val target = ioAddress(address)
    return suspendCoroutine<AsyncUdpSocket> {
        continuation ->
        val operation =
            LoopOperation(
                loop,
                loop.nextOperation(),
                {
                    native,
                    id -> @Unsafe
                    {
                        return@LoopOperation nativeStatus(
                            id,
                            nativeUdpBind(native, id, target, reuse)
                        )
                    }
                },
                { _, _ -> },
                {
                    event,
                    selected -> finishEndpointCreation<AsyncUdpSocket>(
                        loop,
                        EndpointKind.Udp,
                        event.result,
                        selected,
                        continuation,
                        { owner -> UdpSocket(owner, udpAddress(owner.pointer)) }
                    )
                }
            )
        operation.subscribe(job)
        loop.submit(operation)
    }
}
