package scoop.asyncio

import scoop.platform.env.temporaryDirectory
import scoop.platform.fs.*
import scoop.platform.native.temporaryPathPattern
import scoop.platform.system.PlatformException

/**
 * A newly created temporary path paired with its open asynchronous file. Closing the handle does
 * not delete the path.
 */
public struct TemporaryFile(val path: Path, val file: AsyncFile): AsyncCloseable {
    /**
     * Closes the file handle while leaving the temporary path in the filesystem.
     */
    public override suspend fun close() {
        file.close()
    }
}

internal suspend fun createTemporaryFileOnLoop(
    loop: LoopOwner,
    parent: Path?,
    prefix: String
): TemporaryFile {
    val job = loop.requireJob()
    val base = parent ?: temporaryDirectory()
    val pattern = temporaryPathPattern(base, prefix)
    return suspendCoroutine<TemporaryFile> {
        continuation ->
        val operation =
            LoopOperation(
                loop,
                loop.nextOperation(),
                {
                    native,
                    id -> @Unsafe
                    {
                        return@LoopOperation nativeStatus(
                            id,
                            startTemporaryFile(native, id, base, pattern)
                        )
                    }
                },
                {
                    native,
                    id -> @Unsafe
                    {
                        nativeWorkCancel(native, id)
                    }
                },
                {
                    event,
                    selected -> when (event.result) {
                        case Temporary(value) -> {
                            val owner = OwnedFile(loop, value.file, value.path.toOsString())
                            loop.retain(owner)
                            val failure: Throwable? =
                                when (selected) {
                                    case Some(error) -> Some(error)
                                    case None -> if (value.status.code == 0)
                                        None
                                    else {
                                        val error = nativeStatusError(value.status)
                                        Some(
                                            PlatformException(
                                                "create temporary file",
                                                error.kind,
                                                Some(error),
                                                Some(base.toOsString())
                                            )
                                        )
                                    }
                                }
                            when (failure) {
                                case None -> continuation.resume(
                                    TemporaryFile(value.path, WorkerFile(owner))
                                )
                                case Some(error) -> discardTemporaryFile(
                                    owner,
                                    value.path,
                                    error,
                                    continuation
                                )
                            }
                        }
                        case _ -> continuation.resumeWithException(
                            completionFailure(
                                "create temporary file",
                                event.result,
                                selected,
                                Some(base.toOsString())
                            ) ?:
                                IllegalStateException(Some("temporary creation returned no file"))
                        )
                    }
                }
            )
        operation.subscribe(job)
        loop.submit(operation)
    }
}

private fun discardTemporaryFile(
    owner: OwnedFile,
    path: Path,
    primary: Throwable,
    continuation: Continuation<TemporaryFile>
) {
    owner.closeOnLoop {
        closeFailure -> deleteFileForCleanup(owner.loop, path) {
            deleteFailure ->
            val cleanup =
                when (closeFailure) {
                    case None -> deleteFailure
                    case Some(error) -> Some(
                        when (deleteFailure) {
                            case None -> error
                            case Some(other) -> ResourceUseException(error, other)
                        }
                    )
                }
            continuation.resumeWithException(
                when (cleanup) {
                    case None -> primary
                    case Some(error) -> ResourceUseException(primary, error)
                }
            )
        }
    }
}
