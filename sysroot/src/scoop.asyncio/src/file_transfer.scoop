package scoop.asyncio

import scoop.platform.memory.NativeByteBuffer
import scoop.platform.memory.NativeByteBorrow
import scoop.platform.io.WriteZeroException

private class FileProgress {
    var count: Long = 0L
}

internal suspend fun transferFile(
    owner: OwnedFile,
    buffer: NativeByteBuffer,
    count: Long,
    writing: Boolean
): Long {
    val job = owner.loop.requireJob()
    val reservation = owner.reserve()
    try {
        val borrowed = borrowFile(buffer, count, writing)
        val progress = FileProgress()
        try {
            if (count == 0L)
                return 0L
            return suspendCoroutine<Long> {
                continuation ->
                val operation =
                    LoopOperation(
                        owner.loop,
                        owner.loop.nextOperation(),
                        {
                            _,
                            id -> @Unsafe
                            {
                                return@LoopOperation nativeStatus(
                                    id,
                                    nativeFileTransfer(
                                        owner.pointer,
                                        id,
                                        borrowed.pointer(),
                                        borrowed.length,
                                        writing
                                    )
                                )
                            }
                        },
                        {
                            native,
                            id -> @Unsafe
                            {
                                nativeWorkCancel(native, id)
                            }
                        },
                        {
                            event, selected ->
                            progress.count = resultProgress(event.result)
                            when (
                                completionFailure(
                                    if (writing)
                                        "file write"
                                    else
                                        "file read",
                                    event.result,
                                    selected,
                                    Some(owner.context)
                                )
                            ) {
                                case Some(error) -> continuation.resumeWithException(error)
                                case None -> {
                                    if (writing && progress.count == 0L)
                                        continuation.resumeWithException(WriteZeroException())
                                    else
                                        continuation.resume(progress.count)
                                }
                            }
                        }
                    )
                operation.subscribe(job)
                owner.attach(operation)
                owner.loop.submit(operation)
            }
        } finally {
            @Unsafe
            {
                borrowed.complete(progress.count)
            }
        }
    } finally {
        reservation.dispose()
    }
}

private fun borrowFile(buffer: NativeByteBuffer, count: Long, writing: Boolean): NativeByteBorrow {
    @Unsafe
    {
        return if (writing)
            buffer.borrowReadable(count)
        else
            buffer.borrowWritable(count)
    }
}

@Extern(name = "scoop_io_file_transfer")
private fun nativeFileTransfer(
    file: Ptr<Unit>,
    id: Long,
    bytes: Ptr<Byte>?,
    count: Long,
    writing: Boolean
): Int
