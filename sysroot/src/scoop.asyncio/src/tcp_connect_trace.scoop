package scoop.asyncio

import scoop.platform.time.MonotonicTimeSource
import scoop.time.TimeMark

/**
 * Distinguishes name resolution from connecting to an address.
 */
public enum TcpConnectPhase {
    /**
     * An address-family lookup phase.
     */
    Resolve,
    /**
     * A TCP connection-attempt phase.
     */
    Connect }
/**
 * The start or completion boundary of a traced phase.
 */
public enum TcpConnectEventKind {
    /**
     * The phase began.
     */
    Started,
    /**
     * The phase ended, including failure or cancellation.
     */
    Finished }

/**
 * A phase boundary recorded at a monotonic time mark.
 */
public class TcpConnectEvent internal constructor(
    /**
     * The operation phase being observed.
     */
    public val phase: TcpConnectPhase,
        /**
         * Whether this event starts or finishes the phase.
         */
        public val kind: TcpConnectEventKind,
        /**
         * The monotonic time mark at the phase boundary.
         */
        public val at: TimeMark
)

internal class TcpConnectTrace(private val callback: (TcpConnectEvent) -> Unit) {
    private var resolving: Boolean = false
    private var resolved: Boolean = false
    private var connecting: Boolean = false
    private var connected: Boolean = false
    private var failed: Boolean = false

    fun start(phase: TcpConnectPhase) {
        if (failed) return
        when (phase) {
            case Resolve -> { if (resolving) return; resolving = true }
            case Connect -> { if (connecting) return; connecting = true }
        }
        notify(phase, TcpConnectEventKind.Started)
    }

    fun finish(phase: TcpConnectPhase) {
        if (failed) return
        when (phase) {
            case Resolve -> { if (!resolving || resolved) return; resolved = true }
            case Connect -> { if (!connecting || connected) return; connected = true }
        }
        notify(phase, TcpConnectEventKind.Finished)
    }

    private fun notify(phase: TcpConnectPhase, kind: TcpConnectEventKind) {
        try { callback(TcpConnectEvent(phase, kind, MonotonicTimeSource.markNow())) }
        catch (error: Throwable) { failed = true; throw error }
    }
}
