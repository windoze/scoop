package scoop.asyncio

import scoop.platform.system.*
import scoop.platform.net.Datagram
import scoop.platform.fs.FileMetadata

internal enum IoResult {
    Done, Bytes(Long), Eof, Created(Ptr<Unit>), Addresses(Ptr<Unit>?), Packet(Datagram), Failed(
        NativeError,
        Long
    ),
    Metadata(FileMetadata), Position(Long), Temporary(CreatedTemporaryFile), DirectoryName(
        OsString
    ),
    TtyResize(Long, Long), TtyTimeout, TtySizeValue(TtySize), TtyMode(Boolean)
}

internal struct NativeEvent(val id: Long, val result: IoResult)

internal enum IoStart {
    Pending, Finished(NativeEvent)
}

internal fun nativeStatus(id: Long, status: Int): IoStart =
    if (status < 0)
        IoStart.Finished(NativeEvent(id, IoResult.Failed(nativeStatusError(status), 0L)))
    else
        IoStart.Pending

internal fun nativeStatus(id: Long, status: NativeIoStatus): IoStart =
    if (status.code != 0)
        IoStart.Finished(NativeEvent(id, IoResult.Failed(nativeStatusError(status), 0L)))
    else
        IoStart.Pending

internal fun decodeEvent(record: NativeRecord): NativeEvent =
    NativeEvent(
        record.id,
        when (record.kind) {
            case 0 -> IoResult.Done
            case 1 -> IoResult.Bytes(record.count)
            case 2 -> IoResult.Eof
            case 3 -> IoResult.Created(record.resource!!)
            case 5 -> IoResult.Failed(
                NativeError(NativeErrorDomain.PosixErrno, record.code),
                record.count
            )
            case 6 -> IoResult.Addresses(record.resource)
            case 7 -> IoResult.Failed(
                NativeError(
                    NativeErrorDomain.AddressResolution,
                    record.code,
                    if (record.count < 0L)
                        None
                    else
                        Some(record.count.toInt())
                ),
                0L
            )
            case 8 -> IoResult.Packet(takeDatagram(record.resource!!))
            case 9 -> IoResult.Failed(
                NativeError(NativeErrorDomain.Win32, record.code),
                record.count
            )
            case 10 -> IoResult.Failed(
                NativeError(NativeErrorDomain.Winsock, record.code),
                record.count
            )
            // File and directory events: 0x100..0x1ff, matching native/loop.h.
            case 0x100 -> IoResult.Metadata(takeFileMetadata(record.resource!!))
            case 0x101 -> IoResult.Position(record.count)
            case 0x102 -> IoResult.Temporary(takeTemporaryFile(record.resource!!))
            case 0x103 -> IoResult.DirectoryName(takeDirectoryName(record.resource!!))
            // TTY events: 0x200..0x2ff, matching native/loop.h.
            case 0x200 -> IoResult.TtyResize(record.count shr 32L, record.count and 4294967295L)
            case 0x201 -> IoResult.TtyTimeout
            else -> throw IllegalStateException(Some("invalid native I/O event"))
        }
    )

internal fun resultFailure(
    operation: String,
    result: IoResult,
    context: OsString? = None
): Throwable? =
    when (result) {
        case Failed(error, _) -> Some(
            PlatformException(operation, error.kind, Some(error), context)
        )
        case _ -> None
    }

internal fun completionFailure(
    operation: String,
    result: IoResult,
    selected: Throwable?,
    context: OsString? = None
): Throwable? =
    when (selected) {
        case Some(_) -> selected;
        case None -> resultFailure(operation, result, context)
    }

internal fun resultProgress(result: IoResult): Long =
    when (result) {
        case Bytes(count) -> count
        case Packet(value) -> value.count
        case Failed(_, count) -> count
        case _ -> 0L
    }
