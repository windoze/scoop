package scoop.asyncio

import scoop.platform.fs.*
import scoop.platform.memory.NativeByteBuffer
import scoop.platform.native.temporaryPathPattern
import scoop.platform.system.*
import scoop.test.*
import scoop.text.startsWith

@Test
private class WindowsTemporaryCompletionTest {
    @Test
    fun `temporary files keep their original handles wide paths and complete prefixes`() {
        withTemporaryParent {
            parent -> @Unsafe
            {
                val created = nativeLoopCreate()
                assertEquals(0, created.status.code)
                val loop = created.pointer!!
                val first = createTemporary(loop, parent, "临时 😀-")
                val second = createTemporary(loop, parent, "临时 😀-")
                assertFalse(first.path == second.path)
                assertEquals(parent.canonicalize(), first.path.parent!!)
                assertTrue(first.path.fileName!!.decodeUtf8().startsWith("临时 😀-"))
                val devicePrefix = createTemporary(loop, parent, "CON.")
                assertTrue(devicePrefix.path.fileName!!.decodeUtf8().startsWith("CON."))
                val bytes = NativeByteBuffer.allocate(1L)
                bytes.writeByte(0xff.toByte())
                val borrow = bytes.borrowReadable(1L)
                assertEquals(
                    0,
                    nativeFileTransfer(first.file, 2L, borrow.pointer(), borrow.length, true)
                )
                gcCollect()
                val event = nextTemporaryResult(loop)
                assertEquals(1, event.kind)
                assertEquals(1L, event.count)
                borrow.complete(event.count)
                assertEquals(0, nativeFileSeek(first.file, 3L, 0L, true))
                val position = nextTemporaryResult(loop)
                assertEquals(0x101, position.kind)
                assertEquals(1L, position.count)
                for (file in [first, second, devicePrefix]) {
                    assertEquals(0, nativeFileClose(file.file, 4L))
                    assertEquals(0, nextTemporaryResult(loop).kind)
                    assertTrue(file.path.exists())
                }
                assertEquals(0xff.toByte(), first.path.readAllBytes()[0L])
                first.path.delete()
                second.path.delete()
                devicePrefix.path.delete()
                bytes.close()
                assertEquals(0, drainTemporaryLoop(loop))
            }
        }
    }
    @Test
    fun `temporary prefix and missing parent failures retain their normal contracts`() {
        withTemporaryParent {
            parent ->
            for (prefix in ["bad/name", "bad\\name", "bad:name", "bad\u0000"]) {
                assertFailsWith<IllegalArgumentException> { temporaryPathPattern(parent, prefix) }
            }
            val missing = parent.resolve(Path.fromString("missing"))
            @Unsafe
            {
                val created = nativeLoopCreate()
                assertEquals(0, created.status.code)
                val loop = created.pointer!!
                assertEquals(
                    0,
                    startTemporaryFile(loop, 1L, missing, temporaryPathPattern(missing, ""))
                )
                val event = nextTemporaryResult(loop)
                val error = nativeStatusError(NativeIoStatus(event.kind, event.code))
                assertEquals(NativeErrorDomain.Win32, error.domain)
                assertEquals(PlatformErrorKind.NotFound, error.kind)
                assertEquals(0, drainTemporaryLoop(loop))
            }
            parent.entries().use { entries -> assertTrue(entries.next() == None) }
        }
    }
    @Test
    fun `queued cancellation creates nothing and late creation retains cleanup ownership`() {
        withTemporaryParent {
            parent -> @Unsafe
            {
                val created = nativeLoopCreate()
                assertEquals(0, created.status.code)
                val loop = created.pointer!!
                val stopped = temporaryFence(loop, 100L, 0u)
                assertEquals(0, stopped.status.code)
                waitTemporaryFence(stopped.pointer!!)
                assertEquals(
                    0,
                    startTemporaryFile(loop, 1L, parent, temporaryPathPattern(parent, "queued-"))
                )
                gcCollect()
                cancelTemporaryWork(loop, 1L)
                val cancelled = nextTemporaryResult(loop)
                assertEquals(1L, cancelled.id)
                assertEquals(5, cancelled.kind)
                assertTrue(cancelled.code != 0)
                parent.entries().use { entries -> assertTrue(entries.next() == None) }
                releaseTemporaryFence(stopped.pointer!!)
                assertEquals(100L, nextTemporaryResult(loop).id)
                assertEquals(
                    0,
                    startTemporaryFile(loop, 2L, parent, temporaryPathPattern(parent, "late-"))
                )
                val finished = temporaryFence(loop, 101L, 0u)
                assertEquals(0, finished.status.code)
                waitTemporaryFence(finished.pointer!!)
                cancelTemporaryWork(loop, 2L)
                val event = nextTemporaryResult(loop)
                assertEquals(2L, event.id)
                assertEquals(0x102, event.kind)
                val file = takeTemporaryFile(event.resource!!)
                assertEquals(0, file.status.code)
                assertTrue(file.path.exists())
                releaseTemporaryFence(finished.pointer!!)
                assertEquals(101L, nextTemporaryResult(loop).id)
                assertEquals(0, nativeFileClose(file.file, 3L))
                assertEquals(0, nextTemporaryResult(loop).kind)
                file.path.delete()
                parent.entries().use { entries -> assertTrue(entries.next() == None) }
                assertEquals(0, drainTemporaryLoop(loop))
            }
        }
    }
    @Test
    fun `native entropy failures retain the full NtStatus code`() {
        val code = 0xc000000du.toInt()
        val error = nativeStatusError(NativeIoStatus(11, code))
        assertEquals(NativeErrorDomain.NtStatus, error.domain)
        assertEquals(code, error.code)
        assertEquals(PlatformErrorKind.InvalidInput, error.kind)
    }
}

private fun withTemporaryParent(block: (Path) -> Unit) {
    val root = createTempDirectory(prefix = "scoop-iocp-temp-")
    try {
        val name = OsString.fromUtf16([0x4e2d.toUShort(), 0xd800.toUShort()])
        val parent = root.resolve(Path.fromOsString(name))
        parent.createDirectory()
        block(parent)
    } finally {
        root.deleteRecursively()
    }
}

@Unsafe
private fun createTemporary(loop: Ptr<Unit>, parent: Path, prefix: String): CreatedTemporaryFile {
    assertEquals(0, startTemporaryFile(loop, 1L, parent, temporaryPathPattern(parent, prefix)))
    gcCollect()
    val event = nextTemporaryResult(loop)
    assertEquals(0x102, event.kind)
    val file = takeTemporaryFile(event.resource!!)
    assertEquals(0, file.status.code)
    return file
}

@Unsafe
private fun nextTemporaryResult(loop: Ptr<Unit>): NativeRecord {
    while (nativeLoopBatchSize(loop) == 0L)
        assertEquals(0, nativeLoopPoll(loop, true).code)
    return nativeLoopNext(loop)
}

@Extern(name = "scoop_test_fence_create")
private fun temporaryFence(loop: Ptr<Unit>, id: Long, spare: UInt): NativeCreated

@Extern(name = "scoop_test_fence_wait")
private fun waitTemporaryFence(fence: Ptr<Unit>)

@Extern(name = "scoop_test_fence_release")
private fun releaseTemporaryFence(fence: Ptr<Unit>)

@Extern(name = "scoop_io_work_cancel")
private fun cancelTemporaryWork(loop: Ptr<Unit>, id: Long)

@Extern(name = "scoop_test_iocp_drain")
private fun drainTemporaryLoop(loop: Ptr<Unit>): Int
