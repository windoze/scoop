package scoop.asyncio

import scoop.platform.memory.NativeByteBuffer
import scoop.test.*
import scoop.time.Duration

// Query actual socket backpressure without depending on the backend's request layout.
private suspend fun outputBlocked(backend: PlatformEventLoop, stream: AsyncTcpStream): Boolean =
    suspendCoroutine<Boolean> {
        continuation ->
        val endpoint = (stream as TcpStream).owner
        backend.state.post {
            @Unsafe
            {
                continuation.resume(nativeOutputBlocked(endpoint.pointer) == 1)
            }
        }
    }

@Test
private class AsyncTcpQueuedWriteTest {
    @Test
    fun `cancel a queued write commits exactly the sent prefix and permits later writes`() {
        val backend = PlatformEventLoop()
        val loop: EventLoop = backend
        loop.run suspend {
            scope ->
            val timeout =
                scope.launch suspend {
                    loop.sleep(Duration.seconds(15L));
                    fail(Some("queued write test timed out"))
                }
            val(_, client, server) = tcpPair(loop, scope)
            NativeByteBuffer.allocate(67108864L).use suspend {
                output ->
                @Unsafe
                {
                    output.withWritableBytes {
                        pointer, length ->
                        @Unsafe
                        {
                            fillNative(pointer, 49, length.toULong())
                        }
                        length
                    }
                }
                val writer = scope.launch suspend { client.writeFully(output) }
                while (!outputBlocked(backend, client)) {
                    assertFalse(
                        writer.isCompleted,
                        Some("kernel accepted the entire backpressure payload")
                    )
                }
                assertFailsWith<IllegalStateException> { output.compact() }
                gcCollect()
                val before = output.readPosition
                writer.cancel()
                writer.join()
                val sent = output.readPosition
                assertTrue(sent >= before)
                assertTrue(sent < output.writePosition)
                NativeByteBuffer.allocate(sent + 1L).use suspend {
                    input ->
                    server.readFully(input, sent)
                    NativeByteBuffer.allocate(1L).use suspend {
                        marker ->
                        marker.writeByte(114)
                        client.writeFully(marker)
                    }
                    server.readFully(input, 1L)
                    assertEquals(114.toByte(), input.getByte(sent))
                    if (sent > 0L)
                        assertEquals(49.toByte(), input.getByte(sent - 1L))
                    Unit
                }
            }
            timeout.cancel()
            timeout.join()
        }
    }
}

@Extern(name = "scoop_test_socket_output_blocked")
private fun nativeOutputBlocked(endpoint: Ptr<Unit>): Int

@Extern(name = "memset")
private fun fillNative(pointer: Ptr<Byte>?, value: Int, count: ULong): Ptr<Byte>?
