package scoop.asyncio

import scoop.platform.memory.NativeByteBuffer
import scoop.test.*

@Test
private class AsyncReadAllTests {
    @Test
    fun `readAllBytes collects only the remaining bytes across real suspension and empty input`() {
        val raw = ShortSource("prefix:中🌍".toByteArray())
        raw.position = 7L
        val source = ObservedCollectSource(raw)
        val loop: EventLoop = PlatformEventLoop()
        loop.run suspend {
            _ ->
            val bytes = source.readAllBytes()
            assertEquals("中🌍", String.fromUtf8(bytes))
            assertEquals(0L, source.readAllBytes().size)
            assertEquals("中🌍", String.fromUtf8(bytes))
            assertEquals(0L, ShortSource(Array<Byte>(0L) { 0.toByte() }).readAllBytes().size)
            assertEquals(0, source.closes)
        }
        assertTrue(source.buffer!!.isClosed)
    }

    @Test
    fun `readAllBytes preserves an input failure and releases its buffer without closing the source`() {
        val raw = ShortSource([1, 2, 3, 4])
        raw.failAfter = 2L
        val source = ObservedCollectSource(raw)
        val loop: EventLoop = PlatformEventLoop()
        val error = assertFailsWith<Throwable> { loop.run suspend { _ -> source.readAllBytes() } }
        assertSame(raw.failure, error)
        assertEquals(2L, raw.position)
        assertEquals(0, source.closes)
        assertTrue(source.buffer!!.isClosed)
    }

    @Test
    fun `readAllBytes rejects invalid progress before copying bytes`() {
        for (progress in [-1L, 8193L]) {
            val source = InvalidCollectSource(progress)
            val loop: EventLoop = PlatformEventLoop()
            assertFailsWith<IllegalStateException> {
                loop.run suspend { _ -> source.readAllBytes() }
            }
            assertTrue(source.buffer!!.isClosed)
            assertEquals(1, source.calls)
        }
    }

    @Test
    fun `readAllBytes cancellation waits for the source borrow and stops before another read`() {
        val source = HeldCollectSource()
        val loop: EventLoop = PlatformEventLoop()
        loop.run suspend {
            scope ->
            val returned = AtomicBoolean(false)
            val reading =
                scope.launch suspend {
                    try {
                        source.readAllBytes();
                        fail(Some("cancelled collection completed"))
                    }
                    catch (_: CancellationException) {
                        returned.store(true)
                    }
                }
            source.started.await()
            try {
                reading.cancel()
                assertFalse(returned.load() || reading.isCompleted)
                assertFalse(source.buffer!!.isClosed)
                assertFailsWith<IllegalStateException> { source.buffer!!.clear() }
                source.release.signal()
                reading.join()
                assertTrue(returned.load())
                assertTrue(source.buffer!!.isClosed)
                assertEquals(1, source.calls)
            } finally {
                source.release.signal()
            }
        }
    }
}

private class ObservedCollectSource(val inner: ShortSource): AsyncByteSource, AsyncCloseable {
    var buffer: NativeByteBuffer? = None
    var closes: Int = 0
    public override suspend fun readInto(target: NativeByteBuffer, count: Long): Long {
        buffer = Some(target)
        return inner.readInto(target, count)
    }
    public override suspend fun close() {
        closes += 1
    }
}

private class InvalidCollectSource(val progress: Long): AsyncByteSource {
    var buffer: NativeByteBuffer? = None
    var calls: Int = 0
    public override suspend fun readInto(target: NativeByteBuffer, count: Long): Long {
        buffer = Some(target)
        calls += 1
        return progress
    }
}
