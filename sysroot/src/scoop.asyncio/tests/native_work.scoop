package scoop.asyncio

import scoop.platform.concurrent.Thread
import scoop.test.*

@Test
private class NativeWorkTests {
    @Test
    fun `native work executes on a worker and keeps results until explicit close`() {
        NativeWorkProbe().use {
            probe ->
            assertFailsWith<IllegalStateException> { probe.result() }
            val loop: EventLoop = PlatformEventLoop()
            loop.run suspend {
                _ ->
                @Unsafe
                {
                    loop.runNativeWork(probe.work)
                }
                gcCollect()
                assertEquals(42, probe.result())
                assertEquals(1, probe.foreign)
                assertEquals(1, probe.finished)
                @Unsafe
                {
                    val failure = IllegalArgumentException(Some("result callback"))
                    assertSame(
                        failure,
                        assertFailsWith<IllegalArgumentException> {
                            @Unsafe
                            {
                                probe.work.withResult<Unit> { _ -> throw failure }
                            }
                        }
                    )
                    probe.work.withResult<Unit> {
                        _ ->
                        assertFailsWith<IllegalStateException> { probe.work.close() }
                        assertFailsWith<IllegalStateException> { probe.result() }
                    }
                    try {
                        loop.runNativeWork(probe.work);
                        fail(Some("work ran twice"))
                    }
                    catch (_: IllegalStateException) {}
                }
                assertEquals(42, probe.result())
            }
            assertEquals(0, probe.released)
            probe.work.close()
            probe.work.close()
            assertEquals(1, probe.released)
            assertTrue(probe.work.isClosed)
            assertFailsWith<IllegalStateException> { probe.result() }
        }
    }

    @Test
    fun `work can close unused and preflight failures do not consume it`() {
        NativeWorkProbe().use {
            probe ->
            probe.work.close()
            assertEquals(0, probe.started)
            assertEquals(1, probe.released)
        }
        NativeWorkProbe().use {
            probe ->
            val loop: EventLoop = PlatformEventLoop()
            val other: EventLoop = PlatformEventLoop()
            loop.run suspend {
                scope ->
                @Unsafe
                {
                    try {
                        other.runNativeWork(probe.work);
                        fail(Some("wrong loop accepted"))
                    }
                    catch (_: IllegalStateException) {}
                }
                val cancelled =
                    scope.launch suspend {
                        currentJobOrNone()!!.cancel()
                        @Unsafe
                        {
                            try {
                                loop.runNativeWork(probe.work);
                                fail(Some("cancelled job accepted"))
                            }
                            catch (_: CancellationException) {}
                        }
                    }
                cancelled.join()
                assertEquals(0, probe.started)
                @Unsafe
                {
                    loop.runNativeWork(probe.work)
                }
                assertEquals(42, probe.result())
            }
        }
    }

    @Test
    fun `queued cancellation never calls execute and retains one release obligation`() {
        NativeWorkProbe().use {
            probe ->
            val backend = PlatformEventLoop()
            val loop: EventLoop = backend
            loop.run suspend {
                scope ->
                val fence = WorkFence(backend)
                fence.start()
                fence.waitStarted()
                try {
                    val child =
                        scope.launch suspend {
                            @Unsafe
                            {
                                loop.runNativeWork(probe.work)
                            }
                        }
                    backend.state.post { child.cancel() }
                    child.join()
                    assertTrue(child.isCancelled)
                    assertEquals(0, probe.started)
                    assertEquals(0, probe.released)
                    assertFailsWith<IllegalStateException> { probe.result() }
                    @Unsafe
                    {
                        try {
                            loop.runNativeWork(probe.work);
                            fail(Some("cancelled work reused"))
                        }
                        catch (_: IllegalStateException) {}
                    }
                } finally {
                    fence.close()
                }
            }
            probe.work.close()
            assertEquals(1, probe.released)
        }
    }

    @Test
    fun `running cancellation waits for native completion across threads and moving GC`() {
        NativeWorkProbe(false).use {
            probe ->
            val backend = PlatformEventLoop()
            val loop: EventLoop = backend
            loop.run suspend {
                scope ->
                val returned = AtomicBoolean(false)
                val child =
                    scope.launch suspend {
                        try {
                            @Unsafe
                            {
                                loop.runNativeWork(probe.work)
                            }
                        }
                        catch (_: CancellationException) {
                            returned.store(true)
                        }
                    }
                suspendCoroutine<Unit> {
                    continuation -> backend.state.post { continuation.resume(Unit) }
                }
                probe.waitStarted()
                try {
                    assertFailsWith<IllegalStateException> { probe.work.close() }
                    @Unsafe
                    {
                        try {
                            loop.runNativeWork(probe.work);
                            fail(Some("concurrent work accepted"))
                        }
                        catch (_: IllegalStateException) {}
                    }
                    Thread.start { child.cancel() }.join()
                    assertFalse(returned.load() || child.isCompleted)
                    assertEquals(0, probe.finished)
                    gcCollect()
                    probe.allow()
                    child.join()
                    assertTrue(returned.load())
                    assertEquals(1, probe.finished)
                    assertFailsWith<IllegalStateException> { probe.result() }
                    probe.work.close()
                    assertEquals(1, probe.released)
                } finally {
                    probe.allow()
                }
            }
        }
    }
}
