package scoop.asyncio

import scoop.platform.memory.NativeByteBuffer
import scoop.test.*
import scoop.time.Duration

@Test
private class AsyncSocks5LifecycleTest {
    @Test
    fun `handshake cancellation waits for an actual native borrow before closing`() {
        val script = Socks5Script(socks5SuccessInput())
        script.holdRead = true
        val loop: EventLoop = PlatformEventLoop()
        loop.run suspend {
            scope ->
            val opening =
                scope.launch suspend {
                    AsyncSocks5Tunnel.takeOwnership(script, socks5IpTarget()).close()
                }
            script.readStarted.await()
            try {
                opening.cancel()
                assertFalse(opening.isCompleted)
                assertEquals(0L, script.closes)
                assertFailsWith<IllegalStateException> { script.heldBuffer!!.close() }
                gcCollect()
            } finally {
                script.readRelease.signal()
            }
            opening.join()
            assertTrue(opening.isCancelled)
            assertTrue(script.closed)
            assertTrue(script.heldBuffer!!.isClosed)
            assertEquals(1L, script.position)
            assertEquals(1L, script.closes)
        }
    }

    @Test
    fun `a failed handshake is not reported until owned transport close finishes`() {
        val script = Socks5Script([4, 0])
        script.holdClose = true
        val reported = AtomicBoolean(false)
        val loop: EventLoop = PlatformEventLoop()
        loop.run suspend {
            scope ->
            val opening =
                scope.launch suspend {
                    try {
                        AsyncSocks5Tunnel.takeOwnership(script, socks5IpTarget());
                        fail()
                    }
                    catch (_: Socks5Exception) {
                        reported.store(true)
                    }
                }
            script.closeStarted.await()
            try {
                assertFalse(opening.isCompleted)
                assertFalse(reported.load())
                gcCollect()
            } finally {
                script.closeRelease.signal()
            }
            opening.join()
            assertTrue(reported.load())
            assertTrue(script.closed)
            assertEquals(1L, script.closes)
            assertFalse(scope.job.isCancelled)
        }
    }

    @Test
    fun `a real pending reply cancels and closes the TCP transport before returning`() {
        val loop: EventLoop = PlatformEventLoop()
        loop.run suspend {
            scope ->
            val(_, client, peer) = tcpPair(loop, scope)
            val opening =
                scope.launch suspend {
                    AsyncSocks5Tunnel.takeOwnership(client, socks5IpTarget()).close()
                }
            NativeByteBuffer.allocate(3L).use suspend {
                bytes ->
                peer.readFully(bytes)
                assertSocks5Bytes([5, 1, 0], bytes.readBytes(3L))
                opening.cancel()
                opening.join()
                bytes.clear()
                assertEquals(0L, peer.readInto(bytes, 1L))
            }
            assertTrue(opening.isCancelled)
            assertFalse(scope.job.isCancelled)
        }
    }

    @Test
    fun `coalesced tunnel data remains intact and concurrent close drains a pending read`() {
        val loop: EventLoop = PlatformEventLoop()
        loop.run suspend {
            scope ->
            val(_, client, peer) = tcpPair(loop, scope)
            val opening =
                scope.async<AsyncSocks5Tunnel> suspend {
                    AsyncSocks5Tunnel.takeOwnership(client, socks5IpTarget())
                }
            serveSocks5Ip(peer, [42, 73])
            val tunnel = opening.await()
            NativeByteBuffer.allocate(2L).use suspend {
                bytes ->
                tunnel.readFully(bytes)
                assertSocks5Bytes([42, 73], bytes.readBytes(2L))
                bytes.clear()
                val reading =
                    scope.launch suspend {
                        try {
                            tunnel.readInto(bytes, 1L);
                            fail()
                        }
                        catch (_: IoClosedException) {}
                    }
                loop.sleep(Duration.nanoseconds(1L))
                assertFailsWith<IllegalStateException> { bytes.clear() }
                val first = scope.launch suspend { tunnel.close() }
                val second = scope.launch suspend { tunnel.close() }
                first.join()
                second.join()
                reading.join()
                assertTrue(tunnel.isClosed)
                bytes.clear()
                assertEquals(0L, peer.readInto(bytes, 1L))
            }
            tunnel.close()
        }
    }

    @Test
    fun `loop ownership is checked and cancelled finally can close a returned tunnel`() {
        val script = Socks5Script(socks5SuccessInput())
        val loop: EventLoop = PlatformEventLoop()
        loop.run suspend {
            scope ->
            val tunnel = AsyncSocks5Tunnel.takeOwnership(script, socks5IpTarget())
            val foreign: EventLoop = PlatformEventLoop()
            context(foreign) {
                try {
                    tunnel.flush();
                    fail()
                }
                catch (_: IllegalStateException) {}
            }
            val child =
                scope.launch suspend {
                    try {
                        loop.sleep(Duration.seconds(1000000L))
                    }
                    finally {
                        tunnel.close()
                    }
                }
            loop.sleep(Duration.nanoseconds(1L))
            child.cancel()
            child.join()
            assertTrue(tunnel.isClosed)
            assertEquals(1L, script.closes)
        }
    }
}
