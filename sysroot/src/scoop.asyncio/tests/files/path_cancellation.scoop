package scoop.asyncio

import scoop.platform.fs.*
import scoop.test.*

@Test
private class AsyncPathCancellationTest {
    @Test
    fun `queued path modifications cancel without filesystem effects`() {
        IoTestDirectory().use {
            tree ->
            val source = tree.child("source")
            val destination = tree.child("destination")
            val nested = tree.child("new/a/b")
            source.writeText("source")
            destination.writeText("destination")
            val backend = PlatformEventLoop()
            val loop: EventLoop = backend
            loop.run suspend {
                scope ->
                val fence = WorkFence(backend)
                fence.start()
                fence.waitStarted()
                try {
                    val moving = scope.launch suspend { loop.moveFile(source, destination, true) }
                    backend.state.post { moving.cancel() }
                    moving.join()
                    assertTrue(moving.isCancelled)
                    val deleting = scope.launch suspend { loop.deleteFile(source) }
                    backend.state.post { deleting.cancel() }
                    deleting.join()
                    assertTrue(deleting.isCancelled)
                    val creating = scope.launch suspend { loop.createDirectories(nested) }
                    backend.state.post { creating.cancel() }
                    creating.join()
                    assertTrue(creating.isCancelled)
                    gcCollect()
                } finally {
                    fence.close()
                }
                assertEquals("source", source.readText())
                assertEquals("destination", destination.readText())
                assertFalse(tree.child("new").exists())
            }
        }
    }

    @Test
    fun `late path cancellation retains completed move delete and directory creation`() {
        IoTestDirectory().use {
            tree ->
            val source = tree.child("source")
            val destination = tree.child("destination")
            val directory = tree.child("directory")
            source.writeText("source")
            val backend = PlatformEventLoop()
            val loop: EventLoop = backend
            loop.run suspend {
                scope ->
                val moving = scope.launch suspend { loop.moveFile(source, destination) }
                cancelAfterPathCompletion(backend, moving)
                assertFalse(source.exists())
                assertEquals("source", destination.readText())
                val deleting = scope.launch suspend { loop.deleteFile(destination) }
                cancelAfterPathCompletion(backend, deleting)
                assertFalse(destination.exists())
                val creating = scope.launch suspend { loop.createDirectories(directory) }
                cancelAfterPathCompletion(backend, creating)
                assertTrue(loop.metadata(directory).kind == FileKind.Directory)
            }
        }
    }
}

private suspend fun cancelAfterPathCompletion(loop: PlatformEventLoop, job: Job) {
    val fence = WorkFence(loop)
    fence.start(cancelAfterPriorWork = Some(job))
    try {
        job.join()
        assertTrue(job.isCancelled)
    } finally {
        fence.close()
    }
}
