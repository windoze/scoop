package scoop.asyncio

import scoop.platform.fs.*
import scoop.platform.memory.NativeByteBuffer
import scoop.test.*

@Test
private class AsyncFileControlLifecycleTest {
    @Test
    fun `file controls share the read write sync and close reservation`() {
        IoTestDirectory().use { tree ->
            val path = tree.child("data")
            path.writeText("data")
            val loop: EventLoop = LibuvEventLoop()
            loop.run suspend { scope ->
                val file = loop.openFile(path, OpenOptions(write = true))
                val querying = scope.launch suspend {
                    try { file.metadata(); fail(Some("close lost before metadata delivery")) }
                    catch (_: IoClosedException) {}
                }
                try { file.seek(1L); fail(Some("concurrent seek accepted")) }
                catch (_: IllegalStateException) {}
                try { file.position(); fail(Some("concurrent position accepted")) }
                catch (_: IllegalStateException) {}
                try { file.truncate(1L); fail(Some("concurrent truncate accepted")) }
                catch (_: IllegalStateException) {}
                try { file.size(); fail(Some("concurrent metadata accepted")) }
                catch (_: IllegalStateException) {}
                try { file.syncAll(); fail(Some("concurrent sync accepted")) }
                catch (_: IllegalStateException) {}
                NativeByteBuffer.allocate(1L).use suspend { bytes ->
                    try { file.readInto(bytes, 1L); fail(Some("concurrent read accepted")) }
                    catch (_: IllegalStateException) {}
                    assertEquals(0L, bytes.writePosition)
                }
                val first = scope.launch suspend { file.close() }
                val second = scope.launch suspend { file.close() }
                first.join()
                second.join()
                querying.join()
                try { file.metadata(); fail(Some("closed metadata accepted")) }
                catch (_: IoClosedException) {}
                try { file.seek(0L); fail(Some("closed seek accepted")) }
                catch (_: IoClosedException) {}
                try { file.truncate(0L); fail(Some("closed truncate accepted")) }
                catch (_: IoClosedException) {}
                assertEquals(4L, path.metadata().size)
            }
        }
    }

    @Test
    fun `queued controls cancel without changing offset size or touching paths`() {
        IoTestDirectory().use { tree ->
            val path = tree.child("data")
            path.writeText("data")
            val backend = LibuvEventLoop()
            val loop: EventLoop = backend
            loop.run suspend { scope ->
                val file = loop.openFile(path, OpenOptions(write = true))
                file.seek(1L)
                val fence = WorkFence(backend)
                fence.start()
                fence.waitStarted()
                try {
                    val seeking = scope.launch suspend { file.seek(3L) }
                    backend.state.post { seeking.cancel() }
                    seeking.join()
                    assertTrue(seeking.isCancelled)
                    val truncating = scope.launch suspend { file.truncate(1L) }
                    backend.state.post { truncating.cancel() }
                    truncating.join()
                    assertTrue(truncating.isCancelled)
                    val querying = scope.launch suspend { file.metadata() }
                    backend.state.post { querying.cancel() }
                    querying.join()
                    assertTrue(querying.isCancelled)
                    val missing = scope.launch suspend { loop.metadata(tree.child("missing")) }
                    backend.state.post { missing.cancel() }
                    missing.join()
                    assertTrue(missing.isCancelled)
                    gcCollect()
                } finally { fence.close() }
                assertEquals(1L, file.position())
                assertEquals(4L, file.size())
                file.close()
            }
        }
    }
}
