package scoop.asyncio

import scoop.platform.fs.*
import scoop.platform.system.*
import scoop.test.*

@Test
private class AsyncDirectoryReadTest {
    @Test
    fun `directory entries preserve raw names links and independent snapshots`() {
        IoTestDirectory().use {
            tree ->
            val raw: Array<Byte> = [100, -1, 32, 110]
            val name =
                if (operatingSystem == OperatingSystem.Linux)
                    OsString.fromByteArray(raw)
                else
                    OsString.fromString("目录 空格")
            tree.path.resolve(Path.fromOsString(name)).writeText("data")
            tree.child("subdirectory").createDirectory()
            tree.child("link").createSymbolicLink(tree.child("missing"))
            val loop: EventLoop = PlatformEventLoop()
            loop.run suspend {
                _ ->
                val directory = loop.openDirectory(tree.path)
                val entries = collectDirectoryEntries(directory)
                assertEquals(3L, entries.size)
                assertTrue(hasDirectoryName(entries, name))
                assertTrue(hasDirectoryName(entries, OsString.fromString("subdirectory")))
                assertTrue(hasDirectoryName(entries, OsString.fromString("link")))
                gcCollect()
                for (entry in entries)
                    assertEquals(tree.path.resolve(Path.fromOsString(entry.name)), entry.path)
                assertDirectoryEnd(directory.next())
                directory.close()
                assertDirectoryEnd(directory.next())
                assertTrue(
                    loop.metadata(tree.child("link"), followLinks = false).kind ==
                        FileKind.SymbolicLink
                )
            }
        }
    }

    @Test
    fun `empty enumeration remembers EOF and open failures preserve path errno`() {
        IoTestDirectory().use {
            tree ->
            val empty = tree.child("empty")
            empty.createDirectory()
            val file = tree.child("file")
            file.writeText("file")
            val missing = tree.child("missing")
            val loop: EventLoop = PlatformEventLoop()
            loop.run suspend {
                _ ->
                loop.openDirectory(empty).useAsync suspend {
                    directory ->
                    assertDirectoryEnd(directory.next())
                    assertDirectoryEnd(directory.next())
                }
                try {
                    loop.openDirectory(missing);
                    fail(Some("missing directory opened"))
                }
                catch (error: PlatformException) {
                    assertTrue(error.kind == PlatformErrorKind.NotFound)
                    assertTrue(error.nativeError!!.domain == NativeErrorDomain.PosixErrno)
                    assertEquals(missing.toOsString(), error.context!!)
                }
                try {
                    loop.openDirectory(file);
                    fail(Some("ordinary file opened as directory"))
                }
                catch (error: PlatformException) {
                    assertTrue(error.kind == PlatformErrorKind.NotDirectory)
                    assertEquals(file.toOsString(), error.context!!)
                }
            }
        }
    }
}

internal suspend fun collectDirectoryEntries(directory: AsyncDirectoryEntries): ArrayList<
    DirectoryEntry
> {
    val entries = ArrayList<DirectoryEntry>()
    while (true) {
        when (directory.next()) {
            case None -> return entries
            case Some(entry) -> entries.add(entry)
        }
    }
}

internal fun assertDirectoryEnd(entry: DirectoryEntry?) {
    when (entry) {
        case None -> {};
        case Some(_) -> fail(Some("expected directory EOF"))
    }
}

private fun hasDirectoryName(entries: List<DirectoryEntry>, name: OsString): Boolean {
    for (entry in entries)
        if (entry.name == name)
            return true
    return false
}
