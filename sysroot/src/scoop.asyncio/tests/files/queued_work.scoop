package scoop.asyncio

import scoop.platform.fs.*
import scoop.platform.memory.NativeByteBuffer
import scoop.platform.system.OsString
import scoop.test.*

@Test
private class AsyncFileQueuedWorkTest {
    @Test
    fun `queued file operations and DNS cancel without using input storage or acquiring a file`() {
        IoTestDirectory().use { tree ->
            val existing = tree.child("existing")
            val missing = tree.child("not-created")
            existing.writeText("data")
            val backend = LibuvEventLoop()
            val loop: EventLoop = backend
            loop.run suspend { scope ->
                val file = loop.openFile(existing)
                val fence = WorkFence(backend)
                fence.start()
                fence.waitStarted()
                try {
                    NativeByteBuffer.allocate(4L).use suspend { bytes ->
                        val reading = scope.launch suspend { file.readInto(bytes, 4L) }
                        backend.state.post { reading.cancel() }
                        reading.join()
                        assertTrue(reading.isCancelled)
                        assertEquals(0L, bytes.writePosition)
                        bytes.clear()
                    }
                    val opening = scope.launch suspend { loop.openFile(missing, OpenOptions(write = true, createNew = true)) }
                    backend.state.post { opening.cancel() }
                    opening.join()
                    assertFalse(missing.exists())
                    val resolving = scope.launch suspend { loop.resolve(OsString.fromString("127.0.0.1"), 42) }
                    backend.state.post { resolving.cancel() }
                    resolving.join()
                    assertTrue(resolving.isCancelled)
                    gcCollect()
                } finally { fence.close() }
                NativeByteBuffer.allocate(4L).use suspend { bytes ->
                    file.readFully(bytes)
                    assertEquals("data", OsString.fromByteArray(bytes.readBytes(4L)).decodeUtf8())
                }
                file.close()
            }
        }
    }
}
