package scoop.asyncio

import scoop.platform.fs.*
import scoop.platform.system.OsString
import scoop.test.*

@Test
private class AsyncFileQueuedWorkTest {
    @Test
    fun `queued open and DNS cancel without acquiring a file or resolving`() {
        IoTestDirectory().use {
            tree ->
            val missing = tree.child("not-created")
            val backend = PlatformEventLoop()
            val loop: EventLoop = backend
            loop.run suspend {
                scope ->
                val fence = WorkFence(backend)
                fence.start()
                fence.waitStarted()
                try {
                    val opening =
                        scope.launch suspend {
                            loop.openFile(missing, OpenOptions(write = true, createNew = true))
                        }
                    backend.state.post { opening.cancel() }
                    opening.join()
                    assertFalse(missing.exists())
                    val resolving =
                        scope.launch suspend { loop.resolve(OsString.fromString("127.0.0.1"), 42) }
                    backend.state.post { resolving.cancel() }
                    resolving.join()
                    assertTrue(resolving.isCancelled)
                    gcCollect()
                } finally {
                    fence.close()
                }
            }
        }
    }
}
