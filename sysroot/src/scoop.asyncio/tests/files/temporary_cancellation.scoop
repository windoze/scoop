package scoop.asyncio

import scoop.platform.concurrent.yield
import scoop.platform.fs.*
import scoop.platform.system.*
import scoop.platform.time.*
import scoop.time.Duration
import scoop.test.*

@Test
private class AsyncTemporaryFileCancellationTest {
    @Test
    fun `queued temporary creation cancels before acquiring a path or handle`() {
        IoTestDirectory().use {
            tree ->
            val backend = PlatformEventLoop()
            val loop: EventLoop = backend
            loop.run suspend {
                scope ->
                val fence = WorkFence(backend)
                fence.start()
                fence.waitStarted()
                try {
                    val creating = scope.launch suspend { loop.createTempFile(Some(tree.path)) }
                    backend.state.post { creating.cancel() }
                    creating.join()
                    assertTrue(creating.isCancelled)
                    assertTrue(firstTemporaryPath(tree.path) == None)
                    gcCollect()
                } finally {
                    fence.close()
                }
            }
        }
    }

    @Test
    fun `late cancellation closes and deletes the unreturned temporary file`() {
        IoTestDirectory().use {
            tree ->
            val backend = PlatformEventLoop()
            val loop: EventLoop = backend
            val observed = ObservedTemporary()
            loop.run suspend {
                scope ->
                val creating = scope.launch suspend { loop.createTempFile(Some(tree.path)) }
                backend.state.post {
                    observed.path = Some(awaitTemporaryFile(tree.path))
                    gcCollect()
                    creating.cancel()
                }
                creating.join()
                assertTrue(creating.isCancelled)
                assertFalse(observed.path!!.exists())
                assertTrue(firstTemporaryPath(tree.path) == None)
            }
        }
    }

    @Test
    fun `temporary cleanup failures retain cancellation and the native delete error`() {
        IoTestDirectory().use {
            tree ->
            val directory = tree.child("creating")
            directory.createDirectory()
            val moved = tree.child("moved")
            val backend = PlatformEventLoop()
            val loop: EventLoop = backend
            val observed = ObservedTemporary()
            loop.run suspend {
                scope ->
                val creating =
                    scope.launch suspend {
                        try {
                            loop.createTempFile(Some(directory));
                            fail(Some("cancelled temporary file returned"))
                        }
                        catch (error: ResourceUseException) {
                            assertTrue(error.primaryFailure is CancellationException)
                            assertTrue(error.cleanupFailure is PlatformException)
                            val failure = error.cleanupFailure as PlatformException
                            assertTrue(failure.nativeError!!.domain == testFileErrorDomain())
                            assertEquals(observed.path!!.toOsString(), failure.context!!)
                            observed.cleanupFailed = true
                        }
                    }
                backend.state.post {
                    val path = awaitTemporaryFile(directory)
                    observed.path = Some(path)
                    path.moveTo(moved)
                    path.createDirectory()
                    path.resolve(Path.fromString("child")).writeText("nonempty")
                    creating.cancel()
                }
                creating.join()
                assertTrue(creating.isCancelled)
                assertTrue(observed.cleanupFailed)
                assertTrue(moved.exists())
                assertTrue(observed.path!!.exists())
            }
        }
    }
}

private class ObservedTemporary {
    var path: Path? = None
    var cleanupFailed: Boolean = false
}

private fun firstTemporaryPath(directory: Path): Path? =
    directory.entries().use {
        entries -> when (entries.next()) {
            case None -> None
            case Some(entry) -> Some(entry.path)
        }
    }

private fun awaitTemporaryFile(directory: Path): Path {
    val start = MonotonicTimeSource.markNow()
    while (true) {
        when (firstTemporaryPath(directory)) {
            case Some(path) -> return path;
            case None -> {}
        }
        assertTrue(
            start.elapsedNow() < Duration.seconds(10L),
            Some("temporary creation did not execute")
        )
        yield()
    }
}
