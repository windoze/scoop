package scoop.asyncio.tests.consumer.tcp_deadlines

import scoop.test.*
import scoop.asyncio.*
import scoop.platform.concurrent.Thread
import scoop.platform.io.*
import scoop.platform.memory.NativeByteBuffer
import scoop.platform.net.*
import scoop.platform.net.TcpListener
import scoop.platform.system.OsString
import scoop.time.Duration

private fun check(value: Boolean) {
    if (!value)
        throw IllegalStateException(Some("TCP deadline integration check failed"))
}

private fun serve(listener: TcpListener) {
    listener.accept().use {
        peer -> NativeByteBuffer.allocate(2L).use {
            bytes ->
            peer.readFully(bytes)
            val first = bytes.readByte()
            val second = bytes.readByte()
            bytes.clear();
            bytes.writeByte(second);
            bytes.writeByte(first)
            peer.writeFully(bytes);
            peer.shutdownOutput()
            bytes.clear();
            check(peer.readInto(bytes, 1L) == 0L)
        }
    }
}

private suspend fun rejectDeadlines(loop: EventLoop, host: OsString, port: Int) {
    try {
        loop.connectTcp(host, port, TcpConnectOptions(resolveTimeout = Some(Duration.ZERO)))
        throw IllegalStateException(Some("zero resolution deadline connected"))
    } catch (error: TcpConnectException) {
        check(error.host == host && error.port == port && error.attempts.size == 0L)
        check(error.resolutionFailures.size == 2L)
        for (failure in error.resolutionFailures) {
            val timeout = failure.cause as TcpResolutionTimeoutException
            check(timeout.host == host && timeout.port == port && timeout.family == failure.family)
            check(timeout.limit == Duration.ZERO && timeout.elapsed >= Duration.ZERO)
        }
    }
    try {
        loop.connectTcp(host, port, TcpConnectOptions(connectTimeout = Some(Duration.ZERO)))
        throw IllegalStateException(Some("zero connection deadline connected"))
    } catch (error: TcpConnectTimeoutException) {
        check(error.host == host && error.port == port && error.attempts.size == 0L)
        check(error.limit == Duration.ZERO && error.elapsed >= Duration.ZERO)
    }
}

private fun exercise(ip: IpAddress, host: OsString) {
    TcpListener.bind(SocketAddress(ip, 0)).use {
        listener ->
        val address = listener.localAddress()
        Thread.start { serve(listener) }.use {
            server ->
            val loop: EventLoop = PlatformEventLoop()
            loop.run suspend {
                scope ->
                rejectDeadlines(loop, host, address.port)
                check(!scope.job.isCancelled)
                val long = Some(Duration.seconds(3600L))
                loop.connectTcp(
                    host,
                    address.port,
                    TcpConnectOptions(resolveTimeout = long, connectTimeout = long)
                ).useAsync suspend {
                    client ->
                    check(client.peerAddress == address)
                    NativeByteBuffer.allocate(2L).use suspend {
                        bytes ->
                        bytes.writeByte(42);
                        bytes.writeByte(7)
                        client.writeFully(bytes);
                        client.shutdownOutput()
                        bytes.clear();
                        client.readFully(bytes)
                        check(bytes.readByte() == 7.toByte() && bytes.readByte() == 42.toByte())
                        bytes.clear();
                        check(client.readInto(bytes, 1L) == 0L)
                    }
                }
                check(!scope.job.isCancelled)
            }
            server.join()
        }
    }
}

private fun exerciseConsumer() {
    Thread.start { exercise(IpAddress.IPV4_LOOPBACK, OsString.fromString("localhost")) }.use {
        first ->
        // libc is not required to synthesize an IPv6 address for localhost.
        Thread.start { exercise(IpAddress.IPV6_LOOPBACK, OsString.fromString("::1")) }.use {
            second ->
            first.join();
            second.join()
        }
    }
}

@Test
private class ConsumerTests {
    @Test
    fun behavior() {
        exerciseConsumer()
    }
}
