package scoop.asyncio.tests.consumer.directory

import scoop.test.*
import scoop.platform.fs.*
import scoop.asyncio.*
import scoop.platform.concurrent.Thread
import scoop.platform.fs.*
import scoop.platform.memory.NativeByteBuffer

private fun check(value: Boolean) {
    if (!value)
        throw IllegalStateException(Some("asynchronous directory check failed"))
}

private suspend fun scan(loop: EventLoop, path: Path): ArrayList<Path> {
    return loop.openDirectory(path).useAsync suspend {
        directory ->
        val paths = ArrayList<Path>()
        var sum = 0L
        while (true) {
            when (directory.next()) {
                case None -> break
                case Some(entry) -> {
                    check(entry.path == path.resolve(Path.fromOsString(entry.name)))
                    check(loop.metadata(entry.path).size == 1L)
                    val bytes =
                        loop.openFile(entry.path).useAsync suspend { file -> file.readAllBytes() }
                    check(bytes.size == 1L)
                    sum += bytes[0L].toLong()
                    paths.add(entry.path)
                    gcCollect()
                }
            }
        }
        check(paths.size == 8L && sum == 28L)
        when (directory.next()) {
            case None -> {};
            case Some(_) -> check(false)
        }
        paths
    }
}

private fun exercise(parent: Path) {
    val directory = createTempDirectory(Some(parent), "scoop-directory-")
    try {
        val loop: EventLoop = PlatformEventLoop()
        loop.run suspend {
            _ ->
            for (index in 0L ..< 8L) {
                loop.createTempFile(Some(directory), "条目 ").useAsync suspend {
                    temporary -> NativeByteBuffer.allocate(1L).use suspend {
                        bytes ->
                        bytes.writeByte(index.toByte())
                        temporary.file.writeFully(bytes)
                    }
                }
            }
            val paths = scan(loop, directory)
            for (path in paths)
                loop.deleteFile(path)
            loop.openDirectory(directory).useAsync suspend {
                entries -> when (entries.next()) {
                    case None -> {};
                    case Some(_) -> check(false)
                }
            }
        }
    } finally {
        directory.deleteRecursively()
    }
}

private fun exerciseConsumer(args: Array<String>) {
    check(args.size == 2L)
    val directory = Path.fromString(args[1L])
    Thread.start { exercise(directory) }.use {
        first -> Thread.start { exercise(directory) }.use {
            second ->
            first.join()
            second.join()
        }
    }
}

@Test
private class ConsumerTests {
    @Test
    fun run() {
        val directory = createTempDirectory(prefix = "scoop-consumer-")
        try {
            exerciseConsumer(["consumer", directory.decodeUtf8()])
        }
        finally {
            directory.deleteRecursively()
        }
    }
}
