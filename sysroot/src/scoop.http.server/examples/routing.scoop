//! dep: scoop:scoop.asyncio:0.1.0
//! dep: scoop:scoop.http:0.1.0
//! dep: scoop:scoop.http.server:0.1.0

import scoop.asyncio.*
import scoop.http.HttpField
import scoop.http.server.*

fun main() {
    val routes = RouterBuilder()
    routes.get("/", suspend { _ -> text("Try /api/v1/teams/scoop/users/42") })
    routes.fallback(suspend { _ -> text("Page not found", 404U) })

    routes.group("/api") { api ->
        api.use(suspend { ctx, next ->
            ctx.response.set(HttpField("X-Example".toByteArray(), "nested-routes".toByteArray()))
            next()
        })
        api.fallback(suspend { _ -> text("API route not found", 404U) })

        api.group("/v1") { v1 ->
            v1.get("/status", suspend { _ -> text("ok") })
            v1.group("/teams/{team}") { team ->
                team.get("/users/{id}", suspend { ctx ->
                    text("team:" + ctx.pathParams.text("team") + ", user:" + ctx.pathParams.text("id"))
                })
            }
        }
    }

    // A built application can be supplied to the same listen factory.
    val application = routes.build()
    val loop: EventLoop = LibuvEventLoop()
    loop.run suspend { scope ->
        HttpServer.listen(application, scope).useAsync suspend { server ->
            println("Listening at http://" + server.localAddress.toString())
            server.awaitTermination()
        }
    }
}
