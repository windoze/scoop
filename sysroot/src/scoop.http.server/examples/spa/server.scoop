//! dep: scoop:scoop.asyncio:0.1.0
//! dep: scoop:scoop.platform:0.1.0
//! dep: scoop:scoop.http.server:0.1.0

import scoop.asyncio.*
import scoop.http.server.*
import scoop.platform.fs.Path

fun main() {
    val root = Path.fromString("public")
    val entry = root.resolve(Path.fromString("index.html"))
    val assets = root.resolve(Path.fromString("assets"))
    val notFound: HttpHandler = suspend { _ -> text("Not Found", 404U) }
    val loop: EventLoop = LibuvEventLoop()

    loop.run suspend { scope ->
        HttpServer.listen(scope) { routes ->
            routes.get("/hello", suspend { _ -> text("Hello, Scoop!") })

            routes.get("/api", notFound)
            routes.group("/api") { api ->
                api.get("/", notFound)
                api.group("/v1") { v1 ->
                    v1.get("/status", suspend { _ -> text("ok") })
                    v1.get("/users/{id}", suspend { ctx ->
                        text("user:" + ctx.pathParams.text("id"))
                    })
                }
                // A group fallback alone would not override the root SPA wildcard.
                api.get("/{*path}", notFound)
            }

            // Missing assets keep their 404 response instead of serving HTML.
            routes.get("/assets", notFound)
            routes.get("/assets/", notFound)
            routes.get("/assets/{*path}", staticFiles(assets))

            // The terminal wildcard does not match an empty root suffix.
            routes.get("/", suspend { _ -> file(entry) })
            routes.get("/{*path}", staticFiles(root, StaticFileOptions(
                indexDocument = Some("index.html"),
                fallbackFile = Some(entry)
            )))
        }.useAsync suspend { server ->
            println("Listening at http://" + server.localAddress.toString())
            server.awaitTermination()
        }
    }
}
