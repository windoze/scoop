//! dep: scoop:scoop.asyncio:0.1.0
//! dep: scoop:scoop.http:0.1.0
//! dep: scoop:scoop.http.server:0.1.0

import scoop.asyncio.*
import scoop.http.SseMessage
import scoop.http.server.*
import scoop.time.Duration

fun main() {
    val loop: EventLoop = PlatformEventLoop()
    loop.run suspend {
        scope -> HttpServer.listen(scope) {
            routes ->
            routes.get("/", suspend { _ -> text("Use curl -N http://127.0.0.1:8080/events") })
            routes.get(
                "/events",
                suspend {
                    _ -> sse(
                        produce =
                            suspend {
                                events -> for (index in 1 .. 5) {
                                    events.send(
                                        SseMessage(
                                            data = Some("tick " + index.toString()),
                                            event = Some("tick"),
                                            id = Some(index.toString())
                                        )
                                    )
                                    if (index < 5)
                                        currentEventLoop().sleep(Duration.seconds(1))
                                }
                            }
                    )
                }
            )
        }.useAsync suspend {
            server ->
            println("Listening at http://" + server.localAddress.toString())
            server.awaitTermination()
        }
    }
}
