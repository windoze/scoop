package scoop.tests.http.server.consumer

import scoop.asyncio.*
import scoop.compression.*
import scoop.compression.asyncio.AsyncDecompressionSource
import scoop.http.*
import scoop.http.asyncio.*
import scoop.http.server.*
import scoop.platform.memory.NativeByteBuffer
import scoop.platform.net.*
import scoop.test.*

@Test
private class HttpServerConsumerTests {
    @Test
    fun `published server composes typed extraction and gzip responses through public APIs`() {
        val routes = RouterBuilder()
        routes.use(responseCompression(ResponseCompressionOptions(minimumBytes = 0L)))
        routes.post(
            "/hello/{id}",
            adapt(
                suspend {
                    ctx ->
                    val query = queryExtractor<ConsumerQuery>()(ctx)
                    val name = jsonExtractor(String.Companion)(ctx)
                    (name, query)
                },
                ::consumerHello
            )
        )
        val loop: EventLoop = PlatformEventLoop()
        loop.run suspend {
            scope ->
            val listener = loop.listenTcp(SocketAddress(IpAddress.IPV4_LOOPBACK, 0))
            val address = listener.localAddress
            HttpServer.takeOwnership(listener, routes.build(), scope).useAsync suspend {
                _ ->
                val stream = loop.connectTcp(address)
                AsyncHttp1Connection.takeOwnershipAsClient(stream, scope).useAsync suspend {
                    client ->
                    val request =
                        HttpRequestHead(
                            HttpVersion.Http11,
                            "POST".toByteArray(),
                            HttpRequestTarget.Http1("/hello/42?count=2".toByteArray()),
                            [
                                HttpField("Host".toByteArray(), "localhost".toByteArray()),
                                HttpField("Accept-Encoding".toByteArray(), "gzip".toByteArray()),
                                HttpField(
                                    "Content-Type".toByteArray(),
                                    "application/json".toByteArray()
                                )
                            ]
                        )
                    val bytes = "\"Ada\"".toByteArray()
                    val writer = client.sendRequest(request, Http1BodyFraming.Length(bytes.size))
                    NativeByteBuffer.allocate(64L).use suspend {
                        buffer ->
                        buffer.writeBytes(bytes)
                        writer.writeFully(buffer)
                        writer.finish()
                        val response = client.receiveResponse()
                        assertEquals(200U, response.head.status)
                        assertEquals(
                            1L,
                            response.head.fields.findAll("Set-Cookie".toByteArray()).size
                        )
                        assertEquals(
                            "gzip",
                            String.fromUtf8(
                                response.head.fields.findAll("Content-Encoding".toByteArray())[
                                    0L
                                ].value
                            )
                        )
                        AsyncDecompressionSource(
                            response.body,
                            DecompressionOptions(CompressionFormat.Gzip)
                        ).useAsync suspend {
                            source ->
                            val body = StringBuilder()
                            while (true) {
                                buffer.clear()
                                val count = source.readInto(buffer, buffer.writableBytes)
                                if (count == 0L)
                                    break
                                body.append(String.fromUtf8(buffer.readBytes(count)))
                            }
                            assertEquals("\"42:Ada:2\"", body.toString())
                        }
                    }
                }
            }
        }
    }
}
