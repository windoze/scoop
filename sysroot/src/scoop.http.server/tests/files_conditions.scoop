package scoop.http.server

import scoop.http.*
import scoop.platform.fs.*
import scoop.test.*

@Test
private class ServerFileConditionTests {
    @Test
    fun `final response validators drive preconditions before ranges and survive metadata only results`() {
        UploadTestDirectory().use { directory ->
            val path = directory.child("data.txt"); path.writeText("abcdef")
            val configure: (HttpContext) -> Unit = { ctx ->
                ctx.response.beforeCommit { draft ->
                    assertEquals("6", String.fromUtf8(draft.fields.findAll("Content-Length".toByteArray())[0L].value))
                    draft.set(HttpEntityTag.parse("\"final\"").toHttpField())
                    draft.set(field("Cache-Control", "max-age=60")); draft.set(field("Vary", "Accept-Encoding"))
                }
            }
            val notModified = fileExchange(path, [field("If-None-Match", "W/\"final\""), field("Range", "bytes=99-")], configure = configure)
            assertEquals(304U, notModified.status); assertEquals("", notModified.text())
            assertEquals("\"final\"", notModified.output.header("ETag"))
            assertEquals("max-age=60", notModified.output.header("Cache-Control"))
            assertTrue(present(RequestHeaders(notModified.output.head!!.fields).getSingle("Last-Modified")))
            for (name in ["Content-Type", "Content-Encoding", "Content-Length", "Content-Range"])
                assertFalse(present(RequestHeaders(notModified.output.head!!.fields).getSingle(name)))
            val failed = fileExchange(path, [field("If-Match", "\"missing\""), field("If-None-Match", "*")], configure = configure)
            assertEquals(412U, failed.status); assertEquals("0", failed.output.header("Content-Length"))
            assertEquals("\"final\"", failed.output.header("ETag"))
            assertEquals(304U, fileExchange(path, [field("If-None-Match", "*")]).status)
            assertEquals(400U, fileExchange(path, [field("If-None-Match", "bad tag")]).status)
            assertEquals(200U, fileExchange(path, [field("If-Modified-Since", "bad date")]).status)
            val date = fileExchange(path).output.header("Last-Modified")
            assertEquals(304U, fileExchange(path, [field("If-Modified-Since", date)], "HEAD").status)
            assertEquals(500U, fileExchange(path, configure = { ctx -> ctx.response.beforeCommit { draft ->
                draft.add(HttpEntityTag.parse("\"one\"").toHttpField()); draft.add(HttpEntityTag.parse("\"two\"").toHttpField())
            } }).status)
        }
    }

    @Test
    fun `range covers exact open and suffix intervals with explicit full response fallbacks`() {
        UploadTestDirectory().use { directory ->
            val path = directory.child("data"); path.writeText("0123456789")
            for ((range, expected, contentRange) in [("bytes=2-4", "234", "bytes 2-4/10"),
                ("bytes=7-", "789", "bytes 7-9/10"), ("bytes=-3", "789", "bytes 7-9/10"),
                ("bytes=7-999", "789", "bytes 7-9/10"), ("bytes=-100", "0123456789", "bytes 0-9/10")]) {
                val result = fileExchange(path, [field("Range", range)])
                assertEquals(206U, result.status); assertEquals(expected, result.text())
                assertEquals(contentRange, result.output.header("Content-Range"))
                assertEquals(expected.toByteArray().size.toString(), result.output.header("Content-Length"))
            }
            for (range in ["bytes=10-", "bytes=-0"]) {
                val result = fileExchange(path, [field("Range", range)])
                assertEquals(416U, result.status); assertEquals("", result.text())
                assertEquals("bytes */10", result.output.header("Content-Range"))
            }
            for (range in ["items=0-1", "bytes=4-1", "bytes=9223372036854775808-", "bytes=0-1,3-4", "garbage"]) {
                val result = fileExchange(path, [field("Range", range)])
                assertEquals(200U, result.status); assertEquals("0123456789", result.text())
            }
            assertEquals(200U, fileExchange(path, [field("Range", "bytes=0-1"), field("Range", "bytes=3-4")]).status)
            val head = fileExchange(path, [field("Range", "bytes=0-1")], "HEAD")
            assertEquals(200U, head.status); assertEquals("10", head.output.header("Content-Length")); assertEquals("", head.text())
        }
    }

    @Test
    fun `If Range requires a strong exact validator and does not trigger repeat encoding negotiation`() {
        UploadTestDirectory().use { directory ->
            val path = directory.child("data.txt"); path.writeText("abcdef")
            val tag = Some(HttpEntityTag.parse("\"v1\""))
            val options = FileResponseOptions(entityTag = tag)
            val date = fileExchange(path).output.header("Last-Modified")
            for ((condition, expected) in [("\"v1\"", 206U), ("W/\"v1\"", 200U), ("\"v2\"", 200U),
                ("bad", 200U), (date, 200U), ("*", 200U)]) {
                assertEquals(expected, fileExchange(path, [field("Range", "bytes=1-2"), field("If-Range", condition)], options = options).status)
            }
            val strong = FileResponseOptions(entityTag = tag, lastModifiedIsStrong = true)
            assertEquals(206U, fileExchange(path, [field("Range", "bytes=1-2"), field("If-Range", date)], options = strong).status)
            assertEquals(200U, fileExchange(path, [field("Range", "bytes=1-2"),
                field("If-Range", "Fri, 01 Jan 2100 00:00:00 GMT")], options = strong).status)
            assertEquals(200U, fileExchange(path, [field("If-Range", "malformed")]).status)
            val encoded = directory.child("data.gz"); encoded.writeAllBytes(requestGzip("abcdef".toByteArray()))
            val routes = RouterBuilder(); routes.use(responseCompression())
            routes.get("/", suspend { _ -> file(encoded, FileResponseOptions(entityTag = tag, contentEncoding = Some("gzip"))) })
            val result = exercise(routes.build(), fields = [field("Accept-Encoding", "gzip,identity;q=0"), field("If-Match", "\"bad\"")])
            assertEquals(412U, result.status)
        }
    }
}
