package scoop.http.server

import scoop.asyncio.*
import scoop.http.*
import scoop.http.asyncio.AsyncHttp2Connection
import scoop.test.*

@Test
private class ServerCompressionLifecycleTests {
    @Test
    fun `H2 compressed backpressure remains isolated and reset waits for producer cleanup`() {
        val entered = ServerTestGate(); val flushed = AtomicBoolean(false)
        val cleaning = ServerTestGate(); val release = ServerTestGate()
        val completed = ServerTestCompletions(2L)
        val payload = Array<Byte>(32768L) { index -> ((index * index + index * 31L) % 256L).toByte() }
        val routes = RouterBuilder()
        routes.use(responseCompression(ResponseCompressionOptions(minimumBytes = 0L, bufferSize = 7L)))
        routes.get("/slow", suspend { _ -> stream("text/plain", suspend { writer ->
            entered.signal()
            try { writer.writeAll(payload); writer.flush(); flushed.store(true) }
            finally { nonCancellableScope<Unit> suspend { _ -> cleaning.signal(); release.await() } }
        }) })
        routes.get("/fast", suspend { _ -> text("ok") })
        val options = HttpServerOptions(allowCleartextHttp2 = true, http2Limits = Http2Limits(maxPendingBodyBytes = 16L),
            onRequestCompleted = Some(completed::receive))
        withServer(routes.build(), options, suspend { scope, _, address ->
            AsyncHttp2Connection.takeOwnershipAsClient(currentEventLoop().connectTcp(address), scope,
                settings = Http2Settings(initialWindowSize = 16U)).useAsync suspend { client ->
                val slow = client.openRequest(h2ServerRequest("/slow", fields = [field("Accept-Encoding", "gzip")]))
                assertEquals(Some("gzip"), RequestHeaders(slow.receiveResponse().fields).getSingle("Content-Encoding"))
                entered.await()
                assertEquals("ok", h2ServerText(client, "/fast"))
                assertFalse(flushed.load())
                try {
                    slow.close()
                    cleaning.await()
                    for (result in completed.snapshot()) assertEquals("/fast", result.route!!.template)
                } finally { release.signal() }
                completed.ready.await()
                var found = false
                for (result in completed.snapshot()) if (result.route!!.template == "/slow") {
                    found = true
                    assertEquals(HttpRequestOutcome.Cancelled, result.outcome)
                    assertTrue(result.encodedResponseBytes > 0L)
                    assertTrue(result.encodedResponseBytes < payload.size)
                }
                assertTrue(found)
                assertFalse(client.isClosed)
            }
        })
    }
}
