package scoop.http.server

import scoop.test.*

@Test
private class ServerQueryNumberTests {
    @Test
    fun `query integers enforce exact ranges and strict decimal text`() {
        val signed = queryFieldCodec("v", Long.Companion)
        val unsigned = queryFieldCodec("v", ULong.Companion)
        assertEquals(Long.MIN_VALUE, queryInput("v=-9223372036854775808").decode(signed))
        assertEquals(Long.MAX_VALUE, queryInput("v=9223372036854775807").decode(signed))
        assertEquals(ULong.MAX_VALUE, queryInput("v=18446744073709551615").decode(unsigned))
        assertEquals(12L, queryInput("v=+0012").decode(signed))
        assertEquals(0UL, queryInput("v=+00").decode(unsigned))
        for (bad in ["", "+", "-", " 1", "1 ", "1.0", "1e1", "0x10", "1_0", "１２", "9223372036854775808", "-9223372036854775809"])
            expectQueryError("v=" + bad, signed, "/v", "query items 0")
        for (bad in ["-0", "-1", "18446744073709551616"])
            expectQueryError("v=" + bad, unsigned, "/v")
        expectQueryError("v=2147483648", queryFieldCodec("v", Int.Companion), "/v", "query items 0")
        expectQueryError("v=256", queryFieldCodec("v", UByte.Companion), "/v")
        val boolean = queryFieldCodec("v", Boolean.Companion)
        assertTrue(queryInput("v=true").decode(boolean))
        assertFalse(queryInput("v=false").decode(boolean))
        for (bad in ["", "TRUE", "1", "false ", "null"]) expectQueryError("v=" + bad, boolean, "/v")
    }

    @Test
    fun `query floating point uses target precision finite values and decimal grammar`() {
        val single = queryFieldCodec("v", Float.Companion)
        val double = queryFieldCodec("v", Double.Companion)
        assertEquals(1.25, queryInput("v=+1.25").decode(double))
        assertEquals(0.5, queryInput("v=.5").decode(double))
        assertEquals(2.0, queryInput("v=2.").decode(double))
        assertEquals(-125.0, queryInput("v=-1.25e+2").decode(double))
        assertEquals(1.0f.toBits(), queryInput("v=1.000000059604644775390625").decode(single).toBits())
        assertEquals((-0.0).toBits(), queryInput("v=-1e-9999").decode(double).toBits())
        assertEquals((-0.0f).toBits(), queryInput("v=-0").decode(single).toBits())
        for (bad in ["", ".", "NaN", "Infinity", "+Infinity", "-Infinity", "1e", "1e+", "0x1p2", " 1.0", "1.0 ", "1_0", "1,5", "1e309"])
            expectQueryError("v=" + bad, double, "/v", "query items 0")
        expectQueryError("v=3.5e38", single, "/v")
        expectQueryError("v=1.0&v=2.0", double, "/v")
    }
}
