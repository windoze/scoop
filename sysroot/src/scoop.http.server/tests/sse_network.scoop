package scoop.http.server

import scoop.asyncio.*
import scoop.http.*
import scoop.test.*
import scoop.time.Duration

private class SseWriterHolder {
    var value: SseWriter? = None
}

@Test
private class ServerSseNetworkTests {
    @Test
    fun `H1 and H2 flush headers and the first event before the producer finishes`() {
        for (h2 in [false, true]) {
            val send = ServerTestGate();
            val finish = ServerTestGate();
            val finished = AtomicBoolean(false)
            val completed = ServerTestCompletions()
            val routes = RouterBuilder()
            routes.get(
                "/",
                suspend {
                    ctx ->
                    val id = ctx.request.lastEventId
                    sse(
                        produce =
                            suspend {
                                events ->
                                send.await();
                                events.send(SseMessage(Some("first"), id = id))
                                finish.await();
                                finished.store(true)
                            }
                    )
                }
            )
            val expected = "id: resume\ndata: first\n\n"
            val options =
                HttpServerOptions(
                    allowCleartextHttp2 = true,
                    onRequestCompleted = Some(completed::receive)
                )
            withServer(
                routes.build(),
                options,
                suspend {
                    scope, _, address ->
                    val read: suspend (HttpResponseHead, AsyncByteSource) -> Unit =
                        suspend {
                            head, body ->
                            assertEquals(200U, head.status)
                            assertEquals(
                                "text/event-stream; charset=utf-8",
                                RequestHeaders(head.fields).getSingle("Content-Type")!!
                            )
                            assertEquals(
                                "no-cache",
                                RequestHeaders(head.fields).getSingle("Cache-Control")!!
                            )
                            assertEquals(None, parseHttpContentLength(head.fields))
                            send.signal()
                            assertEquals(expected, readNetworkText(body, expected.byteLength))
                            assertFalse(finished.load())
                            finish.signal()
                            assertEquals("", networkText(body))
                        }
                    if (h2)
                        h2ServerClient(address, scope).useAsync suspend {
                            client ->
                            val stream =
                                client.openRequest(
                                    h2ServerRequest(fields = [field("Last-Event-ID", "resume")])
                                )
                            read(stream.receiveResponse(), stream)
                        }
                    else
                        networkClient(address, scope).useAsync suspend {
                            client ->
                            client.sendRequest(
                                networkRequest(fields = [field("Last-Event-ID", "resume")])
                            ).finish()
                            val response = client.receiveResponse()
                            read(response.head, response.body)
                        }
                    completed.ready.await()
                    assertEquals(HttpRequestOutcome.Completed, completed.snapshot()[0L].outcome)
                }
            )
        }
    }

    @Test
    fun `batching is explicit and a writer cannot escape its producer`() {
        val output = TestOutput();
        val escaped = SseWriterHolder()
        val routes = RouterBuilder()
        routes.get(
            "/",
            suspend {
                _ -> sse(
                    produce =
                        suspend {
                            events ->
                            escaped.value = Some(events)
                            assertEquals(1, output.flushes)
                            events.send(SseMessage(Some("one")), false)
                            events.comment("batch", false)
                            assertEquals(1, output.flushes)
                            events.flush()
                            assertEquals(2, output.flushes)
                            events.send(SseMessage(Some("two")))
                            assertEquals(3, output.flushes)
                        }
                )
            }
        )
        val response = exercise(routes.build(), output = output)
        assertEquals("data: one\n\n: batch\n\ndata: two\n\n", response.text())
        assertEquals(1, output.finishes)
        val loop: EventLoop = PlatformEventLoop()
        loop.run suspend {
            _ ->
            var rejected = false
            try {
                escaped.value!!.comment("late")
            }
            catch (_: IllegalStateException) {
                rejected = true
            }
            assertTrue(rejected)
        }
    }

    @Test
    fun `HEAD skips events and heartbeats and resume identifiers are strict single fields`() {
        expectArgument { SseOptions(Some(Duration.ZERO)) }
        expectArgument { SseOptions(Some(Duration.milliseconds(-1))) }
        val invoked = TestCounter()
        val routes = RouterBuilder()
        routes.get(
            "/",
            suspend {
                ctx ->
                val id = ctx.request.lastEventId
                sse(
                    SseOptions(Some(Duration.milliseconds(1))),
                    suspend {
                        events ->
                        invoked.value += 1
                        events.send(SseMessage(Some(id ?: "absent")))
                    }
                )
            }
        )
        val app = routes.build()
        val head = exercise(app, method = "HEAD")
        assertEquals(200U, head.status)
        assertEquals("", head.text())
        assertEquals(0, invoked.value)
        assertEquals("data: absent\n\n", exercise(app).text())
        assertEquals("data: \n\n", exercise(app, fields = [field("Last-Event-ID", "")]).text())
        assertEquals(
            400U,
            exercise(
                app,
                fields = [field("Last-Event-ID", "one"), field("Last-Event-ID", "two")]
            ).status
        )
        assertEquals(
            400U,
            exercise(
                app,
                fields = [HttpField("Last-Event-ID".toByteArray(), [(-1).toByte()])]
            ).status
        )
    }
}
