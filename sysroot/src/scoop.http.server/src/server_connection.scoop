package scoop.http.server

import scoop.asyncio.*
import scoop.http.*
import scoop.http.asyncio.*
import scoop.tls.asyncio.AsyncTlsStream

internal suspend fun runServerConnection(state: ServerState, entry: ServerConnection) {
    try {
        coroutineScope<Unit> suspend { scope ->
            val stop = state.lock.withLock {
                entry.job = Some(scope.job)
                state.phase != ServerPhase.Running
            }
            if (stop) { scope.job.cancel(); scope.job.ensureActive() }
            if (present(state.options.tls)) {
                val tls = serverDeadline<AsyncTlsStream>(state.options.tlsHandshakeTimeout, "TLS handshake", suspend {
                    AsyncTlsStream.takeOwnershipAsServer(entry.transport, state.options.tls!!)
                })
                var failure: Throwable? = None
                try {
                    val info = tls.connectionInfo
                    val alpn: List<Byte>? = when (info.alpn) { case None -> None; case Some(value) -> Some(value) }
                    selectHttpAlpn(alpn, [HttpProtocol.Http1], state.options.allowHttp1Fallback)
                    entry.info = HttpConnectionInfo(entry.transport.localAddress, entry.transport.peerAddress, HttpProtocol.Http1, Some(info))
                    serveHttp1(state, entry, tls, scope)
                } catch (error: Throwable) { failure = Some(error); throw error }
                finally { closeServerResource(state, tls, failure) }
            } else serveHttp1(state, entry, entry.transport, scope)
        }
    } catch (error: Throwable) {
        if (!(error is CancellationException)) observeConnectionFailure(state, entry.info, error)
    } finally {
        try { entry.transport.close() }
        catch (error: Throwable) { observeConnectionFailure(state, entry.info, error); state.recordFailure(error) }
        state.unregister(entry)
    }
}

private fun observeConnectionFailure(state: ServerState, info: HttpConnectionInfo, error: Throwable) {
    if (!present(state.options.onConnectionError)) return
    try { state.options.onConnectionError!!(info, error) }
    catch (_: Throwable) { return }
}

private suspend fun <T> serveHttp1(state: ServerState, entry: ServerConnection, transport: T, scope: CoroutineScope)
    where T : AsyncByteStream, T : AsyncCloseable {
    val options = state.options
    val connection = AsyncHttp1Connection.takeOwnershipAsServer(transport, scope,
        options.http1Receive, options.http1Limits, HttpIoTimeoutOptions(options.bodyReadIdle, options.responseWriteIdle))
    var failure: Throwable? = None
    try {
        var first = true
        while (state.running() && !connection.isClosed) {
            val timeout = if (first) options.firstRequestHeadTimeout else options.keepAliveIdleTimeout
            val incoming = serverDeadline<Http1IncomingRequest?>(timeout, "HTTP/1 request head", suspend { connection.receiveRequest() })
            first = false
            if (!present(incoming)) break
            val requestId = state.beginRequest(entry)
            if (!present(requestId)) break
            try { executeHttp1Request(state, entry, connection, incoming!!, requestId!!) }
            finally { state.endRequest(entry) }
            if (!connection.isReusable) break
        }
    } catch (error: Throwable) { failure = Some(error); throw error }
    finally { closeServerResource(state, connection, failure) }
}

private suspend fun closeServerResource(state: ServerState, resource: AsyncCloseable, primary: Throwable?) {
    try { resource.close() }
    catch (cleanup: Throwable) {
        state.recordFailure(cleanup)
        if (present(primary)) throw ResourceUseException(primary!!, cleanup)
        throw cleanup
    }
}
