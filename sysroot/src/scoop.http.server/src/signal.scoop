package scoop.http.server

// Coalesces changes for one waiter; resumes outside the state lock.
internal class ServerSignal {
    private val lock: ServerLock = ServerLock()
    private var changed: Boolean = false
    private var waiting: CancellableContinuation<Unit>? = None

    fun signal() {
        val waiter = lock.withLock {
            val result = waiting
            waiting = None
            if (!present(result)) changed = true
            result
        }
        if (present(waiter)) waiter!!.tryResume(Unit)
    }

    suspend fun await() {
        suspendCancellableCoroutine<Unit> { waiter ->
            val ready = lock.withLock {
                if (changed) { changed = false; true } else { waiting = Some(waiter); false }
            }
            waiter.invokeOnCancellation { _ ->
                lock.withLock { if (present(waiting) && waiting!! === waiter) waiting = None; Unit }
            }
            if (ready) waiter.tryResume(Unit)
        }
    }
}
