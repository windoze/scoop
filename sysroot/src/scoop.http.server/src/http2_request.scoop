package scoop.http.server

import scoop.http.asyncio.Http2IncomingRequest
import scoop.platform.time.MonotonicTimeSource

internal suspend fun executeHttp2Request(state: ServerState, entry: ServerConnection, activity: ServerHttp2,
    incoming: Http2IncomingRequest, requestId: String) {
    val started = MonotonicTimeSource.markNow()
    val result = RequestExecution()
    try {
        val output = Http2ResponseOutput(incoming.stream, incoming.head.method)
        val expectations = RequestExpectations(incoming.head.fields)
        val source = Http2RequestInput(incoming.stream, output, expectations)
        val body = HttpRequestBody(source, state.options.requestBodyLimit, incoming.head.fields, state.options.bufferedBodyLimit)
        val request = HttpRequest(incoming.head, body, expectations)
        coroutineScope<Unit> suspend { requestScope ->
            activity.register(incoming.stream.id, requestScope.job)
            if (present(incoming.stream.failure)) requestScope.job.cancel()
            executeRequestPipeline(state.application, request, output, requestId, entry.info, state.options.requestDeadline, result)
        }
    } catch (error: Throwable) { result.failure = Some(error) }
    finally {
        closeRequestViews(result)
        try {
            if (!incoming.stream.isReadComplete || !incoming.stream.isWriteComplete) incoming.stream.close()
        } catch (cleanup: Throwable) {
            result.failure = Some(if (present(result.failure)) ResourceUseException(result.failure!!, cleanup) else cleanup)
        }
        val cancelledByStream = present(result.context) && result.context!!.requestJob.isCancelled &&
            present(result.failure) && present(incoming.stream.failure) && result.failure!! === incoming.stream.failure!!
        completeServerRequest(state, result, started, cancelledByStream)
        activity.finished(incoming.stream.id)
    }
}
