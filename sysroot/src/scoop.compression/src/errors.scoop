package scoop.compression

import scoop.platform.system.*

/**
 * The codec-level reason for a failed compression or decompression operation.
 */
public enum CompressionFailureKind {
    /**
     * The compressed bytes or framing are invalid.
     */
    InvalidData,
        /**
         * Input ended before the required frame or stream boundary.
         */
        Truncated,
        /**
         * The stream requires a dictionary that was not supplied.
         */
        DictionaryRequired,
        /**
         * The supplied dictionary does not match the stream.
         */
        DictionaryMismatch,
        /**
         * Decoded output would exceed the configured byte limit.
         */
        OutputLimit,
        /**
         * The stream requires a window larger than the configured limit.
         */
        WindowLimit,
        /**
         * A native codec operation failed.
         */
        Backend
}

/**
 * A codec failure retaining format, operation, reason, backend code, and diagnostic detail.
 */
public class CompressionException public constructor(
    /**
     * The operation that failed.
     */
    public val operation: String,
        /**
         * The selected wire format.
         */
        public val format: CompressionFormat,
    /**
     * The portable failure category.
     */
    public val kind: CompressionFailureKind,
        /**
         * The native backend error code.
         */
        public val backendCode: Int,
        /**
         * The diagnostic explanation from the codec.
         */
        public val detail: String
) : Exception(Some(operation + ": " + detail))

internal fun compressionError(kind: Int, code: Int, detail: String, format: CompressionFormat): Throwable {
    if (kind == 8) return IllegalArgumentException(Some(detail))
    if (kind == 9) return PlatformException("allocate compression memory", PlatformErrorKind.NoMemory,
        if (code == 0) None else Some(NativeError(NativeErrorDomain.PosixErrno, code)))
    if (kind == 10) return ArithmeticException()
    return CompressionException("compression codec", format, when (kind) {
        case 1 -> CompressionFailureKind.InvalidData
        case 2 -> CompressionFailureKind.Truncated
        case 3 -> CompressionFailureKind.DictionaryRequired
        case 4 -> CompressionFailureKind.DictionaryMismatch
        case 5 -> CompressionFailureKind.OutputLimit
        case 6 -> CompressionFailureKind.WindowLimit
        else -> CompressionFailureKind.Backend
    }, code, detail)
}

internal fun compressionTrailing(format: CompressionFormat): Nothing =
    throw CompressionException("decompress", format, CompressionFailureKind.InvalidData, 0, "trailing compressed data")

internal fun <T> compressionPresent(value: T?): Boolean = when (value) { case Some(_) -> true; case None -> false }
