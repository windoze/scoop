package scoop.compression.asyncio

import scoop.asyncio.*
import scoop.compression.*

internal suspend fun closeCompression(state: AsyncCompressionOwner) {
    if (state.lock.withLock { state.closed }) return
    val job = requireAsyncCompressionJob(state.loop, false)
    suspendCoroutine<Unit> { continuation ->
        val result: (Boolean, Job?) = state.lock.withLock {
            if (state.closed) (true, None)
            else {
                state.closeWaiters.add(continuation)
                if (!state.closing) { state.closing = true; state.closeJob = Some(job) }
                (false, state.active)
            }
        }
        val (closed, active) = result
        if (closed) continuation.resume(Unit)
        else {
            when (active) { case Some(value) -> value.cancel(); case None -> {} }
            startCompressionClose(state)
        }
    }
}

internal fun startCompressionClose(state: AsyncCompressionOwner) {
    val start = state.lock.withLock {
        if (!state.closing || state.running || state.cleanupStarted) false
        else { state.cleanupStarted = true; true }
    }
    if (!start) return
    val job = state.closeJob!!
    val loop = state.loop
    context(job) { context(loop) {
        startCoroutine<Unit>(suspend {
            var failure = compressionCleanup(None) { state.resources.close() }
            when (state.owner) {
                case Some(owner) -> {
                    try { owner.close() }
                    catch (error: Throwable) { failure = Some(when (failure) {
                        case Some(primary) -> ResourceUseException(primary, error)
                        case None -> error
                    }) }
                }
                case None -> {}
            }
            throwCompressionFailure(failure)
        }, CompressionCloseCompletion(state))
    } }
}

private class CompressionCloseCompletion(val state: AsyncCompressionOwner) : Continuation<Unit> {
    public override fun resume(value: Unit) { finish(None) }
    public override fun resumeWithException(exception: Throwable) { finish(Some(exception)) }

    private fun finish(error: Throwable?) {
        val waiters = state.lock.withLock {
            state.closed = true
            val result = state.closeWaiters.toArray()
            state.closeWaiters.clear()
            result
        }
        for (waiter in waiters) {
            when (error) { case Some(failure) -> waiter.resumeWithException(failure); case None -> waiter.resume(Unit) }
        }
    }
}
