package scoop.compression.asyncio

import scoop.asyncio.*
import scoop.compression.*
import scoop.platform.io.WriteZeroException
import scoop.platform.memory.NativeByteBuffer

internal class AsyncCompressionSinkImpl(
    private val sink: AsyncByteSink, loop: EventLoop, resources: CompressionIoResources, owner: AsyncCloseable?
) : AsyncByteSink, AsyncCloseable {
    private val state: CompressionWriteState = CompressionWriteState(resources)
    private val guard: AsyncCompressionOwner = AsyncCompressionOwner(resources, owner, loop)
    val totals: CompressionTotals get() = state.totals
    val failure: Throwable? get() = guard.failure

    public override suspend fun writeFrom(buffer: NativeByteBuffer, count: Long): Long = guard.operation<Long>(
        { requireCompressionTransfer(count, buffer.readableBytes); state.requireWritable() },
        suspend { if (count == 0L) 0L else writeSome(buffer, count) }
    )

    private suspend fun writeSome(buffer: NativeByteBuffer, count: Long): Long {
        while (true) {
            ensureActive()
            drain()
            val step = state.process(buffer, count)
            drain()
            if (step.consumed > 0L) return step.consumed
        }
    }

    private suspend fun drain() {
        val output = state.buffer
        while (output.readableBytes > 0L) {
            ensureActive()
            val requested = output.readableBytes
            val before = output.readPosition
            val count = try { sink.writeFrom(output, requested) }
            finally { state.recordOutput(output.readPosition - before) }
            requireCompressionProgress(count, requested, output.readPosition - before)
            if (count == 0L) throw WriteZeroException()
        }
        output.clear()
    }

    public override suspend fun flush() {
        guard.operation<Unit>({ Unit }, suspend {
            drain()
            while (true) {
                ensureActive()
                val step = state.flushStep()
                drain()
                if (step.state != CompressionState.NeedOutput) break
            }
            sink.flush()
        })
    }

    suspend fun finish() {
        guard.operation<Unit>({ Unit }, suspend {
            drain()
            while (!state.finished) { ensureActive(); state.finishStep(); drain() }
        })
    }

    public override suspend fun close() { closeCompression(guard) }
}
