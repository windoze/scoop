package scoop.compression

import scoop.asyncio.*
import scoop.bytes.ByteArrayBuilder
import scoop.platform.memory.NativeByteBuffer
import scoop.test.*
import scoop.time.Duration

internal class ShortAsyncCompressionSource(val bytes: Array<Byte>) : AsyncByteSource, AsyncCloseable {
    var position: Long = 0L
    var calls: Int = 0
    var closes: Int = 0
    var failAfter: Long = Long.MAX_VALUE
    val error: Throwable = Throwable()

    public override suspend fun readInto(buffer: NativeByteBuffer, count: Long): Long {
        calls += 1
        currentEventLoop().sleep(Duration.nanoseconds(1L))
        if (position >= failAfter) throw error
        var size = if (count < 2L) count else 2L
        if (size > bytes.size - position) size = bytes.size - position
        buffer.writeBytes(bytes, position, size)
        position += size
        return size
    }

    public override suspend fun close() { closes += 1 }
}

internal class ShortAsyncCompressionSink : AsyncByteSink, AsyncCloseable {
    val bytes: ByteArrayBuilder = ByteArrayBuilder()
    var closes: Int = 0
    var flushes: Int = 0
    var failAfter: Long = Long.MAX_VALUE
    var failAfterProgress: Boolean = false
    var failClose: Boolean = false
    var zero: Boolean = false
    val error: Throwable = Throwable()
    val cleanup: Throwable = Throwable()

    public override suspend fun writeFrom(buffer: NativeByteBuffer, count: Long): Long {
        currentEventLoop().sleep(Duration.nanoseconds(1L))
        if (bytes.size >= failAfter) throw error
        if (zero) return 0L
        val size = if (count < 2L) count else 2L
        bytes.append(buffer.readBytes(size))
        if (failAfterProgress) throw error
        return size
    }

    public override suspend fun flush() { flushes += 1 }
    public override suspend fun close() { closes += 1; if (failClose) throw cleanup }
}

internal suspend fun writeAsyncCompression(sink: AsyncByteSink, bytes: List<Byte>) {
    NativeByteBuffer.allocate(bytes.size).use suspend { input -> input.writeBytes(bytes); sink.writeFully(input) }
}

internal suspend fun readSmallAsyncCompression(source: AsyncByteSource): Array<Byte> {
    val result = ByteArrayBuilder()
    NativeByteBuffer.allocate(3L).use suspend { buffer ->
        while (true) {
            buffer.clear()
            val count = source.readInto(buffer, 1L)
            if (count == 0L) break
            result.append(buffer.readBytes(count))
        }
    }
    return result.toByteArray()
}

internal suspend fun <E : Throwable> expectAsyncCompressionFailure(block: suspend () -> Unit): E {
    try { block() }
    catch (error: Throwable) { if (error is E) return error; throw error }
    fail(Some("expected asynchronous compression failure"))
}
