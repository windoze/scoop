package scoop.terminal.asyncio

import scoop.asyncio.useAsync
import scoop.terminal.*
import scoop.terminal.event.*
import scoop.terminal.protocol.*
import scoop.time.Duration

public suspend fun AsyncTerminalSession.cursorPosition(timeout: Duration = Duration.seconds(1L)): CursorPosition =
    when (query(QueryKind.Cursor, timeout)) {
        case InputItem.CursorPosition(column, row) -> CursorPosition(column, row)
        case _ -> throw IllegalStateException(Some("unexpected cursor query result"))
    }

public suspend fun AsyncTerminalSession.deviceAttributes(kind: DeviceAttributeKind = DeviceAttributeKind.Primary,
    timeout: Duration = Duration.seconds(1L)): Array<Long> =
    when (query(if (kind == DeviceAttributeKind.Primary) QueryKind.Primary else QueryKind.Secondary, timeout)) {
        case InputItem.DeviceAttributes(_, parameters) -> parameters
        case _ -> throw IllegalStateException(Some("unexpected device attributes result"))
    }

public suspend fun AsyncTerminalSession.keyboardEnhancementFlags(
    timeout: Duration = Duration.seconds(1L)): KeyboardEnhancementFlags? = when (query(QueryKind.Keyboard, timeout)) {
    case InputItem.KeyboardFlags(flags) -> Some(flags)
    case InputItem.DeviceAttributes(false, _) -> None
    case _ -> throw IllegalStateException(Some("unexpected keyboard query result"))
}

public suspend fun AsyncTerminalSession.supportsKeyboardEnhancement(timeout: Duration = Duration.seconds(1L)): Boolean =
    keyboardEnhancementFlags(timeout) != None

private suspend fun AsyncTerminalSession.query(kind: QueryKind, timeout: Duration): InputItem {
    if (timeout < Duration.ZERO) throw IllegalArgumentException(Some("negative terminal query timeout"))
    return withAccess(true, true) suspend {
        val scope = RawModeScope(this, true)
        scope.enter()
        scope.useAsync suspend { input.query(tty, kind, timeout) }
    }
}
