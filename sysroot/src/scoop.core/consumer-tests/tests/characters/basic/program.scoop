package test.core.tests.characters.basic

import scoop.test.*
const val snow: Char = '雪'
const val ordered: Boolean = '\uD7FF' < '\uE000'
const val unequal: Boolean = 'A' != 'B'

@NoGC
fun scalarCode(value: Char): Int = value.code

private fun exercise() {
    if (scalarCode(snow) != 38634 || !ordered || !unequal) { fail(Some("const")) }
    if ('A'.code != 65 || '\u{1F680}'.code != 128640 || '\u{10FFFF}'.code != 1114111) {
        fail(Some("literal"))
    }
    if ('\t'.code != 9 || '\b'.code != 8 || '\n'.code != 10 || '\r'.code != 13 ||
        '\''.code != 39 || '\"'.code != 34 || '\\'.code != 92 || '\$'.code != 36 ||
        '\u0000'.code != 0) { fail(Some("escape")) }
    if ('雪' != 38634.toChar() || 'A' >= 'B' || '\u{10FFFF}' <= '雪') {
        fail(Some("comparison"))
    }
    if ('雪'.toString() != "雪" || '\u{1F680}'.toString() != "🚀" ||
        '\u0000'.toString() != "\u0000" || snow.hash() != 38634L) { fail(Some("conversion")) }
    val compare: (Char) -> Long = snow::compareTo
    val equal: (Char) -> Boolean = snow::equals
    if (compare('A') != 1L || compare(snow) != 0L || !equal(snow) || equal('A')) {
        fail(Some("reference"))
    }
    val boundaries = Array<Int>(6L) { i -> when (i) {
        case 0L -> 0
        case 1L -> 127
        case 2L -> 2047
        case 3L -> 55295
        case 4L -> 57344
        else -> 1114111
    } }
    for (number in boundaries) {
        if (number.toChar().code != number) { fail(Some("boundary")) }
    }
    var errors = 0
    try { val unused = (-1).toChar() } catch (e: IllegalArgumentException) { errors = errors + 1 }
    try { val unused = 55296.toChar() } catch (e: IllegalArgumentException) { errors = errors + 1 }
    try { val unused = 57343.toChar() } catch (e: IllegalArgumentException) { errors = errors + 1 }
    try { val unused = 1114112.toChar() } catch (e: IllegalArgumentException) { errors = errors + 1 }
    if (errors != 4) { fail(Some("invalid-code")) }
}

@Test
private class ApiTests {
    @Test
    fun behavior() { exercise() }
}
