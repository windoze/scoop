package test.core.tests.scalars.floating

import scoop.test.*

private fun throughInterface(value: ToString): String = value.toString()

@Test
private class FloatingTextTests {
    @Test
    fun spellingAndThresholds() {
        assertEquals("0.0", 0.0.toString())
        assertEquals("-0.0", (-0.0).toString())
        assertEquals("-0.0", (-0.0f).toString())
        assertEquals("NaN", Double.NaN.toString())
        assertEquals("NaN", Float.NaN.toString())
        assertEquals("Infinity", Double.POSITIVE_INFINITY.toString())
        assertEquals("-Infinity", Float.NEGATIVE_INFINITY.toString())
        assertEquals("0.001", 0.001.toString())
        assertEquals("-0.001", (-0.001f).toString())
        assertEquals("1.0e-4", 0.0001.toString())
        assertEquals("9999999.0", 9999999.0.toString())
        assertEquals("1.0e7", 10000000.0f.toString())
        assertEquals("-1.25e7", (-12500000.0).toString())
        assertEquals("1.2345678901234567", 1.2345678901234567.toString())
    }

    @Test
    fun extremesAndMovingResults() {
        assertEquals("1.0e-45", Float.MIN_VALUE.toString())
        assertEquals("5.0e-324", Double.MIN_VALUE.toString())
        assertEquals("1.1754944e-38", Float.MIN_NORMAL.toString())
        assertEquals("2.2250738585072014e-308", Double.MIN_NORMAL.toString())
        assertEquals("3.4028235e38", Float.MAX_VALUE.toString())
        assertEquals("1.7976931348623157e308", Double.MAX_VALUE.toString())
        val small = throughInterface(-Double.MIN_VALUE)
        val large = throughInterface(-Float.MAX_VALUE)
        gcCollect()
        assertEquals("-5.0e-324", small)
        assertEquals("-3.4028235e38", large)
    }
}
