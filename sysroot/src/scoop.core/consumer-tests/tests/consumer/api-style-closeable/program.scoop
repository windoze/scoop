package test.core.tests.consumer.api_style_closeable

import scoop.test.*
private fun check(value: Boolean, location: SourceLocation = currentSourceLocation()) {
    assertTrue(value, location = location)
}

private class Resource : Closeable {
    var calls: Int = 0
    public override fun close() {
        if (calls == 0) { calls += 1; gcCollect() }
    }
}

private class FailingResource(private val failure: Throwable) : Closeable {
    public override fun close() { throw failure }
}

private class ValueResource(var value: Int) : Disposable {
    public override fun dispose() { value += 1 }
}

private fun evaluated(resource: ValueResource, counter: ValueResource): ValueResource {
    counter.value += 1
    return resource
}

private class Gate(var waiter: Continuation<Int>? = None)
private class Completion : Continuation<Int> {
    var value: Int = 0
    public override fun resume(value: Int) { this.value = value }
    public override fun resumeWithException(exception: Throwable) { throw exception }
}

private fun exerciseConsumer() {
    val resource = Resource()
    check(resource.use { it.calls + 7 } == 7)
    check(resource.calls == 1)
    val disposable: Disposable = resource
    disposable.dispose()
    resource.close()
    check(resource.calls == 1)
    val primary = Exception(Some("body"))
    val cleanup = Exception(Some("close"))
    var caught = false
    try { FailingResource(cleanup).use { throw primary } }
    catch (error: Exception) {
        val combined = error as ResourceUseException
        check(combined.primaryFailure === primary && combined.cleanupFailure === cleanup)
        caught = true
    }
    check(caught)
    val suspended = Resource()
    val gate = Gate()
    val completion = Completion()
    startCoroutine(suspend {
        suspended.use(suspend { current ->
            check(current.calls == 0)
            val value: Int = suspendCoroutine { gate.waiter = Some(it) }
            value
        })
    }, completion)
    check(suspended.calls == 0)
    gcCollect()
    gate.waiter!!.resume(42)
    check(completion.value == 42 && suspended.calls == 1)

}

@Test
private class ConsumerTests {
    @Test
    fun behavior() { exerciseConsumer() }

    @Test
    fun cleanupPreservesResultAndEvaluatesReceiverOnce() {
        val resource = ValueResource(7)
        val counter = ValueResource(0)
        val result = evaluated(resource, counter).use { it.value }
        check(result == 7 && resource.value == 8 && counter.value == 1)
    }

    @Test
    fun singleFailuresPreserveIdentity() {
        val primary = Exception(Some("body"))
        val cleanup = Exception(Some("dispose"))
        val resource = ValueResource(0)
        var caught = 0
        try { resource.use { throw primary } }
        catch (error: Throwable) { check(error === primary); caught += 1 }
        check(resource.value == 1)
        try { FailingResource(cleanup).use { 42 } }
        catch (error: Throwable) { check(error === cleanup); caught += 1 }
        check(caught == 2)
    }
}
