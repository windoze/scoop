package test.core.tests.consumer.annotation_query_basic

import scoop.test.*
import annotationKey as query

fun check(value: Boolean, location: SourceLocation = currentSourceLocation()) {
    assertTrue(value, location = location)
}
@Repeatable
annotation class Tag(val text: String = "default")
@Tag("metadata")
annotation class Label(val count: Long = 7L, val tags: Array<Tag> = [])
class Owner { annotation class Label(val enabled: Boolean = true) }
@Tag("first") @Tag("second")
struct Record(val number: Int)
fun <T> annotationKey(value: T): T = value
fun <T> label(): AnnotationKey = query<Label>()
fun defaulted(value: AnnotationKey = query<Label>()): AnnotationKey = value
val saved: AnnotationKey = query<Label>()

private fun exerciseConsumer() {
    query<Label>()
    val key = query<Label>()
    check(key == saved && key == defaulted())
    check(key == label<Int>() && key == label<String>())
    check(key != query<Owner.Label>())
    check(key.displayName == query<Owner.Label>().displayName)
    check(annotationKey<Int>(7) == 7)
    val description = key.describe()
    check(description.key == key && description.parameters.size == 2L)
    check(description.parameters[0L].name == "count")
    check(when (description.parameters[0L].defaultValue!!) {
        case AnnotationValue.Integer(IntegerValue.Long(value)) -> value == 7L
       ; else -> false
    })
    check(description.annotations[0L].key == query<Tag>())
    check(when (description.parameters[1L].type) {
        case AnnotationParameterType.Array(AnnotationAtomType.Annotation(element)) -> element == query<Tag>()
       ; else -> false
    })
    val tags = findAnnotations(typeInfo<Record>().describe().annotations, query<Tag>())
    check(tags.size == 2L)
    check(when (tags[0L].arguments[0L].value) { case AnnotationValue.String(value) -> value == "first"; else -> false })
    check(findAnnotations(typeInfo<Record>().describe().annotations, key).size == 0L)
    var current = key
    for (index in 0L until 10L) {
        current = current.describe().key
        gcCollect()
        check(current == key)
    }

}

@Test
private class ConsumerTests {
    @Test
    fun behavior() { exerciseConsumer() }
}
