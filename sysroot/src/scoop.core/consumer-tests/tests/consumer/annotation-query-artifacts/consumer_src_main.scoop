package test.core.tests.consumer.annotation_query_artifacts.p0

import scoop.test.*
import test.core.tests.consumer.annotation_query_artifacts.p2.*
import test.core.tests.consumer.annotation_query_artifacts.p1.*
import test.core.tests.consumer.annotation_query_artifacts.p2.Label as ImportedLabel
import test.core.tests.consumer.annotation_query_artifacts.p1.label as importedLabel
annotation class Label(val text: String = "consumer")
fun check(value: Boolean, location: SourceLocation = currentSourceLocation()) {
    assertTrue(value, location = location)
}
private fun exerciseConsumer() {
    val key = annotationKey<ImportedLabel>()
    check(key == importedLabel())
    check(key == defaulted() && key == Keyed().key)
    check(key != annotationKey<Label>())
    val description = key.describe()
    check(description.key == key && description.parameters.size == 1L)
    check(when (description.parameters[0L].defaultValue!!) { case AnnotationValue.String(value) -> value == "provider"; else -> false })
    val hidden = forwarded<Long>()
    check(hidden == built() && hidden == genericKey<String>())
    check(hidden.describe().visibility == DeclarationVisibility.Private)
    check(hidden != key && hidden.describe().parameters.size == 1L)
    check(Stored<Long>().key == hidden && Stored<Int>().key == builtStored())
    check(BuiltKey().key == key)
    val closure = callback<Long>()
    gcCollect()
    check(closure() == hidden)
    check(when (hidden.describe().parameters[0L].defaultValue!!) { case AnnotationValue.Integer(IntegerValue.Int(value)) -> value == 9; else -> false })

}

@Test
private class ConsumerTests {
    @Test
    fun behavior() { exerciseConsumer() }
}
