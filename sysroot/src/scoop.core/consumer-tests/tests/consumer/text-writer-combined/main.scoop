package test.core.tests.consumer.text_writer_combined.p0

import scoop.test.*
import test.core.tests.consumer.text_writer_combined.p1.writeParts
import test.core.tests.consumer.text_writer_combined.p1.deferred
import test.core.tests.consumer.text_writer_combined.p1.joined

fun check(condition: Boolean, location: SourceLocation = currentSourceLocation()): Unit {
    if (!condition) {
        println(location.line)
        throw IllegalStateException()
    }
}

class RecordingWriter(val target: TextWriter, val failure: IllegalStateException) : TextWriter {
    var calls: Long = 0L

    public override fun write(text: String): Unit {
        calls += 1L
        gcCollect()
        if (text == "stop") { throw failure }
        target.write(text)
    }
}

private fun exerciseConsumer() {
    val target = StringWriter()
    val failure = IllegalStateException(Some("writer failure"))
    val writer = RecordingWriter(target, failure)
    writeParts(writer, ["start:", "雪", ""])
    check(writer.calls == 3L)
    check(target.toString() == "start:雪")
    val callback = deferred(writer, "🚀")
    gcCollect()
    callback()
    check(target.toString() == "start:雪🚀")

    var caught = false
    try {
        writeParts(writer, ["kept", "stop", "unreachable"])
    } catch (error: IllegalStateException) {
        check(error.message == Some("writer failure"))
        caught = true
    }
    check(caught)
    check(writer.calls == 6L)
    check(target.toString() == "start:雪🚀kept")
    writer.write("after")
    check(target.toString() == "start:雪🚀keptafter")
    check(joined(["one", ":", "two"]) == "one:two")

}

@Test
private class ConsumerTests {
    @Test
    fun behavior() { exerciseConsumer() }
}
