package test.core.tests.consumer.debug_derived

import scoop.test.*
fun equal(actual: String, expected: String) {
    if (actual != expected) {
        println("actual: " + actual + " expected: " + expected)
        throw IllegalStateException()
    }
}
fun check(value: Boolean, location: SourceLocation = currentSourceLocation()) {
    assertTrue(value, location = location)
}

struct Record(val name: String, val pair: (Int, String), val values: Array<Int>, val optional: Int??, val unit: Unit) {
    companion object : ValueInspector<Record>
}
enum State { Idle, Named(val code: Int, val text: String), Pair(Int, String), Fields { code: Int, text: String }
    companion object : ValueInspector<State>
}
enum Level : Int16 { Low = -3, High = 9
    companion object : ValueInspector<Level>
}
class Secret(private val token: String) {
    val computed: Int get() { throw IllegalStateException() }
    private val number: Int = 7
    companion object : ValueInspector<Secret>
}
class PublicRecord(val number: Int) { val body: String = "body" }
object PublicInspector : ValueInspector<PublicRecord>
object TupleInspector : ValueInspector<(Int, String)>
struct Box<T>(val value: T)
class BoxInspector<T>(private val element: ValueInspector<T>) : ValueInspector<Box<T>>
struct Duo<A, B>(val first: A, val second: B)
class DuoInspector<A, B>(private val first: ValueInspector<A>, private val second: ValueInspector<B>) : ValueInspector<Duo<A, B>>
class Offset(val amount: Int) : ValueInspector<Int> {
    public override fun inspect(value: Int): ValueView = Int.inspect(value + amount)
}
class Node(private val name: String) {
    var next: Node? = None
    companion object : ValueInspector<Node>
}
struct FunctionRecord(val call: () -> Int)
class FunctionInspector(private val call: ValueInspector<() -> Int>) : ValueInspector<FunctionRecord>
class Counts { var reads: Int = 0 }
class Counting(private val counts: Counts) : ValueInspector<Int> {
    public override fun inspect(value: Int): ValueView {
        counts.reads = counts.reads + 1
        gcCollect()
        return Int.inspect(value)
    }
}
struct Filtered(@DebugIgnore val ignored: Int, @DebugRedact val redacted: Int, val kept: Int)
class FilteredInspector(private val field: ValueInspector<Int>) : ValueInspector<Filtered>
open class Open
interface Custom : ValueInspector<Open> {
    public override fun inspect(value: Open): ValueView = OpaqueInspector<Open>("chosen default").inspect(value)
}
object Inherited : Custom

private fun exerciseConsumer() {
    val record = Record("Ada", (3, "x"), [1, 2], Some(None), Unit)
    equal(DebugPrinter.format(Record.inspect(record)), "Record(name=\"Ada\", pair=(3, \"x\"), values=[1, 2], optional=Option<Option<Int>>.Some(Option<Int>.None), unit=Unit)")
    equal(DebugPrinter.format(State.inspect(State.Idle)), "State.Idle")
    equal(DebugPrinter.format(State.inspect(State.Named(4, "x"))), "State.Named(code=4, text=\"x\")")
    equal(DebugPrinter.format(State.inspect(State.Pair(5, "y"))), "State.Pair(5, \"y\")")
    equal(DebugPrinter.format(State.inspect(State.Fields(code = 6, text = "z"))), "State.Fields(code=6, text=\"z\")")
    equal(DebugPrinter.format(Level.inspect(Level.Low)), "Level.Low(-3)")
    equal(DebugPrinter.format(Secret.inspect(Secret("private"))), "Secret(token=\"private\", number=7)")
    equal(DebugPrinter.format(PublicInspector.inspect(PublicRecord(8))), "PublicRecord(number=8, body=\"body\")")
    equal(DebugPrinter.format(TupleInspector.inspect((1, "a"))), "(1, \"a\")")
    equal(DebugPrinter.format(BoxInspector<Int>(Offset(10)).inspect(Box(2))), "Box<Int>(value=12)")
    equal(DebugPrinter.format(DuoInspector<Int, Int>(Offset(10), Offset(20)).inspect(Duo(1, 2))), "Duo<Int, Int>(first=11, second=22)")
    equal(DebugPrinter.format(FunctionInspector(OpaqueInspector<() -> Int>("function")).inspect(FunctionRecord({ 1 }))), "FunctionRecord(call=<opaque function>)")
    equal(DebugPrinter.format(Inherited.inspect(Open())), "<opaque chosen default>")
    val counts = Counts()
    val filtered = FilteredInspector(Counting(counts)).inspect(Filtered(1, 2, 3))
    check(counts.reads == 0)
    equal(DebugPrinter.format(filtered, DebugOptions(maxItems = 1L)), "Filtered(redacted=\"<redacted>\", …)")
    check(counts.reads == 0)
    equal(DebugPrinter.format(filtered), "Filtered(redacted=\"<redacted>\", kept=3)")
    check(counts.reads == 1)
    val node = Node("root")
    node.next = Some(node)
    equal(DebugPrinter.format(Node.inspect(node)), "Node(name=\"root\", next=Option<Node>.Some(<cycle Node>))")

}

@Test
private class ConsumerTests {
    @Test
    fun behavior() { exerciseConsumer() }
}
