package test.core.tests.consumer.api_style_bytes

import scoop.test.*
private fun check(value: Boolean, location: SourceLocation = currentSourceLocation()) {
    assertTrue(value, location = location)
}

private class Bytes(private val source: List<Byte>) : List<Byte> {
    public override val size: Long get() = source.size
    public override operator fun get(index: Long): Byte = source[index]
    public override operator fun iterator(): Iterator<Byte> = source.iterator()
}

private class FailingBytes(private val failure: Throwable) : List<Byte> {
    public override val size: Long get() = 1L
    public override operator fun get(index: Long): Byte { throw failure }
    public override operator fun iterator(): Iterator<Byte> { throw failure }
}

private fun exerciseConsumer() {
    val text = "A\u0000雪🙂"
    val immutable: Array<Byte> = text.toByteArray()
    val mutable: MutableArray<Byte> = text.toMutableByteArray()
    val chars: Array<Char> = text.toCharArray()
    val writableChars: MutableArray<Char> = text.toMutableCharArray()
    check(String.fromUtf8(immutable) == text)
    check(String.fromUtf8(mutable) == text)
    check(String.fromUtf8(Bytes(immutable)) == text)
    check(String.fromUtf8OrNone(Bytes(immutable)) == Some(text))
    check(String.fromUtf8Lossy(Bytes(immutable)) == text)
    mutable[0L] = 90.toByte()
    writableChars[0L] = 'Z'
    gcCollect()
    check(immutable[0L] == 65.toByte() && chars[0L] == 'A')
    check(String.fromUtf8(mutable) == "Z\u0000雪🙂")
    check(String.fromChars(writableChars) == "Z\u0000雪🙂")
    val failure = Exception(Some("getter"))
    var caught = false
    try { String.fromUtf8OrNone(FailingBytes(failure)) }
    catch (error: Exception) { check(error === failure); caught = true }
    check(caught)

}

@Test
private class ConsumerTests {
    @Test
    fun behavior() { exerciseConsumer() }
}
