package test.core.tests.strings.reads

import scoop.test.*

private fun genericHash(value: Hash): Long = value.hash()
private fun dynamicCompare(left: String, right: String): Long = left.compareTo(right)

private fun checkByteHash(length: Long, expected: Long) {
    val text = String.fromUtf8(Array<Byte>(length) { index -> (index % 127L).toByte() })
    val hash = text::hash
    assertEquals(expected, genericHash(text))
    gcCollect()
    assertEquals(expected, text.hash())
    assertEquals(expected, hash())
}

@Test
private class ReadTests {
    @Test
    fun hashCompatibility() {
        assertEquals(1469598103934665603L, "".hash())
        assertEquals(1469598103934665603L, genericHash("" + ""))
        assertEquals(4953267810257967366L, "a".hash())
        assertEquals(4953267810257967366L, genericHash("a" + ""))
        assertEquals(-7229320835136510740L, "ab".hash())
        assertEquals(-7229320835136510740L, genericHash("ab" + ""))
        assertEquals(-2204510569963675907L, "abc".hash())
        assertEquals(-2204510569963675907L, genericHash("abc" + ""))
        assertEquals(-4874911600433857029L, "abcd".hash())
        assertEquals(-4874911600433857029L, genericHash("abcd" + ""))
        assertEquals(-4579939170047986822L, "abcde".hash())
        assertEquals(-4579939170047986822L, genericHash("abcde" + ""))
        assertEquals(7212980802197362836L, "abcdef".hash())
        assertEquals(7212980802197362836L, genericHash("abcdef" + ""))
        assertEquals(-4093457314057493271L, "abcdefg".hash())
        assertEquals(-4093457314057493271L, genericHash("abcdefg" + ""))
        assertEquals(-2784653379561568461L, "abcdefgh".hash())
        assertEquals(-2784653379561568461L, genericHash("abcdefgh" + ""))
        assertEquals(-448326216548270610L, "abcdefghi".hash())
        assertEquals(-448326216548270610L, genericHash("abcdefghi" + ""))
        assertEquals(650175339729647904L, "A\u0000é雪".hash())
        assertEquals(650175339729647904L, genericHash("A\u0000é雪" + ""))
        assertEquals(-874321210376381241L, "🙂🙂".hash())
        assertEquals(-874321210376381241L, genericHash("🙂🙂" + ""))
        assertEquals(9070348016127378236L, "é雪🙂abcdefghi".hash())
        assertEquals(9070348016127378236L, genericHash("é雪🙂abcdefghi" + ""))
    }

    @Test
    fun equalityAndOrdering() {
        val text = "A\u0000é雪🙂" + ""
        val copy = text.slice(0L, text.charLength)
        gcCollect()
        assertTrue(text == text)
        assertTrue(text == copy)
        assertFalse(text == "")
        assertFalse(text == "A\u0000é雪🙃")
        assertTrue("" == "".slice(0L, 0L))
        assertEquals(0L, dynamicCompare(text, copy))
        assertEquals(-1L, dynamicCompare("abc", "abcd"))
        assertEquals(1L, dynamicCompare("abcd", "abc"))
        assertEquals(-1L, dynamicCompare("", "a"))
        assertEquals(1L, dynamicCompare("a", ""))
        assertEquals(-1L, dynamicCompare("a\u0000", "a\u0001"))
        assertEquals(1L, dynamicCompare("é", "z"))
        assertEquals(-1L, dynamicCompare("雪", "🙂"))
    }

    @Test
    fun dynamicHashLengthBoundaries() {
        checkByteHash(0L, 1469598103934665603L)
        checkByteHash(7L, 5247242255190488182L)
        checkByteHash(8L, -3948417661554533373L)
        checkByteHash(9L, 1001814023825581745L)
        checkByteHash(15L, 8637538703190335550L)
        checkByteHash(16L, 615731795747517251L)
        checkByteHash(17L, -664846548891093495L)
        checkByteHash(31L, -6540265022281374610L)
        checkByteHash(32L, -4098353606094590973L)
        checkByteHash(33L, 2689684201023061881L)
        checkByteHash(64L, -3498673563981234557L)
        checkByteHash(65L, 6364177471900067161L)
        checkByteHash(128L, -8139581360370597558L)
        assertEquals(-8900035388218590101L, genericHash("🙂🙂🙂🙂" + ""))
        assertEquals(1518467307101369953L, genericHash("🙂🙂🙂🙂🙂" + ""))
        assertEquals(-404753460161457847L, genericHash("A\u0000é雪🙂abcdefghi" + ""))
    }
}
