package test.core.tests.strings.basic

import scoop.test.*
private fun exercise() {
    val text = "A雪🚀\u0000e\u0301"
    if (text.charLength != 6L || text.byteLength != 12L || text.getCharAt(idx = 1L) != '雪' ||
        text.getCharAt(2L) != '🚀' || text.getCharAt(3L) != '\u0000' || text.getCharAt(5L) != '\u0301') {
        fail(Some("units"))
    }
    if (text.slice(1L, 3L) != "雪🚀" || text.slice(0L, 6L) != text ||
        text.slice(6L, 6L) != "" || "".slice(0L, 0L) != "") { fail(Some("slice")) }
    val empty = ""
    if (empty.charLength != 0L || empty.byteLength != 0L) { fail(Some("empty")) }
    val erased: Any = text
    if (erased is IndexGet<Long, Char>) { fail(Some("index-interface")) }
    val source: Iterable<Char> = text
    var count = 0L
    for (character in source) {
        if (character != text.getCharAt(count)) { fail(Some("iteration")) }
        count = count + 1L
    }
    val iterator = source.iterator()
    while (iterator.next() != None) {}
    if (count != 6L || iterator.next() != None || iterator.next() != None ||
        empty.iterator().next() != None) { fail(Some("exhaustion")) }
    var caught = 0
    try { val value = text.getCharAt(-1L) } catch (e: IndexOutOfBoundsException) { caught = caught + 1 }
    try { val value = text.getCharAt(6L) } catch (e: IndexOutOfBoundsException) { caught = caught + 1 }
    try { val value = text.getCharAt(9223372036854775807L) } catch (e: IndexOutOfBoundsException) { caught = caught + 1 }
    try { val value = text.getCharAt(-9223372036854775808L) } catch (e: IndexOutOfBoundsException) { caught = caught + 1 }
    try { text.slice(-1L, 0L) } catch (e: IndexOutOfBoundsException) { caught = caught + 1 }
    try { text.slice(2L, 1L) } catch (e: IndexOutOfBoundsException) { caught = caught + 1 }
    try { text.slice(0L, 7L) } catch (e: IndexOutOfBoundsException) { caught = caught + 1 }
    try { text.slice(7L, 7L) } catch (e: IndexOutOfBoundsException) { caught = caught + 1 }
    try { text.slice(-9223372036854775808L, 9223372036854775807L) } catch (e: IndexOutOfBoundsException) { caught = caught + 1 }
    try { val value = empty.getCharAt(0L) } catch (e: IndexOutOfBoundsException) { caught = caught + 1 }
    if (caught != 10 || text == "A雪🚀\u0000é") { fail(Some("bounds-normalization")) }
}

@Test
private class ApiTests {
    @Test
    fun behavior() { exercise() }
}
