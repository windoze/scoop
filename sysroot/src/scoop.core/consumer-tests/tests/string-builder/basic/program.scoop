package test.core.tests.string_builder.basic

import scoop.test.*
private fun exercise() {
    val builder = StringBuilder()
    if (builder.toString() != "" || builder.toString().charLength != 0L) { fail(Some("empty")) }
    val same = builder.append("A")
    same.append('雪').append('\u0000').append(42)
    val first = builder.toString()
    if (first != "A雪\u000042" || first.charLength != 5L || builder.toString() != first) {
        fail(Some("chain"))
    }
    builder.append("").append<String>("🚀")
    gcCollect()
    if (first != "A雪\u000042" || builder.toString() != "A雪\u000042🚀") { fail(Some("snapshot")) }
    val many = StringBuilder()
    var expected = ""
    for (index in 0L until 130L) {
        many.append(index)
        expected = expected + index.toString()
    }
    gcCollect()
    val result = many.toString()
    if (result != expected || many.toString() != result) { fail(Some("many")) }
    many.append("tail")
    if (many.toString() != expected + "tail" || result != expected) { fail(Some("append")) }
}

@Test
private class ApiTests {
    @Test
    fun behavior() { exercise() }
}
