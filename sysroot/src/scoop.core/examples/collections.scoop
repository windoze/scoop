fun main() {
    val names = ArrayList<String>()
    names.add("Ada")
    names.add("Lin")
    val snapshot = names.toArray()
    names[0L] = "Grace"

    for (name in snapshot) {
        println(f"Hello, ${name}!")
    }
    println(f"Current first: ${names[0L]}")

    val text = "Scoop 中文"
    println(f"scalars=${text.length}, bytes=${text.toByteArray().size}")
    val builder = StringBuilder()
    for (number in 1..3) {
        builder.append(number.toString())
    }
    println(builder.toString())
}
