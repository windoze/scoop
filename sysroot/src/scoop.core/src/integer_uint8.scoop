/**
 * A 8-bit unsigned integer. Arithmetic wraps modulo 2^8; division by zero throws
 * [ArithmeticException]. Conversions are explicit and preserve the language's fixed-width rules on
 * every target.
 */
@Intrinsic("core_uint8")
public struct UInt8 :
    Add<UInt8, UInt8>,
    Sub<UInt8, UInt8>,
    Mul<UInt8, UInt8>,
    Div<UInt8, UInt8>,
    Rem<UInt8, UInt8>,
    UnaryPlus<UInt8>,
    UnaryMinus<UInt8>,
    Increment<UInt8>,
    Decrement<UInt8>,
    Compare<UInt8>,
    RangeTo<UInt8, UIntRange>,
    RangeUntil<UInt8, UIntRange>,
    Equals<UInt8>, ToString, Hash {
    /**
     * Rounds the integer directly to IEEE binary32 using round-to-nearest, ties-to-even.
     */
    @NoGC @Intrinsic("uint8_to_float")
    public fun toFloat(): Float

    /**
     * Rounds the integer directly to IEEE binary64 using round-to-nearest, ties-to-even.
     */
    @NoGC @Intrinsic("uint8_to_double")
    public fun toDouble(): Double

    /**
     * Compares the mathematical values of two integers of the same type.
     */
    @NoGC
    @Intrinsic("uint8_equals")
    public override operator fun equals(other: UInt8): Boolean


    /**
     * Returns the unchanged integer value.
     */
    @NoGC
    @Intrinsic("uint8_unary_plus")
    public override operator fun unaryPlus(): UInt8

    /**
     * Returns the additive inverse modulo 2^8, including at the representation boundary.
     */
    @NoGC
    @Intrinsic("uint8_unary_minus")
    public override operator fun unaryMinus(): UInt8

    /**
     * Returns the value plus one, wrapping modulo 2^8.
     */
    @NoGC
    @Intrinsic("uint8_inc")
    public override operator fun inc(): UInt8

    /**
     * Returns the value minus one, wrapping modulo 2^8.
     */
    @NoGC
    @Intrinsic("uint8_dec")
    public override operator fun dec(): UInt8

    /**
     * Returns the sum modulo 2^8; overflow does not throw.
     */
    @NoGC
    @Intrinsic("uint8_add")
    public override operator fun plus(other: UInt8): UInt8

    /**
     * Returns the difference modulo 2^8; overflow does not throw.
     */
    @NoGC
    @Intrinsic("uint8_sub")
    public override operator fun minus(other: UInt8): UInt8

    /**
     * Returns the product modulo 2^8; overflow does not throw.
     */
    @NoGC
    @Intrinsic("uint8_mul")
    public override operator fun times(other: UInt8): UInt8

    /**
     * Returns the quotient truncated toward zero. A zero divisor throws [ArithmeticException].
     */
    @Intrinsic("uint8_div")
    public override operator fun div(other: UInt8): UInt8

    /**
     * Returns the remainder associated with division truncated toward zero. A zero divisor throws
     * [ArithmeticException].
     */
    @Intrinsic("uint8_rem")
    public override operator fun rem(other: UInt8): UInt8

    /**
     * Returns -1, 0, or 1 using unsigned mathematical ordering.
     */
    @NoGC
    @Intrinsic("uint8_compare_to")
    public override operator fun compareTo(other: UInt8): Long

    /**
     * Returns the bitwise intersection of the 8-bit operands.
     */
    @NoGC
    @Intrinsic("uint8_and")
    public infix fun and(other: UInt8): UInt8

    /**
     * Returns the bitwise union of the 8-bit operands.
     */
    @NoGC
    @Intrinsic("uint8_or")
    public infix fun or(other: UInt8): UInt8

    /**
     * Sets each result bit where the corresponding 8-bit operand bits differ.
     */
    @NoGC
    @Intrinsic("uint8_xor")
    public infix fun xor(other: UInt8): UInt8

    /**
     * Flips all 8 bits of the representation.
     */
    @NoGC
    @Intrinsic("uint8_inv")
    public fun inv(): UInt8

    /**
     * Shifts left using the low 3 bits of the Long count; shifted-out bits are discarded.
     */
    @NoGC
    @Intrinsic("uint8_shl")
    public infix fun shl(count: Long): UInt8

    /**
     * Shifts right using the low 3 bits of the Long count, filling with zero bits.
     */
    @NoGC
    @Intrinsic("uint8_shr")
    public infix fun shr(count: Long): UInt8

    /**
     * Converts modulo 2^8 and interprets the result as a 8-bit signed integer. The conversion
     * always succeeds.
     */
    @NoGC
    @Intrinsic("uint8_to_int8")
    public fun toByte(): Byte

    /**
     * Converts modulo 2^16 and interprets the result as a 16-bit signed integer. The conversion
     * always succeeds.
     */
    @NoGC
    @Intrinsic("uint8_to_int16")
    public fun toShort(): Short

    /**
     * Converts modulo 2^32 and interprets the result as a 32-bit signed integer. The conversion
     * always succeeds.
     */
    @NoGC
    @Intrinsic("uint8_to_int")
    public fun toInt(): Int

    /**
     * Converts modulo 2^64 and interprets the result as a 64-bit signed integer. The conversion
     * always succeeds.
     */
    @NoGC
    @Intrinsic("uint8_to_long")
    public fun toLong(): Long

    /**
     * Converts modulo 2^8 and interprets the result as a 8-bit unsigned integer. The conversion
     * always succeeds.
     */
    @NoGC
    @Intrinsic("uint8_to_uint8")
    public fun toUByte(): UByte

    /**
     * Converts modulo 2^16 and interprets the result as a 16-bit unsigned integer. The conversion
     * always succeeds.
     */
    @NoGC
    @Intrinsic("uint8_to_uint16")
    public fun toUShort(): UShort

    /**
     * Converts modulo 2^32 and interprets the result as a 32-bit unsigned integer. The conversion
     * always succeeds.
     */
    @NoGC
    @Intrinsic("uint8_to_uint")
    public fun toUInt(): UInt

    /**
     * Converts modulo 2^64 and interprets the result as a 64-bit unsigned integer. The conversion
     * always succeeds.
     */
    @NoGC
    @Intrinsic("uint8_to_ulong")
    public fun toULong(): ULong

    /**
     * Creates an ascending range including both this value and the endpoint.
     */
    public override operator fun rangeTo(endpoint: UInt8): UIntRange =
        UIntRange(this.toUInt(), endpoint.toUInt(), 1u, false, true)

    /**
     * Creates an ascending range including this value and excluding the endpoint.
     */
    public override operator fun rangeUntil(endpoint: UInt8): UIntRange =
        UIntRange(this.toUInt(), endpoint.toUInt(), 1u, false, false)

    /**
     * Creates an ascending range with an exclusive endpoint.
     */
    public infix fun until(endpoint: UInt8): UIntRange =
        UIntRange(this.toUInt(), endpoint.toUInt(), 1u, false, false)

    /**
     * Creates a descending range including both endpoints.
     */
    public infix fun downTo(endpoint: UInt8): UIntRange =
        UIntRange(this.toUInt(), endpoint.toUInt(), 1u, true, true)

    /**
     * Returns the locale-independent decimal representation of this integer.
     */
    public override fun toString(): String = coreULongToString(this.toULong())

    /**
     * Returns a hash consistent with same-type integer equality.
     */
    public override fun hash(): Long = coreULongHash(this.toULong())

    /**
     * Fixed representation bounds and the scalar encoding, decoding, and inspection protocols.
     */
    public companion object : ValueEncoder<UInt8>, ValueDecoder<UInt8>, ValueInspector<UInt8> {
        /**
         * Exposes the integer as a scalar value observation without reference identity.
         */
        public override fun inspect(value: UInt8): ValueView =
            ValueObservation(typeInfo<UInt8>().type, None, { ValueShape.Scalar(ScalarValue.Unsigned(value.toULong())) })

        /**
         * The smallest representable 8-bit unsigned integer.
         */
        public const val MIN_VALUE: UInt8 = 0u
        /**
         * The largest representable 8-bit unsigned integer.
         */
        public const val MAX_VALUE: UInt8 = 255u

        /**
         * Writes the integer through the encoder's single-value container.
         */
        public override fun encode(value: UInt8, encoder: Encoder): Unit =
            encoder.singleValue().writeULong(value.toULong())

        /**
         * Decodes an integer and rejects values outside the 8-bit unsigned range with
         * [DecodingException].
         */
        public override fun decode(decoder: Decoder): UInt8 =
            decodeUnsigned(decoder, 255UL).toUByte()
    }
}
