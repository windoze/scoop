/**
 * The visibility recorded for an individual declaration, including local declarations.
 */
public enum DeclarationVisibility {
    /**
     * Visible through the public declaration boundary.
     */
    Public,
    /**
     * Visible within its declaring Cone.
     */
    Internal,
    /**
     * Visible under protected member-access rules.
     */
    Protected,
    /**
     * Visible only in the declaration's private scope.
     */
    Private,
    /**
     * Declared in a local lexical scope.
     */
    Local
}
