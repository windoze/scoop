/**
 * The identity of one nominal declaration. The stored identity is opaque; display names are not
 * substitutes for it.
 */
public struct NominalRef(val identity: String) : Equals<NominalRef> {
    /**
     * Compares the represented declaration identities.
     */
    public override operator fun equals(other: NominalRef): Boolean = identity == other.identity
}

