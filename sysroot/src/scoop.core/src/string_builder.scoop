public class StringBuilder public constructor() : ToString {
    private val parts: ArrayList<String> = ArrayList<String>()

    public fun append(value: String): StringBuilder {
        parts.add(value)
        return this
    }

    public fun <T : ToString> append(value: T): StringBuilder {
        val text = value.toString()
        parts.add(text)
        return this
    }

    public override fun toString(): String = coreStringJoinParts(parts.backing, parts.size)
}

@Extern(name = "scoop_rt_string_join_parts", abi = "scoop")
internal fun coreStringJoinParts(storage: MutableArray<MaybeUninit<String>>, partCount: Long): String
