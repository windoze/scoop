/**
 * A one-way cursor whose [next] operation returns Some(value) or None at the end.
 */
public interface Iterator<T> {
    /**
     * Returns the next value or None when iteration is exhausted.
     */
    public fun next(): Option<T>
}

/**
 * A value that supplies an [Iterator] for the for-loop protocol.
 */
public interface Iterable<T> {
    /**
     * Creates the cursor used to traverse this value.
     */
    public operator fun iterator(): Iterator<T>
}

internal class ListIterator<T> internal constructor(
    private val source: List<T>,
    private var index: Long,
    private var exhausted: Boolean
) : Iterator<T> {
    public override fun next(): Option<T> {
        if (exhausted) { return None }
        if (index >= source.size) {
            exhausted = true
            return None
        }
        val value = source[index]
        index = index + 1L
        return Some(value)
    }
}
