/**
 * A shared atomic cell. Memory-order arguments must be compile-time enum variants. Loads permit
 * Relaxed, Acquire, or SeqCst; stores permit Relaxed, Release, or SeqCst. Read-modify-write
 * operations permit every order. Compare-exchange failure order cannot release or be stronger than
 * success order. Reference comparison uses identity, not user-defined equality.
 */
@Intrinsic("core_atomic_ref")
public class AtomicRef<T : ref> {
    /**
     * Atomically reads the current value with the selected load order.
     */
    @NoGC @Intrinsic("atomic_ref_load")
    public fun load(order: MemoryOrder = MemoryOrder.SeqCst): T

    /**
     * Atomically replaces the value with the selected store order.
     */
    @NoGC @Intrinsic("atomic_ref_store")
    public fun store(value: T, order: MemoryOrder = MemoryOrder.SeqCst): Unit

    /**
     * Atomically replaces the value and returns the value observed before replacement.
     */
    @NoGC @Intrinsic("atomic_ref_exchange")
    public fun exchange(value: T, order: MemoryOrder = MemoryOrder.SeqCst): T

    /**
     * Replaces the value only when it matches `expected`, returning whether replacement occurred.
     */
    @NoGC @Intrinsic("atomic_ref_compare_and_set")
    public fun compareAndSet(expected: T, value: T, successOrder: MemoryOrder = MemoryOrder.SeqCst, failureOrder: MemoryOrder = MemoryOrder.SeqCst): Boolean

    /**
     * Conditionally replaces the value and returns the value observed by the comparison.
     */
    @NoGC @Intrinsic("atomic_ref_compare_and_exchange")
    public fun compareAndExchange(expected: T, value: T, successOrder: MemoryOrder = MemoryOrder.SeqCst, failureOrder: MemoryOrder = MemoryOrder.SeqCst): T

    /**
     * Retries a compare-exchange loop and returns the old value. The callback may run more than
     * once; callback side effects are not rolled back.
     */
    public fun getAndUpdate(update: (T) -> T): T {
        var current = load()
        var next = update(current)
        while (!compareAndSet(current, next)) {
            current = load()
            next = update(current)
        }
        return current
    }

    /**
     * Retries a compare-exchange loop and returns the installed value. The callback may run more
     * than once.
     */
    public fun updateAndGet(update: (T) -> T): T {
        var current = load()
        var next = update(current)
        while (!compareAndSet(current, next)) {
            current = load()
            next = update(current)
        }
        return next
    }
}
