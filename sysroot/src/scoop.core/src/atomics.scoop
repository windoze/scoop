@Intrinsic("core_atomic_ref")
public class AtomicRef<T : ref> {
    @NoGC @Intrinsic("atomic_ref_load")
    public fun load(order: MemoryOrder = MemoryOrder.SeqCst): T

    @NoGC @Intrinsic("atomic_ref_store")
    public fun store(value: T, order: MemoryOrder = MemoryOrder.SeqCst): Unit

