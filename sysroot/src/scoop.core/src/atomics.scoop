/**
 * The ordering of an atomic operation relative to other memory accesses. Allowed combinations
 * depend on the operation.
 */
public enum MemoryOrder {
    /**
     * Provides atomicity without ordering unrelated accesses.
     */
    Relaxed,
    /**
     * Orders subsequent accesses after a matching release observed by this operation.
     */
    Acquire,
    /**
     * Publishes preceding accesses to an acquire that observes this operation.
     */
    Release,
    /**
     * Combines acquire and release for a read-modify-write operation.
     */
    AcqRel,
    /**
     * Participates in the sequentially consistent order in addition to the operation's
     * acquire/release effects.
     */
    SeqCst }

/**
 * A shared atomic cell. Memory-order arguments must be compile-time enum variants. Loads permit
 * Relaxed, Acquire, or SeqCst; stores permit Relaxed, Release, or SeqCst. Read-modify-write
 * operations permit every order. Compare-exchange failure order cannot release or be stronger than
 * success order.
 */
@Intrinsic("core_atomic_int")
public class AtomicInt {
    /**
     * Atomically reads the current value with the selected load order.
     */
    @NoGC @Intrinsic("atomic_int_load")
    public fun load(order: MemoryOrder = MemoryOrder.SeqCst): Int

    /**
     * Atomically replaces the value with the selected store order.
     */
    @NoGC @Intrinsic("atomic_int_store")
    public fun store(value: Int, order: MemoryOrder = MemoryOrder.SeqCst): Unit

    /**
     * Atomically replaces the value and returns the value observed before replacement.
     */
    @NoGC @Intrinsic("atomic_int_exchange")
    public fun exchange(value: Int, order: MemoryOrder = MemoryOrder.SeqCst): Int

    /**
     * Replaces the value only when it matches `expected`, returning whether replacement occurred.
     */
    @NoGC @Intrinsic("atomic_int_compare_and_set")
    public fun compareAndSet(expected: Int, value: Int, successOrder: MemoryOrder = MemoryOrder.SeqCst, failureOrder: MemoryOrder = MemoryOrder.SeqCst): Boolean

    /**
     * Conditionally replaces the value and returns the value observed by the comparison.
     */
    @NoGC @Intrinsic("atomic_int_compare_and_exchange")
    public fun compareAndExchange(expected: Int, value: Int, successOrder: MemoryOrder = MemoryOrder.SeqCst, failureOrder: MemoryOrder = MemoryOrder.SeqCst): Int

    /**
     * Atomically adds with integer wrapping and returns the previous value.
     */
    @NoGC @Intrinsic("atomic_int_fetch_add")
    public fun fetchAdd(value: Int, order: MemoryOrder = MemoryOrder.SeqCst): Int

    /**
     * Atomically subtracts with integer wrapping and returns the previous value.
     */
    @NoGC @Intrinsic("atomic_int_fetch_sub")
    public fun fetchSub(value: Int, order: MemoryOrder = MemoryOrder.SeqCst): Int

    /**
     * Atomically applies bitwise AND and returns the previous value.
     */
    @NoGC @Intrinsic("atomic_int_fetch_and")
    public fun fetchAnd(value: Int, order: MemoryOrder = MemoryOrder.SeqCst): Int

    /**
     * Atomically applies bitwise OR and returns the previous value.
     */
    @NoGC @Intrinsic("atomic_int_fetch_or")
    public fun fetchOr(value: Int, order: MemoryOrder = MemoryOrder.SeqCst): Int

    /**
     * Atomically applies bitwise XOR and returns the previous value.
     */
    @NoGC @Intrinsic("atomic_int_fetch_xor")
    public fun fetchXor(value: Int, order: MemoryOrder = MemoryOrder.SeqCst): Int

    /**
     * Retries a compare-exchange loop and returns the old value. The callback may run more than
     * once; callback side effects are not rolled back.
     */
    public fun getAndUpdate(update: (Int) -> Int): Int {
        var current = load()
        var next = update(current)
        while (!compareAndSet(current, next)) {
            current = load()
            next = update(current)
        }
        return current
    }

    /**
     * Retries a compare-exchange loop and returns the installed value. The callback may run more
     * than once.
     */
    public fun updateAndGet(update: (Int) -> Int): Int {
        var current = load()
        var next = update(current)
        while (!compareAndSet(current, next)) {
            current = load()
            next = update(current)
        }
        return next
    }
}

/**
 * A shared atomic cell. Memory-order arguments must be compile-time enum variants. Loads permit
 * Relaxed, Acquire, or SeqCst; stores permit Relaxed, Release, or SeqCst. Read-modify-write
 * operations permit every order. Compare-exchange failure order cannot release or be stronger than
 * success order.
 */
@Intrinsic("core_atomic_long")
public class AtomicLong {
    /**
     * Atomically reads the current value with the selected load order.
     */
    @NoGC @Intrinsic("atomic_long_load")
    public fun load(order: MemoryOrder = MemoryOrder.SeqCst): Long

    /**
     * Atomically replaces the value with the selected store order.
     */
    @NoGC @Intrinsic("atomic_long_store")
    public fun store(value: Long, order: MemoryOrder = MemoryOrder.SeqCst): Unit

    /**
     * Atomically replaces the value and returns the value observed before replacement.
     */
    @NoGC @Intrinsic("atomic_long_exchange")
    public fun exchange(value: Long, order: MemoryOrder = MemoryOrder.SeqCst): Long

    /**
     * Replaces the value only when it matches `expected`, returning whether replacement occurred.
     */
    @NoGC @Intrinsic("atomic_long_compare_and_set")
    public fun compareAndSet(expected: Long, value: Long, successOrder: MemoryOrder = MemoryOrder.SeqCst, failureOrder: MemoryOrder = MemoryOrder.SeqCst): Boolean

    /**
     * Conditionally replaces the value and returns the value observed by the comparison.
     */
    @NoGC @Intrinsic("atomic_long_compare_and_exchange")
    public fun compareAndExchange(expected: Long, value: Long, successOrder: MemoryOrder = MemoryOrder.SeqCst, failureOrder: MemoryOrder = MemoryOrder.SeqCst): Long

    /**
     * Atomically adds with integer wrapping and returns the previous value.
     */
    @NoGC @Intrinsic("atomic_long_fetch_add")
    public fun fetchAdd(value: Long, order: MemoryOrder = MemoryOrder.SeqCst): Long

    /**
     * Atomically subtracts with integer wrapping and returns the previous value.
     */
    @NoGC @Intrinsic("atomic_long_fetch_sub")
    public fun fetchSub(value: Long, order: MemoryOrder = MemoryOrder.SeqCst): Long

    /**
     * Atomically applies bitwise AND and returns the previous value.
     */
    @NoGC @Intrinsic("atomic_long_fetch_and")
    public fun fetchAnd(value: Long, order: MemoryOrder = MemoryOrder.SeqCst): Long

    /**
     * Atomically applies bitwise OR and returns the previous value.
     */
    @NoGC @Intrinsic("atomic_long_fetch_or")
    public fun fetchOr(value: Long, order: MemoryOrder = MemoryOrder.SeqCst): Long

    /**
     * Atomically applies bitwise XOR and returns the previous value.
     */
    @NoGC @Intrinsic("atomic_long_fetch_xor")
    public fun fetchXor(value: Long, order: MemoryOrder = MemoryOrder.SeqCst): Long

    /**
     * Retries a compare-exchange loop and returns the old value. The callback may run more than
     * once; callback side effects are not rolled back.
     */
    public fun getAndUpdate(update: (Long) -> Long): Long {
        var current = load()
        var next = update(current)
        while (!compareAndSet(current, next)) {
            current = load()
            next = update(current)
        }
        return current
    }

    /**
     * Retries a compare-exchange loop and returns the installed value. The callback may run more
     * than once.
     */
    public fun updateAndGet(update: (Long) -> Long): Long {
        var current = load()
        var next = update(current)
        while (!compareAndSet(current, next)) {
            current = load()
            next = update(current)
        }
        return next
    }
}

/**
