public enum MemoryOrder { Relaxed, Acquire, Release, AcqRel, SeqCst }

@Intrinsic("core_atomic_int")
public class AtomicInt {
    @NoGC @Intrinsic("atomic_int_load")
    public fun load(order: MemoryOrder = MemoryOrder.SeqCst): Int

    @NoGC @Intrinsic("atomic_int_store")
    public fun store(value: Int, order: MemoryOrder = MemoryOrder.SeqCst): Unit

    @NoGC @Intrinsic("atomic_int_exchange")
    public fun exchange(value: Int, order: MemoryOrder = MemoryOrder.SeqCst): Int

    @NoGC @Intrinsic("atomic_int_compare_and_set")
    public fun compareAndSet(expected: Int, value: Int, successOrder: MemoryOrder = MemoryOrder.SeqCst, failureOrder: MemoryOrder = MemoryOrder.SeqCst): Boolean

    @NoGC @Intrinsic("atomic_int_compare_and_exchange")
    public fun compareAndExchange(expected: Int, value: Int, successOrder: MemoryOrder = MemoryOrder.SeqCst, failureOrder: MemoryOrder = MemoryOrder.SeqCst): Int

    @NoGC @Intrinsic("atomic_int_fetch_add")
    public fun fetchAdd(value: Int, order: MemoryOrder = MemoryOrder.SeqCst): Int

    @NoGC @Intrinsic("atomic_int_fetch_sub")
    public fun fetchSub(value: Int, order: MemoryOrder = MemoryOrder.SeqCst): Int

    @NoGC @Intrinsic("atomic_int_fetch_and")
    public fun fetchAnd(value: Int, order: MemoryOrder = MemoryOrder.SeqCst): Int

    @NoGC @Intrinsic("atomic_int_fetch_or")
    public fun fetchOr(value: Int, order: MemoryOrder = MemoryOrder.SeqCst): Int

    @NoGC @Intrinsic("atomic_int_fetch_xor")
    public fun fetchXor(value: Int, order: MemoryOrder = MemoryOrder.SeqCst): Int

    public fun getAndUpdate(update: (Int) -> Int): Int {
        var current = load()
        var next = update(current)
        while (!compareAndSet(current, next)) {
            current = load()
            next = update(current)
        }
        return current
    }

    public fun updateAndGet(update: (Int) -> Int): Int {
        var current = load()
        var next = update(current)
        while (!compareAndSet(current, next)) {
            current = load()
            next = update(current)
        }
        return next
    }
}

