    @NoGC @Intrinsic("atomic_ref_compare_and_exchange")
    public fun compareAndExchange(expected: T, value: T, successOrder: MemoryOrder = MemoryOrder.SeqCst, failureOrder: MemoryOrder = MemoryOrder.SeqCst): T

    public fun getAndUpdate(update: (T) -> T): T {
        var current = load()
        var next = update(current)
        while (!compareAndSet(current, next)) {
            current = load()
            next = update(current)
        }
        return current
