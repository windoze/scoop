// Public failure behavior shares the ordinary core UTF-8 decoder.
internal fun requireValidUtf8(result: (String?, Long)): String {
    val value = result._1
    if (value == None) { throw CharacterCodingException(result._2) }
    return value!!
}

internal fun decodeUtf8(bytes: List<Byte>): (String?, Long) {
    @Unsafe {
        return bytes.toArray().withDataPointer(fun(pointer: Ptr<Byte>, length: Long): (String?, Long) {
            @Unsafe { return coreStringDecodeUtf8(pointer.cast<UInt8>(), length) }
        })
    }
}
internal fun decodeUtf8Lossy(bytes: List<Byte>): String {
    @Unsafe {
        return bytes.toArray().withDataPointer(fun(pointer: Ptr<Byte>, length: Long): String {
            @Unsafe { return coreStringDecodeUtf8Lossy(pointer.cast<UInt8>(), length) }
        })
    }
}
