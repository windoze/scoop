/**
 * A 8-bit signed integer. Arithmetic wraps modulo 2^8; division by zero throws
 * [ArithmeticException]. Conversions are explicit and preserve the language's fixed-width rules on
 * every target.
 */
@Intrinsic("core_int8")
public struct Int8 :
    Add<Int8, Int8>,
    Sub<Int8, Int8>,
    Mul<Int8, Int8>,
    Div<Int8, Int8>,
    Rem<Int8, Int8>,
    UnaryPlus<Int8>,
    UnaryMinus<Int8>,
    Increment<Int8>,
    Decrement<Int8>,
    Compare<Int8>,
    RangeTo<Int8, IntRange>,
    RangeUntil<Int8, IntRange>,
    Equals<Int8>, ToString, Hash {
    /**
     * Rounds the integer directly to IEEE binary32 using round-to-nearest, ties-to-even.
     */
    @NoGC @Intrinsic("int8_to_float")
    public fun toFloat(): Float

    /**
     * Rounds the integer directly to IEEE binary64 using round-to-nearest, ties-to-even.
     */
    @NoGC @Intrinsic("int8_to_double")
    public fun toDouble(): Double

    /**
     * Compares the mathematical values of two integers of the same type.
     */
    @NoGC
    @Intrinsic("int8_equals")
    public override operator fun equals(other: Int8): Boolean


    /**
     * Returns the unchanged integer value.
     */
    @NoGC
    @Intrinsic("int8_unary_plus")
    public override operator fun unaryPlus(): Int8

    /**
     * Returns the additive inverse modulo 2^8, including at the representation boundary.
     */
    @NoGC
    @Intrinsic("int8_unary_minus")
    public override operator fun unaryMinus(): Int8

    /**
     * Returns the value plus one, wrapping modulo 2^8.
     */
    @NoGC
    @Intrinsic("int8_inc")
    public override operator fun inc(): Int8

    /**
     * Returns the value minus one, wrapping modulo 2^8.
     */
    @NoGC
    @Intrinsic("int8_dec")
    public override operator fun dec(): Int8

    /**
     * Returns the sum modulo 2^8; overflow does not throw.
     */
    @NoGC
    @Intrinsic("int8_add")
    public override operator fun plus(other: Int8): Int8

    /**
     * Returns the difference modulo 2^8; overflow does not throw.
     */
    @NoGC
    @Intrinsic("int8_sub")
    public override operator fun minus(other: Int8): Int8

    /**
     * Returns the product modulo 2^8; overflow does not throw.
     */
    @NoGC
    @Intrinsic("int8_mul")
    public override operator fun times(other: Int8): Int8

    /**
     * Returns the quotient truncated toward zero. A zero divisor throws [ArithmeticException]. The
     * minimum value divided by -1 wraps to the minimum value.
     */
    @Intrinsic("int8_div")
    public override operator fun div(other: Int8): Int8

    /**
     * Returns the remainder associated with division truncated toward zero. A zero divisor throws
     * [ArithmeticException]. A nonzero remainder has the dividend's sign.
     */
    @Intrinsic("int8_rem")
    public override operator fun rem(other: Int8): Int8

    /**
     * Returns -1, 0, or 1 using signed mathematical ordering.
     */
    @NoGC
    @Intrinsic("int8_compare_to")
    public override operator fun compareTo(other: Int8): Long

    /**
     * Returns the bitwise intersection of the 8-bit operands.
     */
    @NoGC
    @Intrinsic("int8_and")
    public infix fun and(other: Int8): Int8

    /**
     * Returns the bitwise union of the 8-bit operands.
     */
    @NoGC
    @Intrinsic("int8_or")
    public infix fun or(other: Int8): Int8

    /**
     * Sets each result bit where the corresponding 8-bit operand bits differ.
     */
    @NoGC
    @Intrinsic("int8_xor")
    public infix fun xor(other: Int8): Int8

    /**
     * Flips all 8 bits of the representation.
     */
    @NoGC
    @Intrinsic("int8_inv")
    public fun inv(): Int8

    /**
     * Shifts left using the low 3 bits of the Long count; shifted-out bits are discarded.
     */
    @NoGC
    @Intrinsic("int8_shl")
    public infix fun shl(count: Long): Int8

    /**
     * Shifts right using the low 3 bits of the Long count, replicating the sign bit.
     */
    @NoGC
    @Intrinsic("int8_shr")
    public infix fun shr(count: Long): Int8

    /**
     * Shifts right with zero fill using the low 3 bits of the Long count.
     */
    @NoGC
    @Intrinsic("int8_ushr")
    public infix fun ushr(count: Long): Int8

    /**
     * Converts modulo 2^8 and interprets the result as a 8-bit signed integer. The conversion
     * always succeeds.
     */
    @NoGC
    @Intrinsic("int8_to_int8")
    public fun toByte(): Byte

    /**
     * Converts modulo 2^16 and interprets the result as a 16-bit signed integer. The conversion
     * always succeeds.
     */
    @NoGC
    @Intrinsic("int8_to_int16")
    public fun toShort(): Short

    /**
     * Converts modulo 2^32 and interprets the result as a 32-bit signed integer. The conversion
     * always succeeds.
     */
    @NoGC
    @Intrinsic("int8_to_int")
    public fun toInt(): Int

    /**
     * Converts modulo 2^64 and interprets the result as a 64-bit signed integer. The conversion
     * always succeeds.
     */
    @NoGC
    @Intrinsic("int8_to_long")
    public fun toLong(): Long

    /**
     * Converts modulo 2^8 and interprets the result as a 8-bit unsigned integer. The conversion
     * always succeeds.
     */
    @NoGC
    @Intrinsic("int8_to_uint8")
    public fun toUByte(): UByte

    /**
     * Converts modulo 2^16 and interprets the result as a 16-bit unsigned integer. The conversion
     * always succeeds.
     */
    @NoGC
    @Intrinsic("int8_to_uint16")
    public fun toUShort(): UShort

    /**
     * Converts modulo 2^32 and interprets the result as a 32-bit unsigned integer. The conversion
     * always succeeds.
     */
    @NoGC
    @Intrinsic("int8_to_uint")
    public fun toUInt(): UInt

    /**
     * Converts modulo 2^64 and interprets the result as a 64-bit unsigned integer. The conversion
     * always succeeds.
     */
    @NoGC
    @Intrinsic("int8_to_ulong")
    public fun toULong(): ULong

    /**
     * Creates an ascending range including both this value and the endpoint.
     */
    public override operator fun rangeTo(endpoint: Int8): IntRange =
        IntRange(this.toInt(), endpoint.toInt(), 1, false, true)

    /**
     * Creates an ascending range including this value and excluding the endpoint.
     */
    public override operator fun rangeUntil(endpoint: Int8): IntRange =
        IntRange(this.toInt(), endpoint.toInt(), 1, false, false)

    /**
     * Creates an ascending range with an exclusive endpoint.
     */
    public infix fun until(endpoint: Int8): IntRange =
        IntRange(this.toInt(), endpoint.toInt(), 1, false, false)

    /**
     * Creates a descending range including both endpoints.
     */
    public infix fun downTo(endpoint: Int8): IntRange =
        IntRange(this.toInt(), endpoint.toInt(), 1, true, true)

    /**
     * Returns the locale-independent decimal representation of this integer.
     */
    public override fun toString(): String = coreLongToString(this.toLong())

    /**
     * Returns a hash consistent with same-type integer equality.
     */
    public override fun hash(): Long = coreLongHash(this.toLong())

    /**
     * Fixed representation bounds and the scalar encoding, decoding, and inspection protocols.
     */
    public companion object : ValueEncoder<Int8>, ValueDecoder<Int8>, ValueInspector<Int8> {
        /**
         * Exposes the integer as a scalar value observation without reference identity.
         */
        public override fun inspect(value: Int8): ValueView =
            ValueObservation(typeInfo<Int8>().type, None, { ValueShape.Scalar(ScalarValue.Signed(value.toLong())) })

        /**
         * The smallest representable 8-bit signed integer.
         */
        public const val MIN_VALUE: Int8 = -128
        /**
         * The largest representable 8-bit signed integer.
         */
        public const val MAX_VALUE: Int8 = 127

        /**
         * Writes the integer through the encoder's single-value container.
         */
        public override fun encode(value: Int8, encoder: Encoder): Unit =
            encoder.singleValue().writeLong(value.toLong())

        /**
         * Decodes an integer and rejects values outside the 8-bit signed range with
         * [DecodingException].
         */
        public override fun decode(decoder: Decoder): Int8 =
            decodeSigned(decoder, -128L, 127L).toByte()
    }
}
