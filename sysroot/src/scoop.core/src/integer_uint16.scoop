/**
 * A 16-bit unsigned integer. Arithmetic wraps modulo 2^16; division by zero throws
 * [ArithmeticException]. Conversions are explicit and preserve the language's fixed-width rules on
 * every target.
 */
@Intrinsic("core_uint16")
public struct UInt16 :
    Add<UInt16, UInt16>,
    Sub<UInt16, UInt16>,
    Mul<UInt16, UInt16>,
    Div<UInt16, UInt16>,
    Rem<UInt16, UInt16>,
    UnaryPlus<UInt16>,
    UnaryMinus<UInt16>,
    Increment<UInt16>,
    Decrement<UInt16>,
    Compare<UInt16>,
    RangeTo<UInt16, UIntRange>,
    RangeUntil<UInt16, UIntRange>,
    Equals<UInt16>, ToString, Hash {
    /**
     * Rounds the integer directly to IEEE binary32 using round-to-nearest, ties-to-even.
     */
    @NoGC @Intrinsic("uint16_to_float")
    public fun toFloat(): Float

    /**
     * Rounds the integer directly to IEEE binary64 using round-to-nearest, ties-to-even.
     */
    @NoGC @Intrinsic("uint16_to_double")
    public fun toDouble(): Double

    /**
     * Compares the mathematical values of two integers of the same type.
     */
    @NoGC
    @Intrinsic("uint16_equals")
    public override operator fun equals(other: UInt16): Boolean


    /**
     * Returns the unchanged integer value.
     */
    @NoGC
    @Intrinsic("uint16_unary_plus")
    public override operator fun unaryPlus(): UInt16

    /**
     * Returns the additive inverse modulo 2^16, including at the representation boundary.
     */
    @NoGC
    @Intrinsic("uint16_unary_minus")
    public override operator fun unaryMinus(): UInt16

    /**
     * Returns the value plus one, wrapping modulo 2^16.
     */
    @NoGC
    @Intrinsic("uint16_inc")
    public override operator fun inc(): UInt16

    /**
     * Returns the value minus one, wrapping modulo 2^16.
     */
    @NoGC
    @Intrinsic("uint16_dec")
    public override operator fun dec(): UInt16

    /**
     * Returns the sum modulo 2^16; overflow does not throw.
     */
    @NoGC
    @Intrinsic("uint16_add")
    public override operator fun plus(other: UInt16): UInt16

    /**
     * Returns the difference modulo 2^16; overflow does not throw.
     */
    @NoGC
    @Intrinsic("uint16_sub")
    public override operator fun minus(other: UInt16): UInt16

    /**
     * Returns the product modulo 2^16; overflow does not throw.
     */
    @NoGC
    @Intrinsic("uint16_mul")
    public override operator fun times(other: UInt16): UInt16

    /**
     * Returns the quotient truncated toward zero. A zero divisor throws [ArithmeticException].
     */
    @Intrinsic("uint16_div")
    public override operator fun div(other: UInt16): UInt16

    /**
     * Returns the remainder associated with division truncated toward zero. A zero divisor throws
     * [ArithmeticException].
     */
    @Intrinsic("uint16_rem")
    public override operator fun rem(other: UInt16): UInt16

    /**
     * Returns -1, 0, or 1 using unsigned mathematical ordering.
     */
    @NoGC
    @Intrinsic("uint16_compare_to")
    public override operator fun compareTo(other: UInt16): Long

    /**
     * Returns the bitwise intersection of the 16-bit operands.
     */
    @NoGC
    @Intrinsic("uint16_and")
    public infix fun and(other: UInt16): UInt16

    /**
     * Returns the bitwise union of the 16-bit operands.
     */
    @NoGC
    @Intrinsic("uint16_or")
    public infix fun or(other: UInt16): UInt16

    /**
     * Sets each result bit where the corresponding 16-bit operand bits differ.
     */
    @NoGC
    @Intrinsic("uint16_xor")
    public infix fun xor(other: UInt16): UInt16

    /**
     * Flips all 16 bits of the representation.
     */
    @NoGC
    @Intrinsic("uint16_inv")
    public fun inv(): UInt16

    /**
     * Shifts left using the low 4 bits of the Long count; shifted-out bits are discarded.
     */
    @NoGC
    @Intrinsic("uint16_shl")
    public infix fun shl(count: Long): UInt16

    /**
     * Shifts right using the low 4 bits of the Long count, filling with zero bits.
     */
    @NoGC
    @Intrinsic("uint16_shr")
    public infix fun shr(count: Long): UInt16

    /**
     * Converts modulo 2^8 and interprets the result as a 8-bit signed integer. The conversion
     * always succeeds.
     */
    @NoGC
    @Intrinsic("uint16_to_int8")
    public fun toByte(): Byte

    /**
     * Converts modulo 2^16 and interprets the result as a 16-bit signed integer. The conversion
     * always succeeds.
     */
    @NoGC
    @Intrinsic("uint16_to_int16")
    public fun toShort(): Short

    /**
     * Converts modulo 2^32 and interprets the result as a 32-bit signed integer. The conversion
     * always succeeds.
     */
    @NoGC
    @Intrinsic("uint16_to_int")
    public fun toInt(): Int

    /**
     * Converts modulo 2^64 and interprets the result as a 64-bit signed integer. The conversion
     * always succeeds.
     */
    @NoGC
    @Intrinsic("uint16_to_long")
    public fun toLong(): Long

    /**
     * Converts modulo 2^8 and interprets the result as a 8-bit unsigned integer. The conversion
     * always succeeds.
     */
    @NoGC
    @Intrinsic("uint16_to_uint8")
    public fun toUByte(): UByte

    /**
     * Converts modulo 2^16 and interprets the result as a 16-bit unsigned integer. The conversion
     * always succeeds.
     */
    @NoGC
    @Intrinsic("uint16_to_uint16")
    public fun toUShort(): UShort

    /**
     * Converts modulo 2^32 and interprets the result as a 32-bit unsigned integer. The conversion
     * always succeeds.
     */
    @NoGC
    @Intrinsic("uint16_to_uint")
    public fun toUInt(): UInt

    /**
     * Converts modulo 2^64 and interprets the result as a 64-bit unsigned integer. The conversion
     * always succeeds.
     */
    @NoGC
    @Intrinsic("uint16_to_ulong")
    public fun toULong(): ULong

    /**
     * Creates an ascending range including both this value and the endpoint.
     */
    public override operator fun rangeTo(endpoint: UInt16): UIntRange =
        UIntRange(this.toUInt(), endpoint.toUInt(), 1u, false, true)

    /**
     * Creates an ascending range including this value and excluding the endpoint.
     */
    public override operator fun rangeUntil(endpoint: UInt16): UIntRange =
        UIntRange(this.toUInt(), endpoint.toUInt(), 1u, false, false)

    /**
     * Creates an ascending range with an exclusive endpoint.
     */
    public infix fun until(endpoint: UInt16): UIntRange =
        UIntRange(this.toUInt(), endpoint.toUInt(), 1u, false, false)

    /**
     * Creates a descending range including both endpoints.
     */
    public infix fun downTo(endpoint: UInt16): UIntRange =
        UIntRange(this.toUInt(), endpoint.toUInt(), 1u, true, true)

    /**
     * Returns the locale-independent decimal representation of this integer.
     */
    public override fun toString(): String = coreULongToString(this.toULong())

    /**
     * Returns a hash consistent with same-type integer equality.
     */
    public override fun hash(): Long {
        @Unsafe { return coreULongHash(this.toULong()) }
    }

    /**
     * Fixed representation bounds and the scalar encoding, decoding, and inspection protocols.
     */
    public companion object : ValueEncoder<UInt16>, ValueDecoder<UInt16>, ValueInspector<UInt16> {
        /**
         * Exposes the integer as a scalar value observation without reference identity.
         */
        public override fun inspect(value: UInt16): ValueView =
            ValueObservation(typeInfo<UInt16>().type, None, { ValueShape.Scalar(ScalarValue.Unsigned(value.toULong())) })

        /**
         * The smallest representable 16-bit unsigned integer.
         */
        public const val MIN_VALUE: UInt16 = 0u
        /**
         * The largest representable 16-bit unsigned integer.
         */
        public const val MAX_VALUE: UInt16 = 65535u

        /**
         * Writes the integer through the encoder's single-value container.
         */
        public override fun encode(value: UInt16, encoder: Encoder): Unit =
            encoder.singleValue().writeULong(value.toULong())

        /**
         * Decodes an integer and rejects values outside the 16-bit unsigned range with
         * [DecodingException].
         */
        public override fun decode(decoder: Decoder): UInt16 =
            decodeUnsigned(decoder, 65535UL).toUShort()
    }
}
