@Intrinsic("core_ulong")
public struct ULong :
    Add<ULong, ULong>,
    Sub<ULong, ULong>,
    Mul<ULong, ULong>,
    Div<ULong, ULong>,
    Rem<ULong, ULong>,
    UnaryPlus<ULong>,
    UnaryMinus<ULong>,
    Increment<ULong>,
    Decrement<ULong>,
    Compare<ULong>,
    RangeTo<ULong, ULongRange>,
    RangeUntil<ULong, ULongRange>,
    Equals<ULong>, ToString, Hash {
    @NoGC @Intrinsic("ulong_to_float")
    public fun toFloat(): Float

    @NoGC @Intrinsic("ulong_to_double")
    public fun toDouble(): Double

    @NoGC
    @Intrinsic("ulong_equals")
    public override operator fun equals(other: ULong): Boolean


    @NoGC
    @Intrinsic("ulong_unary_plus")
    public override operator fun unaryPlus(): ULong

    @NoGC
    @Intrinsic("ulong_unary_minus")
    public override operator fun unaryMinus(): ULong

    @NoGC
    @Intrinsic("ulong_inc")
    public override operator fun inc(): ULong

    @NoGC
    @Intrinsic("ulong_dec")
    public override operator fun dec(): ULong

    @NoGC
    @Intrinsic("ulong_add")
    public override operator fun plus(other: ULong): ULong

    @NoGC
    @Intrinsic("ulong_sub")
    public override operator fun minus(other: ULong): ULong

    @NoGC
    @Intrinsic("ulong_mul")
    public override operator fun times(other: ULong): ULong

    @Intrinsic("ulong_div")
    public override operator fun div(other: ULong): ULong

    @Intrinsic("ulong_rem")
    public override operator fun rem(other: ULong): ULong

    @NoGC
    @Intrinsic("ulong_compare_to")
    public override operator fun compareTo(other: ULong): Long

    @NoGC
    @Intrinsic("ulong_and")
    public infix fun and(other: ULong): ULong

    @NoGC
    @Intrinsic("ulong_or")
    public infix fun or(other: ULong): ULong

    @NoGC
    @Intrinsic("ulong_xor")
    public infix fun xor(other: ULong): ULong

    @NoGC
    @Intrinsic("ulong_inv")
    public fun inv(): ULong

    @NoGC
    @Intrinsic("ulong_shl")
    public infix fun shl(count: Long): ULong

    @NoGC
    @Intrinsic("ulong_shr")
    public infix fun shr(count: Long): ULong

    @NoGC
    @Intrinsic("ulong_to_int8")
    public fun toByte(): Byte

    @NoGC
    @Intrinsic("ulong_to_int16")
    public fun toShort(): Short

    @NoGC
    @Intrinsic("ulong_to_int")
    public fun toInt(): Int

    @NoGC
    @Intrinsic("ulong_to_long")
    public fun toLong(): Long

    @NoGC
    @Intrinsic("ulong_to_uint8")
    public fun toUByte(): UByte

    @NoGC
    @Intrinsic("ulong_to_uint16")
    public fun toUShort(): UShort

    @NoGC
    @Intrinsic("ulong_to_uint")
    public fun toUInt(): UInt

    @NoGC
    @Intrinsic("ulong_to_ulong")
    public fun toULong(): ULong

    public override operator fun rangeTo(endpoint: ULong): ULongRange =
        ULongRange(this, endpoint, 1uL, false, true)

    public override operator fun rangeUntil(endpoint: ULong): ULongRange =
        ULongRange(this, endpoint, 1uL, false, false)

    public infix fun until(endpoint: ULong): ULongRange =
        ULongRange(this, endpoint, 1uL, false, false)

    public infix fun downTo(endpoint: ULong): ULongRange =
        ULongRange(this, endpoint, 1uL, true, true)

    public override fun toString(): String = coreULongToString(this)

    public override fun hash(): Long = coreULongHash(this)

    public companion object : ValueEncoder<ULong>, ValueDecoder<ULong>, ValueInspector<ULong> {
        public override fun inspect(value: ULong): ValueView =
            ValueObservation(typeInfo<ULong>().type, None, { ValueShape.Scalar(ScalarValue.Unsigned(value)) })

        public const val MIN_VALUE: ULong = 0uL
        public const val MAX_VALUE: ULong = 18446744073709551615uL

        public override fun encode(value: ULong, encoder: Encoder): Unit =
            encoder.singleValue().writeULong(value.toULong())

        public override fun decode(decoder: Decoder): ULong =
            decoder.singleValue().readULong()
    }
}
