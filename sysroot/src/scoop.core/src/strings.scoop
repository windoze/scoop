/** Immutable UTF-8 text. */
@DocAlias("text")
@Intrinsic("core_string")
public class String : Compare<String>, Add<String, String>, Equals<String>, ToString, Hash, Iterable<Char> {
    /**
     * The UTF-8 byte count, available in constant time.
     */
    public val byteLength: Long get() = coreStringByteLength(this)
    /**
     * The number of Unicode scalar values, computed in O(byteLength) time by scanning UTF-8.
     * Combining marks count separately.
     */
    public val charLength: Long get() = coreStringLength(this)

    /**
     * Compares text exactly, without Unicode normalization or case folding.
     */
    public override operator fun equals(other: String): Boolean {
        if (this === other) { return true }
        val length = byteLength
        if (length != other.byteLength) { return false }
        return length == 0L || compareTo(other) == 0L
    }

    /**
     * Concatenates the two immutable UTF-8 strings.
     */
    @Intrinsic("string_concat")
    public override operator fun plus(other: String): String

    /**
     * Compares strings lexicographically using their Unicode text order.
     */
    @Intrinsic("string_compare_to")
    public override operator fun compareTo(other: String): Long

    /**
     * Returns this immutable string.
     */
    public override fun toString(): String = this
    /**
     * Returns a hash consistent with exact string equality.
     */
    public override fun hash(): Long = coreStringHash(this)

    /**
     * Returns the Unicode scalar at a zero-based scalar index by scanning from the beginning,
     * taking O(byteLength) time in the worst case. An invalid index throws
     * [IndexOutOfBoundsException]. Use iteration for a complete sequential traversal.
     */
    public fun getCharAt(idx: Long): Char {
        val value = coreStringGet(this, idx)
        if (value == None) { throw IndexOutOfBoundsException() }
        return value!!
    }

    /**
     * Returns the scalar-indexed half-open range from `start` to `endExclusive`. Invalid bounds
     * throw [IndexOutOfBoundsException]; an empty range is allowed.
     */
    public fun slice(start: Long, endExclusive: Long): String {
        val result = coreStringSliceBounds(this, start, endExclusive)
        if (result == None) { throw IndexOutOfBoundsException() }
        val bounds = result!!
        return coreStringSliceBytes(this, bounds._1, bounds._2)
    }

    /**
     * Traverses Unicode scalars in order without repeatedly rescanning from the beginning.
     */
    public override operator fun iterator(): Iterator<Char> = StringIterator(this)

    /**
     * Copies Unicode scalars into an immutable character array.
     */
    public fun toCharArray(): Array<Char> {
        val source = iterator()
        return Array<Char>(charLength) { _ -> source.next()!! }
    }

    /**
     * Copies Unicode scalars into independently mutable character slots.
     */
    public fun toMutableCharArray(): MutableArray<Char> {
        val source = iterator()
        return MutableArray<Char>(charLength) { _ -> source.next()!! }
    }

    /**
     * Copies the UTF-8 encoding into an immutable byte array without a NUL terminator.
     */
    public fun toByteArray(): Array<Byte> = coreStringToBytes(this)

    /**
     * Copies the UTF-8 encoding into an independently mutable byte array.
     */
    public fun toMutableByteArray(): MutableArray<Byte> = coreStringToMutableBytes(this)

    /**
     * String construction and scalar encoding, decoding, and inspection operations.
     */
    public companion object : ValueEncoder<String>, ValueDecoder<String>, ValueInspector<String> {
        /**
         * Observes the complete string as a text scalar.
         */
        public override fun inspect(value: String): ValueView =
            ValueObservation(typeInfo<String>().type, Some(value), { ValueShape.Scalar(ScalarValue.String(value)) })

        /**
         * Writes the string through the backend's text scalar operation.
         */
        public override fun encode(value: String, encoder: Encoder): Unit =
            encoder.singleValue().writeString(value)

        /**
         * Reads a string through the backend's text scalar operation.
         */
        public override fun decode(decoder: Decoder): String =
            decoder.singleValue().readString()

        /**
         * Encodes the supplied Unicode scalars as a new UTF-8 string.
         */
        public fun fromChars(chars: List<Char>): String = coreStringFromChars(chars.toArray())

        /**
         * Copies bytes that the unsafe caller guarantees are valid UTF-8.
         */
        @Unsafe
        public fun fromUtf8Unchecked(bytes: List<Byte>): String =
            coreStringFromBytes(bytes.toArray())

        /**
         * Validates and copies UTF-8 bytes. Invalid encoding throws [CharacterCodingException];
         * raw-pointer callers must provide readable, stable memory for the specified length.
         */
        public fun fromUtf8(bytes: List<Byte>): String =
            requireValidUtf8(decodeUtf8(bytes))

        /**
         * Returns decoded UTF-8 text, or None for invalid encoding.
         */
        public fun fromUtf8OrNone(bytes: List<Byte>): String? = decodeUtf8(bytes)._1

        /**
         * Decodes UTF-8 while replacing malformed input with Unicode replacement characters.
         */
        public fun fromUtf8Lossy(bytes: List<Byte>): String = decodeUtf8Lossy(bytes)

        /**
         * Validates and copies UTF-8 bytes. Invalid encoding throws [CharacterCodingException];
         * raw-pointer callers must provide readable, stable memory for the specified length.
         */
        @Unsafe
        public fun fromUtf8(pointer: Ptr<UInt8>, length: Long): String {
            if (length < 0L) { throw IllegalArgumentException() }
            return requireValidUtf8(coreStringDecodeUtf8(pointer, length))
        }

        /**
         * Copies and validates the UTF-8 bytes preceding the first NUL. The unsafe caller must
         * keep the entire terminated region readable and stable.
         */
        @Unsafe
        public fun fromCString(pointer: Ptr<Int8>): String =
            fromUtf8(pointer.cast<UInt8>(), coreCStringLength(pointer).toLong())
    }
}

private fun coreStringHashLong(value: String): Long {
    @Unsafe {
        val length = coreStringByteLength(value)
        var hash = 1469598103934665603uL
        var index = 0L
        while (index < length) {
            hash = (hash.xor(coreStringByteAtUnchecked(value, index).toUByte().toULong())) * 1099511628211uL
            index += 1L
        }
        return hash.toLong()
    }
}

internal fun coreStringHash(value: String): Long {
    val length = coreStringByteLength(value)
    if (length > 32L) { return coreStringHashLong(value) }
    var hash = 1469598103934665603uL
    if (length <= 0L) { return hash.toLong() }
    hash = hash.xor(coreStringByteAt(value, 0L).toUByte().toULong()) * 1099511628211uL
    if (length <= 1L) { return hash.toLong() }
    hash = hash.xor(coreStringByteAt(value, 1L).toUByte().toULong()) * 1099511628211uL
    if (length <= 2L) { return hash.toLong() }
    hash = hash.xor(coreStringByteAt(value, 2L).toUByte().toULong()) * 1099511628211uL
    if (length <= 3L) { return hash.toLong() }
    hash = hash.xor(coreStringByteAt(value, 3L).toUByte().toULong()) * 1099511628211uL
    if (length <= 4L) { return hash.toLong() }
    hash = hash.xor(coreStringByteAt(value, 4L).toUByte().toULong()) * 1099511628211uL
    if (length <= 5L) { return hash.toLong() }
    hash = hash.xor(coreStringByteAt(value, 5L).toUByte().toULong()) * 1099511628211uL
    if (length <= 6L) { return hash.toLong() }
    hash = hash.xor(coreStringByteAt(value, 6L).toUByte().toULong()) * 1099511628211uL
    if (length <= 7L) { return hash.toLong() }
    hash = hash.xor(coreStringByteAt(value, 7L).toUByte().toULong()) * 1099511628211uL
    if (length <= 8L) { return hash.toLong() }
    hash = hash.xor(coreStringByteAt(value, 8L).toUByte().toULong()) * 1099511628211uL
    if (length <= 9L) { return hash.toLong() }
    hash = hash.xor(coreStringByteAt(value, 9L).toUByte().toULong()) * 1099511628211uL
    if (length <= 10L) { return hash.toLong() }
    hash = hash.xor(coreStringByteAt(value, 10L).toUByte().toULong()) * 1099511628211uL
    if (length <= 11L) { return hash.toLong() }
    hash = hash.xor(coreStringByteAt(value, 11L).toUByte().toULong()) * 1099511628211uL
    if (length <= 12L) { return hash.toLong() }
    hash = hash.xor(coreStringByteAt(value, 12L).toUByte().toULong()) * 1099511628211uL
    if (length <= 13L) { return hash.toLong() }
    hash = hash.xor(coreStringByteAt(value, 13L).toUByte().toULong()) * 1099511628211uL
    if (length <= 14L) { return hash.toLong() }
    hash = hash.xor(coreStringByteAt(value, 14L).toUByte().toULong()) * 1099511628211uL
    if (length <= 15L) { return hash.toLong() }
    hash = hash.xor(coreStringByteAt(value, 15L).toUByte().toULong()) * 1099511628211uL
    if (length <= 16L) { return hash.toLong() }
    hash = hash.xor(coreStringByteAt(value, 16L).toUByte().toULong()) * 1099511628211uL
    if (length <= 17L) { return hash.toLong() }
    hash = hash.xor(coreStringByteAt(value, 17L).toUByte().toULong()) * 1099511628211uL
    if (length <= 18L) { return hash.toLong() }
    hash = hash.xor(coreStringByteAt(value, 18L).toUByte().toULong()) * 1099511628211uL
    if (length <= 19L) { return hash.toLong() }
    hash = hash.xor(coreStringByteAt(value, 19L).toUByte().toULong()) * 1099511628211uL
    if (length <= 20L) { return hash.toLong() }
    hash = hash.xor(coreStringByteAt(value, 20L).toUByte().toULong()) * 1099511628211uL
    if (length <= 21L) { return hash.toLong() }
    hash = hash.xor(coreStringByteAt(value, 21L).toUByte().toULong()) * 1099511628211uL
    if (length <= 22L) { return hash.toLong() }
    hash = hash.xor(coreStringByteAt(value, 22L).toUByte().toULong()) * 1099511628211uL
    if (length <= 23L) { return hash.toLong() }
    hash = hash.xor(coreStringByteAt(value, 23L).toUByte().toULong()) * 1099511628211uL
    if (length <= 24L) { return hash.toLong() }
    hash = hash.xor(coreStringByteAt(value, 24L).toUByte().toULong()) * 1099511628211uL
    if (length <= 25L) { return hash.toLong() }
    hash = hash.xor(coreStringByteAt(value, 25L).toUByte().toULong()) * 1099511628211uL
    if (length <= 26L) { return hash.toLong() }
    hash = hash.xor(coreStringByteAt(value, 26L).toUByte().toULong()) * 1099511628211uL
    if (length <= 27L) { return hash.toLong() }
    hash = hash.xor(coreStringByteAt(value, 27L).toUByte().toULong()) * 1099511628211uL
    if (length <= 28L) { return hash.toLong() }
    hash = hash.xor(coreStringByteAt(value, 28L).toUByte().toULong()) * 1099511628211uL
    if (length <= 29L) { return hash.toLong() }
    hash = hash.xor(coreStringByteAt(value, 29L).toUByte().toULong()) * 1099511628211uL
    if (length <= 30L) { return hash.toLong() }
    hash = hash.xor(coreStringByteAt(value, 30L).toUByte().toULong()) * 1099511628211uL
    if (length <= 31L) { return hash.toLong() }
    hash = hash.xor(coreStringByteAt(value, 31L).toUByte().toULong()) * 1099511628211uL
    return hash.toLong()
}

@Intrinsic("string_byte_length")
internal fun coreStringByteLength(value: String): Long

@Intrinsic("string_character_at_byte")
internal fun coreStringCharacterAtByte(value: String, index: Long): Char

@Intrinsic("string_byte_at")
internal fun coreStringByteAt(value: String, index: Long): Byte

@Intrinsic("string_slice_bytes")
internal fun coreStringSliceBytes(value: String, start: Long, endExclusive: Long): String

@Intrinsic("string_from_bytes")
internal fun coreStringFromBytes(value: Array<Byte>): String
