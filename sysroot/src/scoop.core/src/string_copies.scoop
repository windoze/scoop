// Construction-only storage operations. The caller establishes byte bounds;
// writes are confined to an unpublished result until valid UTF-8 is complete.
@Intrinsic("string_allocate_zeroed")
internal fun coreStringAllocateZeroed(length: Long): String

@Unsafe @Intrinsic("string_byte_at_unchecked")
internal fun coreStringByteAtUnchecked(value: String, index: Long): Byte

@Unsafe @Intrinsic("string_set_byte_unchecked")
internal fun coreStringSetByteUnchecked(value: String, index: Long, byte: Byte)

@Unsafe
@Intrinsic("string_copy_utf8_unchecked")
internal fun coreStringCopyUtf8Unchecked(bytes: Ptr<Byte>, length: Long): String

@Intrinsic("string_to_bytes")
internal fun coreStringToBytes(value: String): Array<Byte>

@Intrinsic("string_to_mutable_bytes")
internal fun coreStringToMutableBytes(value: String): MutableArray<Byte>

// The Char caller supplies one valid scalar. Encode it once into a GC-free
// local place, then copy exactly the initialized bytes.
internal fun coreCharToString(code: UInt): String {
    var storage = coreUtf8Word(code)
    @Unsafe {
        return coreStringCopyUtf8Unchecked(addressOf(storage).cast<Byte>(), coreUtf8Width(code))
    }
}
