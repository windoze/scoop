/**
 * A destination for Unicode text that does not prescribe storage or ownership.
 */
public interface TextWriter {
    /**
     * Writes the supplied text without adding a line terminator.
     */
    public fun write(text: String): Unit
}

/**
 * An in-memory [TextWriter] backed by a [StringBuilder].
 */
public class StringWriter public constructor() : TextWriter, ToString {
    private val builder: StringBuilder = StringBuilder()

    /**
     * Appends text to the in-memory result.
     */
    public override fun write(text: String): Unit {
        builder.append(text)
    }

    /**
     * Returns all text written so far.
     */
    public override fun toString(): String = builder.toString()
}
