public enum MemberName {
    Named(String),
    Positional(Long)
}

public enum StorageOrigin {
    Declared,
    Backing(PropertyRef),
    Delegate(PropertyRef),
    Outer,
    Capture,
    Generated
}

public struct FieldInfo(
    val id: FieldRef,
    val owner: TypeRef,
    val name: MemberName,
    val typeUse: TypeUseInfo,
    val isOptionAtDeclaration: Boolean,
    val index: Long,
    val annotations: Array<AnnotationInfo>,
    val visibility: DeclarationVisibility,
    val origin: StorageOrigin,
    val constructorParameter: Option<ParameterRef>
) {
    public val type: TypeRef get() = typeUse.type
}

public enum PropertyStorage {
    Stored(FieldRef),
    Computed,
    Delegated(FieldRef)
}

public struct PropertyInfo(
    val id: PropertyRef,
    val owner: TypeRef,
    val name: String,
    val typeUse: TypeUseInfo,
    val isOptionAtDeclaration: Boolean,
    val index: Long,
    val isMutable: Boolean,
    val visibility: DeclarationVisibility,
    val annotations: Array<AnnotationInfo>,
    val getter: AccessorInfo,
    val setter: Option<AccessorInfo>,
    val storage: PropertyStorage,
    val overrides: Array<PropertyRef>,
    val constructorParameter: Option<ParameterRef>
) {
    public val type: TypeRef get() = typeUse.type
}

public enum AccessorKind {
    Storage,
    Constant,
    Body,
    Abstract
}

public struct AccessorInfo(
    val id: AccessorRef,
    val visibility: DeclarationVisibility,
    val annotations: Array<AnnotationInfo>,
    val kind: AccessorKind
)

public struct TupleElementInfo(val index: Long, val name: String, val typeUse: TypeUseInfo) {
    public val type: TypeRef get() = typeUse.type
}

public enum VariantPayload {
    Unit,
    Named(Array<FieldInfo>),
    Positional(Array<FieldInfo>)
}

public struct VariantInfo(
    val id: VariantRef,
    val owner: TypeRef,
    val name: String,
    val annotations: Array<AnnotationInfo>,
    val index: Long,
    val payload: VariantPayload,
    val constructor: ConstructorInfo
)

public enum ConstructorKind {
    Primary,
    Secondary,
    Variant(VariantRef)
}

public struct ConstructorInfo(
    val id: ConstructorRef,
    val owner: TypeRef,
    val kind: ConstructorKind,
    val visibility: DeclarationVisibility,
    val annotations: Array<AnnotationInfo>,
    val parameters: Array<ParameterInfo>
)

public enum ParameterMember {
    None,
    Field(FieldRef),
    Property(PropertyRef)
}

public struct ParameterInfo(
    val id: ParameterRef,
    val name: String,
    val typeUse: TypeUseInfo,
    val index: Long,
    val annotations: Array<AnnotationInfo>,
    val hasDefault: Boolean,
    val isVararg: Boolean,
    val member: ParameterMember
)
