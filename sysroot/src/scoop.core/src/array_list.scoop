/**
 * A growable indexed list. Appending grows storage geometrically; insertion and removal shift
 * later elements. Clearing releases references in occupied slots.
 */
public class ArrayList<T> public constructor(initialCapacity: Long = 0L): MutableList<T> {
    private var storage: MutableArray<MaybeUninit<T>> =
        MutableArray<MaybeUninit<T>>(initialCapacity) { _ -> MaybeUninit<T>.uninit() }
    private var elementCount: Long = 0L

    /**
     * The current number of element slots visible through the list interface.
     */
    public override val size: Long get() = elementCount

    private fun checkIndex(index: Long) {
        if (index < 0L || index >= elementCount) {
            throw IndexOutOfBoundsException()
        }
    }

    private fun ensureRoom() {
        if (elementCount == storage.size) {
            grow()
        }
    }

    private fun grow() {
        if (elementCount == 9223372036854775807L) {
            coreAllocationOverflow()
        }
        val required = elementCount + 1L
        val capacity = storage.size
        val nextCapacity =
            if (capacity == 0L) {
                8L
            } else {
                if (capacity > 4611686018427387903L) {
                    required
                } else {
                    capacity * 2L
                }
            }
        val old = storage
        val count = elementCount
        val replacement =
            MutableArray<MaybeUninit<T>>(nextCapacity) { _ -> MaybeUninit<T>.uninit() }
        var index = 0L
        while (index < count) {
            replacement[index] = old[index]
            index += 1L
        }
        storage = replacement
    }

    /**
     * Reads the element at a zero-based index; out-of-range indices throw
     * [IndexOutOfBoundsException].
     */
    public override operator fun get(index: Long): T {
        checkIndex(index)
        @Unsafe
        {
            return storage[index].assumeInit()
        }
    }

    /**
     * Replaces an existing element; out-of-range indices throw [IndexOutOfBoundsException].
     */
    public override operator fun set(index: Long, value: T) {
        checkIndex(index)
        storage[index] = MaybeUninit<T>.initialized(value)
    }

    /**
     * Appends an element or inserts it at the supplied index. Indexed insertion shifts later
     * elements.
     */
    public override fun add(value: T) {
        val count = elementCount
        ensureRoom()
        storage[count] = MaybeUninit<T>.initialized(value)
        elementCount = count + 1L
    }

    /**
     * Appends an element or inserts it at the supplied index. Indexed insertion shifts later
     * elements.
     */
    public override fun add(index: Long, value: T) {
        val count = elementCount
        if (index < 0L || index > count) {
            throw IndexOutOfBoundsException()
        }
        ensureRoom()
        val target = storage
        var cursor = count
        while (cursor > index) {
            target[cursor] = target[cursor - 1L]
            cursor = cursor - 1L
        }
        target[index] = MaybeUninit<T>.initialized(value)
        elementCount = count + 1L
    }

    /**
     * Removes and returns the indexed element, shifts later elements, and releases the vacated
     * slot.
     */
    public override fun removeAt(index: Long): T {
        checkIndex(index)
        @Unsafe
        {
            val target = storage
            val result = target[index].assumeInit()
            val last = elementCount - 1L
            var cursor = index
            while (cursor < last) {
                target[cursor] = target[cursor + 1L]
                cursor = cursor + 1L
            }
            target[last] = MaybeUninit<T>.uninit()
            elementCount = last
            return result
        }
    }

    /**
     * Releases all occupied element slots and sets the size to zero.
     */
    public override fun clear() {
        val target = storage
        val count = elementCount
        var cursor = 0L
        while (cursor < count) {
            target[cursor] = MaybeUninit<T>.uninit()
            cursor = cursor + 1L
        }
        elementCount = 0L
    }

    /** Copies the initialized elements into independent immutable array slots. */
    public fun toArray(): Array<T> {
        val count = elementCount
        val source = storage
        return Array<T>(
            count,
            fun(index: Long): T {
                @Unsafe
                {
                    return source[index].assumeInit()
                }
            }
        )
    }

    /** Copies the initialized elements into independent mutable array slots. */
    public fun toMutableArray(): MutableArray<T> {
        val count = elementCount
        val source = storage
        return MutableArray<T>(
            count,
            fun(index: Long): T {
                @Unsafe
                {
                    return source[index].assumeInit()
                }
            }
        )
    }

    /**
     * Traverses the elements in index order and remains exhausted after reaching the end.
     */
    public override operator fun iterator(): Iterator<T> = ListIterator<T>(this, 0L, false)

    /**
     * Builds element-wise inspection and serialization adapters for this container.
     */
    public companion object {
        /**
         * Builds a sequence inspector using the supplied element inspector.
         */
        public fun inspector(element: ValueInspector<T>): ValueInspector<ArrayList<T>> =
            ArrayListInspector<T>(element)

        /**
         * Builds a sequence encoder using the supplied element encoder.
         */
        public fun encoder(element: ValueEncoder<T>): ValueEncoder<ArrayList<T>> =
            ArrayListEncoder<T>(element)

        /**
         * Builds a sequence decoder using the supplied element decoder.
         */
        public fun decoder(element: ValueDecoder<T>): ValueDecoder<ArrayList<T>> =
            ArrayListDecoder<T>(element)

        override interface ValueEncoder<ArrayList<T>> where T.Companion: ValueEncoder<T> {
            /** Encodes logical elements using the element companion. */
            public override fun encode(value: ArrayList<T>, encoder: Encoder): Unit =
                encodeList(value, T.Companion, encoder)
        }

        override interface ValueDecoder<ArrayList<T>> where T.Companion: ValueDecoder<T> {
            /** Decodes a new list using the element companion. */
            public override fun decode(decoder: Decoder): ArrayList<T> =
                decodeSequence(decoder, T.Companion)
        }
    }
}

@NoGC
@Extern(name = "scoop_rt_allocation_overflow", abi = "scoop")
internal fun coreAllocationOverflow()
