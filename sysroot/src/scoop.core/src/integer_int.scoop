@Intrinsic("core_int")
public struct Int :
    Add<Int, Int>,
    Sub<Int, Int>,
    Mul<Int, Int>,
    Div<Int, Int>,
    Rem<Int, Int>,
    UnaryPlus<Int>,
    UnaryMinus<Int>,
    Increment<Int>,
    Decrement<Int>,
    Compare<Int>,
    RangeTo<Int, IntRange>,
    RangeUntil<Int, IntRange>,
    Equals<Int>, ToString, Hash {
    @NoGC @Intrinsic("int_to_float")
    public fun toFloat(): Float

    @NoGC @Intrinsic("int_to_double")
    public fun toDouble(): Double

    @NoGC @Unsafe @Intrinsic("char_from_code_unchecked")
    internal fun characterUnchecked(): Char

    @NoGC
    @Intrinsic("int_equals")
    public override operator fun equals(other: Int): Boolean


    @NoGC
    @Intrinsic("int_unary_plus")
    public override operator fun unaryPlus(): Int

    @NoGC
    @Intrinsic("int_unary_minus")
    public override operator fun unaryMinus(): Int

    @NoGC
    @Intrinsic("int_inc")
    public override operator fun inc(): Int

    @NoGC
    @Intrinsic("int_dec")
    public override operator fun dec(): Int

    @NoGC
    @Intrinsic("int_add")
    public override operator fun plus(other: Int): Int

    @NoGC
    @Intrinsic("int_sub")
    public override operator fun minus(other: Int): Int

    @NoGC
    @Intrinsic("int_mul")
    public override operator fun times(other: Int): Int

    @Intrinsic("int_div")
    public override operator fun div(other: Int): Int

    @Intrinsic("int_rem")
    public override operator fun rem(other: Int): Int

    @NoGC
    @Intrinsic("int_compare_to")
    public override operator fun compareTo(other: Int): Long

    @NoGC
    @Intrinsic("int_and")
    public infix fun and(other: Int): Int

    @NoGC
    @Intrinsic("int_or")
    public infix fun or(other: Int): Int

    @NoGC
    @Intrinsic("int_xor")
    public infix fun xor(other: Int): Int

    @NoGC
    @Intrinsic("int_inv")
    public fun inv(): Int

    @NoGC
    @Intrinsic("int_shl")
    public infix fun shl(count: Long): Int

    @NoGC
    @Intrinsic("int_shr")
    public infix fun shr(count: Long): Int

    @NoGC
    @Intrinsic("int_ushr")
    public infix fun ushr(count: Long): Int

    @NoGC
    @Intrinsic("int_to_int8")
    public fun toByte(): Byte

    @NoGC
    @Intrinsic("int_to_int16")
    public fun toShort(): Short

    @NoGC
    @Intrinsic("int_to_int")
    public fun toInt(): Int

    @NoGC
    @Intrinsic("int_to_long")
    public fun toLong(): Long

    @NoGC
    @Intrinsic("int_to_uint8")
    public fun toUByte(): UByte

    @NoGC
    @Intrinsic("int_to_uint16")
    public fun toUShort(): UShort

    @NoGC
    @Intrinsic("int_to_uint")
    public fun toUInt(): UInt

    @NoGC
    @Intrinsic("int_to_ulong")
    public fun toULong(): ULong

    public override operator fun rangeTo(endpoint: Int): IntRange =
        IntRange(this, endpoint, 1, false, true)

    public override operator fun rangeUntil(endpoint: Int): IntRange =
        IntRange(this, endpoint, 1, false, false)

    public infix fun until(endpoint: Int): IntRange =
        IntRange(this, endpoint, 1, false, false)

    public infix fun downTo(endpoint: Int): IntRange =
        IntRange(this, endpoint, 1, true, true)

    public override fun toString(): String = coreLongToString(this.toLong())

    public override fun hash(): Long = coreLongHash(this.toLong())

    public companion object : ValueEncoder<Int>, ValueDecoder<Int>, ValueInspector<Int> {
        public override fun inspect(value: Int): ValueView =
            ValueObservation(typeInfo<Int>().type, None, { ValueShape.Scalar(ScalarValue.Signed(value.toLong())) })

        public const val MIN_VALUE: Int = -2147483648
        public const val MAX_VALUE: Int = 2147483647

        public override fun encode(value: Int, encoder: Encoder): Unit =
            encoder.singleValue().writeLong(value.toLong())

        public override fun decode(decoder: Decoder): Int =
            decodeSigned(decoder, -2147483648L, 2147483647L).toInt()
    }
}
