/** A signed integer value with arithmetic and comparison operations. */
@DocAlias("integer")
@Intrinsic("core_int")
public struct Int :
    Add<Int, Int>,
    Sub<Int, Int>,
    Mul<Int, Int>,
    Div<Int, Int>,
    Rem<Int, Int>,
    UnaryPlus<Int>,
    UnaryMinus<Int>,
    Increment<Int>,
    Decrement<Int>,
    Compare<Int>,
    RangeTo<Int, IntRange>,
    RangeUntil<Int, IntRange>,
    Equals<Int>, ToString, Hash {
    /**
     * Rounds the integer directly to IEEE binary32 using round-to-nearest, ties-to-even.
     */
    @NoGC @Intrinsic("int_to_float")
    public fun toFloat(): Float

    /**
     * Rounds the integer directly to IEEE binary64 using round-to-nearest, ties-to-even.
     */
    @NoGC @Intrinsic("int_to_double")
    public fun toDouble(): Double

    @NoGC @Unsafe @Intrinsic("char_from_code_unchecked")
    internal fun characterUnchecked(): Char

    /**
     * Compares the mathematical values of two integers of the same type.
     */
    @NoGC
    @Intrinsic("int_equals")
    public override operator fun equals(other: Int): Boolean


    /**
     * Returns the unchanged integer value.
     */
    @NoGC
    @Intrinsic("int_unary_plus")
    public override operator fun unaryPlus(): Int

    /**
     * Returns the additive inverse modulo 2^32, including at the representation boundary.
     */
    @NoGC
    @Intrinsic("int_unary_minus")
    public override operator fun unaryMinus(): Int

    /**
     * Returns the value plus one, wrapping modulo 2^32.
     */
    @NoGC
    @Intrinsic("int_inc")
    public override operator fun inc(): Int

    /**
     * Returns the value minus one, wrapping modulo 2^32.
     */
    @NoGC
    @Intrinsic("int_dec")
    public override operator fun dec(): Int

    /**
     * Returns the sum modulo 2^32; overflow does not throw.
     */
    @NoGC
    @Intrinsic("int_add")
    public override operator fun plus(other: Int): Int

    /**
     * Returns the difference modulo 2^32; overflow does not throw.
     */
    @NoGC
    @Intrinsic("int_sub")
    public override operator fun minus(other: Int): Int

    /**
     * Returns the product modulo 2^32; overflow does not throw.
     */
    @NoGC
    @Intrinsic("int_mul")
    public override operator fun times(other: Int): Int

    /**
     * Returns the quotient truncated toward zero. A zero divisor throws [ArithmeticException]. The
     * minimum value divided by -1 wraps to the minimum value.
     */
    @Intrinsic("int_div")
    public override operator fun div(other: Int): Int

    /**
     * Returns the remainder associated with division truncated toward zero. A zero divisor throws
     * [ArithmeticException]. A nonzero remainder has the dividend's sign.
     */
    @Intrinsic("int_rem")
    public override operator fun rem(other: Int): Int

    /**
     * Returns -1, 0, or 1 using signed mathematical ordering.
     */
    @NoGC
    @Intrinsic("int_compare_to")
    public override operator fun compareTo(other: Int): Long

    /**
     * Returns the bitwise intersection of the 32-bit operands.
     */
    @NoGC
    @Intrinsic("int_and")
    public infix fun and(other: Int): Int

    /**
     * Returns the bitwise union of the 32-bit operands.
     */
    @NoGC
    @Intrinsic("int_or")
    public infix fun or(other: Int): Int

    /**
     * Sets each result bit where the corresponding 32-bit operand bits differ.
     */
    @NoGC
    @Intrinsic("int_xor")
    public infix fun xor(other: Int): Int

    /**
     * Flips all 32 bits of the representation.
     */
    @NoGC
    @Intrinsic("int_inv")
    public fun inv(): Int

    /**
     * Shifts left using the low 5 bits of the Long count; shifted-out bits are discarded.
     */
    @NoGC
    @Intrinsic("int_shl")
    public infix fun shl(count: Long): Int

    /**
     * Shifts right using the low 5 bits of the Long count, replicating the sign bit.
     */
    @NoGC
    @Intrinsic("int_shr")
    public infix fun shr(count: Long): Int

    /**
     * Shifts right with zero fill using the low 5 bits of the Long count.
     */
    @NoGC
    @Intrinsic("int_ushr")
    public infix fun ushr(count: Long): Int

    /**
     * Converts modulo 2^8 and interprets the result as a 8-bit signed integer. The conversion
     * always succeeds.
     */
    @NoGC
    @Intrinsic("int_to_int8")
    public fun toByte(): Byte

    /**
     * Converts modulo 2^16 and interprets the result as a 16-bit signed integer. The conversion
     * always succeeds.
     */
    @NoGC
    @Intrinsic("int_to_int16")
    public fun toShort(): Short

    /**
     * Converts modulo 2^32 and interprets the result as a 32-bit signed integer. The conversion
     * always succeeds.
     */
    @NoGC
    @Intrinsic("int_to_int")
    public fun toInt(): Int

    /**
     * Converts modulo 2^64 and interprets the result as a 64-bit signed integer. The conversion
     * always succeeds.
     */
    @NoGC
    @Intrinsic("int_to_long")
    public fun toLong(): Long

    /**
     * Converts modulo 2^8 and interprets the result as a 8-bit unsigned integer. The conversion
     * always succeeds.
     */
    @NoGC
    @Intrinsic("int_to_uint8")
    public fun toUByte(): UByte

    /**
     * Converts modulo 2^16 and interprets the result as a 16-bit unsigned integer. The conversion
     * always succeeds.
     */
    @NoGC
    @Intrinsic("int_to_uint16")
    public fun toUShort(): UShort

    /**
     * Converts modulo 2^32 and interprets the result as a 32-bit unsigned integer. The conversion
     * always succeeds.
     */
    @NoGC
    @Intrinsic("int_to_uint")
    public fun toUInt(): UInt

    /**
     * Converts modulo 2^64 and interprets the result as a 64-bit unsigned integer. The conversion
     * always succeeds.
     */
    @NoGC
    @Intrinsic("int_to_ulong")
    public fun toULong(): ULong

    /**
     * Creates an ascending range including both this value and the endpoint.
     */
    public override operator fun rangeTo(endpoint: Int): IntRange =
        IntRange(this, endpoint, 1, false, true)

    /**
     * Creates an ascending range including this value and excluding the endpoint.
     */
    public override operator fun rangeUntil(endpoint: Int): IntRange =
        IntRange(this, endpoint, 1, false, false)

    /**
     * Creates an ascending range with an exclusive endpoint.
     */
    public infix fun until(endpoint: Int): IntRange =
        IntRange(this, endpoint, 1, false, false)

    /**
     * Creates a descending range including both endpoints.
     */
    public infix fun downTo(endpoint: Int): IntRange =
        IntRange(this, endpoint, 1, true, true)

    /**
     * Returns the locale-independent decimal representation of this integer.
     */
    public override fun toString(): String = coreLongToString(this.toLong())

    /**
     * Returns a hash consistent with same-type integer equality.
     */
    public override fun hash(): Long {
        @Unsafe { return coreLongHash(this.toLong()) }
    }

    /**
     * Fixed representation bounds and the scalar encoding, decoding, and inspection protocols.
     */
    public companion object : ValueEncoder<Int>, ValueDecoder<Int>, ValueInspector<Int> {
        /**
         * Exposes the integer as a scalar value observation without reference identity.
         */
        public override fun inspect(value: Int): ValueView =
            ValueObservation(typeInfo<Int>().type, None, { ValueShape.Scalar(ScalarValue.Signed(value.toLong())) })

        /**
         * The smallest representable 32-bit signed integer.
         */
        public const val MIN_VALUE: Int = -2147483648
        /**
         * The largest representable 32-bit signed integer.
         */
        public const val MAX_VALUE: Int = 2147483647

        /**
         * Writes the integer through the encoder's single-value container.
         */
        public override fun encode(value: Int, encoder: Encoder): Unit =
            encoder.singleValue().writeLong(value.toLong())

        /**
         * Decodes an integer and rejects values outside the 32-bit signed range with
         * [DecodingException].
         */
        public override fun decode(decoder: Decoder): Int =
            decodeSigned(decoder, -2147483648L, 2147483647L).toInt()
    }
}
