/**
 * The generic operator contract used for `a[index]`. Operand and result types are chosen by the
 * implementation.
 */
public interface IndexGet<Index, Value> {
    /**
     * Implements `a[index]` for this receiver; domain restrictions and failure behavior belong to
     * the implementing type.
     */
    public operator fun get(index: Index): Value
}

/**
 * The generic operator contract used for `a[index] = value`. Operand and result types are chosen
 * by the implementation.
 */
public interface IndexSet<Index, Value> {
    /**
     * Implements `a[index] = value` for this receiver; domain restrictions and failure behavior
     * belong to the implementing type.
     */
    public operator fun set(index: Index, value: Value): Unit
}

/**
 * The generic operator contract used for `a[first, second]`. Operand and result types are chosen
 * by the implementation.
 */
public interface IndexGet2<I, J, Value> {
    /**
     * Implements `a[first, second]` for this receiver; domain restrictions and failure behavior
     * belong to the implementing type.
     */
    public operator fun get(first: I, second: J): Value
}

/**
 * The generic operator contract used for `a[first, second] = value`. Operand and result types are
 * chosen by the implementation.
 */
public interface IndexSet2<I, J, Value> {
    /**
     * Implements `a[first, second] = value` for this receiver; domain restrictions and failure
     * behavior belong to the implementing type.
     */
    public operator fun set(first: I, second: J, value: Value): Unit
}

/**
 * The generic operator contract used for `a()`. Operand and result types are chosen by the
 * implementation.
 */
public interface Invoke0<Result> {
    /**
     * Implements `a()` for this receiver; domain restrictions and failure behavior belong to the
     * implementing type.
     */
    public operator fun invoke(): Result
}

/**
 * The generic operator contract used for `a(argument)`. Operand and result types are chosen by the
