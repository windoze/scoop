 */
public interface Invoke<Arg, Result> {
    /**
     * Implements `a(argument)` for this receiver; domain restrictions and failure behavior belong
     * to the implementing type.
     */
    public operator fun invoke(argument: Arg): Result
}

/**
 * The generic operator contract used for `a(first, second)`. Operand and result types are chosen
 * by the implementation.
 */
public interface Invoke2<A, B, Result> {
    /**
     * Implements `a(first, second)` for this receiver; domain restrictions and failure behavior
     * belong to the implementing type.
     */
    public operator fun invoke(first: A, second: B): Result
}

/**
 * The generic operator contract used for `the first destructured component`. Operand and result
 * types are chosen by the implementation.
 */
public interface Component1<Result> {
    /**
     * Implements `the first destructured component` for this receiver; domain restrictions and
     * failure behavior belong to the implementing type.
     */
    public operator fun component1(): Result
}

/**
 * The generic operator contract used for `the second destructured component`. Operand and result
 * types are chosen by the implementation.
 */
public interface Component2<Result> {
    /**
     * Implements `the second destructured component` for this receiver; domain restrictions and
     * failure behavior belong to the implementing type.
     */
    public operator fun component2(): Result
}
