/**
 * The terminal exception used for cooperative job cancellation.
 */
public class CancellationException public constructor() : Exception(Some("task was cancelled"))

/**
 * Tracks a coroutine and its structured children. Completion waits for children; cancellation
 * requests propagate to children and registered handlers.
 */
public open class Job internal constructor(parent: Job?, private val propagatesFailure: Boolean = true) {
    private val lock: CoroutineLock = CoroutineLock()
    private var parent: Job? = parent
    private val children: ArrayList<Job> = ArrayList<Job>()
    private val completionListeners: CoroutineListeners = CoroutineListeners()
    private val cancellationListeners: CoroutineListeners = CoroutineListeners()
    private var bodyEnded: Boolean = false
    private var completed: Boolean = false
    private var cancelling: Int = 0
    private var cancellation: CancellationException? = None
    private var failure: Throwable? = None

    /**
     * Whether the job and its children have reached a terminal state.
     */
    public val isCompleted: Boolean get() = lock.withLock { completed }
    /**
     * Whether cancellation has been requested for this job.
     */
    public val isCancelled: Boolean get() = lock.withLock { !coroutineAbsent(cancellation) }

    /**
     * Throws the job's cancellation exception when cancellation has been requested.
     */
    public fun ensureActive() {
        val reason = lock.withLock { cancellation }
        when (reason) {
            case Some(error) -> throw error
            case None -> {}
        }
    }

    /**
     * Requests cancellation of this job and its children. Repeated requests preserve the existing
     * cancellation outcome.
     */
    public fun cancel() { requestCancellation(None) }

    /**
     * Registers a cancellation handler and returns a disposable registration; an already-cancelled
     * job invokes it immediately.
     */
    public fun invokeOnCancellation(handler: (CancellationException) -> Unit): Disposable {
        val (listener, callNow, tracked) = lock.withLock {
            if (!coroutineAbsent(cancellation)) {
                if (!completed) cancelling += 1
                return@withLock (CoroutineRegistration(cancellationListeners, { handler(cancellationReason()) }), true, !completed)
            }
            val entry = cancellationListeners.add { handler(cancellationReason()) }
            if (completed) entry.dispose()
            (entry, false, false)
        }
        if (callNow) {
            try { listener.fire() }
            catch (error: Throwable) {
                if (!tracked) throw error
                requestCancellation(Some(error))
            } finally {
                if (tracked) {
                    lock.withLock { cancelling -= 1 }
                    tryComplete()
                }
            }
        }
        return listener
    }

    private fun cancellationReason(): CancellationException = lock.withLock { cancellation!! }

    internal fun attach(child: Job) {
        val cancelChild = lock.withLock {
            if (bodyEnded) throw IllegalStateException(Some("coroutine scope is closed"))
            children.add(child)
            !coroutineAbsent(cancellation)
        }
        if (cancelChild) child.cancel()
    }

    private fun removeChild(child: Job) {
        lock.withLock {
            var index = 0L
            while (index < children.size) {
                if (children[index] === child) {
                    children.removeAt(index)
                    return@withLock
                }
                index += 1L
            }
        }
        tryComplete()
    }

    internal fun finishBody(error: Throwable?) {
        lock.withLock { bodyEnded = true; cancelling += 1 }
        try {
            when (error) {
                case Some(reason) -> requestCancellation(Some(reason))
                case None -> {}
            }
        } finally {
            lock.withLock { cancelling -= 1 }
            tryComplete()
        }
    }

    private fun requestCancellation(error: Throwable?) {
        val dispatch: CoroutineCancellation? = lock.withLock {
            if (completed) return@withLock None
            var propagate: Throwable? = None
            when (error) {
                case Some(reason) -> {
                    if (!(reason is CancellationException) && coroutineAbsent(failure)) {
                        failure = Some(reason)
                        propagate = Some(reason)
                    }
                }
                case None -> {}
            }
            if (coroutineAbsent(cancellation)) cancellation = Some(CancellationException())
            cancelling += 1
            Some(CoroutineCancellation(parent, propagate, children.toArray(), cancellationListeners.take()))
        }
        when (dispatch) {
            case None -> return
            case Some(batch) -> {
                try {
                    when (batch.failure) {
                        case Some(reason) -> {
                            when (batch.parent) {
                                case Some(owner) -> if (propagatesFailure) owner.requestCancellation(Some(reason))
                                case None -> {}
                            }
                        }
                        case None -> {}
                    }
                    for (child in batch.children) child.cancel()
                    for (listener in batch.listeners) {
                        try { listener.fire() }
                        catch (reason: Throwable) { requestCancellation(Some(reason)) }
                    }
                } finally {
                    lock.withLock { cancelling -= 1 }
                    tryComplete()
                }
            }
        }
    }

    private fun tryComplete() {
        val batch: CoroutineCompletion? = lock.withLock {
            if (completed || !bodyEnded || children.size != 0L || cancelling != 0) return@withLock None
            completed = true
            val owner = parent
            parent = None
            for (listener in cancellationListeners.take()) listener.dispose()
            Some(CoroutineCompletion(owner, completionListeners.take()))
        }
        when (batch) {
            case None -> {}
            case Some(done) -> {
                try {
                    when (done.parent) {
                        case Some(owner) -> owner.removeChild(this)
                        case None -> {}
                    }
                } finally { notifyCoroutineListeners(done.listeners) }
            }
        }
    }

    internal fun onCompletion(action: () -> Unit): Disposable {
        val listener = lock.withLock { completionListeners.add(action) }
        if (isCompleted) listener.fire()
        return listener
    }

    internal fun finalFailure(): Throwable? = lock.withLock {
        if (!completed) throw IllegalStateException(Some("task has not completed"))
        if (!coroutineAbsent(failure)) return@withLock failure
        when (cancellation) {
            case Some(reason) -> Some(reason)
            case None -> None
        }
    }

    internal suspend fun joinUncancelled() {
        suspendCoroutine<Unit> { continuation ->
            onCompletion { continuation.resume(Unit) }
        }
    }

    /**
     * Suspends until this job completes, including its children. Joining does not retrieve a
     * deferred result.
     */
    public suspend fun join() {
        suspendCancellableCoroutine<Unit> { continuation ->
            val listener = onCompletion { continuation.tryResume(Unit) }
            continuation.invokeOnCancellation { _ -> listener.dispose() }
        }
    }
}

private class CoroutineCancellation(
    val parent: Job?,
    val failure: Throwable?,
    val children: Array<Job>,
    val listeners: ArrayList<CoroutineRegistration>
)

private class CoroutineCompletion(val parent: Job?, val listeners: ArrayList<CoroutineRegistration>)
