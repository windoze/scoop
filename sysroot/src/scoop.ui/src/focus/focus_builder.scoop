package scoop.ui

import scoop.surface.FocusVisibility

public fun focusOptions(configure: FocusOptionsBuilder.() -> Unit = {}): FocusOptions =
    FocusOptions().copy(configure)

public fun FocusOptions.copy(configure: FocusOptionsBuilder.() -> Unit = {}): FocusOptions {
    val builder = FocusOptionsBuilder(this)
    builder.configure()
    return builder.snapshot()
}

public class FocusOptionsBuilder internal constructor(value: FocusOptions) {
    public var handle: FocusHandle? = value.handle
    public var tabStop: Boolean = value.tabStop
    public var order: Int = value.order
    public var visibility: FocusVisibility = value.visibility
    internal fun snapshot(): FocusOptions = FocusOptions(handle, tabStop, order, visibility)
}
