package scoop.ui

import scoop.graphics.*
import scoop.surface.FrameContext
import scoop.surface.FrameCompletion
import scoop.surface.FrameSubmission
import scoop.surface.InputArea
import scoop.time.TimeMark

internal class ScenePass {
    var presentedChildren = false
    val paintKeys = ArrayList<PaintKey>()
}

/** Geometry, input and child presentation share one frame state, separate from pixel blocks. */
public class SceneContext internal constructor(
    private val node: MountedNode,
    private val frame: FrameContext,
    private val extent: Size,
    private val overlay: OverlayLayout? = None,
    private val pass: ScenePass = ScenePass(),
    private val scrollPath: Array<ScrollReveal> = [],
    private val paintCache: PaintCachePolicy = PaintCachePolicy.None
) {
    public val layoutDirection: LayoutDirection get() {
        checkActive();
        return node.layoutDirection
    }
    private var active = true
    private var borrowed = false
    public val size: Size get() {
        checkActive()
        return extent
    }
    public val time: TimeMark get() {
        checkActive()
        return frame.time
    }
    public val overlayLayout: OverlayLayout? get() {
        checkActive()
        return overlay
    }
    /** Captures current transform and clip without creating an input target. */
    public fun anchor(handle: LayoutAnchor, rect: Rect) {
        checkActive()
        handle.capture(node, node.root.overlays.frame, frame.canvas, rect)
    }
    /** Runs after this frame ends, while this node remains mounted and its root remains open. */
    public fun onFrameComplete(action: (FrameCompletion) -> Unit) {
        checkActive()
        node.root.addCompletion(node, action)
    }
    internal fun checkOwner(owner: MountedNode) {
        checkActive()
        requireUi(node === owner, "scene registration belongs to a different mount")
    }
    private fun checkActive() {
        node.root.checkThread()
        if (!active)
            throw IllegalStateException(Some("scene context has ended"))
        if (borrowed)
            throw IllegalStateException(Some("scene context has an active child scope"))
    }
    /** Runs a pixel-only block with an independent Canvas lifetime and save stack. */
    public fun draw(block: (PaintContext) -> Unit) {
        checkActive()
        borrowed = true
        try {
            frame.canvas.withState {
                canvas ->
                val context = PaintContext(node.root, canvas, extent, frame.time)
                try {
                    block(context)
                } finally {
                    context.end()
                }
            }
        } finally {
            borrowed = false
        }
    }
    /** Records a finite, isolated layer; revision covers every input affecting its pixels. */
    public fun drawLayer(
        key: PaintKey,
        bounds: Rect,
        revision: Long,
        samplingOutset: Double = 1.0,
        block: (PaintContext) -> Unit
    ) {
        checkActive()
        for (previous in pass.paintKeys)
            requireUi(previous !== key, "paint key was already used in this scene")
        pass.paintKeys.add(key)
        borrowed = true
        try {
            node.paintLayers.draw(
                frame.canvas,
                key,
                PaintLayerInput(extent, bounds, revision, samplingOutset),
                paintCache
            ) {
                canvas ->
                val context = PaintContext(node.root, canvas, extent, frame.time)
                try {
                    block(context)
                } finally {
                    context.end()
                }
            }
        } finally {
            borrowed = false
        }
    }
    /** Shares the one child presentation pass while isolating scene state. */
    public fun <T> withState(block: (SceneContext) -> T): T {
        checkActive()
        return withPath(scrollPath, paintCache, block)
    }
    internal fun scrollContent(
        viewport: ScrollViewport,
        layout: ScrollLayout,
        origin: Point,
        block: (SceneContext) -> Unit
    ) {
        checkActive()
        val boundary = node.root.focus.captureScroll(viewport, layout, frame.canvas)
        val path =
            Array<ScrollReveal>(scrollPath.size + 1L) {
                index -> if (index < scrollPath.size)
                    scrollPath[index]
                else
                    boundary
            }
        withPath<Unit>(path, viewport.paintCache) {
            child ->
            val snapshot = layout.snapshot
            child.clipRect(Rect(0.0, 0.0, snapshot.viewport.width, snapshot.viewport.height))
            child.translate(origin.x - snapshot.offset.x, origin.y - snapshot.offset.y)
            block(child)
        }
    }
    private fun <T> withPath(
        path: Array<ScrollReveal>,
        policy: PaintCachePolicy,
        block: (SceneContext) -> T
    ): T {
        borrowed = true
        try {
            return frame.withState {
                childFrame ->
                val child = SceneContext(node, childFrame, extent, overlay, pass, path, policy)
                try {
                    block(child)
                } finally {
                    child.end()
                }
            }
        } finally {
            borrowed = false
        }
    }
    public fun concat(transform: Transform) {
        checkActive()
        frame.canvas.concat(transform)
    }
    public fun translate(x: Double, y: Double) {
        checkActive()
        frame.canvas.translate(x, y)
    }
    public fun scale(x: Double, y: Double) {
        checkActive()
        frame.canvas.scale(x, y)
    }
    public fun rotate(radians: Double) {
        checkActive()
        frame.canvas.rotate(radians)
    }
    public fun clipRect(rect: Rect) {
        checkActive()
        frame.canvas.clipRect(rect)
    }
    public fun clipPath(path: Path) {
        checkActive()
        frame.canvas.clipPath(path)
    }
    public fun save() {
        checkActive()
        frame.canvas.save()
    }
    public fun saveLayer(
        opacity: Double = 1.0,
        filter: ImageFilter? = None,
        blendMode: BlendMode = BlendMode.SrcOver
    ) {
        checkActive()
        frame.canvas.saveLayer(opacity, filter, blendMode)
    }
    public fun restore() {
        checkActive()
        frame.canvas.restore()
    }
    public fun place(area: InputArea, shape: Rect) {
        checkActive()
        frame.place(area, shape)
        node.root.focus.place(area, scrollPath)
    }
    public fun place(area: InputArea, shape: Path) {
        checkActive()
        frame.place(area, shape)
        node.root.focus.place(area, scrollPath)
    }
    public fun children() {
        checkActive()
        if (pass.presentedChildren)
            throw IllegalStateException(Some("children were already presented"))
        pass.presentedChildren = true
        for (index in 0L ..< node.children.size)
            presentChild(index)
    }
    /** Presents a complete permutation without changing logical mount or input ownership. */
    public fun children(order: Array<Long>) {
        checkActive()
        if (pass.presentedChildren)
            throw IllegalStateException(Some("children were already presented"))
        requireUi(order.size == node.children.size, "child order must include every child")
        val visited = MutableArray<Boolean>(node.children.size) { _ -> false }
        for (index in order) {
            requireUi(
                index >= 0L && index < node.children.size,
                "child order index is out of bounds"
            )
            requireUi(!visited[index], "child order contains a duplicate index")
            visited[index] = true
        }
        pass.presentedChildren = true
        for (index in order)
            presentChild(index)
    }
    private fun presentChild(index: Long) {
        val child = node.children[index]
        val placed = node.placements[index] != None
        if (child.participatesInFrame != placed)
            node.root.addCompletion(child) {
                completion -> if (completion.submission == FrameSubmission.Accepted)
                    child.setFrameParticipation(placed)
            }
        when (node.placements[index]) {
            case Some(origin) -> node.children[index].scene(
                frame,
                origin,
                overlay,
                scrollPath,
                paintCache
            )
            case None -> node.children[index].clearPaintSubtree()
        }
    }
    internal fun finish() {
        if (!pass.presentedChildren) {
            for (origin in node.placements)
                if (origin != None)
                    throw IllegalStateException(Some("placed children must be presented"))
            for (index in 0L ..< node.children.size)
                presentChild(index)
        }
        node.paintLayers.retain(pass.paintKeys)
    }
    internal fun end() {
        active = false
    }
}

internal fun MountedNode.scene(
    frame: FrameContext,
    origin: Point,
    overlay: OverlayLayout? = None,
    scrollPath: Array<ScrollReveal> = [],
    paintCache: PaintCachePolicy = PaintCachePolicy.None
) {
    if (!active || !root.isOpen)
        return
    when (body) {
        case Empty -> {}
        case Direction -> children[0L].scene(frame, origin, overlay, scrollPath, paintCache)
        case Component(_) -> children[0L].scene(frame, origin, overlay, scrollPath, paintCache)
        case Portal(instance) -> root.overlays.include(instance)
        case Element(instance) -> sceneElement(frame, origin, overlay, scrollPath, paintCache) {
            context -> instance.value.scene(context)
        }
        case Lazy(instance, _) -> sceneElement(frame, origin, overlay, scrollPath, paintCache) {
            context -> instance.value.scene(context)
        }
    }
}

private fun MountedNode.sceneElement(
    frame: FrameContext,
    origin: Point,
    overlay: OverlayLayout?,
    scrollPath: Array<ScrollReveal>,
    paintCache: PaintCachePolicy,
    draw: (SceneContext) -> Unit
) {
    frame.withState {
        childFrame ->
        childFrame.canvas.translate(origin.x, origin.y)
        val result = metrics ?: throw IllegalStateException(Some("element has not been measured"))
        val context =
            SceneContext(
                this,
                childFrame,
                result.size,
                overlay,
                scrollPath = scrollPath,
                paintCache = paintCache
            )
        try {
            evaluateUi<Unit>(None) { draw(context) }
            if (active && root.isOpen)
                context.finish()
            Unit
        } finally {
            context.end()
        }
    }
}
