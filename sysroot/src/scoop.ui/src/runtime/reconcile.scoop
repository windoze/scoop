package scoop.ui

import scoop.collections.HashMap
import scoop.collections.HashSet

internal fun MountedNode.reconcile(descriptions: Array<View>, turn: UpdateTurn) {
    val keys = HashSet<ViewKey>()
    for (description in descriptions) {
        if (description.key != ViewKey.Position)
            requireUi(keys.add(description.key), "duplicate sibling ViewKey")
    }
    val previous = children
    val keyed = HashMap<ViewKey, Long>()
    var oldIndex = 0L
    for (child in previous) {
        if (child.view.key != ViewKey.Position)
            keyed.put(child.view.key, oldIndex)
        oldIndex += 1L
    }
    val used = MutableArray<Boolean>(previous.size) { _ -> false }
    val matches =
        Array<MountedNode?>(descriptions.size) {
            index ->
            val description = descriptions[index]
            val candidate =
                if (description.key == ViewKey.Position) {
                    if (index < previous.size && previous[index].view.key == ViewKey.Position)
                        Some(index)
                    else
                        None
                } else
                    keyed[description.key]
            when (candidate) {
                case Some(position) -> {
                    val child = previous[position]
                    if (child.view.shape == description.shape) {
                        used[position] = true
                        Some(child)
                    } else
                        None
                }
                case None -> None
            }
        }
    // Remove every stale interaction before running any unmount callback.
    var index = 0L
    for (child in previous) {
        if (!used[index])
            child.deactivate()
        index += 1L
    }
    var failure: Throwable? = None
    index = 0L
    for (child in previous) {
        if (!used[index])
            failure = cleanupUi(failure) { child.unmount() }
        index += 1L
    }
    throwUi(failure)
    if (!root.isOpen)
        return

    val next = ArrayList<MountedNode>()
    val created = ArrayList<MountedNode>()
    try {
        var position = 0L
        for (match in matches) {
            val child =
                when (match) {
                    case Some(value) -> value
                    case None -> {
                        val value = createNode(root, Some(this), descriptions[position])
                        created.add(value)
                        value
                    }
                }
            next.add(child)
            position += 1L
        }
    } catch (error: Throwable) {
        var cleanup: Throwable? = Some(error)
        for (child in created)
            cleanup = cleanupUi(cleanup) { child.unmount() }
        throwUi(cleanup)
    }
    // All surviving and newly allocated nodes remain reachable if a callback fails.
    children = next.toArray()
    index = 0L
    for (child in children) {
        child.replace(descriptions[index])
        child.rebuild(turn)
        index += 1L
    }
}
