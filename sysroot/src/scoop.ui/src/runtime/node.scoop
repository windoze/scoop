package scoop.ui

import scoop.graphics.Point

internal enum NodeBody {
    Empty, Component(ComponentInstance), Element(ElementInstance), Portal(PortalInstance),
    Lazy(LazyInstance, LazyChildren), Direction
}

internal class UpdateTurn

internal class MountedNode(
    val root: UiRoot,
    val parent: MountedNode?,
    var view: View,
    val body: NodeBody
) {
    val depth: Long = (parent?.depth ?: -1L) + 1L
    var layoutDirection: LayoutDirection =
        view.directionOverride ?: parent?.layoutDirection ?: LayoutDirection.Ltr
    val scope = ComponentScope(this)
    val paintLayers = PaintLayers()
    val focusTargets = ArrayList<FocusTarget>()
    var focusScope: FocusScope? = None
    var navigation: KeyNavigation? = None
    var lazyFocus: LazyFocus? = None
    var children: Array<MountedNode> = []
    var active = true
    var mounted = false
    var retired = false
    var queued = false
    var updated: UpdateTurn? = None
    var dependencies: Array<StateSignal> = []
    var metrics: LayoutMetrics? = None
    var placements: Array<Point?> = []
    private var participates = true
    val participatesInFrame: Boolean get() = participates
    var frameEnabled: Boolean = parent?.frameEnabled ?: true

    fun setFrameParticipation(value: Boolean) {
        participates = value
        inheritFrameParticipation(parent?.frameEnabled ?: true)
    }
    private fun inheritFrameParticipation(parentEnabled: Boolean) {
        val next = participates && parentEnabled
        if (next == frameEnabled)
            return
        frameEnabled = next
        if (!next)
            paintLayers.close()
        scope.updateFrameParticipation()
        for (child in children)
            child.inheritFrameParticipation(next)
    }

    fun clearPaintSubtree() {
        var failure: Throwable? = None
        failure = cleanupUi(failure) { paintLayers.close() }
        for (child in children)
            failure = cleanupUi(failure) { child.clearPaintSubtree() }
        throwUi(failure)
    }

    fun invalidate() {
        if (active && root.isOpen && !queued) {
            queued = true
            root.enqueue(this)
        }
    }
    fun replace(next: View) {
        when ((body, next.body)) {
            case(Empty, Empty) -> {}
            case(Direction, Direction(_, _)) -> {}
            case(Component(instance), Component(description)) -> instance.replace(description)
            case(Element(instance), Element(description, _)) -> instance.replace(description)
            case(Portal(instance), Portal(_, open, options)) -> instance.replace(open, options)
            case(Lazy(instance, _), Lazy(description, _, _)) -> instance.replace(description)
            else -> throw IllegalStateException(Some("mismatched mounted view shape"))
        }
        view = next
    }
    fun rebuild(turn: UpdateTurn) {
        if (!active || !root.isOpen)
            return
        updated = Some(turn)
        val previousDirection = layoutDirection
        layoutDirection = view.directionOverride ?: parent?.layoutDirection ?: LayoutDirection.Ltr
        when (body) {
            case Empty -> {}
            case Direction -> when (view.body) {
                case Direction(content, _) -> {
                    if (children.size == 1L && children[0L].view === content)
                        children[0L].refreshDirection(turn)
                    else
                        reconcile([content], turn)
                }
                else -> throw IllegalStateException(
                    Some("direction description was replaced by another shape")
                )
            }
            case Portal(instance) -> when (view.body) {
                case Portal(content, _, _) -> instance.prepare(this, content, turn)
                else -> throw IllegalStateException(
                    Some("portal description was replaced by another shape")
                )
            }
            case Component(instance) -> rebuildComponent(instance, turn, false)
            case Element(instance) -> {
                when (view.body) {
                    case Element(_, descriptions) -> reconcile(descriptions, turn)
                    else -> throw IllegalStateException(
                        Some("element description was replaced by another shape")
                    )
                }
                if (active && root.isOpen && mounted)
                    instance.value.update()
            }
            case Lazy(instance, items) -> {
                when (view.body) {
                    case Lazy(_, source, capacity) -> items.replace(this, source, capacity, turn)
                    else -> throw IllegalStateException(
                        Some("lazy description was replaced by another shape")
                    )
                }
                if (layoutDirection != previousDirection)
                    for (child in children)
                        child.refreshDirection(turn)
                if (active && root.isOpen && mounted)
                    instance.value.update()
            }
        }
    }
    fun mountPending() {
        if (!active || !root.isOpen)
            return
        if (!mounted) {
            when (body) {
                case Empty -> {}
                case Direction -> {}
                case Component(instance) -> instance.value.onMount(scope)
                case Element(instance) -> instance.value.onMount(scope)
                case Portal(instance) -> instance.mount(this)
                case Lazy(instance, _) -> instance.value.onMount(scope)
            }
            mounted = true
            if (active && root.isOpen) {
                when (body) {
                    case Element(instance) -> instance.value.update()
                    case Lazy(instance, items) -> {
                        items.mount(this)
                        instance.value.update()
                    }
                    else -> {}
                }
            }
        }
        for (child in children)
            child.mountPending()
    }
    fun deactivate() {
        if (!active)
            return
        active = false
        queued = false
        var failure: Throwable? = None
        failure =
            cleanupUi(failure) {
                when (body) {
                    case Portal(instance) -> instance.retireInput()
                    else -> {}
                }
            }
        failure = cleanupUi(failure) { scope.deactivate() }
        for (source in dependencies)
            source.unsubscribe(this)
        dependencies = []
        for (child in children)
            failure = cleanupUi(failure) { child.deactivate() }
        throwUi(failure)
    }
    fun unmount() {
        if (retired)
            return
        retired = true
        deactivate()
        var failure: Throwable? = None
        for (child in children)
            failure = cleanupUi(failure) { child.unmount() }
        children = []
        failure = cleanupUi(failure) { throwUi(scope.retireInteraction()) }
        if (mounted) {
            failure =
                cleanupUi(failure) {
                    when (body) {
                        case Empty -> {}
                        case Direction -> {}
                        case Component(instance) -> instance.value.onUnmount()
                        case Element(instance) -> instance.value.onUnmount()
                        case Portal(_) -> {}
                        case Lazy(instance, _) -> instance.value.onUnmount()
                    }
                }
        }
        failure = cleanupUi(failure) { throwUi(scope.release()) }
        failure = cleanupUi(failure) { paintLayers.close() }
        failure = cleanupUi(failure) { releaseInstance(body) }
        metrics = None
        placements = []
        throwUi(failure)
    }
}

internal fun sameTurn(previous: UpdateTurn?, current: UpdateTurn): Boolean =
    when (previous) {
        case Some(value) -> value === current
        case None -> false
    }
