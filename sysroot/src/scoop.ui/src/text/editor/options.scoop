package scoop.ui.text

import scoop.graphics.*
import scoop.graphics.text.*
import scoop.time.Duration
import scoop.ui.*

public enum TextTabBehavior {
    Navigate, Insert
}

public enum TextSubmitKeys {
    None, Enter, PrimaryEnter
}

/** Editing policy is independent of the control's theme and border. */
public class TextEditOptions public constructor(
    public val multiline: Boolean = false,
    public val wrap: Boolean = true,
    public val readOnly: Boolean = false,
    public val enabled: Boolean = true,
    public val tab: TextTabBehavior = TextTabBehavior.Navigate,
    public val submit: TextSubmitKeys = TextSubmitKeys.Enter,
    public val direction: TextDirection? = None,
    public val alignment: TextAlignment = TextAlignment.Start,
    public val paintCache: PaintCachePolicy = PaintCachePolicy.None,
    public val caretBlink: Duration = Duration.milliseconds(500L),
    public val policy: TextEditPolicy = textEditPolicy(),
    public val projection: TextProjection = textProjection(),
    public val copy: TextCopyPolicy = TextCopyPolicy.Default
) {
    internal fun check() {
        requireUi(caretBlink.floorSeconds >= 0L, "negative caret blink interval")
        checkPaintCachePolicy(paintCache)
    }
}

/** Borrows fonts and immutable styles; the host owns only the resulting layouts. */
public class TextEditAppearance public constructor(
    public val fonts: FontCollection,
    public val textStyle: TextStyle = textStyle(),
    public val placeholderStyle: TextStyle = textStyle { this.color = Color(0.5, 0.5, 0.5) },
    public val selectionColor: Color = Color(0.2, 0.45, 0.9, 0.3),
    public val inactiveSelectionColor: Color = Color(0.5, 0.5, 0.5, 0.25),
    public val caretColor: Color = Color.Black,
    public val markedColor: Color = Color.Black,
    public val caretWidth: Double = 1.0
) {
    internal fun check() {
        requireUi(caretWidth.isFinite() && caretWidth > 0.0, "invalid caret width")
        for (color in [selectionColor, inactiveSelectionColor, caretColor, markedColor])
            requireUi(
                color.red.isFinite() &&
                    color.green.isFinite() &&
                    color.blue.isFinite() &&
                    color.alpha.isFinite(),
                "non-finite editor color"
            )
        requireUi(!fonts.isClosed, "editor fonts are closed")
    }
}

public struct TextEditInteraction(
    val focused: Boolean = false,
    val hovered: Boolean = false,
    val focusVisible: Boolean = false
)
