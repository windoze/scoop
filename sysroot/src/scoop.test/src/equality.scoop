package scoop.test

/**
 * Checks `expected.equals(actual)` using the type's declared or structurally available equality
 * operation. Failure records expected and actual values when they can be rendered.
 */
public fun <T : Equals<T>> assertEquals(
    expected: T,
    actual: T,
    message: String? = None,
    location: SourceLocation = currentSourceLocation()
) {
    if (!expected.equals(actual)) {
        comparisonFailure("assertEquals", expected, actual, message, location)
    }
}

/**
 * Fails if `expected.equals(actual)` is true, using the type's available equality operation and
 * preserving the assertion call site.
 */
public fun <T : Equals<T>> assertNotEquals(
    expected: T,
    actual: T,
    message: String? = None,
    location: SourceLocation = currentSourceLocation()
) {
    if (expected.equals(actual)) {
        comparisonFailure("assertNotEquals", expected, actual, message, location)
    }
}

/**
 * Checks `expected.equals(actual)` using the type's declared or structurally available equality
 * operation. Failure records expected and actual values when they can be rendered.
 */
public fun <T : !Equals<T>> assertEquals(
    expected: T,
    actual: T,
    message: String? = None,
    location: SourceLocation = currentSourceLocation()
) where requires(x: T, y: T) { x.equals(y): Boolean } {
    if (!expected.equals(actual)) {
        comparisonFailure("assertEquals", expected, actual, message, location)
    }
}

/**
 * Fails if `expected.equals(actual)` is true, using the type's available equality operation and
 * preserving the assertion call site.
 */
public fun <T : !Equals<T>> assertNotEquals(
    expected: T,
    actual: T,
    message: String? = None,
    location: SourceLocation = currentSourceLocation()
) where requires(x: T, y: T) { x.equals(y): Boolean } {
    if (expected.equals(actual)) {
        comparisonFailure("assertNotEquals", expected, actual, message, location)
    }
}
