package scoop.test

/**
 * Throws [AssertionFailure] unless the condition is true. The default location records the
 * assertion call site.
 */
public fun assertTrue(
    condition: Boolean,
    message: String? = None,
    location: SourceLocation = currentSourceLocation()
) {
    if (!condition) {
        comparisonFailure("assertTrue", true, condition, message, location)
    }
}

/**
 * Throws [AssertionFailure] unless the condition is false. The default location records the
 * assertion call site.
 */
public fun assertFalse(
    condition: Boolean,
    message: String? = None,
    location: SourceLocation = currentSourceLocation()
) {
    if (condition) {
        comparisonFailure("assertFalse", false, condition, message, location)
    }
}
