package scoop.test

/**
 * Checks reference identity rather than value equality and throws [AssertionFailure] for different
 * objects.
 */
public fun <T : ref> assertSame(
    expected: T,
    actual: T,
    message: String? = None,
    location: SourceLocation = currentSourceLocation()
) {
    if (expected !== actual) {
        comparisonFailure("assertSame", expected, actual, message, location)
    }
}

/**
 * Throws [AssertionFailure] when both references identify the same object.
 */
public fun <T : ref> assertNotSame(
    expected: T,
    actual: T,
    message: String? = None,
    location: SourceLocation = currentSourceLocation()
) {
    if (expected === actual) {
        comparisonFailure("assertNotSame", expected, actual, message, location)
    }
}
