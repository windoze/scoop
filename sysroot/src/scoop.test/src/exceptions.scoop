package scoop.test

/**
 * Runs the block and returns the thrown exception if it has the requested type. Normal return or
 * another exception type produces [AssertionFailure]; a mismatched exception is retained as its
 * cause.
 */
public fun <E : Throwable> assertFailsWith(
    message: String? = None,
    location: SourceLocation = currentSourceLocation(),
    block: () -> Unit
): E {
    val caught: Throwable? = try {
        block()
        None
    } catch (error: Throwable) {
        Some(error)
    }
    when (caught) {
        case Some(error) -> {
            if (error is E) return error
            throw AssertionFailure("assertFailsWith", message, location, cause = Some(error))
        }
        case None -> throw AssertionFailure("assertFailsWith", message, location)
    }
}
