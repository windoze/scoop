package scoop.test

import scoop.test.execution.isTestSelected

@Test private class StandaloneSelectionTest {
    @Test fun nameAndIgnoreSelection() {
        assertTrue(isTestSelected(["test", "--scoop-test-filter", "Cases::case"], "2", false, "cone::Cases::case"))
        assertFalse(isTestSelected(["test", "--scoop-test-filter", "case"], "2", true, "cone::Cases::case"))
        assertTrue(isTestSelected(["test", "--scoop-test-filter-ignored", "case"], "2", true, "cone::Cases::case"))
        assertFalse(isTestSelected(["test", "--scoop-test-filter", "missing"], "2", false, "cone::Cases::case"))
        assertFalse(isTestSelected(["test", "--scoop-test-filter"], "2", false, "cone::Cases::case"))
        assertFalse(isTestSelected(["test", "--unknown", "2"], "2", false))
        assertTrue(isTestSelected(["test", "--scoop-test-cases", "2"], "2", true))
    }
}
