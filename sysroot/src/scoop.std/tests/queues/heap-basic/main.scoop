package scoop.std.tests.queues.heap_basic

import scoop.test.*
import scoop.collections.*
import scoop.comparisons.*

class Item(val rank: Int)
class Hook { var action: () -> Unit = {} }
fun check(value: Boolean, label: String, location: SourceLocation = currentSourceLocation()) {
    assertTrue(value, Some(label), location = location)
}

private fun exercise() {
    val values = priorityQueueOf<Int>(5, 2, 4, 2, 1, 3)
    check(values.peek() == 1 && values.peekOrNone() == Some(1), "minimum")
    var previous = -1
    while (values.isNotEmpty()) {
        val current = values.removeFirst()
        check(previous <= current, "ordered removal")
        previous = current
    }
    val empty = values.iterator()
    values.clear()
    check(empty.next() == None && values.removeFirstOrNone() == None && values.peekOrNone() == None, "empty")
    var caught = false
    try { values.peek() } catch (error: NoSuchElementException) { caught = true }
    check(caught, "empty peek")
    caught = false
    try { values.removeFirst() } catch (error: NoSuchElementException) { caught = true }
    check(caught, "empty remove")
    values.add(1)
    check(empty.next() == None, "permanent exhaustion")
    val iterator = values.iterator()
    values.add(2)
    caught = false
    try { iterator.next() } catch (error: ConcurrentModificationException) { caught = true }
    check(caught, "iterator invalidation")

    val reverse = priorityQueueOf<Item>(comparatorOf<Item> { a, b -> b.rank.compareTo(a.rank) }, Item(1), Item(3), Item(2))
    check(reverse.removeFirst().rank == 3 && reverse.removeFirst().rank == 2 && reverse.removeFirst().rank == 1, "custom no bounds")
    val options = priorityQueueOf<Int?>(comparatorOf<Int?> { a, b -> (a ?: -1).compareTo(b ?: -1) }, Some(2), None)
    check(options.removeFirstOrNone() == Some(None), "nested option")

    val hook = Hook()
    val order = comparatorOf<Int> { a, b -> hook.action(); a.compareTo(b) }
    val guarded = priorityQueueOf<Int>(order, 2, 4, 3, 7, 5, 6, 9, 8)
    val before = guarded.iterator()
    hook.action = { throw Exception(Some("compare")) }
    caught = false
    try { guarded.add(1) } catch (error: Exception) { caught = true }
    check(caught && guarded.size == 8L && before.next() == Some(2), "failed add at capacity")
    caught = false
    try { guarded.removeFirst() } catch (error: Exception) { caught = true }
    check(caught && guarded.size == 8L && guarded.peek() == 2, "failed removal")
    hook.action = { hook.action = {}; guarded.add(0) }
    caught = false
    try { guarded.add(1) } catch (error: ConcurrentModificationException) { caught = true }
    check(caught && guarded.size == 9L && guarded.peek() == 0, "reentrant add")
    hook.action = { hook.action = {}; guarded.clear() }
    caught = false
    try { guarded.removeFirst() } catch (error: ConcurrentModificationException) { caught = true }
    check(caught && guarded.isEmpty(), "reentrant remove")

}

@Test
private class ApiTests {
    @Test
    fun behavior() { exercise() }
}
