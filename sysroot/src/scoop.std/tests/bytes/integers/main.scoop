package scoop.std.tests.bytes.integers

import scoop.test.*
import scoop.bytes.*
import scoop.text.*

fun check(ok: Boolean, location: SourceLocation = currentSourceLocation()) {
    assertTrue(ok, location = location)
}
fun golden(bytes: List<Byte>, hex: String) {
    check(bytes.size * 2L == hex.charLength)
    var index = 0L
    while (index < bytes.size) {
        check(bytes[index].toUByte() == hex.substring(index * 2L, index * 2L + 2L).toUByte(16))
        index += 1L
    }
}
fun exercise(order: ByteOrder, expected: String) {
    val builder = ByteArrayBuilder()
    builder.writeInt8(Int8.MIN_VALUE)
    builder.writeUInt8(UInt8.MAX_VALUE)
    builder.writeInt16(Int16.MIN_VALUE, order)
    builder.writeUInt16(UInt16.MAX_VALUE, order)
    builder.writeInt32(Int.MIN_VALUE, order)
    builder.writeUInt32(UInt.MAX_VALUE, order)
    builder.writeInt64(Long.MIN_VALUE, order)
    builder.writeUInt64(ULong.MAX_VALUE, order)
    golden(builder.toByteArray(), expected)
    val reader = ByteArrayReader(builder.toByteArray())
    check(reader.size == 30L && reader.position == 0L && reader.remaining == 30L)
    check(reader.readInt8() == Int8.MIN_VALUE && reader.readUInt8() == UInt8.MAX_VALUE)
    check(reader.readInt16(order) == Int16.MIN_VALUE && reader.readUInt16(order) == UInt16.MAX_VALUE)
    check(reader.readInt32(order) == Int.MIN_VALUE && reader.readUInt32(order) == UInt.MAX_VALUE)
    check(reader.readInt64(order) == Long.MIN_VALUE && reader.readUInt64(order) == ULong.MAX_VALUE)
    check(reader.position == 30L && reader.remaining == 0L)
    reader.seek(2L)
    check(reader.readBytes(2L)[0L] == builder.toByteArray()[2L] && reader.position == 4L)
    reader.skip(2L)
    check(reader.readInt32(order) == Int.MIN_VALUE)
}
private fun exercise() {
    exercise(ByteOrder.BigEndian, "80ff8000ffff80000000ffffffff8000000000000000ffffffffffffffff")
    exercise(ByteOrder.LittleEndian, "80ff0080ffff00000080ffffffff0000000000000080ffffffffffffffff")
    val builder = ByteArrayBuilder()
    builder.writeUInt64(0x0123456789abcdefuL, ByteOrder.BigEndian)
    builder.writeUInt64(0x0123456789abcdefuL, ByteOrder.LittleEndian)
    golden(builder.toByteArray(), "0123456789abcdefefcdab8967452301")
    builder.clear()
    var index = 0L
    while (index < 512L) { builder.writeInt64(index - 256L, ByteOrder.LittleEndian); index += 1L }
    check(builder.size == 4096L)
    val reader = ByteArrayReader(builder.toByteArray())
    index = 0L
    while (index < 512L) { check(reader.readInt64(ByteOrder.LittleEndian) == index - 256L); index += 1L }

}

@Test
private class ApiTests {
    @Test
    fun behavior() { exercise() }
}
