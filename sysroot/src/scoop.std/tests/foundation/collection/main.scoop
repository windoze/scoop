package scoop.std.tests.foundation.collection

import scoop.test.*
class Words(val words: Array<String>) : Collection<String> {
    public override val size: Long get() = words.size
    public override operator fun iterator(): Iterator<String> = words.iterator()
}

fun <T> count(values: Collection<T>): Long {
    var total = 0L
    for (value in values) total += 1L
    if (total != values.size) throw Exception(Some("collection size"))
    return total
}

private fun exercise() {
    val array = [1, 2, 3]
    val mutable = array.toMutableArray()
    val list = ArrayList<Int>()
    list.add(4)
    val viewed: List<Int> = list
    assertEquals(3L, count<Int>(array))
    assertEquals(3L, count<Int>(mutable))
    assertEquals(1L, count<Int>(viewed))
    assertEquals(2L, count<String>(Words(["one", "two"])))
    val iterator = viewed.iterator()
    assertEquals(Some(4), iterator.next())
    list.add(5)
    assertEquals(Some(5), iterator.next())
    assertTrue(iterator.next() == None)
    list.add(6)
    assertTrue(iterator.next() == None)
}

@Test
private class ApiTests {
    @Test
    fun behavior() { exercise() }
}
