package scoop.std.tests.datetime.calendar

import scoop.test.*
// Python datetime provides expected days and weekdays after a 400-year shift.
fun vectors() {
    verify(-999999999, 1, 1, -365243219162L, 1, 1)
    verify(-999999999, 2, 28, -365243219104L, 59, 3)
    verify(-999999999, 3, 1, -365243219103L, 60, 4)
    verify(-999999999, 12, 31, -365243218798L, 365, 1)
    verify(-1000000, 1, 1, -365962028L, 1, 6)
    verify(-1000000, 2, 28, -365961970L, 59, 1)
    verify(-1000000, 3, 1, -365961968L, 61, 3)
    verify(-1000000, 12, 31, -365961663L, 366, 7)
    verify(-400, 1, 1, -865625L, 1, 6)
    verify(-400, 2, 28, -865567L, 59, 1)
    verify(-400, 3, 1, -865565L, 61, 3)
    verify(-400, 12, 31, -865260L, 366, 7)
    verify(-100, 1, 1, -756052L, 1, 1)
    verify(-100, 2, 28, -755994L, 59, 3)
    verify(-100, 3, 1, -755993L, 60, 4)
    verify(-100, 12, 31, -755688L, 365, 1)
    verify(-1, 1, 1, -719893L, 1, 5)
    verify(-1, 2, 28, -719835L, 59, 7)
    verify(-1, 3, 1, -719834L, 60, 1)
    verify(-1, 12, 31, -719529L, 365, 5)
    verify(0, 1, 1, -719528L, 1, 6)
    verify(0, 2, 28, -719470L, 59, 1)
    verify(0, 3, 1, -719468L, 61, 3)
    verify(0, 12, 31, -719163L, 366, 7)
    verify(1, 1, 1, -719162L, 1, 1)
    verify(1, 2, 28, -719104L, 59, 3)
    verify(1, 3, 1, -719103L, 60, 4)
    verify(1, 12, 31, -718798L, 365, 1)
    verify(4, 1, 1, -718067L, 1, 4)
    verify(4, 2, 28, -718009L, 59, 6)
    verify(4, 3, 1, -718007L, 61, 1)
    verify(4, 12, 31, -717702L, 366, 5)
    verify(100, 1, 1, -683003L, 1, 5)
    verify(100, 2, 28, -682945L, 59, 7)
    verify(100, 3, 1, -682944L, 60, 1)
    verify(100, 12, 31, -682639L, 365, 5)
    verify(400, 1, 1, -573431L, 1, 6)
    verify(400, 2, 28, -573373L, 59, 1)
    verify(400, 3, 1, -573371L, 61, 3)
    verify(400, 12, 31, -573066L, 366, 7)
    verify(1582, 1, 1, -141714L, 1, 5)
    verify(1582, 2, 28, -141656L, 59, 7)
    verify(1582, 3, 1, -141655L, 60, 1)
    verify(1582, 12, 31, -141350L, 365, 5)
    verify(1900, 1, 1, -25567L, 1, 1)
    verify(1900, 2, 28, -25509L, 59, 3)
    verify(1900, 3, 1, -25508L, 60, 4)
    verify(1900, 12, 31, -25203L, 365, 1)
    verify(1970, 1, 1, 0L, 1, 4)
    verify(1970, 2, 28, 58L, 59, 6)
    verify(1970, 3, 1, 59L, 60, 7)
    verify(1970, 12, 31, 364L, 365, 4)
    verify(2000, 1, 1, 10957L, 1, 6)
    verify(2000, 2, 28, 11015L, 59, 1)
    verify(2000, 3, 1, 11017L, 61, 3)
    verify(2000, 12, 31, 11322L, 366, 7)
    verify(2024, 1, 1, 19723L, 1, 1)
    verify(2024, 2, 28, 19781L, 59, 3)
    verify(2024, 3, 1, 19783L, 61, 5)
    verify(2024, 12, 31, 20088L, 366, 2)
    verify(9999, 1, 1, 2932532L, 1, 5)
    verify(9999, 2, 28, 2932590L, 59, 7)
    verify(9999, 3, 1, 2932591L, 60, 1)
    verify(9999, 12, 31, 2932896L, 365, 5)
    verify(10000, 1, 1, 2932897L, 1, 6)
    verify(10000, 2, 28, 2932955L, 59, 1)
    verify(10000, 3, 1, 2932957L, 61, 3)
    verify(10000, 12, 31, 2933262L, 366, 7)
    verify(999999999, 1, 1, 365241780107L, 1, 5)
    verify(999999999, 2, 28, 365241780165L, 59, 7)
    verify(999999999, 3, 1, 365241780166L, 60, 1)
