package scoop.std.tests.datetime.date_arithmetic

import scoop.test.*
import scoop.datetime.*
import scoop.collections.*

fun check(ok: Boolean, location: SourceLocation = currentSourceLocation()) {
    assertTrue(ok, location = location)
}
fun overflow(block: () -> Unit) {
    var failed = false
    try { block() } catch (error: ArithmeticException) { failed = true }
    check(failed)
}
private fun exercise() {
    val leap = LocalDate(2024, 2, 29)
    check(leap.plusDays(1L) == LocalDate(2024, 3, 1))
    check(leap.plusYears(1L) == LocalDate(2025, 2, 28))
    check(LocalDate(2024, 1, 31).plusMonths(1L) == leap)
    check(LocalDate(2024, 3, 31).plusMonths(-1L) == leap)
    check(LocalDate(0, 1, 31).plusMonths(-1L) == LocalDate(-1, 12, 31))
    check(LocalDate(-1, 12, 31).plusDays(1L) == LocalDate(0, 1, 1))
    check(LocalDate(0, 12, 31).plusDays(1L) == LocalDate(1, 1, 1))
    check(leap + DatePeriod(years = 1, months = -12) == leap)
    check(leap - DatePeriod(years = 1, months = -12) == leap)
    check(LocalDate(2024, 1, 31) + DatePeriod(months = 1, days = 1L) == LocalDate(2024, 3, 1))
    check(LocalDate(2024, 3, 31) - DatePeriod(months = 1, days = 1L) == LocalDate(2024, 2, 28))
    check(LocalDate(2024, 1, 31) + DatePeriod(days = -31L) == LocalDate(2023, 12, 31))
    check(DatePeriod(years = 1) != DatePeriod(months = 12))
    check(hashMapOf((DatePeriod(), 5))[DatePeriod(0, 0, 0L)] == Some(5))
    val days = LocalDate.MIN.daysUntil(LocalDate.MAX)
    check(LocalDate.MIN.plusDays(days) == LocalDate.MAX)
    check(LocalDate.MAX.plusDays(-days) == LocalDate.MIN)
    check(LocalDate.MAX.daysUntil(LocalDate.MIN) == -days)
    check(LocalDate.MIN.plusYears(1999999998L) == LocalDate(999999999, 1, 1))
    check(YearMonth(0, 1).plusMonths(-1L) == YearMonth(-1, 12))
    check(YearMonth(2024, 2).plusYears(-2024L) == YearMonth(0, 2))
    check(YearMonth(-999999999, 1).plusMonths(23999999987L) == YearMonth(999999999, 12))
    overflow { LocalDate.MIN.plusDays(-1L) }; overflow { LocalDate.MAX.plusDays(1L) }
    overflow { leap.plusDays(Long.MIN_VALUE) }; overflow { leap.plusDays(Long.MAX_VALUE) }
    overflow { leap.plusMonths(Long.MIN_VALUE) }; overflow { leap.plusMonths(Long.MAX_VALUE) }
    overflow { leap.plusYears(Long.MIN_VALUE) }; overflow { leap.plusYears(Long.MAX_VALUE) }
    overflow { LocalDate.MIN - DatePeriod(days = 1L) }
    overflow { leap - DatePeriod(days = Long.MIN_VALUE) }
    overflow { leap + DatePeriod(days = Long.MIN_VALUE) }
    overflow { leap - DatePeriod(years = Int.MIN_VALUE, months = Int.MIN_VALUE) }
    overflow { YearMonth(-999999999, 1).plusMonths(-1L) }
    overflow { YearMonth(999999999, 12).plusMonths(1L) }
    overflow { YearMonth(0, 1).plusYears(Long.MIN_VALUE) }
    overflow { YearMonth(0, 1).plusYears(Long.MAX_VALUE) }

}

@Test
private class ApiTests {
    @Test
    fun behavior() { exercise() }
}
