package scoop.std.tests.algorithms.grouping

import scoop.test.*
import scoop.collections.*
import scoop.comparisons.*

struct Row(val key: Int, val label: String)
class Key(val rank: Int)
fun check(value: Boolean, label: String, location: SourceLocation = currentSourceLocation()) {
    assertTrue(value, Some(label), location = location)
}

private fun exercise() {
    val rows = listOf<Row>(Row(2, "a"), Row(1, "b"), Row(2, "c"), Row(1, "d"))
    val groups = rows.groupBy<Row, Int> { row -> row.key }
    check(groups.keys.toList().joinToString() == "2, 1", "first key order")
    check(groups[2]!!.map<Row, String> { row -> row.label }.joinToString() == "a, c", "group order")
    check(!(groups is MutableMap<Int, List<Row>>) && !(groups[2]!! is MutableList<Row>), "readonly groups")
    val labels = rows.groupBy<Row, Int, String>({ row -> row.key }) { row -> row.label }
    check(labels[1]!!.joinToString() == "b, d", "value transform")
    val destination = sortedMapOf<Key, MutableList<String>>(comparatorOf<Key> { a, b -> a.rank.compareTo(b.rank) })
    destination[Key(2)] = mutableListOf<String>("old")
    check(rows.groupByTo<Row, Key, String>(destination, { row -> Key(row.key) }, { row -> row.label }) === destination, "same target")
    check(destination[Key(2)]!!.joinToString() == "old, a, c", "target comparator equivalence")
    val ordinary = mutableMapOf<Int, MutableList<Row>>()
    rows.groupByTo<Row, Int>(ordinary) { row -> row.key }
    check(ordinary[1]!!.size == 2L, "groupByTo overload")
    val associated = rows.associate<Row, Int, String> { row -> (row.key, row.label) }
    check(associated.keys.toList().joinToString() == "2, 1" && associated[2] == Some("c"), "associate overwrite")
    check(rows.associateBy<Row, Int> { row -> row.key }[1]!!.label == "d", "associateBy")
    check(rows.associateBy<Row, Int, String>({ row -> row.key }) { row -> row.label }[1] == Some("d"), "associateBy transform")
    val lengths = listOf<String>("aa", "b", "aa").associateWith<String, Long> { value -> value.charLength }
    check(lengths.size == 2L && lengths["aa"] == Some(2L) && !(lengths is MutableMap<String, Long>), "associateWith")
    check(rows.distinctBy<Row, Int> { row -> row.key }.map<Row, String> { row -> row.label }.joinToString() == "a, b", "distinctBy")
    check(listOf<Int>(3, 1, 3, 2, 1).distinct().joinToString() == "3, 1, 2", "distinct")
    val partial = mutableMapOf<Int, MutableList<String>>()
    var caught = false
    try {
        rows.groupByTo<Row, Int, String>(partial, { row -> row.key }) { row ->
            if (row.label == "c") throw Exception(Some("value transform"))
            row.label
        }
    } catch (error: Exception) { caught = true }
    check(caught && partial[2]!!.joinToString() == "a" && partial[1]!!.joinToString() == "b", "group prefix")

}

@Test
private class ApiTests {
    @Test
    fun behavior() { exercise() }
}
