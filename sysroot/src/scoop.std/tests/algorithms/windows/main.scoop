package scoop.std.tests.algorithms.windows

import scoop.test.*
import scoop.collections.*

class Reads { var left: Long = 0L; var right: Long = 0L }
class Counting(private val count: Long, private val left: Boolean, private val reads: Reads) : Iterable<Long>, Iterator<Long> {
    private var index: Long = 0L
    public override operator fun iterator(): Iterator<Long> = this
    public override fun next(): Long? {
        if (left) reads.left += 1L else reads.right += 1L
        if (index == count) return None
        val result = index
        index += 1L
        return Some(result)
    }
}
fun check(value: Boolean, location: SourceLocation = currentSourceLocation()) {
    assertTrue(value, location = location)
}

private fun exercise() {
    var count = 0L
    while (count < 12L) {
        val input = Array<Long>(count) { index -> index }
        var size = 1L
        while (size < 6L) {
            var step = 1L
            while (step < 8L) {
                for (partial in listOf<Boolean>(false, true)) {
                    val result = input.windowed<Long>(size, step, partial)
                    var start = 0L
                    var index = 0L
                    while (start < count && (partial || size <= count - start)) {
                        val length = if (size < count - start) size else count - start
                        check(index < result.size && result[index].size == length)
                        var offset = 0L
                        while (offset < length) { check(result[index][offset] == start + offset); offset += 1L }
                        check(!(result[index] is MutableList<Long>))
                        start += step
                        index += 1L
                    }
                    check(index == result.size)
                }
                step += 1L
            }
            size += 1L
        }
        count += 1L
    }
    val chunks = listOf<Int>(1, 2, 3, 4, 5).chunked(2L)
    check(chunks.size == 3L && chunks[2L].joinToString() == "5")
    check(listOf<Int>(1, 2, 3).windowed(2L).map<List<Int>, String> { window -> window.joinToString() }.joinToString(";") == "1, 2;2, 3")
    val indexed = listOf<String>("a", "b").withIndex().toList()
    check(indexed[1L].index == 1L && indexed[1L].value == "b")
    val reads = Reads()
    val zipped = Counting(3L, true, reads).zip<Long, Long>(Counting(1L, false, reads))
    check(zipped.size == 1L && zipped[0L] == (0L, 0L) && reads.left == 2L && reads.right == 2L)
    var rejected = 0
    try { emptyList<Int>().windowed(0L) } catch (error: IllegalArgumentException) { rejected += 1 }
    try { emptyList<Int>().windowed(1L, 0L) } catch (error: IllegalArgumentException) { rejected += 1 }
    try { emptyList<Int>().chunked(-1L) } catch (error: IllegalArgumentException) { rejected += 1 }
    try { emptyList<Int>().take(-1L) } catch (error: IllegalArgumentException) { rejected += 1 }
    try { emptyList<Int>().drop(-1L) } catch (error: IllegalArgumentException) { rejected += 1 }
    check(rejected == 5)

}

@Test
private class ApiTests {
    @Test
    fun behavior() { exercise() }
}
