package scoop.std.tests.random.bounded

import scoop.test.*
import scoop.random.Random
import scoop.collections.*

fun check(ok: Boolean, location: SourceLocation = currentSourceLocation()) {
    assertTrue(ok, location = location)
}
class Scripted public constructor(private val values: List<Int>, private val widths: List<Int>) : Random {
    public var calls: Long = 0L
    public override fun nextBits(bitCount: Int): Int {
        check(calls < values.size && bitCount == widths[calls])
        val value = values[calls]
        calls += 1L
        return value
    }
}
