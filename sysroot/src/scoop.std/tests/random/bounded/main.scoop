package scoop.std.tests.random.bounded

import scoop.test.*
import scoop.collections.*

fun words(vararg values: Int): Scripted = Scripted(values, listOf<Int>(*Array<Int>(values.size) { _ -> 32 }))
private fun exercise() {
    val small = words(0, 5, 6, -1)
    check(small.nextUInt(10u) == 6u && small.calls == 3L)
    check(small.nextInt(-5, 5) == 0 && small.calls == 4L)
    val wide = words(0, 0, 0, 5, 0, 6, -1, -1)
    check(wide.nextULong(10uL) == 6uL && wide.calls == 6L)
    check(wide.nextLong(-5L, 5L) == 0L && wide.calls == 8L)
    val signed = words(0, 1, -1, -2)
    check(signed.nextInt(Int.MIN_VALUE, Int.MAX_VALUE) == Int.MIN_VALUE + 1)
    check(signed.nextInt(Int.MIN_VALUE, Int.MAX_VALUE) == Int.MIN_VALUE)
    check(signed.nextInt(Int.MIN_VALUE, Int.MAX_VALUE) == Int.MAX_VALUE - 1)
    val signedWide = words(0, 0, 0, 1, -1, -1, -1, -2)
    check(signedWide.nextLong(Long.MIN_VALUE, Long.MAX_VALUE) == Long.MIN_VALUE + 1L)
    check(signedWide.nextLong(Long.MIN_VALUE, Long.MAX_VALUE) == Long.MIN_VALUE)
    check(signedWide.nextLong(Long.MIN_VALUE, Long.MAX_VALUE) == Long.MAX_VALUE - 1L)
    val unsigned = words(1, 2, 0, 1, 0, 2)
    check(unsigned.nextUInt(1u, UInt.MAX_VALUE) == 3u)
    check(unsigned.nextULong(1uL, ULong.MAX_VALUE) == 3uL)
    val single = words(-1, 0, 0)
    check(single.nextInt(7, 8) == 7 && single.nextLong(8L, 9L) == 8L && single.calls == 3L)
    val until = words(8, 0, 9, -1, -1)
    check(until.nextInt(10) == 8 && until.nextLong(10L) == 9L)
    check(until.nextUInt() == UInt.MAX_VALUE && until.nextInt() == -1)

}

@Test
private class ApiTests {
    @Test
    fun behavior() { exercise() }
}
