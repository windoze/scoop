package scoop.std.tests.random.seeded

import scoop.test.*
import scoop.random.*

// Values computed independently from the original C implementations.
fun seed0() {
    val random: Random = Random.seeded(0L)
    check(random.nextBits(32).toUInt() == 2582404918u)
    check(random.nextBits(1).toUInt() == 1u)
    check(random.nextBits(17).toUInt() == 13503u)
    check(random.nextBits(0).toUInt() == 0u)
    check(random.nextBits(24).toUInt() == 6989204u)
    check(random.nextBits(26).toUInt() == 49190581u)
    check(random.nextBits(27).toUInt() == 134183963u)
    check(random.nextBits(8).toUInt() == 108u)
    check(random.nextBits(31).toUInt() == 1150310066u)
    check(random.nextBits(32).toUInt() == 3674418187u)
    check(random.nextBits(32).toUInt() == 3946465114u)
    check(random.nextBits(32).toUInt() == 490903871u)
}

fun seed1() {
    val random: Random = Xoshiro256StarStar(1L)
    check(random.nextBits(32).toUInt() == 3019026285u)
    check(random.nextBits(1).toUInt() == 1u)
    check(random.nextBits(17).toUInt() == 75249u)
    check(random.nextBits(0).toUInt() == 0u)
    check(random.nextBits(24).toUInt() == 6565404u)
    check(random.nextBits(26).toUInt() == 46786851u)
    check(random.nextBits(27).toUInt() == 19269912u)
    check(random.nextBits(8).toUInt() == 18u)
    check(random.nextBits(31).toUInt() == 818587366u)
    check(random.nextBits(32).toUInt() == 3724391562u)
    check(random.nextBits(32).toUInt() == 2369575820u)
    check(random.nextBits(32).toUInt() == 4005368139u)
}

fun seed2() {
    val random: Random = Random.seeded(-1L)
    check(random.nextBits(32).toUInt() == 2404720853u)
    check(random.nextBits(1).toUInt() == 1u)
    check(random.nextBits(17).toUInt() == 66492u)
    check(random.nextBits(0).toUInt() == 0u)
    check(random.nextBits(24).toUInt() == 12543373u)
    check(random.nextBits(26).toUInt() == 38065743u)
    check(random.nextBits(27).toUInt() == 98212596u)
    check(random.nextBits(8).toUInt() == 94u)
    check(random.nextBits(31).toUInt() == 1648598215u)
    check(random.nextBits(32).toUInt() == 2691122907u)
    check(random.nextBits(32).toUInt() == 2638299542u)
    check(random.nextBits(32).toUInt() == 1104091897u)
}

fun seed3() {
    val random: Random = Xoshiro256StarStar(Long.MIN_VALUE)
    check(random.nextBits(32).toUInt() == 3491494555u)
    check(random.nextBits(1).toUInt() == 0u)
    check(random.nextBits(17).toUInt() == 35565u)
    check(random.nextBits(0).toUInt() == 0u)
    check(random.nextBits(24).toUInt() == 15060544u)
    check(random.nextBits(26).toUInt() == 43498291u)
    check(random.nextBits(27).toUInt() == 107617027u)
    check(random.nextBits(8).toUInt() == 66u)
    check(random.nextBits(31).toUInt() == 914944317u)
    check(random.nextBits(32).toUInt() == 1654658577u)
    check(random.nextBits(32).toUInt() == 3288331782u)
    check(random.nextBits(32).toUInt() == 4151071699u)
}

fun seed4() {
    val random: Random = Random.seeded(42L)
    check(random.nextBits(32).toUInt() == 360188718u)
    check(random.nextBits(1).toUInt() == 0u)
    check(random.nextBits(17).toUInt() == 89134u)
    check(random.nextBits(0).toUInt() == 0u)
    check(random.nextBits(24).toUInt() == 15513773u)
    check(random.nextBits(26).toUInt() == 66558833u)
    check(random.nextBits(27).toUInt() == 103312681u)
    check(random.nextBits(8).toUInt() == 184u)
    check(random.nextBits(31).toUInt() == 1825379233u)
    check(random.nextBits(32).toUInt() == 3270078066u)
    check(random.nextBits(32).toUInt() == 2505466207u)
    check(random.nextBits(32).toUInt() == 2931112756u)
}
