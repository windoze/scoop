package scoop.std.tests.results.basic

import scoop.test.*
import scoop.*
import scoop.collections.*

class State { var calls: Int = 0 }
class Payload(val text: String)
fun check(value: Boolean, label: String, location: SourceLocation = currentSourceLocation()) {
    assertTrue(value, Some(label), location = location)
}

private fun exercise() {
    val good = Result.Success<Int, String>(7)
    val bad = Result.Failure<Int, String>("missing")
    check(good.isSuccess && !good.isFailure && bad.isFailure && !bad.isSuccess, "tags")
    check(good.getOrNone() == Some(7) && good.errorOrNone() == None, "success projection")
    check(bad.getOrNone() == None && bad.errorOrNone() == Some("missing"), "error projection")
    val state = State()
    check(good.getOrElse { _ -> throw Exception(Some("unexpected fallback")) } == 7, "lazy success")
    check(bad.getOrElse { error -> state.calls += 1; error.charLength.toInt() } == 7 && state.calls == 1, "error fallback once")
    check(good.fold<Int, String, String>({ value -> value.toString() }) { _ -> "failure" } == "7", "success fold")
    check(bad.fold<Int, String, String>({ _ -> "success" }) { error -> error } == "missing", "error fold")
    val mapped = good.map<Int, String, String> { value -> f"n=${value}" }
    check(mapped.getOrNone() == Some("n=7"), "map changes value type")
    check(bad.map<Int, String, String> { _ -> throw Exception(Some("unexpected map")) }.errorOrNone() == Some("missing"), "map failure")
    check(bad.mapError<Int, String, Long> { error -> error.charLength }.errorOrNone() == Some(7L), "mapError changes error type")
    check(good.mapError<Int, String, Long> { _ -> throw Exception(Some("unexpected error map")) }.getOrNone() == Some(7), "mapError success")
    check(good.flatMap<Int, String, Long> { value -> Result.Success<Long, String>(value.toLong()) }.getOrNone() == Some(7L), "flatMap success")
    check(good.flatMap<Int, String, Long> { _ -> Result.Failure<Long, String>("rejected") }.errorOrNone() == Some("rejected"), "flatMap returned failure")
    check(bad.flatMap<Int, String, Long> { _ -> throw Exception(Some("unexpected flatMap")) }.errorOrNone() == Some("missing"), "flatMap failure")
    check(bad.recover { error -> error.charLength.toInt() }.getOrNone() == Some(7), "recover")
    check(good.recover { _ -> throw Exception(Some("unexpected recover")) }.getOrNone() == Some(7), "recover success")
    val payload = Payload("alive")
    val result = Result.Success<Payload, Payload>(payload)
    val unchanged = result.onSuccess { value -> check(value === payload, "action payload"); state.calls += 1 }
        .onFailure { _ -> throw Exception(Some("unexpected failure action")) }
    check(unchanged.getOrNone()!! === payload && state.calls == 2, "onSuccess preserves reference")
    val failure = Result.Failure<Payload, Payload>(payload).onFailure { value -> check(value === payload, "error payload"); state.calls += 1 }
        .onSuccess { _ -> throw Exception(Some("unexpected success action")) }
    check(failure.errorOrNone()!! === payload && state.calls == 3, "onFailure preserves reference")
    val values = listOf<Result<Int, String>>(good, bad, Result.Success<Int, String>(9))
    check(values.mapNotNone<Result<Int, String>, Int> { value -> value.toOption() }.joinToString() == "7, 9", "collection combination")
    check(Result.Success<Int?, String?>(None).getOrNone() == Some(None), "nested success option")
    check(Result.Failure<Int?, String?>(None).errorOrNone() == Some(None), "nested error option")

}

@Test
private class ApiTests {
    @Test
    fun behavior() { exercise() }
}
