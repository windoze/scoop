package scoop.std.tests.consumer.uuid_artifacts

import scoop.test.*
import scoop.uuid.Uuid
import scoop.random.Random
import scoop.io.encoding.Base64
import scoop.collections.*
import scoop.sequences.sequenceOf
import scoop.sequences.shuffled
import scoop.sequences.toList

fun check(ok: Boolean) { if (!ok) throw IllegalStateException() }
private fun exerciseConsumer() {
    val random = Random.seeded(Long.MIN_VALUE)
    val map = sortedMapOf<Uuid, String>()
    var index = 0
    while (index < 64) {
        val id = Uuid.random(random)
        val payload = Base64.UrlSafe.encode(id.toByteArray())
        map[id] = payload
        check(Uuid.fromByteArray(Base64.UrlSafe.decode(payload)) == Uuid.parse(id.toString()))
        index += 1
    }
    check(map.size == 64L)
    val selected = map.keys.random<Uuid>(random)
    check(map.containsKey(selected))
    val sequence = sequenceOf<Uuid>(Uuid.NIL, selected, Uuid.MAX).shuffled<Uuid>(random).toList<Uuid>()
    check(sequence.toSet<Uuid>().size == 3L)

}

@Test
private class ConsumerTests {
    @Test
    fun behavior() { exerciseConsumer() }
}
