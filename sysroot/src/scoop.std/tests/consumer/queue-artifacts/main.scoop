package scoop.std.tests.consumer.queue_artifacts

import scoop.test.*
import scoop.collections.*
import scoop.comparisons.*

struct Event(val rank: Long, val message: String)

private fun exerciseConsumer() {
    val deque = ArrayDeque<Event>()
    deque.addFirst(Event(3L, "c"))
    deque.addLast(Event(1L, "a"))
    deque.addFirst(Event(2L, "b"))
    val queue = PriorityQueue<Event>(comparatorOf<Event> { a, b -> a.rank.compareTo(b.rank) })
    while (deque.isNotEmpty()) queue.add(deque.removeFirst())
    gcCollect()
    assertEquals("a", queue.removeFirst().message)
    assertEquals("b", queue.removeFirst().message)
    assertEquals("c", queue.removeFirst().message)
    assertTrue(deque.isEmpty() && queue.isEmpty())
}

@Test
private class ConsumerTests {
    @Test
    fun behavior() { exerciseConsumer() }
}
