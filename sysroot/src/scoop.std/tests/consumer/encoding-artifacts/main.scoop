package scoop.std.tests.consumer.encoding_artifacts

import scoop.test.*
import scoop.bytes.*
import scoop.io.encoding.Base64
import scoop.io.encoding.Base64.PaddingOption
import scoop.text.*

private fun exerciseConsumer() {
    val builder = ByteArrayBuilder()
    builder.writeInt32(42, ByteOrder.BigEndian)
    builder.writeDouble(Double.fromBits(0x7ff0000000000123L), ByteOrder.LittleEndian)
    val hex = builder.toByteArray().toHexString()
    val codec = Base64.UrlSafe.withPadding(PaddingOption.Absent)
    val frame = codec.encode(hex.hexToByteArray())
    val reader = ByteArrayReader(codec.decode(frame))
    if (reader.readInt32(ByteOrder.BigEndian) != 42 ||
        reader.readDouble(ByteOrder.LittleEndian).toBits() != 0x7ff0000000000123L || reader.remaining != 0L) throw IllegalStateException()

}

@Test
private class ConsumerTests {
    @Test
    fun behavior() { exerciseConsumer() }
}
