package scoop.std.tests.consumer.datetime_artifacts

import scoop.test.*
import scoop.datetime.*
import scoop.time.*
import scoop.random.Random
import scoop.uuid.Uuid
import scoop.collections.*
import scoop.sequences.*

fun check(ok: Boolean) { if (!ok) throw IllegalStateException() }
private fun exerciseConsumer() {
    val random = Random.seeded(42L)
    val events = sortedMapOf<Instant, Uuid>()
    val offset = UtcOffset.fromHoursMinutesSeconds(5, 45)
    var index = 0
    while (index < 32) {
        val moment = Instant.fromEpochSeconds(random.nextLong(-10000000000L, 10000000000L), random.nextLong(1000000000L))
        val local = moment.toLocalDateTime(offset)
        check(local.toInstant(offset) == moment)
        check(Instant.parse(OffsetDateTime(local, offset).toString()) == moment)
        check(LocalDate.fromEpochDays(local.date.toEpochDays()) == local.date)
        check(LocalTime.fromNanosecondOfDay(local.time.toNanosecondOfDay()) == local.time)
        check(YearMonth.parse(local.date.yearMonth.toString()) == local.date.yearMonth)
        check(local + DateTimePeriod(DatePeriod(months = 1), 1.days()) ==
            LocalDateTime(local.date.plusMonths(1L).plusDays(1L), local.time))
        events.put(moment, Uuid.random(random))
        index += 1
    }
    val restored = events.keys.asSequence().map<Instant, Instant> { value -> Instant.parse(value.toString()) }.toList()
    check(restored.size == 32L)
    var position = 1L
    while (position < restored.size) {
        val first = restored[position - 1L]
        val second = restored[position]
        check(first < second && first + (second - first) == second)
        position += 1L
    }
    val midnight = LocalDateTime(2024, 2, 29, 0, 0)
    check(midnight.toInstant(offset).toString() == "2024-02-28T18:15:00Z")

}

@Test
private class ConsumerTests {
    @Test
    fun behavior() { exerciseConsumer() }
}
