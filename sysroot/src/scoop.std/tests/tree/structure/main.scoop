package scoop.std.tests.tree.structure

import scoop.test.*
import scoop.collections.*
import scoop.comparisons.*

class Count { var comparisons: Long = 0L }

private fun exercise() {
    verifyBTreeStructure()
    val count = Count()
    val order = comparatorOf<Int> { left, right -> count.comparisons += 1L; left.compareTo(right) }
    val values = TreeMap<Int, Int>(order)
    var index = 0
    while (index < 2048) { values[index] = index; index += 1 }
    if (count.comparisons >= 2048L * 32L) throw Exception(Some("unbalanced insertion"))
    count.comparisons = 0L
    index = 0
    while (index < 2048) { values.remove(index); index += 1 }
    if (count.comparisons >= 2048L * 32L || values.size != 0L) throw Exception(Some("unbalanced deletion"))

}

@Test
private class ApiTests {
    @Test
    fun behavior() { exercise() }
}
