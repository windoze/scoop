package scoop.std.tests.duration.arithmetic

import scoop.test.*
import scoop.time.Duration

fun check(ok: Boolean, location: SourceLocation = currentSourceLocation()) {
    assertTrue(ok, location = location)
}
fun duration(parts: (Long, Int)): Duration = Duration.seconds(parts._1, parts._2.toLong())
fun verify(expected: (Long, Int)?, operation: () -> Duration) {
    when (expected) {
        case Some(parts) -> {
            // Arithmetic vectors use normalized seconds and a nonnegative remainder.
            val actual = operation()
            check((actual.floorSeconds, actual.nanosecondsOfSecond) == parts)
        }
        case None -> {
            var failed = false
            try { operation() } catch (error: ArithmeticException) { failed = true }
            check(failed)
        }
    }
}
fun addition(first: (Long, Int), second: (Long, Int), sum: (Long, Int)?, difference: (Long, Int)?) {
    val a = duration(first)
    val b = duration(second)
    verify(sum) { a + b }; verify(difference) { a - b }
}
fun scaling(parts: (Long, Int), factor: Long, product: (Long, Int)?, quotient: (Long, Int)?) {
    val value = duration(parts)
    verify(product) { value * factor }; verify(quotient) { value / factor }
}
private fun exercise() {
    addVectors0(); addVectors1(); addVectors2()
    scaleVectors0(); scaleVectors1(); scaleVectors2(); scaleVectors3()

}

@Test
private class ApiTests {
    @Test
    fun behavior() { exercise() }
}
