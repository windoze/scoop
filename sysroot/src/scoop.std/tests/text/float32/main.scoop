package scoop.std.tests.text.float32

import scoop.test.*
import scoop.text.*

fun check(value: Boolean, label: String, location: SourceLocation = currentSourceLocation()) {
    assertTrue(value, Some(label), location = location)
}
fun expect(text: String, expected: Float) {
    val value = text.toFloat()
    check(value == expected, text)
    if (value == 0f) check(1f / value == 1f / expected, "zero sign: " + text)
}
fun reject(text: String) { check(text.toFloatOrNone() == None, "overflow: " + text) }
private fun exercise() {
    vectors0()
    vectors1()
    vectors2()
    vectors3()
    vectors4()
    vectors5()
    vectors6()

}

@Test
private class ApiTests {
    @Test
    fun behavior() { exercise() }
}
