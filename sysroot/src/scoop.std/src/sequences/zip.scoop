package scoop.sequences

private class ZippingIterator<T, R>(private val left: Iterator<T>, private val right: Iterator<R>) : Iterator<(T, R)> {
    public override fun next(): (T, R)? = when (left.next()) {
        case None -> None
        case Some(first) -> when (right.next()) {
            case None -> None
            case Some(second) -> Some((first, second))
        }
    }
}

public fun <T, R> Sequence<T>.zip(other: Sequence<R>): Sequence<(T, R)> =
    FactorySequence<(T, R)> { ZippingIterator<T, R>(iterator(), other.iterator()) }
