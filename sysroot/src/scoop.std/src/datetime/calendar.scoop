package scoop.datetime

// Civil date formulas by Howard Hinnant; see licenses/DATE-ALGORITHMS.txt.
internal fun calendarFloorDiv(value: Long, divisor: Long): Long =
    value / divisor - (if (value % divisor < 0L) 1L else 0L)

internal fun calendarLeapYear(year: Int): Boolean = year % 4 == 0 && (year % 100 != 0 || year % 400 == 0)

internal fun calendarMonthLength(year: Int, month: Int): Int =
    if (month == 2) (if (calendarLeapYear(year)) 29 else 28)
    else if (month == 4 || month == 6 || month == 9 || month == 11) 30 else 31

internal fun validCalendarDate(year: Int, month: Int, day: Int): Boolean =
    year >= -999999999 && year <= 999999999 && month >= 1 && month <= 12 &&
    day >= 1 && day <= calendarMonthLength(year, month)

internal fun calendarEpochDay(year: Int, month: Int, day: Int): Long {
    val adjustedYear = year.toLong() - (if (month <= 2) 1L else 0L)
    val era = calendarFloorDiv(adjustedYear, 400L)
    val yearOfEra = adjustedYear - era * 400L
    val shiftedMonth = month.toLong() + (if (month > 2) -3L else 9L)
    val dayOfYear = (153L * shiftedMonth + 2L) / 5L + day.toLong() - 1L
    return era * 146097L + yearOfEra * 365L + yearOfEra / 4L - yearOfEra / 100L + dayOfYear - 719468L
}

internal fun calendarDateFromDay(day: Long): (Int, Int, Int) {
    val shifted = day + 719468L
    val era = calendarFloorDiv(shifted, 146097L)
    val dayOfEra = shifted - era * 146097L
    val yearOfEra = (dayOfEra - dayOfEra / 1460L + dayOfEra / 36524L - dayOfEra / 146096L) / 365L
    val year = yearOfEra + era * 400L
    val dayOfYear = dayOfEra - (365L * yearOfEra + yearOfEra / 4L - yearOfEra / 100L)
    val shiftedMonth = (5L * dayOfYear + 2L) / 153L
    val dayOfMonth = dayOfYear - (153L * shiftedMonth + 2L) / 5L + 1L
    val month = shiftedMonth + (if (shiftedMonth < 10L) 3L else -9L)
    return ((year + (if (month <= 2L) 1L else 0L)).toInt(), month.toInt(), dayOfMonth.toInt())
}

internal fun shiftedCalendarMonth(year: Int, month: Int, amount: Long): (Int, Int) {
    val current = year.toLong() * 12L + month.toLong() - 1L
    if (amount < -11999999988L - current || amount > 11999999999L - current) throw ArithmeticException()
    val target = current + amount
    val targetYear = calendarFloorDiv(target, 12L)
    return (targetYear.toInt(), (target - targetYear * 12L + 1L).toInt())
}

internal fun checkCalendarYearShift(year: Int, amount: Long) {
    if (amount < -999999999L - year.toLong() || amount > 999999999L - year.toLong()) throw ArithmeticException()
}
