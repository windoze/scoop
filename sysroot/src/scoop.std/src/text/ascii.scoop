package scoop.text

private fun String.convertAscii(uppercase: Boolean): String {
    val chars = toMutableCharArray()
    var index = 0L
    while (index < chars.size) {
        val code = chars[index].code
        if (uppercase && code >= 97 && code <= 122) chars[index] = (code - 32).toChar()
        if (!uppercase && code >= 65 && code <= 90) chars[index] = (code + 32).toChar()
        index += 1L
    }
    return String.fromChars(chars)
}

/**
 * Maps ASCII A-Z to a-z, leaving all other Unicode scalars unchanged.
 */
public fun String.lowercaseAscii(): String = convertAscii(false)
/**
 * Maps ASCII a-z to A-Z, leaving all other Unicode scalars unchanged.
 */
public fun String.uppercaseAscii(): String = convertAscii(true)
