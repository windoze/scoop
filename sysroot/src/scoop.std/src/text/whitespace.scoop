package scoop.text

// Unicode 17.0.0 PropList.txt, White_Space (25 scalars).
// Copyright 2025 Unicode, Inc. See licenses/Unicode-3.0.txt.
internal fun isTextWhitespace(value: Char): Boolean {
    val code = value.code
    return (code >= 0x9 && code <= 0xD) || code == 0x20 || code == 0x85 || code == 0xA0 || code == 0x1680 ||
        (code >= 0x2000 && code <= 0x200A) || code == 0x2028 || code == 0x2029 || code == 0x202F || code == 0x205F || code == 0x3000
}

/**
 * Returns whether every scalar satisfies the predicate, or Unicode White_Space when no predicate
 * is supplied. Empty text is blank.
 */
public fun String.isBlank(predicate: (Char) -> Boolean): Boolean {
    for (value in this) { if (!predicate(value)) return false }
    return true
}

/**
 * Returns whether at least one scalar fails the predicate, or is not Unicode White_Space when no
 * predicate is supplied.
 */
public fun String.isNotBlank(predicate: (Char) -> Boolean): Boolean = !isBlank(predicate)
/**
 * Returns whether every scalar satisfies the predicate, or Unicode White_Space when no predicate
 * is supplied. Empty text is blank.
 */
public fun String.isBlank(): Boolean = isBlank(::isTextWhitespace)
/**
 * Returns whether at least one scalar fails the predicate, or is not Unicode White_Space when no
 * predicate is supplied.
 */
public fun String.isNotBlank(): Boolean = !isBlank()
