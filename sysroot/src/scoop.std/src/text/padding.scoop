package scoop.text

/**
 * Concatenates this string a nonnegative number of times; zero yields an empty string and size
 * overflow throws.
 */
public fun String.repeat(count: Long): String {
    if (count < 0L) throw IllegalArgumentException(Some("negative repeat count"))
    if (count == 0L || byteLength == 0L) return ""
    checkedTextProduct(byteLength, count)
    val result = StringBuilder()
    var part = this
    var remaining = count
    while (remaining > 0L) {
        if (remaining % 2L != 0L) result.append(part)
        remaining /= 2L
        if (remaining > 0L) part = part + part
    }
    return result.toString()
}

private fun String.padding(length: Long, paddingChar: Char): String {
    if (length < 0L) throw IllegalArgumentException(Some("negative padding length"))
    val count = length - this.charLength
    if (count <= 0L) return ""
    checkedTextSum(byteLength, checkedTextProduct(charByteLength(paddingChar), count))
    return paddingChar.toString().repeat(count)
}

/**
 * Prepends the padding scalar until the requested nonnegative character length is reached; longer
 * input is preserved.
 */
public fun String.padStart(length: Long, paddingChar: Char = ' '): String = padding(length, paddingChar) + this
/**
 * Appends the padding scalar until the requested nonnegative character length is reached; longer
 * input is preserved.
 */
public fun String.padEnd(length: Long, paddingChar: Char = ' '): String = this + padding(length, paddingChar)
