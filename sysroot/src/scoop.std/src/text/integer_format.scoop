package scoop.text

private fun formatInteger(magnitude: ULong, negative: Boolean, radix: Int): String {
    requireTextRadix(radix)
    if (magnitude == 0uL) return "0"
    val chars = ArrayList<Char>()
    val base = radix.toULong()
    var remaining = magnitude
    while (remaining > 0uL) {
        val digit = (remaining % base).toInt()
        chars.add((if (digit < 10) 48 + digit else 87 + digit).toChar())
        remaining /= base
    }
    if (negative) chars.add('-')
    return String.fromChars(Array<Char>(chars.size) { index -> chars[chars.size - 1L - index] })
}

private fun formatSignedInteger(value: Long, radix: Int): String {
    val negative = value < 0L
    val magnitude = if (negative) 0uL - value.toULong() else value.toULong()
    return formatInteger(magnitude, negative, radix)
}

/**
 * Formats this integer in radix 2..36 using lowercase digits and a leading minus for negative
 * signed values.
 */
public fun Int8.toString(radix: Int): String = formatSignedInteger(toLong(), radix)
/**
 * Formats this integer in radix 2..36 using lowercase digits and a leading minus for negative
 * signed values.
 */
public fun Int16.toString(radix: Int): String = formatSignedInteger(toLong(), radix)
/**
 * Formats this integer in radix 2..36 using lowercase digits and a leading minus for negative
 * signed values.
 */
public fun Int.toString(radix: Int): String = formatSignedInteger(toLong(), radix)
/**
 * Formats this integer in radix 2..36 using lowercase digits and a leading minus for negative
 * signed values.
 */
public fun Long.toString(radix: Int): String = formatSignedInteger(this, radix)
/**
 * Formats this integer in radix 2..36 using lowercase digits and a leading minus for negative
 * signed values.
 */
public fun UInt8.toString(radix: Int): String = formatInteger(toULong(), false, radix)
/**
 * Formats this integer in radix 2..36 using lowercase digits and a leading minus for negative
 * signed values.
 */
public fun UInt16.toString(radix: Int): String = formatInteger(toULong(), false, radix)
/**
 * Formats this integer in radix 2..36 using lowercase digits and a leading minus for negative
 * signed values.
 */
public fun UInt.toString(radix: Int): String = formatInteger(toULong(), false, radix)
/**
 * Formats this integer in radix 2..36 using lowercase digits and a leading minus for negative
 * signed values.
 */
public fun ULong.toString(radix: Int): String = formatInteger(this, false, radix)
