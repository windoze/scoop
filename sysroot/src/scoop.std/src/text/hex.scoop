package scoop.text

import scoop.bytes.ByteArrayBuilder

/**
 * Encodes each byte as two hexadecimal digits, using the selected letter case.
 */
public fun List<Byte>.toHexString(uppercase: Boolean = false): String {
    val length = size
    val chars = MutableArray<Char>(checkedTextProduct(length, 2L)) { _ -> '0' }
    val alphabet = if (uppercase) "0123456789ABCDEF" else "0123456789abcdef"
    var index = 0L
    while (index < length) {
        val value = this[index].toUByte().toInt()
        chars[index * 2L] = alphabet[(value / 16).toLong()]
        chars[index * 2L + 1L] = alphabet[(value % 16).toLong()]
        index += 1L
    }
    return String.fromChars(chars)
}

private enum HexResult { Bytes(val value: Array<Byte>), Invalid(val index: Long) }

private fun parseHex(text: String): HexResult {
    val output = ByteArrayBuilder()
    var first = -1
    var index = 0L
    for (character in text) {
        val digit = textDigit(character)
        if (digit < 0 || digit >= 16) return HexResult.Invalid(index)
        if (first < 0) first = digit
        else { output.append((first * 16 + digit).toByte()); first = -1 }
        index += 1L
    }
    if (first >= 0) return HexResult.Invalid(index)
    return HexResult.Bytes(output.toByteArray())
}

/**
 * Decodes an even-length hexadecimal string; malformed input throws IllegalArgumentException.
 */
public fun String.hexToByteArray(): Array<Byte> = when (parseHex(this)) {
    case HexResult.Bytes(value) -> value
    case HexResult.Invalid(index) -> throw IllegalArgumentException(Some("invalid hex at index " + index.toString()))
}

/**
 * Decodes an even-length hexadecimal string, returning None for invalid digits or odd length.
 */
public fun String.hexToByteArrayOrNone(): Array<Byte>? = when (parseHex(this)) {
    case HexResult.Bytes(value) -> Some(value)
    case HexResult.Invalid(_) -> None
}
