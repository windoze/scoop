package scoop.collections

/**
 * Copies the comparator-bounded range into an independent read-only ordered collection. Bounds
 * default to lower-inclusive and upper-exclusive; reversed bounds throw.
 */
public fun <K, V> SortedMap<K, V>.copyOfRange(
    fromKey: K, toKey: K, fromInclusive: Boolean = true, toInclusive: Boolean = false
): SortedMap<K, V> {
    val order = comparator
    if (order.compare(fromKey, toKey) > 0L) throw IllegalArgumentException(Some("reversed map bounds"))
    val result = TreeMap<K, V>(order)
    for ((key, value) in this) {
        val from = order.compare(key, fromKey)
        val to = order.compare(key, toKey)
        if ((from > 0L || (fromInclusive && from == 0L)) && (to < 0L || (toInclusive && to == 0L))) {
            result.put(key, value)
        }
    }
    return SortedMapSnapshot<K, V>(result)
}

/**
 * Copies the comparator-bounded range into an independent read-only ordered collection. Bounds
 * default to lower-inclusive and upper-exclusive; reversed bounds throw.
 */
public fun <T> SortedSet<T>.copyOfRange(
    fromElement: T, toElement: T, fromInclusive: Boolean = true, toInclusive: Boolean = false
): SortedSet<T> {
    val order = comparator
    if (order.compare(fromElement, toElement) > 0L) throw IllegalArgumentException(Some("reversed set bounds"))
    val result = TreeSet<T>(order)
    for (element in this) {
        val from = order.compare(element, fromElement)
        val to = order.compare(element, toElement)
        if ((from > 0L || (fromInclusive && from == 0L)) && (to < 0L || (toInclusive && to == 0L))) {
            result.add(element)
        }
    }
    return SortedSetSnapshot<T>(result)
}
