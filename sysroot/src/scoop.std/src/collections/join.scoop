package scoop.collections

/**
 * Joins rendered elements with separator, prefix, and postfix. A nonnegative limit bounds rendered
 * elements and appends truncated text when more remain.
 */
public fun <T> Iterable<T>.joinToString(
    separator: String = ", ", prefix: String = "", postfix: String = "",
    limit: Long = -1L, truncated: String = "...", transform: (T) -> String
): String {
    if (limit < -1L) throw IllegalArgumentException(Some("invalid join limit"))
    val builder = StringBuilder()
    builder.append(prefix)
    var count = 0L
    for (element in this) {
        if (count > 0L) builder.append(separator)
        if (limit >= 0L && count == limit) { builder.append(truncated); break }
        builder.append(transform(element))
        count = nextCollectionCount(count)
    }
    builder.append(postfix)
    return builder.toString()
}

/**
 * Joins rendered elements with separator, prefix, and postfix. A nonnegative limit bounds rendered
 * elements and appends truncated text when more remain.
 */
public fun <T : ToString> Iterable<T>.joinToString(
    separator: String = ", ", prefix: String = "", postfix: String = "", limit: Long = -1L, truncated: String = "..."
): String = joinToString<T>(separator, prefix, postfix, limit, truncated) { element -> element.toString() }
