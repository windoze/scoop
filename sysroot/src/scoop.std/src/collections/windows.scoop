package scoop.collections

/**
 * An element paired with its zero-based Long iteration index.
 */
public struct IndexedValue<T>(val index: Long, val value: T)

/**
 * Pairs each element with its zero-based Long index as it is iterated.
 */
public fun <T> Iterable<T>.withIndex(): Iterable<IndexedValue<T>> = IndexedIterable<T>(this)

private class IndexedIterable<T>(private val source: Iterable<T>) : Iterable<IndexedValue<T>> {
    public override operator fun iterator(): Iterator<IndexedValue<T>> = IndexedIterator<T>(source.iterator())
}

private class IndexedIterator<T>(private val source: Iterator<T>) : Iterator<IndexedValue<T>> {
    private var index: Long = 0L

    public override fun next(): IndexedValue<T>? = when (source.next()) {
        case None -> None
        case Some(value) -> {
            val result = IndexedValue<T>(index, value)
            index = nextCollectionCount(index)
            Some(result)
        }
    }
}

/**
 * Pairs elements by position, stopping when either input ends.
 */
public fun <T, R> Iterable<T>.zip(other: Iterable<R>): List<(T, R)> {
    val result = ArrayList<(T, R)>()
    val left = iterator()
    val right = other.iterator()
    while (true) {
        val first = left.next()
        when (first) {
            case None -> break
            case Some(value) -> when (right.next()) {
                case None -> break
                case Some(otherValue) -> result.add((value, otherValue))
            }
        }
    }
    return ListSnapshot<(T, R)>(result.toArray())
}

/**
 * Produces copied windows at the requested step. Size and step must be positive; incomplete
 * trailing windows are included only when partialWindows is true.
 */
public fun <T> Iterable<T>.windowed(size: Long, step: Long = 1L, partialWindows: Boolean = false): List<List<T>> {
    if (size <= 0L || step <= 0L) throw IllegalArgumentException(Some("non-positive window size or step"))
    val result = ArrayList<List<T>>()
    val window = ArrayDeque<T>()
    val source = iterator()
    var ended = false
    while (true) {
        while (!ended && window.size < size) {
            when (source.next()) {
                case None -> ended = true
                case Some(element) -> window.addLast(element)
            }
        }
        if (window.isEmpty()) break
        if (window.size < size && !partialWindows) break
        result.add(window.toList())
        var skip = step
        while (skip > 0L && window.isNotEmpty()) { window.removeFirst(); skip -= 1L }
        while (skip > 0L && !ended) {
            when (source.next()) {
                case None -> ended = true
                case Some(_) -> skip -= 1L
            }
        }
    }
    return ListSnapshot<List<T>>(result.toArray())
}

/**
 * Partitions input into copied, nonoverlapping chunks of positive size; the final chunk may be
 * shorter.
 */
public fun <T> Iterable<T>.chunked(size: Long): List<List<T>> = windowed<T>(size, size, true)
