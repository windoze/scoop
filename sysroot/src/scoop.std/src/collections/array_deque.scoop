package scoop.collections

/**
 * A growable double-ended queue with constant-time indexed ring-buffer access at either end.
 * Structural changes invalidate active iterators.
 */
public class ArrayDeque<T> public constructor() : Collection<T> {
    private var storage: ElementBuffer<T> = ElementBuffer<T>(8L)
    private var head: Long = 0L
    private var elementCount: Long = 0L
    private val structure: ModificationCounter = ModificationCounter()
    /**
     * The number of queued elements.
     */
    public override val size: Long get() = elementCount

    private fun position(index: Long): Long {
        val tailSpace = storage.capacity - head
        return if (index < tailSpace) head + index else index - tailSpace
    }

    internal fun elementAt(index: Long): T = storage.read(position(index))

    private fun ensureRoom() {
        if (elementCount < storage.capacity) return
        val replacement = ElementBuffer<T>(expandedCollectionCapacity(storage.capacity))
        var index = 0L
        while (index < elementCount) { replacement.write(index, elementAt(index)); index += 1L }
        storage = replacement
        head = 0L
    }

    /**
     * Prepends an element to the queue.
     */
    public fun addFirst(element: T) {
        ensureRoom()
        head = if (head == 0L) storage.capacity - 1L else head - 1L
        storage.write(head, element)
        elementCount += 1L
        structure.advance()
    }

    /**
     * Appends an element to the queue.
     */
    public fun addLast(element: T) {
        ensureRoom()
        storage.write(position(elementCount), element)
        elementCount += 1L
        structure.advance()
    }

    /**
     * Returns the front element without removing it, or None when empty.
     */
    public fun firstOrNone(): T? = if (elementCount == 0L) None else Some(elementAt(0L))
    /**
     * Returns the back element without removing it, or None when empty.
     */
    public fun lastOrNone(): T? = if (elementCount == 0L) None else Some(elementAt(elementCount - 1L))

    /**
     * Removes and returns the front element; an empty queue throws NoSuchElementException.
     */
    public fun removeFirst(): T {
        if (elementCount == 0L) throw NoSuchElementException("empty deque")
        val value = storage.read(head)
        storage.erase(head)
        head = if (head + 1L == storage.capacity) 0L else head + 1L
        elementCount -= 1L
        if (elementCount == 0L) head = 0L
        structure.advance()
        return value
    }

    /**
     * Removes and returns the back element; an empty queue throws NoSuchElementException.
     */
    public fun removeLast(): T {
        if (elementCount == 0L) throw NoSuchElementException("empty deque")
        val index = position(elementCount - 1L)
        val value = storage.read(index)
        storage.erase(index)
        elementCount -= 1L
        if (elementCount == 0L) head = 0L
        structure.advance()
        return value
    }

    /**
     * Removes the front element, or returns None when empty.
     */
    public fun removeFirstOrNone(): T? = if (elementCount == 0L) None else Some(removeFirst())
    /**
     * Removes the back element, or returns None when empty.
     */
    public fun removeLastOrNone(): T? = if (elementCount == 0L) None else Some(removeLast())

    /**
     * Removes all queued elements.
     */
    public fun clear() {
        if (elementCount == 0L) return
        var index = 0L
        while (index < elementCount) { storage.erase(position(index)); index += 1L }
        head = 0L
        elementCount = 0L
        structure.advance()
    }

    /**
     * Iterates from front to back; structural changes invalidate the iterator.
     */
    public override operator fun iterator(): Iterator<T> = DequeIterator<T>(this, structure)

    /**
     * Serialization factories using explicit element or key/value codecs.
     */
    public companion object {
        /**
         * Encodes entries or elements in iteration order using the supplied component codecs.
         */
        public fun encoder(element: ValueEncoder<T>): ValueEncoder<ArrayDeque<T>> =
            ValueEncoderFunction<ArrayDeque<T>> { values, encoder -> encodeElements(values, element, encoder) }
        /**
         * Decodes entries or elements into a new collection using the supplied component codecs
         * and comparator where required.
         */
        public fun decoder(element: ValueDecoder<T>): ValueDecoder<ArrayDeque<T>> = ValueDecoderFunction<ArrayDeque<T>> { decoder ->
            val result = ArrayDeque<T>()
            decodeElements(decoder, element) { value -> result.addLast(value) }
            result
        }
    }
}

internal class DequeIterator<T> internal constructor(
    private val source: ArrayDeque<T>, private val structure: ModificationCounter
) : Iterator<T> {
    private val stamp: RevisionStamp = structure.snapshot()
    private var index: Long = 0L
    private var exhausted: Boolean = false

    public override fun next(): T? {
        if (exhausted) return None
        structure.check(stamp)
        if (index == source.size) { exhausted = true; return None }
        val value = source.elementAt(index)
        index += 1L
        return Some(value)
    }
}
