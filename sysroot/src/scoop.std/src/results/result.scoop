package scoop

/**
 * A value carrying either a successful result or an explicitly typed failure.
 */
public enum Result<T, E> {
    /**
     * Carries the successful value.
     */
    Success(T),
    /**
     * Carries the failure value.
     */
    Failure(E)

    /**
     * Whether this value holds Success.
     */
    public val isSuccess: Boolean get() = when (this) {
        case Success(_) -> true
        case Failure(_) -> false
    }
    /**
     * Whether this value holds Failure.
     */
    public val isFailure: Boolean get() = !isSuccess

    /**
     * Serialization factories with separate success and failure codecs.
     */
    public companion object {
        /**
         * Encodes the selected variant using its supplied payload codec.
         */
        public fun encoder(success: ValueEncoder<T>, failure: ValueEncoder<E>): ValueEncoder<Result<T, E>> = ResultEncoder<T, E>(success, failure)
        /**
         * Decodes a success or failure variant using its supplied payload codec.
         */
        public fun decoder(success: ValueDecoder<T>, failure: ValueDecoder<E>): ValueDecoder<Result<T, E>> = ResultDecoder<T, E>(success, failure)
    }
}

/**
 * Returns the successful value as Some, or None on failure.
 */
public fun <T, E> Result<T, E>.getOrNone(): T? = when (this) {
    case Result.Success(value) -> Some(value)
    case Result.Failure(_) -> None
}

/**
 * Returns the failure value as Some, or None on success.
 */
public fun <T, E> Result<T, E>.errorOrNone(): E? = when (this) {
    case Result.Success(_) -> None
    case Result.Failure(error) -> Some(error)
}

/**
 * Returns the success value, or evaluates the failure callback.
 */
public fun <T, E> Result<T, E>.getOrElse(onFailure: (E) -> T): T = when (this) {
    case Result.Success(value) -> value
    case Result.Failure(error) -> onFailure(error)
}

/**
 * Runs exactly the callback corresponding to the success or failure variant.
 */
public fun <T, E, R> Result<T, E>.fold(onSuccess: (T) -> R, onFailure: (E) -> R): R = when (this) {
    case Result.Success(value) -> onSuccess(value)
    case Result.Failure(error) -> onFailure(error)
}

/**
 * Returns the success value or throws the stored Throwable.
 */
public fun <T, E : Throwable> Result<T, E>.getOrThrow(): T = when (this) {
    case Result.Success(value) -> value
    case Result.Failure(error) -> throw error
}

/**
 * Runs the block and captures a thrown Throwable as Failure.
 */
public fun <T> runCatching(block: () -> T): Result<T, Throwable> = try {
    Result.Success<T, Throwable>(block())
} catch (error: Throwable) {
    Result.Failure<T, Throwable>(error)
}

/**
 * Keeps the success value and discards a failure into None.
 */
public fun <T, E> Result<T, E>.toOption(): T? = getOrNone<T, E>()
