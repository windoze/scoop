package scoop.ui.style

import scoop.graphics.*

public struct SurfaceMetrics(
    val suggestedSize: Size,
    val minimumSize: Size,
    val padding: Insets,
    val borderInsets: Insets,
    val corners: CornerRadii,
    val focusOutset: Double
) {
    public val contentInsets: Insets get() =
        Insets(
            padding.left + borderInsets.left,
            padding.top + borderInsets.top,
            padding.right + borderInsets.right,
            padding.bottom + borderInsets.bottom
        )
}

public class SurfaceOptions internal constructor(
    public val suggestedSize: Size? = None,
    public val minimumSize: Size? = None,
    public val padding: Insets? = None,
    public val style: StyleOverride = styleOverride(),
    public val focus: OutlineStyle? = None,
    public val validation: OutlineStyle? = None
) {
    public fun copy(configure: SurfaceOptionsBuilder.() -> Unit = {}): SurfaceOptions =
        configureSurfaceOptions(this, configure)
}

public class SurfaceGeometry public constructor(
    public val bounds: Rect,
    public val outline: RoundedOutline,
    public val borderInner: RoundedOutline,
    public val content: Rect,
    public val ring: OutlineRing?,
    public val style: Style,
    public val opacity: Double = 1.0
) {
    public val contentStyle: Style get() =
        Style(
            corners = Corners.Physical(outline.radii),
            contentEffects = style.contentEffects,
            clipContent = style.clipContent
        )
}

public struct CheckboxMetrics(
    val suggestedSize: Size,
    val minimumSize: Size,
    val borderInsets: Insets,
    val corners: CornerRadii,
    val markInset: Double,
    val markWidth: Double,
    val focusOutset: Double
)

public class CheckboxOptions internal constructor(
    public val size: Double? = None,
    public val minimumSize: Double? = None,
    public val markInset: Double? = None,
    public val style: StyleOverride = styleOverride(),
    public val markColor: Color? = None,
    public val focus: OutlineStyle? = None,
    public val validation: OutlineStyle? = None
) {
    public fun copy(configure: CheckboxOptionsBuilder.() -> Unit = {}): CheckboxOptions =
        configureCheckboxOptions(this, configure)
}

public class CheckboxGeometry public constructor(
    public val bounds: Rect,
    public val outline: RoundedOutline,
    public val interior: RoundedOutline,
    public val markBounds: Rect,
    public val tick: StrokeSegment,
    public val mixed: RoundedOutline,
    public val ring: OutlineRing?,
    public val style: Style,
    public val markColor: Color,
    public val selection: Double,
    public val opacity: Double = 1.0
)

public struct RadioMetrics(
    val suggestedSize: Size,
    val minimumSize: Size,
    val ringWidth: Double,
    val dotInset: Double,
    val focusOutset: Double
)

public class RadioOptions internal constructor(
    public val size: Double? = None,
    public val minimumSize: Double? = None,
    public val dotInset: Double? = None,
    public val background: StyleValue<Paint?> = StyleValue.Inherit,
    public val border: StyleValue<BorderEdge?> = StyleValue.Inherit,
    public val dotColor: Color? = None,
    public val focus: OutlineStyle? = None,
    public val validation: OutlineStyle? = None
) {
    public fun copy(configure: RadioOptionsBuilder.() -> Unit = {}): RadioOptions =
        configureRadioOptions(this, configure)
}

public class RadioGeometry public constructor(
    public val bounds: Rect,
    public val outer: Circle,
    public val interior: Circle,
    public val dot: Circle,
    public val ring: OutlineRing?,
    public val style: Style,
    public val dotColor: Color,
    public val selection: Double,
    public val opacity: Double = 1.0
)

public struct ScrollbarMetrics(
    val thickness: Double,
    val minimumThumbLength: Double,
    val trackInset: Double,
    val thumbInset: Double,
    val cornerRadius: Double,
    val buttonLength: Double?
)

public class ScrollbarOptions internal constructor(
    public val thickness: Double? = None,
    public val minimumThumbLength: Double? = None,
    public val trackInset: Double? = None,
    public val thumbInset: Double? = None,
    public val buttonLength: StyleValue<Double?> = StyleValue.Inherit
) {
    public fun copy(configure: ScrollbarOptionsBuilder.() -> Unit = {}): ScrollbarOptions =
        configureScrollbarOptions(this, configure)
}

public struct ScrollbarButtonGeometry(val outline: RoundedOutline, val arrow: StrokeSegment)

public class ScrollbarGeometry public constructor(
    public val bounds: Rect,
    public val orientation: Orientation,
    public val track: RoundedOutline,
    public val thumb: RoundedOutline,
    public val decrement: ScrollbarButtonGeometry?,
    public val increment: ScrollbarButtonGeometry?,
    public val travelStart: Point,
    public val travel: Double,
    public val thumbLength: Double,
    public val position: Double,
    public val visibleFraction: Double
)

/** Concrete descriptions used by the three shape-based themes, also useful for custom presets. */
public class SurfacePart internal constructor(
    public val metrics: SurfaceMetrics,
    public val fill: StateColors,
    public val border: StateColors,
    public val foreground: StateColors,
    public val focus: OutlineStyle,
    public val shadows: Array<BoxShadow> = []
) {
    public fun copy(configure: SurfacePartBuilder.() -> Unit = {}): SurfacePart =
        configureSurfacePart(this, configure)
}

public class SurfaceParts internal constructor(
    public val plain: SurfacePart,
    public val action: SurfacePart,
    public val elevated: SurfacePart
) {
    public fun copy(configure: SurfacePartsBuilder.() -> Unit = {}): SurfaceParts =
        configureSurfaceParts(this, configure)

    public fun get(kind: SurfaceKind): SurfacePart =
        when (kind) {
            case Plain -> plain;
            case Action -> action;
            case Elevated -> elevated
        }
}

public class MarkerAppearance internal constructor(
    public val empty: StateColors,
    public val selected: StateColors,
    public val border: StateColors,
    public val selectedBorder: StateColors,
    public val mark: StateColors,
    public val focus: OutlineStyle,
    public val shadows: Array<BoxShadow> = []
) {
    public fun copy(configure: MarkerAppearanceBuilder.() -> Unit = {}): MarkerAppearance =
        configureMarkerAppearance(this, configure)
}

public class CheckboxPart internal constructor(
    public val metrics: CheckboxMetrics,
    public val appearance: MarkerAppearance
) {
    public fun copy(configure: CheckboxPartBuilder.() -> Unit = {}): CheckboxPart =
        configureCheckboxPart(this, configure)
}

public class RadioPart internal constructor(
    public val metrics: RadioMetrics,
    public val appearance: MarkerAppearance
) {
    public fun copy(configure: RadioPartBuilder.() -> Unit = {}): RadioPart =
        configureRadioPart(this, configure)
}

public class ScrollbarPart internal constructor(
    public val metrics: ScrollbarMetrics,
    public val track: StateColors,
    public val thumb: StateColors,
    public val button: StateColors,
    public val arrow: StateColors,
    public val arrowWidth: Double = 1.5
) {
    public fun copy(configure: ScrollbarPartBuilder.() -> Unit = {}): ScrollbarPart =
        configureScrollbarPart(this, configure)
}
