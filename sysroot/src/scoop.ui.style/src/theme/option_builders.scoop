/** Configures one immutable description without creating drawing or UI resources. */
public fun radioOptions(configure: RadioOptionsBuilder.() -> Unit = {}): RadioOptions =
    configureRadioOptions(RadioOptions(), configure)

internal fun configureRadioOptions(
    initial: RadioOptions,
    configure: RadioOptionsBuilder.() -> Unit
): RadioOptions {
    val builder = RadioOptionsBuilder(initial)
    builder.configure()
    return builder.snapshot()
}

/** Mutable configuration; published values remain independent of later changes. */
public class RadioOptionsBuilder internal constructor(initial: RadioOptions) {
    public var size: Double? = initial.size
    public var minimumSize: Double? = initial.minimumSize
    public var dotInset: Double? = initial.dotInset
    public var background: StyleValue<Paint?> = initial.background
    public var border: StyleValue<BorderEdge?> = initial.border
    public var dotColor: Color? = initial.dotColor
    public var focus: OutlineStyle? = initial.focus
    public var validation: OutlineStyle? = initial.validation

    public fun background(value: Paint?): Unit {
        this.background = StyleValue.Set(value)
    }

    public fun border(value: BorderEdge?): Unit {
        this.border = StyleValue.Set(value)
    }

    internal fun snapshot(): RadioOptions =
        RadioOptions(
            size = size,
            minimumSize = minimumSize,
            dotInset = dotInset,
            background = background,
            border = border,
            dotColor = dotColor,
            focus = focus,
            validation = validation
        )
}

