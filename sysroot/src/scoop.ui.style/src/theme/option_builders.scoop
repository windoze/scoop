package scoop.ui.style

import scoop.graphics.*

/** Configures one immutable description without creating drawing or UI resources. */
public fun surfaceOptions(configure: SurfaceOptionsBuilder.() -> Unit = {}): SurfaceOptions =
    configureSurfaceOptions(SurfaceOptions(), configure)

internal fun configureSurfaceOptions(
    initial: SurfaceOptions,
    configure: SurfaceOptionsBuilder.() -> Unit
): SurfaceOptions {
    val builder = SurfaceOptionsBuilder(initial)
    builder.configure()
    return builder.snapshot()
}

/** Mutable configuration; published values remain independent of later changes. */
public class SurfaceOptionsBuilder internal constructor(initial: SurfaceOptions) {
    public var suggestedSize: Size? = initial.suggestedSize
    public var minimumSize: Size? = initial.minimumSize
    public var padding: Insets? = initial.padding
    public var style: StyleOverride = initial.style
    public var focus: OutlineStyle? = initial.focus
    public var validation: OutlineStyle? = initial.validation

    public fun style(configure: StyleOverrideBuilder.() -> Unit): Unit {
        style = style.copy(configure)
    }

    internal fun snapshot(): SurfaceOptions =
        SurfaceOptions(
            suggestedSize = suggestedSize,
            minimumSize = minimumSize,
            padding = padding,
            style = style,
            focus = focus,
            validation = validation
        )
}

