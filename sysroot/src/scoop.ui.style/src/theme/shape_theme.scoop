package scoop.ui.style

import scoop.graphics.*
import scoop.ui.LayoutDirection

/** Shared algorithms for the four public parts; concrete themes supply all appearance choices. */
public class ShapeTheme internal constructor(
    public override val tokens: ThemeTokens,
    public val surfaces: SurfaceParts,
    public val checkbox: CheckboxPart,
    public val radio: RadioPart,
    public val scrollbar: ScrollbarPart
): Theme {
    public fun copy(configure: ShapeThemeBuilder.() -> Unit = {}): ShapeTheme =
        configureShapeTheme(this, configure)

    private fun surfaceStyle(
        visual: SurfaceVisual,
        options: SurfaceOptions,
        direction: LayoutDirection
    ): Style {
        val part = surfaces.get(visual.kind)
        return physicalStyle(
            options.style.resolve(
                Style(
                    background = Some(Paint(part.fill.resolve(visual.interaction))),
                    border =
                        Some(
                            themeBorder(
                                part.metrics.borderInsets,
                                outlineBorder(
                                    part.border.resolve(visual.interaction),
                                    visual.interaction,
                                    options.focus ?: part.focus,
                                    options.validation ?: tokens.validation
                                )
                            )
                        ),
                    corners = Corners.Physical(part.metrics.corners),
                    boxShadows = part.shadows
                )
            ),
            direction
        )
    }
    public override fun surfaceTextColor(visual: SurfaceVisual): Color =
        surfaces.get(visual.kind).foreground.resolve(visual.interaction)
    public override fun surfaceMetrics(
        visual: SurfaceVisual,
        options: SurfaceOptions,
        direction: LayoutDirection
    ): SurfaceMetrics {
        val part = surfaces.get(visual.kind)
        val style = surfaceStyle(visual, options, direction)
        val focus = options.focus ?: part.focus
        val result =
            SurfaceMetrics(
                options.suggestedSize ?: part.metrics.suggestedSize,
                options.minimumSize ?: part.metrics.minimumSize,
                options.padding ?: part.metrics.padding,
                physicalEdges(style).insets,
                style.corners.resolve(direction),
                outlineOutset(focus, options.validation ?: tokens.validation)
            )
        themeSize(result.suggestedSize);
        themeSize(result.minimumSize);
        result.contentInsets.totals()
        result.corners.normalized(result.suggestedSize);
        themeLength(result.focusOutset);
        themeLength(focus.width)
        return result
    }
    public override fun surfaceGeometry(
        bounds: Rect,
        visual: SurfaceVisual,
        options: SurfaceOptions,
        direction: LayoutDirection
    ): SurfaceGeometry {
        themeBounds(bounds)
        val metrics = surfaceMetrics(visual, options, direction)
        val outline = RoundedOutline(bounds, metrics.corners).normalized()
        val inner = insetOutline(outline, metrics.borderInsets)
        return SurfaceGeometry(
            bounds,
            outline,
            inner,
            insetTheme(bounds, metrics.contentInsets),
            outlineTheme(
                outline,
                visual.interaction,
                options.focus ?: surfaces.get(visual.kind).focus,
                options.validation ?: tokens.validation
            ),
            surfaceStyle(visual, options, direction),
            controlOpacity(visual.interaction.enabled)
        )
    }
    public override fun checkboxMetrics(
        options: CheckboxOptions,
        direction: LayoutDirection
    ): CheckboxMetrics {
        val base = checkbox.metrics
        val size = options.size ?: base.suggestedSize.width
        val min = options.minimumSize ?: base.minimumSize.width
        val corners =
            options.style.corners.resolve(Corners.Physical(base.corners)).resolve(direction)
        val edge = options.style.border.resolve(Some(themeBorder(base.borderInsets, Color.Black)))
        val insets =
            when (edge) {
                case Some(value) -> value.resolve(direction).insets
                case None -> Insets()
            }
        val focus = options.focus ?: checkbox.appearance.focus
        val result =
            CheckboxMetrics(
                Size(size, size),
                Size(min, min),
                insets,
                corners,
                options.markInset ?: base.markInset,
                base.markWidth,
                outlineOutset(focus, options.validation ?: tokens.validation)
            )
        for (value in [size, min, result.markInset, result.markWidth, focus.outset, focus.width])
            themeLength(value)
        corners.normalized(result.suggestedSize)
        return result
    }
    public override fun checkboxGeometry(
        bounds: Rect,
        visual: CheckboxVisual,
        options: CheckboxOptions,
        direction: LayoutDirection
    ): CheckboxGeometry {
        val metrics = checkboxMetrics(options, direction)
        val square = squareTheme(bounds)
        val outline = RoundedOutline(square, metrics.corners).normalized()
        val interior = insetOutline(outline, metrics.borderInsets)
        val mark = insetTheme(square, Insets.all(metrics.markInset))
        val width = themeMin(metrics.markWidth, themeMin(mark.width, mark.height))
        val tick =
            StrokeSegment(
                Point(mark.x, mark.y + mark.height * 0.52),
                Point(mark.x + mark.width * 0.38, mark.y + mark.height),
                Point(mark.x + mark.width, mark.y),
                width
            )
        val mixed = Rect(mark.x, square.y + (square.height - width) / 2.0, mark.width, width)
        val amount = themeProgress(visual.selectionProgress, visual.mark != CheckMark.Off)
        val appearance = checkbox.appearance
        val style =
            physicalStyle(
                options.style.resolve(
                    markerStyle(
                        appearance,
                        visual.interaction,
                        amount,
                        metrics.borderInsets,
                        outline.radii,
                        options.focus ?: appearance.focus,
                        options.validation ?: tokens.validation
                    )
                ),
                direction
            )
        return CheckboxGeometry(
            bounds,
            outline,
            interior,
            mark,
            tick,
            roundTheme(mixed, width / 2.0),
            outlineTheme(
                outline,
                visual.interaction,
                options.focus ?: appearance.focus,
                options.validation ?: tokens.validation
            ),
            style,
            options.markColor ?: appearance.mark.resolve(visual.interaction),
            amount,
            controlOpacity(visual.interaction.enabled)
        )
    }
    public override fun radioMetrics(options: RadioOptions): RadioMetrics {
        val base = radio.metrics
        val size = options.size ?: base.suggestedSize.width
        val min = options.minimumSize ?: base.minimumSize.width
        val edge = options.border.resolve(Some(BorderEdge(base.ringWidth, Color.Black)))
        val width =
            when (edge) {
                case Some(value) -> value.width;
                case None -> 0.0
            }
        val focus = options.focus ?: radio.appearance.focus
        val result =
            RadioMetrics(
                Size(size, size),
                Size(min, min),
                width,
                options.dotInset ?: base.dotInset,
                outlineOutset(focus, options.validation ?: tokens.validation)
            )
        for (value in [size, min, width, result.dotInset, focus.outset, focus.width])
            themeLength(value)
        return result
    }
    public override fun radioGeometry(
        bounds: Rect,
        visual: RadioVisual,
        options: RadioOptions
    ): RadioGeometry {
        val metrics = radioMetrics(options)
        val square = squareTheme(bounds)
        val outer =
            Circle(
                Point(square.x + square.width / 2.0, square.y + square.height / 2.0),
                square.width / 2.0
            )
        val interior = Circle(outer.center, themeMax(0.0, outer.radius - metrics.ringWidth))
        val amount = themeProgress(visual.selectionProgress, visual.selected)
        val dot = Circle(outer.center, themeMax(0.0, outer.radius - metrics.dotInset) * amount)
        val appearance = radio.appearance
        val style =
            markerStyle(
                appearance,
                visual.interaction,
                amount,
                Insets.all(metrics.ringWidth),
                CornerRadii.all(outer.radius),
                options.focus ?: appearance.focus,
                options.validation ?: tokens.validation
            )
        return RadioGeometry(
            bounds,
            outer,
            interior,
            dot,
            outlineTheme(
                roundTheme(square, outer.radius),
                visual.interaction,
                options.focus ?: appearance.focus,
                options.validation ?: tokens.validation
            ),
            style.copy {
                this.background = options.background.resolve(this.background)
                this.border =
                    when (options.border) {
                        case Inherit -> this.border
                        case Set(value) -> when (value) {
                            case Some(edge) -> Some(Border.all(edge.width, edge.color))
                            case None -> None
                        }
                    }
            },
            options.dotColor ?: appearance.mark.resolve(visual.interaction),
            amount,
            controlOpacity(visual.interaction.enabled)
        )
    }
    public override fun scrollbarMetrics(options: ScrollbarOptions): ScrollbarMetrics {
        val base = scrollbar.metrics
        val result =
            ScrollbarMetrics(
                options.thickness ?: base.thickness,
                options.minimumThumbLength ?: base.minimumThumbLength,
                options.trackInset ?: base.trackInset,
                options.thumbInset ?: base.thumbInset,
                base.cornerRadius,
                options.buttonLength.resolve(base.buttonLength)
            )
        for (
            value in [
                result.thickness,
                result.minimumThumbLength,
                result.trackInset,
                result.thumbInset,
                result.cornerRadius,
                result.buttonLength ?: 0.0,
                scrollbar.arrowWidth
            ]
        )
            themeLength(value)
        return result
    }
    public override fun scrollbarGeometry(
        bounds: Rect,
        visual: ScrollbarVisual,
        options: ScrollbarOptions
    ): ScrollbarGeometry =
        makeScrollbarGeometry(bounds, visual, scrollbarMetrics(options), scrollbar.arrowWidth)
    private fun controlOpacity(enabled: Boolean): Double =
        if (enabled)
            1.0
        else
            themeUnit(tokens.disabledOpacity)

    public override fun createPainter(): ThemePainter =
        ShapeThemePainter(scrollbar, controlOpacity(false))
}

private fun markerStyle(
    appearance: MarkerAppearance,
    visual: InteractionVisual,
    selection: Double,
    insets: Insets,
    radii: CornerRadii,
    focus: OutlineStyle,
    validation: OutlineStyle
): Style =
    Style(
        background =
            Some(
                Paint(
                    mixThemeColor(
                        appearance.empty.resolve(visual),
                        appearance.selected.resolve(visual),
                        selection
                    )
                )
            ),
        border =
            Some(
                themeBorder(
                    insets,
                    outlineBorder(
                        mixThemeColor(
                            appearance.border.resolve(visual),
                            appearance.selectedBorder.resolve(visual),
                            selection
                        ),
                        visual,
                        focus,
                        validation
                    )
                )
            ),
        corners = Corners.Physical(radii),
        boxShadows = appearance.shadows
    )
