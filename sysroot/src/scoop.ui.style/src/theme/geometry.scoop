package scoop.ui.style

import scoop.graphics.*
import scoop.ui.LayoutDirection

internal fun themeLength(value: Double) {
    requireStyle(value.isFinite() && value >= 0.0, "theme lengths must be finite and nonnegative")
}

internal fun themeSize(size: Size) {
    themeLength(size.width);
    themeLength(size.height)
}

internal fun themeBounds(bounds: Rect) {
    themeSize(Size(bounds.width, bounds.height))
    requireStyle(
        bounds.x.isFinite() &&
            bounds.y.isFinite() &&
            (bounds.x + bounds.width).isFinite() &&
            (bounds.y + bounds.height).isFinite(),
        "invalid theme bounds"
    )
}

internal fun themeMin(a: Double, b: Double): Double =
    if (a < b)
        a
    else
        b

internal fun themeMax(a: Double, b: Double): Double =
    if (a > b)
        a
    else
        b

internal fun themeUnit(value: Double): Double {
    requireStyle(value.isFinite(), "theme progress must be finite")
    return themeMin(1.0, themeMax(0.0, value))
}

internal fun themeProgress(value: Double?, selected: Boolean): Double =
    themeUnit(
        value ?:
            if (selected)
                1.0
            else
                0.0
    )

internal fun insetTheme(bounds: Rect, insets: Insets): Rect =
    insetOutline(RoundedOutline(bounds), insets).bounds

internal fun insetOutline(outline: RoundedOutline, insets: Insets): RoundedOutline =
    outline.inset(insets.left, insets.top, insets.right, insets.bottom)

internal fun roundTheme(bounds: Rect, radius: Double): RoundedOutline =
    RoundedOutline(bounds, CornerRadii.all(radius)).normalized()

internal fun physicalEdges(
    style: Style,
    direction: LayoutDirection = LayoutDirection.Ltr
): BorderEdges =
    when (style.border) {
        case Some(value) -> value.resolve(direction)
        case None -> BorderEdges()
    }

internal fun themeBorder(insets: Insets, color: Color): Border =
    Border.Physical(
        BorderEdges(
            BorderEdge(insets.left, color),
            BorderEdge(insets.top, color),
            BorderEdge(insets.right, color),
            BorderEdge(insets.bottom, color)
        )
    )

internal fun physicalStyle(style: Style, direction: LayoutDirection): Style =
    Style(
        style.background,
        when (style.border) {
            case Some(value) -> Some(Border.Physical(value.resolve(direction)))
            case None -> None
        },
        Corners.Physical(style.corners.resolve(direction)),
        style.boxShadows,
        style.contentEffects,
        style.clipContent
    )

internal fun squareTheme(bounds: Rect): Rect {
    themeBounds(bounds)
    val side = themeMin(bounds.width, bounds.height)
    return Rect(
        bounds.x + (bounds.width - side) / 2.0,
        bounds.y + (bounds.height - side) / 2.0,
        side,
        side
    )
}

private fun stateOutline(
    visual: InteractionVisual,
    focus: OutlineStyle,
    validation: OutlineStyle
): OutlineStyle? =
    if (visual.invalid)
        Some(validation)
    else
        if (visual.enabled && visual.focusVisible)
            Some(focus)
        else
            None

internal fun outlineBorder(
    base: Color,
    visual: InteractionVisual,
    focus: OutlineStyle,
    validation: OutlineStyle
): Color {
    val style = stateOutline(visual, focus, validation) ?: return base
    val color = style.borderColor ?: return base
    return color
}

internal fun outlineOutset(focus: OutlineStyle, validation: OutlineStyle): Double {
    for (value in [focus.width, focus.outset, validation.width, validation.outset])
        themeLength(value)
    return themeMax(focus.outset, validation.outset)
}

internal fun outlineTheme(
    outline: RoundedOutline,
    visual: InteractionVisual,
    focus: OutlineStyle,
    validation: OutlineStyle
): OutlineRing? {
    val style = stateOutline(visual, focus, validation) ?: return None
    themeLength(style.outset);
    themeLength(style.width)
    if (style.width == 0.0)
        return None
    return Some(OutlineRing(outline.expanded(style.outset), BorderEdge(style.width, style.color)))
}
