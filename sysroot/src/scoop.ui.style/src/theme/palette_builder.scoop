package scoop.ui.style

import scoop.graphics.Color

internal fun configureThemePalette(
    initial: ThemePalette,
    configure: ThemePaletteBuilder.() -> Unit
): ThemePalette {
    val builder = ThemePaletteBuilder(initial)
    builder.configure()
    return builder.snapshot()
}

/** Mutable configuration initialized from a complete immutable value. */
public class ThemePaletteBuilder internal constructor(initial: ThemePalette) {
    public var background: ColorPair = initial.background
    public var card: ColorPair = initial.card
    public var popover: ColorPair = initial.popover
    public var primary: ColorPair = initial.primary
    public var secondary: ColorPair = initial.secondary
    public var muted: ColorPair = initial.muted
    public var accent: ColorPair = initial.accent
    public var destructive: ColorPair = initial.destructive
    public var border: Color = initial.border
    public var input: Color = initial.input
    public var ring: Color = initial.ring
    public var chart: ChartPalette = initial.chart
    public var sidebar: SidebarPalette = initial.sidebar
    public var disabledText: Color = initial.disabledText
    public var shadow: Color = initial.shadow

    internal fun snapshot(): ThemePalette =
        ThemePalette(
            background = background,
            card = card,
            popover = popover,
            primary = primary,
            secondary = secondary,
            muted = muted,
            accent = accent,
            destructive = destructive,
            border = border,
            input = input,
            ring = ring,
            chart = chart,
            sidebar = sidebar,
            disabledText = disabledText,
            shadow = shadow
        )
}
