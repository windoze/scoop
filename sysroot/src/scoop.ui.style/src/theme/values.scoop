package scoop.ui.style

import scoop.graphics.*
import scoop.graphics.text.TextStyle
import scoop.surface.AnimationSpec

public enum ThemeMode {
    Light, Dark
}

public enum SurfaceKind {
    Plain, Action, Elevated
}

public enum SurfaceLayer {
    Background, Foreground, All
}

public enum CheckMark {
    Off, On, Mixed
}

public enum Orientation {
    Horizontal, Vertical
}

public enum ScrollbarRegion {
    Track, Thumb, Decrement, Increment
}

/** Physical edges in logical units, shared by geometry and control layout. */
public struct Insets(
    val left: Double = 0.0,
    val top: Double = 0.0,
    val right: Double = 0.0,
    val bottom: Double = 0.0
) {
    public companion object {
        public fun all(value: Double): Insets = Insets(value, value, value, value)
    }
    public fun totals(): Size {
        for (value in [left, top, right, bottom])
            themeLength(value)
        val result = Size(left + right, top + bottom)
        themeSize(result)
        return result
    }
}

public struct Circle(val center: Point, val radius: Double) {
    public val bounds: Rect get() =
        Rect(center.x - radius, center.y - radius, radius * 2.0, radius * 2.0)
}

public struct StrokeSegment(val start: Point, val bend: Point, val end: Point, val width: Double)

public struct OutlineStyle(
    val color: Color,
    val width: Double,
    val outset: Double,
    val borderColor: Color? = None
)

public struct OutlineRing(val outline: RoundedOutline, val border: BorderEdge)

/** Samples are optional; callers own animations and pass this frame's values. */
public struct InteractionVisual(
    val enabled: Boolean = true,
    val hovered: Boolean = false,
    val pressed: Boolean = false,
    val focusVisible: Boolean = false,
    val hoverProgress: Double? = None,
    val pressProgress: Double? = None,
    val invalid: Boolean = false
)

public struct SurfaceVisual(
    val kind: SurfaceKind = SurfaceKind.Plain,
    val interaction: InteractionVisual = InteractionVisual()
)

public struct CheckboxVisual(
    val mark: CheckMark = CheckMark.Off,
    val interaction: InteractionVisual = InteractionVisual(),
    val selectionProgress: Double? = None
)

public struct RadioVisual(
    val selected: Boolean = false,
    val interaction: InteractionVisual = InteractionVisual(),
    val selectionProgress: Double? = None
)

public struct ScrollbarVisual(
    val orientation: Orientation = Orientation.Vertical,
    val position: Double = 0.0,
    val visibleFraction: Double = 0.25,
    val enabled: Boolean = true,
    val hoveredPart: ScrollbarRegion? = None,
    val pressedPart: ScrollbarRegion? = None,
    val opacity: Double = 1.0
)

public struct StateColors(
    val normal: Color,
    val hovered: Color,
    val pressed: Color,
    val disabled: Color
) {
    public fun resolve(visual: InteractionVisual): Color {
        val hover = themeProgress(visual.hoverProgress, visual.hovered)
        val press = themeProgress(visual.pressProgress, visual.pressed)
        return if (visual.enabled)
            mixThemeColor(mixThemeColor(normal, hovered, hover), pressed, press)
        else
            disabled
    }
    public companion object {
        public fun solid(color: Color): StateColors = StateColors(color, color, color, color)
    }
}

public struct ColorPair(val background: Color, val foreground: Color)

public struct ChartPalette(
    val one: Color,
    val two: Color,
    val three: Color,
    val four: Color,
    val five: Color
)

public struct SidebarPalette(
    val background: ColorPair,
    val primary: ColorPair,
    val accent: ColorPair,
    val border: Color,
    val ring: Color
)

public class ThemePalette public constructor(
    public val background: ColorPair,
    public val card: ColorPair,
    public val popover: ColorPair,
    public val primary: ColorPair,
    public val secondary: ColorPair,
    public val muted: ColorPair,
    public val accent: ColorPair,
    public val destructive: ColorPair,
    public val border: Color,
    public val input: Color,
    public val ring: Color,
    public val chart: ChartPalette,
    public val sidebar: SidebarPalette,
    public val disabledText: Color,
    public val shadow: Color
) {
    public fun copy(configure: ThemePaletteBuilder.() -> Unit = {}): ThemePalette =
        configureThemePalette(this, configure)
}

public class ThemeTypography internal constructor(
    public val body: TextStyle,
    public val caption: TextStyle,
    public val action: TextStyle
) {
    public fun copy(configure: ThemeTypographyBuilder.() -> Unit = {}): ThemeTypography =
        configureThemeTypography(this, configure)
}

public struct ThemeSpacing(val small: Double, val medium: Double, val large: Double)

public struct ThemeCorners(val small: Double, val medium: Double, val large: Double)

public class ThemeEffects internal constructor(
    public val raised: Array<BoxShadow> = [],
    public val floating: Array<BoxShadow> = [],
    public val emphasis: Array<ContentEffect> = []
) {
    public fun copy(configure: ThemeEffectsBuilder.() -> Unit = {}): ThemeEffects =
        configureThemeEffects(this, configure)
}

public enum MotionPreference {
    Full, Reduced
}

public class ThemeMotion internal constructor(
    public val preference: MotionPreference = MotionPreference.Full,
    public val hover: AnimationSpec? = None,
    public val press: AnimationSpec? = None,
    public val selection: AnimationSpec? = None
) {
    public fun resolve(spec: AnimationSpec?): AnimationSpec? =
        if (preference == MotionPreference.Reduced)
            None
        else
            spec

    public fun copy(configure: ThemeMotionBuilder.() -> Unit = {}): ThemeMotion =
        configureThemeMotion(this, configure)
}

public class ThemeTokens internal constructor(
    public val mode: ThemeMode = ThemeMode.Light,
    public val palette: ThemePalette,
    public val typography: ThemeTypography,
    public val spacing: ThemeSpacing,
    public val motion: ThemeMotion = themeMotion(),
    public val corners: ThemeCorners,
    public val validation: OutlineStyle,
    public val effects: ThemeEffects = themeEffects(),
    public val disabledOpacity: Double = 1.0
) {
    public fun copy(configure: ThemeTokensBuilder.() -> Unit = {}): ThemeTokens =
        configureThemeTokens(this, configure)
}

public fun mixThemeColor(from: Color, to: Color, progress: Double): Color {
    val t = themeUnit(progress)
    return Color(
        from.red + (to.red - from.red) * t,
        from.green + (to.green - from.green) * t,
        from.blue + (to.blue - from.blue) * t,
        from.alpha + (to.alpha - from.alpha) * t
    )
}
