package scoop.http.client.tests.consumer.client_upload_completion

import scoop.test.*
import scoop.asyncio.*
import scoop.platform.memory.NativeByteBuffer

internal fun completionCheck(value: Boolean) {
    if (!value) throw IllegalStateException(Some("HTTP upload completion check failed"))
}

internal class CompletionGate {
    private var ready: Boolean = false
    private var waiter: Continuation<Unit>? = None
    fun signal() {
        ready = true
        val saved = waiter; waiter = None
        saved?.resume(Unit)
    }
    suspend fun await() {
        suspendCoroutine<Unit> { continuation ->
            if (ready) continuation.resume(Unit) else waiter = Some(continuation)
        }
    }
}

internal class CompletionSource(val holding: Boolean, val fail: Boolean) : AsyncByteSource, AsyncCloseable {
    val cleaning: CompletionGate = CompletionGate()
    val cancelled: CompletionGate = CompletionGate()
    val release: CompletionGate = CompletionGate()
    val failure: Throwable = IllegalStateException(Some("owned source cleanup failure"))
    var closed: Boolean = false
    private var consumed: Boolean = false

    public override suspend fun readInto(buffer: NativeByteBuffer, count: Long): Long {
        if (consumed || count == 0L) return 0L
        completionCheck(count >= 4L)
        buffer.writeBytes("sent".toByteArray()); consumed = true
        return 4L
    }
    public override suspend fun close() {
        val registration = currentJobOrNone()!!.invokeOnCancellation { _ -> cancelled.signal() }
        try {
            cleaning.signal()
            if (holding) release.await()
            closed = true
            if (fail) throw failure
        } finally { registration.dispose() }
    }
}

internal class CompletionFailure { var value: Throwable? = None }

internal suspend fun completionWrite(output: AsyncByteSink) {
    NativeByteBuffer.allocate(4L).use suspend { buffer ->
        buffer.writeBytes("done".toByteArray()); output.writeFully(buffer)
    }
}
