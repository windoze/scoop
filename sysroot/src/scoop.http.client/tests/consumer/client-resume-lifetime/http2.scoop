package scoop.http.client.tests.consumer.client_resume_lifetime

import scoop.test.*
import scoop.asyncio.*
import scoop.crypto.x509.TrustStore
import scoop.http.*
import scoop.http.asyncio.AsyncHttp2Connection
import scoop.http.client.*
import scoop.platform.fs.*
import scoop.platform.net.*
import scoop.platform.system.PlatformErrorKind
import scoop.platform.system.PlatformException
import scoop.test.*
import scoop.time.Duration
import scoop.url.Url

internal fun resumeHttp2(trust: TrustStore, directory: Path, total: Boolean) {
    val loop: EventLoop = PlatformEventLoop()
    loop.run suspend {
        scope ->
        loop.createDirectories(directory)
        loop.listenTcp(SocketAddress(IpAddress.IPV4_LOOPBACK, 0)).useAsync suspend {
            listener ->
            val url = Url.parse("http://127.0.0.1:" + listener.localAddress.port.toString() + "/")
            val finish = DownloadGate()
            val serving =
                scope.launch suspend {
                    AsyncHttp2Connection.takeOwnershipAsServer(
                        listener.accept(),
                        scope
                    ).useAsync suspend {
                        connection ->
                        for (index in 0L ..< 3L) {
                            val request = connection.acceptRequest()!!
                            val fields = ArrayList<HttpField>()
                            fields.add(downloadField("ETag", "\"one\""))
                            if (index == 0L)
                                assertEquals(
                                    0L,
                                    request.head.fields.findAll("Range".toByteArray()).size
                                )
                            else {
                                assertEquals(
                                    if (index == 1L)
                                        "bytes=1-"
                                    else
                                        "bytes=3-",
                                    String.fromUtf8(
                                        request.head.fields.findAll("Range".toByteArray())[0L].value
                                    )
                                )
                                fields.add(
                                    downloadField(
                                        "Content-Range",
                                        if (index == 1L)
                                            "bytes 1-2/4"
                                        else
                                            "bytes 3-3/4"
                                    )
                                )
                            }
                            val body =
                                if (index == 0L)
                                    "body"
                                else
                                    if (index == 1L)
                                        "od"
                                    else
                                        "y"
                            fields.add(
                                downloadField("Content-Length", body.toByteArray().size.toString())
                            )
                            request.stream.sendResponse(
                                HttpResponseHead(
                                    HttpVersion.Http2,
                                    if (index == 0L)
                                        200U
                                    else
                                        206U,
                                    fields = fields
                                ),
                                false
                            )
                            downloadWrite(request.stream, body)
                            request.stream.finish([downloadField("Segment", index.toString())])
                        }
                        finish.await()
                    }
                }
            try {
                withHttpClient(downloadConfig(trust, true)) suspend {
                    client ->
                    val target = directory.resolve(Path.fromString("result"))
                    val resume =
                        HttpResumeOptions(
                            directory.resolve(Path.fromString("partial")),
                            directory.resolve(Path.fromString("metadata"))
                        )
                    downloadStore(target, "original")
                    val first =
                        resumeFailure suspend {
                            client.resumeDownload(HttpRequest.get(url), target, resume);
                            Unit
                        }
                    assertTrue(first is PlatformException)
                    assertEquals(PlatformErrorKind.AlreadyExists, (first as PlatformException).kind)
                    loop.openFile(resume.partialFile, OpenOptions(write = true)).useAsync suspend {
                        file -> file.truncate(1L)
                    }
                    val delayed = AtomicBoolean(false)
                    val limit = Duration.seconds(10L)
                    val request =
                        HttpRequest.get(
                            url,
                            options =
                                HttpCallOptions(
                                    timeouts =
                                        if (total)
                                            Some(HttpTimeoutOptions(total = Some(limit)))
                                        else
                                            None
                                )
                        )
                    val options =
                        HttpDownloadOptions(
                            replaceExisting = true,
                            onProgress =
                                suspend {
                                    progress ->
                                    assertEquals(1L, progress.resumedBytes)
                                    if (
                                        total &&
                                            progress.bytesWritten ==
                                            3L &&
                                            delayed.compareAndSet(false, true)
                                    )
                                        loop.sleep(Duration.seconds(6L))
                                    if (total && progress.bytesWritten == 4L)
                                        loop.sleep(Duration.seconds(60L))
                                    Unit
                                }
                        )
                    if (total) {
                        val error =
                            resumeFailure suspend {
                                client.resumeDownload(request, target, resume, options);
                                Unit
                            }
                        assertTrue(error is HttpTimeoutException)
                        val timeout = error as HttpTimeoutException
                        assertEquals(HttpTimeoutPhase.Total, timeout.phase)
                        assertTrue(timeout.elapsed >= limit)
                        assertEquals(3L, timeout.responseBodyBytes)
                        assertEquals(3L, timeout.encodedResponseBodyBytes)
                        assertEquals("body", String.fromUtf8(downloadRead(resume.partialFile)))
                        assertEquals("original", String.fromUtf8(downloadRead(target)))
                        assertTrue(downloadExists(resume.metadataFile))
                    } else {
                        val result = client.resumeDownload(request, target, resume, options)
                        assertEquals(HttpVersion.Http2, result.head.version)
                        assertEquals(4L, result.byteCount)
                        assertEquals(1L, result.resumedBytes)
                        assertEquals("2", String.fromUtf8(result.trailers[0L].value))
                        assertEquals("body", String.fromUtf8(downloadRead(target)))
                        assertFalse(
                            downloadExists(resume.partialFile) ||
                                downloadExists(resume.metadataFile)
                        )
                    }
                    Unit
                }
            } finally {
                finish.signal()
            }
            serving.join()
        }
    }
}
