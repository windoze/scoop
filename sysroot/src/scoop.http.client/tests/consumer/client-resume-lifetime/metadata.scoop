package scoop.http.client.tests.consumer.client_resume_lifetime

import scoop.test.*
import scoop.asyncio.*
import scoop.crypto.x509.TrustStore
import scoop.http.client.*
import scoop.platform.fs.*
import scoop.platform.system.PlatformErrorKind
import scoop.platform.system.PlatformException
import scoop.test.*
import scoop.url.Url

internal fun resumeMetadata(trust: TrustStore, directory: Path, mode: String) {
    val completing = mode == "restart-missing" || mode == "restart-weak" || mode == "zero"
    resumeWithServer(directory, mode, if (completing) 2L else 1L) suspend { loop, _, url, _ ->
        val target = directory.resolve(Path.fromString("result"))
        val data = directory.resolve(Path.fromString("partial"))
        val metadata = directory.resolve(Path.fromString("metadata"))
        downloadStore(target, "original")
        val initial = HttpResumeOptions(data, metadata)
        withHttpClient(downloadConfig(trust)) suspend { client ->
            val first = resumeFailure suspend { client.resumeDownload(HttpRequest.get(url), target, initial); Unit }
            assertTrue(first is PlatformException)
            assertEquals(PlatformErrorKind.AlreadyExists, (first as PlatformException).kind)
            assertEquals("body", String.fromUtf8(downloadRead(data)))
            if (mode == "missing" || mode == "restart-missing") loop.deleteFile(metadata)
            if (mode == "invalid" || mode == "invalid-restart" || mode == "zero") downloadStore(metadata, "invalid")
            if (mode == "zero") loop.openFile(data, OpenOptions(write = true)).useAsync suspend { file -> file.truncate(0L) }
            if (mode == "length") downloadStore(data, "body!")
            val options = HttpResumeOptions(data, metadata,
                if ((completing && mode != "zero") || mode == "invalid-restart") HttpResumeMismatch.Restart else HttpResumeMismatch.Fail,
                if (mode == "limit") 1L else 65536L)
            val request = HttpRequest.get(if (mode == "url") Url.parse(url.toString() + "changed") else url)
            if (completing) {
                val result = client.resumeDownload(request, target, options, HttpDownloadOptions(replaceExisting = true))
                assertEquals(3L, result.byteCount)
                assertEquals(0L, result.resumedBytes)
                assertEquals("new", String.fromUtf8(downloadRead(target)))
                assertFalse(downloadExists(data) || downloadExists(metadata))
            } else {
                val error = resumeFailure suspend { client.resumeDownload(request, target, options); Unit }
                assertTrue(error is HttpResumeException)
                val reason = when (mode) {
                    "missing" -> HttpResumeFailureReason.MissingMetadata
                    "no-etag", "weak", "duplicate" -> HttpResumeFailureReason.UnreliableValidator
                    "length" -> HttpResumeFailureReason.InvalidRange
                    "url" -> HttpResumeFailureReason.RequestChanged
                    else -> HttpResumeFailureReason.InvalidMetadata
                }
                assertEquals(reason, (error as HttpResumeException).reason)
                assertEquals("original", String.fromUtf8(downloadRead(target)))
                assertEquals(if (mode == "length") "body!" else "body", String.fromUtf8(downloadRead(data)))
            }
            Unit
        }
    }
}

internal fun resumeInitialFailure(trust: TrustStore, directory: Path, mode: String) {
    resumeWithServer(directory, mode, 1L) suspend { _, _, url, _ ->
        val target = directory.resolve(Path.fromString("result"))
        val data = directory.resolve(Path.fromString("partial"))
        val metadata = directory.resolve(Path.fromString(if (mode == "file-error") "missing/metadata" else "metadata"))
        downloadStore(target, "original"); downloadStore(data, "old")
        withHttpClient(downloadConfig(trust)) suspend { client ->
            val options = HttpResumeOptions(data, metadata, maxMetadataBytes = if (mode == "write-limit") 1L else 65536L)
            val error = resumeFailure suspend { client.resumeDownload(HttpRequest.get(url), target, options); Unit }
            if (mode == "file-error") assertTrue(error is PlatformException)
            else {
                assertTrue(error is HttpResumeException)
                assertEquals(if (mode == "write-limit") HttpResumeFailureReason.InvalidMetadata else HttpResumeFailureReason.UnexpectedStatus,
                    (error as HttpResumeException).reason)
            }
            assertEquals("original", String.fromUtf8(downloadRead(target)))
            assertEquals(if (mode == "file-error") "" else "old", String.fromUtf8(downloadRead(data)))
            assertFalse(downloadExists(metadata))
        }
    }
}
