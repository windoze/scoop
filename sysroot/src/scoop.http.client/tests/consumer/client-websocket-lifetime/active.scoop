package scoop.http.client.tests.consumer.client_websocket_lifetime

import scoop.test.*
import scoop.asyncio.*
import scoop.crypto.x509.TrustStore
import scoop.http.asyncio.*
import scoop.http.client.*
import scoop.test.*
import scoop.time.Duration

internal fun clientWsOpening(trust: TrustStore, mode: String) {
    withClientWsPeer("opening") suspend { _, scope, url, peer ->
        val client = HttpClient.open(scope, clientWsConfig(trust))
        val failed = ClientWsFailure()
        val running = scope.launch suspend {
            try {
                clientWsOpen(client, url, HttpCallOptions(timeouts = if (mode == "total")
                    Some(HttpTimeoutOptions(total = Some(Duration.seconds(5L)))) else None))
            } catch (error: Throwable) { failed.value = Some(error) }
        }
        try {
            peer.received.await()
            assertFalse(running.isCompleted)
            if (mode == "caller") running.cancel()
            if (mode == "client") client.close()
            running.join()
            when (mode) {
                "caller" -> assertTrue(failed.value!! is CancellationException)
                "client" -> assertTrue(failed.value!! is HttpClientClosedException)
                else -> {
                    assertTrue(failed.value!! is HttpTimeoutException)
                    assertEquals(HttpTimeoutPhase.Total, (failed.value!! as HttpTimeoutException).phase)
                }
            }
        } finally { client.close() }
    }
}

internal fun clientWsReading(trust: TrustStore, mode: String) {
    withClientWsPeer("session") suspend { _, scope, url, _ ->
        val client = HttpClient.open(scope, clientWsConfig(trust))
        val session = clientWsOpen(client, url)
        val started = ClientWsGate()
        val failure = ClientWsFailure()
        val reading = scope.launch suspend {
            try { started.signal(); session.receive() }
            catch (error: Throwable) { failure.value = Some(error) }
        }
        try {
            started.await()
            assertTrue(clientWsFailure suspend { session.receive(); Unit } is IllegalStateException)
            assertFalse(reading.isCompleted || session.isClosed)
            if (mode == "caller") reading.cancel()
            else if (mode == "client") client.close()
            else session.close()
            reading.join()
            assertTrue(session.isClosed)
            assertTrue(if (mode == "caller") failure.value!! is CancellationException else failure.value!! is WebSocketSessionException)
            if (mode != "caller") assertFalse(clientWsPresent(session.failure))
            session.awaitClosed()
        } finally { client.close() }
    }
}

internal fun clientWsIdle(trust: TrustStore) {
    withClientWsPeer("session") suspend { loop, scope, url, peer ->
        val client = HttpClient.open(scope, clientWsConfig(trust))
        try {
            val opening = scope.async suspend {
                clientWsOpen(client, url, HttpCallOptions(timeouts = Some(HttpTimeoutOptions(total = Some(Duration.seconds(5L))))))
            }
            val session = opening.await()
            assertTrue(opening.isCompleted)
            loop.sleep(Duration.seconds(6L))
            assertFalse(session.isClosed || clientWsPresent(session.failure))
            peer.session!!.sendText("after HTTP deadline")
            assertEquals("after HTTP deadline", session.receive()!!.readText())
            client.close()
            assertTrue(client.isClosed && session.isClosed)
        } finally { client.close() }
    }
}

internal fun clientWsRejectedDeadline(trust: TrustStore) {
    withClientWsPeer("reject") suspend { _, scope, url, _ ->
        val client = HttpClient.open(scope, clientWsConfig(trust))
        try {
            val result = client.openWebSocket(HttpWebSocketRequest(url,
                options = HttpCallOptions(timeouts = Some(HttpTimeoutOptions(total = Some(Duration.seconds(5L)))))))
            when (result) {
                case Opened(_) -> throw IllegalStateException(Some("expected rejected handshake"))
                case Rejected(response, cause) -> {
                    assertTrue(cause is scoop.http.WebSocketHandshakeException)
                    assertEquals(403U, response.status)
                    val error = clientWsFailure suspend { response.body.text(16L); Unit }
                    assertTrue(error is HttpTimeoutException)
                    assertEquals(HttpTimeoutPhase.Total, (error as HttpTimeoutException).phase)
                    response.close()
                }
            }
        } finally { client.close() }
    }
}
