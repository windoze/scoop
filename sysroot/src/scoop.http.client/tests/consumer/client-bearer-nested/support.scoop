package scoop.http.client.tests.consumer.client_bearer_nested
import scoop.asyncio.*
import scoop.collections.emptyList
import scoop.crypto.x509.TrustStore
import scoop.http.*
import scoop.http.asyncio.AsyncHttp1Connection
import scoop.http.client.*
import scoop.platform.memory.NativeByteBuffer
import scoop.platform.net.*
import scoop.tls.TlsTrustSource
import scoop.url.Url

internal fun bearerCheck(value: Boolean, detail: String = "Bearer authentication integration check failed") {
    if (!value) throw IllegalStateException(Some(detail))
}

internal fun <T> bearerPresent(value: T?): Boolean = when (value) { case Some(_) -> true; case None -> false }

internal suspend fun <E : Throwable> bearerFailure(block: suspend () -> Unit): E {
    try { block() }
    catch (error: Throwable) { if (error is E) return error; throw error }
    throw IllegalStateException(Some("expected Bearer authentication failure"))
}

internal fun bearerConfig(trust: TrustStore, authentication: HttpAuthenticationOptions = HttpAuthenticationOptions(),
    h2: Boolean = false, retries: HttpRetryOptions = HttpRetryOptions(maxRetries = 0L)): HttpClientConfig =
    HttpClientConfig(tls = HttpClientTlsConfig(TlsTrustSource.Store(trust)), authentication = authentication,
        cleartext = if (h2) HttpCleartextProtocol.Http2PriorKnowledge else HttpCleartextProtocol.Http1,
        retries = retries, pool = HttpConnectionPoolOptions(maxConnectionsPerOrigin = 4L))

internal fun bearerUrl(listener: AsyncTcpListener): Url =
    Url.parse("http://127.0.0.1:" + listener.localAddress.port.toString() + "/private/start")

internal fun withBearerRuntime(block: suspend (EventLoop, CoroutineScope, AsyncTcpListener) -> Unit) {
    val loop: EventLoop = LibuvEventLoop()
    loop.run suspend { scope ->
        loop.listenTcp(SocketAddress(IpAddress.IPV4_LOOPBACK, 0)).useAsync suspend { listener ->
            block(loop, scope, listener)
            bearerCheck(!scope.job.isCancelled)
        }
    }
}

internal fun bearerField(name: String, value: String): HttpField = HttpField(name.toByteArray(), value.toByteArray())

internal suspend fun bearerWrite(output: AsyncByteSink, text: String) {
    val bytes = text.toByteArray()
    NativeByteBuffer.allocate(bytes.size).use suspend { buffer ->
        buffer.writeBytes(bytes)
        output.writeFully(buffer)
    }
}

internal suspend fun bearerRespond(connection: AsyncHttp1Connection, status: UInt, text: String = "",
    extra: List<HttpField> = emptyList<HttpField>()) {
    val fields = ArrayList<HttpField>()
    fields.add(bearerField("Connection", "close"))
    for (field in extra) fields.add(field)
    connection.sendResponse(HttpResponseHead(HttpVersion.Http11, status, Some("actual Bearer response".toByteArray()), fields),
        Http1BodyFraming.Length(text.toByteArray().size)).useAsync suspend { output ->
        if (text.charLength != 0L) bearerWrite(output, text)
        output.finish()
    }
}

internal class BearerGate {
    private var ready: Boolean = false
    private val waiters: ArrayList<Continuation<Unit>> = ArrayList<Continuation<Unit>>()
    fun signal() {
        ready = true
        val saved = waiters.toArray(); waiters.clear()
        for (waiter in saved) waiter.resume(Unit)
    }
    suspend fun await() {
        suspendCoroutine<Unit> { continuation ->
            if (ready) continuation.resume(Unit) else waiters.add(continuation)
        }
    }
}

internal class BearerFailureHolder { var value: Throwable? = None }
internal class BearerContext(val name: String)
context(value: BearerContext)
internal fun bearerContext(): String = value.name

internal fun bearerToken(head: HttpRequestHead): String? {
    val fields = head.fields.findAll("Authorization".toByteArray())
    if (fields.size == 0L) return None
    bearerCheck(fields.size == 1L)
    val credentials = HttpCredentials.parse(fields[0L].value)
    bearerCheck(credentials.scheme == "bearer")
    return credentials.token68
}

internal suspend fun bearerDone(client: HttpClient, request: HttpRequest) {
    client.withResponse(request) suspend { response ->
        bearerCheck(response.authenticationCount == 0L && response.body.text(4L) == "done")
    }
}

internal class BearerClientHolder { var value: HttpClient? = None }
