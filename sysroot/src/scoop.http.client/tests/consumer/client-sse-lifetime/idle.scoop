package scoop.http.client.tests.consumer.client_sse_lifetime

import scoop.test.*
import scoop.asyncio.*
import scoop.crypto.x509.TrustStore
import scoop.http.client.*
import scoop.test.*
import scoop.time.Duration

internal fun sseIdle(trust: TrustStore, mode: String) {
    withSsePeer("idle") suspend { loop, scope, url, _ ->
        val client = HttpClient.open(scope, sseConfig(trust))
        try {
            val limit = Duration.seconds(10L)
            val options = HttpCallOptions(timeouts = if (mode == "total") Some(HttpTimeoutOptions(total = Some(limit))) else None)
            val source = scope.async suspend { client.openSse(HttpRequest.get(url, options = options),
                HttpSseOptions(reconnect = Some(HttpSseReconnectOptions()))) }.await()
            assertEquals("body", source.next()!!.data)
            client.withResponse(HttpRequest.get(url)) suspend { response -> assertEquals("ok", response.body.text(16L)) }
            assertFalse(source.isClosed || source.isFinished)
            if (mode == "close") source.close()
            else if (mode == "client") client.close()
            else while (!source.isClosed) loop.sleep(Duration.milliseconds(10L))
            assertTrue(source.isClosed)
            assertFalse(source.isFinished)
            val failure = sseFailure suspend { source.next(); Unit }
            if (mode == "close") {
                assertTrue(failure is IoClosedException)
                assertFalse(ssePresent(source.failure) || client.isClosed)
            } else {
                assertSame(failure, source.failure!!)
                if (mode == "client") assertTrue(failure is HttpClientClosedException)
                else {
                    assertTrue(failure is HttpTimeoutException)
                    val timeout = failure as HttpTimeoutException
                    assertEquals(HttpTimeoutPhase.Total, timeout.phase)
                    assertTrue(timeout.elapsed >= limit)
                    assertEquals(sseLifetimeBody.toByteArray().size, timeout.responseBodyBytes)
                }
            }
            source.close()
        } finally { client.close() }
    }
}

internal fun sseActive(trust: TrustStore, mode: String, opening: Boolean) {
    withSsePeer(if (opening) "opening" else "read") suspend { _, scope, url, received ->
        val client = HttpClient.open(scope, sseConfig(trust))
        val failed = SseFailure()
        val reconnects = AtomicLong(0L)
        val reconnect = HttpSseOptions(reconnect = Some(HttpSseReconnectOptions(Duration.ZERO, Duration.ZERO, Some(2L),
            suspend { _ -> reconnects.fetchAdd(1L); Unit })))
        val request = HttpRequest.get(url, options = HttpCallOptions(timeouts = if (mode == "read-idle")
            Some(HttpTimeoutOptions(readIdle = Some(Duration.seconds(5L)))) else None))
        val source = if (opening) None else Some(client.openSse(request, reconnect))
        val running = scope.launch suspend {
            try { if (opening) client.openSse(request, reconnect) else source!!.next() }
            catch (error: Throwable) { failed.value = Some(error) }
        }
        try {
            received.await()
            assertFalse(running.isCompleted)
            if (!opening) {
                assertTrue(sseFailure suspend { source!!.next(); Unit } is IllegalStateException)
                assertFalse(running.isCompleted || ssePresent(source!!.failure))
            }
            if (mode == "caller") running.cancel()
            else if (mode == "client") client.close()
            else if (mode == "close") source!!.close()
            running.join()
            val failure = failed.value!!
            when (mode) {
                "caller" -> assertTrue(failure is CancellationException)
                "client" -> assertTrue(failure is HttpClientClosedException)
                "read-idle" -> { assertTrue(failure is HttpTimeoutException); assertEquals(HttpTimeoutPhase.ReadIdle, (failure as HttpTimeoutException).phase) }
                else -> assertTrue(failure is IoClosedException)
            }
            assertEquals(0L, reconnects.load())
            if (ssePresent(source)) {
                assertTrue(source!!.isClosed)
                if (mode != "close") assertSame(failure, source!!.failure!!)
            }
        } finally { client.close() }
    }
}
