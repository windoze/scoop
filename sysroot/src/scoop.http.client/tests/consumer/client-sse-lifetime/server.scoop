package scoop.http.client.tests.consumer.client_sse_lifetime

import scoop.test.*
import scoop.asyncio.*
import scoop.http.*
import scoop.http.asyncio.AsyncHttp2Connection
import scoop.platform.memory.NativeByteBuffer
import scoop.platform.net.*
import scoop.test.*
import scoop.text.endsWith
import scoop.url.Url

internal val sseLifetimeBody: String = "id: one\ndata: body\n\n"

internal fun withSsePeer(mode: String, block: suspend (EventLoop, CoroutineScope, Url, SseGate) -> Unit) {
    val loop: EventLoop = LibuvEventLoop()
    loop.run suspend { scope ->
        loop.listenTcp(SocketAddress(IpAddress.IPV4_LOOPBACK, 0)).useAsync suspend { listener ->
            val finish = SseGate()
            val received = SseGate()
            val serving = scope.launch suspend {
                if (mode == "duplex") {
                    AsyncHttp2Connection.takeOwnershipAsServer(listener.accept(), scope).useAsync suspend { connection ->
                        val request = connection.acceptRequest()!!
                        assertEquals("POST", String.fromUtf8(request.head.method))
                        received.signal()
                        request.stream.sendResponse(HttpResponseHead(HttpVersion.Http2, 200U,
                            fields = [sseField("Content-Type", "text/event-stream"),
                                sseField("Content-Length", sseLifetimeBody.toByteArray().size.toString())]), false)
                        sseWrite(request.stream, sseLifetimeBody)
                        request.stream.finish()
                        finish.await()
                    }
                } else listener.accept().useAsync suspend { peer ->
                    sseReadHead(peer)
                    received.signal()
                    if (mode != "opening") {
                        sseWrite(peer, "HTTP/1.1 200 OK\r\nContent-Type: text/event-stream\r\nContent-Length: " +
                            sseLifetimeBody.toByteArray().size.toString() + "\r\n\r\n")
                        if (mode != "read") sseWrite(peer, sseLifetimeBody)
                        if (mode == "idle") {
                            sseReadHead(peer)
                            sseWrite(peer, "HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nok")
                        }
                    }
                    finish.await()
                }
            }
            try { block(loop, scope, Url.parse("http://127.0.0.1:" + listener.localAddress.port.toString() + "/"), received) }
            finally { finish.signal() }
            serving.join()
        }
    }
}

private suspend fun sseReadHead(peer: AsyncByteSource) {
    NativeByteBuffer.allocate(4096L).use suspend { buffer ->
        var header = ""
        while (!header.endsWith("\r\n\r\n")) {
            buffer.clear()
            val count = peer.readInto(buffer, buffer.capacity)
            assertTrue(count > 0L)
            header += String.fromUtf8(buffer.getBytes(0L, count))
        }
    }
}
