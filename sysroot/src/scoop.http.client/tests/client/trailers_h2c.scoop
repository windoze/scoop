package scoop.http.client

import scoop.asyncio.*
import scoop.http.*
import scoop.http.asyncio.*
import scoop.test.*

@Test
private class HttpClientTrailersH2cTest {
    @Test
    fun `h2c completes the original chunked request trailers once after Continue`() {
        withClientH2cTest suspend { _, scope, listener, config ->
            val serving = scope.launch suspend {
                AsyncHttp1Connection.takeOwnershipAsServer(listener.accept(), scope).useAsync suspend { h1 ->
                    val incoming = h1.receiveRequest()!!
                    assertTrue(httpExpectsContinue(incoming.head.fields))
                    assertTrue(parseHttpContentLength(incoming.head.fields) == None)
                    h1.sendResponse(HttpResponseHead(HttpVersion.Http11, 100U)).finish()
                    assertEquals("sent", String.fromUtf8(incoming.body.readAllBytes(4L)))
                    assertEquals("done", String.fromUtf8(incoming.body.trailers!![0L].value))
                    acceptClientTestUpgrade(h1, scope, incoming.head).useAsync suspend { h2 ->
                        h2.upgradedStream!!.sendResponse(HttpResponseHead(HttpVersion.Http2, 204U))
                        val next = h2.acceptRequest()!!
                        assertEquals(3, next.stream.id)
                        assertEquals(0L, next.stream.readAllBytes(0L).size)
                        next.stream.sendResponse(HttpResponseHead(HttpVersion.Http2, 204U))
                    }
                }
            }
            val calls = AtomicLong(0L)
            val body = RequestBody.fromProducerWithTrailers(["X-End"], Some(4L)) suspend { output ->
                calls.fetchAdd(1L)
                writeBodyText(output, "sent")
                [HttpField("X-End".toByteArray(), "done".toByteArray())]
            }
            withHttpClient(config) suspend { client ->
                client.withResponse(HttpRequest.post(clientTestUrl(listener), body,
                    options = HttpCallOptions(expectContinue = true))) suspend { response ->
                    assertTrue(response.version == HttpVersion.Http2)
                    assertEquals(0L, response.body.readAllBytes(0L).size)
                }
                client.withResponse(HttpRequest.get(clientTestUrl(listener))) suspend { response ->
                    assertTrue(response.version == HttpVersion.Http2)
                    assertEquals(0L, response.body.readAllBytes(0L).size)
                }
            }
            serving.join()
            assertEquals(1L, calls.load())
        }
    }
}
