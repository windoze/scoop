package scoop.http.client

import scoop.asyncio.*
import scoop.http.asyncio.AsyncHttp1Connection
import scoop.test.*
import scoop.time.Duration

@Test
private class HttpClientCancellationTest {
    @Test
    fun `caller cancellation and concurrent client close wait for owned source cleanup`() {
        clientTestTrust().use {
            trust ->
            val loop: EventLoop = PlatformEventLoop()
            loop.run suspend {
                scope -> clientTestListen(loop).useAsync suspend {
                    listener ->
                    val source = BodyTestSource("late".toByteArray())
                    source.holdRead = true;
                    source.holdClose = true
                    val serverDone = BodyTestGate()
                    val serving =
                        scope.launch suspend {
                            AsyncHttp1Connection.takeOwnershipAsServer(
                                listener.accept(),
                                scope
                            ).useAsync suspend {
                                connection ->
                                connection.receiveRequest()
                                serverDone.await()
                            }
                        }
                    val client = HttpClient.open(scope, clientTestConfig(trust))
                    val failure = ClientTestFailureHolder()
                    val executing =
                        scope.launch suspend {
                            try {
                                client.execute(
                                    HttpRequest.post(
                                        clientTestUrl(listener),
                                        RequestBody.fromSourceFactory suspend { source }
                                    )
                                ).close()
                                throw IllegalStateException(
                                    Some("cancelled call completed successfully")
                                )
                            } catch (error: Throwable) {
                                failure.value = Some(error)
                            }
                        }
                    source.started.await()
                    executing.cancel()
                    val first = scope.launch suspend { client.close() }
                    val second = scope.launch suspend { client.close() }
                    assertFalse(first.isCompleted || second.isCompleted || executing.isCompleted)
                    source.release.signal()
                    source.closeStarted.await()
                    assertFalse(first.isCompleted || second.isCompleted || executing.isCompleted)
                    source.closeRelease.signal()
                    executing.join();
                    first.join();
                    second.join()
                    assertTrue(failure.value!! is CancellationException)
                    assertTrue(client.isClosed)
                    assertEquals(1L, source.closes)
                    assertTrue(source.buffer!!.isClosed)
                    serverDone.signal()
                    serving.join()
                    assertFalse(scope.job.isCancelled)
                }
            }
        }
    }

    @Test
    fun `client closes from a cancelled finally and a later connection failure does not poison the parent`() {
        clientTestTrust().use {
            trust ->
            val loop: EventLoop = PlatformEventLoop()
            loop.run suspend {
                scope ->
                val started = BodyTestGate()
                val closed = BodyTestGate()
                val task =
                    scope.launch suspend {
                        coroutineScope suspend {
                            child ->
                            val client = HttpClient.open(child, clientTestConfig(trust))
                            try {
                                started.signal();
                                loop.sleep(Duration.seconds(100L))
                            }
                            finally {
                                client.close();
                                closed.signal();
                                assertTrue(client.isClosed)
                            }
                        }
                    }
                started.await()
                task.cancel()
                closed.await()
                task.join()
                val listener = clientTestListen(loop)
                val url = clientTestUrl(listener)
                listener.close()
                withHttpClient(clientTestConfig(trust)) suspend {
                    client -> expectBodyFailure<Throwable> suspend {
                        client.execute(HttpRequest.get(url));
                        Unit
                    }
                }
                assertFalse(scope.job.isCancelled)
            }
        }
    }
}
