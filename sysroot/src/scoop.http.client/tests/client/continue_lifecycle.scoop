package scoop.http.client

import scoop.asyncio.*
import scoop.http.*
import scoop.http.asyncio.*
import scoop.test.*
import scoop.time.Duration

@Test
private class HttpClientContinueLifecycleTest {
    @Test
    fun `Continue and h2c finish the original upload before transferring stream one`() {
        withClientH2cTest suspend { _, scope, listener, config ->
            val started = AtomicBoolean(false)
            val serving = scope.launch suspend {
                AsyncHttp1Connection.takeOwnershipAsServer(listener.accept(), scope).useAsync suspend { h1 ->
                    val incoming = h1.receiveRequest()!!
                    assertTrue(httpExpectsContinue(incoming.head.fields))
                    readHttp2UpgradeSettings(incoming.head)
                    assertFalse(started.load())
                    h1.sendResponse(HttpResponseHead(HttpVersion.Http11, 100U)).finish()
                    assertEquals("body", String.fromUtf8(incoming.body.readAllBytes(4L)))
                    acceptClientTestUpgrade(h1, scope, incoming.head).useAsync suspend { h2 ->
                        assertEquals(1, h2.upgradedStream!!.id)
                        h2.upgradedStream!!.sendResponse(HttpResponseHead(HttpVersion.Http2, 204U))
                    }
                }
            }
            withHttpClient(config) suspend { client ->
                val body = RequestBody.fromProducer(Some(4L)) suspend { output ->
                    assertFalse(started.exchange(true))
                    writeBodyText(output, "body")
                }
                client.withResponse(HttpRequest.post(clientTestUrl(listener), body,
                    options = HttpCallOptions(expectContinue = true, continueWait = Duration.seconds(60L)))) suspend { response ->
                    assertTrue(response.version == HttpVersion.Http2)
                    assertEquals(204U, response.status)
                    response.body.readAllBytes(0L)
                    Unit
                }
            }
            serving.join()
        }
    }

    @Test
    fun `cancelling Continue waiting never acquires the source and closes its timer with the client`() {
        withClientContinueTest suspend { _, scope, listener, config ->
            val waiting = BodyTestGate()
            val done = BodyTestGate()
            val acquired = AtomicBoolean(false)
            val source = BodyTestSource("body".toByteArray())
            val serving = scope.launch suspend {
                AsyncHttp1Connection.takeOwnershipAsServer(listener.accept(), scope).useAsync suspend { h1 ->
                    h1.receiveRequest()
                    h1.sendResponse(HttpResponseHead(HttpVersion.Http11, 103U)).finish()
                    done.await()
                }
            }
            val client = HttpClient.open(scope, config)
            val failure = ClientTestFailureHolder()
            val executing = scope.launch suspend {
                val body = RequestBody.fromSourceFactory(Some(4L)) suspend { acquired.store(true); source }
                val options = HttpCallOptions(expectContinue = true, continueWait = Duration.seconds(3600L),
                    onInformational = suspend { head -> assertEquals(103U, head.status); waiting.signal() })
                try { client.execute(HttpRequest.post(clientTestUrl(listener), body, options = options)).close() }
                catch (error: Throwable) { failure.value = Some(error) }
            }
            waiting.await()
            executing.cancel()
            val closing = scope.launch suspend { client.close() }
            executing.join(); closing.join()
            assertTrue(failure.value!! is CancellationException)
            assertFalse(acquired.load())
            assertEquals(0L, source.reads + source.closes)
            assertTrue(client.isClosed)
            source.close()
            done.signal()
            serving.join()
            assertFalse(scope.job.isCancelled)
        }
    }
}
