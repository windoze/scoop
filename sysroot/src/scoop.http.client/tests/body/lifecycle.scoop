package scoop.http.client

import scoop.asyncio.*
import scoop.platform.io.WriteZeroException
import scoop.platform.memory.NativeByteBuffer
import scoop.test.*

@Test
private class RequestBodyLifecycleTest {
    @Test
    fun `cancellation waits for late input and owned source close before returning`() {
        val source = BodyTestSource("abc".toByteArray())
        source.holdRead = true
        source.holdClose = true
        val output = BodyTestSink()
        val body = RequestBody.fromSourceFactory suspend { source }
        val loop: EventLoop = PlatformEventLoop()
        loop.run suspend {
            scope ->
            val sending =
                scope.launch suspend {
                    body.writeTo(output);
                    Unit
                }
            source.started.await()
            try {
                sending.cancel()
                assertFalse(sending.isCompleted)
                assertEquals(0L, source.closes)
                assertFalse(source.buffer!!.isClosed)
                gcCollect()
            } finally {
                source.release.signal()
            }
            source.closeStarted.await()
            try {
                assertFalse(sending.isCompleted)
                assertEquals(3L, source.position)
                assertEquals(0L, output.bytes.size)
                assertTrue(source.buffer!!.isClosed)
            } finally {
                source.closeRelease.signal()
            }
            sending.join()
            assertTrue(sending.isCancelled)
            assertEquals(1L, source.closes)
            assertFalse(scope.job.isCancelled)
        }
    }

    @Test
    fun `already cancelled entry leaves a single source available for a later call`() {
        val source = BodyTestSource("later".toByteArray())
        val body = RequestBody.fromSource(source)
        val loop: EventLoop = PlatformEventLoop()
        loop.run suspend {
            _ ->
            try {
                coroutineScope<Unit> suspend {
                    scope ->
                    scope.job.cancel()
                    expectBodyFailure<CancellationException> suspend {
                        body.writeTo(BodyTestSink())
                    }
                }
            } catch (_: CancellationException) {}
            assertEquals(0L, source.reads)
            assertEquals("later", bodyText(body))
        }
    }

    @Test
    fun `a concurrent second use cannot read from the same single input`() {
        val source = BodyTestSource("once".toByteArray())
        source.holdRead = true
        val body = RequestBody.fromSource(source)
        val loop: EventLoop = PlatformEventLoop()
        loop.run suspend {
            scope ->
            val first = scope.async suspend { bodyText(body) }
            source.started.await()
            try {
                expectBodyFailure<RequestBodyConsumedException> suspend {
                    body.writeTo(BodyTestSink())
                }
                assertEquals(1L, source.reads)
            } finally {
                source.release.signal()
            }
            assertEquals("once", first.await())
        }
    }

    @Test
    fun `a producer cannot overlap output operations while a short write is suspended`() {
        val output = BodyTestSink()
        output.holdWrite = true
        val loop: EventLoop = PlatformEventLoop()
        loop.run suspend {
            _ ->
            val body =
                RequestBody.fromProducer(Some(1L)) suspend {
                    sink -> coroutineScope<Unit> suspend {
                        scope ->
                        val writing = scope.launch suspend { writeBodyText(sink, "x") }
                        output.started.await()
                        try {
                            expectBodyFailure<IllegalStateException> suspend { sink.flush() }
                            NativeByteBuffer.allocate(1L).use suspend {
                                buffer ->
                                buffer.writeByte(9)
                                expectBodyFailure<IllegalStateException> suspend {
                                    sink.writeFrom(buffer, 1L)
                                }
                                assertEquals(1L, buffer.readableBytes)
                            }
                        } finally {
                            output.release.signal()
                        }
                        writing.join()
                    }
                }
            assertEquals(1L, body.writeTo(output))
            assertEquals("x", String.fromUtf8(output.bytes.toByteArray()))
        }
    }

    @Test
    fun `invalid configuration zero writes and false progress fail explicitly`() {
        assertFailsWith<IllegalArgumentException> {
            RequestBody.fromSource(BodyTestSource("x".toByteArray()), Some(-1L))
        }
        val loop: EventLoop = PlatformEventLoop()
        loop.run suspend {
            _ ->
            val zero = BodyTestSink()
            zero.zero = true
            expectBodyFailure<WriteZeroException> suspend {
                RequestBody.fromText("x").writeTo(zero)
            }
            val caught =
                RequestBody.fromProducer suspend {
                    sink -> try {
                        writeBodyText(sink, "x")
                    }
                    catch (_: WriteZeroException) {}
                }
            expectBodyFailure<WriteZeroException> suspend { caught.writeTo(zero) }
            val invalid = BodyTestSink()
            invalid.invalidProgress = true
            expectBodyFailure<IllegalStateException> suspend {
                RequestBody.fromText("xy").writeTo(invalid)
            }
            assertEquals("xy", String.fromUtf8(invalid.bytes.toByteArray()))
        }
    }
}
