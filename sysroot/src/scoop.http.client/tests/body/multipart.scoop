package scoop.http.client

import scoop.asyncio.*
import scoop.collections.emptyList
import scoop.http.*
import scoop.http.asyncio.MultipartSource
import scoop.test.*
import scoop.text.contains

@Test
private class MultipartRequestBodyTest {
    @Test
    fun `multipart metadata and parts are snapshotted with an exact known length`() {
        val fields = ArrayList<HttpField>()
        fields.add(HttpField("content-type".toByteArray(), "application/custom".toByteArray()))
        fields.add(HttpField("X-Part".toByteArray(), "retained".toByteArray()))
        val part = RequestBodyPart(RequestBody.fromText("one"), fields)
        fields.clear()
        assertEquals("application/custom", String.fromUtf8(part.head.fields.findAll("Content-Type".toByteArray())[0L].value))
        assertEquals(2L, part.head.fields.size)
        val parts = ArrayList<RequestBodyPart>()
        parts.add(part)
        parts.add(RequestBodyPart.formData("中文", RequestBody.fromText("two"), Some("报告.txt")))
        val body = RequestBody.fromMultipart(parts, MultipartBoundary("quoted boundary"))
        parts.clear()
        assertTrue(body.isReplayable)
        val loop: EventLoop = LibuvEventLoop()
        loop.run suspend { _ ->
            val encoded = collectRequestBody(body, 1L)
            assertTrue(body.contentLength == Some(encoded.size))
            assertTrue(String.fromUtf8(encoded).contains("name=\"中文\"; filename=\"报告.txt\""))
            readBodyParts(body, ["one", "two"])
        }
    }

    @Test
    fun `unknown length source factories are reopened and closed inside each multipart send`() {
        val opened = ArrayList<BodyTestSource>()
        val source = RequestBody.fromSourceFactory suspend {
            val input = BodyTestSource("stream".toByteArray())
            opened.add(input)
            input
        }
        val body = RequestBody.fromMultipart([RequestBodyPart.formData("file", source)])
        assertTrue(body.isReplayable)
        assertTrue(body.contentLength == None)
        assertEquals(0L, opened.size)
        val loop: EventLoop = LibuvEventLoop()
        loop.run suspend { _ ->
            readBodyParts(body, ["stream"])
            readBodyParts(body, ["stream"])
            assertEquals(2L, opened.size)
            for (input in opened) assertEquals(1L, input.closes)
        }
    }

    @Test
    fun `a multipart body containing one single source rejects reuse before another delimiter`() {
        val source = BodyTestSource("once".toByteArray())
        val body = RequestBody.fromMultipart([
            RequestBodyPart(RequestBody.fromText("before")),
            RequestBodyPart(RequestBody.fromSource(source))
        ])
        assertFalse(body.isReplayable)
        val loop: EventLoop = LibuvEventLoop()
        loop.run suspend { _ ->
            readBodyParts(body, ["before", "once"])
            val output = BodyTestSink()
            expectBodyFailure<RequestBodyConsumedException> suspend { body.writeTo(output) }
            assertEquals(0L, output.calls + output.bytes.size + source.closes)
        }
    }

    @Test
    fun `empty and nested multipart bodies use the same streaming encoding`() {
        val empty = RequestBody.fromMultipart(emptyList<RequestBodyPart>(), MultipartBoundary("empty"))
        val inner = RequestBody.fromMultipart([RequestBodyPart(RequestBody.fromText("inside"))], MultipartBoundary("inner"), "mixed")
        val outer = RequestBody.fromMultipart([RequestBodyPart(inner)], MultipartBoundary("outer"))
        val loop: EventLoop = LibuvEventLoop()
        loop.run suspend { _ ->
            val encodedEmpty = collectRequestBody(empty)
            assertEquals("--empty--\r\n", String.fromUtf8(encodedEmpty))
            assertTrue(empty.contentLength == Some(encodedEmpty.size))
            val encoded = collectRequestBody(outer)
            assertTrue(outer.contentLength == Some(encoded.size))
            MultipartSource(BodyTestSource(encoded), MultipartBoundary("outer"), bufferSize = 3L).useAsync suspend { source ->
                val part = source.nextPart()!!
                val media = HttpMediaType.parse(part.head.fields.findAll("Content-Type".toByteArray())[0L].value)
                assertEquals("mixed", media.subtype)
                MultipartSource(part.body, MultipartBoundary.fromMediaType(media), bufferSize = 1L).useAsync suspend { nested ->
                    val child = nested.nextPart()!!
                    assertEquals("inside", String.fromUtf8(child.body.readAllBytes(100L)))
                    assertTrue(when (nested.nextPart()) { case None -> true; case Some(_) -> false })
                }
                assertTrue(when (source.nextPart()) { case None -> true; case Some(_) -> false })
            }
        }
    }
}
