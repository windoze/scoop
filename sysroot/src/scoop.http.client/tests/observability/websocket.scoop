package scoop.http.client

import scoop.asyncio.*
import scoop.http.*
import scoop.http.asyncio.*
import scoop.test.*
import scoop.url.Url

@Test
private class HttpRequestObservationWebSocketTest {
    @Test
    fun `WebSocket upgrade preserves request observation and treats 101 as final`() {
        clientTestTrust().use { trust ->
            LibuvEventLoop().run suspend { scope ->
                clientTestListen(currentEventLoop()).useAsync suspend { listener ->
                    val done = BodyTestGate()
                    val serving = scope.launch suspend {
                        AsyncHttp1Connection.takeOwnershipAsServer(listener.accept(), scope).useAsync suspend { connection ->
                            val request = connection.receiveRequest()!!
                            request.body.readAllBytes(0L)
                            val handshake = WebSocketHandshake.parse(request.head)
                            connection.sendResponse(handshake.response()).useAsync suspend { writer -> writer.finish() }
                            AsyncWebSocketSession.takeOwnership(connection.takeTransport(), scope, HttpRole.Server)
                                .useAsync suspend { _ -> done.await() }
                        }
                    }
                    val log = RequestObservationLog()
                    try {
                        withHttpClient(clientTestConfig(trust)) suspend { client ->
                            val url = Url.parse("ws://127.0.0.1:" + listener.localAddress.port.toString() + "/")
                            client.withWebSocket(HttpWebSocketRequest(url,
                                options = HttpCallOptions(observer = Some(log.observer)))) suspend { result ->
                                when (result) {
                                    case Opened(session) -> {
                                        assertEquals(Some(101U), session.metrics!!.status)
                                        checkRequestObservation(session.metrics!!)
                                    }
                                    case Rejected(_, error) -> throw error
                                }
                            }
                        }
                    } finally { done.signal() }
                    serving.join()
                    checkRequestObservation(log.completed())
                }
            }
        }
    }
}
