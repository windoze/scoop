package scoop.http.client

import scoop.asyncio.*
import scoop.collections.emptyList
import scoop.http.*
import scoop.http.asyncio.AsyncHttp1Connection
import scoop.platform.time.MonotonicTimeSource
import scoop.test.*
import scoop.time.Duration

@Test
private class HttpClientRetryStatusTest {
    @Test
    fun `status retries are opt in and Retry After is not clipped to the exponential maximum`() {
        for (enabled in [false, true]) {
            val retry = HttpRetryOptions(statuses = if (enabled) [503U] else emptyList<UInt>(),
                initialDelay = Duration.ZERO, maxDelay = Duration.ZERO)
            withClientRetryTest(retry) suspend { _, scope, listener, config ->
                val done = BodyTestGate()
                val serving = scope.launch suspend {
                    AsyncHttp1Connection.takeOwnershipAsServer(listener.accept(), scope).useAsync suspend { connection ->
                        connection.receiveRequest()!!.body.readAllBytes(0L)
                        val before = MonotonicTimeSource.markNow()
                        sendRetryTestStatus(connection, fields = [HttpField("Retry-After".toByteArray(), "1".toByteArray())])
                        if (enabled) {
                            connection.receiveRequest()!!.body.readAllBytes(0L)
                            assertTrue(MonotonicTimeSource.markNow() - before >= Duration.seconds(1L))
                            sendClientTestText(connection, 200U, "done")
                        }
                        done.await()
                    }
                }
                try {
                    withHttpClient(config) suspend { client ->
                        client.withResponse(HttpRequest.get(clientTestUrl(listener))) suspend { response ->
                            assertEquals(if (enabled) 200U else 503U, response.status)
                            assertEquals(if (enabled) 1L else 0L, response.retryCount)
                            assertEquals(if (enabled) "done" else "", response.body.text(4L))
                        }
                    }
                } finally { done.signal() }
                serving.join()
                assertFalse(scope.job.isCancelled)
            }
        }
    }

    @Test
    fun `redirects take precedence and the call override and retry count survive a GET rewrite`() {
        val options = HttpRetryOptions(statuses = [302U, 503U], initialDelay = Duration.ZERO, jitter = false)
        withClientRetryTest(immediateClientRetryOptions(0L)) suspend { _, scope, listener, config ->
            val serving = scope.launch suspend {
                AsyncHttp1Connection.takeOwnershipAsServer(listener.accept(), scope).useAsync suspend { connection ->
                    for ((path, method, status, location) in [("/start", "POST", 302U, "/a"), ("/a", "GET", 503U, ""),
                        ("/a", "GET", 302U, "/b"), ("/b", "GET", 503U, ""), ("/b", "GET", 503U, "")]) {
                        val incoming = connection.receiveRequest()!!
                        assertEquals(method, String.fromUtf8(incoming.head.method))
                        when (incoming.head.target) {
                            case Http1(bytes) -> assertEquals(path, String.fromUtf8(bytes))
                            else -> fail(Some("expected an HTTP/1 target"))
                        }
                        incoming.body.readAllBytes(0L)
                        val fields = if (status == 302U) [HttpField("Location".toByteArray(), location.toByteArray())]
                            else emptyList<HttpField>()
                        sendRetryTestStatus(connection, status, fields)
                    }
                }
            }
            withHttpClient(config) suspend { client ->
                client.withResponse(HttpRequest.post(clientTestUrl(listener, "/start"), RequestBody.Empty,
                    options = HttpCallOptions(retries = Some(options)))) suspend { response ->
                    assertEquals(503U, response.status); assertEquals(2L, response.retryCount)
                    assertEquals(2L, response.redirectHistory.size)
                    assertEquals(clientTestUrl(listener, "/b").toString(), response.url.toString())
                    response.body.bytes(0L)
                }
            }
            serving.join()
            assertFalse(scope.job.isCancelled)
        }
    }
}
