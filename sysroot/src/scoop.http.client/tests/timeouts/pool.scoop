package scoop.http.client

import scoop.asyncio.*
import scoop.http.*
import scoop.http.asyncio.AsyncHttp1Connection
import scoop.test.*
import scoop.time.Duration

@Test
private class HttpClientPoolTimeoutTest {
    @Test
    fun `a queued timeout leaves the occupying call usable and returns no extra connection lease`() {
        withClientTimeoutTest suspend { _, scope, listener, config ->
            val serving = scope.launch suspend {
                AsyncHttp1Connection.takeOwnershipAsServer(listener.accept(), scope).useAsync suspend { connection ->
                    var index = 0
                    while (index < 2) {
                        connection.receiveRequest()!!.body.readAllBytes(0L)
                        sendClientTestText(connection, 200U, "ok")
                        index += 1
                    }
                }
            }
            withHttpClient(config) suspend { client ->
                val held = client.execute(HttpRequest.get(clientTestUrl(listener)))
                val limit = Duration.milliseconds(5L)
                val failure = expectBodyFailure<HttpTimeoutException> suspend {
                    client.execute(HttpRequest.get(clientTestUrl(listener),
                        options = HttpCallOptions(timeouts = Some(HttpTimeoutOptions(poolAcquire = Some(limit)))))); Unit
                }
                checkClientTimeout(failure, HttpTimeoutPhase.PoolAcquire, limit)
                assertEquals("ok", held.body.text(2L)); held.close()
                client.withResponse(HttpRequest.get(clientTestUrl(listener))) suspend { response ->
                    assertEquals("ok", response.body.text(2L))
                }
            }
            serving.join()
            assertFalse(scope.job.isCancelled)
        }
    }

    @Test
    fun `zero pool wait fails before dialing and an admitted connection stops its pool timer`() {
        val limit = clientTimeoutTestDuration()
        withClientTimeoutTest suspend { loop, scope, listener, config ->
            val serving = scope.launch suspend {
                AsyncHttp1Connection.takeOwnershipAsServer(listener.accept(), scope).useAsync suspend { connection ->
                    connection.receiveRequest()!!.body.readAllBytes(0L)
                    connection.sendResponse(HttpResponseHead(HttpVersion.Http11, 103U)).finish()
                    sendClientTestText(connection, 200U, "ok")
                }
            }
            withHttpClient(config) suspend { client ->
                val failure = expectBodyFailure<HttpTimeoutException> suspend {
                    client.execute(HttpRequest.get(clientTestUrl(listener),
                        options = HttpCallOptions(timeouts = Some(HttpTimeoutOptions(poolAcquire = Some(Duration.ZERO)))))); Unit
                }
                checkClientTimeout(failure, HttpTimeoutPhase.PoolAcquire, Duration.ZERO)
                val options = HttpCallOptions(timeouts = Some(HttpTimeoutOptions(poolAcquire = Some(limit))),
                    onInformational = suspend { _ -> loop.sleep(limit + Duration.milliseconds(10L)) })
                client.withResponse(HttpRequest.get(clientTestUrl(listener), options = options)) suspend { response ->
                    assertEquals("ok", response.body.text(2L))
                }
            }
            serving.join()
        }
    }
}
