//! dep: scoop:scoop.asyncio:0.1.0
//! dep: scoop:scoop.http.client:0.1.0
//! dep: scoop:scoop.url:0.1.0

import scoop.asyncio.*
import scoop.http.client.*
import scoop.url.Url

fun main(args: Array<String>) {
    val url = Url.parse(if (args.size > 1L) args[1L] else "http://127.0.0.1:8080/")
    val loop: EventLoop = LibuvEventLoop()
    loop.run suspend { _ ->
        withHttpClient suspend { client ->
            client.withResponse(HttpRequest.get(url)) suspend { response ->
                response.requireSuccess()
                println(response.status)
                println(response.body.text(1_048_576L))
            }
        }
    }
}
