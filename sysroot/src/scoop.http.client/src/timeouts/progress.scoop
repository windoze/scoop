package scoop.http.client

import scoop.asyncio.*
import scoop.http.HttpVersion
import scoop.platform.memory.NativeByteBuffer

internal suspend fun sendClientBytes(call: ClientCall, destination: ClientExchange, buffer: NativeByteBuffer, count: Long): Long {
    val before = if (call.tracksProgress) buffer.readPosition else 0L
    val written = try { destination.writeFrom(buffer, count) }
    catch (error: Throwable) { recordClientUploadIoFailure(call, error, destination.version == HttpVersion.Http2); throw error }
    finally {
        if (call.tracksProgress)
            call.lock.withLock { call.requestBodyBytes = addClientProgress(call.requestBodyBytes, buffer.readPosition - before) }
        Unit
    }
    if (call.tracksProgress) requireClientCall(call)
    return written
}

internal suspend fun receiveClientBytes(call: ClientCall, source: AsyncByteSource, buffer: NativeByteBuffer,
    count: Long, encoded: Boolean): Long {
    if (!call.tracksProgress) return source.readInto(buffer, count)
    val before = buffer.writePosition
    try { return source.readInto(buffer, count) }
    finally {
        val amount = buffer.writePosition - before
        call.lock.withLock {
            if (encoded) call.encodedResponseBodyBytes = addClientProgress(call.encodedResponseBodyBytes, amount)
            else call.responseBodyBytes = addClientProgress(call.responseBodyBytes, amount)
        }
    }
}

internal class ClientResponseWireSource(private val call: ClientCall) : AsyncByteSource {
    public override suspend fun readInto(buffer: NativeByteBuffer, count: Long): Long =
        receiveClientBytes(call, call.exchange!!, buffer, count, true)
}

private fun addClientProgress(previous: Long, count: Long): Long =
    if (count > Long.MAX_VALUE - previous) Long.MAX_VALUE else previous + count
