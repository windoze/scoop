package scoop.http.client

import scoop.asyncio.IoClosedException
import scoop.http.HttpResponseHead
import scoop.http.asyncio.SseSource
import scoop.platform.time.MonotonicTimeSource
import scoop.time.Duration
import scoop.url.Url

internal class ClientSseInfo(var url: Url, var head: HttpResponseHead)

internal class ClientSseState(val client: ClientState, val original: HttpRequest, val options: HttpSseOptions, initialId: String) {
    var sequence: ClientRequestSequence = ClientRequestSequence(client.config, original)
    var lastCall: ClientCall? = None
    var response: HttpResponse? = None
    var reader: SseSource? = None
    var info: ClientSseInfo? = None
    var lastEventId: String = initialId
    var delay: Duration = when (options.reconnect) { case Some(value) -> value.initialDelay; case None -> Duration.ZERO }
    var reconnects: Long = 0L
    var registered: Boolean = false
    var running: Boolean = false
    var active: Job? = None
    var timer: Job? = None
    var closing: Boolean = false
    var closed: Boolean = false
    var finished: Boolean = false
    var explicitClose: Boolean = false
    var cleanupStarted: Boolean = false
    var failure: Throwable? = None
    var cleanupFailure: Throwable? = None
    val closeWaiters: ArrayList<Continuation<Unit>> = ArrayList<Continuation<Unit>>()

    fun requireActive() {
        client.lock.withLock {
            if (clientPresent(failure)) throw failure!!
            if (closing && !finished) throw IoClosedException()
            Unit
        }
        ensureActive()
        val limit = sequence.timeouts.total
        if (clientPresent(limit) && MonotonicTimeSource.markNow() - sequence.started!! >= limit!!) throw timeout()
    }

    fun timeout(): HttpTimeoutException {
        val (current, last) = client.lock.withLock { (sequence, lastCall) }
        return clientSequenceTimeout(client, current, last)
    }
}

internal fun recordClientSseFailure(state: ClientSseState, error: Throwable) {
    state.client.lock.withLock {
        state.finished = false
        val primary = state.failure
        if (!clientPresent(primary)) {
            if (error is ResourceUseException) {
                state.failure = Some(error.primaryFailure)
                state.cleanupFailure = collectClientSecondary(error.primaryFailure, state.cleanupFailure, error.cleanupFailure)
            } else state.failure = Some(error)
        } else state.cleanupFailure = collectClientSecondary(primary!!, state.cleanupFailure, error)
        state.closing = true
    }
}

internal fun clientSseFailure(state: ClientSseState): Throwable? = when (state.cleanupFailure) {
    case Some(cleanup) -> Some(clientCombined(state.failure, cleanup))
    case None -> state.failure
}

context(source: ClientSseState)
private fun boundClientSse(): ClientSseState = source

internal fun checkClientSseClose(client: ClientState, source: ClientSseState? = None) {
    val bound = try { Some(boundClientSse()) } catch (_: MissingContextException) { None }
    if (clientPresent(bound) && bound!!.client === client && (!clientPresent(source) || bound!! === source!!) &&
        client.lock.withLock { bound!!.running })
        throw IllegalStateException(Some("cannot await SSE or client close from an active event-source operation"))
}
