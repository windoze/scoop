package scoop.http.client

import scoop.http.*
import scoop.url.Url

/**
 * A suspend interceptor around a logical call. It may invoke the chain once while active and is
 * responsible for returning a compatible owned result.
 */
public class HttpInterceptor public constructor(internal val intercept: suspend (HttpCallChain) -> HttpCallResult)

/**
 * The current logical request and one-shot continuation into later interceptors or transport.
 */
public class HttpCallChain internal constructor(internal val invocation: ClientInvocation,
    internal val next: Long,
        /**
         * The current request passed to this interceptor.
         */
        public val request: HttpRequest) {
    /**
     * The caller-supplied fields, before client-managed framing and authority.
     */
    public val suppliedFields: Array<HttpField> = request.suppliedFields.toArray()
    /**
     * Upgrade options when this chain belongs to a WebSocket handshake.
     */
    public val webSocketOptions: HttpWebSocketOptions? = invocation.sequence.webSocket
    internal var active: Boolean = true
    internal var proceeded: Boolean = false

    /**
     * Invokes the remainder of the chain once while active, optionally replacing URL, method,
     * fields, and body. WebSocket chains require a replayable empty GET.
     */
    public suspend fun proceed(url: Url = request.url, method: String = request.method,
        fields: List<HttpField> = suppliedFields, body: RequestBody = request.body): HttpCallResult {
        invocation.client.lock.withLock {
            if (!active || proceeded) throw IllegalStateException(Some("HTTP interceptor chain can proceed only once while active"))
            proceeded = true
        }
        invocation.requireActive()
        val selected = HttpRequest(url, method, fields, body, request.options)
        if (clientPresent(webSocketOptions)) {
            if (method != "GET" || body.contentLength != Some(0L) || !body.isReplayable || body.trailerNames.size != 0L)
                throw IllegalArgumentException(Some("WebSocket interceptor requires GET with a replayable empty body"))
            val websocket = HttpWebSocketRequest(clientWebSocketUrl(url), fields, request.options)
            validateClientWebSocket(websocket, webSocketOptions!!)
        }
        return invokeClientInterceptor(invocation, next, selected)
    }
}

internal suspend fun invokeClientInterceptor(invocation: ClientInvocation, index: Long, request: HttpRequest): HttpCallResult {
    invocation.requireActive()
    val interceptors = invocation.client.config.interceptors
    if (index == interceptors.size) {
        val result = runClientSequence(invocation.client, request, invocation.sequence)
        rememberClientInvocationResult(invocation, result)
        return result
    }
    val chain = HttpCallChain(invocation, index + 1L, request)
    try {
        val result = interceptors[index].intercept(chain)
        rememberClientInvocationResult(invocation, result)
        return result
    } finally { invocation.client.lock.withLock { chain.active = false } }
}
