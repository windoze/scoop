package scoop.http.client

import scoop.asyncio.*
import scoop.http.*

internal interface ClientExchange : AsyncByteStream, AsyncCloseable {
    public val version: HttpVersion
    public val isReadComplete: Boolean
    public val trailers: Array<HttpField>?
    public suspend fun receiveResponse(): HttpResponseHead
    public suspend fun finish(trailers: List<HttpField>)
}

internal suspend fun openClientExchange(call: ClientCall, connection: ClientConnection): ClientExchange {
    val request = call.request
    return when (connection) {
        case Http1(value) -> {
            val version = call.client.config.http1RequestVersion
            validateClientHttp1Request(request, version)
            val framing = if (request.body.trailerNames.size != 0L) Http1BodyFraming.Chunked else when (request.contentLength) {
                case Some(0L) -> Http1BodyFraming.Empty
                case Some(length) -> Http1BodyFraming.Length(length)
                case None -> Http1BodyFraming.Chunked
            }
            val entry = call.lock.withLock { call.lease!! }
            val upgrading = call.client.lock.withLock { entry.h2cPending }
            val head = clientRequestHead(request, version, call.client.config)
            val prepared = if (upgrading) prepareHttp2Upgrade(head, call.client.config.http2Settings) else head
            val exchange = ClientH1Exchange(value, value.sendRequest(prepared, framing, writeIdle = call.timeouts.writeIdle),
                version, call.timeouts.readIdle)
            if (upgrading) ClientH2cExchange(call, entry, exchange) else exchange
        }
        case Http2(value) -> {
            val stream = value.openRequest(clientRequestHead(request, HttpVersion.Http2, call.client.config), false, clientIoTimeouts(call))
            bindClientHttp2Stream(call, stream)
            ClientH2Exchange(stream)
        }
    }
}

private fun clientRequestHead(request: HttpRequest, version: HttpVersion, config: HttpClientConfig): HttpRequestHead {
    val fields = ArrayList<HttpField>()
    for (field in request.fields) if (!field.hasName("Content-Length".toByteArray())) fields.add(field)
    addClientAcceptEncoding(fields, request, config)
    if (version == HttpVersion.Http2 || request.body.trailerNames.size == 0L) {
        when (request.contentLength) {
            case Some(length) -> fields.add(HttpField("Content-Length".toByteArray(), length.toString().toByteArray()))
            case None -> {}
        }
    }
    val authority = request.origin.authority(request.url.authority!!.port != None).toByteArray()
    if (version != HttpVersion.Http2) fields.add(HttpField("Host".toByteArray(), authority))
    val target = if (request.method == "CONNECT") HttpRequestTarget.Connect(request.origin.authority(true).toByteArray())
        else if (version == HttpVersion.Http2) HttpRequestTarget.Http2(request.origin.scheme.toByteArray(), authority, request.url.httpRequestTarget().toByteArray())
        else HttpRequestTarget.Http1(request.url.httpRequestTarget().toByteArray())
    return HttpRequestHead(version, request.methodBytes, target, fields)
}
