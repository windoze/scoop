package scoop.http.client

import scoop.http.HttpAuthChallenge

public class HttpBearerTokens public constructor(public val accessToken: String, public val refreshToken: String? = None)

public class HttpBearerRefreshRequest internal constructor(
    public val request: HttpRequest,
    public val challenge: HttpAuthChallenge,
    public val attempt: Long,
    public val tokens: HttpBearerTokens
)

internal class ClientBearerAuthentication(
    val loadTokens: suspend (HttpAuthenticationRequest) -> HttpBearerTokens,
    val refreshTokens: suspend (HttpBearerRefreshRequest) -> HttpBearerTokens?
)
