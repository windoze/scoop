package scoop.http.client

import scoop.collections.emptyList
import scoop.http.HttpAuthChallenge
import scoop.url.Url
import scoop.url.UrlOrigin

public enum HttpBasicCharset { Iso8859_1, Utf8 }

public class HttpPasswordCredentials public constructor(public val username: String, public val password: String)

public class HttpAuthenticationRequest internal constructor(
    public val request: HttpRequest,
    public val challenge: HttpAuthChallenge?,
    public val attempt: Long,
    public val proxyUrl: Url? = None
)

public class HttpAuthenticationOptions public constructor(
    providers: List<HttpAuthenticator> = emptyList<HttpAuthenticator>(),
    public val maxAttempts: Long = 3L
) {
    public val providers: Array<HttpAuthenticator> = providers.toArray()
    init {
        if (maxAttempts < 0L) throw IllegalArgumentException(Some("negative authentication attempt limit"))
    }
}

public class HttpAuthenticator private constructor(
    public val origin: UrlOrigin,
    realm: List<Byte>?,
    public val sendWithoutChallenge: Boolean,
    internal val provider: ClientAuthenticationProvider
) {
    public val realm: Array<Byte>? = when (realm) { case Some(value) -> Some(value.toArray()); case None -> None }
    init {
        if (origin.scheme != "http" && origin.scheme != "https")
            throw IllegalArgumentException(Some("authentication origin must use http or https"))
    }

    public companion object {
        public fun digest(
            origin: UrlOrigin,
            realm: List<Byte>? = None,
            sendWithoutChallenge: Boolean = true,
            algorithms: List<HttpDigestAlgorithm> = [HttpDigestAlgorithm.Sha512_256, HttpDigestAlgorithm.Sha512_256Sess,
                HttpDigestAlgorithm.Sha256, HttpDigestAlgorithm.Sha256Sess, HttpDigestAlgorithm.Md5, HttpDigestAlgorithm.Md5Sess],
            preferIntegrity: Boolean = false,
            credentials: suspend (HttpAuthenticationRequest) -> HttpPasswordCredentials
        ): HttpAuthenticator =
            HttpAuthenticator(origin, realm, sendWithoutChallenge,
                ClientAuthenticationProvider.Digest(ClientDigestAuthentication(algorithms, preferIntegrity, credentials)))

        public fun bearer(
            origin: UrlOrigin,
            realm: List<Byte>? = None,
            sendWithoutChallenge: Boolean = true,
            refreshTokens: suspend (HttpBearerRefreshRequest) -> HttpBearerTokens? = suspend { _ -> None },
            loadTokens: suspend (HttpAuthenticationRequest) -> HttpBearerTokens
        ): HttpAuthenticator =
            HttpAuthenticator(origin, realm, sendWithoutChallenge,
                ClientAuthenticationProvider.Bearer(ClientBearerAuthentication(loadTokens, refreshTokens)))

        public fun basic(
            origin: UrlOrigin,
            realm: List<Byte>? = None,
            sendWithoutChallenge: Boolean = false,
            charset: HttpBasicCharset = HttpBasicCharset.Iso8859_1,
            credentials: suspend (HttpAuthenticationRequest) -> HttpPasswordCredentials
        ): HttpAuthenticator =
            HttpAuthenticator(origin, realm, sendWithoutChallenge,
                ClientAuthenticationProvider.Basic(ClientBasicAuthentication(charset, credentials)))
    }
}

internal enum ClientAuthenticationProvider { Basic(ClientBasicAuthentication), Bearer(ClientBearerAuthentication), Digest(ClientDigestAuthentication) }

internal class ClientBasicAuthentication(
    val charset: HttpBasicCharset,
    val credentials: suspend (HttpAuthenticationRequest) -> HttpPasswordCredentials
)
