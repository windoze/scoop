package scoop.http.client

import scoop.charset.*

internal suspend fun clientDigestSecret(call: ClientCall, selection: ClientDigestSession,
    provider: ClientDigestAuthentication): ClientDigestSecret {
    val challenge = selection.nonce.challenge
    val credentials = provider.credentials(HttpAuthenticationRequest(call.originalRequest, Some(challenge.original),
        call.sequence.authenticationCount))
    requireClientCall(call)
    val username = if (challenge.utf8) normalizeNfc(credentials.username) else credentials.username
    val password = if (challenge.utf8) normalizeNfc(credentials.password) else credentials.password
    for (character in username) {
        if (character.code < 32 || character.code == 127 || character == ':')
            throw HttpAuthenticationException(HttpAuthenticationFailure.InvalidCredentials, call.request.url)
    }
    for (character in password) if (character.code < 32 || character.code == 127)
        throw HttpAuthenticationException(HttpAuthenticationFailure.InvalidCredentials, call.request.url)
    val charset = if (challenge.utf8) Charset.Utf8 else Charset.Iso8859_1
    try {
        val ha1 = clientDigestHash(challenge.algorithm,
            [charset.encode(username), ":".toByteArray(), challenge.realm, ":".toByteArray(), charset.encode(password)])
        return ClientDigestSecret(username, ha1)
    } catch (error: CharsetException) {
        throw HttpAuthenticationException(HttpAuthenticationFailure.InvalidCredentials, call.request.url, cause = Some(error))
    }
}
