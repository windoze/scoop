package scoop.http.client

import scoop.asyncio.*
import scoop.charset.Charset
import scoop.collections.emptyList
import scoop.compression.CompressionOptions
import scoop.compression.GzipOptions
import scoop.http.HttpMediaType
import scoop.http.HttpField
import scoop.http.HttpTrailerDeclaration
import scoop.http.MultipartBoundary
import scoop.platform.fs.Path
import scoop.url.UrlQuery

public class RequestBody internal constructor(
    contentLength: Long?, public val contentType: HttpMediaType?, private val plan: RequestBodyPlan,
    contentEncodings: List<String> = emptyList<String>(),
    internal val trailerDeclaration: HttpTrailerDeclaration = HttpTrailerDeclaration(emptyList<String>()),
    internal val entityDigests: Array<ClientEntityDigest> = []
) {
    public val contentLength: Long? = checkedBodyLength(contentLength)
    public val contentEncodings: Array<String> = contentEncodings.toArray()
    public val trailerNames: Array<String> get() = trailerDeclaration.names
    public val isReplayable: Boolean get() = plan.isReplayable

    public fun compressed(options: CompressionOptions = CompressionOptions.Gzip(GzipOptions())): RequestBody =
        compressedRequestBody(this, options)

    public fun withDigest(algorithm: HttpDigestAlgorithm, bytes: List<Byte>): RequestBody =
        RequestBody(contentLength, contentType, plan, contentEncodings, trailerDeclaration,
            replaceClientEntityDigest(entityDigests, algorithm, bytes))

    public suspend fun writeTo(destination: AsyncByteSink, bufferSize: Long = 8192L): Long {
        ensureActive()
        if (trailerNames.size != 0L)
            throw IllegalArgumentException(Some("request body trailers require writeWithTrailersTo"))
        return writeWithTrailersTo(destination, bufferSize).transferredBytes
    }

    public suspend fun writeWithTrailersTo(destination: AsyncByteSink, bufferSize: Long = 8192L): RequestBodyWriteResult {
        ensureActive()
        if (bufferSize <= 0L) throw IllegalArgumentException(Some("request body buffer size must be positive"))
        val sink = RequestBodySink(destination, contentLength)
        try {
            val trailers = plan.writeTo(sink, bufferSize).toArray()
            val transferred = sink.finish()
            trailerDeclaration.requireDeclared(trailers)
            return RequestBodyWriteResult(transferred, trailers)
        } finally { sink.end() }
    }

    public companion object {
        public val Empty: RequestBody = RequestBody(Some(0L), None, RequestBytes(Array<Byte>(0L) { _ -> 0.toByte() }))

        public fun fromByteArray(bytes: List<Byte>, contentType: HttpMediaType? = None): RequestBody {
            val snapshot = bytes.toArray()
            return RequestBody(Some(snapshot.size), contentType, RequestBytes(snapshot))
        }

        public fun fromText(text: String, charset: Charset = Charset.Utf8): RequestBody =
            textRequestBody(text, charset)

        public fun <T> fromJson(value: T, codec: ValueEncoder<T>, maxBytes: Long): RequestBody =
            jsonRequestBody(value, codec, maxBytes)

        public fun fromForm(parameters: UrlQuery): RequestBody = formRequestBody(parameters)

        public fun fromMultipart(parts: List<RequestBodyPart>, boundary: MultipartBoundary = MultipartBoundary.generate(),
            subtype: String = "form-data"): RequestBody = multipartRequestBody(parts, boundary, subtype)

        public fun fromSource(source: AsyncByteSource, contentLength: Long? = None,
            contentType: HttpMediaType? = None): RequestBody =
            RequestBody(contentLength, contentType, RequestBodyOnce(suspend { destination, bufferSize ->
                source.copyTo(destination, bufferSize)
                emptyList<HttpField>()
            }))

        public fun <T> fromSourceFactory(contentLength: Long? = None, contentType: HttpMediaType? = None,
            factory: suspend () -> T): RequestBody where T : AsyncByteSource, T : AsyncCloseable =
            RequestBody(contentLength, contentType, RequestBodyFactory(suspend {
                suspend { destination, bufferSize ->
                    factory().useAsync suspend { source -> source.copyTo(destination, bufferSize); Unit }
                    emptyList<HttpField>()
                }
            }))

        public fun fromFile(path: Path, contentLength: Long? = None, contentType: HttpMediaType? = None): RequestBody =
            fromSourceFactory(contentLength, contentType, suspend { currentEventLoop().openFile(path) })

        public fun fromProducer(contentLength: Long? = None, contentType: HttpMediaType? = None,
            producer: suspend (AsyncByteSink) -> Unit): RequestBody =
            RequestBody(contentLength, contentType, RequestBodyOnce(suspend { destination, _ ->
                producer(destination)
                emptyList<HttpField>()
            }))

        public fun fromProducerFactory(contentLength: Long? = None, contentType: HttpMediaType? = None,
            factory: suspend () -> suspend (AsyncByteSink) -> Unit): RequestBody =
            RequestBody(contentLength, contentType, RequestBodyFactory(suspend {
                val producer = factory();
                suspend { destination, _ -> producer(destination); emptyList<HttpField>() }
            }))

        public fun fromProducerWithTrailers(trailerNames: List<String>, contentLength: Long? = None,
            contentType: HttpMediaType? = None, producer: suspend (AsyncByteSink) -> List<HttpField>): RequestBody =
            RequestBody(contentLength, contentType, RequestBodyOnce(suspend { destination, _ -> producer(destination) }),
                trailerDeclaration = HttpTrailerDeclaration(trailerNames))

        public fun fromProducerWithTrailersFactory(trailerNames: List<String>, contentLength: Long? = None,
            contentType: HttpMediaType? = None, factory: suspend () -> suspend (AsyncByteSink) -> List<HttpField>): RequestBody =
            RequestBody(contentLength, contentType, RequestBodyFactory(suspend {
                val producer = factory();
                suspend { destination, _ -> producer(destination) }
            }), trailerDeclaration = HttpTrailerDeclaration(trailerNames))
    }
}

public class RequestBodyWriteResult internal constructor(public val transferredBytes: Long, public val trailers: Array<HttpField>)

private fun checkedBodyLength(length: Long?): Long? {
    if (length != None && length!! < 0L) throw IllegalArgumentException(Some("negative request body length"))
    return length
}
