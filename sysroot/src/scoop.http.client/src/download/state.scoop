package scoop.http.client

import scoop.asyncio.TemporaryFile
import scoop.platform.time.MonotonicTimeSource

internal class ClientDownload(val client: ClientState, val caller: Job, val sequence: ClientRequestSequence) {
    var job: Job? = None
    var registered: Boolean = false
    var committing: Boolean = false
    var failure: Throwable? = None
    var cleanupFailure: Throwable? = None
    var responseCall: ClientCall? = None
    var temporary: TemporaryFile? = None

    fun requireActive() {
        val current = client.lock.withLock { failure }
        if (clientPresent(current)) throw current!!
        caller.ensureActive()
        ensureActive()
        val limit = sequence.timeouts.total
        if (clientPresent(limit) && MonotonicTimeSource.markNow() - sequence.started!! >= limit!!) throw timeout()
    }

    fun timeout(): HttpTimeoutException {
        val active = client.lock.withLock {
            var current = responseCall
            for (call in client.calls) if (call.sequence === sequence) current = Some(call)
            current
        }
        val progress = when (active) {
            case Some(call) -> call.lock.withLock { (call.requestBodyBytes, call.encodedResponseBodyBytes, call.responseBodyBytes) }
            case None -> (sequence.requestBodyBytes, sequence.encodedResponseBodyBytes, sequence.responseBodyBytes)
        }
        val (sent, encoded, decoded) = progress
        return HttpTimeoutException(HttpTimeoutPhase.Total, sequence.timeouts.total!!,
            MonotonicTimeSource.markNow() - sequence.started!!, sent, encoded, decoded)
    }
}

internal fun stopClientDownload(download: ClientDownload, reason: Throwable) {
    val job: Job? = download.client.lock.withLock {
        if (download.committing) return@withLock None
        if (!clientPresent(download.failure)) download.failure = Some(reason)
        download.job
    }
    job?.cancel()
}

context(download: ClientDownload)
private fun boundClientDownload(): ClientDownload = download

internal fun checkClientDownloadClose(state: ClientState) {
    val current = try { Some(boundClientDownload()) } catch (_: MissingContextException) { None }
    if (clientPresent(current) && current!!.client === state && state.lock.withLock { current!!.registered })
        throw IllegalStateException(Some("cannot await client.close from an active download"))
}
