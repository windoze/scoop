package scoop.http.client

import scoop.platform.time.MonotonicTimeSource
import scoop.time.Duration
import scoop.time.TimeMark

internal class ClientRequestSequence(config: HttpClientConfig, request: HttpRequest) {
    val timeouts: HttpTimeoutOptions = request.options.timeouts ?: config.timeouts
    val started: TimeMark? = if (timeouts.total != None) Some(MonotonicTimeSource.markNow()) else None
    val redirects: HttpRedirectOptions = request.options.redirects ?: config.redirects
    val retries: HttpRetryOptions = request.options.retries ?: config.retries
    val authentication: HttpAuthenticationOptions = request.options.authentication ?: config.authentication
    val authenticationSessions: ArrayList<ClientAuthenticationSession> = ArrayList<ClientAuthenticationSession>()
    var authenticationCount: Long = 0L
    var proxyAuthenticationCount: Long = 0L
    val history: ArrayList<HttpRedirect> = ArrayList<HttpRedirect>()
    var retryCount: Long = 0L
    var unprocessedRetryUsed: Boolean = false
    var requestBodyBytes: Long = 0L
    var encodedResponseBodyBytes: Long = 0L
    var responseBodyBytes: Long = 0L
}

internal enum ClientFollowUp { Redirect(ClientRedirect), Retry(Duration), Authenticate(ClientAuthenticationSession) }
internal enum ClientCallResult { Response(HttpResponse), FollowUp(ClientFollowUp), Failed(ClientIoFailure, Boolean) }

internal suspend fun executeClientRequest(state: ClientState, request: HttpRequest): HttpResponse {
    val caller = clientJob(state.loop, true)
    val sequence = ClientRequestSequence(state.config, request)
    var current = request
    while (true) {
        caller.ensureActive()
        val result = executeClientAttempt(state, current, caller, sequence)
        when (result) {
            case Response(response) -> return response
            case FollowUp(ClientFollowUp.Redirect(redirect)) -> {
                sequence.history.add(redirect.history)
                current = redirect.request
            }
            case FollowUp(ClientFollowUp.Retry(delay)) -> {
                awaitClientRetry(state, caller, sequence, delay)
                sequence.retryCount += 1L
            }
            case FollowUp(ClientFollowUp.Authenticate(session)) -> {
                sequence.authenticationSessions.add(session)
                if (session.scope.isProxy) sequence.proxyAuthenticationCount += 1L
                else sequence.authenticationCount += 1L
            }
            case Failed(failure, bodyStarted) -> {
                val delay = planClientFailureRetry(sequence, current, failure, bodyStarted) ?: throw failure.cause
                awaitClientRetry(state, caller, sequence, delay)
                sequence.retryCount += 1L
            }
        }
    }
}
