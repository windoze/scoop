package scoop.http.client

import scoop.asyncio.EventLoop
import scoop.collections.ArrayDeque
import scoop.tls.TlsClientContext

internal class ClientState(val loop: EventLoop, val config: HttpClientConfig, val tls: TlsClientContext, val cachePartition: String?) {
    val lock: ClientLock = ClientLock()
    val calls: ArrayList<ClientCall> = ArrayList<ClientCall>()
    val retryWaits: ArrayList<Job> = ArrayList<Job>()
    val downloads: ArrayList<ClientDownload> = ArrayList<ClientDownload>()
    val eventSources: ArrayList<ClientSseState> = ArrayList<ClientSseState>()
    val webSockets: ArrayList<ClientWebSocketState> = ArrayList<ClientWebSocketState>()
    val invocations: ArrayList<ClientInvocation> = ArrayList<ClientInvocation>()
    var webSocketTls: TlsClientContext? = None
    val bearerEntries: ArrayList<ClientBearerEntry> = ArrayList<ClientBearerEntry>()
    val digestEntries: ArrayList<ClientDigestEntry> = ArrayList<ClientDigestEntry>()
    val waiting: ArrayDeque<ClientCall> = ArrayDeque<ClientCall>()
    val upgrades: ArrayDeque<ClientUpgrade> = ArrayDeque<ClientUpgrade>()
    val connections: ArrayList<ClientPoolEntry> = ArrayList<ClientPoolEntry>()
    var scope: CoroutineScope? = None
    var ownerHold: Continuation<Unit>? = None
    var wake: Continuation<Unit>? = None
    var dirty: Boolean = false
    var adopted: Boolean = false
    var closing: Boolean = false
    var closed: Boolean = false
    var closeFailure: Throwable? = None
    val closeWaiters: ArrayList<Continuation<Unit>> = ArrayList<Continuation<Unit>>()
}

internal fun wakeClient(state: ClientState) {
    val wake = state.lock.withLock { state.dirty = true; val saved = state.wake; state.wake = None; saved }
    if (clientPresent(wake)) wake!!.resume(Unit)
}

internal fun stopClient(state: ClientState) {
    val (calls, retryWaits, bearers, downloads, eventSources, webSockets, invocations) = state.lock.withLock {
        state.closing = true
        val active = ArrayList<ClientBearerFlight>()
        for (entry in state.bearerEntries) if (clientPresent(entry.flight)) active.add(entry.flight!!)
        for (download in state.downloads) {
            if (!download.committing && !clientPresent(download.failure)) download.failure = Some(HttpClientClosedException())
        }
        for (source in state.eventSources) {
            if (!source.finished && !clientPresent(source.failure)) source.failure = Some(HttpClientClosedException())
        }
        (state.calls.toArray(), state.retryWaits.toArray(), active.toArray(), state.downloads.toArray(), state.eventSources.toArray(),
            state.webSockets.toArray(), state.invocations.toArray())
    }
    for (call in calls) cancelClientCall(call, HttpClientClosedException(), true)
    for (waiting in retryWaits) waiting.cancel()
    for (flight in bearers) stopClientBearerFlight(flight)
    for (download in downloads) stopClientDownload(download, HttpClientClosedException())
    for (source in eventSources) stopClientSse(source, HttpClientClosedException())
    for (session in webSockets) stopClientWebSocket(session)
    for (invocation in invocations) stopClientInvocation(invocation, HttpClientClosedException())
    wakeClient(state)
}
