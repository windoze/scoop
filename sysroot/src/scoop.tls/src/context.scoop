package scoop.tls

import scoop.crypto.PrivateKey
import scoop.crypto.native.*
import scoop.crypto.x509.*
import scoop.platform.fs.*
import scoop.tls.native.*

public class TlsClientContext private constructor(private val state: ContextState) : Closeable {
    public companion object {
        internal fun takeOwnership(handle: ULong): TlsClientContext = TlsClientContext(ContextState(handle))

        public fun fromCaFile(path: Path, options: TlsOptions = TlsOptions(), identity: TlsIdentity? = None): TlsClientContext =
            TrustStore.fromPem(path.readText()).use { store -> TlsClientContext(store, options, identity) }
    }

    public constructor(trustStore: TrustStore, options: TlsOptions = TlsOptions(), identity: TlsIdentity? = None)
        : this(storeState(trustStore, options, identity)) {}

    public constructor(trust: TlsTrustSource = TlsTrustSource.System, options: TlsOptions = TlsOptions(), identity: TlsIdentity? = None)
        : this(trustState(trust, options, identity)) {}

    internal fun newSession(peer: TlsPeerName): ULong {
        val (kind, bytes) = peerData(peer)
        return state.withHandle { handle ->
            @Unsafe { return@withHandle bytes.withDataPointer { pointer, count ->
                @Unsafe { return@withDataPointer tlsValue(sessionNew(handle, 0, kind, Some(pointer), count), "create client TLS session") }
            } }
        }
    }
    public override fun close() { state.dispose() }
}

public class TlsServerContext private constructor(private val state: ContextState) : Closeable {
    public constructor(certificates: List<Certificate>, privateKey: PrivateKey, options: TlsOptions = TlsOptions())
        : this(serverState(certificates, privateKey, options)) {}

    internal fun newSession(): ULong = state.withHandle { handle ->
        @Unsafe { return@withHandle tlsValue(sessionNew(handle, 1, 0, None, 0L), "create server TLS session") }
    }
    public override fun close() { state.dispose() }
}

private fun trustState(trust: TlsTrustSource, options: TlsOptions, identity: TlsIdentity?): ContextState {
    when (trust) {
        case Store(store) -> return storeState(store, options, identity)
        case System -> @Unsafe {
            val work = prepareSystemContext(options, identity)
            try { runSystemContext(work); return ContextState(takeSystemContextHandle(work)) }
            finally { freeSystemContext(work) }
        }
    }
}

private fun storeState(trustStore: TrustStore, options: TlsOptions, identity: TlsIdentity?): ContextState {
    @Unsafe { return ContextState(clientHandle(trustStoreHandle(trustStore), options, identity)) }
}

internal fun clientHandle(store: ULong, options: TlsOptions, identity: TlsIdentity?): ULong {
    val alpn = encodeOptions(options)
    @Unsafe {
        val handle = newContext(false, options, alpn, store)
        try {
            identity?.configure(handle)
            return handle
        } catch (error: Throwable) {
            contextFree(handle)
            throw error
        }
    }
}

private fun serverState(certificates: List<Certificate>, privateKey: PrivateKey, options: TlsOptions): ContextState {
    val alpn = encodeOptions(options)
    return TlsIdentity(certificates, privateKey).use { identity ->
        val handle = newContext(true, options, alpn, 0UL)
        try {
            identity.configure(handle)
            ContextState(handle)
        } catch (error: Throwable) {
            @Unsafe { contextFree(handle) }
            throw error
        }
    }
}

private fun newContext(server: Boolean, options: TlsOptions, alpn: Array<Byte>, store: ULong): ULong {
    @Unsafe { return alpn.withDataPointer { pointer, count ->
        @Unsafe { return@withDataPointer tlsValue(contextNew(if (server) 1 else 0, versionCode(options.minimum), versionCode(options.maximum), pointer, count, store), "create TLS context") }
    } }
}

private class ContextState(private var handle: ULong) : Disposable {
    private val held: AtomicBoolean = AtomicBoolean(false)

    private fun <T> locked(block: () -> T): T {
        while (!held.compareAndSet(false, true, MemoryOrder.Acquire, MemoryOrder.Relaxed)) { }
        try { return block() }
        finally { held.store(false, MemoryOrder.Release) }
    }

    fun <T> withHandle(block: (ULong) -> T): T = locked {
        if (handle == 0UL) throw IllegalStateException(Some("TLS context is closed"))
        block(handle)
    }

    public override fun dispose() {
        locked {
            val owned = handle
            handle = 0UL
            if (owned != 0UL) @Unsafe { contextFree(owned) }
            Unit
        }
    }
}
