package scoop.tls

import scoop.crypto.PrivateKey
import scoop.crypto.native.*
import scoop.crypto.x509.*
import scoop.tls.native.*

public class TlsIdentity private constructor(private var handle: ULong) : Closeable {
    private val held: AtomicBoolean = AtomicBoolean(false)

    public constructor(certificates: List<Certificate>, privateKey: PrivateKey)
        : this(retainIdentity(certificates, privateKey)) {}

    public companion object {
        public fun fromPem(certificates: String, privateKey: String): TlsIdentity {
            val chain = parseCertificatesPem(certificates)
            try { return PrivateKey.fromPem(privateKey).use { key -> TlsIdentity(chain, key) } }
            finally { for (certificate in chain) certificate.close() }
        }
    }

    private fun <T> locked(block: () -> T): T {
        while (!held.compareAndSet(false, true, MemoryOrder.Acquire, MemoryOrder.Relaxed)) { }
        try { return block() }
        finally { held.store(false, MemoryOrder.Release) }
    }

    public val isClosed: Boolean get() = locked { handle == 0UL }

    internal fun configure(context: ULong) {
        locked {
            if (handle == 0UL) throw IllegalStateException(Some("TLS identity is closed"))
            @Unsafe { tlsValue(contextIdentity(context, handle), "configure TLS identity") }
            Unit
        }
    }

    public override fun close() {
        locked {
            val owned = handle
            handle = 0UL
            if (owned != 0UL) @Unsafe { identityFree(owned) }
            Unit
        }
    }
}

private fun retainIdentity(certificates: List<Certificate>, privateKey: PrivateKey): ULong {
    val chain = certificates.toArray()
    if (chain.size == 0L) throw IllegalArgumentException(Some("TLS identity requires a certificate chain"))
    @Unsafe {
        val key = privateKeyHandle(privateKey)
        val handles = Array<ULong>(chain.size) { index -> @Unsafe { return@Array certificateHandle(chain[index]) } }
        return handles.withDataPointer { pointer, count ->
            @Unsafe { return@withDataPointer tlsValue(identityNew(key, pointer, count), "create TLS identity") }
        }
    }
}
