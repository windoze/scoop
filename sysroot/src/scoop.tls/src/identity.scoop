package scoop.tls

import scoop.crypto.PrivateKey
import scoop.crypto.DigestAlgorithm
import scoop.crypto.digest
import scoop.crypto.native.*
import scoop.crypto.x509.*
import scoop.tls.native.*

/**
 * A retained certificate chain and matching private key for TLS authentication. Construction
 * requires a nonempty chain with the leaf first; the supplied certificate and key wrappers retain
 * their own ownership. Close this identity after use.
 */
public class TlsIdentity private constructor(retained: RetainedTlsIdentity) : Closeable {
    private var handle: ULong = retained.handle
    private val held: AtomicBoolean = AtomicBoolean(false)
    /**
     * SHA-256 digest of the first certificate's DER encoding.
     */
    public val leafCertificateSha256: Array<Byte> = retained.leafCertificateSha256

    public constructor(certificates: List<Certificate>, privateKey: PrivateKey)
        : this(retainIdentity(certificates, privateKey)) {}

    /**
     * Factories for reading a TLS certificate chain and private key together.
     */
    public companion object {
        /**
         * Parses a PEM certificate chain and private key into one retained identity, releasing
         * temporary certificate and key wrappers even on failure.
         */
        public fun fromPem(certificates: String, privateKey: String): TlsIdentity {
            val chain = parseCertificatesPem(certificates)
            try { return PrivateKey.fromPem(privateKey).use { key -> TlsIdentity(chain, key) } }
            finally { for (certificate in chain) certificate.close() }
        }
    }

    private fun <T> locked(block: () -> T): T {
        while (!held.compareAndSet(false, true, MemoryOrder.Acquire, MemoryOrder.Relaxed)) { }
        try { return block() }
        finally { held.store(false, MemoryOrder.Release) }
    }

    /**
     * Whether this identity has released its retained native state.
     */
    public val isClosed: Boolean get() = locked { handle == 0UL }

    internal fun configure(context: ULong) {
        locked {
            if (handle == 0UL) throw IllegalStateException(Some("TLS identity is closed"))
            @Unsafe { tlsValue(contextIdentity(context, handle), "configure TLS identity") }
            Unit
        }
    }

    /**
     * Releases the retained certificate chain and key. Repeated closes are allowed.
     */
    public override fun close() {
        locked {
            val owned = handle
            handle = 0UL
            if (owned != 0UL) @Unsafe { identityFree(owned) }
            Unit
        }
    }
}

private struct RetainedTlsIdentity(val handle: ULong, val leafCertificateSha256: Array<Byte>)

private fun retainIdentity(certificates: List<Certificate>, privateKey: PrivateKey): RetainedTlsIdentity {
    val chain = certificates.toArray()
    if (chain.size == 0L) throw IllegalArgumentException(Some("TLS identity requires a certificate chain"))
    val fingerprint = digest(DigestAlgorithm.Sha256, chain[0L].toDer())
    @Unsafe {
        val key = privateKeyHandle(privateKey)
        val handles = Array<ULong>(chain.size) { index -> @Unsafe { return@Array certificateHandle(chain[index]) } }
        return handles.withDataPointer { pointer, count ->
            @Unsafe { return@withDataPointer RetainedTlsIdentity(
                tlsValue(identityNew(key, pointer, count), "create TLS identity"), fingerprint) }
        }
    }
}
