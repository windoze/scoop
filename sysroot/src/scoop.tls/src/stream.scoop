package scoop.tls

import scoop.platform.io.*
import scoop.platform.memory.*
import scoop.tls.native.TlsEngine

/**
 * A synchronous TLS byte stream that owns its transport and native TLS state. Construction
 * completes the handshake. Operations must not overlap.
 *
 * [close] releases local resources; [shutdownGracefully] exchanges TLS close notifications before
 * closing the transport. A failed I/O operation closes owned resources.
 */
public class TlsStream internal constructor(private val pump: SyncPump, private val owner: Closeable)
    : ByteSource, ByteSink, Closeable {
    /**
     * Factories that complete a TLS handshake over an existing duplex transport.
     */
    public companion object {
        // Completes the handshake; ownership transfers after session creation, before buffer allocation.
        /**
         * Creates a client session and completes its handshake, verifying the supplied peer
         * identity. Transport ownership transfers after session creation and before buffer
         * allocation; later failure closes the transport.
         */
        public fun <T> takeOwnershipAsClient(transport: T, context: TlsClientContext, peer: TlsPeerName): TlsStream
            where T : ByteSource, T : ByteSink, T : Closeable = adoptSync(TlsEngine.client(context, peer), transport)

        // Completes the handshake; ownership transfers after session creation, before buffer allocation.
        /**
         * Creates a server session and completes its handshake. Transport ownership transfers
         * after session creation and before buffer allocation; later failure closes the transport.
         */
        public fun <T> takeOwnershipAsServer(transport: T, context: TlsServerContext): TlsStream
            where T : ByteSource, T : ByteSink, T : Closeable = adoptSync(TlsEngine.server(context), transport)
    }

    private var closed: Boolean = false
    private var active: Boolean = false
    /**
     * Whether local transport, engine, and buffer cleanup has begun.
     */
    public val isClosed: Boolean get() = closed
    /**
     * The negotiated version and ALPN. Reading this property requires an open, idle stream.
     */
    public val connectionInfo: TlsConnectionInfo get() { requireIdle(); return pump.engine.connectionInfo }

    private fun requireIdle() {
        if (closed) throw IllegalStateException(Some("TLS stream is closed"))
        if (active) throw IllegalStateException(Some("TLS stream operation is active"))
    }

    internal fun handshake() {
        requireIdle()
        active = true
        try { pump.drive(0, None) }
        catch (error: Throwable) { abort(error) }
        finally { active = false }
    }

    /**
     * Reads decrypted bytes into writable buffer space and advances the buffer by the returned
     * count. A zero count request performs no transfer.
     */
    public override fun readInto(buffer: NativeByteBuffer, count: Long): Long = transfer(buffer, count, true)
    /**
     * Writes readable plaintext and advances the buffer by the accepted count. A call may accept
     * only a prefix, at most 16,384 bytes.
     */
    public override fun writeFrom(buffer: NativeByteBuffer, count: Long): Long = transfer(buffer, count, false)

    private fun transfer(buffer: NativeByteBuffer, count: Long, read: Boolean): Long {
        requireIdle()
        val available = if (read) buffer.writableBytes else buffer.readableBytes
        if (count < 0L) throw IllegalArgumentException(Some("negative TLS transfer count"))
        if (count > available) throw IndexOutOfBoundsException()
        if (count == 0L) return 0L
        val prefix = if (!read && count > 16384L) 16384L else count
        @Unsafe {
            val borrow = if (read) buffer.borrowWritable(prefix) else buffer.borrowReadable(prefix)
            active = true
            try { return pump.drive(if (read) 1 else 2, Some(borrow)) }
            catch (error: Throwable) { abort(error) }
            finally { active = false; borrow.complete(pump.progress) }
        }
    }

    /**
     * Drains pending TLS ciphertext and flushes the underlying byte sink.
     */
    public override fun flush() {
        requireIdle()
        active = true
        try { pump.drain(); pump.sink.flush() }
        catch (error: Throwable) { abort(error) }
        finally { active = false }
    }

    /**
     * Completes the TLS close handshake, then closes the owned transport and local state. Use this
     * when the peer must receive an orderly TLS shutdown.
     */
    public fun shutdownGracefully() {
        requireIdle()
        active = true
        try { pump.drive(3, None) }
        catch (error: Throwable) { abort(error) }
        finally { active = false }
        closeOwned()
    }

    private fun abort(error: Throwable): Nothing {
        active = false
        try { closeOwned() }
        catch (cleanup: Throwable) { throw ResourceUseException(error, cleanup) }
        throw error
    }

    private fun closeOwned() {
        if (closed) return
        closed = true
        val resources: Array<Closeable> = [owner, pump.engine, pump.input, pump.output]
        when (closeAll(resources)) {
            case Some(error) -> throw error
            case None -> return
        }
    }

    // Releases local resources; use shutdownGracefully for the TLS close handshake.
    /**
     * Closes the owned transport and releases local state without performing a TLS close
     * handshake. It rejects an overlapping stream operation.
     */
    public override fun close() {
        if (active) throw IllegalStateException(Some("TLS stream operation is active"))
        closeOwned()
    }
}

internal fun closeAll(resources: Array<Closeable>): Throwable? {
    var failure: Throwable? = None
    for (resource in resources) {
        try { resource.close() }
        catch (error: Throwable) {
            failure = Some(when (failure) {
                case None -> error
                case Some(primary) -> ResourceUseException(primary, error)
            })
        }
    }
    return failure
}
