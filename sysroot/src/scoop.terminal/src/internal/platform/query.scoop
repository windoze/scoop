package scoop.terminal.internal.platform

import scoop.platform.memory.NativeByteBuffer

internal fun TerminalHandle.sendQuery(command: String) {
    val bytes = command.toByteArray()
    NativeByteBuffer.allocate(bytes.size).use {
        buffer ->
        buffer.writeBytes(bytes)
        while (buffer.readableBytes > 0L)
            write(buffer, buffer.readableBytes)
    }
}

internal class QueryRawScope(private val terminal: TerminalHandle): Closeable {
    private val changed: Boolean = !terminal.isRaw
    init {
        if (changed)
            terminal.setRaw(true)
    }
    public override fun close() {
        if (changed)
            terminal.setRaw(false)
    }
}
