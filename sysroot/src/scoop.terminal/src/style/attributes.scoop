package scoop.terminal.style

import scoop.terminal.Command

/**
 * An SGR rendition attribute or its corresponding reset instruction. Terminal support varies by
 * attribute.
 */
public enum Attribute {
    /**
     * Reset all rendition attributes.
     */
    Reset,
        /**
         * Enable bold or increased intensity.
         */
        Bold,
        /**
         * Enable decreased intensity.
         */
        Dim,
        /**
         * Enable italic presentation.
         */
        Italic,
        /**
         * Enable a single underline.
         */
        Underlined,
        /**
         * Enable a double underline.
         */
        DoubleUnderlined,
        /**
         * Enable a curled underline.
         */
        Undercurled,
    /**
     * Enable a dotted underline.
     */
    Underdotted,
        /**
         * Enable a dashed underline.
         */
        Underdashed,
        /**
         * Enable slow blinking.
         */
        SlowBlink,
        /**
         * Enable rapid blinking.
         */
        RapidBlink,
        /**
         * Swap foreground and background rendition.
         */
        Reverse,
        /**
         * Conceal displayed text.
         */
        Hidden,
        /**
         * Strike through text.
         */
        CrossedOut,
    /**
     * Select Fraktur-style presentation.
     */
    Fraktur,
        /**
         * Disable bold presentation.
         */
        NoBold,
        /**
         * Restore ordinary intensity, clearing bold/dim.
         */
        NormalIntensity,
        /**
         * Disable italic presentation.
         */
        NoItalic,
        /**
         * Disable underlining.
         */
        NoUnderline,
        /**
         * Disable blinking.
         */
        NoBlink,
        /**
         * Disable reversed presentation.
         */
        NoReverse,
    /**
     * Reveal concealed text.
     */
    NoHidden,
        /**
         * Disable strike-through.
         */
        NotCrossedOut,
        /**
         * Frame the text.
         */
        Framed,
        /**
         * Encircle the text.
         */
        Encircled,
        /**
         * Enable an overline.
         */
        OverLined,
        /**
         * Disable framing and encircling.
         */
        NotFramedOrEncircled,
        /**
         * Disable overlining.
         */
        NotOverLined

    internal val index: Int get() = when (this) {
        case Reset -> 0; case Bold -> 1; case Dim -> 2; case Italic -> 3
        case Underlined -> 4; case DoubleUnderlined -> 5; case Undercurled -> 6
        case Underdotted -> 7; case Underdashed -> 8; case SlowBlink -> 9
        case RapidBlink -> 10; case Reverse -> 11; case Hidden -> 12; case CrossedOut -> 13
        case Fraktur -> 14; case NoBold -> 15; case NormalIntensity -> 16; case NoItalic -> 17
        case NoUnderline -> 18; case NoBlink -> 19; case NoReverse -> 20; case NoHidden -> 21
        case NotCrossedOut -> 22; case Framed -> 23; case Encircled -> 24; case OverLined -> 25
        case NotFramedOrEncircled -> 26; case NotOverLined -> 27
    }

    /**
     * Returns the SGR parameter text without CSI prefix or final m.
     */
    public fun sgr(): String = when (this) {
        case Reset -> "0"; case Bold -> "1"; case Dim -> "2"; case Italic -> "3"
        case Underlined -> "4"; case DoubleUnderlined -> "4:2"; case Undercurled -> "4:3"
        case Underdotted -> "4:4"; case Underdashed -> "4:5"; case SlowBlink -> "5"
        case RapidBlink -> "6"; case Reverse -> "7"; case Hidden -> "8"; case CrossedOut -> "9"
        case Fraktur -> "20"; case NoBold -> "21"; case NormalIntensity -> "22"; case NoItalic -> "23"
        case NoUnderline -> "24"; case NoBlink -> "25"; case NoReverse -> "27"; case NoHidden -> "28"
        case NotCrossedOut -> "29"; case Framed -> "51"; case Encircled -> "52"; case OverLined -> "53"
        case NotFramedOrEncircled -> "54"; case NotOverLined -> "55"
    }
}

internal val allAttributes: Array<Attribute> = [
    Attribute.Reset, Attribute.Bold, Attribute.Dim, Attribute.Italic, Attribute.Underlined,
    Attribute.DoubleUnderlined, Attribute.Undercurled, Attribute.Underdotted, Attribute.Underdashed,
    Attribute.SlowBlink, Attribute.RapidBlink, Attribute.Reverse, Attribute.Hidden, Attribute.CrossedOut,
    Attribute.Fraktur, Attribute.NoBold, Attribute.NormalIntensity, Attribute.NoItalic, Attribute.NoUnderline,
    Attribute.NoBlink, Attribute.NoReverse, Attribute.NoHidden, Attribute.NotCrossedOut, Attribute.Framed,
    Attribute.Encircled, Attribute.OverLined, Attribute.NotFramedOrEncircled, Attribute.NotOverLined
]

/**
 * An immutable set of SGR attributes.
 */
public struct Attributes(val bits: UInt = 0u) {
    /**
     * Whether no bits are set.
     */
    public val isEmpty: Boolean get() = bits == 0u
    /**
     * Tests whether the selected flag is present.
     */
    public fun has(attribute: Attribute): Boolean = (bits and (1u shl attribute.index.toLong())) != 0u
    /**
     * Returns a copy with the selected flag included.
     */
    public fun with(attribute: Attribute): Attributes = Attributes(bits or (1u shl attribute.index.toLong()))
    /**
     * Returns a copy with the selected flag removed.
     */
    public fun without(attribute: Attribute): Attributes = Attributes(bits and (1u shl attribute.index.toLong()).inv())
    /**
     * Returns a copy with the selected attribute's bit toggled.
     */
    public fun toggled(attribute: Attribute): Attributes = Attributes(bits xor (1u shl attribute.index.toLong()))
}

/**
 * Emits one SGR attribute command.
 */
public struct SetAttribute(val attribute: Attribute) : Command {
    /**
     * Writes this command's ANSI representation to the supplied writer without flushing it.
     * Parameter validation happens before or during serialization.
     */
    public override fun writeAnsi(writer: TextWriter) { writer.write("\u001b[" + attribute.sgr() + "m") }
}

/**
 * Emits the selected SGR attributes in the library's fixed order.
 */
public struct SetAttributes(val attributes: Attributes) : Command {
    /**
     * Writes this command's ANSI representation to the supplied writer without flushing it.
     * Parameter validation happens before or during serialization.
     */
    public override fun writeAnsi(writer: TextWriter) {
        if ((attributes.bits and 0xf0000000u) != 0u) {
            throw IllegalArgumentException(Some("unknown terminal attribute bits"))
        }
        for (attribute in allAttributes) {
            if (attributes.has(attribute)) SetAttribute(attribute).writeAnsi(writer)
        }
    }
}
