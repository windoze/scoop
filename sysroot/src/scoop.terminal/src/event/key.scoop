package scoop.terminal.event

public enum KeyCode {
    Backspace, Enter, Left, Right, Up, Down, Home, End, PageUp, PageDown,
    Tab, BackTab, Delete, Insert, F(val number: Int), Char(val character: Char),
    Null, Esc, CapsLock, ScrollLock, NumLock, PrintScreen, Pause, Menu, KeypadBegin,
    Media(val code: MediaKeyCode), Modifier(val code: ModifierKeyCode)
}

public enum KeyEventKind { Press, Repeat, Release }

public struct KeyEvent(
    val code: KeyCode,
    val modifiers: KeyModifiers = KeyModifiers(),
    val kind: KeyEventKind = KeyEventKind.Press,
    val state: KeyEventState = KeyEventState()
)

public enum MediaKeyCode {
    Play, Pause, PlayPause, Reverse, Stop, FastForward, Rewind,
    TrackNext, TrackPrevious, Record, LowerVolume, RaiseVolume, MuteVolume
}

public enum ModifierKeyCode {
    LeftShift, LeftControl, LeftAlt, LeftSuper, LeftHyper, LeftMeta,
    RightShift, RightControl, RightAlt, RightSuper, RightHyper, RightMeta,
    IsoLevel3Shift, IsoLevel5Shift
}
