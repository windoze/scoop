package scoop.terminal

import scoop.terminal.event.KeyboardEnhancementFlags
import scoop.terminal.internal.input.*
import scoop.time.Duration

public struct CursorPosition(val column: Long, val row: Long)
public enum DeviceAttributeKind { Primary, Secondary }
public class TerminalQueryTimeoutException : Exception(Some("terminal query timed out"))

public fun TerminalSession.cursorPosition(timeout: Duration = Duration.seconds(1L)): CursorPosition =
    when (query(QueryKind.Cursor, timeout)) {
        case InputItem.CursorPosition(column, row) -> CursorPosition(column, row)
        case _ -> throw IllegalStateException(Some("unexpected cursor query result"))
    }

public fun TerminalSession.deviceAttributes(kind: DeviceAttributeKind = DeviceAttributeKind.Primary,
    timeout: Duration = Duration.seconds(1L)): Array<Long> {
    val request = if (kind == DeviceAttributeKind.Primary) QueryKind.Primary else QueryKind.Secondary
    return when (query(request, timeout)) {
        case InputItem.DeviceAttributes(_, parameters) -> parameters
        case _ -> throw IllegalStateException(Some("unexpected device attributes result"))
    }
}

public fun TerminalSession.keyboardEnhancementFlags(
    timeout: Duration = Duration.seconds(1L)): KeyboardEnhancementFlags? = when (query(QueryKind.Keyboard, timeout)) {
    case InputItem.KeyboardFlags(flags) -> Some(flags)
    case InputItem.DeviceAttributes(false, _) -> None
    case _ -> throw IllegalStateException(Some("unexpected keyboard query result"))
}

public fun TerminalSession.supportsKeyboardEnhancement(timeout: Duration = Duration.seconds(1L)): Boolean =
    keyboardEnhancementFlags(timeout) != None
