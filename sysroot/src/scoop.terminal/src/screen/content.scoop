package scoop.terminal.screen

import scoop.terminal.Command
import scoop.terminal.requireTerminalParameter
import scoop.terminal.writeCsiParameter

/**
 * The screen or line region selected for an ANSI erase command.
 */
public enum ClearType {
    /**
     * Erase the visible screen.
     */
    All,
    /**
     * Erase the terminal scrollback buffer.
     */
    Purge,
    /**
     * Erase from the cursor to the end of the screen.
     */
    FromCursorDown,
    /**
     * Erase from the beginning of the screen through the cursor.
     */
    FromCursorUp,
    /**
     * Erase the complete current line.
     */
    CurrentLine,
    /**
     * Erase from the cursor to the end of its line.
     */
    UntilNewLine }

/**
 * Erases the selected region without moving the cursor.
 */
public struct Clear(val type: ClearType) : Command {
    /**
     * Writes this command's ANSI representation to the supplied writer without flushing it.
     * Parameter validation happens before or during serialization.
     */
    public override fun writeAnsi(writer: TextWriter) {
        val suffix = when (type) {
            case ClearType.All -> "2J"
            case ClearType.Purge -> "3J"
            case ClearType.FromCursorDown -> "J"
            case ClearType.FromCursorUp -> "1J"
            case ClearType.CurrentLine -> "2K"
            case ClearType.UntilNewLine -> "K"
        }
        writer.write("\u001b[" + suffix)
    }
}

/**
 * Scrolls the screen upward by the requested line count; zero emits no command.
 */
public struct ScrollUp(val count: Long) : Command {
    /**
     * Writes this command's ANSI representation to the supplied writer without flushing it.
     * Parameter validation happens before or during serialization.
     */
    public override fun writeAnsi(writer: TextWriter) {
        if (count != 0L) writeCsiParameter(writer, count, "S")
    }
}

/**
 * Scrolls the screen downward by the requested line count; zero emits no command.
 */
public struct ScrollDown(val count: Long) : Command {
    /**
     * Writes this command's ANSI representation to the supplied writer without flushing it.
     * Parameter validation happens before or during serialization.
     */
    public override fun writeAnsi(writer: TextWriter) {
        if (count != 0L) writeCsiParameter(writer, count, "T")
    }
}

/**
 * Requests terminal dimensions in character cells. Both dimensions must be in 1..65535.
 */
public struct SetSize(val columns: Long, val rows: Long) : Command {
    /**
     * Writes this command's ANSI representation to the supplied writer without flushing it.
     * Parameter validation happens before or during serialization.
     */
    public override fun writeAnsi(writer: TextWriter) {
        requireTerminalParameter(columns, 1L)
        requireTerminalParameter(rows, 1L)
        writer.write("\u001b[8;" + rows.toString() + ";" + columns.toString() + "t")
    }
}

/**
 * Sets the terminal title. Control characters are rejected before serialization.
 */
public struct SetTitle(val title: String) : Command {
    /**
     * Writes this command's ANSI representation to the supplied writer without flushing it.
     * Parameter validation happens before or during serialization.
     */
    public override fun writeAnsi(writer: TextWriter) {
        for (character in title) {
            if (character.code < 32 || (character.code >= 127 && character.code <= 159)) {
                throw IllegalArgumentException(Some("terminal title contains a control character"))
            }
        }
        writer.write("\u001b]0;" + title + "\u0007")
    }
}
