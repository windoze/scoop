package scoop.terminal.tests.consumer.terminal_key_switch

import scoop.test.*
enum Code {
    Backspace, Enter, Left, Right, Up, Down, Home, End, PageUp, PageDown,
    Tab, BackTab, Delete, Insert, F(val number: Int), Char(val character: Char),
    Null, Esc, CapsLock, ScrollLock, NumLock, PrintScreen, Pause, Menu, KeypadBegin
}

fun letterKey(letter: Char): Code = when (letter) {
    case 'A' -> Code.Up; case 'B' -> Code.Down
    case 'C' -> Code.Right; case 'D' -> Code.Left
    case 'E' -> Code.KeypadBegin; case 'F' -> Code.End; case 'H' -> Code.Home
    case 'P' -> Code.F(1); case 'Q' -> Code.F(2); case 'R' -> Code.F(3); case 'S' -> Code.F(4)
    case _ -> throw IllegalArgumentException(Some("unknown letter"))
}

private fun exerciseConsumer() {
    val input = "ABCDEFHPQRS"
    val expected = [Code.Up, Code.Down, Code.Right, Code.Left, Code.KeypadBegin, Code.End,
        Code.Home, Code.F(1), Code.F(2), Code.F(3), Code.F(4)]
    var index = 0L
    for (letter in input) {
        val code = letterKey(letter)
        gcCollect()
        if (code != expected[index]) throw IllegalStateException()
        index += 1L
    }
    try { letterKey('x'); throw IllegalStateException() }
    catch (_: IllegalArgumentException) { println("key switch ok") }
}

@Test
private class ConsumerTests {
    @Test
    fun behavior() { exerciseConsumer() }
}
