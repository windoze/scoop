package scoop.http.asyncio

import scoop.asyncio.*
import scoop.http.*
import scoop.platform.memory.NativeByteBuffer

internal class SseReader(source: AsyncByteSource, owner: AsyncCloseable?, loop: EventLoop, val decoder: SseDecoder, val input: NativeByteBuffer) {
    val io: MessageIo<AsyncByteSource> = MessageIo<AsyncByteSource>(source, owner, loop) {
        var failure = messageCleanup(None) { input.close() }
        failure = messageCleanup(failure) { decoder.close() }
        when (failure) { case Some(error) -> throw error; case None -> {} }
    }

    suspend fun next(): SseEvent? = io.run({}) suspend { source -> readNext(source) }

    private suspend fun readNext(source: AsyncByteSource): SseEvent? {
        while (true) {
            ensureActive()
            when (decoder.nextEvent()) { case Some(event) -> return Some(event); case None -> {} }
            if (decoder.isFinished) return None
            if (input.readableBytes > 0L) decoder.receive(input)
            else {
                input.clear()
                val requested = input.writableBytes
                val count = source.readInto(input, requested)
                httpProgress(count, requested)
                if (input.writePosition != count || input.readPosition != 0L)
                    throw IllegalStateException(Some("inconsistent SSE source progress"))
                if (count == 0L) decoder.endInput()
            }
        }
    }
}
