package scoop.http.asyncio

import scoop.http.HttpProtocol
import scoop.time.Duration
import scoop.time.TimeMark

/**
 * Optional read-idle and write-idle deadlines for protocol I/O progress.
 */
public struct HttpIoTimeoutOptions(val readIdle: Duration? = None, val writeIdle: Duration? = None)

/**
 * The I/O direction whose idle deadline expired.
 */
public enum HttpIoDirection {
    /**
     * Waiting for input progress.
     */
    Read,
    /**
     * Waiting for output progress.
     */
    Write }

/**
 * Reports an idle timeout with protocol, stream, direction, configured limit, and measured elapsed
 * time.
 */
public class HttpIoTimeoutException public constructor(
    /**
     * The I/O direction that made insufficient progress.
     */
    public val direction: HttpIoDirection,
        /**
         * The affected HTTP protocol.
         */
        public val protocol: HttpProtocol,
        /**
         * The affected protocol stream identifier.
         */
        public val streamId: Int,
    /**
     * The configured idle timeout.
     */
    public val limit: Duration,
        /**
         * The measured idle duration at failure.
         */
        public val elapsed: Duration
) : Exception(Some("HTTP I/O idle timeout"))

internal fun httpIdleLimit(limit: Duration?) {
    if (limit != None && limit!! < Duration.ZERO) throw IllegalArgumentException(Some("negative HTTP idle timeout"))
}

internal fun requireHttpIoTimeouts(options: HttpIoTimeoutOptions) {
    httpIdleLimit(options.readIdle); httpIdleLimit(options.writeIdle)
}

internal class HttpIoClock(val direction: HttpIoDirection, val protocol: HttpProtocol, val streamId: Int,
    val limit: Duration, var progress: TimeMark) {
    fun remaining(now: TimeMark): Duration = limit - (now - progress)
    fun expired(now: TimeMark): HttpIoTimeoutException? {
        val elapsed = now - progress
        return if (elapsed >= limit) Some(HttpIoTimeoutException(direction, protocol, streamId, limit, elapsed)) else None
    }
}
