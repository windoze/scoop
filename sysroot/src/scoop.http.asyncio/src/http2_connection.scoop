package scoop.http.asyncio

import scoop.asyncio.*
import scoop.http.*

/**
 * A received request head paired with its independently controlled HTTP/2 stream.
 */
public class Http2IncomingRequest internal constructor(
    /**
     * The received protocol head, preserving the original ordered fields.
     */
    public val head: HttpRequestHead,
    /**
     * The stream used to read the request body and send its response.
     */
    public val stream: AsyncHttp2Stream)

/**
 * No new stream was submitted because the HTTP/2 connection is draining.
 */
public class Http2ConnectionDrainingException public constructor() :
    Exception(Some("HTTP/2 connection is draining; no new request was submitted"))

/**
 * An owned multiplexed HTTP/2 connection driven by structured tasks in the supplied scope.
 * Per-stream cancellation resets only that stream; connection or scope closure ends shared
 * transport I/O.
 */
public class AsyncHttp2Connection internal constructor(internal val state: H2State) : AsyncCloseable {
    /**
     * Factories that transfer an established transport to structured protocol tasks.
     */
    public companion object {
        /**
         * Takes an already-established transport as an HTTP client. The supplied scope owns
         * connection tasks; TCP connection and TLS handshake must already be complete.
         */
        public suspend fun <T> takeOwnershipAsClient(transport: T, scope: CoroutineScope,
            options: Http2ReceiveOptions = Http2ReceiveOptions(), limits: Http2Limits = Http2Limits(),
            settings: Http2Settings = Http2Settings(), ioTimeouts: HttpIoTimeoutOptions = HttpIoTimeoutOptions(),
            onEvent: (Http2Notice) -> Unit = { _ -> }, captureTimings: Boolean = false): AsyncHttp2Connection
            where T : AsyncByteStream, T : AsyncCloseable =
            adoptH2(transport, transport, scope, { Http2Session.client(options, limits, settings) }, settings, ioTimeouts, onEvent, false, captureTimings)

        /**
         * Takes an already-established transport as an HTTP server. The supplied scope owns
         * connection tasks; TCP connection and TLS handshake must already be complete.
         */
        public suspend fun <T> takeOwnershipAsServer(transport: T, scope: CoroutineScope,
            options: Http2ReceiveOptions = Http2ReceiveOptions(), limits: Http2Limits = Http2Limits(),
            settings: Http2Settings = Http2Settings(), ioTimeouts: HttpIoTimeoutOptions = HttpIoTimeoutOptions(),
            onEvent: (Http2Notice) -> Unit = { _ -> }): AsyncHttp2Connection
            where T : AsyncByteStream, T : AsyncCloseable =
            adoptH2(transport, transport, scope, { Http2Session.server(options, limits, settings) }, settings, ioTimeouts, onEvent, false)

        /**
         * Takes transport ownership after a completed HTTP/1 h2c switch, preserving stream 1 and
         * using the actual upgrade SETTINGS. New client streams begin at 3.
         */
        public suspend fun <T> takeOwnershipAsUpgradedClient(transport: T, scope: CoroutineScope, requestMethod: List<Byte>,
            settings: Http2Settings = Http2Settings(), options: Http2ReceiveOptions = Http2ReceiveOptions(),
            limits: Http2Limits = Http2Limits(), ioTimeouts: HttpIoTimeoutOptions = HttpIoTimeoutOptions(),
            onEvent: (Http2Notice) -> Unit = { _ -> }, captureTimings: Boolean = false): AsyncHttp2Connection
            where T : AsyncByteStream, T : AsyncCloseable =
            adoptH2(transport, transport, scope, { Http2Session.upgradedClient(requestMethod, settings, options, limits) },
                settings, ioTimeouts, onEvent, true, captureTimings)

        /**
         * Takes transport ownership after a completed HTTP/1 h2c switch, preserving stream 1 and
         * using the actual upgrade SETTINGS. New client streams begin at 3.
         */
        public suspend fun <T> takeOwnershipAsUpgradedServer(transport: T, scope: CoroutineScope, requestMethod: List<Byte>,
            settingsPayload: List<Byte>, options: Http2ReceiveOptions = Http2ReceiveOptions(), limits: Http2Limits = Http2Limits(),
            settings: Http2Settings = Http2Settings(), ioTimeouts: HttpIoTimeoutOptions = HttpIoTimeoutOptions(),
            onEvent: (Http2Notice) -> Unit = { _ -> }): AsyncHttp2Connection
            where T : AsyncByteStream, T : AsyncCloseable =
            adoptH2(transport, transport, scope,
                { Http2Session.upgradedServer(requestMethod, settingsPayload, options, limits, settings) },
                settings, ioTimeouts, onEvent, true)
    }

    /**
     * The local HTTP client or server role.
     */
    public val role: HttpRole get() = state.session.role
    /**
     * The default I/O idle deadlines used by this connection.
     */
    public val ioTimeouts: HttpIoTimeoutOptions get() = state.ioTimeouts
    /**
     * Whether connection shutdown has begun, before cleanup completes.
     */
    public val isClosing: Boolean get() = state.lock.withLock { state.closing }
    /**
     * Whether connection cleanup has completed.
     */
    public val isClosed: Boolean get() = state.lock.withLock { state.closed }
    /**
     * Whether new requests are disallowed while existing streams drain.
     */
    public val isDraining: Boolean get() = state.lock.withLock { state.acceptingEnded }
    /**
     * Stream 1 associated with a successful h2c upgrade, or None for a connection established
     * directly as HTTP/2.
     */
    public val upgradedStream: AsyncHttp2Stream? get() = state.lock.withLock {
        when (state.upgrade) { case Some(stream) -> Some(AsyncHttp2Stream(state, stream)); case None -> None }
    }

    /**
     * Submits a request and returns its stream. Set endStream false when an upload body or
     * trailers will follow; draining connections reject before submission.
     */
    public suspend fun openRequest(head: HttpRequestHead, endStream: Boolean = true,
        ioTimeouts: HttpIoTimeoutOptions = this.ioTimeouts): AsyncHttp2Stream {
        val job = httpJob(state.loop, true)
        requireHttpIoTimeouts(ioTimeouts)
        val stream = state.lock.withLock {
            h2Open(state)
            if (state.acceptingEnded) throw Http2ConnectionDrainingException()
            val value = H2Stream(state.session.submitRequest(head, endStream), ioTimeouts)
            value.sendStarted = true
            value.sendEnded = endStream
            state.streams[value.id] = value
            value
        }
        listenH2Stream(state, stream, job)
        val result = AsyncHttp2Stream(state, stream)
        try { result.flush(); return result }
        catch (error: Throwable) { result.close(); throw error }
    }

    /**
     * Waits for a server-side incoming request, or None after the connection stops accepting
     * requests.
     */
    public suspend fun acceptRequest(): Http2IncomingRequest? = acceptH2(state)

    /**
     * Sends an explicit GOAWAY notification with selected code, debug data, and optional
     * last-stream boundary.
     */
    public suspend fun goAway(code: UInt = 0U, debugData: List<Byte> = ArrayList<Byte>(), lastStreamId: Int? = None) {
        flushH2Connection(state) {
            if (state.goAwayPending) throw IllegalStateException(Some("HTTP/2 GOAWAY send is busy"))
            state.session.goAway(code, debugData, lastStreamId)
            state.goAwayPending = true
            state.goAwaySerialized = false
            state.acceptingEnded = true
        }
    }

    /**
     * Cancels and joins shared connection I/O and closes the owned transport. This is local
     * cleanup, distinct from explicitly sending GOAWAY.
     */
    public override suspend fun close() { closeH2(state) }
}
