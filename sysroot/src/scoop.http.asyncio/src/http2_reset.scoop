package scoop.http.asyncio

import scoop.asyncio.IoClosedException

internal fun resetH2Stream(state: H2State, stream: H2Stream, error: Throwable, code: UInt, actions: ArrayList<() -> Unit>) {
    if (stream.disposed) return
    stream.failure = Some(error)
    if (state.closing) return
    try { state.session.reset(stream.id, code) }
    catch (failure: Throwable) { terminateH2(state, failure); return }
    releaseH2Stream(state, stream, error, actions)
}

internal fun releaseH2Stream(state: H2State, stream: H2Stream, error: Throwable, actions: ArrayList<() -> Unit>) {
    stopH2Idle(stream, actions)
    stream.disposed = true
    stream.failure = Some(error)
    stream.data.clear(); stream.offset = 0L
    stream.responses.clear()
    if (present(stream.reader)) finishH2Body(state, stream, stream.reader!!, 0L, Some(error), actions)
    if (present(stream.writer)) finishH2Body(state, stream, stream.writer!!, 0L, Some(error), actions)
    if (present(stream.responseWaiter)) {
        failH2Wait(stream.responseWaiter!!, error, actions)
        stream.responseWaiter = None
    }
    var index = state.requests.size
    while (index > 0L) {
        index -= 1L
        if (state.requests[index].stream.id == stream.id) state.requests.removeAt(index)
    }
    state.streams.remove(stream.id)
    detachH2Stream(stream, actions)
}

internal fun retireH2Stream(state: H2State, stream: H2Stream, actions: ArrayList<() -> Unit>) {
    if (!stream.closed || stream.data.size != 0L || stream.responses.size != 0L ||
        present(stream.reader) || present(stream.writer) || present(stream.responseWaiter)) return
    if (!state.closed && h2PendingOutput(state, stream)) return
    stopH2Idle(stream, actions)
    state.streams.remove(stream.id)
    detachH2Stream(stream, actions)
}

internal suspend fun closeH2Stream(state: H2State, stream: H2Stream) {
    if (state.lock.withLock { stream.disposed && stream.idleTimers == 0L }) return
    httpJob(state.loop, false)
    suspendCoroutine<Unit> { continuation ->
        val actions = ArrayList<() -> Unit>()
        val done = state.lock.withLock {
            if (!stream.disposed) {
                if (state.closed) releaseH2Stream(state, stream, IoClosedException(), actions)
                else resetH2Stream(state, stream, IoClosedException(), 8U, actions)
            }
            if (stream.idleTimers == 0L) true else { stream.idleCloseWaiters.add(continuation); false }
        }
        for (action in actions) action()
        driveH2(state)
        if (done) continuation.resume(Unit)
    }
}
