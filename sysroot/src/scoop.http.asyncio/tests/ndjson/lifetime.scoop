package scoop.http.asyncio

import scoop.asyncio.*
import scoop.test.*

@Test
private class NdjsonLifetimeTests {
    @Test
    fun `NDJSON construction wrong loop and precancellation leave the input usable`() {
        val loop: EventLoop = LibuvEventLoop()
        val other: EventLoop = LibuvEventLoop()
        loop.run suspend { scope ->
            val input = MessageTestSource("a\n".toByteArray())
            assertFailsWith<IllegalArgumentException> { NdjsonSource.takeOwnership(input, maxRecordBytes = -1L) }
            assertFailsWith<IllegalArgumentException> { NdjsonSource.takeOwnership(input, bufferSize = 0L) }
            val source = NdjsonSource(input)
            val cancelled = scope.launch suspend {
                currentJobOrNone()!!.cancel()
                expectMessageFailure<CancellationException> suspend { NdjsonSource.takeOwnership(input) }
                expectMessageFailure<CancellationException> suspend { source.next() }
            }
            cancelled.join()
            expectMessageFailure<IllegalStateException> suspend { context(other) { source.next() } }
            assertEquals(0, input.reads)
            assertEquals(0, input.closes)
            assertFalse(present(source.failure))
            assertEquals(Some("a"), source.next())
            source.close(); input.close()
        }
    }

    @Test
    fun `NDJSON concurrent readers fail locally and owning close waits for the actual native borrow`() {
        val loop: EventLoop = LibuvEventLoop()
        loop.run suspend { scope ->
            val pending = PendingMessageSource()
            val source = NdjsonSource.takeOwnership(pending, bufferSize = 4L)
            val reader = scope.launch suspend {
                expectMessageFailure<CancellationException> suspend { source.next() }
                ensureActive()
            }
            try {
                assertTrue(pending.running)
                expectMessageFailure<IllegalStateException> suspend { source.next() }
                assertFalse(present(source.failure))
                val first = scope.launch suspend { source.close() }
                val second = scope.launch suspend { source.close() }
                assertTrue(pending.job!!.isCancelled)
                assertFalse(reader.isCompleted || first.isCompleted || second.isCompleted)
                assertEquals(0, pending.closes)
                assertFailsWith<IllegalStateException> { pending.buffer!!.clear() }
                pending.complete()
                reader.join(); first.join(); second.join()
                assertFalse(reader.isCancelled)
                assertTrue(pending.buffer!!.isClosed && source.isClosed)
                assertEquals(1, pending.closes)
            } finally {
                if (pending.running) pending.complete()
                source.close()
            }
        }
    }

    @Test
    fun `NDJSON inconsistent source progress fails before record decoding`() {
        val loop: EventLoop = LibuvEventLoop()
        loop.run suspend { _ ->
            for (mode in [1, 2, 3, 4]) {
                val input = MessageTestSource([])
                input.badProgress = mode
                val source = NdjsonSource.takeOwnership(input)
                expectMessageFailure<IllegalStateException> suspend { source.next() }
                assertTrue(source.failure!! is IllegalStateException)
                source.close()
                assertEquals(1, input.closes)
            }
        }
    }
}
