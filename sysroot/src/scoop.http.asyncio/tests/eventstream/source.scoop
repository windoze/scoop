package scoop.http.asyncio

import scoop.asyncio.*
import scoop.bytes.ByteArrayBuilder
import scoop.http.*
import scoop.test.*

@Test
private class AwsEventStreamSourceTests {
    @Test
    fun `AWS EventStream source drives short reads preserves typed messages and reaches clean EOF without closing a borrowed input`() {
        val loop: EventLoop = PlatformEventLoop()
        loop.run suspend {
            _ ->
            val bytes =
                ByteArrayBuilder().append(asyncAwsMessage).append(asyncAwsEmpty).toByteArray()
            val input = MessageTestSource(bytes, 3L)
            val source = AwsEventStreamSource(input, bufferSize = 5L)
            assertEquals(0, input.reads)
            source.useAsync suspend {
                stream ->
                val first = stream.next()!!
                assertEquals(10L, first.headers.size)
                assertEquals("{'foo':'bar'}", String.fromUtf8(first.payload))
                when (first.header("int64")!!) {
                    case Int64(value) -> assertEquals(42424242L, value);
                    else -> fail()
                }
                assertTrue(input.position < bytes.size)
                gcCollect()
                assertEquals(0L, stream.next()!!.payload.size)
                assertFalse(present(stream.next()))
                assertTrue(stream.isFinished)
                val reads = input.reads
                assertFalse(present(stream.next()))
                assertEquals(reads, input.reads)
            }
            assertTrue(source.isClosed)
            assertEquals(0, input.closes)
            input.close()
        }
    }

    @Test
    fun `AWS EventStream owning source bounds prefetch and early close never drains the remaining messages`() {
        val loop: EventLoop = PlatformEventLoop()
        loop.run suspend {
            _ ->
            val bytes =
                ByteArrayBuilder().append(asyncAwsEmpty).append(asyncAwsMessage).toByteArray()
            val input = MessageTestSource(bytes, 1000L)
            val source = AwsEventStreamSource.takeOwnership(input, bufferSize = 17L)
            assertEquals(0L, source.next()!!.payload.size)
            assertEquals(17L, input.position)
            val reads = input.reads
            source.close();
            source.close()
            assertEquals(reads, input.reads)
            assertEquals(1, input.closes)
            assertTrue(source.isClosed)
            assertFalse(source.isFinished)
            expectMessageFailure<IoClosedException> suspend { source.next() }
        }
    }

    @Test
    fun `AWS EventStream source retains truncation and IO failures and combines owned cleanup errors`() {
        val loop: EventLoop = PlatformEventLoop()
        loop.run suspend {
            _ ->
            val short = MessageTestSource(Array<Byte>(12L) { index -> asyncAwsEmpty[index] })
            val source = AwsEventStreamSource.takeOwnership(short)
            val truncated = expectMessageFailure<AwsEventStreamException> suspend { source.next() }
            assertEquals(AwsEventStreamErrorKind.UnexpectedEof, truncated.kind)
            assertTrue(source.failure!! === truncated)
            expectMessageFailure<IllegalStateException> suspend { source.next() }
            source.close()
            assertEquals(1, short.closes)
            val broken = MessageTestSource([])
            broken.failRead = true;
            broken.failClose = true
            val failed = AwsEventStreamSource.takeOwnership(broken)
            val error =
                expectMessageFailure<ResourceUseException> suspend {
                    failed.useAsync suspend { stream -> stream.next() }
                }
            assertTrue(error.primaryFailure is TransportFailure)
            assertTrue(error.cleanupFailure is CleanupFailure)
            assertTrue(failed.failure!! is TransportFailure)
            assertTrue(failed.isClosed)
            assertEquals(1, broken.closes)
        }
    }
}
