package scoop.http.asyncio

import scoop.asyncio.*
import scoop.http.*
import scoop.platform.memory.NativeByteBuffer
import scoop.test.*

@Test private class MultipartSinkValidationTests {
    @Test fun `parameter and encoding state failures preserve input and allow correction`() {
        val loop: EventLoop = LibuvEventLoop()
        loop.run suspend { _ ->
            val output = MessageTestSink(3L)
            MultipartSink.takeOwnership(output, MultipartBoundary("b"), 3L).useAsync suspend { sink ->
                val part = sink.beginPart(MultipartPartHead(bodyLength = Some(2L)))
                val before = output.bytes.size
                expectMessageFailure<IllegalStateException> suspend { sink.beginPart(MultipartPartHead()) }
                expectMessageFailure<IllegalStateException> suspend { sink.finish() }
                expectMessageFailure<IllegalStateException> suspend { part.finish() }
                NativeByteBuffer.allocate(3L).use suspend { buffer ->
                    buffer.writeBytes("abc".toByteArray())
                    expectMessageFailure<IllegalArgumentException> suspend { part.writeFrom(buffer, -1L) }
                    expectMessageFailure<IndexOutOfBoundsException> suspend { part.writeFrom(buffer, 4L) }
                    expectMessageFailure<IllegalArgumentException> suspend { part.writeFrom(buffer, 3L) }
                    assertEquals(0L, buffer.readPosition)
                    assertEquals(before, output.bytes.size)
                    assertFalse(present(sink.failure))
                    assertEquals(2L, part.writeFrom(buffer, 2L))
                    part.finish()
                    expectMessageFailure<IllegalStateException> suspend { part.finish() }
                    expectMessageFailure<IllegalStateException> suspend { part.writeFrom(buffer, 0L) }
                    part.close()
                    expectMessageFailure<IoClosedException> suspend { part.flush() }
                }
                sink.finish()
                val finished = output.bytes.size
                expectMessageFailure<IllegalStateException> suspend { sink.finish() }
                expectMessageFailure<IllegalStateException> suspend { sink.beginPart(MultipartPartHead()) }
                assertEquals(finished, output.bytes.size)
                assertFalse(present(sink.failure))
            }
        }
    }

    @Test fun `construction pre-cancellation and wrong loop do not transfer or damage endpoints`() {
        val loop: EventLoop = LibuvEventLoop()
        val other: EventLoop = LibuvEventLoop()
        loop.run suspend { scope ->
            val output = MessageTestSink(3L)
            val boundary = MultipartBoundary("b")
            assertFailsWith<IllegalArgumentException> { MultipartSink.takeOwnership(output, boundary, 0L) }
            val sink = MultipartSink(output, boundary)
            val cancelled = scope.launch suspend {
                currentJobOrNone()!!.cancel()
                expectMessageFailure<CancellationException> suspend { MultipartSink.takeOwnership(output, boundary) }
                expectMessageFailure<CancellationException> suspend { sink.beginPart(MultipartPartHead()) }
            }
            cancelled.join()
            expectMessageFailure<IllegalStateException> suspend { context(other) { sink.flush() } }
            assertEquals(0, output.writes); assertEquals(0, output.closes)
            assertFalse(present(sink.failure))
            sink.finish(); sink.close(); output.close()
        }
    }
}
