package scoop.http.asyncio.tests.consumer.websocket_handshake

import scoop.test.*
import scoop.http.*
import scoop.io.encoding.Base64
import scoop.platform.fs.*
import scoop.platform.memory.NativeByteBuffer
import scoop.text.*

fun runOracle(path: Path) {
    for (line in path.readText().split('\n')) {
        if (line.charLength == 0L) continue
        val fields = line.split('|')
        try {
            val handshake = WebSocketHandshake.parse(decodeRequest(Base64.Default.decode(fields[0L])))
            val negotiated = handshake.accept(decodeResponse(Base64.Default.decode(fields[1L])))
            val raw: WebSocketDeflate? = when (negotiated.deflate) { case Some(value) -> Some(value.response); case None -> None }
            val result = StringBuilder().append("OK|").append(negotiated.protocol ?: "-")
            when (negotiated.deflate) {
                case Some(value) -> {
                    result.append("|").append(if (value.serverNoContextTakeover) "1" else "0")
                        .append("|").append(if (value.clientNoContextTakeover) "1" else "0")
                        .append("|").append(value.serverWindowBits.toString()).append("|").append(value.clientWindowBits.toString())
                }
                case None -> result.append("|-|-|-|-")
            }
            result.append("|").append(Base64.Default.encode(encodeResponse(handshake.response(negotiated.protocol, raw))))
            println(result.toString())
        } catch (_: WebSocketHandshakeException) { println("ERR") }
        catch (_: HttpFieldParseException) { println("ERR") }
    }
}

fun decodeRequest(bytes: Array<Byte>): HttpRequestHead = Http1Decoder.server().use { decoder ->
    NativeByteBuffer.allocate(bytes.size).use { buffer ->
        buffer.writeBytes(bytes)
        while (buffer.readableBytes > 0L) {
            check(decoder.receive(buffer) > 0L)
            while (true) {
                when (decoder.nextEvent()) {
                    case Some(Http1Event.Request(head)) -> return@use head
                    case Some(_) -> {}
                    case None -> break
                }
            }
        }
        throw IllegalStateException(Some("missing request head"))
    }
}

private fun decodeResponse(bytes: Array<Byte>): HttpResponseHead = Http1Decoder.client().use { decoder ->
    decoder.expectResponse("GET".toByteArray())
    NativeByteBuffer.allocate(bytes.size).use { buffer ->
        buffer.writeBytes(bytes)
        while (buffer.readableBytes > 0L) {
            check(decoder.receive(buffer) > 0L)
            while (true) {
                when (decoder.nextEvent()) {
                    case Some(Http1Event.Response(head)) -> return@use head
                    case Some(_) -> {}
                    case None -> break
                }
            }
        }
        throw IllegalStateException(Some("missing response head"))
    }
}

fun encodeResponse(response: HttpResponseHead): Array<Byte> = Http1Encoder(HttpRole.Server).use { encoder ->
    val bytes = encoder.beginResponse(response, "GET".toByteArray())
    check(encoder.finish().size == 0L)
    bytes
}
