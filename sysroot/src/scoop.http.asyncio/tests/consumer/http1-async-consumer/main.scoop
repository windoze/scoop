package scoop.http.asyncio.tests.consumer.http1_async_consumer

import scoop.test.*
import scoop.asyncio.*
import scoop.http.*
import scoop.http.asyncio.*
import scoop.platform.memory.*
import scoop.platform.net.*

private fun check(value: Boolean) {
    if (!value)
        throw IllegalStateException()
}

private fun exerciseConsumer() {
    val loop: EventLoop = PlatformEventLoop()
    loop.run suspend {
        scope ->
        val listener = loop.listenTcp(SocketAddress(IpAddress.IPV4_LOOPBACK, 0))
        try {
            val serving =
                scope.launch suspend {
                    val connection =
                        AsyncHttp1Connection.takeOwnershipAsServer(listener.accept(), scope)
                    try {
                        val request = connection.receiveRequest()!!
                        check(String.fromUtf8(request.head.method) == "GET")
                        NativeByteBuffer.allocate(1L).use suspend {
                            buffer -> check(request.body.readInto(buffer, 1L) == 0L)
                        }
                        val writer =
                            connection.sendResponse(
                                HttpResponseHead(HttpVersion.Http11, 200U),
                                Http1BodyFraming.Chunked
                            )
                        NativeByteBuffer.allocate(2L).use suspend {
                            buffer ->
                            buffer.writeBytes("42".toByteArray());
                            writer.writeFully(buffer)
                        }
                        writer.finish([HttpField("X-Done".toByteArray(), "yes".toByteArray())])
                    } finally {
                        connection.close()
                    }
                }
            val connection =
                AsyncHttp1Connection.takeOwnershipAsClient(
                    loop.connectTcp(listener.localAddress),
                    scope
                )
            try {
                connection.sendRequest(
                    HttpRequestHead(
                        HttpVersion.Http11,
                        "GET".toByteArray(),
                        HttpRequestTarget.Http1("/".toByteArray()),
                        [HttpField("Host".toByteArray(), "localhost".toByteArray())]
                    )
                ).finish()
                val response = connection.receiveResponse()
                check(response.head.status == 200U)
                NativeByteBuffer.allocate(3L).use suspend {
                    buffer ->
                    response.body.readFully(buffer, 2L)
                    check(String.fromUtf8(buffer.readBytes(2L)) == "42")
                    check(response.body.readInto(buffer, 1L) == 0L)
                    check(response.body.trailers!!.size == 1L)
                }
                gcCollect()
                check(response.body.isComplete)
            } finally {
                connection.close()
            }
            serving.join()
        } finally {
            listener.close()
        }
    }
    assertEquals("42", (42).toString())
}

@Test
private class ConsumerTests {
    @Test
    fun behavior() {
        exerciseConsumer()
    }
}
