package scoop.http.asyncio.tests.consumer.websocket_lifetime

import scoop.test.*
import scoop.asyncio.*
import scoop.http.*
import scoop.http.asyncio.*

internal fun wsSourceClose() {
    val loop: EventLoop = LibuvEventLoop()
    loop.run suspend { scope ->
        val transport = WsTestTransport()
        val session = AsyncWebSocketSession.takeOwnership(transport, scope, HttpRole.Client)
        val source = WsBlockedSource()
        val result = WsFailure()
        val sending = scope.launch suspend {
            try { session.send(WebSocketMessageType.Binary, source) }
            catch (error: Throwable) { result.value = Some(error) }
            ensureActive()
        }
        source.started.await()
        val closing = scope.launch suspend { session.close() }
        try {
            wsCheck(source.cancelled.ready, "close did not cancel the suspended send source")
            wsCheck(!closing.isCompleted && !session.isClosed, "close completed before the source finally")
            wsCheck(transport.closes == 0, "transport closed before source cleanup")
            source.release.signal()
            sending.join(); closing.join()
            wsCheck(source.finished && session.isClosed && transport.closes == 1, "real close completion")
            wsCheck(!sending.isCancelled && wsPresent(result.value), "close must not cancel the caller")
            wsCheck(!wsPresent(session.failure), "local close must not manufacture a failure")
        } finally {
            sending.cancel(); source.release.signal()
            sending.join(); closing.join(); session.close()
        }
    }
}
