package scoop.http.asyncio.tests.consumer.multipart_source

import scoop.test.*
import scoop.asyncio.*
import scoop.http.*
import scoop.http.asyncio.*
import scoop.platform.memory.NativeByteBuffer

private fun exerciseConsumer() {
    val loop: EventLoop = LibuvEventLoop()
    loop.run suspend { scope -> runHttp1(loop, scope); runHttp2(loop, scope) }

}

fun check(value: Boolean) { if (!value) throw IllegalStateException() }
fun boundary(): MultipartBoundary = MultipartBoundary("b:54")
fun multipartBytes(): Array<Byte> = ("preamble\r\n--b:54\r\nContent-Disposition: form-data; name=\"字段\"\r\n\r\n正文" +
    "\r\n--b:54\r\n\r\n\r\n--b:54\r\n\r\nabcdef\r\n--b:54--\r\nepilogue").toByteArray()

fun multipartHead(version: HttpVersion): HttpResponseHead =
    HttpResponseHead(version, 200U, fields = [boundary().toMediaType().toHttpField()])

suspend fun writeBytes(sink: AsyncByteSink, bytes: Array<Byte>) {
    NativeByteBuffer.allocate(3L).use suspend { buffer ->
        var offset = 0L
        while (offset < bytes.size) {
            buffer.clear()
            val count = if (bytes.size - offset > 3L) 3L else bytes.size - offset
            buffer.writeBytes(bytes, offset, count)
            sink.writeFully(buffer)
            offset += count
        }
    }
}

suspend fun readParts(source: MultipartSource) {
    val first = source.nextPart()!!
    val disposition = HttpContentDisposition.parse(first.head.fields[0L].value)
    check(String.fromUtf8(disposition.parameter("name")!!.value) == "字段")
    val bytes = ArrayList<Byte>()
    NativeByteBuffer.allocate(2L).use suspend { buffer ->
        while (true) {
            buffer.clear()
            val count = first.body.readInto(buffer, 2L)
            if (count == 0L) break
            for (byte in buffer.readBytes(count)) bytes.add(byte)
        }
    }
    check(String.fromUtf8(bytes) == "正文" && first.body.isComplete)
    first.body.close()
    check(source.nextPart()!!.body.discard(0L) == 0L)
    val last = source.nextPart()!!
    NativeByteBuffer.allocate(1L).use suspend { buffer ->
        check(last.body.readInto(buffer, 1L) == 1L && buffer.readInt8() == 97.toByte())
    }
    gcCollect()
    check(last.body.discard(5L) == 5L)
    check(when (source.nextPart()) { case None -> true; case Some(_) -> false })
    check(source.isFinished)
}

suspend fun checkEmpty(source: AsyncByteSource) {
    NativeByteBuffer.allocate(1L).use suspend { buffer -> check(source.readInto(buffer, 1L) == 0L) }
}

class Gate {
    private var open: Boolean = false
    private val waiters: ArrayList<Continuation<Unit>> = ArrayList<Continuation<Unit>>()
    fun signal() {
        open = true
        val ready = waiters.toArray()
        waiters.clear()
        for (waiter in ready) waiter.resume(Unit)
    }
    suspend fun await() {
        suspendCoroutine<Unit> { next -> if (open) next.resume(Unit) else waiters.add(next) }
    }
}

@Test
private class ConsumerTests {
    @Test
    fun behavior() { exerciseConsumer() }
}
