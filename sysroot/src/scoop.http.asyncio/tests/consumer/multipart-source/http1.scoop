package scoop.http.asyncio.tests.consumer.multipart_source

import scoop.test.*
import scoop.asyncio.*
import scoop.compression.*
import scoop.compression.asyncio.*
import scoop.http.*
import scoop.http.asyncio.*
import scoop.platform.net.*

private fun request(): HttpRequestHead = HttpRequestHead(HttpVersion.Http11, "GET".toByteArray(),
    HttpRequestTarget.Http1("/parts".toByteArray()), [HttpField("Host".toByteArray(), "localhost".toByteArray())])

suspend fun runHttp1(loop: EventLoop, scope: CoroutineScope) {
    val listener = loop.listenTcp(SocketAddress(IpAddress.IPV4_LOOPBACK, 0))
    try {
        val serving = scope.launch suspend {
            val server = AsyncHttp1Connection.takeOwnershipAsServer(listener.accept(), scope)
            try {
                checkEmpty(server.receiveRequest()!!.body)
                val head = HttpResponseHead(HttpVersion.Http11, 200U, fields = [boundary().toMediaType().toHttpField(),
                    HttpField("Content-Encoding".toByteArray(), "gzip".toByteArray())])
                val writer = server.sendResponse(head, Http1BodyFraming.Chunked)
                writeBytes(writer, compress(multipartBytes(), CompressionOptions.Gzip(GzipOptions())))
                writer.finish([HttpField("x-source".toByteArray(), "h1".toByteArray())])
                checkEmpty(server.receiveRequest()!!.body)
                server.sendResponse(HttpResponseHead(HttpVersion.Http11, 204U)).finish()
            } finally { server.close() }
        }
        val client = AsyncHttp1Connection.takeOwnershipAsClient(loop.connectTcp(listener.localAddress), scope)
        try {
            client.sendRequest(request()).finish()
            val response = client.receiveResponse()
            val media = HttpMediaType.parse(response.head.fields.findAll("content-type".toByteArray())[0L].value)
            val decompressed = AsyncDecompressionSource.takeOwnership(response.body, DecompressionOptions(CompressionFormat.Gzip), 3L)
            MultipartSource.takeOwnership(decompressed, MultipartBoundary.fromMediaType(media),
                MultipartLimits(dataChunkBytes = 2L), 3L).useAsync suspend { source ->
                readParts(source)
                check(response.body.isComplete && String.fromUtf8(response.body.trailers!![0L].value) == "h1")
            }
            client.sendRequest(request()).finish()
            val next = client.receiveResponse()
            check(next.head.status == 204U)
            checkEmpty(next.body)
            next.body.close()
            serving.join()
        } finally { client.close() }
    } finally { listener.close() }
}
