package scoop.http.asyncio.tests.consumer.websocket_async

import scoop.test.*
import scoop.asyncio.*
import scoop.bytes.ByteArrayBuilder
import scoop.http.*
import scoop.http.asyncio.*
import scoop.platform.memory.NativeByteBuffer

suspend fun serveUpgrade(raw: AsyncTcpStream, scope: CoroutineScope) {
    try {
        val (request, prefix) = readUpgrade(raw)
        val handshake = WebSocketHandshake.parse(request)
        check(when (request.target) { case Http1(bytes) -> String.fromUtf8(bytes) == "/chat?x=%2F"; else -> false })
        val response = handshake.response(Some("chat"))
        val bytes = Http1Encoder(HttpRole.Server).use { encoder ->
            val header = encoder.beginResponse(response, "GET".toByteArray())
            check(encoder.finish().size == 0L)
            header
        }
        val combined = ByteArrayBuilder().append(bytes).append(firstFrame())
        NativeByteBuffer.allocate(combined.size).use suspend { buffer ->
            buffer.writeBytes(combined.toByteArray())
            raw.writeFully(buffer)
            raw.flush()
        }
        val session = AsyncWebSocketSession.takeOwnership(HttpTransport.takeOwnershipWithPrefix(raw, prefix),
            scope, HttpRole.Server, sessionOptions())
        try {
            val message = session.receive()!!
            val text = message.readText()
            check(text == "chunk 🌍 across frames")
            check(message.isComplete)
            session.ping("server".toByteArray())
            session.sendText("ack:" + text)
            val binary = session.receive()!!
            check(binary.type == WebSocketMessageType.Binary)
            session.sendBinary(binary.readBytes())
            check(when (session.receive()) { case None -> true; case Some(_) -> false })
            check(session.shutdownGracefully().reason == "finished")
        } finally { session.close() }
    } finally { raw.close() }
}

private fun firstFrame(): Array<Byte> = WebSocketFrameEncoder(HttpRole.Server).use { encoder ->
    val bytes = "ready 🌍".toByteArray()
    val result = ByteArrayBuilder().append(encoder.beginFrame(WebSocketFrameHead(WebSocketOpcode.Text, bytes.size)))
    NativeByteBuffer.allocate(bytes.size).use { buffer ->
        buffer.writeBytes(bytes)
        result.append(encoder.writePayload(buffer))
        encoder.finishFrame()
        result.toByteArray()
    }
}

private suspend fun readUpgrade(source: AsyncByteSource): (HttpRequestHead, Array<Byte>) =
    Http1Decoder.server().use suspend { decoder ->
        NativeByteBuffer.allocate(1024L).use suspend { buffer ->
            var request: HttpRequestHead? = None
            var ended = false
            while (!ended) {
                when (decoder.nextEvent()) {
                    case Some(Http1Event.Request(head)) -> request = Some(head)
                    case Some(Http1Event.Trailers(fields)) -> check(fields.size == 0L)
                    case Some(Http1Event.End(_)) -> ended = true
                    case Some(_) -> throw IllegalStateException(Some("unexpected WebSocket request body"))
                    case None -> {
                        if (buffer.readableBytes == 0L) {
                            buffer.clear()
                            check(source.readInto(buffer, buffer.writableBytes) > 0L)
                        }
                        check(decoder.receive(buffer) > 0L)
                    }
                }
            }
            (request!!, buffer.readBytes(buffer.readableBytes))
        }
    }
