package scoop.http.asyncio

import scoop.asyncio.*
import scoop.http.*
import scoop.platform.memory.NativeByteBuffer
import scoop.test.*

@Test
private class AsyncHttp1ReuseTests {
    @Test
    fun `reuse requires complete output request context final response and trailers`() {
        withHttp1 suspend { _, _, _, client, server ->
            assertTrue(client.isReusable && server.isReusable)
            val writing = client.sendRequest(request("POST"), Http1BodyFraming.Length(2L))
            assertFalse(client.isReusable)
            val incoming = server.receiveRequest()!!
            assertFalse(server.isReusable)
            sendBytes(writing, "ab".toByteArray())
            writing.finish()
            assertFalse(client.isReusable)
            assertEquals("ab", String.fromUtf8(incoming.body.readAllBytes(2L)))
            assertFalse(server.isReusable)
            server.sendResponse(response(103U)).finish()
            assertEquals(0L, client.receiveResponse().body.readAllBytes(0L).size)
            assertFalse(client.isReusable || server.isReusable)
            val outgoing = server.sendResponse(response(), Http1BodyFraming.Chunked)
            sendBytes(outgoing, "ok".toByteArray())
            outgoing.finish([field("X-End", "yes")])
            assertTrue(server.isReusable)
            val answer = client.receiveResponse()
            assertFalse(client.isReusable)
            NativeByteBuffer.allocate(1L).use suspend { buffer ->
                assertEquals(1L, answer.body.readInto(buffer, 1L))
                assertFalse(client.isReusable)
            }
            assertEquals("k", String.fromUtf8(answer.body.readAllBytes(1L)))
            assertEquals("yes", String.fromUtf8(answer.body.trailers!![0L].value))
            assertTrue(client.isReusable)
            client.close(); server.close()
            assertFalse(client.isReusable || server.isReusable)
        }
    }

    @Test
    fun `a pending receive operation is not an idle reusable connection`() {
        withHttp1 suspend { scope, _, _, client, server ->
            assertTrue(server.isReusable)
            val receiving = scope.async suspend { server.receiveRequest()!! }
            assertFalse(server.isReusable)
            client.sendRequest(request()).finish()
            receiving.await().body.readAllBytes(0L)
            server.sendResponse(response(204U)).finish()
            client.receiveResponse().body.readAllBytes(0L)
            assertTrue(client.isReusable && server.isReusable)
        }
    }
}
