package scoop.http.asyncio

import scoop.asyncio.*
import scoop.http.*
import scoop.test.*

@Test
private class SseSourceFailureTests {
    @Test
    fun `construction and pre-cancellation preserve ownership and wrong loop calls do not damage the source`() {
        val loop: EventLoop = PlatformEventLoop()
        val other: EventLoop = PlatformEventLoop()
        loop.run suspend {
            scope ->
            val input = MessageTestSource("data:ok\n\n".toByteArray())
            assertFailsWith<IllegalArgumentException> {
                SseSource.takeOwnership(input, bufferSize = 0L)
            }
            assertFailsWith<IllegalArgumentException> {
                SseSource.takeOwnership(input, initialLastEventId = "bad\n")
            }
            val source = SseSource(input)
            val cancelled =
                scope.launch suspend {
                    currentJobOrNone()!!.cancel()
                    expectMessageFailure<CancellationException> suspend {
                        SseSource.takeOwnership(input)
                    }
                    expectMessageFailure<CancellationException> suspend { source.next() }
                }
            cancelled.join()
            expectMessageFailure<IllegalStateException> suspend {
                context(other) {
                    source.next()
                }
            }
            assertEquals(0, input.reads)
            assertEquals(0, input.closes)
            assertFalse(present(source.failure))
            assertEquals("ok", source.next()!!.data)
            source.close()
            assertEquals(0, input.closes)
            input.close()
        }
    }

    @Test
    fun `I/O and parser failures retain their types and useAsync combines cleanup failure`() {
        val loop: EventLoop = PlatformEventLoop()
        loop.run suspend {
            _ ->
            val input = MessageTestSource("".toByteArray())
            input.failRead = true;
            input.failClose = true
            val source = SseSource.takeOwnership(input)
            val error =
                expectMessageFailure<ResourceUseException> suspend {
                    source.useAsync suspend { stream -> stream.next() }
                }
            assertTrue(error.primaryFailure is TransportFailure)
            assertTrue(error.cleanupFailure is CleanupFailure)
            assertTrue(source.failure!! is TransportFailure)
            assertTrue(source.isClosed)
            assertEquals(1, input.closes)
            source.close()
            val large = MessageTestSource("data:too long\n\n".toByteArray())
            val limited = SseSource.takeOwnership(large, SseLimits(maxEventBytes = 1L))
            val limit = expectMessageFailure<SseLimitException> suspend { limited.next() }
            assertTrue(limit.kind == SseLimitKind.EventBytes)
            assertTrue(limited.failure!! is SseLimitException)
            expectMessageFailure<IllegalStateException> suspend { limited.next() }
            limited.close()
            assertEquals(1, large.closes)
        }
    }

    @Test
    fun `inconsistent source progress is rejected before reusing its buffer`() {
        val loop: EventLoop = PlatformEventLoop()
        loop.run suspend {
            _ -> for (mode in [1, 2, 3, 4]) {
                val input = MessageTestSource("".toByteArray())
                input.badProgress = mode
                val source = SseSource.takeOwnership(input, bufferSize = 4L)
                expectMessageFailure<IllegalStateException> suspend { source.next() }
                assertTrue(source.failure!! is IllegalStateException)
                source.close()
                assertEquals(1, input.closes)
            }
        }
    }

    @Test
    fun `concurrent close waiters receive the same cleanup failure and the endpoint closes once`() {
        val loop: EventLoop = PlatformEventLoop()
        loop.run suspend {
            scope ->
            val gate = AsyncGate()
            val input = MessageTestSource("".toByteArray())
            input.closeGate = Some(gate);
            input.failClose = true
            val source = SseSource.takeOwnership(input)
            val failures = ArrayList<CleanupFailure>()
            val first =
                scope.launch suspend {
                    failures.add(expectMessageFailure<CleanupFailure> suspend { source.close() })
                }
            val second =
                scope.launch suspend {
                    failures.add(expectMessageFailure<CleanupFailure> suspend { source.close() })
                }
            assertFalse(first.isCompleted || second.isCompleted || source.isClosed)
            assertEquals(1, input.closes)
            gate.signal()
            first.join();
            second.join()
            assertEquals(2L, failures.size)
            assertTrue(failures[0L] === failures[1L])
            assertTrue(source.isClosed)
            source.close()
            assertEquals(1, input.closes)
            ensureActive()
        }
    }
}
