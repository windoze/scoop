package scoop.http.asyncio

import scoop.asyncio.*
import scoop.test.*

@Test
private class SseSourceCancellationTests {
    @Test
    fun `concurrent reads are rejected and close waits for the real borrow without cancelling the caller`() {
        val loop: EventLoop = PlatformEventLoop()
        loop.run suspend {
            scope ->
            val pending = PendingMessageSource()
            val source = SseSource.takeOwnership(pending, bufferSize = 4L)
            val reader =
                scope.launch suspend {
                    expectMessageFailure<CancellationException> suspend { source.next() }
                    ensureActive()
                }
            try {
                assertTrue(pending.running)
                expectMessageFailure<IllegalStateException> suspend { source.next() }
                assertFalse(present(source.failure))
                val first = scope.launch suspend { source.close() }
                val second = scope.launch suspend { source.close() }
                assertTrue(pending.job!!.isCancelled)
                assertFalse(reader.isCompleted || first.isCompleted || second.isCompleted)
                assertEquals(0, pending.closes)
                assertFalse(pending.buffer!!.isClosed)
                assertFailsWith<IllegalStateException> { pending.buffer!!.clear() }
                gcCollect()
                pending.complete()
                reader.join();
                first.join();
                second.join()
                assertFalse(reader.isCancelled)
                assertTrue(pending.buffer!!.isClosed)
                assertTrue(source.isClosed)
                assertEquals(1, pending.closes)
                ensureActive()
            } finally {
                if (pending.running)
                    pending.complete()
                source.close()
            }
        }
    }

    @Test
    fun `cancelled finally closes local state while a borrowed endpoint remains open`() {
        val loop: EventLoop = PlatformEventLoop()
        loop.run suspend {
            scope ->
            val pending = PendingMessageSource()
            val source = SseSource(pending, bufferSize = 4L)
            val reader =
                scope.launch suspend {
                    try {
                        source.next()
                    } finally {
                        source.close()
                    }
                }
            try {
                assertTrue(pending.running)
                reader.cancel()
                assertTrue(pending.job!!.isCancelled)
                assertFalse(reader.isCompleted)
                assertFailsWith<IllegalStateException> { pending.buffer!!.close() }
                pending.complete()
                reader.join()
                assertTrue(reader.isCancelled && source.isClosed && pending.buffer!!.isClosed)
                assertEquals(0, pending.closes)
                assertTrue(source.failure!! is CancellationException)
                ensureActive()
            } finally {
                if (pending.running)
                    pending.complete()
                source.close()
                pending.close()
            }
        }
    }
}
