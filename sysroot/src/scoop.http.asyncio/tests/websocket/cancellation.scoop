package scoop.http.asyncio

import scoop.asyncio.*
import scoop.http.*
import scoop.platform.concurrent.Thread
import scoop.platform.memory.NativeByteBuffer
import scoop.test.*
import scoop.time.Duration

@Test
private class AsyncWebSocketCancellationTests {
    @Test
    fun `local close waits for the real input borrow without cancelling its caller`() {
        val loop: EventLoop = PlatformEventLoop()
        loop.run suspend {
            scope ->
            val input = PendingMessageSource()
            val transport = WebSocketTestTransport(input, MessageTestSink())
            val session = AsyncWebSocketSession.takeOwnership(transport, scope, HttpRole.Client)
            val reading =
                scope.launch suspend {
                    val error =
                        expectMessageFailure<WebSocketSessionException> suspend {
                            session.receive()
                        }
                    assertTrue(error.kind == WebSocketFailureKind.Closed)
                    ensureActive()
                }
            try {
                assertTrue(input.running)
                expectMessageFailure<IllegalStateException> suspend { session.receive() }
                val first = scope.launch suspend { session.close() }
                val second = scope.launch suspend { session.close() }
                assertTrue(input.job!!.isCancelled)
                assertFalse(first.isCompleted || second.isCompleted || reading.isCompleted)
                assertEquals(0, transport.closes)
                assertFailsWith<IllegalStateException> { input.buffer!!.close() }
                gcCollect()
                input.complete()
                reading.join();
                first.join();
                second.join()
                assertTrue(session.isClosed && input.buffer!!.isClosed)
                assertFalse(present(session.failure) || reading.isCancelled)
                assertEquals(1, transport.closes)
            } finally {
                if (input.running)
                    input.complete()
                session.close()
            }
        }
    }

    @Test
    fun `cross thread cancellation waits for both native borrows and closes from cancelled finally`() {
        val loop: EventLoop = PlatformEventLoop()
        loop.run suspend {
            scope ->
            val input = PendingMessageSource()
            val output = PendingMessageSink(1.toByte())
            output.pause = true
            val transport = WebSocketTestTransport(input, output)
            val session =
                AsyncWebSocketSession.takeOwnership(
                    transport,
                    scope,
                    HttpRole.Client,
                    WebSocketSessionOptions(outgoingFrameBytes = 2L)
                )
            val writer = session.beginMessage(WebSocketMessageType.Text)
            NativeByteBuffer.allocate(3L).use suspend {
                buffer ->
                buffer.writeBytes("abc".toByteArray())
                val writing =
                    scope.launch suspend {
                        try {
                            writer.writeFrom(buffer, 3L)
                        }
                        finally {
                            writer.close()
                        }
                    }
                try {
                    assertTrue(input.running && output.running)
                    assertEquals(2L, buffer.readPosition)
                    val cancelling = Thread.start { writing.cancel() }
                    cancelling.join()
                    assertTrue(input.job!!.isCancelled && output.job!!.isCancelled)
                    assertTrue(input.job!! === output.job!!)
                    assertFalse(input.job!! === writing)
                    val first = scope.launch suspend { session.close() }
                    val second = scope.launch suspend { session.close() }
                    assertFalse(first.isCompleted || second.isCompleted || writing.isCompleted)
                    assertEquals(0, transport.closes)
                    gcCollect()
                    input.complete()
                    assertFalse(input.buffer!!.isClosed)
                    assertEquals(0, transport.closes)
                    output.complete()
                    writing.join();
                    first.join();
                    second.join()
                    assertTrue(input.buffer!!.isClosed && output.buffer!!.isClosed)
                    assertTrue(session.isClosed && writer.isClosed && !writer.isComplete)
                    assertTrue(session.failure!! is CancellationException)
                    assertEquals(1, transport.closes)
                    ensureActive()
                } finally {
                    if (input.running)
                        input.complete()
                    if (output.running)
                        output.complete()
                    session.close()
                }
            }
        }
    }

    @Test
    fun `closing an unfinished received message aborts instead of draining indefinitely`() {
        withWebSockets suspend {
            _, _, _, client, server ->
            val writer = client.beginMessage(WebSocketMessageType.Binary)
            sendBytes(writer, "partial".toByteArray())
            val message = server.receive()!!
            message.close()
            assertTrue(message.isClosed && !message.isComplete)
            assertTrue(server.isClosed)
            assertFalse(present(server.sentClose) || present(server.failure))
            message.close()
        }
    }

    @Test
    fun `session owns its timer after the supplied scope body returns`() {
        val loop: EventLoop = PlatformEventLoop()
        loop.run suspend {
            scope ->
            val(a, b) = rawPair(loop, scope)
            val slot = WebSocketSlot()
            val ready = AsyncGate()
            val owner =
                scope.launch suspend {
                    coroutineScope<Unit> suspend {
                        child ->
                        slot.value =
                            Some(
                                AsyncWebSocketSession.takeOwnership(
                                    a,
                                    child,
                                    HttpRole.Client,
                                    WebSocketSessionOptions(
                                        closeTimeout = Duration.seconds(Long.MAX_VALUE)
                                    )
                                )
                            )
                        ready.signal()
                    }
                }
            ready.await()
            val client = slot.value!!
            val server = AsyncWebSocketSession.takeOwnership(b, scope, HttpRole.Server)
            try {
                assertFalse(owner.isCompleted)
                assertTrue(client.shutdownGracefully().code == Some(1000U))
                server.shutdownGracefully()
                owner.join()
                assertTrue(client.isClosed && server.isClosed)
                assertFalse(present(client.failure))
            } finally {
                client.close();
                server.close();
                owner.join()
            }
        }
    }

    @Test
    fun `invalid options and closed scope are rejected before ownership transfer`() {
        assertFailsWith<IllegalArgumentException> { WebSocketSessionOptions(inputBufferBytes = 0L) }
        assertFailsWith<IllegalArgumentException> {
            WebSocketSessionOptions(outgoingFrameBytes = Long.MAX_VALUE)
        }
        assertFailsWith<IllegalArgumentException> {
            WebSocketSessionOptions(closeTimeout = Duration.ZERO)
        }
        val loop: EventLoop = PlatformEventLoop()
        loop.run suspend {
            _ ->
            val closed = coroutineScope<CoroutineScope> suspend { it }
            val transport = WebSocketTestTransport(WebSocketWaitingSource(), MessageTestSink())
            expectMessageFailure<IllegalStateException> suspend {
                AsyncWebSocketSession.takeOwnership(transport, closed, HttpRole.Client)
            }
            assertEquals(0, transport.closes)
        }
    }

    @Test
    fun `cancelling a message owner between operations aborts the unfinished writer`() {
        withRawWebSocket suspend {
            scope, _, session, _ ->
            val ready = AsyncGate()
            val release = AsyncGate()
            val sending =
                scope.launch suspend {
                    val writer = session.beginMessage(WebSocketMessageType.Binary)
                    try {
                        ready.signal();
                        release.await()
                    }
                    finally {
                        writer.close()
                    }
                }
            try {
                ready.await()
                sending.cancel()
                session.close()
                assertTrue(session.failure!! is CancellationException)
                assertTrue(session.isClosed)
            } finally {
                release.signal();
                sending.join()
            }
        }
    }

    @Test
    fun `cancelling the supplied owner scope closes an idle session`() {
        val loop: EventLoop = PlatformEventLoop()
        loop.run suspend {
            scope ->
            val transport = WebSocketTestTransport(WebSocketWaitingSource(), MessageTestSink())
            val slot = WebSocketSlot()
            val ready = AsyncGate()
            val owner =
                scope.launch suspend {
                    coroutineScope<Unit> suspend {
                        child ->
                        slot.value =
                            Some(
                                AsyncWebSocketSession.takeOwnership(
                                    transport,
                                    child,
                                    HttpRole.Client
                                )
                            )
                        ready.signal()
                    }
                }
            ready.await()
            owner.cancel()
            owner.join()
            assertTrue(slot.value!!.isClosed)
            assertTrue(slot.value!!.failure!! is CancellationException)
            assertEquals(1, transport.closes)
            ensureActive()
        }
    }
}
