package scoop.http.asyncio

import scoop.bytes.ByteArrayBuilder
import scoop.http.*
import scoop.test.*
import scoop.url.Url

internal fun negotiatedWsDeflate(serverWindow: Int = 15, clientWindow: Int = 15,
    serverNoContext: Boolean = false, clientNoContext: Boolean = false): WebSocketDeflateNegotiation {
    val offer = WebSocketDeflateOffer(serverNoContext, clientNoContext, Some(serverWindow), WebSocketWindowBits.Limit(clientWindow))
    val handshake = WebSocketHandshake.create(Url.parse("ws://localhost/chat"), deflateOffers = [offer])
    val response = handshake.response(deflate = Some(WebSocketDeflate(serverNoContext, clientNoContext,
        Some(serverWindow), Some(clientWindow))))
    return handshake.accept(response).deflate!!
}

internal suspend fun wsRawMessage(peer: RawWebSocketPeer, maxFrameBytes: Long = Long.MAX_VALUE):
    (WebSocketFrameHead, Array<Byte>) {
    val (first, bytes) = peer.receive()
    assertTrue(first.opcode == WebSocketOpcode.Text || first.opcode == WebSocketOpcode.Binary)
    assertTrue(first.payloadLength <= maxFrameBytes)
    val result = ByteArrayBuilder().append(bytes)
    var last = first
    while (!last.isFinal) {
        val (head, next) = peer.receive()
        assertTrue(head.opcode == WebSocketOpcode.Continuation)
        assertFalse(head.isCompressed)
        assertTrue(head.payloadLength <= maxFrameBytes)
        result.append(next)
        last = head
    }
    return (first, result.toByteArray())
}

