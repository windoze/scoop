package scoop.readline

import scoop.charset.graphemes

internal struct StyledGrapheme(val plain: String, val decoration: String)

// Only SGR styling is invisible. User input controls remain visible text.
private fun decorationEnd(text: String, start: Long): Long {
    if (start + 2L >= text.charLength || text.getCharAt(start) != '\u001b' || text.getCharAt(start + 1L) != '[') return start
    var index = start + 2L
    while (index < text.charLength) {
        val character = text.getCharAt(index)
        if (character == 'm') return index + 1L
        if ((character < '0' || character > '9') && character != ';' && character != ':') return start
        index += 1L
    }
    return start
}

internal fun stripDecoration(text: String): String {
    val result = StringBuilder()
    var index = 0L
    while (index < text.charLength) {
        val end = decorationEnd(text, index)
        if (end > index) index = end
        else { result.append(text.getCharAt(index)); index += 1L }
    }
    return result.toString()
}

internal fun styledGraphemes(plain: String, styled: String): Array<StyledGrapheme> {
    val result = ArrayList<StyledGrapheme>()
    var index = 0L
    for (cluster in graphemes(plain)) {
        val decoration = StringBuilder()
        for (character in cluster) {
            while (index < styled.charLength && styled.getCharAt(index) != character) {
                val end = decorationEnd(styled, index)
                if (end == index) throw IllegalArgumentException(Some("highlighter changed visible text"))
                decoration.append(styled.slice(index, end))
                index = end
            }
            if (index >= styled.charLength || styled.getCharAt(index) != character) {
                throw IllegalArgumentException(Some("highlighter changed visible text"))
            }
            index += 1L
        }
        result.add(StyledGrapheme(cluster, decoration.toString()))
    }
    val trailing = StringBuilder()
    while (index < styled.charLength) {
        val end = decorationEnd(styled, index)
        if (end == index) throw IllegalArgumentException(Some("highlighter changed visible text"))
        trailing.append(styled.slice(index, end))
        index = end
    }
    if (trailing.toString().byteLength > 0L) result.add(StyledGrapheme("", trailing.toString()))
    return result.toArray()
}
