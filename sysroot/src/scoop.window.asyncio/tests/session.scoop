package scoop.window.asyncio

import scoop.asyncio.*
import scoop.window.*
import scoop.window.native.*
import scoop.platform.concurrent.currentThreadId
import scoop.time.Duration
import scoop.test.*
import scoop.tests.window.*
import scoop.platform.time.MonotonicTimeSource

@Test
private class WindowAsyncioTest {
    @Test
    fun `root cancellation closes windows before child cleanup and waits for leases`() {
        val application = Application()
        val handler = AsyncHandler()
        application.runWithAsyncio(handler)
        assertTrue(handler.childStarted)
        assertTrue(handler.childFinished)
        assertTrue(handler.closing)
        assertTrue(handler.destroyed)
        assertEquals(1, handler.exiting)
        assertTrue(handler.batches < 40)
        assertTrue(handler.modalTicks > 0)
        assertTrue(handler.menuTicks > 0)
        assertFailsWith<MissingContextException> { currentApplicationScope() }
    }
}

private class AsyncHandler: ApplicationHandler {
    val thread = currentThreadId()
    var window: Window? = None
    var lease: NativeWindowLease? = None
    var childStarted = false
    var childFinished = false
    var closing = false
    var destroyed = false
    var exiting = 0
    var batches = 0
    var modalTicks = 0
    var menuTicks = 0

    public override fun onEvent(application: ActiveApplication, event: ApplicationEvent) {
        assertEquals(thread, currentThreadId())
        when (event) {
            case NewEvents(StartCause.Deadline) -> fail(Some("native host mode deadline expired"))
            case NewEvents(_) -> batches += 1
            case Resumed -> start(application)
            case Exiting -> {
                exiting += 1;
                assertFailsWith<MissingContextException> { currentApplicationScope() }
            }
            case Window(_, WindowEvent.Closing) -> {
                closing = true
                assertFalse(childFinished)
                assertFailsWith<MissingContextException> { currentApplicationScope() }
            }
            case Window(_, WindowEvent.Destroyed) -> {
                assertTrue(childFinished)
                destroyed = true
                assertFailsWith<MissingContextException> { currentApplicationScope() }
            }
            else -> {}
        }
    }

    private fun start(application: ActiveApplication) {
        val first =
            application.createWindow(
                WindowAttributes("Scoop asyncio host test", LogicalSize(320.0, 180.0))
            )
        first.requestFocus()
        window = Some(first)
        @Unsafe
        {
            lease = Some(first.acquireNativeWindow())
        }
        val scope = currentApplicationScope()
        val loop = currentEventLoop()
        application.setControlFlow(
            ControlFlow.WaitUntil(MonotonicTimeSource.markNow() + Duration.seconds(5L))
        )
        @Unsafe
        {
            when (lease!!.handle) {
                case AppKit(window, _) -> scheduleNativeMode(window, 1, 0.15)
            }
        }
        scope.launch suspend {
            childStarted = true
            try {
                loop.sleep(Duration.seconds(10L))
            }
            finally {
                // Root cancellation reaches the window control source before this suspended cleanup.
                nonCancellableScope<Unit> suspend {
                    _ ->
                    loop.sleep(Duration.milliseconds(10L))
                    try {
                        assertTrue(closing)
                    }
                    finally {
                        childFinished = true;
                        lease!!.close()
                    }
                }
            }
        }
        scope.launch suspend {
            var menuStarted = false
            while (true) {
                loop.sleep(Duration.milliseconds(10L))
                @Unsafe
                {
                    val mode = activeNativeMode()
                    if (mode == 1)
                        modalTicks += 1
                    if (mode == 2)
                        menuTicks += 1
                    val count = completedNativeModes()
                    if (count == 2)
                        break
                    if (count == 1 && !menuStarted) {
                        menuStarted = true
                        when (lease!!.handle) {
                            case AppKit(window, _) -> scheduleNativeMode(window, 2, 0.15)
                        }
                    }
                }
            }
            gcCollect()
            scope.job.cancel()
        }
    }
}
