package scoop.url

import scoop.test.*

@Test
private class UrlResolveTests {
    @Test
    fun `RFC3986 section 5 normal and abnormal reference resolution`() {
        val base = Url.parse("http://a/b/c/d;p?q")
        val vectors: Array<(String, String)> = [
            ("g:h", "g:h"), ("g", "http://a/b/c/g"), ("./g", "http://a/b/c/g"),
            ("g/", "http://a/b/c/g/"), ("/g", "http://a/g"), ("//g", "http://g"),
            ("?y", "http://a/b/c/d;p?y"), ("g?y", "http://a/b/c/g?y"),
            ("#s", "http://a/b/c/d;p?q#s"), ("g#s", "http://a/b/c/g#s"),
            ("g?y#s", "http://a/b/c/g?y#s"), (";x", "http://a/b/c/;x"),
            ("g;x", "http://a/b/c/g;x"), ("g;x?y#s", "http://a/b/c/g;x?y#s"),
            ("", "http://a/b/c/d;p?q"), (".", "http://a/b/c/"), ("./", "http://a/b/c/"),
            ("..", "http://a/b/"), ("../", "http://a/b/"), ("../g", "http://a/b/g"),
            ("../..", "http://a/"), ("../../", "http://a/"), ("../../g", "http://a/g"),
            ("../../../g", "http://a/g"), ("../../../../g", "http://a/g"),
            ("/./g", "http://a/g"), ("/../g", "http://a/g"),
            ("g.", "http://a/b/c/g."), (".g", "http://a/b/c/.g"),
            ("g..", "http://a/b/c/g.."), ("..g", "http://a/b/c/..g"),
            ("./../g", "http://a/b/g"), ("./g/.", "http://a/b/c/g/"),
            ("g/./h", "http://a/b/c/g/h"), ("g/../h", "http://a/b/c/h"),
            ("g;x=1/./y", "http://a/b/c/g;x=1/y"), ("g;x=1/../y", "http://a/b/c/y"),
            ("g?y/./x", "http://a/b/c/g?y/./x"), ("g?y/../x", "http://a/b/c/g?y/../x"),
            ("g#s/./x", "http://a/b/c/g#s/./x"), ("g#s/../x", "http://a/b/c/g#s/../x"),
            ("http:g", "http:g")
        ]
        for (vector in vectors) {
            val value = base.resolve(vector._1)
            gcCollect()
            assertEquals(vector._2, value.toString())
            assertEquals(value, value.toBuilder().build())
        }
        assertEquals("http://a/b/c/d;p?q", base.toString())
    }

    @Test
    fun `encoded dots duplicate slashes and query data are not normalized as path structure`() {
        val base = Url.parse("http://example/a/b")
        assertEquals("http://example/a/%2E/%2E%2E/x", base.resolve("%2e/%2e%2e/x").toString())
        assertEquals("http://example/a/x//y", base.resolve("x//y").toString())
        assertEquals("http://example/x?", base.resolve("../x?").toString())
        assertEquals("http://example/a/b?x=../#..", base.resolve("?x=../#..").toString())
        assertFailsWith<UrlParseException> { Url.parse("relative").resolve("/x") }
        assertFailsWith<UrlParseException> { Url.parse("relative").httpAbsoluteTarget() }
    }
}
