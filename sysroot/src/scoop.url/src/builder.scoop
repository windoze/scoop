package scoop.url

import scoop.text.*

/**
 * Builds a URL from components. Ordinary setters accept raw text; encoded setters accept
 * already-escaped components. Build validates the assembled reference.
 */
public class UrlBuilder public constructor() {
    private var scheme: String? = None
    private var host: String? = None
    private var userInfo: String? = None
    private var port: Int? = None
    private var path: String = ""
    private var query: String? = None
    private var fragment: String? = None
    private val reusable: ArrayList<UrlAuthority> = ArrayList<UrlAuthority>()

    /**
     * Sets or clears the scheme; the result must be valid for the assembled reference.
     */
    public fun setScheme(value: String?): UrlBuilder {
        scheme = if (value == None) None else Some(canonicalEncoded(value!!, UrlComponent.Scheme).lowercaseAscii())
        return this
    }
    /**
     * Sets a raw Unicode host using the URL host and IDNA rules.
     */
    public fun setHost(value: String): UrlBuilder {
        val encoded = encodeUrlBytes(value.toByteArray(), false, "[]:")
        host = Some(if (encoded.contains(':') && !encoded.startsWith('[')) "[" + encoded + "]" else encoded)
        return this
    }
    /**
     * Sets an already-encoded host, or clears the host component.
     */
    public fun setEncodedHost(value: String?): UrlBuilder {
        host = encodedOptional(value, UrlComponent.Host)
        return this
    }
    /**
     * Replaces or clears the complete encoded authority.
     */
    public fun setEncodedAuthority(value: String?): UrlBuilder {
        if (value == None) { host = None; userInfo = None; port = None; return this }
        val parsed = Url.parse("//" + value!!)
        if (parsed.encodedPath.charLength != 0L || parsed.encodedQuery != None || parsed.encodedFragment != None) {
            urlError(UrlComponent.Authority, "authority must not contain a path, query or fragment")
        }
        copyAuthority(parsed.authority!!)
        return this
    }
    /**
     * Sets raw user information, percent-encoding data delimiters as needed.
     */
    public fun setUserInfo(value: String?): UrlBuilder =
        setEncodedUserInfo(if (value == None) None else Some(PercentEncoding.encode(value!!)))
    /**
     * Sets or clears already-encoded user information.
     */
    public fun setEncodedUserInfo(value: String?): UrlBuilder {
        userInfo = encodedOptional(value, UrlComponent.UserInfo)
        return this
    }
    /**
     * Sets or clears the explicit port.
     */
    public fun setPort(value: Int?): UrlBuilder {
        if (value != None && (value!! < 0 || value!! > 65535)) urlError(UrlComponent.Port, "port must be in 0..65535")
        port = value
        return this
    }
    /**
     * Replaces the path from raw text, preserving path separators as structure.
     */
    public fun setPath(value: String): UrlBuilder = setEncodedPath(encodeUrlBytes(value.toByteArray(), false, "/!$&'()*+,;=:@"))
    /**
     * Replaces the already-encoded path without treating encoded reserved characters as
     * separators.
     */
    public fun setEncodedPath(value: String): UrlBuilder {
        path = canonicalEncoded(value, UrlComponent.Path)
        return this
    }
    /**
     * Appends one raw path segment. Slashes and a segment equal to dot or dot-dot are encoded as
     * data.
     */
    public fun appendPathSegment(value: String): UrlBuilder {
        val encoded = if (value == ".") "%2E" else if (value == "..") "%2E%2E" else PercentEncoding.encode(value)
        return appendEncodedPathSegment(encoded)
    }
    /**
     * Appends one encoded segment; literal structural separators are rejected.
     */
    public fun appendEncodedPathSegment(value: String): UrlBuilder {
        val segment = canonicalEncoded(value, UrlComponent.Path)
        if (segment.contains('/') || segment.contains('?') || segment.contains('#')) {
            urlError(UrlComponent.Path, "an encoded path segment cannot contain structural separators")
        }
        if ((path.charLength == 0L && host != None) || (path.charLength > 0L && !path.endsWith('/'))) path += "/"
        path += segment
        return this
    }
    /**
     * Sets raw query text, or clears the query. This does not parse it as name/value pairs.
     */
    public fun setQuery(value: String?): UrlBuilder =
        setEncodedQuery(if (value == None) None else Some(PercentEncoding.encode(value!!)))
    /**
     * Sets or clears the whole encoded query without requiring name/value pair syntax.
     */
    public fun setEncodedQuery(value: String?): UrlBuilder {
        query = encodedOptional(value, UrlComponent.Query)
        return this
    }
    /**
     * Replaces the query using ordinary URI parameter serialization.
     */
    public fun setQueryParameters(value: UrlQuery): UrlBuilder = setEncodedQuery(Some(value.toString()))
    /**
     * Sets or clears a raw fragment, encoding it as needed.
     */
    public fun setFragment(value: String?): UrlBuilder =
        setEncodedFragment(if (value == None) None else Some(PercentEncoding.encode(value!!)))
    /**
     * Sets or clears an already-encoded fragment.
     */
    public fun setEncodedFragment(value: String?): UrlBuilder {
        fragment = encodedOptional(value, UrlComponent.Fragment)
        return this
    }

    /**
     * Validates and snapshots the current components as an immutable Url.
     */
    public fun build(): Url {
        @Unsafe {
            val result = urlEmpty()
            checkUriCode(result.code, UrlComponent.Reference)
            val handle = result.value!!
            try {
                if (scheme != None) setNativeUrlPart(handle, 0, scheme, UrlComponent.Scheme)
                if (host != None) setNativeUrlPart(handle, 2, host, UrlComponent.Host)
                if (userInfo != None) setNativeUrlPart(handle, 1, userInfo, UrlComponent.UserInfo)
                if (port != None) setNativeUrlPart(handle, 3, Some(port!!.toString()), UrlComponent.Port)
                setNativeUrlPart(handle, 4, Some(path), UrlComponent.Path)
                if (query != None) setNativeUrlPart(handle, 5, query, UrlComponent.Query)
                if (fragment != None) setNativeUrlPart(handle, 6, fragment, UrlComponent.Fragment)
                return snapshotUrl(handle, reusable)
            } finally { urlFree(handle) }
        }
    }

    private fun copyAuthority(value: UrlAuthority) {
        host = Some(if (value.hostKind == 2 || value.hostKind == 3) "[" + value.encodedHost + "]" else value.encodedHost)
        userInfo = value.encodedUserInfo
        port = value.port
        reusable.add(value)
    }

    internal companion object {
        internal fun from(value: Url): UrlBuilder {
            val builder = UrlBuilder()
            builder.scheme = value.scheme
            builder.path = value.encodedPath
            builder.query = value.encodedQuery
            builder.fragment = value.encodedFragment
            if (value.authority != None) builder.copyAuthority(value.authority!!)
            return builder
        }
    }
}

private fun encodedOptional(value: String?, component: UrlComponent): String? =
    if (value == None) None else Some(canonicalEncoded(value!!, component))
