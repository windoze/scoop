package scoop.url

import scoop.collections.emptyList

/**
 * An immutable URI/IRI reference. Parsing accepts relative references and non-HTTP schemes without
 * network I/O. Equality and ordering use normalized ASCII serialization; parsing follows a strict
 * profile without browser-style recovery.
 */
public class Url internal constructor(
    /**
     * The normalized scheme, or None for a relative reference.
     */
    public val scheme: String?,
        /**
         * The parsed authority when the reference contains one.
         */
        public val authority: UrlAuthority?,
    /**
     * The percent-encoded path, retaining reserved characters as structural data.
     */
    public val encodedPath: String,
        /**
         * The encoded query without the leading question mark; None differs from an empty query.
         */
        public val encodedQuery: String?,
        /**
         * The encoded fragment without the leading hash; None differs from an empty fragment.
         */
        public val encodedFragment: String?,
    private val serialized: String
) : Equals<Url>, Compare<Url>, Hash, ToString {
    /**
     * Returns the normalized ASCII URI serialization.
     */
    public override fun toString(): String = serialized
    /**
     * Compares normalized ASCII serializations.
     */
    public override operator fun equals(other: Url): Boolean = serialized == other.serialized
    /**
     * Orders normalized ASCII serializations lexicographically.
     */
    public override operator fun compareTo(other: Url): Long = serialized.compareTo(other.serialized)
    /**
     * Hashes the same normalized serialization used by equality.
     */
    public override fun hash(): Long = serialized.hash()

    /**
     * Resolves a relative reference against this URL using URI reference-resolution rules.
     */
    public fun resolve(reference: String): Url = resolve(Url.parse(reference))
    /**
     * Resolves a relative reference against this URL using URI reference-resolution rules.
     */
    public fun resolve(reference: Url): Url = resolveNativeUrl(this, reference)
    /**
     * Creates a mutable component builder initialized from this immutable URL.
     */
    public fun toBuilder(): UrlBuilder = UrlBuilder.from(this)

    /**
     * Validates an HTTP or HTTPS network target and computes its normalized host and effective
     * port. Invalid DNS names, compatibility numeric addresses, port zero, and IPvFuture are
     * rejected.
     */
    public fun httpOrigin(): UrlOrigin {
        if (!isNetworkScheme(scheme)) urlError(UrlComponent.Scheme, "HTTP target requires http, https, ws or wss")
        if (authority == None) urlError(UrlComponent.Authority, "HTTP target requires an authority")
        val value = authority!!
        val port = if (value.port == None) defaultUrlPort(scheme!!) else value.port!!
        if (port == 0) urlError(UrlComponent.Port, "HTTP target port cannot be zero")
        return UrlOrigin(scheme!!, value.networkHost(), port)
    }

    /**
     * Returns origin-form path and query, excluding user information and fragment.
     */
    public fun httpRequestTarget(): String {
        httpOrigin()
        return (if (encodedPath.length == 0L) "/" else encodedPath) +
            (if (encodedQuery == None) "" else "?" + encodedQuery!!)
    }

    /**
     * Returns the absolute HTTP request target for a proxy, excluding user information and
     * fragment.
     */
    public fun httpAbsoluteTarget(): String {
        val target = httpRequestTarget()
        return scheme!! + "://" + authority!!.render(false, false) + target
    }

    /**
     * Parses the encoded query as ordered parameters, with ordinary URI plus semantics.
     */
    public fun queryParameters(): UrlQuery = UrlQuery.parse(if (encodedQuery == None) "" else encodedQuery!!)

    /**
     * Returns a display-oriented IRI, retaining escapes for reserved characters such as encoded
     * slashes.
     */
    public fun toIriString(): String {
        val output = StringBuilder()
        if (scheme != None) output.append(scheme!!).append(":")
        if (authority != None) output.append("//").append(authority!!.render(true, true))
        output.append(iriDisplay(encodedPath))
        if (encodedQuery != None) output.append("?").append(iriDisplay(encodedQuery!!, true))
        if (encodedFragment != None) output.append("#").append(iriDisplay(encodedFragment!!))
        return output.toString()
    }

    /**
     * Removes user information and masks values of the specified query names for presentation.
     */
    public fun redacted(queryNames: List<String> = emptyList<String>()): String {
        val builder = toBuilder().setEncodedUserInfo(None)
        if (encodedQuery != None && queryNames.size > 0L) {
            val entries = ArrayList<UrlQueryParameter>()
            for (entry in queryParameters().entries) {
                var hide = false
                for (name in queryNames) { if (urlBytesEqual(entry.nameBytes, name.toByteArray())) hide = true }
                entries.add(if (hide && hasUrlValue(entry.valueBytes))
                    UrlQueryParameter(entry.nameBytes, Some<List<Byte>>("[redacted]".toByteArray())) else entry)
            }
            builder.setEncodedQuery(Some(UrlQuery(entries).toString()))
        }
        return builder.build().toString()
    }

    /**
     * Strict URI/IRI parsing and parser-backend version information.
     */
    public companion object : ValueEncoder<Url>, ValueDecoder<Url> {
        /** Encodes the existing normalized ASCII URI, preserving all of its components. */
        public override fun encode(value: Url, encoder: Encoder) {
            encoder.singleValue().writeString(value.toString())
        }

        /** Decodes a URI reference without imposing network or scheme-specific restrictions. */
        public override fun decode(decoder: Decoder): Url =
            when (parseOrNone(decoder.singleValue().readString())) {
                case Some(value) -> value
                case None -> throw DecodingException(decoder.path, "invalid URL")
            }

        /**
         * Parses a complete URI/IRI reference. Relative input stays relative; no scheme is
         * guessed.
         */
        public fun parse(text: String): Url = parseNativeUrl(prepareIri(text))
        /**
         * Returns None only for an ordinary URL format failure. Backend failures still propagate.
         */
        public fun parseOrNone(text: String): Url? {
            try { return Some(parse(text)) }
            catch (_: UrlParseException) { return None }
        }
        /**
         * The version reported by the linked URI parser backend.
         */
        public val backendVersion: String get() { @Unsafe { return String.fromCString(urlVersion()) } }
    }
}
