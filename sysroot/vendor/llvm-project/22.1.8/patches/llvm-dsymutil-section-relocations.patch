+++ b/llvm/test/tools/dsymutil/X86/section-relative-address.test
@@ -0,0 +1,91 @@
+# RUN: rm -rf %t && split-file %s %t
+# RUN: llvm-mc -triple x86_64-apple-macosx -filetype=obj %t/input.s -o %t/input.o
+# RUN: dsymutil -y %t/map.yaml --oso-prepend-path %t -f -o %t/output
+# RUN: llvm-dwarfdump --debug-info %t/output | FileCheck %s
+
+# A section's end alias and the following TLS descriptor have the same object
+# address. The local relocation names the descriptor's section, not that alias.
+# Keep the first (zero-indexed) section's code mapping as well.
+# CHECK: DW_AT_low_pc (0x0000000100000100)
+# CHECK: DW_AT_name ("threadCounter")
+# CHECK: DW_AT_location (DW_OP_const8u 0x100002000, DW_OP_form_tls_address)
+
+#--- map.yaml
+---
+triple: x86_64-apple-darwin
+objects:
+  - filename: input.o
+    symbols:
+      - { sym: _function, objAddr: 0x0, binAddr: 0x100000100, size: 0x1 }
+      - { sym: _tls, objAddr: 0x9, binAddr: 0x100002000, size: 0x18 }
+      - { sym: _before_end, objAddr: 0x9, binAddr: 0x100003008, size: 0x0 }
+...
+
+#--- input.s
+.text
+.globl _function
+_function:
+  retq
+
+.section __DATA,__before
+  .quad 0
+.globl _before_end
+_before_end:
+
+.section __DATA,__thread_vars,thread_local_variables
+.globl _tls
+_tls:
+  .quad 0, 0, 0
+
+.section __DWARF,__debug_abbrev,regular,debug
+  .uleb128 1
+  .uleb128 0x11
+  .byte 1
+  .uleb128 3
+  .uleb128 8
+  .uleb128 0x11
+  .uleb128 1
+  .uleb128 0x12
+  .uleb128 6
+  .byte 0, 0
+  .uleb128 2
+  .uleb128 0x34
+  .byte 0
+  .uleb128 3
+  .uleb128 8
+  .uleb128 2
+  .uleb128 0x18
+  .byte 0, 0
+  .uleb128 3
+  .uleb128 0x2e
+  .byte 0
+  .uleb128 3
+  .uleb128 8
+  .uleb128 0x11
+  .uleb128 1
+  .uleb128 0x12
+  .uleb128 6
+  .byte 0, 0, 0
+
+.section __DWARF,__debug_info,regular,debug
+  .long Lend-Lbegin
+Lbegin:
+  .short 4
+  .long 0
+  .byte 8
+  .uleb128 1
+  .asciz "section.c"
+  .quad _function
+  .long 1
+  .uleb128 3
+  .asciz "function"
+  .quad _function
+  .long 1
+  .uleb128 2
+  .asciz "threadCounter"
+  .uleb128 10
+  .byte 0x0e
+  .quad _tls
+  .byte 0x9b
+  .byte 0
+Lend:
