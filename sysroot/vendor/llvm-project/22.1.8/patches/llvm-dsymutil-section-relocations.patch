 /// \returns whether there are any valid relocations in the debug info.
 bool DwarfLinkerForBinary::AddressManager::findValidRelocsInDebugSections(
     const object::ObjectFile &Obj, const DebugMapObject &DMO) {
+  // Index the section as well as the address once for this object's local
+  // relocations. Symbol-based relocations continue to use the debug map name.
+  if (const auto *MachOObj = dyn_cast<object::MachOObjectFile>(&Obj)) {
+    for (const object::SymbolRef &Symbol : Obj.symbols()) {
+      auto SymbolSection = Symbol.getSection();
+      if (!SymbolSection) {
+        consumeError(SymbolSection.takeError());
+        continue;
+      }
+      if (*SymbolSection == Obj.section_end())
+        continue;
+      unsigned SectionID = MachOObj->getSectionID(**SymbolSection);
+      auto Name = Symbol.getName();
+      if (!Name) {
+        consumeError(Name.takeError());
+        continue;
+      }
+      const auto *Mapping = DMO.lookupSymbol(*Name);
+      if (Mapping && Mapping->getValue().ObjectAddress)
+        SectionAddressToMapping.try_emplace(
+            std::make_pair(SectionID, *Mapping->getValue().ObjectAddress),
+            Mapping);
+    }
+  }
