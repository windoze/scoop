--- /dev/null
+++ b/llvm/test/DebugInfo/Generic/landingpad-phi-debug-value.ll
@@ -0,0 +1,49 @@
+; REQUIRES: aarch64-registered-target, x86-registered-target
+; RUN: llc -mtriple=aarch64-apple-darwin -O0 -global-isel=false -fast-isel=false -stop-after=phi-node-elimination %s -o - | FileCheck %s
+; RUN: llc -mtriple=x86_64-apple-darwin -O0 -global-isel=false -fast-isel=false -stop-after=phi-node-elimination %s -o - | FileCheck %s
+;
+; Exception dispatch must enter before the PHI copies. Leading debug values
+; must not move the copies before the landing-pad label.
+; CHECK-LABEL: bb.3.catch (landing-pad):
+; CHECK: EH_LABEL
+; CHECK-NEXT: [[VALUE:%[0-9]+]]:{{[a-z0-9]+}} = COPY
+; CHECK-NEXT: DBG_VALUE [[VALUE]],
+
+target triple = "aarch64-apple-darwin"
+
+declare void @thrower()
+declare i32 @__gxx_personality_v0(...)
+declare ptr @__cxa_begin_catch(ptr)
+declare void @__cxa_end_catch()
+
+define i64 @eh(i1 %choice) personality ptr @__gxx_personality_v0 !dbg !4 {
+entry:
+  br i1 %choice, label %left, label %right
+left:
+  invoke void @thrower() to label %done unwind label %catch, !dbg !9
+right:
+  invoke void @thrower() to label %done unwind label %catch, !dbg !9
+catch:
+  %value = phi i64 [7, %left], [19, %right]
+  #dbg_value(i64 %value, !8, !DIExpression(), !9)
+  %exception = landingpad {ptr, i32} catch ptr null
+  %pointer = extractvalue {ptr, i32} %exception, 0
+  call ptr @__cxa_begin_catch(ptr %pointer)
+  call void @__cxa_end_catch()
+  ret i64 %value
+done:
+  ret i64 0
+}
+
+!llvm.dbg.cu = !{!0}
+!llvm.module.flags = !{!2, !3}
+!0 = distinct !DICompileUnit(language: DW_LANG_C_plus_plus, file: !1, producer: "test", isOptimized: false, runtimeVersion: 0, emissionKind: FullDebug)
+!1 = !DIFile(filename: "eh.cpp", directory: ".")
+!2 = !{i32 2, !"Dwarf Version", i32 4}
+!3 = !{i32 2, !"Debug Info Version", i32 3}
+!4 = distinct !DISubprogram(name: "eh", scope: !1, file: !1, line: 1, type: !5, scopeLine: 1, spFlags: DISPFlagDefinition, unit: !0)
+!5 = !DISubroutineType(types: !6)
+!6 = !{!7}
+!7 = !DIBasicType(name: "long", size: 64, encoding: DW_ATE_signed)
+!8 = !DILocalVariable(name: "value", scope: !4, file: !1, line: 1, type: !7)
+!9 = !DILocation(line: 1, scope: !4)
