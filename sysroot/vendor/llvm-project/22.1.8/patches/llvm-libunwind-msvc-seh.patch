--- a/libunwind/CMakeLists.txt
+++ b/libunwind/CMakeLists.txt
@@ -24,7 +24,9 @@
 include(GNUInstallDirs)
 include(CheckSymbolExists)
 
-if (MSVC)
+option(LIBUNWIND_ENABLE_MSVC_SEH "Build static Level-I SEH support for MSVC targets" OFF)
+
+if (MSVC AND NOT LIBUNWIND_ENABLE_MSVC_SEH)
   message(FATAL_ERROR "Libunwind doesn't build for MSVC targets, and that is almost certainly not what you want to do "
                       "anyway since libunwind is tied to the Itanium C++ ABI, and MSVC targets must use the MS C++ ABI.")
 endif()
@@ -97,6 +99,16 @@
   message(FATAL_ERROR "libunwind must be built as either a shared or static library.")
 endif()
 
+# Scoop uses Level-I SEH without using this library as a C++ ABI provider.
+if (LIBUNWIND_ENABLE_MSVC_SEH)
+  if (NOT MSVC OR NOT CMAKE_CXX_COMPILER_ID STREQUAL "Clang" OR
+      NOT CMAKE_SYSTEM_PROCESSOR MATCHES "^(AMD64|amd64|x86_64)$" OR
+      LIBUNWIND_ENABLE_SHARED OR NOT LIBUNWIND_ENABLE_STATIC)
+    message(FATAL_ERROR "MSVC Level-I SEH requires Clang x64 and a static-only build")
+  endif()
+  add_compile_definitions(__SEH__)
+endif()
+
 if (LIBUNWIND_ENABLE_CET AND MSVC)
   message(FATAL_ERROR "libunwind CET support is not available for MSVC!")
 endif()
@@ -253,6 +265,11 @@
 add_cxx_compile_flags_if_supported(-fno-exceptions)
 add_cxx_compile_flags_if_supported(-fno-rtti)
 
+if (LIBUNWIND_ENABLE_MSVC_SEH)
+  list(APPEND LIBUNWIND_COMPILE_FLAGS /clang:-funwind-tables)
+  list(APPEND LIBUNWIND_CXX_FLAGS /clang:-fno-exceptions /GR-)
+endif()
+
 # Ensure that we don't depend on C++ standard library.
 if (CXX_SUPPORTS_NOSTDINCXX_FLAG)
   list(APPEND LIBUNWIND_COMPILE_FLAGS -nostdinc++)
--- a/libunwind/src/CMakeLists.txt
+++ b/libunwind/src/CMakeLists.txt
@@ -26,6 +26,10 @@
                               # `nounwind`, which breaks LTO builds of
                               # libunwind.  See #56825 and #120657 for context.
                               COMPILE_FLAGS "-std=c99 -fexceptions")
+if (LIBUNWIND_ENABLE_MSVC_SEH)
+  set_source_files_properties(${LIBUNWIND_C_SOURCES} PROPERTIES
+    COMPILE_FLAGS "/clang:-std=c99 /clang:-fexceptions")
+endif()
 
 set(LIBUNWIND_ASM_SOURCES
     UnwindRegistersRestore.S
@@ -127,7 +131,7 @@
 # Build the shared library.
 add_library(unwind_shared_objects OBJECT EXCLUDE_FROM_ALL ${LIBUNWIND_SOURCES} ${LIBUNWIND_HEADERS})
 cxx_add_warning_flags(unwind_shared_objects ${LIBUNWIND_ENABLE_WERROR} ${LIBUNWIND_ENABLE_PEDANTIC})
-if(CMAKE_C_COMPILER_ID STREQUAL MSVC)
+if(CMAKE_C_COMPILER_ID STREQUAL MSVC OR LIBUNWIND_ENABLE_MSVC_SEH)
   target_compile_options(unwind_shared_objects PRIVATE /GR-)
 else()
   target_compile_options(unwind_shared_objects PRIVATE -fno-rtti)
@@ -162,7 +166,7 @@
 # Build the static library.
 add_library(unwind_static_objects OBJECT EXCLUDE_FROM_ALL ${LIBUNWIND_SOURCES} ${LIBUNWIND_HEADERS})
 cxx_add_warning_flags(unwind_static_objects ${LIBUNWIND_ENABLE_WERROR} ${LIBUNWIND_ENABLE_PEDANTIC})
-if(CMAKE_C_COMPILER_ID STREQUAL MSVC)
+if(CMAKE_C_COMPILER_ID STREQUAL MSVC OR LIBUNWIND_ENABLE_MSVC_SEH)
   target_compile_options(unwind_static_objects PRIVATE /GR-)
 else()
   target_compile_options(unwind_static_objects PRIVATE -fno-rtti)
