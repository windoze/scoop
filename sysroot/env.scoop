// Scoop sysroot: env surface（std v2，early stage）
//
// 说明：
// - 该模块提供标准库 `scoop.env` 的最小可执行表面（T1318a）。
// - 当前阶段只要求 host 平台可用：由 LLVM codegen 直接映射到 runtime C 符号（`scoop_env_get`）。
// - 返回值采用 `String?`（即 `Option<String>`）：`None` 表示不存在或读取失败。

package scoop.env

import scoop.core.*

/// 读取环境变量（不存在则返回 `None`）。
///
/// 说明：命名为 `getOrNull` 以避免与集合 `get`（例如 `Array.get(index)`）在 star import 下冲突。
fun getOrNull(key: String): String?
