+static addr_t GetStaticTLSAddress(Process &process, const ModuleSP &module,
+                                  Thread &thread, addr_t offset) {
+  Target &target = process.GetTarget();
+  const llvm::Triple &triple = target.GetArchitecture().GetTriple();
+  if (triple.getOS() != llvm::Triple::Linux ||
+      triple.getArch() != llvm::Triple::x86_64 ||
+      module != target.GetExecutableModule())
+    return LLDB_INVALID_ADDRESS;
+  auto *object = llvm::dyn_cast_or_null<ObjectFileELF>(module->GetObjectFile());
+  if (!object)
+    return LLDB_INVALID_ADDRESS;
+
+  const elf::ELFProgramHeader *tls = nullptr;
+  for (const auto &header : object->ProgramHeaders()) {
+    if (header.p_type == llvm::ELF::PT_INTERP)
+      return LLDB_INVALID_ADDRESS;
+    if (header.p_type == llvm::ELF::PT_TLS)
+      tls = &header;
+  }
+  if (!tls || offset >= tls->p_memsz)
+    return LLDB_INVALID_ADDRESS;
+
+  // AMD64 variant II places the executable's static TLS below the thread
+  // pointer, preserving the image's offset within its alignment boundary.
+  uint64_t alignment = std::max<uint64_t>(tls->p_align, 1);
+  if (!llvm::isPowerOf2_64(alignment))
+    return LLDB_INVALID_ADDRESS;
+  uint64_t padding = (-tls->p_vaddr - tls->p_memsz) & (alignment - 1);
+  uint64_t size = tls->p_memsz + padding;
+  addr_t tp = thread.GetThreadPointer();
+  if (size < tls->p_memsz || tp == LLDB_INVALID_ADDRESS || tp < size)
+    return LLDB_INVALID_ADDRESS;
+  return tp - size + offset;
+}
