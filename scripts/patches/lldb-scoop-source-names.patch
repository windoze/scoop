+addr_t TargetThreadWindows::GetThreadLocalData(const ModuleSP module,
+                                               addr_t tls_file_addr) {
+  auto process = GetProcess();
+  if (!module || module->GetArchitecture().GetMachine() != llvm::Triple::x86_64)
+    return LLDB_INVALID_ADDRESS;
+  ObjectFile *object = module->GetObjectFile();
+  if (!object)
+    return LLDB_INVALID_ADDRESS;
+  Address base = object->GetBaseAddress();
+  addr_t image = base.GetLoadAddress(&process->GetTarget());
+  if (image == LLDB_INVALID_ADDRESS)
+    return LLDB_INVALID_ADDRESS;
+
+  Status error;
+  auto read = [&](addr_t address, auto &value) {
+    return process->ReadMemory(address, &value, sizeof(value), error) ==
+           sizeof(value);
+  };
+  IMAGE_DOS_HEADER dos;
+  IMAGE_NT_HEADERS64 nt;
+  if (!read(image, dos) || dos.e_magic != IMAGE_DOS_SIGNATURE ||
+      dos.e_lfanew < 0 || !read(image + dos.e_lfanew, nt) ||
+      nt.Signature != IMAGE_NT_SIGNATURE ||
+      nt.OptionalHeader.Magic != IMAGE_NT_OPTIONAL_HDR64_MAGIC ||
+      nt.OptionalHeader.NumberOfRvaAndSizes <= IMAGE_DIRECTORY_ENTRY_TLS)
+    return LLDB_INVALID_ADDRESS;
+  auto directory = nt.OptionalHeader.DataDirectory[IMAGE_DIRECTORY_ENTRY_TLS];
+  IMAGE_TLS_DIRECTORY64 tls;
+  if (!directory.VirtualAddress || directory.Size < sizeof(tls) ||
+      !read(image + directory.VirtualAddress, tls))
+    return LLDB_INVALID_ADDRESS;
+
+  using QueryThread = decltype(&::NtQueryInformationThread);
+  static auto query_thread = reinterpret_cast<QueryThread>(::GetProcAddress(
+      ::GetModuleHandleW(L"ntdll.dll"), "NtQueryInformationThread"));
+  if (!query_thread)
+    return LLDB_INVALID_ADDRESS;
+  struct ThreadBasicInfo {
+    NTSTATUS exit_status;
+    PVOID teb;
+    CLIENT_ID client_id;
+    ULONG_PTR affinity;
+    LONG priority;
+    LONG base_priority;
+  } info = {};
+  if (query_thread(m_host_thread.GetNativeThread().GetSystemHandle(),
+                   ThreadBasicInformation, &info, sizeof(info), nullptr) < 0)
+    return LLDB_INVALID_ADDRESS;
+
+  DWORD index;
+  uint64_t vector, storage;
+  addr_t teb = reinterpret_cast<uintptr_t>(info.teb);
+  if (!read(tls.AddressOfIndex, index) ||
+      !read(teb + offsetof(TEB64, ThreadLocalStoragePointer), vector) ||
+      !vector || !read(vector + uint64_t(index) * sizeof(uint64_t), storage) ||
+      !storage)
+    return LLDB_INVALID_ADDRESS;
+  // PDB expressions carry file addresses; the loaded TLS directory is
+  // relocated.
+  addr_t start = base.GetFileAddress() + (tls.StartAddressOfRawData - image);
+  if (tls_file_addr < start)
+    return LLDB_INVALID_ADDRESS;
+  return storage + (tls_file_addr - start);
+}
