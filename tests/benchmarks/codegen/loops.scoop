@NoGC @Unsafe
fun fill(data: Ptr<Long>, count: Long) {
    var i = 0L
    while (i < count) { data.store(i, 0L); i += 1L }
}
@NoGC @Unsafe
fun prefix(data: Ptr<Long>, count: Long) {
    var i = 1L
    while (i < count) { data.store(i, data.load(i - 1L) + i); i += 1L }
}
@NoGC @Unsafe
fun small(data: Ptr<Long>, count: Long) {
    var i = 0L
    while (i < count) {
        var k = 0L
        var x = data.load(i)
        while (k < 4L) { x = x.xor(x.shl(5L)) + k; k += 1L }
        data.store(i, x)
        i += 1L
    }
}
@NoGC @Unsafe
fun branch(data: Ptr<Long>, count: Long, flag: Boolean) {
    var i = 0L
    while (i < count) {
        val x = data.load(i)
        var y = x
        if (flag) { y = x * 3L + 7L } else { y = x.xor(x.shr(7L)) }
        if (y < 0L) { y = -y }
        if (y >= 0L) { data.store(i, y) } else { data.store(i, 0L) }
        i += 1L
    }
}
@Unsafe
fun main(args: Array<String>) {
    val values = MutableArray<Long>(8192L) { _ -> 0L }
    values.withDataPointer<Long, Unit>() { data: Ptr<Long>, count: Long ->
        @Unsafe {
            var round = 0L
            if (args[1L] == "fill") {
                while (round < 4096L) { fill(data, count); round += 1L }
            } else if (args[1L] == "prefix") {
                while (round < 4096L) { prefix(data, count); round += 1L }
            } else if (args[1L] == "small") {
                while (round < 4096L) { small(data, count); round += 1L }
            } else {
                while (round < 4096L) { branch(data, count, round.and(1L) == 0L); round += 1L }
            }
        }
    }
    println(values[8191L])
}
