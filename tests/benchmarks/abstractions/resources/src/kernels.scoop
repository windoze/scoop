package dev.performance.resources

class Lease(var value: Long) : Disposable {
    public override fun dispose() { value += 1L }
}

fun usingLease(count: Long): Long {
    val lease = Lease(7L)
    var i = 0L
    var result = 0L
    while (i < count) {
        val input = i
        result = result.xor(lease.use { current -> current.value.xor(input) })
        i += 1L
    }
    return result.xor(lease.value)
}

fun directLease(count: Long): Long {
    val lease = Lease(7L)
    var i = 0L
    var result = 0L
    while (i < count) {
        val input = i
        val value = lease.value.xor(input)
        lease.dispose()
        result = result.xor(value)
        i += 1L
    }
    return result.xor(lease.value)
}
