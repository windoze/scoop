@Extern(lib = "m34_interfaces", name = "bench_kind") fun benchKind(): Int
@Extern(lib = "m34_interfaces", name = "bench_count") fun benchCount(): Int
@Extern(lib = "m34_interfaces", name = "bench_begin") fun benchBegin(): Unit
@Extern(lib = "m34_interfaces", name = "bench_end") fun benchEnd(): Unit

fun sum(values: Array<Long>): Long {
    val count = values.size
    var i = 0L
    var result = 0L
    while (i < count) { result += values[i]; i += 1L }
    return result
}

fun transform(values: MutableArray<Int>, seed: Int) {
    var i = 0L
    while (i < values.size) { values[i] = values[i] * 3 + seed; i += 1L }
}

fun copy(source: MutableArray<Int>, target: MutableArray<Int>, count: Long) {
    var i = 0L
    while (i < count) { target[i] = source[i]; i += 1L }
}

@NoGC fun control(count: Long): Long {
    var i = 0L
    var state = 7L
    while (i < count) {
        state = state.xor(state.shl(13L)).and(4294967295L)
        state = state.xor(state.shr(17L))
        state = state.xor(state.shl(5L)).and(4294967295L)
        i += 1L
    }
    return state
}

@Unsafe fun exercise(count: Long, mode: Int): Long {
    val longs = Array<Long>(count) { i -> i * 1664525L + 7L }
    val source = MutableArray<Int>(count) { i -> i.toInt() * 1664525 + 7 }
    val target = MutableArray<Int>(count) { _ -> -1 }
    val rounds = if (count < 256L) 100000L else 128L
    var round = 0L
    var result = 0L
    benchBegin()
    while (round < rounds) {
        if (mode == 0) result += sum(longs)
        else if (mode == 1) transform(source, round.toInt())
        else if (mode == 2) copy(source, target, count)
        else copy(source, source, count)
        round += 1L
    }
    benchEnd()
    return result + source[0L].toLong() + source[count - 1L].toLong() + target[count - 1L].toLong()
}

@Unsafe fun reduction(count: Long): Long {
    val values = Array<Long>(count) { i -> i * 1664525L + 7L }
    val rounds = if (count < 256L) 100000L else 128L
    var round = 0L
    var result = 0L
    benchBegin()
    while (round < rounds) { result += sum(values); round += 1L }
    benchEnd()
    return result
}

@Unsafe fun main() {
    val count = benchCount().toLong()
    val mode = benchKind()
    if (mode == 4) {
        benchBegin()
        val result = control(count * 128L)
        benchEnd()
        println(result)
    } else if (mode == 5) println(reduction(count))
    else println(exercise(count, mode))
}
