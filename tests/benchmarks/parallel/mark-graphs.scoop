@Extern(lib = "m34_mark", name = "m34_mark_kind") fun graphKind(): Int
@Extern(lib = "m34_mark", name = "m34_mark_count") fun graphCount(): Long
@Extern(lib = "m34_mark", name = "m34_mark_rounds") fun graphRounds(): Int
@Extern(lib = "m34_mark", name = "m34_mark_begin") fun beginMark(): Unit
@Extern(lib = "m34_mark", name = "m34_mark_end") fun endMark(round: Int): Unit
@GCLeaf @Extern(lib = "m34_mark", name = "m34_minor_count") fun minorCount(): Long

class Node(val value: Long, var left: Node?, var right: Node?)

class SparseLeaf(val value: Long)
class SparseNode(val leaf: SparseLeaf, var next: SparseNode?)

@Unsafe fun sparseGraph(count: Long): MutableArray<SparseNode> {
    val all = MutableArray<SparseNode>(count) { index ->
        SparseNode(SparseLeaf(index), None)
    }
    gcCollect()
    val kept = MutableArray<SparseNode>(count / 16L) { index -> all[index * 16L] }
    var index = 0L
    while (index < kept.size) {
        kept[index].next = Some(kept[(index + 1L) % kept.size])
        index += 1L
    }
    return kept
}

@Unsafe fun compactRound(count: Long, round: Int): Long {
    val kept = sparseGraph(count)
    beginMark()
    gcCollect()
    endMark(round)
    var result = 0L
    var index = 0L
    while (index < kept.size) {
        val current = kept[index]
        if (current.next!! !== kept[(index + 1L) % kept.size]) {
            throw IllegalStateException()
        }
        if (current.leaf.value != index * 16L) { throw IllegalStateException() }
        result += current.leaf.value
        index += 1L
    }
    return result
}

@Unsafe fun compact(count: Long): Long {
    var result = 0L
    var round = 0
    while (round < graphRounds()) {
        result += compactRound(count, round)
        round += 1
    }
    return result
}

@Unsafe fun churnUntilMinor(previous: Long) {
    var index = 0L
    var checksum = 0L
    while (minorCount() == previous) {
        val end = index + 1024L
        while (index < end) {
            checksum += SparseLeaf(index).value
            index += 1L
        }
    }
    if (checksum != index * (index - 1L) / 2L) { throw IllegalStateException() }
}

@Unsafe fun minorRound(count: Long, round: Int): Long {
    val old = MutableArray<SparseNode?>(count) { _ -> None }
    gcCollect()
    val previous = minorCount()
    var index = 0L
    while (index < count) {
        old[index] = Some(SparseNode(SparseLeaf(index), None))
        index += 1L
    }
    index = 0L
    while (index < count) {
        old[index]!!.next = old[(index + count - 1L) % count]
        index += 1L
    }
    val pinned = pin(old[0L]!!)
    if (minorCount() != previous) { throw IllegalStateException() }
    beginMark()
    churnUntilMinor(previous)
    endMark(round)
    if (minorCount() != previous + 1L || unpin(pinned) !== old[0L]!!) {
        throw IllegalStateException()
    }
    var result = 0L
    index = 0L
    while (index < count) {
        val current = old[index]!!
        if (current.next!! !== old[(index + count - 1L) % count]!! || current.leaf.value != index) {
            throw IllegalStateException()
        }
        result += current.leaf.value
        index += 1L
    }
    return result
}

@Unsafe fun minor(count: Long): Long {
    var result = 0L
    var round = 0
    while (round < graphRounds()) {
        result += minorRound(count, round)
        round += 1
    }
    return result
}

@Unsafe fun collectRounds() {
    val count = graphRounds()
    var round = 0
    while (round < count) {
        beginMark()
        gcCollect()
        endMark(round)
        round += 1
    }
}

fun makeWide(count: Long): Node {
    val nodes = MutableArray<Node>(count) { index -> Node(index, None, None) }
    var index = 0L
    while (index < count) {
        if (2L * index + 1L < count) { nodes[index].left = Some(nodes[2L * index + 1L]) }
        if (2L * index + 2L < count) { nodes[index].right = Some(nodes[2L * index + 2L]) }
        index += 1L
    }
    return nodes[0L]
}

fun sumTree(node: Node?): Long = when (node) {
    case None -> 0L
    case Some(value) -> value.value + sumTree(value.left) + sumTree(value.right)
}

@Unsafe fun wide(count: Long): Long {
    val root = makeWide(count)
    collectRounds()
    return sumTree(Some(root))
}

@Unsafe fun array(count: Long): Long {
    val shared = Node(-1L, None, None)
    shared.left = Some(shared)
    val values = MutableArray<Node>(count) { index -> Node(index, Some(shared), Some(shared)) }
    collectRounds()
    var result = 0L
    var index = 0L
    while (index < count) {
        result += values[index].value
        if (values[index].left!!.left!! !== shared) { throw IllegalStateException() }
        index += 1L
    }
    return result
}

@Unsafe fun chain(count: Long): Long {
    var head: Node? = None
    var index = 0L
    while (index < count) {
        head = Some(Node(index, head, None))
        index += 1L
    }
    collectRounds()
    var result = 0L
    while (when (head) { case None -> false; case Some(_) -> true }) {
        result += head!!.value
        head = head!!.left
    }
    return result
}

@Unsafe fun main() {
    val count = graphCount()
    val kind = graphKind()
    val checksum = if (kind == 0) { wide(count) } else {
        if (kind == 1) { array(count) } else {
            if (kind == 2) { chain(count) } else {
                if (kind == 3) { compact(count) } else { minor(count) }
            }
        }
    }
    val expected = if (kind == 3) {
        (count / 16L) * (count / 16L - 1L) / 2L * 16L * graphRounds().toInt64()
    } else { count * (count - 1L) / 2L * (if (kind == 4) graphRounds().toInt64() else 1L) }
    if (checksum != expected) { throw IllegalStateException() }
    println(checksum)
}
