fun <T> identity(value: T): T = value

fun main() {
    var round = 0L
    var total = 0L
    while (round < 300L) {
        val values = ArrayList<String>()
        var index = 0L
        while (index < 128L) {
            values.add(identity("value-" + index.toString()))
            index = index + 1L
        }
        for (value in values) { total = total + value.length }
        round = round + 1L
    }
    println(total)
}
