package dev.m34.runner

import dev.m34.bench.*

@GCLeaf @Extern(lib = "m34_interfaces", name = "bench_kind") fun kind(): Int
@GCLeaf @Extern(lib = "m34_interfaces", name = "bench_count") fun count(): Int
@GCLeaf @Extern(lib = "m34_interfaces", name = "bench_begin") fun begin()
@GCLeaf @Extern(lib = "m34_interfaces", name = "bench_end") fun end()

fun main() {
    @Unsafe {
        val selected = kind()
        val iterations = count()
        val cell = Cell(17U)
        val reader: Reader = cell
        val child = ChildCell(17U)
        val projection = ProjectionCell(17U)
        begin()
        val value = when (selected) {
            case 0 -> known(cell, iterations)
            case 1 -> unknown(reader, iterations)
            case 2 -> convertedOnce(cell, iterations)
            case 4 -> repeatedParent(child, iterations)
            case 5 -> smartParent(child, iterations)
            case 6 -> smartChild(child, iterations)
            case 7 -> repeatedSecondary(projection, iterations)
            case 8 -> repeatedDiamond(projection, iterations)
            else -> convertedEach(cell, iterations)
        }
        end()
        println(value)
    }
}
