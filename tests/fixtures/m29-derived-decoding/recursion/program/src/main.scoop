import scoop.json.Json

private fun check(value: Boolean, code: Int) {
    if (!value) {
        println(f"recursive decode assertion ${code}")
        throw IllegalStateException(Some(f"recursive decode assertion ${code}"))
    }
}

public class Node public constructor(public val value: Int, public val next: Option<Node>)
public class NodeDecoder(private val element: ValueDecoder<Int>) : ValueDecoder<Node>
private class Offset(private val amount: Int) : ValueDecoder<Int> {
    public override fun decode(decoder: Decoder): Int = Int.Companion.decode(decoder) + amount
}

public enum Tree {
    Leaf,
    Branch(val node: TreeNode)
    public companion object : ValueDecoder<Tree>
}
public class TreeNode public constructor(public val child: Tree) {
    public companion object : ValueDecoder<TreeNode>
}

fun main() {
    val text = "{\"value\":1,\"next\":{\"value\":2,\"next\":{\"value\":3,\"next\":null}}}"
    val codec = NodeDecoder(Offset(10))
    val root = Json.decodeFromString(text, codec)
    check(root.value == 11 && root.next!!.value == 12 && root.next!!.next!!.value == 13, 1)
    check(when (root.next!!.next!!.next) { case None -> true; case Some(value) -> false }, 2)
    val other = Json.decodeFromString(text, NodeDecoder(Offset(100)))
    check(other.value == 101 && other.next!!.value == 102, 3)
    val again = Json.decodeFromString(text, codec)
    check(again !== root && again.next!! !== root.next!! && again.next!!.value == 12, 4)
    val tree = Json.decodeFromString("{\"Branch\":{\"node\":{\"child\":{\"Branch\":{\"node\":{\"child\":{\"Leaf\":{}}}}}}}}", Tree.Companion)
    check(when (tree) {
        case Tree.Branch(node) -> when (node.child) {
            case Tree.Branch(inner) -> when (inner.child) { case Tree.Leaf -> true; else -> false }
            else -> false
        }
        else -> false
    }, 5)
    println("recursion-ok")
}
