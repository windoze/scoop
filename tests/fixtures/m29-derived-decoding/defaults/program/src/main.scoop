import scoop.json.Json

private object Trace {
    var events: String = ""
    var initialized: Int = 0
    var constructed: Int = 0
}

private fun check(value: Boolean, code: Int) {
    if (!value) {
        println(f"default decode assertion ${code}: ${Trace.events}")
        throw IllegalStateException(Some(f"default decode assertion ${code}"))
    }
}

public struct Logged(val value: Int) {
    public companion object : Decodable<Logged> {
        public override fun decode(decoder: Decoder): Logged {
            Trace.events += decoder.path
            return Logged(Int.Companion.decode(decoder))
        }
    }
}

public fun defaultValue(value: Int, event: String): Logged {
    Trace.events += event
    return Logged(value)
}

public struct Defaults(
    val first: Logged = defaultValue(10, "A"),
    val second: Logged = defaultValue(first.value + 1, "B"),
    @Transient val ignored: Logged = defaultValue(second.value + 1, "T")
) {
    public companion object : Decodable<Defaults>
}

public struct OptionalField(val value: Option<Int>, val fallback: Option<Int> = Some(8)) {
    public companion object : Decodable<OptionalField>
}

private fun initialize(): Int { Trace.initialized += 1; return 1 }
public struct Late(val value: Int) {
    public companion object : Decodable<Late> {
        private val initialized: Int = initialize()
        public override fun decode(decoder: Decoder): Late = Late(Int.Companion.decode(decoder))
    }
}
public struct LazyDefault(val value: Late = Late(7)) {
    public companion object : Decodable<LazyDefault>
}

public class UserFailure(message: String) : Exception(Some(message))
public fun failingDefault(): Int { throw UserFailure("default") }
public struct Failing(val value: Int = failingDefault()) {
    public companion object : Decodable<Failing>
}
public class Constructed public constructor(public val value: Int) {
    init {
        Trace.constructed += 1
        if (value < 0) { throw UserFailure("constructor") }
    }
    public companion object : Decodable<Constructed>
}

private fun <T> reject(text: String, codec: Decodable<T>, path: String) {
    try { Json.decode(text, codec) }
    catch (error: DecodingException) { check(error.path == path, 90); return }
    throw IllegalStateException(Some("expected a decoding error"))
}

fun main() {
    val a = Json.decode("{\"second\":20}", Defaults.Companion)
    check(Trace.events == "/secondAT" && a.first.value == 10 && a.second.value == 20 && a.ignored.value == 21, 1)
    Trace.events = ""
    val b = Json.decode("{\"first\":30}", Defaults.Companion)
    check(Trace.events == "/firstBT" && b.second.value == 31 && b.ignored.value == 32, 2)
    Trace.events = ""
    val c = Json.decode("{\"second\":2,\"first\":1}", Defaults.Companion)
    check(Trace.events == "/first/secondT" && c.ignored.value == 3, 3)
    Trace.events = ""
    val d = Json.decode("{}", Defaults.Companion)
    check(Trace.events == "ABT" && d.ignored.value == 12, 4)
    Trace.events = ""
    reject("{\"second\":null}", Defaults.Companion, "/second")
    check(Trace.events == "/second", 5)
    val none = Json.decode("{\"value\":{\"None\":{}}}", OptionalField.Companion)
    check(none.value == None && none.fallback!! == 8, 6)
    val provided = Json.decode("{\"value\":{\"Some\":[3]},\"fallback\":{\"None\":{}}}", OptionalField.Companion)
    check(provided.value!! == 3 && provided.fallback == None, 7)
    reject("{}", OptionalField.Companion, "/value")
    reject("{\"value\":{\"None\":{}},\"fallback\":null}", OptionalField.Companion, "/fallback")
    check(Json.decode("{}", LazyDefault.Companion).value.value == 7 && Trace.initialized == 0, 8)
    check(Json.decode("{\"value\":9}", LazyDefault.Companion).value.value == 9 && Trace.initialized == 1, 9)
    check(Json.decode("{}", LazyDefault.Companion).value.value == 7 && Trace.initialized == 1, 10)
    try { Json.decode("{}", Failing.Companion); check(false, 11) }
    catch (error: UserFailure) { check(error.message == Some("default"), 12) }
    check(Json.decode("{\"value\":5}", Failing.Companion).value == 5, 13)
    check(Json.decode("{\"value\":2}", Constructed.Companion).value == 2 && Trace.constructed == 1, 14)
    reject("{}", Constructed.Companion, "/value")
    check(Trace.constructed == 1, 15)
    try { Json.decode("{\"value\":-1}", Constructed.Companion); check(false, 16) }
    catch (error: UserFailure) { check(error.message == Some("constructor") && Trace.constructed == 2, 17) }
    checkContainerEnd()
    println("defaults-ok")
}

private object Ending : Decoder, KeyedDecodingContainer {
    var fail: Boolean = false
    public override val path: String get() = ""
    public override val keys: List<String> get() = ArrayList<String>()
    public override fun keyed(): KeyedDecodingContainer = this
    public override fun unkeyed(): UnkeyedDecodingContainer { throw UserFailure("unkeyed") }
    public override fun singleValue(): SingleValueDecodingContainer { throw UserFailure("single") }
    public override fun required(name: String): Decoder { throw UserFailure("required") }
    public override fun optional(name: String): Option<Decoder> = None
    public override fun end() {
        Trace.events += "E"
        if (fail) { throw UserFailure("end") }
    }
}

private fun checkContainerEnd() {
    Trace.events = ""
    val value = Defaults.Companion.decode(Ending)
    check(Trace.events == "EABT" && value.ignored.value == 12, 20)
    Trace.events = ""
    Ending.fail = true
    try { Defaults.Companion.decode(Ending); check(false, 21) }
    catch (error: UserFailure) { check(error.message == Some("end") && Trace.events == "E", 22) }
}
