public struct Element<T>(val value: T) {
    public companion object {
        public fun decoder(element: ValueDecoder<T>): ValueDecoder<Element<T>> = ElementReader(element)
    }
}
public class ElementReader<T>(private val element: ValueDecoder<T>) : ValueDecoder<Element<T>>
public struct Item<T>(val value: Element<T>)
public class Reader<T>(private val element: ValueDecoder<T>) : ValueDecoder<Item<T>>

fun main() {}
