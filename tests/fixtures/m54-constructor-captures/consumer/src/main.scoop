import m54.captures.Callback

class Payload(val value: Int)

fun main() {
    val seed = Payload(42)
    val replacement = Payload(73)
    val callback = Callback<Payload>(seed)
    val nested = callback.nested()
    val anonymous = callback.anonymous()
    val shadow = callback.shadow(replacement)()
    gcCollect()
    if (nested() !== seed || anonymous() !== seed) throw IllegalStateException()
    if (callback.local() !== seed || callback.generic() !== seed) throw IllegalStateException()
    if (shadow() !== replacement || shadow().value != 73) throw IllegalStateException()
    val value = Callback<Int>(19)
    if (value.nested()() != 19 || value.anonymous()() != 19) throw IllegalStateException()
    if (value.local() != 19 || value.generic() != 19 || value.shadow(7)()() != 7)
        throw IllegalStateException()
    println("constructor captures preserve nested bindings and shadowing")
}
