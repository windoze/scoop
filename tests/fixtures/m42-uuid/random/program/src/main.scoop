import scoop.uuid.Uuid
import scoop.random.Random

fun check(ok: Boolean) { if (!ok) throw IllegalStateException() }
class Bytes public constructor(private val value: Int) : Random {
    public var calls: Int = 0
    public override fun nextBits(bitCount: Int): Int {
        check(bitCount == 8 && calls < 16)
        val result = if (value < 0) calls else value
        calls += 1
        return result
    }
}
class Failing : Random {
    public var calls: Int = 0
    public override fun nextBits(bitCount: Int): Int {
        calls += 1
        if (calls == 4) throw IllegalStateException()
        return 0
    }
}
fun main() {
    val zeros = Bytes(0)
    check(Uuid.random(zeros).toString() == "00000000-0000-4000-8000-000000000000" && zeros.calls == 16)
    val ones = Bytes(255)
    check(Uuid.random(ones).toString() == "ffffffff-ffff-4fff-bfff-ffffffffffff" && ones.calls == 16)
    val sequential = Bytes(-1)
    val value = Uuid.random(sequential)
    check(value.toString() == "00010203-0405-4607-8809-0a0b0c0d0e0f" && sequential.calls == 16)
    val first = Random.seeded(42L)
    val second = Random.seeded(42L)
    val generated = Uuid.random(first).toByteArray()
    val raw = second.nextBytes(16L)
    var index = 0L
    while (index < 16L) {
        val expected = if (index == 6L) (raw[index].toInt() and 15) or 64
            else if (index == 8L) (raw[index].toInt() and 63) or 128 else raw[index].toUByte().toInt()
        check(generated[index].toUByte().toInt() == expected)
        index += 1L
    }
    check(first.nextLong() == second.nextLong())
    val failing = Failing()
    var propagated = false
    try { Uuid.random(failing) } catch (error: IllegalStateException) { propagated = true }
    check(propagated && failing.calls == 4)
    println("uuid random passed")
}
