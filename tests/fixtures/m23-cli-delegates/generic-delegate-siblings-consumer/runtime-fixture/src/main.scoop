import consumer.delegateSiblings.check

@Extern(lib="m23_delegate_siblings", name="m23_delegate_siblings")
fun siblingMetadata(): Int

@Extern(lib = "m23_class_gc", name = "m23_class_gc_collected")
fun collected(): Int

fun main() {
    if (check() != 42) {
        throw IllegalStateException()
    }
    @Unsafe {
        if (siblingMetadata() != 1) { throw IllegalStateException() }
        if (collected() != 1) {
            throw IllegalStateException()
        }
    }
}
