struct Point(val x: Int, val y: Int)

enum E { Empty, One(Int) }

fun main() {
    val ps = [Point(1, 2), Point(3, 4)]
    println(ps[1].x)          // 3
    val nested = [[1, 2], [3]]
    println(nested[0][1])
    val es = [E.One(1), E.Empty]
    when (es[0]) {
        One(v) -> println(v)
        Empty -> println("empty")
    }
    val opts: Array<Int?> = [Some(1), None]
    println(opts[0] ?: 9)
    println(opts[1] ?: 8)
}
