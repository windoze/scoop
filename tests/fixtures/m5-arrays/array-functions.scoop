fun <T> firstOf(a: Array<T>): T = a[0]

fun sum(a: Array<Int>): Int {
    var total = 0
    var i = 0
    while (i < a.size) {
        total = total + a[i]
        i = i + 1
    }
    return total
}

fun main() {
    println(firstOf([10, 20]))
    println(firstOf(["a", "b"]))
    println(sum([1, 2, 3]))
}
