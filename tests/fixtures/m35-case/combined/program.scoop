struct Payload(val active: Boolean, val value: Int)

enum Reply<T> {
    Item(T),
    Empty
}

fun describe(value: Reply<Payload>): String = when (value) {
    case Item(Payload { active: true, value: number }) if (number > 9) -> "large"
    case Item(Payload { active: true, .. }) -> "small"
    case Item(Payload { active: false, .. }) -> "inactive"
    case Empty -> "empty"
}

fun main() {
    println(describe(Reply.Item(Payload(true, 12))))
    println(describe(Reply.Item(Payload(true, 2))))
    println(describe(Reply.Item(Payload(false, 12))))
    println(describe(Reply.Empty))
    val choice: Option<(Boolean, String)> = Some((true, "nested"))
    when (choice) {
        case Some((true, text)) -> println(text)
        case Some((false, _)) -> println("false")
        case None -> println("none")
    }
}
