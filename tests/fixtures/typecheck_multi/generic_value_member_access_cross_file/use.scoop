// EXPECT: pass
//
// T4010b1a1：真实 typecheck_multi 编译单元下，跨文件 generic nominal 的 ctor 字段、body property
// 与 getter-only property 都必须能晚解析，并按 receiver 实例化类型具体化结果。

package fixtures.typecheck_multi.generic_value_member_access_cross_file

fun crossFileTotal(): Int {
    val directMatches = Box(9).value == 9
    val bodyMatches = Box(9).bodyCopy == 9
    val getterMatches = Box(9).readBack == 9
    val total = Box(30).value + Box(7).bodyCopy + Box(2).readBack

    return if (directMatches && bodyMatches && getterMatches) total else 0
}
