import scoop.platform.env.*
import scoop.platform.system.*
import scoop.platform.memory.NativeByteBuffer
import scoop.platform.random.SystemRandom
import scoop.platform.time.*
import scoop.time.Duration

@Extern(name = "m45_entropy_mode") private fun entropyMode(mode: Int): Long
@Extern(name = "m45_system_callback") private fun setCallback(function: FunPtr<(Int, Ptr<Unit>) -> Int>, context: Ptr<Unit>)
@Extern(name = "m45_system_clear_callback") private fun clearCallback()
@Extern(name = "m45_sleep_gc") private fun sleepGc(function: FunPtr<(Int, Ptr<Unit>) -> Int>, context: Ptr<Unit>): Int
@Extern(name = "m45_home_mode") private fun homeMode(mode: Int)
@Extern(name = "m45_clock_failure") private fun clockFailure()

private fun check(value: Boolean) { if (!value) throw IllegalStateException(Some("platform system assertion failed")) }
private fun expectNative(block: () -> Unit) {
    try { block() } catch (error: PlatformException) { check(error.nativeError!!.code != 0); return }
    throw IllegalStateException(Some("expected native failure"))
}

private fun rawEnvironment() {
    val args = arguments()
    check(args.size == 5L)
    check(args[1L].decodeUtf8() == "" && args[2L].decodeUtf8() == "two words")
    check(args[3L] == OsString.fromByteArray(Array<Byte>(2L) { if (it == 0L) 45.toByte() else -1.toByte() }))
    check(args[4L].decodeUtf8() == "中")
    check(environmentVariable("EMPTY")!!.decodeUtf8() == "")
    check(environmentVariable("M45_ABSENT") == None)
    check(environmentVariable("PAIR")!!.decodeUtf8() == "a=b")
    val name = OsString.fromByteArray(Array<Byte>(2L) { if (it == 0L) 75.toByte() else -1.toByte() })
    val value = OsString.fromByteArray(Array<Byte>(2L) { if (it == 0L) 86.toByte() else -2.toByte() })
    check(environmentVariable(name)!! == value)
    val snapshot = environment()
    check(snapshot[name]!! == value)
    check(snapshot.size == (if (environmentVariable("SCOOP_GC_STRESS_MOVE") == None) 5L else 6L))
    val home = homeDirectory()!!.toOsString()
    check(home.toByteArray()[home.toByteArray().size - 1L] == -1.toByte())
    check(temporaryDirectory().decodeUtf8() == "/tmp")
    @Unsafe {
        homeMode(1)
        check(homeDirectory()!!.decodeUtf8() == "/test/fallback")
        homeMode(2)
        check(homeDirectory() == None)
        homeMode(3)
        expectNative { homeDirectory() }
        homeMode(0)
    }
    check(snapshot[OsString.fromString("HOME")]!! == home)
}

private fun entropyFailures() {
    @Unsafe {
        val callback = foreignCallback<(Int, Ptr<Unit>) -> Int>({ phase -> gcCollect(); 0 }, 1, ForeignCallbackMode.Reusable)
        setCallback(callback.function, callback.context)
        try {
            NativeByteBuffer.allocate(800L).use { buffer ->
                buffer.writeByte(7.toByte())
                @Unsafe {
                    val prefix = entropyMode(1)
                    expectNative { SystemRandom.fill(buffer, 600L) }
                    check(buffer.writePosition == prefix + 1L && buffer.readableBytes == prefix + 1L)
                    check(buffer.readByte() == 7.toByte())
                    for (byte in buffer.readBytes(prefix)) check(byte == 90.toByte())
                    entropyMode(0)
                    check(SystemRandom.fill(buffer) == 799L - prefix)
                }
            }
            val bytes = MutableArray<Byte>(700L) { 42.toByte() }
            val prefix = entropyMode(1)
            expectNative { SystemRandom.nextBytes(bytes, 3L, 603L) }
            var index = 0L
            while (index < bytes.size) {
                check(bytes[index] == (if (index >= 3L && index < prefix + 3L) 90.toByte() else 42.toByte()))
                index += 1L
            }
            entropyMode(0)
            check(when (foreignCallbackFailure(callback)) { case None -> true; case Some(_) -> false })
        } finally { clearCallback(); releaseForeignCallback(callback) }
    }
}

private fun clocksAndGc() {
    @Unsafe {
        clockFailure()
        expectNative { SystemClock.now() }
        val callback = foreignCallback<(Int, Ptr<Unit>) -> Int>(
            { phase ->
                if (phase == 0) sleep(Duration.milliseconds(1L)) else gcCollect()
                1
            }, 1, ForeignCallbackMode.Reusable
        )
        try {
            check(sleepGc(callback.function, callback.context) == 2)
            check(when (foreignCallbackFailure(callback)) { case None -> true; case Some(_) -> false })
        } finally { releaseForeignCallback(callback) }
    }
}

fun main() {
    rawEnvironment()
    entropyFailures()
    clocksAndGc()
    println("raw environment, partial entropy and sleep GC passed")
}
