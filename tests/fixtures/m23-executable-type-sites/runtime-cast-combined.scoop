public fun withDefault(value: Any, result: Int = value as Int): Int = result

public fun castCombined(first: Any, second: Any): String {
    val converted = withDefault(first)
    val repeated = withDefault(second)
    return first as String
}

public fun boxed(value: Int): Any = value
public fun checked(value: Any): Boolean = value is String
public fun <T> dormant(value: Any, result: T = value as T): T = result
public fun upcast(value: String): Any = value as Any
