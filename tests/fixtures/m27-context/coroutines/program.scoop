class Request(val id: Int)

context(request: Request)
fun current(): Int = request.id

fun expect(value: Boolean) {
    if (!value) { throw IllegalStateException() }
}

class Gate(val expected: Int, val synchronous: Boolean = false) {
    var waiter: Continuation<Int>? = None
    fun complete(value: Int) {
        val continuation = waiter!!
        waiter = None
        continuation.resume(value)
    }
}

class Registration(val gate: Gate) : SuspendRegistration<Int> {
    public override fun register(continuation: Continuation<Int>) {
        expect(current() == gate.expected)
        gcCollect()
        if (gate.synchronous) {
            context(Request(99)) {
                continuation.resume(37)
                expect(current() == 99)
            }
            expect(current() == gate.expected)
        } else {
            gate.waiter = Some(continuation)
        }
    }
}

class Completion(val expected: Int) : Continuation<Int> {
    var value: Int = 0
    var calls: Int = 0
    public override fun resume(value: Int) {
        gcCollect()
        expect(current() == expected)
        this.value = value
        calls = calls + 1
    }
    public override fun resumeWithException(exception: Throwable) {
        throw exception
    }
}

context(entry: Request)
suspend fun inner(gate: Gate): Int {
    expect(entry.id == 2)
    return context(Request(3)) {
        val value = suspendCoroutine(Registration(gate))
        gcCollect()
        expect(entry.id == 2)
        expect(current() == 3)
        value + current()
    }
}

context(entry: Request)
suspend fun outer(gate: Gate): Int {
    expect(entry.id == 1)
    return context(Request(2)) {
        val value = inner(gate)
        gcCollect()
        expect(entry.id == 1)
        expect(current() == 2)
        value + current()
    }
}

suspend fun bindingValue(gate: Gate): Request {
    expect(current() == 1)
    val value = suspendCoroutine(Registration(gate))
    expect(current() == 1)
    return Request(value)
}

suspend fun delayedBinding(gate: Gate): Int = context(bindingValue(gate)) {
    gcCollect()
    current()
}

context(entry: T)
suspend fun <T: ref> generic(gate: Gate): T {
    suspendCoroutine(Registration(gate))
    gcCollect()
    return entry
}

class Task(val gate: Gate) : SuspendTask<Int> {
    public override suspend fun run(): Int = outer(gate)
}

fun main() {
    context(Request(1)) {
        val gate = Gate(3)
        val done = Completion(1)
        startCoroutine(suspend { outer(gate) }, done)
        expect(done.calls == 0 && current() == 1)
        gcCollect()
        context(Request(8)) {
            gate.complete(37)
            expect(current() == 8)
        }
        expect(done.value == 42 && done.calls == 1 && current() == 1)

        val synchronous = Completion(1)
        startCoroutine(Task(Gate(3, true)), synchronous)
        expect(synchronous.value == 42 && synchronous.calls == 1 && current() == 1)

        val delayed = Gate(1)
        val bindingDone = Completion(1)
        startCoroutine(suspend { delayedBinding(delayed) }, bindingDone)
        expect(current() == 1)
        context(Request(9)) {
            delayed.complete(5)
            expect(current() == 9)
        }
        expect(bindingDone.value == 5 && bindingDone.calls == 1 && current() == 1)

        val genericGate = Gate(1)
        val genericDone = Completion(1)
        startCoroutine(suspend { generic<Request>(genericGate).id }, genericDone)
        context(Request(7)) {
            genericGate.complete(0)
            expect(current() == 7)
        }
        expect(genericDone.value == 1 && genericDone.calls == 1 && current() == 1)
    }
    try {
        current()
        throw IllegalStateException()
    } catch (missing: MissingContextException) {
        println("coroutines-ok")
    }
}
