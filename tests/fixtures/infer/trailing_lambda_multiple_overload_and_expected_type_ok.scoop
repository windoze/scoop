// EXPECT: pass
// 目标：T1324 多 trailing lambda：
// - 允许 `f { ... } { ... }` / `f(args) { ... } { ... }` 形态；
// - 多个 trailing lambda 与默认参数/命名参数/overload resolution 联动；
// - 每个 lambda 的 expected type 都能分别向下传播（含隐式 `it`）。

package fixtures.infer

import scoop.core.*

fun join2(x: Int, tag: String = "a", f: (Int) -> Int, g: (Int) -> Int): Int {
    return g(f(x))
}

fun join2(x: Int, mode: Int = 0, f: (Int) -> Int): Int {
    return f(x) + mode
}

// expected-type disambiguation：两个 overload 仅在 lambda 期望参数类型上不同。
fun pick(f: (Int) -> Int, g: (Int) -> Int): Int {
    return g(f(1))
}

fun pick(f: (Bool) -> Int, g: (Bool) -> Int): Int {
    return g(f(true) != 0)
}

fun ok() {
    val a: Int = join2(x = 1, tag = "hi") { it + 1 } { it + 2 }
    val b: Int = join2(x = 1, mode = 1) { it + 1 }

    // `it + 1` 只能在 `it: Int` 的 expected type 下通过，因此应选择 Int 版本的 overload。
    val c: Int = pick { it + 1 } { it + 2 }
}
