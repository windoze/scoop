// EXPECT: pass
// 目标：T0515 effect row 推断 v1（高阶）：当 `eff` row 参数透传到返回函数类型时，调用点推断出的 `E`
//      必须回填到返回类型上（否则返回的函数类型会错误地停留在声明处默认 `/ Pure`）。

package fixtures.infer

import scoop.core.*

// 期望：`wants` 要求一个“可能 raise”的函数值。
fun wants(block: () -> Unit / Raise<Int>): Unit {}

// 高阶：把 `E` 透传到返回函数类型。
fun <eff E = Pure> wrap(block: () -> Unit / E): () -> Unit / E {
    return block
}

fun ok() {
    wants(wrap {
        Raise.raise(1)
    })
}
