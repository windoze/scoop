package fixtures.infer

import scoop.core.*

fun select(x: Int, tag: String = "a", block: () -> Int): Int {
    return block()
}

fun select(x: Int, mode: Int = 0, block: () -> Int): Int {
    return block()
}

fun bad() {
    val a: Int = select(1) { 2 }
}
