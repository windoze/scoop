package consumer.literals
import upstream.literals.Tagged
import upstream.literals.inspect
import upstream.literals.defaulted

private struct Local<T>(val enabled: Boolean, val label: String, val value: T?)

public fun <T> exercise(value: T, read: (T) -> Int): Int {
    val local = Local(true, "hit", Some(value))
    val selected = when (local) {
        Local(true, "hit", Some(item)) if (read(item) == 42) -> read(item)
        Local(false, _, _) -> 0
        else -> -1
    }
    if (selected != 42) { return 1 }
    if (defaulted(value, read) != selected) { return 2 }
    return inspect(Tagged(true, "hit", value), read)
}

public fun result(): Int {
    if (exercise<String>("value", { item -> 42 }) != 42) { return 1 }
    if (exercise<Unit>(Unit, { item -> 42 }) != 42) { return 2 }
    return exercise<Int>(42, { item -> item })
}
