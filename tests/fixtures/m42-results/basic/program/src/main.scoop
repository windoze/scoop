import scoop.*
import scoop.collections.*

class State { var calls: Int = 0 }
class Payload(val text: String)
fun check(value: Boolean, label: String) { if (!value) throw Exception(Some(label)) }

fun main() {
    val good = Result.Success<Int, String>(7)
    val bad = Result.Failure<Int, String>("missing")
    check(good.isSuccess && !good.isFailure && bad.isFailure && !bad.isSuccess, "tags")
    check(good.getOrNull() == Some(7) && good.errorOrNull() == None, "success projection")
    check(bad.getOrNull() == None && bad.errorOrNull() == Some("missing"), "error projection")
    val state = State()
    check(good.getOrElse { _ -> throw Exception(Some("unexpected fallback")) } == 7, "lazy success")
    check(bad.getOrElse { error -> state.calls += 1; error.length.toInt() } == 7 && state.calls == 1, "error fallback once")
    check(good.fold<Int, String, String>({ value -> value.toString() }) { _ -> "failure" } == "7", "success fold")
    check(bad.fold<Int, String, String>({ _ -> "success" }) { error -> error } == "missing", "error fold")
    val mapped = good.map<Int, String, String> { value -> f"n=${value}" }
    check(mapped.getOrNull() == Some("n=7"), "map changes value type")
    check(bad.map<Int, String, String> { _ -> throw Exception(Some("unexpected map")) }.errorOrNull() == Some("missing"), "map failure")
    check(bad.mapError<Int, String, Long> { error -> error.length }.errorOrNull() == Some(7L), "mapError changes error type")
    check(good.mapError<Int, String, Long> { _ -> throw Exception(Some("unexpected error map")) }.getOrNull() == Some(7), "mapError success")
    check(good.flatMap<Int, String, Long> { value -> Result.Success<Long, String>(value.toLong()) }.getOrNull() == Some(7L), "flatMap success")
    check(good.flatMap<Int, String, Long> { _ -> Result.Failure<Long, String>("rejected") }.errorOrNull() == Some("rejected"), "flatMap returned failure")
    check(bad.flatMap<Int, String, Long> { _ -> throw Exception(Some("unexpected flatMap")) }.errorOrNull() == Some("missing"), "flatMap failure")
    check(bad.recover { error -> error.length.toInt() }.getOrNull() == Some(7), "recover")
    check(good.recover { _ -> throw Exception(Some("unexpected recover")) }.getOrNull() == Some(7), "recover success")
    val payload = Payload("alive")
    val result = Result.Success<Payload, Payload>(payload)
    val unchanged = result.onSuccess { value -> check(value === payload, "action payload"); state.calls += 1 }
        .onFailure { _ -> throw Exception(Some("unexpected failure action")) }
    check(unchanged.getOrNull()!! === payload && state.calls == 2, "onSuccess preserves reference")
    val failure = Result.Failure<Payload, Payload>(payload).onFailure { value -> check(value === payload, "error payload"); state.calls += 1 }
        .onSuccess { _ -> throw Exception(Some("unexpected success action")) }
    check(failure.errorOrNull()!! === payload && state.calls == 3, "onFailure preserves reference")
    val values = listOf<Result<Int, String>>(good, bad, Result.Success<Int, String>(9))
    check(values.mapNotNull<Result<Int, String>, Int> { value -> value.toOption() }.joinToString() == "7, 9", "collection combination")
    check(Result.Success<Int?, String?>(None).getOrNull() == Some(None), "nested success option")
    check(Result.Failure<Int?, String?>(None).errorOrNull() == Some(None), "nested error option")
    println("results basic passed")
}
