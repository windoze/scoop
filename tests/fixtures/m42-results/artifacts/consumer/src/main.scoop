import scoop.*
import scoop.collections.*

struct Payload(val label: String, val value: Int?)
class Failure(val code: Long)

fun <T, E> describe(result: Result<T, E>, render: (T) -> String): String =
    result.map<T, E, String>(render).getOrElse { _ -> "failed" }

fun main() {
    val value = Payload("ok", Some(7))
    val result = Some(value).toResult<Payload, Failure> { Failure(1L) }
    println(describe<Payload, Failure>(result) { payload -> f"${payload.label}:${payload.value!!}" })
    val values = listOf<Result<Payload, Failure>>(result, Result.Failure<Payload, Failure>(Failure(2L)))
    val selected = values.mapNotNull<Result<Payload, Failure>, Payload> { entry -> entry.toOption() }
    println(selected.size == 1L && runCatching<Int> { selected[0L].value!! }.getOrThrow() == 7)
}
