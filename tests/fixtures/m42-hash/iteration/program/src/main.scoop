import scoop.collections.*

fun check(value: Boolean, label: String) {
    if (!value) throw Exception(Some(label))
}

fun rejected(action: () -> Unit): Boolean {
    try { action() } catch (error: ConcurrentModificationException) { return true }
    return false
}

fun main() {
    val map = hashMapOf<Int, String>((1, "before"))
    val iterator = map.iterator()
    val old = iterator.next()!!
    map[1] = "after"
    check(old.value == "before", "entry is independent value")
    check(iterator.next() == None, "value change preserves iterator")
    map[2] = "new"
    check(iterator.next() == None, "permanent exhaustion")
    val pending = map.iterator()
    map[3] = "third"
    check(rejected { pending.next() }, "insert invalidates")
    val keyIterator = map.keys.iterator()
    map.remove(1)
    check(rejected { keyIterator.next() }, "remove invalidates views")
    val valueIterator = map.values.iterator()
    map.clear()
    check(rejected { valueIterator.next() }, "clear invalidates views")
    val emptyIterator = map.iterator()
    map.clear()
    map.remove(9)
    check(emptyIterator.next() == None, "no-op mutations")
    val set = hashSetOf<Int>(1, 2)
    val setIterator = set.iterator()
    set.add(1)
    set.remove(3)
    check(setIterator.next() != None, "set no-ops preserve iterator")
    set.add(3)
    check(rejected { setIterator.next() }, "set insert invalidates")
    val one = hashMapOf<String, Int>(("key", 1))
    val live = one.values.iterator()
    one["key"] = 2
    check(live.next() == Some(2), "value view sees replacement")
    println("hash iteration passed")
}
