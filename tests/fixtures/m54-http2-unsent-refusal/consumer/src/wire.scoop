import scoop.http.*
import scoop.platform.memory.NativeByteBuffer

internal fun refusedCheck(value: Boolean) {
    if (!value) throw IllegalStateException(Some("unsent HTTP2 request check failed"))
}

internal fun refusedRequest(method: String): HttpRequestHead =
    HttpRequestHead(HttpVersion.Http2, method.toByteArray(),
        HttpRequestTarget.Http2("https".toByteArray(), "example.test".toByteArray(), "/".toByteArray()))

internal fun refusedTransfer(source: Http2Session, destination: Http2Session): Long {
    return NativeByteBuffer.allocate(7L).use { buffer ->
        var total = 0L
        while (true) {
            buffer.clear()
            val count = source.takeOutput(buffer)
            if (count == 0L) break
            refusedCheck(destination.receive(buffer) == count && buffer.readableBytes == 0L)
            total += count
        }
        total
    }
}

internal fun refusedDrive(client: Http2Session, server: Http2Session) {
    while (true) {
        val sent = refusedTransfer(client, server)
        val received = refusedTransfer(server, client)
        if (sent == 0L && received == 0L) return
    }
}

internal fun refusedEvents(session: Http2Session): Array<Http2Event> {
    val events = ArrayList<Http2Event>()
    while (true) {
        val event = session.nextEvent() ?: return events.toArray()
        events.add(event)
    }
}

internal fun refusedWrite(session: Http2Session, id: Int, text: String) {
    val bytes = text.toByteArray()
    NativeByteBuffer.allocate(bytes.size).use { buffer ->
        buffer.writeBytes(bytes)
        refusedCheck(session.writeBody(id, buffer) == bytes.size)
    }
}

