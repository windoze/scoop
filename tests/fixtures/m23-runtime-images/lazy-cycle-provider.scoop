package startup.cycle
@Extern(lib = "m23_runtime_images", name = "m23_trace") private fun trace(value: Long)
private var attempts: Int = 0
private fun left(): Long {
    attempts += 1
    @Unsafe { trace(1L) }
    return Right.value
}
private object Left { val value: Long = left() }
private object Right { val value: Long = Left.value }
public fun readCycle(): Long = Left.value
public fun count(): Int = attempts
public class Box public constructor(public val value: Long)
