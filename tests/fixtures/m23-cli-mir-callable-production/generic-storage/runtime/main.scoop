fun verifyType(value: Boolean) { if (!value) { throw IllegalStateException() } }

fun main() {
    val value = Payload(17)
    verifyType(keepPayload(value).value == 17)
    verifyType(Holder(value).payload == value)
    val erased: Any = value
    verifyType((erased as Payload<Int>).value == 17)
}
