import scoop.platform.env.arguments
import scoop.platform.net.*
import scoop.test.*
import scoop.url.*

fun main() {
    val args = arguments()
    assertEquals(0L, (args.size - 1L) % 4L)
    var index = 1L
    while (index < args.size) {
        val network = IpNetwork.parse(args[index].decodeUtf8())
        val candidate = IpAddress.parse(args[index + 1L].decodeUtf8())
        val expected = args[index + 2L].decodeUtf8() == "true"
        val canonical = IpNetwork.parse(args[index + 3L].decodeUtf8())
        assertEquals(expected, network.contains(candidate))
        assertEquals(canonical, network)
        assertEquals(canonical.hash(), network.hash())
        assertEquals(network, IpNetwork.parse(network.toString()))
        assertEquals(network.address.family, network.family)
        index += 4L
    }
    for (text in ["", "127.0.0.1", "/8", "127.0.0.1/", "127.0.0.1/+1", "127.0.0.1/-1", "127.0.0.1/33",
        "127.0.0.1/1/2", "127.0.0.1/4294967296", "::1/129", "::1/ 1", "localhost/8", "fe80::1%3/64"])
        assertFailsWith<IllegalArgumentException> { IpNetwork.parse(text) }
    assertFailsWith<IllegalArgumentException> { IpNetwork(IpAddress.IPV4_LOOPBACK, -1) }
    assertFailsWith<IllegalArgumentException> { IpNetwork(IpAddress.IPV6_LOOPBACK, 129) }
    assertFailsWith<IllegalArgumentException> { IpNetwork(IpAddress.parse("fe80::1%2"), 64) }
    assertTrue(IpNetwork.parse("fe80::/10").contains(SocketAddress.parse("[fe80::abc%2]:443").address))
    assertFalse(IpNetwork.parse("0.0.0.0/0").contains(IpAddress.parse("::ffff:127.0.0.1")))
    for (text in ["http://192.0.2.17:8080/path", "https://[2001:db8::feed]/path"]) {
        val host = Url.parse(text).httpOrigin().host
        val address = when (host) {
            case Ipv4(bytes) -> IpAddress.fromByteArray(bytes)
            case Ipv6(bytes) -> IpAddress.fromByteArray(bytes)
            case Dns(_) -> throw IllegalStateException()
        }
        val network = IpNetwork.parse(if (address.family == AddressFamily.Ipv4) "192.0.2.0/24" else "2001:db8::/32")
        assertTrue(network.contains(address))
    }
    println("IP networks match independent CIDR vectors and URL socket addresses")
}
