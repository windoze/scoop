import fixtures.builder.*

class Display(val value: String) : ToString {
    public override fun toString(): String = value
}
fun main() {
    val builder = create("A")
    val first = builder.build()
    builder.add('雪').add(42)
    gcCollect()
    if (first != "A" || builder.build() != "A雪42" || surround(42) != "<42>" ||
        surround(Display("value"), '!') != "<value!" || character() != "雪" ||
        StringBuilder().add('雪').build() != character()) { println("cross-cone"); return }
    println(42)
}
