fun main() {
    val builder = StringBuilder()
    if (builder.toString() != "" || builder.toString().length != 0L) { println("empty"); return }
    val same = builder.append("A")
    same.append('雪').append('\u0000').append(42)
    val first = builder.toString()
    if (first != "A雪\u000042" || first.length != 5L || builder.toString() != first) {
        println("chain"); return
    }
    builder.append("").append<String>("🚀")
    gcCollect()
    if (first != "A雪\u000042" || builder.toString() != "A雪\u000042🚀") { println("snapshot"); return }
    val many = StringBuilder()
    var expected = ""
    for (index in 0L until 130L) {
        many.append(index)
        expected = expected + index.toString()
    }
    gcCollect()
    val result = many.toString()
    if (result != expected || many.toString() != result) { println("many"); return }
    many.append("tail")
    if (many.toString() != expected + "tail" || result != expected) { println("append"); return }
    println(42)
}
