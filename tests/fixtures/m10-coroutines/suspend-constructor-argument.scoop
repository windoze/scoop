class Gate(var waiter: Continuation<Int>?) {
    fun complete(value: Int) {
        val continuation = waiter!!
        waiter = None
        continuation.resume(value)
    }
}

class Registration(val gate: Gate) : SuspendRegistration<Int> {
    final override fun register(continuation: Continuation<Int>) {
        gate.waiter = Some(continuation)
    }
}

class Box(val value: Int)

suspend fun buildBox(gate: Gate): Box =
    Box(suspendCoroutine(Registration(gate)))

class BoxTask(val gate: Gate) : SuspendTask<Int> {
    final override suspend fun run(): Int {
        val box = buildBox(gate)
        return box.value + 1
    }
}

class RecordingCompletion() : Continuation<Int> {
    final override fun resume(value: Int) {
        println(value)
    }

    final override fun resumeWithException(exception: Throwable) {
        println("failed")
    }
}

fun main() {
    val gate = Gate(None)
    val task: SuspendTask<Int> = BoxTask(gate)
    println("created")
    startCoroutine(task, RecordingCompletion())
    println("returned")
    gate.complete(41)
}
