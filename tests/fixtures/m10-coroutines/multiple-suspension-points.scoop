class IntGate(var waiter: Continuation<Int>?) {
    fun complete(value: Int) {
        val continuation = waiter!!
        waiter = None
        continuation.resume(value)
    }
}

class BooleanGate(var waiter: Continuation<Boolean>?) {
    fun complete(value: Boolean) {
        val continuation = waiter!!
        waiter = None
        continuation.resume(value)
    }
}

class IntRegistration(val gate: IntGate) : SuspendRegistration<Int> {
    public final override fun register(continuation: Continuation<Int>) {
        gate.waiter = Some(continuation)
    }
}

class BooleanRegistration(val gate: BooleanGate) : SuspendRegistration<Boolean> {
    public final override fun register(continuation: Continuation<Boolean>) {
        gate.waiter = Some(continuation)
    }
}

suspend fun waitForInt(gate: IntGate): Int = suspendCoroutine(IntRegistration(gate))

suspend fun waitForBoolean(gate: BooleanGate): Boolean =
    suspendCoroutine(BooleanRegistration(gate))

class MultipleTask(
    val firstGate: IntGate,
    val secondGate: IntGate,
    val booleanGate: BooleanGate
) : SuspendTask<Int> {
    public final override suspend fun run(): Int {
        val first = waitForInt(firstGate)
        val second = waitForInt(secondGate)
        val accepted = waitForBoolean(booleanGate)
        return if (accepted) { first + second + 1 } else { 0 }
    }
}

class RecordingCompletion() : Continuation<Int> {
    public final override fun resume(value: Int) {
        println(value)
    }

    public final override fun resumeWithException(exception: Throwable) {
        println("failed")
    }
}

fun main() {
    val first = IntGate(None)
    val second = IntGate(None)
    val accepted = BooleanGate(None)
    startCoroutine(MultipleTask(first, second, accepted), RecordingCompletion())
    println("started")
    first.complete(20)
    println("first")
    second.complete(21)
    println("second")
    accepted.complete(true)
}
