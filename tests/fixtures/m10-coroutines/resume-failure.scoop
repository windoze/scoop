class FailureGate(var waiter: Continuation<Int>?) {
    fun fail() {
        val continuation = waiter!!
        waiter = None
        continuation.resumeWithException(UnwrapException())
    }
}

class FailureRegistration(val gate: FailureGate) : SuspendRegistration<Int> {
    public final override fun register(continuation: Continuation<Int>) {
        gate.waiter = Some(continuation)
    }
}

class CaughtTask(val gate: FailureGate) : SuspendTask<Int> {
    public final override suspend fun run(): Int {
        try {
            val registration: SuspendRegistration<Int> = FailureRegistration(gate)
            return suspendCoroutine(registration)
        } catch (exception: UnwrapException) {
            return 42
        }
    }
}

class UncaughtTask(val gate: FailureGate) : SuspendTask<Int> {
    public final override suspend fun run(): Int {
        val registration: SuspendRegistration<Int> = FailureRegistration(gate)
        return suspendCoroutine(registration)
    }
}

class RecordingCompletion() : Continuation<Int> {
    public final override fun resume(value: Int) {
        println(value)
    }

    public final override fun resumeWithException(exception: Throwable) {
        println("failed")
    }
}

fun launch(task: SuspendTask<Int>, completion: Continuation<Int>) {
    startCoroutine(task, completion)
}

fun main() {
    val caught = FailureGate(None)
    val uncaught = FailureGate(None)
    launch(CaughtTask(caught), RecordingCompletion())
    launch(UncaughtTask(uncaught), RecordingCompletion())
    println("returned")
    caught.fail()
    uncaught.fail()
}
