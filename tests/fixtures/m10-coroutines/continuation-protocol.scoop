class Holder(var waiter: Continuation<Int>?) {
    fun resumeTwice(value: Int) {
        val continuation = waiter!!
        continuation.resume(value)
        try {
            continuation.resume(value + 1)
        } catch (exception: IllegalStateException) {
            println("duplicate")
        }
    }

    fun resumeInvalidated(value: Int) {
        val continuation = waiter!!
        try {
            continuation.resume(value)
        } catch (exception: IllegalStateException) {
            println("invalidated")
        }
    }

    fun failThenResume(value: Int) {
        val continuation = waiter!!
        continuation.resumeWithException(UnwrapException())
        try {
            continuation.resume(value)
        } catch (exception: IllegalStateException) {
            println("failure-duplicate")
        }
    }
}

class SavingRegistration(val holder: Holder) : SuspendRegistration<Int> {
    final override fun register(continuation: Continuation<Int>) {
        holder.waiter = Some(continuation)
    }
}

class ResumeThenThrowRegistration() : SuspendRegistration<Int> {
    final override fun register(continuation: Continuation<Int>) {
        continuation.resume(1)
        throw UnwrapException()
    }
}

class SaveThenThrowRegistration(val holder: Holder) : SuspendRegistration<Int> {
    final override fun register(continuation: Continuation<Int>) {
        holder.waiter = Some(continuation)
        throw UnwrapException()
    }
}

class SynchronousFailureRegistration() : SuspendRegistration<Int> {
    final override fun register(continuation: Continuation<Int>) {
        continuation.resumeWithException(UnwrapException())
    }
}

class WaitingTask(val holder: Holder) : SuspendTask<Int> {
    final override suspend fun run(): Int {
        val registration: SuspendRegistration<Int> = SavingRegistration(holder)
        return suspendCoroutine(registration)
    }
}

class ResumeThenThrowTask() : SuspendTask<Int> {
    final override suspend fun run(): Int {
        try {
            val registration: SuspendRegistration<Int> = ResumeThenThrowRegistration()
            return suspendCoroutine(registration)
        } catch (exception: IllegalStateException) {
            return 42
        }
    }
}

class SaveThenThrowTask(val holder: Holder) : SuspendTask<Int> {
    final override suspend fun run(): Int {
        try {
            val registration: SuspendRegistration<Int> = SaveThenThrowRegistration(holder)
            return suspendCoroutine(registration)
        } catch (exception: UnwrapException) {
            return 43
        }
    }
}

class SynchronousFailureTask() : SuspendTask<Int> {
    final override suspend fun run(): Int {
        try {
            val registration: SuspendRegistration<Int> = SynchronousFailureRegistration()
            return suspendCoroutine(registration)
        } catch (exception: UnwrapException) {
            return 44
        }
    }
}

class RecordingCompletion() : Continuation<Int> {
    final override fun resume(value: Int) {
        println(value)
    }

    final override fun resumeWithException(exception: Throwable) {
        println("failed")
    }
}

fun launch(task: SuspendTask<Int>, completion: Continuation<Int>) {
    startCoroutine(task, completion)
}

fun main() {
    val duplicate = Holder(None)
    launch(WaitingTask(duplicate), RecordingCompletion())
    duplicate.resumeTwice(41)

    launch(ResumeThenThrowTask(), RecordingCompletion())
    launch(SynchronousFailureTask(), RecordingCompletion())

    val invalidated = Holder(None)
    launch(SaveThenThrowTask(invalidated), RecordingCompletion())
    invalidated.resumeInvalidated(44)

    val failed = Holder(None)
    launch(WaitingTask(failed), RecordingCompletion())
    failed.failThenResume(45)
}
