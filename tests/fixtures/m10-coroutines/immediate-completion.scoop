suspend fun immediateValue(): Int = 41

class ImmediateTask() : SuspendTask<Int> {
    public final override suspend fun run(): Int = immediateValue() + 1
}

class RecordingCompletion() : Continuation<Int> {
    public final override fun resume(value: Int) {
        println(value)
    }

    public final override fun resumeWithException(exception: Throwable) {
        println("failed")
    }
}

fun launch(task: SuspendTask<Int>, completion: Continuation<Int>) {
    startCoroutine(task, completion)
}

fun main() {
    launch(ImmediateTask(), RecordingCompletion())
    println("returned")
}
