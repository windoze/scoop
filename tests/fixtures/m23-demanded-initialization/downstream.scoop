import consumer.leaf.*

private class Later(val value: Int)

public fun check(): Int {
    val value = Later(result())
    if (exercise<Later>(value, { item -> item.value }) != 42) { return 1 }
    if (exercise<Unit>(Unit, { item -> 42 }) != 42) { return 2 }
    val allocation = Later(0)
    return exercise<Int>(value.value, { item -> item }) + allocation.value
}
