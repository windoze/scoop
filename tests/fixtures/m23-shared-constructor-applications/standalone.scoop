package consumer.constructors

private struct CurrentPair<T, U>(val value: T, val adjustment: Int = 0) {
    constructor(value: T, flag: Boolean): this(value, 0) {}
}

private open class CurrentBox<T, U>(var value: T, val adjustment: Int = 0) {
    val copied: T = value

    constructor(value: T, flag: Boolean): this(value, 0) {}
}

private class CurrentChild<T, U>(value: T): CurrentBox<T, U>(value, true)

private fun <T, U> selected(value: T, box: CurrentBox<T, U> = CurrentBox<T, U>(value)): T = box.value

@NoGC private fun plain(value: Int): Int = CurrentPair<Int, Unit>(value).value

public fun <T> exercise(seed: T, inspect: (T) -> Int): Int {
    val first = CurrentPair<T, Unit>(seed)
    val repeated = CurrentPair<T, Unit>(seed)
    val secondary = CurrentPair<T, String>(seed, false)
    val box = CurrentBox<T, Int>(seed)
    val child = CurrentChild<T, Unit>(seed)
    if (inspect(first.value) != 42 || inspect(repeated.value) != 42) { return 1 }
    if (inspect(secondary.value) != 42 || inspect(box.copied) != 42) { return 2 }
    if (inspect(child.value) != 42 || inspect(selected<T, Unit>(seed)) != 42) { return 3 }
    if (plain(42) != 42) { return 4 }
    val closure: () -> T = { CurrentPair<T, Unit>(seed).value }
    return inspect(closure())
}

public fun result(): Int = exercise<Int>(42, { value -> value })
