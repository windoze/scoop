import scoop.text.toHexString
import scoop.charset.*
import scoop.crypto.DigestAlgorithm
import scoop.crypto.digest
import scoop.http.*
import scoop.io.encoding.Base64
import scoop.platform.concurrent.Thread

private fun nfcCheck(value: Boolean) {
    if (!value) throw IllegalStateException(Some("NFC authentication combination failed"))
}

private fun sha256(text: String): String = digest(DigestAlgorithm.Sha256, text.toByteArray()).toHexString()

private fun exercise() {
    val user = normalizeNfc("Jose\u{0301}")
    val password = normalizeNfc("pa\u{0308}ss")
    nfcCheck(user == "José" && password == "päss")
    val text = user + ":" + password
    nfcCheck(Charset.Utf16LE.decode(Charset.Utf16LE.encode(text)) == text)
    val basic = HttpCredentials.withToken68("Basic", Base64.Default.encode(Charset.Utf8.encode(text)))
    val parsed = HttpCredentials.parse(basic.toAuthorizationField().value)
    nfcCheck(parsed.scheme == "basic" && parsed.token68 == Some("Sm9zw6k6cMOkc3M="))
    val realm = "normalization.test"
    val ha1 = sha256(user + ":" + realm + ":" + password)
    val response = sha256(ha1 + ":nfc-nonce:00000001:client-nfc:auth:" + sha256("GET:/protected"))
    nfcCheck(response == "9decab327bd0397f851fcd95e4bc96ad7f87b36e573de0c5ac901f82d1292f4c")
    val fields = HttpCredentials("Digest", [
        HttpParameter("username", user.toByteArray(), quoted = true),
        HttpParameter("realm", realm.toByteArray(), quoted = true),
        HttpParameter("algorithm", "SHA-256".toByteArray()),
        HttpParameter("response", response.toByteArray(), quoted = true)
    ])
    val decoded = HttpCredentials.parse(fields.toAuthorizationField().value)
    nfcCheck(String.fromUtf8(decoded.parameter("username")!!.value) == user)
    nfcCheck(String.fromUtf8(decoded.parameter("response")!!.value) == response)
    nfcCheck(normalizeNfc("\u{FEFF}\u{0000}e\u{0301}\u{0000}") == "\u{FEFF}\u{0000}é\u{0000}")
    nfcCheck(normalizeNfc("\u{1100}\u{1161}\u{11A8}") == "각")
    nfcCheck(normalizeNfc("\u{1D15E}") == "\u{1D157}\u{1D165}")
    nfcCheck(normalizeNfc("ﬀ①Ａ") == "ﬀ①Ａ")
    gcCollect()
}

fun main() {
    Thread.start { exercise() }.use { thread ->
        exercise()
        thread.join()
    }
    println("NFC composes with HTTP credentials charset and SHA256")
}

