import bridge.*
fun main() {
    val create: (String) -> Box<String> = ::Box
    val readBox = Box<String>::read
    val choose: (Box<String>, Int) -> Int = Box<String>::choose
    println(readBox(create("imported")))
    println(choose(create("unused"), 7))
    println(member(construct(42)))
    println(relay("default"))
    println(forwarded("template"))
    println(virtualRead(Child()))
    println(interfaceRead(Child()))
    println(readWords(words("alias")))
    println(plain("ordinary").text)
    println(empty().text)
    val values = pair(2, 3)
    println(values.left + values.right)
    gcCollect()
}
