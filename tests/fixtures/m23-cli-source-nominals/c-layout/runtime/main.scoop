import sourcepolicy.*

fun verifyNominal(value: Boolean) { if (!value) { throw IllegalStateException() } }


fun main() {
    verifyNominal(packedValues(Packed(true, 17)) == (true, 17))
    verifyNominal(outerValue(Outer(false, Packed(true, 19))) == 19)
    verifyNominal(boxValue(CBox(23)) == 23)
    verifyNominal(boxValue(CBox(29uL)) == 29uL)
    verifyNominal(ordinaryValue(Ordinary(31)) == 31)
    verifyNominal(envelope().headerValue(37) == 37)
    verifyNominal(Outer(false, Packed(true, 41)) == Outer(false, Packed(true, 41)))
}
