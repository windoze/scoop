        FieldAccess value
          Var value
    when
      Var choice
      arm Choice.Item(animal)
        Call println
          FieldAccess name
            Var animal
      arm Choice.Empty()
        Call println
          StringLiteral "empty"
    Call println
      FieldAccess name
        NullAssert
          Call returned
    Call println
      FieldAccess name
        NullAssert
          Call branched
            BoolLiteral true
    when
      Call selected
        FieldAccess On
          Var Switch
      arm Choice.Item(animal)
        Call println
          FieldAccess name
            Var animal
      arm Choice.Empty()
        Call println
          StringLiteral "empty"
    Call println
