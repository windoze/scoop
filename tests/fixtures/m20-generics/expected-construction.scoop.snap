      WhenExpression
        Var switch
        arm Switch.On()
          MethodCall Item
            Var Choice
            Call Cat
        arm Switch.Off()
          FieldAccess Empty
            Var Choice
  fun recovered(): Option<Animal>
    =
      TryExpression
        Call Some
          Call Cat
        catch e: UnwrapException
          Var None
