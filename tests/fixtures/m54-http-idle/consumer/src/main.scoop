import scoop.asyncio.*
import scoop.http.*
import scoop.http.asyncio.*
import scoop.platform.concurrent.Thread
import scoop.platform.net.*
import scoop.text.toInt
import scoop.time.Duration

fun check(value: Boolean) { if (!value) throw IllegalStateException(Some("HTTP idle fixture assertion failed")) }
fun idleLimit(): Duration = Duration.milliseconds(600L)

fun checkTimeout(error: HttpIoTimeoutException, protocol: HttpProtocol, direction: HttpIoDirection, stream: Int) {
    check(error.protocol == protocol && error.direction == direction && error.streamId == stream)
    check(error.limit == idleLimit() && error.elapsed >= error.limit)
}

class Signal {
    private var open: Boolean = false
    private var waiter: Continuation<Unit>? = None
    fun signal() { open = true; val saved = waiter; waiter = None; saved?.resume(Unit) }
    suspend fun await() {
        suspendCoroutine<Unit> { continuation ->
            if (open) continuation.resume(Unit) else waiter = Some(continuation)
        }
    }
}

private fun exercise(mode: String, address: SocketAddress) {
    val loop: EventLoop = LibuvEventLoop()
    loop.run suspend { scope ->
        if (mode == "h1-progress" || mode == "h1-stall") exerciseH1(loop, scope, address, mode)
        else exerciseH2(loop, scope, address, mode)
        check(!scope.job.isCancelled)
    }
}

fun main(args: Array<String>) {
    check(args.size == 3L)
    val mode = args[1L]
    val address = SocketAddress(IpAddress.IPV4_LOOPBACK, args[2L].toInt())
    Thread.start { exercise(mode, address) }.use { thread -> exercise(mode, address); thread.join() }
    println(mode + " idle passed")
}
