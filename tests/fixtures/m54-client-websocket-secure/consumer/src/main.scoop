import scoop.asyncio.*
import scoop.crypto.testdata.*
import scoop.crypto.x509.TrustStore
import scoop.http.*
import scoop.http.asyncio.*
import scoop.http.client.*
import scoop.test.*
import scoop.text.toInt
import scoop.time.Duration
import scoop.tls.*
import scoop.url.Url

fun main(args: Array<String>) {
    try { runSecureWs(args[1L], args[2L].toInt()) }
    catch (error: Exception) { eprintln(error.message ?: "secure WebSocket fixture failed"); throw error }
    println("secure client WebSocket case passed: " + args[1L])
}

private fun runSecureWs(mode: String, port: Int) {
    TrustStore.fromPem(rootPem()).use { trust ->
        TlsIdentity.fromPem(clientPem() + intermediatePem(), serverKeyPem()).use { identity ->
            val loop: EventLoop = LibuvEventLoop()
            loop.run suspend { scope ->
                val version = if (mode == "mutual" || mode == "no-alpn") TlsVersion.Tls12 else TlsVersion.Tls13
                val config = HttpClientConfig(
                    versionPolicy = if (mode == "h2-only") HttpVersionPolicy.Http2Only else HttpVersionPolicy.Auto,
                    tls = HttpClientTlsConfig(TlsTrustSource.Store(trust), version, version,
                        if (mode == "mutual") Some(identity) else None),
                    pool = HttpConnectionPoolOptions(maxConnectionsPerOrigin = 2L),
                    retries = HttpRetryOptions(maxRetries = 0L),
                    timeouts = HttpTimeoutOptions(poolAcquire = Some(Duration.seconds(5L))))
                val client = HttpClient.open(scope, config)
                val url = Url.parse("wss://127.0.0.1:" + port.toString() + "/start/%e9%9b%aa?x=%2f&x=2")
                try {
                    if (mode == "coexist" || mode == "mutual") {
                        val http = url.toBuilder().setScheme(Some("https")).build().resolve("/hold")
                        client.withResponse(HttpRequest.get(http)) suspend { held ->
                            assertEquals(HttpVersion.Http2, held.head.version)
                            exerciseSecureWs(client, url, mode)
                            assertEquals("hold done", held.body.text(32L))
                        }
                        wsClientProbe(client, url)
                    } else exerciseSecureWs(client, url, mode)
                } finally { client.close() }
                assertTrue(client.isClosed)
                assertFalse(scope.job.isCancelled)
            }
        }
    }
}

private suspend fun exerciseSecureWs(client: HttpClient, url: Url, mode: String) {
    val offers = if (mode == "deflate")
        [WebSocketDeflateOffer(true, true, Some(15), WebSocketWindowBits.Limit(15))]
        else Array<WebSocketDeflateOffer>(0L) { _ -> WebSocketDeflateOffer() }
    val request = HttpWebSocketRequest(url, [HttpField("X-Client".toByteArray(), "scoop".toByteArray())])
    client.withWebSocket(request, HttpWebSocketOptions(["chat"], offers,
        WebSocketSessionOptions(outgoingFrameBytes = 7L, inputBufferBytes = 19L))) suspend { result ->
        when (result) {
            case Opened(session) -> {
                assertEquals(Some("wss"), session.url.scheme)
                wsClientSession(client, session, if (mode == "h2-only") "force-h2" else if (mode == "deflate") "deflate" else "plain")
            }
            case Rejected(_, error) -> throw error
        }
    }
}
