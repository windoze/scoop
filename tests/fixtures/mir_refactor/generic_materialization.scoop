// EXPECT: pass
// 目标：MIR-T11 generic root、effect-row args 与 materialization substitution contract。

package mir_refactor.generic_materialization

effect Boom {
    fun ping(): Unit
}

fun <T, eff E = Pure> top(value: T): T / E {
    return value
}

fun <T, eff E = Pure> capture(value: T): T / E {
    val read: () -> T = { value }
    return read()
}

fun <eff E = Pure> Int.effectExt(): Int / E {
    return this
}

class Box<T>(val value: T) {
    fun <U, eff E = Pure> pair(other: U): (T, U) / E {
        return (this.value, other)
    }
}

class Holder<T>(val item: T)

object Tools {
    fun <T> choose(value: T): T {
        return value
    }
}

fun entry(): Int / Boom {
    val box: Box<Int> = Box(10)
    val pair: (Int, String) = box.pair<String, eff Boom>("tag")
    val holder: Holder<Int> = Holder(pair._0)
    val ext: Int = 1.effectExt<eff Boom>()
    val chosen: String = Tools.choose<String>(pair._1)
    val captured: Int = capture<Int, eff Boom>(holder.item)
    return top<Int, eff Boom>(captured) + pair._0 + ext
}

fun main(): Int {
    return 0
}
