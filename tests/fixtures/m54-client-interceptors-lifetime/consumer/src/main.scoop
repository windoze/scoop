import scoop.crypto.testdata.rootPem
import scoop.crypto.x509.TrustStore
import scoop.test.*

fun main(args: Array<String>) {
    assertTrue(args.size >= 2L)
    val name = args[1L]
    TrustStore.fromPem(rootPem()).use { trust ->
        interceptorCase(name) {
            when (name) {
                case "lifetime" -> {
                    assertEquals(6L, args.size)
                    interceptorLifetime(trust, args[2L], args[3L], interceptorBoolean(args[4L]), interceptorBoolean(args[5L]))
                }
                case "self-wait" -> {
                    assertEquals(4L, args.size)
                    interceptorSelfWait(trust, args[2L], interceptorBoolean(args[3L]))
                }
                case "concurrent-proceed" -> { assertEquals(2L, args.size); interceptorConcurrentProceed(trust) }
                case "http2-shared-driver" -> { assertEquals(2L, args.size); interceptorHttp2(trust) }
                else -> throw IllegalArgumentException()
            }
        }
    }
    println("interceptor lifetime case passed")
}

private fun interceptorBoolean(value: String): Boolean = when (value) {
    case "false" -> false
    case "true" -> true
    else -> throw IllegalArgumentException()
}

private fun interceptorCase(name: String, block: () -> Unit) {
    try { block() }
    catch (error: AssertionFailure) {
        eprintln(name + " " + error.kind + " " + (error.message ?: "failure") + " at " + error.location.file + ":" + error.location.line.toString())
        throw error
    } catch (error: Throwable) { eprintln("failed interceptor case: " + name); throw error }
}
