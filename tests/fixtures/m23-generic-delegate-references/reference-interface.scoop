package consumer.delegates

import templates.delegateGenerated.*

public fun <T> exercise(value: T): Int {
    val before = Trace.initializations
    val receiver = Receiver<T>(value)
    val answer = receiver.referenceInterface
    val allocated = Payload(0)
    if (answer != 42 || allocated.value != 0) { return 1 }
    if (receiver.referenceInterface != 42 || Trace.initializations != before + 1) { return 2 }
    return answer
}

public fun result(): Int = exercise<Int>(1)
