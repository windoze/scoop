import m55.facade.*
import scoop.test.*
private struct Local(val value: Int) { public fun read(): Int = value }
private struct Pure(val value: Int) { @NoGC public fun read(): Int = value }
fun main() {
    val value = construct<Remote>(7)
    println(forward(value))
    println(make<Remote>(8).value)
    println(fromDefault(value))
    println(wrapped(value)())
    println(forward(Local(9)))
    println(known())
    println(defaultClosure(value))
    println(defaultClosure(Local(9)))
    println(defaultForward(value))
    val reference: (Local) -> Int = ::read
    val constructor: (Int) -> Local = ::construct
    println(reference(constructor(17)))
    println(Api("tag").withDefault(value))
    println(Api(1).withDefault(Local(19)))
    println(pure(Pure(21)))
    assertEquals(Remote(7), Remote(7))
    assertNotEquals(Local(1), Local(2))
}
