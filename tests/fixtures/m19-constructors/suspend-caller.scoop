class Gate(var waiter: Continuation<Int>?) {
    fun complete(value: Int) {
        val continuation = waiter!!
        waiter = None
        continuation.resume(value)
    }
}

class Registration(val gate: Gate) : SuspendRegistration<Int> {
    final override fun register(continuation: Continuation<Int>) {
        gate.waiter = Some(continuation)
    }
}

suspend fun awaitValue(gate: Gate): Int = suspendCoroutine(Registration(gate))

class Constructed(val value: Int) {
    init {
        println("constructed-after-resume")
    }
}

class ConstructionTask(val gate: Gate) : SuspendTask<Int> {
    final override suspend fun run(): Int {
        val constructed = Constructed(awaitValue(gate))
        println(constructed.value)
        return constructed.value + 1
    }
}

class Completion() : Continuation<Int> {
    final override fun resume(value: Int) {
        println(value)
    }

    final override fun resumeWithException(exception: Throwable) {
        println("failed")
    }
}

fun main() {
    val gate = Gate(None)
    startCoroutine(ConstructionTask(gate), Completion())
    println("suspended-before-construction")
    gate.complete(40)
}
