import scoop.json.Json
import model.Identifier
import model.reader

typealias Id = Identifier

fun main() {
    val text = Json.encodeToString(Identifier(7L), Id.Companion)
    if (text != "{\"id\":7}") { throw IllegalStateException() }
    val codec: ValueDecoder<Identifier> = Id.Companion
    val first = Json.decodeFromString(text, codec)
    val second = Json.decodeFromString(text, reader<Identifier>({ source -> Id.decode(source) }))
    if (first != second || first.value != 7L) { throw IllegalStateException() }
    if (Identifier.Factory.calls != 2L || Id.Companion !== Identifier.Factory) {
        throw IllegalStateException()
    }
    println(text)
    println("artifacts-ok")
}
