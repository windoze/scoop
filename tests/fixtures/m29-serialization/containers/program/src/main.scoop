import scoop.json.Json

fun check(value: Boolean) {
    if (!value) { throw IllegalStateException(Some("container codec assertion failed")) }
}

fun <T> reject(text: String, codec: ValueDecoder<T>, path: String) {
    var rejected: Boolean = false
    try { val result = Json.decodeFromString(text, codec) }
    catch (error: DecodingException) {
        check(error.path == path)
        rejected = true
    }
    check(rejected)
}

public struct User(val id: Long, val name: String) {
    public companion object : ValueEncoder<User>, ValueDecoder<User> {
        public override fun encode(value: User, encoder: Encoder) {
            val fields = encoder.keyed()
            Long.encode(value.id, fields.field("id/~"))
            String.encode(value.name, fields.field("name"))
            fields.end()
        }

        public override fun decode(decoder: Decoder): User {
            val fields = decoder.keyed()
            val id = Long.decode(fields.required("id/~"))
            val name = when (fields.optional("name")) {
                case Some(source) -> String.decode(source)
                case None -> "anonymous"
            }
            fields.end()
            return User(id, name)
        }
    }
}

public struct Numbers(val elements: Array<Long>) {
    public companion object : ValueEncoder<Numbers>, ValueDecoder<Numbers> {
        public override fun encode(value: Numbers, encoder: Encoder) {
            val sequence = encoder.unkeyed()
            for (element in value.elements) { Long.encode(element, sequence.element()) }
            sequence.end()
        }

        public override fun decode(decoder: Decoder): Numbers {
            val sequence = decoder.unkeyed()
            val elements = ArrayList<Long>()
            while (sequence.hasNext) { elements.add(Long.decode(sequence.element())) }
            sequence.end()
            return Numbers(elements.toArray())
        }
    }
}

object Unread : ValueDecoder<Long> {
    public override fun decode(decoder: Decoder): Long = 42L
}

object Incomplete : ValueEncoder<Unit> {
    public override fun encode(value: Unit, encoder: Encoder) { val fields = encoder.keyed() }
}

object ExtraElement : ValueDecoder<Long> {
    public override fun decode(decoder: Decoder): Long {
        val elements = decoder.unkeyed()
        val value = Long.decode(elements.element())
        elements.end()
        return value
    }
}

object WrongEncoderContainer : ValueEncoder<Unit> {
    public override fun encode(value: Unit, encoder: Encoder) {
        val fields = encoder.keyed()
        (encoder as SingleValueEncodingContainer).writeLong(1L)
        fields.end()
    }
}

object ScalarView : ValueDecoder<Long> {
    public override fun decode(decoder: Decoder): Long =
        (decoder as SingleValueDecodingContainer).readLong()
}

fun <T> rejectEncoding(value: T, codec: ValueEncoder<T>) {
    var rejected: Boolean = false
    try { val result = Json.encodeToString(value, codec) }
    catch (error: EncodingException) {
        check(error.path == "")
        rejected = true
    }
    check(rejected)
}

fun main() {
    check(Json.encodeToString(User(7L, "雪"), User.Companion) == "{\"id/~\":7,\"name\":\"雪\"}")
    val user = Json.decodeFromString("{\"name\":\"雪\",\"id/~\":7}", User.Companion)
    check(user == User(7L, "雪"))
    val missing = Json.decodeFromString("{\"unknown\":[null,true,{\"a\":-12.3e+4}],\"id/~\":8}", User.Companion)
    check(missing == User(8L, "anonymous"))
    check(Json.encodeToString(Numbers([1L, -2L, 3L]), Numbers.Companion) == "[1,-2,3]")
    val numbers = Json.decodeFromString(" [ 4 , 5 , 6 ] ", Numbers.Companion)
    check(numbers.elements.size == 3L && numbers.elements[1L] == 5L)
    check(Json.encodeToString(Json.decodeFromString("[]", Numbers.Companion), Numbers.Companion) == "[]")
    check(Json.encodeToString(Unit, UnitEncoder) == "null")
    reject("{}", User.Companion, "/id~1~0")
    reject("{\"id/~\":null}", User.Companion, "/id~1~0")
    reject("{\"id/~\":1,\"name\":null}", User.Companion, "/name")
    reject("{\"id/~\":1,\"id\\u002f~\":2}", User.Companion, "/id~1~0")
    reject("{\"id/~\":1,\"unknown\":[1,]}", User.Companion, "/unknown/1")
    reject("{\"id/~\":1,}", User.Companion, "")
    reject("[1,null]", Numbers.Companion, "/1")
    reject("[]", ExtraElement, "/0")
    reject("[1,2]", ExtraElement, "")
    check(Json.decodeFromString("42", Unread) == 42L)
    check(Json.decodeFromString("42", ScalarView) == 42L)
    rejectEncoding(Unit, Incomplete)
    rejectEncoding(Unit, WrongEncoderContainer)
    val sequence: Array<Option<Long>> = [None, Some(8L)]
    val optionEncoder = Option<Long>.Companion.encoder(Long.Companion)
    val sequenceEncoder = Array<Option<Long>>.Companion.encoder(optionEncoder)
    check(Json.encodeToString(sequence, sequenceEncoder) == "[null,8]")
    val mutable = MutableArray<Long>(2L) { index -> index + 1L }
    check(Json.encodeToString(mutable, MutableArray<Long>.Companion.encoder(Long.Companion)) == "[1,2]")
    val list = ArrayList<Long>()
    list.add(3L)
    check(Json.encodeToString(list, ArrayList<Long>.Companion.encoder(Long.Companion)) == "[3]")
    val listEncoder = ValueEncoderFunction<List<Long>>({ values, encoder -> encodeList(values, Long.Companion, encoder) })
    check(Json.encodeToString<List<Long>>(list, listEncoder) == "[3]")
    val pairEncoder = ValueEncoderFunction<(Long, String)>({ value, encoder ->
        val elements = encoder.unkeyed()
        Long.encode(value._1, elements.element())
        String.encode(value._2, elements.element())
        elements.end()
    })
    check(Json.encodeToString((4L, "pair"), pairEncoder) == "[4,\"pair\"]")
    println("containers-ok")
}
