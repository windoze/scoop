import scoop.json.Json

fun check(value: Boolean) {
    if (!value) { throw IllegalStateException(Some("scalar codec assertion failed")) }
}

fun <T> reject(text: String, codec: ValueDecoder<T>) {
    var rejected: Boolean = false
    try { val result = Json.decodeFromString(text, codec) }
    catch (error: DecodingException) {
        check(error.path == "")
        rejected = true
    }
    check(rejected)
}

class OffsetDecoder(val offset: Long) : ValueDecoder<Long> {
    public override fun decode(decoder: Decoder): Long = Long.decode(decoder) + offset
}

fun main() {
    check(Json.encodeToString(true, Boolean.Companion) == "true")
    check(!Json.decodeFromString("false", Boolean.Companion))
    check(Json.encodeToString((-128).toByte(), Byte.Companion) == "-128")
    check(Json.decodeFromString("127", Byte.Companion) == 127)
    check(Json.decodeFromString("-32768", Int16.Companion) == -32768)
    check(Json.encodeToString(32767.toShort(), Int16.Companion) == "32767")
    check(Json.decodeFromString("-2147483648", Int.Companion) == -2147483648)
    check(Json.encodeToString(2147483647, Int.Companion) == "2147483647")
    check(Json.decodeFromString("-9223372036854775808", Long.Companion) == -9223372036854775808L)
    check(Json.encodeToString(9223372036854775807L, Long.Companion) == "9223372036854775807")
    check(Json.decodeFromString("255", UInt8.Companion) == 255u)
    check(Json.encodeToString(255u.toUByte(), UInt8.Companion) == "255")
    check(Json.decodeFromString("65535", UInt16.Companion) == 65535u)
    check(Json.encodeToString(65535u.toUShort(), UInt16.Companion) == "65535")
    check(Json.decodeFromString("4294967295", UInt.Companion) == 4294967295u)
    check(Json.encodeToString(4294967295u, UInt.Companion) == "4294967295")
    check(Json.decodeFromString("18446744073709551615", ULong.Companion) == 18446744073709551615UL)
    check(Json.encodeToString(18446744073709551615UL, ULong.Companion) == "18446744073709551615")
    check(Json.decodeFromString(" -0 \n", Long.Companion) == 0L)
    check(Json.decodeFromString("\"\\ud83d\\ude00\"", Char.Companion) == '😀')
    check(Json.decodeFromString("\"雪\"", Char.Companion) == '雪')
    check(Json.encodeToString('😀', Char.Companion) == "\"😀\"")
    val text = "\"\\\n\r\t\u{8}\u{c}\u{0}雪😀"
    val encoded = "\"\\\"\\\\\\n\\r\\t\\b\\f\\u0000雪😀\""
    check(Json.encodeToString(text, String.Companion) == encoded)
    check(Json.decodeFromString(encoded, String.Companion) == text)
    check(Json.decodeFromString("\"\\/\\u0061\"", String.Companion) == "/a")
    check(Json.encodeToString(Unit, UnitEncoder) == "null")
    Json.decodeFromString("null", UnitDecoder)
    val multiplier = ValueEncoderFunction<Long>({ value, encoder -> Long.encode(value * 2L, encoder) })
    check(Json.encodeToString(21L, multiplier) == "42")
    val encode = multiplier::encode
    val adapted: ValueEncoder<Long> = ValueEncoderFunction<Long>(encode)
    check(Json.encodeToString(21L, adapted) == "42")
    val erased: Any = 21L
    check(!(erased is ValueEncoder<Long>))
    check(Json.decodeFromString("40", OffsetDecoder(2L)) == 42L)
    val offset: ValueDecoder<Long> = OffsetDecoder(3L)
    check(Json.decodeFromString("40", offset) == 43L)
    val function = ValueDecoderFunction<Long>({ decoder -> Long.decode(decoder) * 2L })
    check(Json.decodeFromString("21", function) == 42L)

    reject("128", Int8.Companion)
    reject("-129", Int8.Companion)
    reject("32768", Int16.Companion)
    reject("-32769", Int16.Companion)
    reject("2147483648", Int.Companion)
    reject("-2147483649", Int.Companion)
    reject("9223372036854775808", Long.Companion)
    reject("-9223372036854775809", Long.Companion)
    reject("256", UInt8.Companion)
    reject("65536", UInt16.Companion)
    reject("4294967296", UInt.Companion)
    reject("18446744073709551616", ULong.Companion)
    reject("-1", ULong.Companion)
    reject("-0", ULong.Companion)
    reject("1e0", Long.Companion)
    reject("1.0", Long.Companion)
    reject("01", Long.Companion)
    reject("+1", Long.Companion)
    reject("1e", Long.Companion)
    reject("1.", Long.Companion)
    reject("-", Long.Companion)
    reject("1 2", Long.Companion)
    reject("true false", Boolean.Companion)
    reject("null", String.Companion)
    reject("0", Boolean.Companion)
    reject("[]", UnitDecoder)
    reject("\"\"", Char.Companion)
    reject("\"ab\"", Char.Companion)
    reject("\"\\ud800\"", String.Companion)
    reject("\"\\udc00\"", String.Companion)
    reject("\"\\ud800\\u0041\"", String.Companion)
    reject("\"\\u00xx\"", String.Companion)
    reject("\"\\x\"", String.Companion)
    reject("\"unterminated", String.Companion)
    reject("\"\n\"", String.Companion)
    reject("", String.Companion)
    println("scalars-ok")
}
