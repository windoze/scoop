import scoop.json.Json

fun check(value: Boolean) {
    if (!value) { throw IllegalStateException(Some("scalar codec assertion failed")) }
}

fun <T> reject(text: String, codec: Decodable<T>) {
    var rejected: Boolean = false
    try { val result = Json.decode(text, codec) }
    catch (error: DecodingException) {
        check(error.path == "")
        rejected = true
    }
    check(rejected)
}

class OffsetDecoder(val offset: Long) : Decodable<Long> {
    public override fun decode(decoder: Decoder): Long = Long.decode(decoder) + offset
}

fun main() {
    check(Json.encode(true) == "true")
    check(!Json.decode("false", Boolean.Companion))
    check(Json.encode((-128).toInt8()) == "-128")
    check(Json.decode("127", Byte.Companion) == 127)
    check(Json.decode("-32768", Int16.Companion) == -32768)
    check(Json.encode(32767.toInt16()) == "32767")
    check(Json.decode("-2147483648", Int.Companion) == -2147483648)
    check(Json.encode(2147483647) == "2147483647")
    check(Json.decode("-9223372036854775808", Long.Companion) == -9223372036854775808L)
    check(Json.encode(9223372036854775807L) == "9223372036854775807")
    check(Json.decode("255", UInt8.Companion) == 255u)
    check(Json.encode(255u.toUInt8()) == "255")
    check(Json.decode("65535", UInt16.Companion) == 65535u)
    check(Json.encode(65535u.toUInt16()) == "65535")
    check(Json.decode("4294967295", UInt.Companion) == 4294967295u)
    check(Json.encode(4294967295u) == "4294967295")
    check(Json.decode("18446744073709551615", ULong.Companion) == 18446744073709551615UL)
    check(Json.encode(18446744073709551615UL) == "18446744073709551615")
    check(Json.decode(" -0 \n", Long.Companion) == 0L)
    check(Json.decode("\"\\ud83d\\ude00\"", Char.Companion) == '😀')
    check(Json.decode("\"雪\"", Char.Companion) == '雪')
    check(Json.encode('😀') == "\"😀\"")
    val text = "\"\\\n\r\t\u{8}\u{c}\u{0}雪😀"
    val encoded = "\"\\\"\\\\\\n\\r\\t\\b\\f\\u0000雪😀\""
    check(Json.encode(text) == encoded)
    check(Json.decode(encoded, String.Companion) == text)
    check(Json.decode("\"\\/\\u0061\"", String.Companion) == "/a")
    Json.decode("null", UnitDecoder)
    check(Json.decode("40", OffsetDecoder(2L)) == 42L)
    val offset: Decodable<Long> = OffsetDecoder(3L)
    check(Json.decode("40", offset) == 43L)
    val function = DecodeFunction<Long>({ decoder -> Long.decode(decoder) * 2L })
    check(Json.decode("21", function) == 42L)

    reject("128", Int8.Companion)
    reject("-129", Int8.Companion)
    reject("32768", Int16.Companion)
    reject("-32769", Int16.Companion)
    reject("2147483648", Int.Companion)
    reject("-2147483649", Int.Companion)
    reject("9223372036854775808", Long.Companion)
    reject("-9223372036854775809", Long.Companion)
    reject("256", UInt8.Companion)
    reject("65536", UInt16.Companion)
    reject("4294967296", UInt.Companion)
    reject("18446744073709551616", ULong.Companion)
    reject("-1", ULong.Companion)
    reject("-0", ULong.Companion)
    reject("1e0", Long.Companion)
    reject("1.0", Long.Companion)
    reject("01", Long.Companion)
    reject("+1", Long.Companion)
    reject("1e", Long.Companion)
    reject("1.", Long.Companion)
    reject("-", Long.Companion)
    reject("1 2", Long.Companion)
    reject("true false", Boolean.Companion)
    reject("null", String.Companion)
    reject("0", Boolean.Companion)
    reject("[]", UnitDecoder)
    reject("\"\"", Char.Companion)
    reject("\"ab\"", Char.Companion)
    reject("\"\\ud800\"", String.Companion)
    reject("\"\\udc00\"", String.Companion)
    reject("\"\\ud800\\u0041\"", String.Companion)
    reject("\"\\u00xx\"", String.Companion)
    reject("\"\\x\"", String.Companion)
    reject("\"unterminated", String.Companion)
    reject("\"\n\"", String.Companion)
    reject("", String.Companion)
    println("scalars-ok")
}
