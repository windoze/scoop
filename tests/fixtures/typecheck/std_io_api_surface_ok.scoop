// EXPECT: pass
//
// 目标：T1318e `scoop.io` 的最小 API 表面可被解析、解析绑定并通过类型检查。

package fixtures.typecheck

import scoop.core.*
import scoop.io.*

fun main() {
    stdoutWriteString("hello")
    stderrWriteString("err")

    val line: String? = stdinReadLine()
    // 仅验证类型：不依赖运行期 stdin 行为。
    val _unused: String? = line
}
