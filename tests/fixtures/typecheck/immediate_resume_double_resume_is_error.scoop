// EXPECT: fail
// EXPECT-ERROR-CODE: scoop::typecheck::immediate_resume_arm_resume_not_tail
// EXPECT-ERROR: `-> resume` arm 中的 `resume(value)` 只能出现在每条控制流路径的尾值位置
// EXPECT-ERROR-AT: 21:13
// 目标：T3009a1：同一路径内重复调用 `resume(value)` 不能再漏到 generic local-call，
// 而应在 typecheck 阶段被 immediate-resume 合同稳定拒绝。

package fixtures.typecheck

import scoop.core.*

effect Yield {
    fun next(): Int
}

fun demo(): Int {
    handle {
        Yield.next()
    } with {
        Yield.next() -> resume {
            resume(1)
            resume(2)
        }
    }
}
