package fixtures.typecheck

import scoop.core.*

// `use` 的 required effects 是 `/ E`，其中 `E` 来自 lambda body 的 required effects。
fun <eff E = Pure> use(block: () -> Unit / E): Unit / E {
    block()
}

fun bad() {
    val x: Unit = use { Raise.raise(1) }
}
