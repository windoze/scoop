// EXPECT: pass
// 目标：T4008c1 多 effect type params 的 effect op call / handle arm 实例化。
// - 单 payload tuple 参数可同时承载两个 effect type params 的推断；
// - handler arm 可通过 binder 注解区分 `Pair<String, Int>` 与 `Pair<Int, String>`；
// - 无 binder 注解时，也可从 handle body 中唯一的 performed effect 反推完整 effect instance。

package fixtures.typecheck

effect Pair<A, B> {
    fun ping(payload: (A, B)): Int
}

fun useStringInt(): Int / Pair<String, Int> {
    return Pair.ping(("left", 7))
}

fun useIntString(): Int / Pair<Int, String> {
    return Pair.ping((9, "right"))
}

fun handleAnnotated(): Int {
    val handled: Int = handle {
        useStringInt()
    } on {
        Pair.ping(payload: (String, Int)) -> {
            val (_, n) = payload
            n
        }
        Pair.ping(payload: (Int, String)) -> {
            0
        }
    }

    return handled
}

fun handleBodyInferred(): Int {
    val handled: Int = handle {
        useIntString()
    } on {
        Pair.ping(payload) -> {
            val (n, _) = payload
            n
        }
    }

    return handled
}
