// EXPECT: pass
// 目标：T4009c：`Task` core 不再依赖公开 `spawn/join` surface；
//      外层只通过 handled `Async.await` + 内部 helper 驱动 lazy task。

package fixtures.typecheck

import scoop.core.*

async fun fetch(): Int {
    val t: Task<Int> = async { 40 }
    return await t + 1
}

fun main(): Int {
    val outer: Task<Int> = async {
        val base: Int = await fetch()
        base + 1
    }
    val value: Int = handle {
        Async.await(outer)
    } with {
        Async.await(taskArg: Task<Int>) -> __scoop_task_join(taskArg)
    }
    return value
}
