// EXPECT: pass
//
// T1508c：interface dispatch（itable）已支持：对 interface member method call 应可通过 typecheck。

package fixtures.typecheck

import scoop.core.*

interface IFace {
    fun foo(): Int
}

class Impl() : IFace {
    fun foo(): Int { return 1 }
}

fun use(x: IFace): Int {
    return x.foo()
}
