// EXPECT: pass
// 目标：T0622/T4009c：`async/await` 在 `async { ... }` 语境内不应使 entry point 泄露 `Async`
//      required effects，且嵌套 `async { ... }` 的返回值/`await` 的参数应为 `Task<T>`。

package fixtures.typecheck

import scoop.core.*

fun main(): Int {
    val x: Task<Int> = async {
        val t1: Task<Int> = async { 1 }
        val t2: Task<Int> = async { 2 }
        val a: Int = await t1
        val b: Int = await t2
        a + b
    }

    // 仅用于确保 async surface 对外稳定暴露 `Task<Int>`。
    val y: Task<Int> = x
    val z: Task<Int> = y
    return 0
}
