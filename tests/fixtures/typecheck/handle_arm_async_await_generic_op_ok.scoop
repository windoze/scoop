// EXPECT: pass
// 目标：T0602b：handler arm head 可处理“泛型 effect op”：
// - `Async.await(task), k -> { ... }` 能基于实例化后的签名校验 binder arity；
// - 并确保 handle body 内的 `Async.await(task)` 调用可通过 typecheck（T 从实参推断）。

package fixtures.typecheck

import scoop.core.*

fun handleAsyncAwait(task: Task<Int>): Unit {
    val _setup: Unit = handle {
        val v: Int = Async.await(task)
        val _ = v
    } with {
        Async.await(taskArg), k -> { () }
    }

    return
}
