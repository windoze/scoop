package fixtures.typecheck

import scoop.core.*

interface BadIterator<T> {
    fun next(): T
}

interface HasIterator<T> {
    fun iterator(): BadIterator<T>
}

fun use(xs: HasIterator<Int>) {
    for (x in xs) {
        println(x)
    }
}
