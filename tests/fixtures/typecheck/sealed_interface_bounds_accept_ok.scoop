// EXPECT: pass
// C4-T01C: sealed markers are valid only as generic/where bounds.

package fixtures.typecheck

import scoop.core.*

class RefThing()

class RefOnly<T>(val value: T) where T: AnyRef

fun <T> idValue(x: T): T where T: AnyValue {
    return x
}

class HashRef<T>(val value: T) where T: AnyRef, T: Hashable {
    fun hashValue(): Int {
        return this.value.hash()
    }
}

val refOk: RefOnly<RefThing> = RefOnly(RefThing())
val valueOk: Int = idValue(41)
val comboOk: Int = HashRef("ok").hashValue()
