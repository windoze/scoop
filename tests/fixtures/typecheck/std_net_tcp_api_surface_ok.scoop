// EXPECT: pass
//
// 目标：T1320d `scoop.net` 最小 API surface + capability gating：
// - `tcpIsSupported` 可被解析并通过类型检查；
// - `tcpConnect/tcpListen/accept/readUtf8/writeUtf8/close` 的签名可用。

package fixtures.typecheck

import scoop.core.*
import scoop.net.*

fun main() {
    val supported: Bool = tcpIsSupported()

    val stream: TcpStream? = tcpConnect("127.0.0.1", 80)
    when (stream) {
        Some(raw) -> {
            // 说明：resolver 的扩展函数解析依赖 receiver 的显式类型标注；
            // `Some(raw)` 的 pattern 绑定在当前阶段不会写回 receiver 的类型信息。
            val s: TcpStream = raw
            val wrote: Int = s.writeUtf8("ping")
            val read: String? = s.readUtf8(1024)
            s.close()
        }
        None -> ()
    }

    val listener: TcpListener? = tcpListen("127.0.0.1", 0)
    when (listener) {
        Some(raw) -> {
            val l: TcpListener = raw
            val conn: TcpStream? = l.accept()
            l.close()
        }
        None -> ()
    }

    when (supported) { true -> () false -> () }
}
