// EXPECT: fail
// EXPECT-ERROR-CODE: scoop::typecheck::handle_arm_unreachable
// EXPECT-ERROR: 不可达的 handler arm
// EXPECT-ERROR-AT: 39:25
// 目标：T2001：mixed-arm 下对 resume 语义冲突不再走统一门禁，而是按真实 arm 覆盖关系给出稳定诊断。

package fixtures.typecheck

import scoop.core.*

effect Yield {
    fun next(): Int
}

effect Ask {
    fun current(): Int
}

effect Boom {
    fun boom(code: Int): Nothing
}

fun demo(mode: Int): Int {
    val result: Int = handle {
        if (mode == 0) {
            val x: Int = Yield.next()
            x + 1
        } else if (mode == 1) {
            val y: Int = Ask.current()
            y + 2
        } else {
            Boom.boom(10)
            0
        }
    } on {
        Yield.next() , k -> {
            k.resume(41)
        }
        Yield.next(), k -> 7
        Boom.boom(code: Int) -> 0
    }
    result
}
