package fixtures.typecheck

import scoop.core.*

struct Point(val x: Int, val y: Int)

enum Result {
    Ok(val point: Point),
    Err(val code: Int),
}

fun use(r: Result) {
    val updated: Result = r with { Ok: 1 }
}
