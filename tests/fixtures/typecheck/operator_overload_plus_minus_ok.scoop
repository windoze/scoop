// EXPECT: pass
// 目标：operator-positioned `a + b` / `a - b` 只绑定到显式 `operator` 方法。

package fixtures.typecheck

import scoop.core.*

struct Vec2 {
    val x: Int
    val y: Int

    operator fun plus(other: Vec2): Vec2 {
        return other
    }

    operator fun minus(other: Vec2): Vec2 {
        return other
    }
}

fun add(a: Vec2, b: Vec2): Vec2 {
    val c: Vec2 = a + b
    val d: Vec2 = a - b
    return c
}
