// EXPECT: fail
// EXPECT-ERROR-CODE: scoop::typecheck::handle_arm_return_type_mismatch
// EXPECT-ERROR: handler arm 的返回类型不匹配
// EXPECT-ERROR-AT: 44:33
// 目标：T2001：mixed-arm 下仍应对 non-resuming / escape-continuation arm 做稳定的结果类型检查。

package fixtures.typecheck

import scoop.core.*

effect Yield {
    fun next(): Int
}

effect Ask {
    fun current(): Int
}

effect Boom {
    fun boom(code: Int): Nothing
}

fun demo(mode: Int): Int {
    val result: Int = handle {
        if (mode == 0) {
            val x: Int = Yield.next()
            x + 1
        } else if (mode == 1) {
            val y: Int = Ask.current()
            y + 2
        } else {
            Boom.boom(10)
            0
        }
    } with {
        Yield.next() , k -> {
            k.resume(41)
        }
        Ask.current(), k -> {
            val keep: Continuation<Int> = k
            val _ = keep
            7
        }
        Boom.boom(code: Int) -> "oops"
    }
    result
}
