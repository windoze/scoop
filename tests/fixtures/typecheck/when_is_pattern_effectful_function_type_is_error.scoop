// 目标：P5-T02 保持带非 `Pure` effect row 的 function-type `when is T` pattern 的更早 reject。

package fixtures.typecheck

import scoop.core.*

typealias EffFn = () -> Int / Raise<RuntimeError>

fun classify(x: Any): Int {
    return when (x) {
        is EffFn -> 1
        else -> 0
    }
}
