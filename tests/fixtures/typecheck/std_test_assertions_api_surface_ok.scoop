// EXPECT: pass
// 目标：T1320a 在 stdlib 中新增 `scoop.test` 的最小断言工具（assertions）API surface 可被解析与类型检查。

package fixtures.typecheck

import scoop.core.*
import scoop.test.*

fun useTestAssertions(): Unit / Raise<RuntimeError> {
    assertTrue(true)
    assertFalse(false)
    assertEqInt(1, 1)

    val some: Int? = Some(7)
    val v: Int = assertSomeInt(some)
    println(v)

    // 说明：当前阶段 `None` 作为“裸标识符值”不可用；用 `None()` 走 enum variant ctor 路径。
    val none: Int? = None()
    assertNoneInt(none)
    return ()
}
