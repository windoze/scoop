// EXPECT: fail
// EXPECT-ERROR-CODE: scoop::typecheck::when_or_pattern_binder_not_allowed
// EXPECT-ERROR-AT: 15:3
// EXPECT-ERROR: 当前语言 contract 下，when or-pattern 不允许引入 binder

package fixtures.typecheck

enum Choice {
  Hit(val left: Int),
  Miss(val right: Int),
}

val x: Choice = Hit(1)
val y: Int = when (x) {
  Hit(v) | Miss(v) -> 1
  else -> 0
}
