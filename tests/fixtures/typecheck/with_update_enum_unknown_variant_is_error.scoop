// EXPECT: fail
// EXPECT-ERROR-CODE: scoop::typecheck::with_update_unknown_variant
// EXPECT-ERROR: 不存在 variant
// 目标：T4010a2b enum `with` 的首段必须解析为 variant 名。

package fixtures.typecheck

import scoop.core.*

struct Point(val x: Int, val y: Int)

enum Result {
    Ok(val point: Point),
    Err(val code: Int),
}

fun use(r: Result) {
    val updated: Result = r with { Missing.point.x: 1 }
}
