// EXPECT: pass
// 目标：T1328 `for (x in xs)` 迭代协议升级：`Iterator.next(): Option<T>`（不再依赖 `hasNext()`）。

package fixtures.typecheck

import scoop.core.*

interface MyIterator<T> {
    fun next(): Option<T>
}

interface MyIterable<T> {
    fun iterator(): MyIterator<T>
}

fun use(xs: MyIterable<Int>) {
    for (x in xs) {
        println(x)
    }
}
