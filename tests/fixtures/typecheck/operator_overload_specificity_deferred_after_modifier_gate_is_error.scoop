// EXPECT: fail
// EXPECT-ERROR-CODE: scoop::typecheck::ambiguous_overload
// EXPECT-ERROR: fixtures.typecheck.Box.plus(fixtures.typecheck.Base) | fixtures.typecheck.Box.plus(fixtures.typecheck.Derived)
// P5-T01R: operator syntax filters to `operator` candidates, but Phase A-C does not select most-specific yet.

package fixtures.typecheck

import scoop.core.*

open class Base()

class Derived() : Base()

struct Box {
    operator fun plus(other: Base): Base {
        return other
    }

    operator fun plus(other: Derived): Derived {
        return other
    }

    fun plus(other: String): String {
        return other
    }
}

fun positioned_call_reports_ambiguity_before_specificity(box: Box, derived: Derived): Derived {
    val x: Derived = box + derived
    return x
}

fun named_call_still_allows_plain_method(box: Box): String {
    return box.plus("hi")
}
