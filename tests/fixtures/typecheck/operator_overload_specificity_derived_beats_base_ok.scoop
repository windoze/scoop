// EXPECT: pass
// 目标：P5-T03；operator-positioned call 在 modifier gate 后继续使用 Phase D specificity。

package fixtures.typecheck

import scoop.core.*

open class Base()

class Derived() : Base()

struct Box {
    operator fun plus(other: Base): Base {
        return other
    }

    operator fun plus(other: Derived): Derived {
        return other
    }

    fun plus(other: String): String {
        return other
    }
}

fun positioned_call_selects_most_specific(box: Box, derived: Derived): Derived {
    val x: Derived = box + derived
    return x
}

fun named_call_still_allows_plain_method(box: Box): String {
    return box.plus("hi")
}
