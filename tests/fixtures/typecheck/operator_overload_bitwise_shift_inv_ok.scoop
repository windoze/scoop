// EXPECT: pass
// 目标：`& | ^ << >> ~` 只绑定到显式 `operator` 方法。

package fixtures.typecheck

import scoop.core.*

struct Bits {
    val v: Int

    operator fun and(other: Bits): Bits {
        return other
    }

    operator fun or(other: Bits): Bits {
        return other
    }

    operator fun xor(other: Bits): Bits {
        return other
    }

    operator fun shl(count: Int): Bits {
        return this
    }

    operator fun shr(count: Int): Bits {
        return this
    }

    operator fun inv(): Bits {
        return this
    }
}

fun ops(a: Bits, b: Bits): Bits {
    val c: Bits = a & b
    val d: Bits = a | b
    val e: Bits = a ^ b
    val f: Bits = a << 1
    val g: Bits = a >> 1
    val h: Bits = ~a
    return c
}
