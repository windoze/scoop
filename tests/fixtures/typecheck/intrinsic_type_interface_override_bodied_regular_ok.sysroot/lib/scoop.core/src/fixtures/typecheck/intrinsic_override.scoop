package fixtures.typecheck

import scoop.core.*

public interface NativeIface {
    public fun ping(): Int

    public fun fallback(): Int {
        return 10
    }
}

@Intrinsic
public class NativeClass() : NativeIface {
    public override fun ping(): Int {
        return 1
    }

    public override fun fallback(): Int {
        return 2
    }
}

@Intrinsic
public struct NativeStruct() : NativeIface {
    public override fun ping(): Int {
        return 3
    }
}

public fun use(c: NativeClass, s: NativeStruct): Int {
    return c.ping() + c.fallback() + s.ping()
}
