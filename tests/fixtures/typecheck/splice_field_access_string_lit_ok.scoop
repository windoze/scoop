// EXPECT: pass
// 目标：T1205 splice 字段访问（`value.[field]`）最小实现：
// - 当 `field` 为字符串字面量时，typecheck 将其视为 `value.<field>` 并推导字段类型；
// - 当 `field` 不是字面量时，当前阶段先退化为 `Any`（留给后续 comptime 展开/FieldMeta 补齐）。

package fixtures.typecheck

import scoop.core.*

struct Point(val x: Int, val y: Int)

fun get_x(p: Point): Int {
    return p.["x"]
}

fun get_by_name_v0(p: Point, name: String): Any {
    return p.[name]
}

