// EXPECT: pass
//
// 目标：T1318d `scoop.path` 的最小 API 表面可被解析、解析绑定并通过类型检查。

package fixtures.typecheck

import scoop.core.*
import scoop.path.normalize
import scoop.path.join as pathJoin
import scoop.path.basename
import scoop.path.dirname

fun main() {
    val a: String = normalize("/a//b/")
    val b: String = pathJoin("/a", "b")
    val c: String = basename("/a/b.txt")
    val d: String = dirname("/a/b.txt")
}
