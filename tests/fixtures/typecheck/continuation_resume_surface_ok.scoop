// EXPECT: pass
// 目标：T4008c4 Continuation.resume surface：
// - `Continuation<Unit, Answer>` 支持零参 `k.resume()`；
// - `Continuation<(A, B), Answer>` 需要把 tuple payload 作为单一实参传递。

package fixtures.typecheck

import scoop.core.*

fun resumeUnit(k: Continuation<Unit, Unit, eff Pure>): Unit / Raise<RuntimeError> {
    k.resume()
}

fun resumePair(k: Continuation<(Int, String), Unit, eff Pure>): Unit / Raise<RuntimeError> {
    k.resume((1, "ok"))
}
