// EXPECT: pass
// 目标：T4008c4 Continuation.resume surface：
// - `Continuation<Unit>` 支持零参 `k.resume()`；
// - `Continuation<(A, B)>` 支持按 payload element 扁平传参，并接受 `a0/a1/...` 命名实参。

package fixtures.typecheck

import scoop.core.*

fun resumeUnit(k: Continuation<Unit, eff Pure>): Unit / Raise<RuntimeError> {
    k.resume()
}

fun resumePair(k: Continuation<(Int, String), eff Pure>): Unit / Raise<RuntimeError> {
    k.resume(a1 = "ok", a0 = 1)
}
