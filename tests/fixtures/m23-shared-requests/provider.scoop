package upstream.requests

public fun <T> identity(value: T): T = value

public fun <T> factory(value: T): () -> T {
    fun <U> keep(next: U): U = next
    return { keep<T>(identity<T>(value)) }
}

public fun <T> defaulted(value: T, select: (T) -> T = { item -> identity<T>(item) }): T = select(value)

public class Box<T> public constructor(public val value: T) {
    public fun read(): T = value
    public fun <U> mix(extra: U, select: (T, U) -> Int): Int = select(value, extra)
}
