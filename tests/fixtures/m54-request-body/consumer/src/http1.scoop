import scoop.asyncio.*
import scoop.http.*
import scoop.http.asyncio.*
import scoop.http.client.RequestBody
import scoop.platform.fs.Path
import scoop.platform.net.*

private fun request(body: RequestBody): HttpRequestHead {
    val fields = ArrayList<HttpField>()
    fields.add(HttpField("Host".toByteArray(), "localhost".toByteArray()))
    when (body.contentType) { case Some(type) -> fields.add(type.toHttpField()); case None -> {} }
    return HttpRequestHead(HttpVersion.Http11, "POST".toByteArray(),
        HttpRequestTarget.Http1("/upload".toByteArray()), fields)
}

private suspend fun serveBodies(connection: AsyncHttp1Connection) {
    for (expected in ["共享字节快照", payload()]) {
        val incoming = connection.receiveRequest()!!
        check(String.fromUtf8(incoming.head.method) == "POST")
        check(String.fromUtf8(incoming.body.readAllBytes()) == expected)
        check(incoming.body.isComplete)
        incoming.body.close()
        connection.sendResponse(HttpResponseHead(HttpVersion.Http11, 204U)).finish()
    }
}

suspend fun runBodyHttp1(loop: EventLoop, scope: CoroutineScope, path: Path, snapshot: RequestBody) {
    val listener = loop.listenTcp(SocketAddress(IpAddress.IPV4_LOOPBACK, 0))
    try {
        val serving = scope.launch suspend {
            AsyncHttp1Connection.takeOwnershipAsServer(listener.accept(), scope).useAsync suspend { server ->
                serveBodies(server)
            }
        }
        AsyncHttp1Connection.takeOwnershipAsClient(loop.connectTcp(listener.localAddress), scope).useAsync suspend { client ->
            val bodies: Array<RequestBody> = [snapshot, RequestBody.fromFile(path)]
            for (body in bodies) {
                val framing = when (body.contentLength) {
                    case Some(length) -> Http1BodyFraming.Length(length)
                    case None -> Http1BodyFraming.Chunked
                }
                val writer = client.sendRequest(request(body), framing)
                try {
                    val written = body.writeTo(writer, 3L)
                    check(written > 0L)
                    writer.finish()
                } finally { writer.close() }
                val response = client.receiveResponse()
                check(response.head.status == 204U)
                checkEnd(response.body)
                response.body.close()
                gcCollect()
            }
        }
        serving.join()
    } finally { listener.close() }
}
