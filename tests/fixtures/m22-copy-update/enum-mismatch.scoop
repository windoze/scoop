// EXPECT-DIAGNOSTICS

enum UnitChoice {
    Only
}

enum PositionalChoice {
    Item(Int)
}

enum NamedChoice {
    Data { value: Int }
}

fun rejectUnit() {
    val base: UnitChoice = UnitChoice.Only
    val invalid = base.{ value: missingRhs() }
}

fun rejectPositional() {
    val base: PositionalChoice = PositionalChoice.Item(1)
    val invalid = base.{ value: missingRhs() }
}

fun rejectNamedEvenWithAUniqueFieldMatch() {
    val base: NamedChoice = NamedChoice.Data(value = 1)
    val invalid = base.{ value: missingRhs() }
}

fun main() {}
