import scoop.asyncio.*
import scoop.platform.memory.NativeByteBuffer

internal class WsGate {
    var ready: Boolean = false
    private var waiter: Continuation<Unit>? = None
    fun signal() { ready = true; val saved = waiter; waiter = None; saved?.resume(Unit) }
    suspend fun await() { suspendCoroutine<Unit> { next -> if (ready) next.resume(Unit) else waiter = Some(next) } }
}
internal class WsFailure { var value: Throwable? = None }
internal fun wsCheck(value: Boolean, text: String) { if (!value) { println(text); throw IllegalStateException(Some(text)) } }
internal fun <T> wsPresent(value: T?): Boolean = when (value) { case Some(_) -> true; case None -> false }
internal class WsTestTransport : AsyncByteStream, AsyncCloseable {
    var closes: Int = 0
    val closing: WsGate = WsGate()
    var closeRelease: WsGate? = None
    var closeFailure: Throwable? = None
    public override suspend fun readInto(buffer: NativeByteBuffer, count: Long): Long =
        suspendCancellableCoroutine<Long> { _ -> }
    public override suspend fun writeFrom(buffer: NativeByteBuffer, count: Long): Long { buffer.skip(count); return count }
    public override suspend fun flush() {}
    public override suspend fun close() {
        closes += 1; closing.signal(); ensureActive()
        closeRelease?.await()
        ensureActive()
        if (wsPresent(closeFailure)) throw closeFailure!!
    }
}
internal class WsBlockedSource : AsyncByteSource {
    val started: WsGate = WsGate()
    val cancelled: WsGate = WsGate()
    val release: WsGate = WsGate()
    var finished: Boolean = false
    public override suspend fun readInto(buffer: NativeByteBuffer, count: Long): Long {
        try { started.signal(); return suspendCancellableCoroutine<Long> { _ -> } }
        finally { cancelled.signal(); release.await(); finished = true }
    }
}

internal class WsMarker(val name: String)
context(marker: WsMarker)
internal fun wsMarker(): String = marker.name
internal suspend fun wsExpect(block: suspend () -> Unit): Throwable {
    try { block() } catch (error: Throwable) { return error }
    throw IllegalStateException(Some("expected WebSocket failure"))
}
internal suspend fun wsIgnoreClose(block: suspend () -> Unit) { try { block() } catch (_: Throwable) {} }
