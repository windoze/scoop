import scoop.http.*
import scoop.bytes.ByteArrayBuilder
import scoop.platform.memory.NativeByteBuffer

fun main() {
    val version = HttpEntityTag([255.toByte(), 44.toByte(), 92.toByte(), 65.toByte()])
    val weak = HttpEntityTag(version.opaque, isWeak = true)
    val condition = HttpEntityTagCondition([version, weak])
    val requests = ArrayList<HttpRequestHead>()
    var requestEnds = 0L
    for (event in decode(requestBytes(condition), HttpRole.Server)) {
        when (event) {
            case Request(head) -> requests.add(head)
            case End(_) -> requestEnds += 1L
            case Data(_) -> throw IllegalStateException()
            else -> {}
        }
    }
    if (requests.size != 1L || requestEnds != 1L) throw IllegalStateException()
    val received = HttpEntityTagCondition.parse(requests[0L].fields.findAll("if-none-match".toByteArray())[0L].value)
    gcCollect()
    if (received.isWildcard || received.tags.size != 2L || !received.tags[0L].stronglyMatches(version) ||
        received.tags[1L].stronglyMatches(version) || !received.tags[1L].weaklyMatches(version)) throw IllegalStateException()
    val response = ByteArrayBuilder()
    response.append("HTTP/1.1 304 Not Modified\r\nETag: ".toByteArray())
    response.append(weak.toHttpField().value)
    response.append("\r\nCache-Control: max-age=30\r\nContent-Length: 3\r\n\r\n".toByteArray())
    val responses = ArrayList<HttpResponseHead>()
    var responseEnds = 0L
    for (event in decode(response.toByteArray(), HttpRole.Client)) {
        when (event) {
            case Response(head) -> responses.add(head)
            case End(_) -> responseEnds += 1L
            case Data(_) -> throw IllegalStateException()
            else -> {}
        }
    }
    if (responses.size != 1L || responses[0L].status != 304U || responseEnds != 1L) throw IllegalStateException()
    val fields = responses[0L].fields
    val validator = HttpEntityTag.parse(fields.findAll("etag".toByteArray())[0L].value)
    if (!validator.isWeak || !validator.weaklyMatches(version) || validator.stronglyMatches(version)) throw IllegalStateException()
    if (HttpCacheControl.parseFields(fields).single("max-age")!!.deltaSeconds() != 30L) throw IllegalStateException()
    if (!HttpEntityTagCondition.parse(HttpEntityTagCondition.wildcard().toIfMatchField().value).isWildcard) throw IllegalStateException()
    println("HTTP entity tags retain opaque bytes")
}

fun requestBytes(condition: HttpEntityTagCondition): Array<Byte> = Http1Encoder(HttpRole.Client).use { encoder ->
    val head = HttpRequestHead(HttpVersion.Http11, "GET".toByteArray(), HttpRequestTarget.Http1("/item".toByteArray()),
        [HttpField("Host".toByteArray(), "example.test".toByteArray()), condition.toIfNoneMatchField()])
    val bytes = ByteArrayBuilder()
    bytes.append(encoder.beginRequest(head, Http1BodyFraming.Length(0L)))
    bytes.append(encoder.finish())
    bytes.toByteArray()
}

fun decode(bytes: Array<Byte>, role: HttpRole): Array<Http1Event> {
    val events = ArrayList<Http1Event>()
    val parser = if (role == HttpRole.Client) Http1Decoder.client() else Http1Decoder.server()
    parser.use { decoder ->
        if (role == HttpRole.Client) decoder.expectResponse("GET".toByteArray())
        NativeByteBuffer.allocate(1L).use { input ->
            for (byte in bytes) {
                input.clear(); input.writeByte(byte)
                if (decoder.receive(input) != 1L) throw IllegalStateException()
                while (true) {
                    val next = decoder.nextEvent()
                    when (next) {
                        case None -> break
                        case Some(_) -> events.add(next!!)
                    }
                }
            }
            decoder.endInput()
        }
        Unit
    }
    return events.toArray()
}
