import scoop.platform.io.standardOutput
import scoop.terminal.*
import scoop.terminal.clipboard.*
import scoop.terminal.cursor.MoveTo
import scoop.terminal.screen.SetTitle
import scoop.terminal.style.*

fun main() {
    forceColorOutput(false)
    standardOutput.execute(MoveTo(2L, 2L), "keep".styled(ContentStyle(Some(Color.Green))))
    val bytes: Array<Byte> = [0, 1, 2, -1]
    val binary = CopyToClipboard(bytes, ClipboardSelection.parse("pc"))
    gcCollect()
    standardOutput.execute(CopyToClipboard.fromText("foo"), binary,
        CopyToClipboard.fromText("中\n\u001b]", ClipboardSelection.primary),
        CopyToClipboard.fromText("", ClipboardSelection.parse("")),
        SetTitle("clipboard-done"))
}
