  class Gate(var waiter: Continuation<Int>?)
    fun complete
    fun fail
  class Registration(val gate: Gate), SuspendRegistration<Int>
    public fun register
  suspend fun waitFor(gate: Gate): Int
    =
      Call suspendCoroutine
        Call Registration
          Var gate
  class Inner(val gate: Gate, val first: Node, val third: Node)
    operator fun component1
    operator suspend fun component2
    operator fun component3
