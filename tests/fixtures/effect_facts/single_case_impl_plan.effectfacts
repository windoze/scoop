      bb0:
        ambient_cases: [case#0=sample.Ping.hit]
        outward_cases: [case#0=sample.Ping.hit]
        has_suspend_boundary: true
        has_handle_boundary: false
      bb1:
        ambient_cases: [case#0=sample.Ping.hit]
        outward_cases: []
        has_suspend_boundary: false
