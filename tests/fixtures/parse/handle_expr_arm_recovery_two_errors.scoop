// EXPECT: fail
// EXPECT-ERROR: 语法错误：期望 `->`
// EXPECT-ERROR-CODE: scoop::parse::expected_token
// EXPECT-ERROR-AT: 13:24
// 目标：验证 handler arms 内语法错误可恢复到下一个 arm（并避免级联错误）。

package fixtures.parse

fun main() {
    handle {
        1
    } on {
        Raise.raise(e) println(e)
        Raise.raise(e) -> resume { 2 }
    }
}
