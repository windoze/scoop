// 目标：source-only 多 cone fixture 保留跨 cone public/internal/private 可见性边界覆盖。

package fixtures.typecheck_cone.deps_visibility_filter.lib

import scoop.core.*

public struct PublicToken(val value: Int)

internal struct InternalToken(val value: Int)

private struct PrivateToken(val value: Int)

public fun makePublicToken(x: Int): PublicToken {
    PublicToken { value: x }
}

internal fun makeInternalToken(x: Int): InternalToken {
    InternalToken { value: x }
}

private fun makePrivateToken(x: Int): PrivateToken {
    PrivateToken { value: x }
}
