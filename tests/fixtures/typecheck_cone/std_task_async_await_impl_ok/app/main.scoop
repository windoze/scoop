// EXPECT: pass
// 目标：T4009a2 移除 `scoop.task` 公开 surface 后，cone 内仍可仅通过 `scoop.core.Task` + handled `Async.await`
// 完成最小 async typecheck 主线。

package fixtures.typecheck_cone.std_task_async_await_impl_ok.app

import scoop.core.*

async fun fetch(): Int {
    val inner: Task<Int> = async { 1 }
    return await inner + 1
}

fun main(): Int {
    val outer: Task<Int> = async {
        await fetch() + 10
    }
    val value: Int = handle {
        Async.await(outer)
    } with {
        Async.await(taskArg: Task<Int>) -> __scoop_task_join(taskArg)
    }
    return value
}
