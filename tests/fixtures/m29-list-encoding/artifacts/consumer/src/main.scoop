import scoop.json.Json
import sequences.sequence
import sequences.capture

private fun check(value: Boolean, code: Int) {
    if (!value) { throw IllegalStateException(Some(f"list artifact assertion ${code}")) }
}

private class Captured(private val body: (List<String>, Encoder) -> Unit) : Encodable {
    public override fun encode(encoder: Encoder) {
        body(Array<String>(2L) { _ -> "界" }, encoder)
    }
}

fun main() {
    val integers = Array<Int>(3L) { index -> index.toInt32() + 1 }
    check(Json.encode(sequence(integers)) == "[1,2,3]", 1)
    val mutable = ArrayList<Unit>()
    mutable.add(Unit)
    check(Json.encode(sequence(mutable)) == "[null]", 2)
    val nested = Array<Encodable>(2L) { _ -> sequence(integers) }
    check(Json.encode(sequence(nested)) == "[[1,2,3],[1,2,3]]", 3)
    check(Json.encode(Captured(capture<String>())) == "[\"界\",\"界\"]", 4)
    val restored = Json.decode(Json.encode(sequence(integers)), Array<Int>.decoder(Int.Companion))
    check(restored.size == 3L && restored[2L] == 3, 5)
    println("list-encoding-artifacts-ok")
}
