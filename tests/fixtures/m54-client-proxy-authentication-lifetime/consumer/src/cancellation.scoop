import scoop.asyncio.*
import scoop.crypto.x509.TrustStore
import scoop.http.client.*
import scoop.time.Duration

internal class LifeControl {
    val entered: LifeGate = LifeGate()
    val cancelled: LifeGate = LifeGate()
    val release: LifeGate = LifeGate()
    val cleaning: LifeGate = LifeGate()
    val finish: LifeGate = LifeGate()
    val cleanup: Throwable = Throwable()
    val closed: AtomicBoolean = AtomicBoolean(false)
    suspend fun hold() {
        val registration = currentJobOrNone()!!.invokeOnCancellation { _ -> cancelled.signal() }
        try { entered.signal(); release.await() }
        finally {
            cleaning.signal(); finish.await(); closed.store(true)
            registration.dispose()
            throw cleanup
        }
    }
}

internal fun lifeCancellation(trust: TrustStore, kind: String, mode: String) {
    withLifeRuntime suspend { _, scope, listener ->
        val proxy = lifeUrl(listener)
        val control = LifeControl()
        val step: suspend (HttpAuthenticationRequest) -> Unit = suspend { request ->
            lifeCheck(request.proxyUrl == Some(proxy) && request.attempt == 1L && lifeContext() == "operation")
            control.hold()
        }
        val provider = if (kind == "basic") HttpAuthenticator.basic(proxy.httpOrigin()) suspend { request ->
            step(request); HttpPasswordCredentials("user", "password")
        } else if (kind == "digest") HttpAuthenticator.digest(proxy.httpOrigin()) suspend { request ->
            step(request); HttpPasswordCredentials("user", "password")
        } else HttpAuthenticator.bearer(proxy.httpOrigin(), sendWithoutChallenge = false) suspend { request ->
            step(request); HttpBearerTokens("unused")
        }
        val serving = lifeReject(scope, listener, kind)
        val client = HttpClient.open(scope, lifeConfig(trust, lifeSelector(HttpProxyEndpoint(proxy,
            authentication = HttpAuthenticationOptions([provider])))))
        val failure = LifeFailure()
        val closeFailure = LifeFailure()
        val executing = context(LifeContext("operation")) { scope.launch suspend {
            try {
                val options = if (mode == "total") HttpCallOptions(timeouts = Some(HttpTimeoutOptions(total = Some(Duration.seconds(15L)),
                    resolve = None, connect = None, tlsHandshake = None, proxyHandshake = None))) else HttpCallOptions()
                client.execute(HttpRequest.get(lifeTarget(), options = options)).close()
            } catch (error: Throwable) { failure.value = Some(error) }
        } }
        control.entered.await()
        val closing = if (mode == "close") Some(scope.launch suspend {
            try { client.close() } catch (error: Throwable) { closeFailure.value = Some(error) }
        }) else None
        if (mode == "caller") executing.cancel()
        try {
            control.cancelled.await()
            lifeCheck(!executing.isCompleted && !control.closed.load())
            if (lifePresent(closing)) lifeCheck(!closing!!.isCompleted)
            control.release.signal(); control.cleaning.await()
            lifeCheck(!executing.isCompleted && !control.closed.load())
            control.finish.signal(); executing.join(); closing?.join()
            lifeCheck(control.closed.load())
            val error = failure.value!!
            lifeCheck(error is ResourceUseException)
            if (error is ResourceUseException) {
                lifeCheck(error.cleanupFailure === control.cleanup)
                val primary = error.primaryFailure
                if (mode == "caller") lifeCheck(primary is CancellationException)
                else if (mode == "close") lifeCheck(primary is HttpClientClosedException)
                else {
                    lifeCheck(primary is HttpTimeoutException)
                    if (primary is HttpTimeoutException) lifeCheck(primary.phase == HttpTimeoutPhase.Total)
                }
            }
            if (mode == "close") lifeCheck(closeFailure.value!! === control.cleanup)
            else lifeCheck(!lifePresent(closeFailure.value))
        } finally { control.release.signal(); control.finish.signal(); client.close() }
        serving.join()
    }
}
