    val s
      MethodCall Circle
        Var Shape
        IntLiteral 5
    when
      Var s
      arm Circle(r)
        Call println
          Var r
      arm Rect(w, h)
        Call println
          Binary Add
            Var w
            Var h
      arm Named{w, ..}
        Call println
          Var w
      arm WithDefault(d)
        Call println
          Var d
    val r
      MethodCall Rect
        Var Shape
        IntLiteral 3
        IntLiteral 4
    when
      Var r
      arm Circle(x)
        Call println
          Var x
      arm Rect(w, h)
        Call println
          Binary Add
            Var w
            Var h
      arm Named{w, ..}
        Call println
          Var w
      arm WithDefault(d)
        Call println
          Var d
    val d
      MethodCall WithDefault
        Var Shape
    when
      Var d
      arm WithDefault(x)
        Call println
          Var x
      else
        Call println
          StringLiteral "other"
    val d2
      MethodCall WithDefault
        Var Shape
        IntLiteral 3
    when
      Var d2
      arm WithDefault(x)
