import scoop.asyncio.*
import scoop.platform.fs.Path
import scoop.platform.memory.NativeByteBuffer

fun main(args: Array<String>) {
    check(args.size == 2L)
    val path = Path.fromString(args[1L])
    val loop: EventLoop = LibuvEventLoop()
    loop.run suspend { scope -> runHttp1(loop, scope, path); runHttp2(loop, scope) }
    println("multipart output composes with asynchronous files gzip and isolated cancellation")
}

fun check(value: Boolean) { if (!value) throw IllegalStateException() }
suspend fun checkEmpty(source: AsyncByteSource) {
    NativeByteBuffer.allocate(1L).use suspend { buffer -> check(source.readInto(buffer, 1L) == 0L) }
}

class Gate {
    private var open: Boolean = false
    private val waiters: ArrayList<Continuation<Unit>> = ArrayList<Continuation<Unit>>()
    fun signal() {
        open = true
        val ready = waiters.toArray()
        waiters.clear()
        for (waiter in ready) waiter.resume(Unit)
    }
    suspend fun await() {
        suspendCoroutine<Unit> { next -> if (open) next.resume(Unit) else waiters.add(next) }
    }
}
