fun main(): Int {
    var count = 0
    while (count < 3) count += 1
    for (value in 0..<4) if (value == 2) continue else count += value
    println(count)
    while (true) if (count == 7) break else count += 1
    println(count)
    if (true) val scoped = 1
    while (false) val scoped = 2
    for (value in 0..<1) val scoped = value
    val scoped = 42
    println(scoped)
    return 0
}
