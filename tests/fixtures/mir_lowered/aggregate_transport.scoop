// EXPECT: pass
// 目标：MIR-T10 aggregate/array/enum/closure/effect payload transport contract。

package mir_lowered.aggregate_transport

import scoop.core.*

struct Box(val value: Int, val label: String)
struct Wrapper(val box: Box, val pair: (Int, Box))

enum Choice {
    Empty,
    Nested(val wrapper: Wrapper, val pair: (Box, (Int, String))),
    Wide(val value: Int64),
}

effect Send {
    fun submit(choice: Choice, payload: (Box, Wrapper)): Box
}

fun makeBox(value: Int): Box {
    return Box(value, "box")
}

fun identityBox(box: Box): Box {
    return box
}

fun arrays(box: Box): Box {
    val xs: Array<Box> = [box, Box(2, "array")]
    val first: Box = xs.get(0)
    val ms: MutableArray<Box> = [box, first]
    ms.set(0, Box(3, "set"))
    return ms.get(0)
}

fun closureCapture(box: Box): Int {
    var counter: Int = 1
    val read: () -> Int = {
        counter = counter + box.value
        counter
    }
    return read()
}

fun functionValue(f: (Box) -> Box, box: Box): Box {
    return f(box)
}

fun effects(box: Box): Int {
    val payload = Wrapper(box, (1, box))
    val selected: Box = handle {
        Send.submit(
            Nested(payload, (box, (2, "payload"))),
            (box, payload),
        )
    } on {
        Send.submit(choice: Choice, payload: (Box, Wrapper)) -> payload._0
    }
    val unitVariant: Choice = Empty()
    val wide: Choice = Wide(9)
    return selected.value + when (unitVariant) {
        Empty -> 1
        Nested(_, _) -> 2
        Wide(_) -> 3
    } + when (wide) {
        Empty -> 1
        Nested(_, _) -> 2
        Wide(_) -> 3
    }
}

fun main(): Int {
    val box = makeBox(1)
    val fromArray = arrays(box)
    val fromFun = functionValue(identityBox, box)
    return fromArray.value + fromFun.value + closureCapture(box) + effects(box)
}
