package fixtures.mir_lowered

effect Step {
    fun next(seed: Int): Int
}

fun cleanup() {}

fun body_completes(): Int {
    return handle {
        5
    } on {
        Step.next(value) -> value
    } finally {
        cleanup()
    }
}

fun handled_raise(): Int {
    return handle {
        Step.next(1)
        0
    } on {
        Step.next(value) -> value + 1
    } finally {
        cleanup()
    }
}

fun main(): Int {
    return body_completes() + handled_raise()
}
