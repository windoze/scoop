package fixtures.mir_lowered

effect Step {
    fun next(seed: Int): Int
}

effect Flag {
    fun read(): Bool
}

fun cleanup() {}

fun box_int(value: Int): Int {
    return value
}

fun main(): Int {
    val local = handle {
        Step.next(1)
        0
    } on {
        Step.next(value) -> value
    } finally {
        cleanup()
    }

    val via_arg = box_int(handle {
        Step.next(local)
        0
    } on {
        Step.next(value) -> value
    } finally {
        cleanup()
    })

    if (handle {
        Flag.read()
        false
    } on {
        Flag.read() -> true
    } finally {
        cleanup()
    }) {
        return via_arg
    }

    return handle {
        Step.next(via_arg)
        0
    } on {
        Step.next(value) -> value
    } finally {
        cleanup()
    }
}
