package mir_lowered.assignment_places

import scoop.core.*

@Global
var G: Int = 0

@Extern(name = "native_counter")
var NativeCounter: Int

class Box(var value: Int)
class Holder(var box: Box)

fun use(box: Box, holder: Holder): Int {
    var local: Int = 1
    local = 2

    var captured: Int = local
    val snapshot: Int = captured
    val reader: () -> Int = { snapshot }
    captured = captured + 1

    G = captured
    @Unsafe do { NativeCounter = G }
    box.value = G
    holder.box.value = box.value
    return holder.box.value
}
