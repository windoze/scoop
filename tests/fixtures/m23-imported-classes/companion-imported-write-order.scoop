import dependency.classes.Counter
import dependency.classes.WriteHost.count as count
import dependency.classes.CompanionTrace
import dependency.classes.companionWriteArgument

public fun primary(): Counter {
    count = if (CompanionTrace.events == 1) { companionWriteArgument() } else { 0 }
    return Counter(if (CompanionTrace.events == 123) { count } else { 0 })
}
