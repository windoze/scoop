import dependency.classes.Counter
import dependency.classes.Token
import dependency.classes.WideValue
import dependency.classes.DefaultWide

public struct LocalWide(): DefaultWide {
    public override fun value(marker: Token, input: Counter): WideValue =
        super<DefaultWide>.value(input = input, marker = marker)
}
public fun primary(): Counter = Counter(LocalWide().value(Token(), Counter(10)).first + 1)
