import dependency.classes.*

public class LocalDefaults public constructor(): ParameterSource {
    public override fun base(): Long = 20
    public override fun answer(renamed: Long): Long = renamed
}
public fun primary(): Counter {
    val target = LocalDefaults()
    val inherited: ParameterSource = target
    return Counter(target.answer(renamed = 11) + inherited.answer(value = 10))
}
