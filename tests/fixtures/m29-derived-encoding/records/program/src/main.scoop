import scoop.json.Json

fun check(value: Boolean) {
    if (!value) { throw IllegalStateException(Some("derived record assertion failed")) }
}

object Defaults { var calls: Int = 0 }
public fun nextValue(): Int { Defaults.calls += 1; return 7 }

public struct Empty() : Encodable
public struct Box<T : Encodable>(val value: T) : Encodable
public struct Record<T : Encodable>(
    @SerialName("v/~") val value: T,
    @Transient val ignored: (Int) -> Int
) : Encodable
public struct WithDefaults(val first: Int = nextValue(), val second: Int = first + 1) : Encodable

public class Row public constructor(private val id: Int, public val name: String) : Encodable {
    public val computed: String get() = name
    @SerialName("counter") public var count: Long = 2L
    @Transient private val cache: (Int) -> Int = { value -> value + 1 }
}

fun <T : Encodable> nested(value: T): String = Json.encode(Box<T>(value))

fun main() {
    check(Json.encode(Empty()) == "{}")
    check(Json.encode(Box<Int>(3)) == "{\"value\":3}")
    check(nested(Box<String>("text")) == "{\"value\":{\"value\":\"text\"}}")
    val value = Record<Box<Int>>(Box<Int>(4), { item -> item + 1 })
    check(Json.encode(value) == "{\"v/~\":{\"value\":4}}")
    val erased: Encodable = value
    check(Json.encode(erased) == "{\"v/~\":{\"value\":4}}")
    check(Json.encode(WithDefaults(7, 8)) == "{\"first\":7,\"second\":8}")
    check(Defaults.calls == 0)
    val defaults = WithDefaults()
    check(Defaults.calls == 1)
    check(Json.encode(defaults) == "{\"first\":7,\"second\":8}")
    check(Defaults.calls == 1)
    val row = Row(9, "nine")
    row.count = 3L
    check(Json.encode(row) == "{\"id\":9,\"name\":\"nine\",\"counter\":3}")
    println("records-ok")
}
