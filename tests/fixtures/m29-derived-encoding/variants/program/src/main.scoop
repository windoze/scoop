import scoop.json.Json

fun check(value: Boolean) {
    if (!value) { throw IllegalStateException(Some("derived enum assertion failed")) }
}

public enum Choice<T> {
    @SerialName("nothing") Empty,
    Pair(T, Int),
    Record { value: T, count: Int },
    Named(@SerialName("item") val value: T, @Transient val ignored: Any, val count: Int = 2)
    public companion object {
        public fun encoder(element: Encodable<T>): Encodable<Choice<T>> = ChoiceEncoder<T>(element)
    }
}
public class ChoiceEncoder<T>(private val element: Encodable<T>) : Encodable<Choice<T>>

public enum Tree {
    Leaf,
    Branch(val node: Node)
    public companion object : Encodable<Tree>
}
public class Node public constructor(public val child: Tree) {
    public companion object : Encodable<Node>
}
public struct Wrapper<T>(val value: T)
public class WrapperEncoder<T>(private val element: Encodable<T>) : Encodable<Wrapper<T>>

fun main() {
    val codec = Choice<String>.Companion.encoder(String.Companion)
    val empty: Choice<String> = Choice<String>.Empty
    check(Json.encode(empty, codec) == "{\"nothing\":{}}")
    check(Json.encode(Choice<String>.Pair("one", 1), codec) == "{\"Pair\":[\"one\",1]}")
    val record = Choice<String>.Record(value = "two", count = 2)
    check(Json.encode(record, codec) == "{\"Record\":{\"value\":\"two\",\"count\":2}}")
    val named = Choice<String>.Named("three", 99)
    check(Json.encode(named, codec) == "{\"Named\":{\"item\":\"three\",\"count\":2}}")
    check(Json.encode(Wrapper<Choice<String>>(named), WrapperEncoder<Choice<String>>(codec)) == "{\"value\":{\"Named\":{\"item\":\"three\",\"count\":2}}}")
    val tree = Tree.Branch(Node(Tree.Leaf))
    check(Json.encode(tree, Tree.Companion) == "{\"Branch\":{\"node\":{\"child\":{\"Leaf\":{}}}}}")
    println("variants-ok")
}
