struct Item(val value: Int)
interface Left : ValueEncoder<Item> {
    public override fun encode(value: Item, encoder: Encoder) { encoder.singleValue().writeLong(1L) }
}
interface Right : ValueEncoder<Item> {
    public override fun encode(value: Item, encoder: Encoder) { encoder.singleValue().writeLong(2L) }
}
object Codec : Left, Right

fun main() {}
