import bridge.*
fun main() {
    println(identity("default"))
    println(reader<Int>()(Box(42)))
    val action = add()
    println(40.action(2))
    val copy = flatten<String> { this }
    println(copy("flat"))
    val value: Any = action
    println(value is Int.(Int) -> Int)
    println(value is (Int, Int) -> Int)
}
