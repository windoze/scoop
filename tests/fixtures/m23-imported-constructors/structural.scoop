package consumer.constructors

import dependency.constructors.Token
import dependency.constructors.Wide
import dependency.constructors.TupleOps
import dependency.constructors.tupleIdentity
import dependency.constructors.tupleDefault
import dependency.constructors.tupleProjection

@NoGC public fun token(): Token = Token()
@NoGC public fun primary(): Wide {
    val fields = tupleIdentity((-29, Token(), 53))
    return Wide(17, fields._1, fields._3, fields._2)
}
@NoGC public fun secondary(): Wide {
    val fields = TupleOps().nested((Token(), (5, 8, 11), Token()))
    return Wide(fields)
}
@NoGC public fun defaults(): Long = tupleDefault() + tupleProjection(TupleOps().pair) - 12
@NoGC public fun republished(value: (Long, Token, Long) = tupleIdentity((1, Token(), 5))): Long = TupleOps().sum(value)
