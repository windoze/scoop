// EXPECT: pass
// RUN-STDOUT: effect_multi_escape_multi_arm_with_nonresuming_finally_raise.stdout
//
// T2003u5a: multiple escape-continuation arms + sibling non-resuming + finally
// 的向外传播路径。
// - source-handle 仍走 pure direct top-level direct multi-arm lowering；
// - 第一个 escape arm 通过 Raise.raise 向外传播，且 sibling custom non-resuming 仍在同一个 handle 中声明；
// - finally 在向外传播前执行一次。

import scoop.core.*

effect Ask {
    fun ask(label: String): String
}

effect Count {
    fun next(seed: Int): Int
}

effect Abort {
    fun stop(text: String): Nothing
}

fun main() {
    println("before")
    val result: Int = try {
        val value: Int = handle {
            println("body")
            val a: String = Ask.ask("first")
            println("body_unreachable_after_ask")
            val b: Int = Count.next(4)
            println("body_unreachable_after_count")
            Abort.stop(a)
            println(b)
            0
        } with {
            Ask.ask(label: String), k -> {
                println("ask_arm")
                println(label)
                Raise.raise(77)
                println("ask_unreachable")
                11
            }
            Count.next(seed: Int), k -> {
                println("count_arm_unreachable")
                println(seed)
                22
            }
            Abort.stop(text: String) -> {
                println("abort_arm_unreachable")
                println(text)
                33
            }
        } finally {
            println("finally")
        }
        println("handle_unreachable")
        value
    } catch (e: Int) {
        println("caught")
        println(e)
        e
    }
    println("result")
    println(result)
    println("done")
}
