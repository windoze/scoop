// EXPECT: pass
// RUN-STDOUT: operator_float64_arithmetic.stdout
// P8-T06: Float64 arithmetic operator and method forms match the P8 baseline.

import scoop.core.*

fun main() {
    val a: Float64 = 5.5
    val b: Float64 = 2.0
    val nan: Float64 = 0.0 / 0.0
    val posInf: Float64 = 1.0 / 0.0
    val negInf: Float64 = -1.0 / 0.0

    val plusOp: Float64 = a + b
    val plusMethod: Float64 = a.plus(b)
    val minusOp: Float64 = a - b
    val minusMethod: Float64 = a.minus(b)
    val timesOp: Float64 = a * b
    val timesMethod: Float64 = a.times(b)
    val divOp: Float64 = a / b
    val divMethod: Float64 = a.div(b)
    val remOp: Float64 = a % b
    val remMethod: Float64 = a.rem(b)
    val negOp: Float64 = -a
    val negMethod: Float64 = a.unaryMinus()

    if (!(plusOp == 7.5)) { panic("fixture assertion failed") }
    if (!(plusMethod == 7.5)) { panic("fixture assertion failed") }
    if (!(minusOp == 3.5)) { panic("fixture assertion failed") }
    if (!(minusMethod == 3.5)) { panic("fixture assertion failed") }
    if (!(timesOp == 11.0)) { panic("fixture assertion failed") }
    if (!(timesMethod == 11.0)) { panic("fixture assertion failed") }
    if (!(divOp == 2.75)) { panic("fixture assertion failed") }
    if (!(divMethod == 2.75)) { panic("fixture assertion failed") }
    if (!(remOp == 1.5)) { panic("fixture assertion failed") }
    if (!(remMethod == 1.5)) { panic("fixture assertion failed") }
    if (!(negOp == -5.5)) { panic("fixture assertion failed") }
    if (!(negMethod == -5.5)) { panic("fixture assertion failed") }
    if (!((posInf + negInf).isNaN())) { panic("fixture assertion failed") }
    if (!(posInf.plus(negInf).isNaN())) { panic("fixture assertion failed") }
    if (!((nan - 1.0).isNaN())) { panic("fixture assertion failed") }
    if (!(nan.minus(1.0).isNaN())) { panic("fixture assertion failed") }
    if (!((nan * 1.0).isNaN())) { panic("fixture assertion failed") }
    if (!(nan.times(1.0).isNaN())) { panic("fixture assertion failed") }
    if (!(nan.isNaN())) { panic("fixture assertion failed") }
    if (!(posInf.isInfinite())) { panic("fixture assertion failed") }
    if (!((nan % 1.0).isNaN())) { panic("fixture assertion failed") }
    if (!(nan.rem(1.0).isNaN())) { panic("fixture assertion failed") }
    if (!((-nan).isNaN())) { panic("fixture assertion failed") }
    if (!(nan.unaryMinus().isNaN())) { panic("fixture assertion failed") }

    println(plusOp)
    println(plusMethod)
    println(minusOp)
    println(minusMethod)
    println(timesOp)
    println(timesMethod)
    println(divOp)
    println(divMethod)
    println(remOp)
    println(remMethod)
    println(negOp)
    println(negMethod)
    println((posInf + negInf).isNaN())
    println(posInf.plus(negInf).isNaN())
    println((nan - 1.0).isNaN())
    println(nan.minus(1.0).isNaN())
    println((nan * 1.0).isNaN())
    println(nan.times(1.0).isNaN())
    println(nan.isNaN())
    println(posInf.isInfinite())
    println((nan % 1.0).isNaN())
    println(nan.rem(1.0).isNaN())
    println((-nan).isNaN())
    println(nan.unaryMinus().isNaN())
}
