// EXPECT: pass
// RUN-STDOUT: while_continue_basic.stdout
// EXPECT-EXIT: 0
//
// T0141: continue in while loop (skip iterations).

import scoop.core.*

fun main(): Int {
    // Sum only odd numbers from 1 to 10
    var sum: Int = 0
    var i: Int = 1
    while (i <= 10) {
        if (i % 2 == 0) {
            i = i + 1
            continue
        } else {
            sum = sum + i
            i = i + 1
        }
    }
    println(sum)

    // Skip multiples of 3 while counting to 15
    var count: Int = 0
    var j: Int = 1
    while (j <= 15) {
        if (j % 3 == 0) {
            j = j + 1
            continue
        } else {
            count = count + 1
            j = j + 1
        }
    }
    println(count)

    println("done")
    return 0
}
