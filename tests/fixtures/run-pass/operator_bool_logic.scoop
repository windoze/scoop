// EXPECT: pass
// RUN-STDOUT: operator_bool_logic.stdout
// P8-T06: Bool non-short-circuit methods/bit ops and short-circuit control flow.

import scoop.core.*

@Global
var calls: Int = 0

fun rhsTrue(): Bool {
    calls = calls + 1
    return true
}

fun rhsFalse(): Bool {
    calls = calls + 1
    return false
}

fun main() {
    val andOp: Bool = true & false
    val andMethod: Bool = true.and(false)
    val orOp: Bool = true | false
    val orMethod: Bool = true.or(false)
    val xorOp: Bool = true ^ false
    val xorMethod: Bool = true.xor(false)
    val xorFalseOp: Bool = true ^ true
    val xorFalseMethod: Bool = true.xor(true)
    val notOp: Bool = !true
    val notMethod: Bool = true.not()

    if (!(!andOp)) { panic("fixture assertion failed") }
    if (!(!andMethod)) { panic("fixture assertion failed") }
    if (!(orOp)) { panic("fixture assertion failed") }
    if (!(orMethod)) { panic("fixture assertion failed") }
    if (!(xorOp)) { panic("fixture assertion failed") }
    if (!(xorMethod)) { panic("fixture assertion failed") }
    if (!(!xorFalseOp)) { panic("fixture assertion failed") }
    if (!(!xorFalseMethod)) { panic("fixture assertion failed") }
    if (!(!notOp)) { panic("fixture assertion failed") }
    if (!(!notMethod)) { panic("fixture assertion failed") }

    calls = 0
    val skippedAnd: Bool = false && rhsTrue()
    if (!(!skippedAnd)) { panic("fixture assertion failed") }
    if (!(calls == 0)) { panic("fixture assertion failed") }
    val evaluatedAnd: Bool = true && rhsTrue()
    if (!(evaluatedAnd)) { panic("fixture assertion failed") }
    if (!(calls == 1)) { panic("fixture assertion failed") }

    calls = 0
    val skippedOr: Bool = true || rhsFalse()
    if (!(skippedOr)) { panic("fixture assertion failed") }
    if (!(calls == 0)) { panic("fixture assertion failed") }
    val evaluatedOr: Bool = false || rhsTrue()
    if (!(evaluatedOr)) { panic("fixture assertion failed") }
    if (!(calls == 1)) { panic("fixture assertion failed") }

    calls = 0
    val methodAnd: Bool = false.and(rhsTrue())
    if (!(!methodAnd)) { panic("fixture assertion failed") }
    if (!(calls == 1)) { panic("fixture assertion failed") }

    println(andOp)
    println(andMethod)
    println(orOp)
    println(orMethod)
    println(xorOp)
    println(xorMethod)
    println(xorFalseOp)
    println(xorFalseMethod)
    println(notOp)
    println(notMethod)
    println(skippedAnd)
    println(evaluatedAnd)
    println(skippedOr)
    println(evaluatedOr)
    println(methodAnd)
    println(calls)
}
