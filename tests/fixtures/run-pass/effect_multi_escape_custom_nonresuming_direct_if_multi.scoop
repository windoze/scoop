// EXPECT: pass
// RUN-STDOUT: effect_multi_escape_custom_nonresuming_direct_if_multi.stdout
//
// T2003c0c2b3b2: 无 immediate-resume 的 multi-arm handle
// 支持同一个 statement-position if 里的 then/else direct escape sites。
// - 运行时会按命中的分支创建 continuation；
// - `resume(...)` 后先 replay 命中的分支 tail，再继续 after-if top-level tail；
// - after-if tail 仍可命中 sibling custom non-resuming arm。

import scoop.core.*

effect Ask {
    fun ask(label: String): String
}

effect Abort {
    fun stop(text: String): Nothing
}

class Cell(var k: Continuation<String, Int>?, var seen: Int)

fun run(flag: Bool, cell: Cell, none_k: Continuation<String, Int>?) {
    cell.k = none_k
    cell.seen = 0

    val result: Int = handle {
        println("body")
        if (flag) {
            println("then_enter")
            val label: String = "then_label"
            val value: String = Ask.ask("then")
            println("then_after")
            println(label)
            println(value)
            cell.seen = 11
        } else {
            println("else_enter")
            val label: String = "else_label"
            val value: String = Ask.ask("else")
            println("else_after")
            println(label)
            println(value)
            cell.seen = 21
        }
        println("after_if")
        println(cell.seen)
        Abort.stop(if (flag) "then_abort" else "else_abort")
        99
    } with {
        Ask.ask(label: String), k -> {
            println("ask_arm")
            println(label)
            cell.k = Some(k)
            7
        }
        Abort.stop(text: String) -> {
            println("abort_arm")
            println(text)
            5
        }
    }

    println("after_handle")
    println(result)

    when (cell.k) {
        Some(k1) -> {
            cell.k = none_k
            val _: Int = try {
                k1.resume(if (flag) "resume_then" else "resume_else")
            } catch (e: RuntimeError) {
                println("unexpected_resume")
                0
            }
        }
        None -> println("missing")
    }
    println("after_resume")
}

fun main() {
    val none_k: Continuation<String, Int>? = None()
    val cell: Cell = Cell(none_k, 0)
    run(true, cell, none_k)
    run(false, cell, none_k)
    println("done")
}
