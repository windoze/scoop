// EXPECT: pass
// RUN-STDOUT: effect_multi_escape_custom_nonresuming_indirect_if_multi.stdout
//
// T2003c0c2b3c3: 无 immediate-resume 的 multi-arm handle
// 支持同一个 statement-position if 里的 then/else indirect escape sites。
// - 运行时会按命中的分支创建 continuation；
// - `resume(...)` 后先 replay 命中的分支 tail，再继续 after-if top-level tail；
// - after-if tail 里的 sibling custom non-resuming 仍由同一个 source-handle 接住。

import scoop.core.*

effect Ask {
    fun ask(seed: Int): String
}

effect Abort {
    fun stop(text: String): Nothing
}

class Cell(var k: Continuation<String>?, var seen: Int)

fun fetch(seed: Int, before: Int, after: Int, cell: Cell): String / (Ask) {
    println("fetch_enter")
    println(seed)
    cell.seen = before
    val msg: String = Ask.ask(seed + 1)
    println("fetch_resume")
    println(msg)
    cell.seen = after
    msg
}

fun run(flag: Bool, cell: Cell, none_k: Continuation<String>?) {
    cell.k = none_k
    cell.seen = 0

    val result: Int = handle {
        println("body")
        if (flag) {
            println("then_enter")
            val label: String = "then_label"
            val reply: String = fetch(10, 2, 3, cell)
            println("then_after")
            println(label)
            println(reply)
            cell.seen = 4
        } else {
            println("else_enter")
            val label: String = "else_label"
            val reply: String = fetch(20, 6, 7, cell)
            println("else_after")
            println(label)
            println(reply)
            cell.seen = 8
        }
        println("after_if")
        println(cell.seen)
        Abort.stop(if (flag) "then_abort" else "else_abort")
        99
    } with {
        Ask.ask(seed), k -> {
            println("ask_arm")
            println(seed)
            cell.k = Some(k)
            cell.seen = if (flag) 11 else 12
            7
        }
        Abort.stop(text: String) -> {
            println("abort_arm")
            println(text)
            5
        }
    }

    println("after_handle")
    println(result)
    println(cell.seen)

    when (cell.k) {
        Some(k1) -> {
            cell.k = none_k
            val _: Unit = try {
                k1.resume(if (flag) "resume_then" else "resume_else")
            } catch (e: RuntimeError) {
                println("unexpected_resume")
            }
        }
        None -> println("missing")
    }

    println("after_resume")
    println(cell.seen)
}

fun main() {
    val none_k: Continuation<String>? = None()
    val cell: Cell = Cell(none_k, 0)
    run(true, cell, none_k)
    run(false, cell, none_k)
    println("done")
}
