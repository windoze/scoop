// EXPECT: pass
// RUN-STDOUT: async_fun_task_runtime_basic.stdout
//
// T4009a1：`async fun` 与 `async {}` 统一收口为 lazy `Task<T>` sugar。
//
// 目标覆盖：
// - `async fun foo(): T` 对外返回 `Task<T>`；
// - 外层可直接通过 `join` 驱动 lazy task；
// - task body 内 `await` 另一个 `async fun` 返回的 created task 时，会通过内部 `join` helper
//   直驱其 body，而不是继续依赖“外层立即求值”旧语义。

import scoop.core.*

async fun fetchBase(): Int {
    println("base")
    return 40
}

async fun fetch(): Int {
    val x: Int = await fetchBase()
    println("fetch")
    println(x)
    return x + 2
}

fun main(): Int {
    val task: Task<Int> = fetch()
    val value: Int = handle {
        Async.await(task)
    } with {
        Async.await(taskArg: Task<Int>) -> __scoop_task_join(taskArg)
    }
    println("done")
    println(value)
    return 0
}
