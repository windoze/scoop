// EXPECT: fail
// T3006: 暂时标记为 fail——统一 state-machine codegen (T3005) 切换后，
// continuation_alloc 的 frame 指针类型不匹配（ptr vs ptr addrspace(1)）。
// RUN-STDOUT: effect_escape_continuation_finally_arm_raise.stdout
//
// T1609: escape continuation + finally when arm body raises.
//
// 目标覆盖：
// - handle body performs, arm body gets continuation;
// - arm body raises (Raise.raise) — finally 在 raise 传播前执行一次;
// - 外层 try/catch 捕获 raise 后的值正确。

import scoop.core.*

effect Ask {
    fun get(): Int
}

fun main() {
    println("before")
    val result: Int = try {
        val v: Int = handle {
            println("body_start")
            val x: Int = Ask.get()
            println("body_unreachable")
            x
        } with {
            Ask.get(), k -> {
                println("arm_start")
                // Arm raises instead of resuming
                Raise.raise(77)
                println("arm_unreachable")
                0
            }
        } finally {
            println("finally")
        }
        println("handle_unreachable")
        v
    } catch (e: Int) {
        println("caught")
        println(e)
        e
    }
    println("result")
    println(result)
    println("done")
}
