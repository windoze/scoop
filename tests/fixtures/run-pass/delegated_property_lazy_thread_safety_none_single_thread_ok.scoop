// EXPECT: pass
// RUN-STDOUT: delegated_property_lazy_thread_safety_none_single_thread_ok.stdout
//
// T1326：delegated properties 的线程安全语义（lazy）
// - `LazyThreadSafetyMode.None`：不提供并发保证，但单线程下仍应保持 “首次访问缓存” 行为。

import scoop.core.*
import scoop.delegates.*

class C() {
    val x: Int by lazy(LazyThreadSafetyMode.None) {
        println("init")
        7
    }
}

fun main(): Int {
    val c: C = C()
    println(c.x)
    println(c.x)
    return 0
}

