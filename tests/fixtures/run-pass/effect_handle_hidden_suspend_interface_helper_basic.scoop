// EXPECT: pass
// RUN-STDOUT: effect_handle_hidden_suspend_interface_helper_basic.stdout
//
// T4017f：ordinary helper 内的 outward-effect itable dispatch 应走显式 outcome boundary。
// - helper() 自身是 ordinary effectful callee，内部通过 interface dispatch 调用 effectful impl；
// - outward-effect 后 `helper_unreachable` 不能执行；
// - outer handle 仍需命中并得到正确结果。

import scoop.core.*

effect Ask {
    fun ask(seed: Int): Int
}

interface IFace {
    fun ping(): Int / (Ask)
}

class Impl() : IFace {
    fun ping(): Int / (Ask) {
        println("impl")
        Ask.ask(52)
    }
}

fun helper(face: IFace): Int / (Ask) {
    println("helper_before")
    val value: Int = face.ping()
    println("helper_unreachable")
    return value
}

fun main(): Int {
    val face: IFace = Impl()
    val result: Int = handle {
        helper(face)
    } on {
        Ask.ask(seed) -> seed + 1
    }

    println(result)
    println("done")
    return 0
}
