//
// T4016T7：同一 task 在自己的 body 内重入 `step()` 必须直接 trap，而不是回落为 `Pending`。

import scoop.core.*

class Holder(var task: Task<Int>)

fun main() {
    val holder: Holder = Holder(__task_from_result(0))
    val task: Task<Int> = async {
        val _nested: TaskStep<Int> = holder.task.step()
        7
    }

    holder.task = task
    val _step: TaskStep<Int> = task.step()
}
