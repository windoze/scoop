// EXPECT: pass
// RUN-STDOUT: effect_raise_trace_hook_basic.stdout
//
// T1411c: non-resuming effect 的 unwind/诊断 hook：记录 `Raise.raise(...)` 的 call-site（line/col）。

import scoop.core.*
import scoop.unsafe.*

@Extern("scoop_effect_trace_src_line")
fun effect_trace_src_line(): Int

@Extern("scoop_effect_trace_src_col")
fun effect_trace_src_col(): Int

fun boom(): Int / Raise<RuntimeError> {
    Raise.raise(RuntimeError.NullAssertionFailed)
    return 0
}

fun main(): Int {
    val x: Int = try {
        val _y: Int = boom()
        _y
    } catch (e: RuntimeError) {
        @Unsafe {
            println(effect_trace_src_line())
            println(effect_trace_src_col())
        }
        0
    }
    return x
}
