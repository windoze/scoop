// EXPECT: pass
// RUN-MODE: dump-stackmaps
// RUN-STDOUT-CONTAINS: records:
// RUN-STDOUT-CONTAINS: verify-roots: ok
// RUN-STDOUT-CONTAINS: root-slots:
// RUN-STACKMAPS-RECORDS-GT: 0
//
// 目标：GC-FIX Phase C2d：补齐端到端回归（closure capture）。
// - closure 返回值与捕获环境（含 `String` ref）在 statepoint/stackmap 下应能产出可解析的 stackmaps。

package fixtures.codegen

import scoop.core.*

fun callAfterGc(f: () -> Int): Int {
    __scoop_gc_collect()
    return f()
}

fun main(): Int {
    val s: String = f"hello {7}"
    return callAfterGc {
        println(f"closure={s}")
        0
    }
}
