// EXPECT: pass
// RUN-STDOUT: effect_handle_top_level_val_pattern_access_basic.stdout
//
// T4004R：顶层 pattern binder 在 handle / try 的 state-machine 路径里，仍需复用与局部 destructuring
// 一致的运行期校验语义：
// - 匹配成功时，隐藏的 top-level once-init boundary 走 inactive path，后续表达式继续执行；
// - 匹配失败时，隐藏 check 必须把 `Raise.raise(RuntimeError.*)` 交给 handler dispatch，
//   不能被顶层 guard 检查误判成递归初始化并 `exit(1)`。

import scoop.core.*

enum MaybeInt {
    Present(val value: Int),
    Missing,
}

fun seedReadyPair(): (MaybeInt, Int) {
    println("seed-ready")
    val ready: MaybeInt = Present(7)
    return (ready, 1)
}

fun seedBoomPair(): (MaybeInt, Int) {
    println("seed-boom")
    val missing: MaybeInt = Missing()
    return (missing, 1)
}

val (Present(_), readyY) = seedReadyPair()
val (Present(_), boomY) = seedBoomPair()

fun main(): Int {
    val inactiveResult: Int = handle {
        println("inactive_before")
        val value: Int = readyY + 1
        println("inactive_after")
        value
    } with {
        Raise.raise(err: RuntimeError) -> 10
    }
    println(inactiveResult)

    val activeResult: Int = handle {
        println("active_before")
        val value: Int = boomY + 1
        println("active_unreachable")
        value
    } with {
        Raise.raise(err: RuntimeError) -> 10
    }
    println(activeResult)

    println("done")
    return 0
}
