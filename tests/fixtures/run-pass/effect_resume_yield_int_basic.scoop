// EXPECT: pass
// T3010b2b: resume landing 现已只继续剩余 tail，不再重放 suspend 前路径。
// RUN-STDOUT: effect_resume_yield_int_basic.stdout
//
// T0616/T4016b1：旧 `-> resume` surface 已迁移为 `, k ->` + `k.resume(...)`，
// 但内部 tail-resume fast path 仍需保持可执行。
//
// 目标覆盖：
// - 自定义 effect op 在 `handle ... on { ... , k -> { ... } }` 下可被捕获；
// - arm 内调用 `k.resume(value)` 后，handle body 能继续执行并使用该返回值。

import scoop.core.*

effect Yield {
    fun next(): Int
}

fun main(): Int {
    val result: Int = handle {
        println("before")
        val x: Int = Yield.next()
        println("after")
        println(x)
        x + 1
    } on {
        Yield.next() , k -> {
            println("in_handler")
            k.resume(41)
        }
    }

    println("done")
    println(result)
    return 0
}
