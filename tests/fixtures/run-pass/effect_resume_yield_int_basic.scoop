// EXPECT: pass
// RUN-STDOUT: effect_resume_yield_int_basic.stdout
//
// T0616: lowering step 2（最小）：`-> resume`（栈 state machine）
//
// 目标覆盖：
// - 自定义 effect op 在 `handle ... with { ... -> resume { ... } }` 下可被捕获；
// - arm 内调用 `resume(value)` 后，handle body 能继续执行并使用该返回值。

import scoop.core.*

effect Yield {
    fun next(): Int
}

fun main(): Int {
    val result: Int = handle {
        println("before")
        val x: Int = Yield.next()
        println("after")
        println(x)
        x + 1
    } with {
        Yield.next() -> resume {
            println("in_handler")
            resume(41)
        }
    }

    println("done")
    println(result)
    return 0
}

