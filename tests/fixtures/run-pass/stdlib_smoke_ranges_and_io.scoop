// EXPECT: pass
// RUN-STDOUT: stdlib_smoke_ranges_and_io.stdout
// EXPECT-EXIT: 0
//
// stdlib smoke test: ranges/progressions + IO (IntProgression, rangeTo, downTo, forEach, println)
// Exercises range-based computation patterns with observable IO output.

import scoop.core.*

fun main(): Int {
    // --- Range ascending: 1..5 ---
    println("ascending")
    val start: Int = 1
    start.rangeTo(5, 1).forEach { println(it) }

    // --- Countdown from 5 to 1 using downTo ---
    println("countdown")
    val hi: Int = 5
    hi.downTo(1, 1).forEach { println(it) }

    // --- Step-2 range: even numbers 2,4,6,8,10 ---
    println("evens")
    val two: Int = 2
    two.rangeTo(10, 2).forEach { println(it) }

    // --- Step-3 descending: 10,7,4,1 ---
    println("step_down")
    val ten: Int = 10
    ten.downTo(1, 3).forEach { println(it) }

    // --- forEach with multiplication ---
    println("doubled")
    start.rangeTo(5, 1).forEach { println(it * 2) }

    println("done")
    return 0
}
