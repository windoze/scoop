// EXPECT: pass
// RUN-STDOUT: effect_handle_suspend_call_inactive_helper_basic.stdout
//
// T3009b0a1c：统一 SuspendCall 在 callee inactive 返回时必须继续 caller-tail。
// - `helper(false)` 仍会被分类成 unified suspend call boundary，但它本次不会 perform；
// - inactive 路径必须继续执行 `+ 1` 与 `inactive_after`，不能误走 continuation + dispatch；
// - 同一 fixture 也顺带锁住 active 路径，避免修 inactive 时破坏已有 dispatch 合同。

import scoop.core.*

effect Ask {
    fun ask(): Int
}

fun helper(flag: Bool): Int / (Ask) {
    println("helper_before")
    if (flag) {
        println("helper_suspend")
        return Ask.ask()
    }

    println("helper_direct")
    println("helper_after")
    return 7
}

fun main(): Int {
    val inactive_result: Int = handle {
        println("inactive_before")
        val value: Int = helper(false) + 1
        println("inactive_after")
        value
    } with {
        Ask.ask() -> resume {
            resume(2)
        }
    }
    println(inactive_result)

    val active_result: Int = handle {
        println("active_before")
        val value: Int = helper(true) + 1
        println("active_after")
        value
    } with {
        Ask.ask() -> resume {
            resume(2)
        }
    }
    println(active_result)

    println("done")
    return 0
}
