// EXPECT: pass
// RUN-STDOUT: effect_resume_mixed_multi_escape_direct_indirect.stdout
//
// T2003r3d4b: unified mixed multi-resuming leaf（1 immediate + N escape）代表样例。
// - `Yield.next()` 先命中唯一 immediate-resume arm；
// - resume 后依次覆盖 direct `Ask.ask(...)` 与 indirect `Count.next(...)` 两个 escape arms；
// - sibling non-resuming `Abort.stop(...)` 与 `finally` 继续复用同一套 unified contract。

import scoop.core.*

effect Yield {
    fun next(): Int
}

effect Ask {
    fun ask(seed: Int): String
}

effect Count {
    fun next(seed: Int): String
}

effect Abort {
    fun stop(text: String): Nothing
}

fun countIndirect(base: Int): String / (Count) {
    println("countIndirect_enter")
    val msg: String = Count.next(base + 20)
    println("countIndirect_resume")
    println(msg)
    msg
}

class Cell(var k: Continuation<String, Int>?, var seen: Int)

fun main() {
    val none_k: Continuation<String, Int>? = None()
    val cell: Cell = Cell(none_k, 0)

    val result: Int = handle {
        println("body")
        val base: Int = Yield.next()
        println("after_yield")
        println(base)

        val first: String = Ask.ask(base + 1)
        println("after_first")
        println(first)

        val second: String = countIndirect(base)
        println("after_second")
        println(first)
        println(second)

        Abort.stop(second)
        99
    } with {
        Yield.next() , k -> {
            println("yield_arm")
            k.resume(40)
        }
        Ask.ask(seed), k -> {
            cell.seen = cell.seen + 1
            println("ask_arm")
            println(cell.seen)
            println(seed)
            cell.k = Some(k)
            7
        }
        Count.next(seed), k -> {
            cell.seen = cell.seen + 1
            println("count_arm")
            println(cell.seen)
            println(seed)
            cell.k = Some(k)
            8
        }
        Abort.stop(text: String) -> {
            println("abort_arm")
            println(text)
            5
        }
    } finally {
        println("cleanup")
    }

    println("after_handle")
    println(result)

    when (cell.k) {
        Some(k1) -> {
            cell.k = none_k
            val _: Int = try {
                k1.resume("hello")
            } catch (e: RuntimeError) {
                println("unexpected_resume1")
                0
            }
        }
        None -> println("missing1")
    }
    println("after_resume1")

    when (cell.k) {
        Some(k2) -> {
            cell.k = none_k
            val _: Int = try {
                k2.resume("world")
            } catch (e: RuntimeError) {
                println("unexpected_resume2")
                0
            }
        }
        None -> println("missing2")
    }
    println("after_resume2")
    println("done")
}
