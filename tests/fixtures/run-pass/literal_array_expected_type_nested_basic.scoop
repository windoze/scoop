// EXPECT: pass
// RUN-STDOUT: literal_array_expected_type_nested_basic.stdout
// 目标：T0150h-2 数组字面量元素的 expected type 能继续传播到 if / when / 嵌套数组 / 函数参数 / 返回值。

import scoop.core.*

fun takeByte(xs: Array<UInt8>): UInt8 {
    return xs.get(0)
}

fun takeFloat(xs: Array<Float32>): Float32 {
    return xs.get(0)
}

fun retMatrix(flag: Bool): Array<Array<Float32>> {
    return [
        [if (flag) { 1.5 } else { 2.5f }],
        [when (flag) {
            true -> 3.5
            false -> 4.5f
        }],
    ]
}

fun main(): Int {
    val bytes: Array<UInt8> = [if (true) { 1 + 2 } else { 9 }]
    val floats: Array<Float32> = [when (false) {
        true -> 1.5
        false -> 2.5f
    }]
    val argByte: UInt8 = takeByte([if (false) { 7 } else { 4 }])
    val argFloat: Float32 = takeFloat([if (true) { 0.25 + 0.5 } else { 1.0f }])

    val matrix: Array<Array<Float32>> = retMatrix(true)
    val firstRow: Array<Float32> = matrix.get(0)
    val secondRow: Array<Float32> = matrix.get(1)

    println((bytes.get(0) == 3).toString())
    println(floats.get(0).toString())
    println((argByte == 4).toString())
    println(argFloat.toString())
    println(firstRow.get(0).toString())
    println(secondRow.get(0).toString())

    return 0
}
