// EXPECT: pass
// RUN-STDOUT: get_platform_runtime_basic.stdout
//
// 回归：`getPlatform()` 继续走真实运行期 lowering，而不是退回 declaration-only 调用。

import scoop.core.*

fun main(): Int {
    val p: Platform = getPlatform()
    println(p.triple != "")
    println(p.arch != "")
    println(p.vendor != "")
    println(p.os != "")
    println(p.env == p.env)
    return 0
}
