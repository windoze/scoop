// EXPECT: fail
// T3006: 暂时标记为 fail——统一 state-machine codegen (T3005) 切换后，
// continuation_alloc 的 frame 指针类型不匹配（ptr vs ptr addrspace(1)）。
// RUN-STDOUT: kotlin_require_check_basic.stdout
//
// T1315a：stdlib 注入（pure scoop prelude）+ Kotlin-like preconditions
// - `require(false)` / `check(false)` 应通过 `Raise<RuntimeError>` 可被 try/catch 捕获。

import scoop.core.*

fun main(): Int {
    println("before")

    val a: Int = try {
        require(false)
        1
    } catch (e: RuntimeError) {
        when (e) {
            NullAssertionFailed -> 10
            ClassCastFailed -> 11
            ContinuationAlreadyResumed -> 30
        }
    }

    val b: Int = try {
        check(false)
        2
    } catch (e: RuntimeError) {
        when (e) {
            NullAssertionFailed -> 12
            ClassCastFailed -> 20
            ContinuationAlreadyResumed -> 31
        }
    }

    println(a)
    println(b)
    println("after")
    return 0
}
