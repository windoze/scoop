// EXPECT: pass
// RUN-STDOUT: effect_resume_mixed_escape_pre_immediate_if_indirect.stdout
//
// T2003c0b2c3b: mixed-arm immediate-resume + sibling escape-continuation
// supports if then/else branch indirect escape sites before the immediate site
// and resumes through the matching branch tail before continuing after the if.

import scoop.core.*

effect Yield {
    fun next(): Int
}

effect Ask {
    fun ask(seed: Int): String
}

class Cell(var k: Continuation<String>?, var seen: Int)

fun fetch(seed: Int, before: Int, after: Int, cell: Cell): String / (Ask) {
    cell.seen = before
    val msg: String = Ask.ask(seed)
    cell.seen = after
    msg
}

fun run(flag: Bool, cell: Cell, none_k: Continuation<String>?) {
    cell.k = none_k
    cell.seen = 0

    val result: Int = handle {
        if (flag) {
            val reply: String = fetch(10, 2, 3, cell)
            cell.seen = 4
            val _: String = reply
        } else {
            val reply: String = fetch(20, 6, 7, cell)
            cell.seen = 8
            val _: String = reply
        }
        val x: Int = Yield.next()
        cell.seen = cell.seen + 10
        x + 1
    } with {
        Yield.next() -> resume {
            resume(41)
        }
        Ask.ask(seed), k -> {
            cell.k = Some(k)
            cell.seen = if (flag) 11 else 12
            7
        }
    }

    println(result)
    println(cell.seen)

    when (cell.k) {
        Some(k1) -> {
            cell.k = none_k
            val _: Unit = try {
                k1.resume(if (flag) "then" else "else")
            } catch (e: RuntimeError) {
                println(-99)
            }
            println(cell.seen)
        }
        None -> println(-1)
    }
}

fun main() {
    val none_k: Continuation<String>? = None()
    val cell: Cell = Cell(none_k, 0)
    run(true, cell, none_k)
    run(false, cell, none_k)
}
