// EXPECT: pass
// RUN-STDOUT: generic_fun_higher_order.stdout
// EXPECT-EXIT: 0
//
// T0127: Generic higher-order function — takes a lambda parameter.

import scoop.core.*

fun callFn<T>(v: T, f: (T) -> T): T {
    return f(v)
}

fun main(): Int {
    val result: Int = callFn(21, { x: Int -> x + x })
    println(result)
    0
}
