// EXPECT: pass
// RUN-STDOUT: type_check_cast_is_as_asq_basic.stdout
//
// T1509b：`is/!is/as/as?` 端到端 codegen（ref 对象模型）
//
// 覆盖点：
// - `x is IFace` / `x !is IFace`：interface 走 itable 检查；
// - `x is Base` / `x is Other`：class 走 type descriptor parent 链检查；
// - `x as IFace`：成功转换后可进行 interface dispatch；
// - `x as? T`：失败返回 `None`；
// - `x as T`：失败触发 `Raise.raise(RuntimeError.ClassCastFailed)`，可被 try/catch 捕获。

import scoop.core.*

interface IFace {
    fun ping(): Int
}

open class Base() {
    fun baseTag(): Int {
        return 10
    }
}

class Impl() : Base(), IFace {
    fun ping(): Int {
        println("Impl.ping")
        return 42
    }
}

class Other() : Base()

fun printBool(label: String, b: Bool): Unit {
    when (b) {
        true -> println(f"{label}: true")
        false -> println(f"{label}: false")
    }
}

fun main(): Int {
    val x: Any = Impl()

    printBool("x is IFace", x is IFace)
    printBool("x !is IFace", x !is IFace)
    printBool("x is Other", x is Other)
    printBool("x !is Other", x !is Other)
    printBool("x is Base", x is Base)

    // `as` 可能失败，因此必须在 try/catch 内使用（否则 main 不再是 Pure，typecheck 会拒绝）。
    val _cast_iface_ok: Unit = try {
        val i: IFace = x as IFace
        val v: Int = i.ping()
        println(v)
    } catch (e: RuntimeError) {
        println("unreachable: cast IFace")
    }

    val _cast_base_ok: Unit = try {
        val b: Base = x as Base
        println(b.baseTag())
    } catch (e: RuntimeError) {
        println("unreachable: cast Base")
    }

    val ok: IFace? = x as? IFace
    when (ok) {
        Some(_y) -> println("as?: IFace ok")
        None -> println("as?: IFace bad")
    }

    val bad: Other? = x as? Other
    when (bad) {
        Some(_y) -> println("as?: Other bad")
        None -> println("as?: Other ok")
    }

    val caught: Int = try {
        val _o: Other = x as Other
        println("unreachable")
        0
    } catch (e: RuntimeError) {
        when (e) {
            NullAssertionFailed -> {
                println("caught: null")
                1
            }
            ClassCastFailed -> {
                println("caught: cast")
                2
            }
            ContinuationAlreadyResumed -> {
                println("caught: resumed")
                3
            }
        }
    }

    println(caught)
    println("done")
    return 0
}
