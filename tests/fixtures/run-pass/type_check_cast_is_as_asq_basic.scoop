// EXPECT: pass
// RUN-STDOUT: type_check_cast_is_as_asq_basic.stdout
//
// T1509b：`is/!is/as/as?` 端到端 codegen（ref 对象模型）
//
// 覆盖点：
// - `x is IFace` / `x !is IFace`：interface 走 itable 检查；
// - `x is Base` / `x is Other`：class 走 type descriptor parent 链检查；
// - `x as IFace`：成功转换后可进行 interface dispatch；
// - `x as? T`：失败返回 `None`；
// - `x as T`：成功转换后保留目标类型；失败 panic 由单独 fixture 覆盖。

import scoop.core.*

interface IFace {
    fun ping(): Int
}

open class Base() {
    fun baseTag(): Int {
        return 10
    }
}

class Impl() : Base(), IFace {
    fun ping(): Int {
        println("Impl.ping")
        return 42
    }
}

class Other() : Base()

fun printBool(label: String, b: Bool): Unit {
    when (b) {
        true -> println(f"${label}: true")
        false -> println(f"${label}: false")
    }
}

fun main(): Int {
    val x: Any = Impl()

    printBool("x is IFace", x is IFace)
    printBool("x !is IFace", x !is IFace)
    printBool("x is Other", x is Other)
    printBool("x !is Other", x !is Other)
    printBool("x is Base", x is Base)

    val i: IFace = x as IFace
    val v: Int = i.ping()
    println(v)

    val b: Base = x as Base
    println(b.baseTag())

    val ok: IFace? = x as? IFace
    when (ok) {
        Some(_y) -> println("as?: IFace ok")
        None -> println("as?: IFace bad")
    }

    val bad: Other? = x as? Other
    when (bad) {
        Some(_y) -> println("as?: Other bad")
        None -> println("as?: Other ok")
    }

    println("done")
    return 0
}
