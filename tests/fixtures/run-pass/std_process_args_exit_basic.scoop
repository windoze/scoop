// EXPECT: pass
// EXPECT-EXIT: 0
// RUN-STDOUT: std_process_args_exit_basic.stdout
// ARGS: foo bar
//
// T5000e3c：argv 直接经由 `main(args)` 进入程序边界：
// - `args` 必须包含完整 native argv，因此这里的 size 应为 3（含 argv[0]）；
// - `args[0]` 的具体路径不稳定，因此只断言它是非空字符串；
// - 其余用户参数应保持原顺序。

import scoop.core.*

fun main(args: Array<String>) {
    println(args.size())
    println(args.get(0).length() > 0)
    println(args.get(1))
    println(args.get(2))
}
