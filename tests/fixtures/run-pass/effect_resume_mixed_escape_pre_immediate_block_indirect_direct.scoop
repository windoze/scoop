// EXPECT: pass
// RUN-STDOUT: effect_resume_mixed_escape_pre_immediate_block_indirect_direct.stdout
//
// T2003c0b2c3d1: mixed-arm immediate-resume + sibling escape-continuation
// supports a single indirect site followed by a single direct site inside the
// same statement-position nested block before the immediate site.
// Current `@Safe { ... }` is only a temporary naked-block workaround until
// T2201/T2203 lands; this fixture does not depend on safe-region semantics.

import scoop.core.*

effect Yield {
    fun next(): Int
}

effect Ask {
    fun ask(seed: Int): String
}

class Cell(var k: Continuation<String>?)

fun fetch(base: Int, label: String): String / (Ask) {
    println("fetch_enter")
    println(label)
    val msg: String = Ask.ask(base + 1)
    println("fetch_resume")
    println(msg)
    println(label)
    msg
}

fun main() {
    val none_k: Continuation<String>? = None()
    val cell: Cell = Cell(none_k)

    val result: Int = handle {
        println("body")
        @Safe {
            println("block_enter")
            val label: String = "pre"
            val indirect: String = fetch(10, label)
            println("after_indirect")
            println(indirect)
            println(label)
            val direct: String = Ask.ask(20)
            println("after_direct")
            println(direct)
            println(label)
        }
        val x: Int = Yield.next()
        println("after_yield")
        println(x)
        x + 1
    } with {
        Yield.next() -> resume {
            println("yield_arm")
            resume(41)
        }
        Ask.ask(seed), k -> {
            println("ask_arm")
            println(seed)
            cell.k = Some(k)
            7
        }
    }

    println("after_handle")
    println(result)

    when (cell.k) {
        Some(k1) -> {
            cell.k = none_k
            val _: Unit = try {
                k1.resume("hello")
            } catch (e: RuntimeError) {
                println("unexpected_error1")
            }
            println("after_resume1")
        }
        None -> println("missing1")
    }

    when (cell.k) {
        Some(k2) -> {
            cell.k = none_k
            val _: Unit = try {
                k2.resume("world")
            } catch (e: RuntimeError) {
                println("unexpected_error2")
            }
            println("after_resume2")
        }
        None -> println("missing2")
    }

    println("done")
}
