// EXPECT: pass
// RUN-STDOUT: kotlin_scope_functions_basic.stdout
// EXPECT-EXIT: 0
//
// T1315b：pure-scoop core runtime helpers（scope functions：also/let/run/apply）

import scoop.core.*

fun main(): Int {
    println("start")

    val x: Int = 41
    val a: Int = x.also {
        println("also block")
        println(it)
    }
    println(a)

    x.let {
        println("let block")
        println(it)
        0
    }

    x.run {
        println("run block")
        println(it)
        0
    }

    val y: Int = 7
    val d: Int = y.apply {
        println("apply block")
        println(it)
    }
    println(d)

    return 0
}
