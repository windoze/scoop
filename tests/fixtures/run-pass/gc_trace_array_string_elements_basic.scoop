// EXPECT: pass
// RUN-STDOUT: gc_trace_array_string_elements_basic.stdout
//
// 目标：T1507a
// - `Array<String>` 的元素槽位必须被 GC 扫描（runtime array descriptor + trace_fn）。
// - 仅通过 array 元素持有两个字符串，在 `__scoop_gc_collect()` 后仍可读取并打印。

import scoop.core.*

fun make(): Array<String> {
    val xs: Array<String> = ["a", "b"]
    return xs
}

fun main(): Int {
    val xs: Array<String> = make()
    __scoop_gc_collect()
    println(xs.get(0))
    println(xs.get(1))
    return 0
}
