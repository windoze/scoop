// EXPECT: pass
// RUN-STDOUT: effect_handle_nested_handle_boundary_inactive_basic.stdout
//
// T3009b0a1e：统一 NestedHandleBoundary 在 inactive 返回时必须继续 outer caller-tail。
// - inner handle 即便内部确实 suspend/resume 过，只要最终 inactive 返回，outer handle
//   就必须继续执行 `+ 10` 与 `inactive_outer_after`；
// - 这条 inactive-path 不能靠重跑 inner handle 实现，否则 `inactive_inner_*` 会重复输出；
// - active 路径仍要交回 outer dispatch，不能继续执行 `active_outer_after`。

import scoop.core.*

effect Ask {
    fun ask(): Int
}

fun main(): Int {
    val inactive_result: Int = handle {
        println("inactive_outer_before")
        val value: Int = (handle {
            println("inactive_inner_before")
            val inner: Int = Ask.ask()
            println("inactive_inner_after")
            inner + 1
        } with {
            Ask.ask() , k -> {
                k.resume(7)
            }
        }) + 10
        println("inactive_outer_after")
        value
    } with {
        Ask.ask() -> 99
    }
    println(inactive_result)

    val active_result: Int = handle {
        println("active_outer_before")
        val value: Int = (handle {
            println("active_inner_before")
            val inner: Int = Ask.ask()
            println("active_inner_after")
            inner + 1
        } with {
            Raise.raise(err: RuntimeError) -> 0
        }) + 10
        println("active_outer_after")
        value
    } with {
        Ask.ask() -> 5
    }
    println(active_result)

    println("done")
    return 0
}
