// EXPECT: pass
// RUN-STDOUT: effect_resume_mixed_escape_post_immediate_while_nested_block_if_indirect.stdout
//
// T2003u5d2: mixed-arm immediate-resume + sibling escape-continuation
// supports a richer nested indirect escape site inside `while -> block -> if`
// after the immediate site.
// Current `@Safe { ... }` is only a temporary naked-block workaround until
// T2203 lands; this fixture does not depend on safe-region semantics.

import scoop.core.*

effect Yield {
    fun next(): Int
}

effect Ask {
    fun ask(seed: Int): String
}

class Cell(var k: Continuation<String>?)

fun fetch(seed: Int): String / (Ask) {
    val msg: String = Ask.ask(seed)
    msg
}

fun main() {
    val none_k: Continuation<String>? = None()
    val cell: Cell = Cell(none_k)

    val result: Int = handle {
        println("body")
        val x: Int = Yield.next()
        println("after_yield")
        var i: Int = 0
        while (i < 3) {
            println("iter_begin")
            @Safe {
                println("block_enter")
                if (i == 1) {
                    println("then_enter")
                    val marker: String = "indirect_marker"
                    val first: String = fetch(i)
                    println("after_ask")
                    println(first)
                    println(marker)
                } else {
                    println("skip_branch")
                }
            }
            i = i + 1
            println("iter_end")
        }
        println("after_while_done")
        x + i
    } with {
        Yield.next() -> resume {
            println("yield_arm")
            resume(40)
        }
        Ask.ask(seed), k -> {
            println("ask_arm")
            cell.k = Some(k)
            7
        }
    }

    println("after_handle")
    val _: Int = result

    when (cell.k) {
        Some(k1) -> {
            cell.k = none_k
            val _: Unit = try {
                k1.resume("resume_then")
            } catch (e: RuntimeError) {
                println("unexpected_error")
            }
            println("after_resume")
        }
        None -> println("missing")
    }

    println("done")
}
