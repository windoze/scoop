// EXPECT: pass
// RUN-STDOUT: task_step_cross_thread_sequential_handoff_basic.stdout
// TIMEOUT: 3000
//
// T4016T8：不同线程顺序 handoff 同一 task 仍应有效；只有并发 / reentrant drive 才是 trap。
// 注意：worker 线程必须等 main 已完成首个 `step()` 并发布 `Waiting(...)` 后再接手，
// 否则就会退化成错误的并发 `step()`，应由 trap fixture 覆盖而不是由本用例吸收。

import scoop.core.*
import scoop.thread.*

fun main() {
    val inner: Task<Int> = async {
        println("inner")
        41
    }

    val outer: Task<Int> = async {
        println("outer-before")
        val value: Int = await inner
        println("outer-after")
        println(value)
        value + 1
    }

    when (outer.step()) {
        TaskStep.Pending -> println("main-pending")
        TaskStep.Ready(value) -> {
            println("main-ready")
            println(value)
        }
    }

    val workerThread: Thread = threadSpawn {
        when (outer.step()) {
            TaskStep.Pending -> println("worker-pending")
            TaskStep.Ready(value) -> {
                println("worker-ready")
                println(value)
            }
        }
    }

    workerThread.join()

    when (outer.step()) {
        TaskStep.Pending -> println("main-final-pending")
        TaskStep.Ready(value) -> {
            println("main-final-ready")
            println(value)
        }
    }
}
