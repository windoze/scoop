// EXPECT: pass
// RUN-STDOUT: std_path_basic.stdout
//
// 目标：T1318d `scoop.path`（normalize/join/basename/dirname）最小行为可回归。
// 说明：当前仅按 host 分隔符规则实现（POSIX 为 `/`）。

import scoop.core.*
import scoop.path.normalize
import scoop.path.join as pathJoin
import scoop.path.basename
import scoop.path.dirname

fun main() {
    println(normalize("/a//b/"))
    println(pathJoin("/a", "b"))
    println(pathJoin("a/", "b"))

    println(basename("/a/b/c.txt"))
    println(dirname("/a/b/c.txt"))

    println(basename("a/b/"))
    println(dirname("a/b/"))

    println(dirname("a"))
    println(basename("a"))

    println(basename("/"))
    println(dirname("/"))
}
