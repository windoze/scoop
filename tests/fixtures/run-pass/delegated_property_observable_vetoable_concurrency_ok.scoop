// EXPECT: pass
// RUN-STDOUT: delegated_property_observable_vetoable_concurrency_ok.stdout
// TIMEOUT: 30000
//
// T1326b：observable/vetoable 的并发可见性与回调规则（host/pthread 最小回归）
// - observable：写入后触发回调（old/new）；并发读写应具备可见性（无 data race）
// - vetoable：写入前触发回调；返回 false 时拒绝更新；并发下 veto 失败分支不应污染可见值
//
// 说明：为保持 stdout golden 稳定，这里用 `scoop.sync` 控制两个线程的写入顺序。
// SYSROOT-DEPS: scoop.thread scoop.sync

import scoop.core.*
import scoop.delegates.*
import scoop.sync.*
import scoop.thread.*

class SyncState(
    val lock: Mutex,
    val cv: CondVar,
    var readyCount: Int,
    var phase: Int,
    var doneCount: Int,
    var callbackCount: Int,
    var callback1: Int,
    var callback2: Int
)

class C() {
    var score: Int by observable(0) { old, new ->
        println(f"score: ${old} -> ${new}")
        val st: SyncState = Shared.state
        st.lock.lock()
        when (st.callbackCount == 0) {
            true -> {
                st.callback1 = new
            }
            false -> {
                st.callback2 = new
            }
        }
        st.callbackCount = st.callbackCount + 1
        st.cv.notifyAll()
        st.lock.unlock()
    }

    var age: Int by vetoable(0) { old, new ->
        println(f"age try: ${old} -> ${new}")
        new >= 0
    }
}

object Shared {
    val c: C = C()
    val state: SyncState = SyncState(mutexCreate(), condVarCreate(), 0, 0, 0, 0, 0, 0)
}

fun worker1() {
    val st: SyncState = Shared.state
    st.lock.lock()
    st.readyCount = st.readyCount + 1
    st.cv.notifyAll()
    while (st.phase != 1) {
        st.cv.wait(st.lock)
    }
    st.lock.unlock()

    val c: C = Shared.c
    c.score = 1
    c.age = 5

    st.lock.lock()
    st.phase = 2
    st.doneCount = st.doneCount + 1
    st.cv.notifyAll()
    st.lock.unlock()
}

fun worker2() {
    val st: SyncState = Shared.state
    st.lock.lock()
    st.readyCount = st.readyCount + 1
    st.cv.notifyAll()
    while (st.phase != 2) {
        st.cv.wait(st.lock)
    }
    st.lock.unlock()

    val c: C = Shared.c
    c.score = 2
    c.age = -1 // vetoable：应拒绝

    st.lock.lock()
    st.doneCount = st.doneCount + 1
    st.cv.notifyAll()
    st.lock.unlock()
}

fun main(): Int {
    val st: SyncState = Shared.state
    val c: C = Shared.c

    val t1: Thread = threadSpawn { worker1() }
    val t2: Thread = threadSpawn { worker2() }

    st.lock.lock()
    while (st.readyCount < 2) {
        st.cv.wait(st.lock)
    }
    println("start")
    st.phase = 1
    st.cv.notifyAll()
    while (st.doneCount < 2 || st.callbackCount < 2) {
        st.cv.wait(st.lock)
    }
    val callback1: Int = st.callback1
    val callback2: Int = st.callback2
    st.lock.unlock()

    t1.join()
    t2.join()

    println(f"callbacks=${callback1}+${callback2}")
    println(f"final_score=${c.score}")
    println(f"final_age=${c.age}")
    println("ok")
    return 0
}
