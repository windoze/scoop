// EXPECT: pass
// RUN-STDOUT: kotlin_ranges_progressions_basic.stdout
// EXPECT-EXIT: 0
//
// T1315c：pure-scoop ranges/progressions 与最小惰性迭代（v0）
//
// 说明：
// - `..` syntax sugar / `until` / direct `for (x in a..b)` 集成已在 T1819 补齐；
// - `for` 本身已支持 `IntProgression` / `Array<Int>` / custom iterator 的 lowering；
// - v0 先通过 `Int.rangeTo/downTo + forEach` 作为可回归落点；
// - step 由调用方显式传入，避免 support source 在非入口文件中引入 Int 字面量（multi-file lowering 门禁）。

import scoop.core.*

fun main(): Int {
    println("up")
    val upStart: Int = 1
    val up: IntProgression = upStart.rangeTo(5, 2)
    up.forEach { println(it) }

    println("down")
    val downStart: Int = 5
    val down: IntProgression = downStart.downTo(1, 2)
    down.forEach { println(it) }

    println("done")
    return 0
}
