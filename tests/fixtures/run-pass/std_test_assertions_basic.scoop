// EXPECT: pass
// RUN-STDOUT: std_test_assertions_basic.stdout
//
// 目标：T1320a `scoop.test` 最小断言工具（assertions）run-pass 可执行回归。

import scoop.core.*
import scoop.test.*

fun main(): Int {
    // 说明：
    // - `assert*` 会在类型层声明 `Raise<RuntimeError>`；
    // - 入口 `main` 当前阶段必须是 Pure，因此这里用 try/catch 显式处理潜在的 Raise。
    val exitCode: Int = try {
        assertTrue(true)
        println("assertTrue: ok")

        assertFalse(false)
        println("assertFalse: ok")

        assertEqInt(1, 1)
        println("assertEqInt: ok")

        // 说明：当前阶段 enum variant ctor（如 `Some(7)`）需要明确的期望 enum 类型语境；
        // 这里先通过显式类型注解固定为 `Int?`（即 `Option<Int>`）。
        val some: Int? = Some(7)
        val v: Int = assertSomeInt(some)
        println("assertSomeInt: ok")
        println(v)

        // 说明：当前阶段 `None` 作为“裸标识符值”不可用；用 `None()` 走 enum variant ctor 路径。
        val none: Int? = None()
        assertNoneInt(none)
        println("assertNoneInt: ok")

        println("ok")
        0
    } catch (e: RuntimeError) {
        // 断言失败时会进入该分支；本用例不期望发生。
        val _unused: RuntimeError = e
        1
    }

    return exitCode
}
