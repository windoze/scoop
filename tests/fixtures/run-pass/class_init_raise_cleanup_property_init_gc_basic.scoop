// EXPECT: pass
// RUN-STDOUT: class_init_raise_cleanup_property_init_gc_basic.stdout
//
// T1327b：类初始化期间 Raise/effect unwinding cleanup
// - property initializer 中触发 Raise.raise，外层 try/catch 捕获后继续执行
// - ctor call 临时 GC frame 必须在 unwind 路径 pop，否则失败构造的对象会被错误保留为 root，
//   `__scoop_gc_collect()` 后 heap object count 不会回落

import scoop.core.*

class Boom() {
    val x: Int = @Safe {
        Raise.raise(RuntimeError.NullAssertionFailed)
        0
    }
}

fun main(): Int {
    val before: Int = __scoop_gc_debug_heap_object_count()

    try {
        val _x: Boom = Boom()
    } catch (e: RuntimeError) {
        // ignore
    }

    __scoop_gc_collect()

    val after: Int = __scoop_gc_debug_heap_object_count()
    println(after - before)
    return 0
}

