// EXPECT: pass
// EXPECT-EXIT: 131
// 目标：T0613 effect runtime ABI（flag + perform slot）在 codegen 侧可调用，且链接运行时不报未定义符号。

package fixtures.run_pass

import scoop.core.*

fun main(): Int {
    __scoop_effect_clear()
    __scoop_effect_slot_write(7, 123)
    __scoop_effect_set_active()

    // 当前阶段（HIR lowering）对普通调用表达式默认使用 `Any`；为确保二元运算能走整数路径，
    // 这里显式标注 `Int` 类型，避免被推断为 `Any` 并触发装箱。
    val active: Int = __scoop_effect_is_active()
    val tag: Int = __scoop_effect_slot_read_op_tag()
    val value: Int = __scoop_effect_slot_read_value()

    active + tag + value
}
