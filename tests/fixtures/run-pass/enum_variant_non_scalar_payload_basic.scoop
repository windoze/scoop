// EXPECT: pass
// EXPECT-EXIT: 83
//
// T4010a2a：inline 非标量 enum payload 需要进入统一可执行主线。
// - 单字段 struct payload 不再卡在 `enum payload (non-scalar)`；
// - 单字段 tuple payload 也可被 `when` 正常提取。

import scoop.core.*

struct Point(val x: Int, val y: Int)

enum Result {
    Ok(val point: Point),
    Msg(val payload: (String, Int)),
    Err(val code: Int),
}

fun read(result: Result): Int {
    return when (result) {
        Ok(point) -> point.x + point.y
        Msg(payload) -> payload.1
        Err(code) -> code
    }
}

fun main(): Int {
    val ok: Result = Ok(Point { x: 7, y: 8 })
    val msg: Result = Msg(("hello", 30))

    val boundPointX: Int = when (ok) {
        Result.Ok(point) -> point.x
        Result.Msg(_) -> 0
        Result.Err(_) -> 0
    }
    val boundPayload: (String, Int) = when (msg) {
        Result.Msg(payload) -> payload
        Result.Ok(_) -> ("", 0)
        Result.Err(_) -> ("", 0)
    }

    val labelScore: Int = if (boundPayload.0 == "hello") {
        1
    } else {
        0
    }
    return read(ok) + read(msg) + boundPointX + boundPayload.1 + labelScore
}
