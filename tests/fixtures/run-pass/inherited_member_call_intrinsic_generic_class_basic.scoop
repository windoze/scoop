// EXPECT: pass
//
// P4-T01g：`@Intrinsic class<T>` 实现 interface 时，subclass-typed receiver 应能直接调用
// interface 的未 override default body，而不需要先 cast 到 interface。

package fixtures.runpass

import scoop.core.*

fun main(): Int {
    val c: Container<Int> = Container(42)
    if (c.describe() != 9) {
        return 1
    }
    if (c.tag() != 5) {
        return 2
    }
    val t: Tagged = c
    if (t.describe() != 9) {
        return 3
    }
    if (t.tag() != 5) {
        return 4
    }
    return 0
}
