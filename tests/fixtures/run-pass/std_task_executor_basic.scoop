// EXPECT: pass
// RUN-STDOUT: std_task_executor_basic.stdout
//
// T1319e：`std` v3 task/executor support（最小可执行路径）
//
// 目标覆盖：
// - `Executor`：create/debugPendingCount/runNext/destroy
// - `Task<Int>`：create/tryStart/state/result
// - `Task<Int>`：manual create/complete/onComplete（含“已完成时立即入队”的路径）
// - onComplete waiters：恢复顺序与 resume value 可观测

import scoop.core.*
import scoop.task.*

effect Waiter {
    fun wait(): Int
}

fun main(): Int {
    val ex: Executor = executorCreate()

    val t: Task<Int> = taskCreate {
        println("body")
        7
    }

    println("state0")
    println(t.state())

    // waiter 1：在 task 完成时恢复 continuation
    val _w1: Unit = handle {
        val v: Int = Waiter.wait()
        println("w1")
        println(v)
    } with {
        Waiter.wait(), k -> {
            val ok: Bool = t.onComplete(ex, k)
            when (ok) {
                true -> println("registered1")
                false -> println("registered1_fail")
            }
        }
    }

    // waiter 2：验证恢复顺序（FIFO）
    val _w2: Unit = handle {
        val v: Int = Waiter.wait()
        println("w2")
        println(v)
    } with {
        Waiter.wait(), k -> {
            val ok: Bool = t.onComplete(ex, k)
            when (ok) {
                true -> println("registered2")
                false -> println("registered2_fail")
            }
        }
    }

    println("pending0")
    println(ex.debugPendingCount())

    val startOk: Bool = t.tryStart(ex)
    when (startOk) {
        true -> println("start_ok")
        false -> println("start_fail")
    }

    println("state1")
    println(t.state())
    println("pending1")
    println(ex.debugPendingCount())

    // step 1：运行 task body（会在内部 complete，并把 waiters 入队）
    val ranTask: Bool = ex.runNext()
    when (ranTask) {
        true -> println("ran_task")
        false -> println("ran_task_fail")
    }

    println("state2")
    println(t.state())
    println("result")
    println(t.result())
    println("pending2")
    println(ex.debugPendingCount())

    // step 2：恢复 waiter 1
    val ranW1: Bool = ex.runNext()
    when (ranW1) {
        true -> println("ran_w1")
        false -> println("ran_w1_fail")
    }
    println("pending3")
    println(ex.debugPendingCount())

    // step 3：恢复 waiter 2
    val ranW2: Bool = ex.runNext()
    when (ranW2) {
        true -> println("ran_w2")
        false -> println("ran_w2_fail")
    }
    println("pending4")
    println(ex.debugPendingCount())

    // 已完成时注册 waiter：应当立即入队并在下一步恢复
    val _w3: Unit = handle {
        val v: Int = Waiter.wait()
        println("w3")
        println(v)
    } with {
        Waiter.wait(), k -> {
            val ok: Bool = t.onComplete(ex, k)
            when (ok) {
                true -> println("registered3")
                false -> println("registered3_fail")
            }
        }
    }

    println("pending5")
    println(ex.debugPendingCount())
    val ranW3: Bool = ex.runNext()
    when (ranW3) {
        true -> println("ran_w3")
        false -> println("ran_w3_fail")
    }
    println("pending6")
    println(ex.debugPendingCount())

    // manual task：没有 body，不能 start，只能 complete
    val m: Task<Int> = taskCreateManual()
    println("m_state0")
    println(m.state())

    val _mw1: Unit = handle {
        val v: Int = Waiter.wait()
        println("mw1")
        println(v)
    } with {
        Waiter.wait(), k -> {
            val ok: Bool = m.onComplete(ex, k)
            when (ok) {
                true -> println("m_registered1")
                false -> println("m_registered1_fail")
            }
        }
    }

    val mStartOk: Bool = m.tryStart(ex)
    when (mStartOk) {
        true -> println("m_start_ok")
        false -> println("m_start_fail")
    }
    println("m_state1")
    println(m.state())

    val mCompleteOk: Bool = m.complete(9)
    when (mCompleteOk) {
        true -> println("m_complete_ok")
        false -> println("m_complete_fail")
    }
    println("m_state2")
    println(m.state())
    println("m_result")
    println(m.result())
    println("m_pending2")
    println(ex.debugPendingCount())

    val mRanW1: Bool = ex.runNext()
    when (mRanW1) {
        true -> println("m_ran_w1")
        false -> println("m_ran_w1_fail")
    }
    println("m_pending3")
    println(ex.debugPendingCount())

    // manual task 已完成时注册 waiter：同样应当立即入队并恢复
    val _mw2: Unit = handle {
        val v: Int = Waiter.wait()
        println("mw2")
        println(v)
    } with {
        Waiter.wait(), k -> {
            val ok: Bool = m.onComplete(ex, k)
            when (ok) {
                true -> println("m_registered2")
                false -> println("m_registered2_fail")
            }
        }
    }

    println("m_pending4")
    println(ex.debugPendingCount())
    val mRanW2: Bool = ex.runNext()
    when (mRanW2) {
        true -> println("m_ran_w2")
        false -> println("m_ran_w2_fail")
    }
    println("m_pending5")
    println(ex.debugPendingCount())

    ex.destroy()
    println("done")
    return 0
}
