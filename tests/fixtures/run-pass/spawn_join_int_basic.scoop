// EXPECT: pass
// RUN-STDOUT: spawn_join_int_basic.stdout
//
// T0620: `spawn/join`（结构化并发最小模型）
//
// 目标覆盖（当前阶段最小可回归语义）：
// - 外层 `async { ... }` 现在返回 lazy `Task<Int>`；
// - `spawn { ... }` 仍按当前阶段语义返回一个可被 `join/await` 读取的 `Task<Int>`；
// - 外层 task 通过 `Executor.tryStart/runUntilIdle/result` 驱动完成。

import scoop.core.*
import scoop.task.*

fun main(): Int {
    val resultTask: Task<Int> = async {
        println("before")

        val t1: Task<Int> = spawn {
            println("t1")
            10
        }

        val t2: Task<Int> = spawn {
            println("t2")
            32
        }

        val a: Int = join t1
        val b: Int = await t2

        println("sum")
        println(a + b)
        a + b
    }

    val ex: Executor = executorCreate()
    val _started: Bool = resultTask.tryStart(ex)
    val _steps: Int = ex.runUntilIdle(0)
    val result: Int = resultTask.result()
    ex.destroy()

    println("done")
    println(result)
    return 0
}
