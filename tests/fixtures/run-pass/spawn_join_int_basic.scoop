// EXPECT: fail
// T3006: 暂时标记为 fail——统一 state-machine codegen (T3005) 切换后，
// 部分 main body codegen 节点尚未在 state-machine 路径上支持。
// RUN-STDOUT: spawn_join_int_basic.stdout
//
// T0620: `spawn/join`（结构化并发最小模型）
//
// 目标覆盖（当前阶段最小可回归语义）：
// - T0622：`spawn { ... }` 计算 body 并返回一个 `Task<Int>` 句柄；
// - `join/await` 取回结果（当前为 one-shot）。

import scoop.core.*

fun main(): Int {
    val result: Int = async {
        println("before")

        val t1: Task<Int> = spawn {
            println("t1")
            10
        }

        val t2: Task<Int> = spawn {
            println("t2")
            32
        }

        val a: Int = join t1
        val b: Int = await t2

        println("sum")
        println(a + b)
        a + b
    }

    println("done")
    println(result)
    return 0
}
