// EXPECT: pass
// RUN-STDOUT: array_lit_infer_fun_arg_return_assign_basic.stdout
//
// 目标：T0149
// - 已知 `Array<T>` 形参类型时，`f([..])` 可在调用点推断；
// - `return [..]` 与赋值右侧 `x = [..]` 不再退化为 `Todo("array_lit")`；
// - 空数组在显式类型注解下可正常工作。

import scoop.core.*

fun sum(xs: Array<Int>): Int {
    var i = 0
    var acc = 0
    while (i < xs.size()) {
        acc = acc + xs.get(i)
        i = i + 1
    }
    return acc
}

fun mk(): Array<Int> {
    return [4, 5, 6]
}

fun main(): Int {
    val empty: Array<Int> = []
    println(empty.size())

    println(sum([1, 2, 3]))

    val ys = mk()
    println(ys.size())

    var zs: Array<Int> = []
    zs = [7, 8]
    println(zs.size())
    println(zs.get(1))

    return 0
}
