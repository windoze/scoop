// EXPECT: pass
// EXPECT-EXIT: 66
//
// 回归：boxed enum payload 中的 `Unit` field 必须保留自己的 field ordinal。

import scoop.core.*

enum Marked {
    Hit(val marker: Unit, val score: Int),
    Miss,
}

fun marker(): Unit {}

fun eval(x: Marked): Int {
    return when (x) {
        Hit(_, score) -> score
        Miss -> 9
    }
}

fun main(): Int {
    val x: Marked = Hit(marker(), 33)
    return eval(x) + when (x) {
        Hit(_, bound) -> bound
        Miss -> 0
    }
}
