// EXPECT: pass
// RUN-STDOUT: effect_resume_mixed_escape_pre_immediate_while_nested_block_if.stdout
//
// T2003u5d2: mixed-arm immediate-resume + sibling escape-continuation
// supports a richer nested direct escape site inside `while -> block -> if`
// before the immediate site.
// Current `@Safe { ... }` is only a temporary naked-block workaround until
// T2004 lands; this fixture does not depend on safe-region semantics.

import scoop.core.*

effect Yield {
    fun next(): Int
}

effect Ask {
    fun ask(seed: Int): String
}

class Cell(var k: Continuation<String>?)

fun main() {
    val none_k: Continuation<String>? = None()
    val cell: Cell = Cell(none_k)

    val result: Int = handle {
        println("body")
        var i: Int = 0
        while (i < 3) {
            println("iter_begin")
            @Safe {
                println("block_enter")
                if (i < 2) {
                    println("then_enter")
                    val marker: String = "branch_marker"
                    val first: String = Ask.ask(i)
                    println("after_ask")
                    println(first)
                    println(marker)
                } else {
                    println("skip_branch")
                }
            }
            i = i + 1
            println("iter_end")
        }
        val x: Int = Yield.next()
        println("after_yield_done")
        x + i
    } with {
        Yield.next() -> resume {
            println("yield_arm")
            resume(40)
        }
        Ask.ask(seed), k -> {
            println("ask_arm")
            cell.k = Some(k)
            7
        }
    }

    println("after_handle")
    val _: Int = result

    when (cell.k) {
        Some(k1) -> {
            cell.k = none_k
            val _: Unit = try {
                k1.resume("zero")
            } catch (e: RuntimeError) {
                println("unexpected_error1")
            }
            println("after_resume1")
        }
        None -> println("missing1")
    }

    when (cell.k) {
        Some(k2) -> {
            cell.k = none_k
            val _: Unit = try {
                k2.resume("one")
            } catch (e: RuntimeError) {
                println("unexpected_error2")
            }
            println("after_resume2")
        }
        None -> println("missing2")
    }

    println("done")
}
