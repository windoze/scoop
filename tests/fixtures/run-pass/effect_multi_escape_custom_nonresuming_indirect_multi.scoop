// EXPECT: pass
// RUN-STDOUT: effect_multi_escape_custom_nonresuming_indirect_multi.stdout
//
// T2003c0c2b3c1: 无 immediate-resume 的 multi-arm handle（multiple indirect escape sites）。
// - body 通过多个 top-level indirect call 命中 escape arm；
// - 第二次 `resume(...)` 后，tail 里的 sibling custom non-resuming 仍由同一个 source-handle 接住；
// - 第一段 indirect result 会跨第二次 suspension 保留下来，供最终 tail / sibling arm 使用。

import scoop.core.*

effect Ask {
    fun ask(seed: Int): String
}

effect Abort {
    fun stop(text: String): Nothing
}

class Cell(var k: Continuation<String, Int>?)

fun fetch(tag: Int): String / (Ask) {
    println("fetch_enter")
    println(tag)
    val msg: String = Ask.ask(tag + 1)
    println("fetch_resume")
    println(msg)
    msg
}

fun main() {
    val none_k: Continuation<String, Int>? = None()
    val cell: Cell = Cell(none_k)

    val result: Int = handle {
        println("body")
        val prefix: String = "prefix"
        val first: String = fetch(20)
        println("after_first")
        println(first)
        val second: String = fetch(30)
        println("after_second")
        println(prefix)
        println(first)
        println(second)
        Abort.stop(second)
        99
    } on {
        Ask.ask(seed), k -> {
            println("ask_arm")
            println(seed)
            cell.k = Some(k)
            7
        }
        Abort.stop(text: String) -> {
            println("abort_arm")
            println(text)
            5
        }
    }

    println("after_handle")
    println(result)

    when (cell.k) {
        Some(k1) -> {
            cell.k = none_k
            val _: Int = try {
                k1.resume("hello")
            } catch (e: RuntimeError) {
                println("unexpected_error1")
                0
            }
            println("after_resume1")
        }
        None -> println("missing1")
    }

    when (cell.k) {
        Some(k2) -> {
            cell.k = none_k
            val _: Int = try {
                k2.resume("world")
            } catch (e: RuntimeError) {
                println("unexpected_error2")
                0
            }
            println("after_resume2")
        }
        None -> println("missing2")
    }

    println("done")
}
