// EXPECT: pass
// RUN-STDOUT: member_call_virtual_named_args_basic.stdout
//
// T4003R：vtable member call 的命名实参与 direct call 共享同一套绑定/求值规则。

import scoop.core.*

fun mark(n: Int): Int {
    println(400 + n)
    return n
}

open class Base() {
    open fun mix(a: Int, b: Int): Int {
        return 100 + a * 10 + b
    }
}

class Derived() : Base() {
    override fun mix(a: Int, b: Int): Int {
        return 200 + a * 10 + b
    }
}

fun main(): Int {
    val base: Base = Derived()
    println(base.mix(b = mark(2), a = mark(1)))
    return 0
}
