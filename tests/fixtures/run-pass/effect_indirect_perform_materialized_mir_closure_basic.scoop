// EXPECT: pass
// RUN-STDOUT: effect_indirect_perform_materialized_mir_closure_basic.stdout
//
// T5002b2a1: Materialized MIR closure body performs an effect directly.
// - `callFn()` receives a closure value and invokes it through the ordinary indirect-call path.
// - The closure captures a local, computes the payload, and performs `Ask.ask(...)` itself.
// - Verifies production MIR closure-body lowering stays end-to-end runnable instead of failing
//   in `mir_body.rs` / LLVM verification when `Perform` is the closure body's terminator.

import scoop.core.*

effect Ask {
    fun ask(seed: Int): Int
}

fun callFn(f: (Int) -> Int / (Ask), x: Int): Int / (Ask) {
    println("apply_before")
    val value: Int = f(x)
    println("apply_unreachable")
    return value
}

fun main(): Int {
    val delta: Int = 1
    val result: Int = handle {
        println("body")
        callFn({ y ->
            println("closure_before")
            println(y + delta)
            Ask.ask(y + delta)
        }, 40)
    } on {
        Ask.ask(seed: Int) -> {
            println("caught")
            println(seed)
            seed + 1
        }
    }

    println("result")
    println(result)
    return 0
}
