// EXPECT: pass
// RUN-STDOUT: if_compound_result.stdout
//
// T1610: if expressions returning compound types (struct, tuple, enum).

import scoop.core.*

struct Point(val x: Int, val y: Int)

enum Result {
    Ok(val value: Int),
    Err(val code: Int),
}

fun main() {
    // 1) if returning struct
    val p: Point = if (true) {
        Point { x: 10, y: 20 }
    } else {
        Point { x: 0, y: 0 }
    }
    println(p.x)
    println(p.y)

    // 2) if returning struct (else branch)
    val q: Point = if (false) {
        Point { x: 0, y: 0 }
    } else {
        Point { x: 30, y: 40 }
    }
    println(q.x)
    println(q.y)

    // 3) if returning tuple
    val t: (Int, Int) = if (true) {
        (1, 2)
    } else {
        (3, 4)
    }
    println(t.0)
    println(t.1)

    // 4) if returning enum
    val s: Result = if (true) {
        Ok(5)
    } else {
        Err(99)
    }
    when (s) {
        Ok(v) -> println(v)
        Err(c) -> println(c)
    }

    println("done")
}
