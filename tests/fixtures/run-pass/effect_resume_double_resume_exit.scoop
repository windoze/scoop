// EXPECT: fail
// T3009a1: spec 已明确要求 immediate-resume arm 中的 `resume(value)`
// 必须在每条控制流路径的尾值位置恰好一次；重复/非 tail 形状应在前置阶段报错，
// 不能再漏到 generic local-call 或运行期 one-shot 语义。
//
// 历史背景：
// - 该 fixture 早期用于回归“多次 resume 触发运行期退出”的旧实现；
// - 当前按规范改为静态拒绝，并保留此路径作为 CLI/build 诊断回归。
//
// 目标覆盖：
// - 同一路径内重复调用 `resume(value)` 会在 typecheck 阶段稳定报错。

import scoop.core.*

effect Yield {
    fun next(): Int
}

fun main(): Int {
    val _x: Int = handle {
        val y: Int = Yield.next()
        y
    } with {
        Yield.next() -> resume {
            resume(1)
            resume(2)
        }
    }

    // unreachable
    return 0
}
