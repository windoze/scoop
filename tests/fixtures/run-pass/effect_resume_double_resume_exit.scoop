// EXPECT: pass
// EXPECT-EXIT: 3
//
// T0616: `resume(value)` one-shot（运行期断言）
//
// 目标覆盖：
// - 在同一个 `-> resume` arm 内重复调用 `resume(value)` 会触发运行期错误（非零退出）。

import scoop.core.*

effect Yield {
    fun next(): Int
}

fun main(): Int {
    val _x: Int = handle {
        val y: Int = Yield.next()
        y
    } with {
        Yield.next() -> resume {
            resume(1)
            resume(2)
        }
    }

    // unreachable
    return 0
}

