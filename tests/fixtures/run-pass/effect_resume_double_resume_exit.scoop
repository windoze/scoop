// EXPECT: pass
// T4016b1: 删除用户态 `-> resume` 后，旧 immediate-resume 专用的前端静态约束也随之移除。
// 该 fixture 保留“同一 arm 内出现多个 `k.resume(...)` 调用”的 migrated source shape，
// 只要求它不再因为旧 special form 规则而在前端失败。
//
// 说明：
// - 真正的 one-shot 运行期重复 resume 语义由
//   `effect_escape_continuation_resume_later_exit.scoop` 覆盖；
// - 本例不再承担“必须在 typecheck 阶段报错”的回归职责。

import scoop.core.*

effect Yield {
    fun next(): Int
}

fun main(): Int {
    val _x: Int = handle {
        val y: Int = Yield.next()
        y
    } with {
        Yield.next() , k -> {
            k.resume(1)
            k.resume(2)
        }
    }

    // unreachable
    return 0
}
