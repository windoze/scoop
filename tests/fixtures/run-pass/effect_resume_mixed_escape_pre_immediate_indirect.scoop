// EXPECT: pass
// RUN-STDOUT: effect_resume_mixed_escape_pre_immediate_indirect.stdout
//
// T2003c0b2b3: mixed-arm immediate-resume + sibling escape-continuation
// supports a top-level indirect escape site before the immediate site.

import scoop.core.*

effect Yield {
    fun next(): Int
}

effect Ask {
    fun ask(seed: Int): String
}

class Cell(var k: Continuation<String>?)

fun fetch(seed: Int): String / (Ask) {
    println("fetch_enter")
    val msg: String = Ask.ask(seed + 1)
    println("fetch_resume")
    println(msg)
    msg
}

fun main() {
    val none_k: Continuation<String>? = None()
    val cell: Cell = Cell(none_k)

    val result: Int = handle {
        println("body")
        val first: String = fetch(0)
        println("after_fetch")
        println(first)
        val x: Int = Yield.next()
        println("after_yield")
        println(x)
        x + 1
    } with {
        Yield.next() -> resume {
            println("yield_arm")
            resume(41)
        }
        Ask.ask(seed), k -> {
            println("ask_arm")
            println(seed)
            cell.k = Some(k)
            7
        }
    }

    println("after_handle")
    println(result)

    when (cell.k) {
        Some(k1) -> {
            cell.k = none_k
            val _: Unit = try {
                k1.resume("hello")
            } catch (e: RuntimeError) {
                println("unexpected_error")
            }
            println("after_resume")
        }
        None -> println("missing")
    }

    println("done")
}
