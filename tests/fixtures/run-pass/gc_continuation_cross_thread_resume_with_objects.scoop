// EXPECT: pass
// RUN-STDOUT: gc_continuation_cross_thread_resume_with_objects.stdout
//
// T1705: Multi-thread + GC + escaping continuation — cross-thread resume with complex objects.
//
// Scenario:
// - Main thread builds a complex object graph (class Node chain + struct Tag with String refs).
// - Handle body suspends 2 times via escape continuation.
// - Each continuation is resumed in a NEW THREAD via __scoop_thread_spawn_join_resume_u64.
// - Between resumes: main thread allocates garbage + explicit __scoop_gc_collect().
// - After each cross-thread resume: verifies object graph fields survived GC + cross-thread boundary.
//
// Deterministic ordering: join() after each cross-thread resume ensures sequential execution.
//
// Note: T0105 fixed the STW deadlock (pthread_join now transitions to IN_NATIVE).
// SCOOP_GC_STRESS=1 no longer hangs, but a GC rooting issue (T0106 scope) causes
// a crash during the second cross-thread resume — this fixture uses explicit
// __scoop_gc_collect() instead until GC rooting is fully audited.

import scoop.core.*

effect Await {
    fun pause(): Int
}

class Cell(var k: Continuation<Int, Unit>?)

struct Tag(val label: String, val score: Int)

class Node(val name: String, val tag: Tag, val value: Int) {
    var child: Node? = None()
}

fun makeNode(name: String, label: String, score: Int, value: Int): Node {
    val t: Tag = Tag { label: f"{label}_tag", score: score }
    return Node(name, t, value)
}

fun attachChild(parent: Node, c: Node): Unit {
    parent.child = Some(c)
}

fun describeNode(n: Node): String {
    val t: Tag = n.tag
    return f"{n.name}({t.label},{t.score},{n.value})"
}

fun main() {
    val none_k: Continuation<Int, Unit>? = None()
    val cell: Cell = Cell(none_k)

    val _: Unit = handle {
        // Build a 3-node chain: root -> mid -> leaf (all GC-managed)
        val root: Node = makeNode("root", "alpha", 10, 100)
        val mid: Node = makeNode("mid", "beta", 20, 200)
        val leaf: Node = makeNode("leaf", "gamma", 30, 300)
        attachChild(root, mid)
        attachChild(mid, leaf)

        println("body_start")
        println(describeNode(root))
        println(describeNode(mid))
        println(describeNode(leaf))

        // First suspension — root, mid, leaf all captured in ContState
        val r1: Int = Await.pause()
        println(f"resume1={r1}")

        // Verify object graph survived cross-thread resume + GC
        println(describeNode(root))
        println(describeNode(mid))
        println(describeNode(leaf))

        // Verify child links survived
        when (root.child) {
            Some(c) -> println(f"root.child={describeNode(c)}")
            None -> println("root.child=NONE")
        }

        // Build more objects between suspensions (allocations in resumed thread)
        val extra: Node = makeNode("extra", "delta", 40, 400)
        attachChild(leaf, extra)

        // Second suspension — extended graph must survive another cross-thread resume + GC
        val r2: Int = Await.pause()
        println(f"resume2={r2}")

        // Verify extended graph
        println(describeNode(root))
        println(describeNode(leaf))
        println(describeNode(extra))
        when (leaf.child) {
            Some(c) -> println(f"leaf.child={describeNode(c)}")
            None -> println("leaf.child=NONE")
        }

        println(f"sum={r1 + r2}")
        println("body_done")
    } with {
        Await.pause(), k -> {
            println("arm")
            cell.k = Some(k)
        }
    }

    println("after_handle")

    // Allocate garbage + explicit GC before first cross-thread resume
    __scoop_gc_debug_alloc_garbage(30)
    __scoop_gc_collect()
    println("gc_before_resume1")

    // Resume 1 in a NEW THREAD
    when (cell.k) {
        Some(k1) -> {
            cell.k = none_k
            println("cross_thread_resume_1")
            __scoop_thread_spawn_join_resume_u64(k1, 10)
            println("joined_1")
        }
        None -> println("missing1")
    }

    // Allocate garbage + explicit GC between resumes
    __scoop_gc_debug_alloc_garbage(30)
    __scoop_gc_collect()
    println("gc_before_resume2")

    // Resume 2 in a NEW THREAD
    when (cell.k) {
        Some(k2) -> {
            cell.k = none_k
            println("cross_thread_resume_2")
            __scoop_thread_spawn_join_resume_u64(k2, 20)
            println("joined_2")
        }
        None -> println("missing2")
    }

    println("done")
}
