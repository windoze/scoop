// EXPECT: pass
// RUN-STDOUT: unsafe_funptr_direct_named_call_basic.stdout
//
// T4003c：`FunPtr<F>` direct call 支持命名实参。
// - receiver function type 使用 `receiver/a0/...` 合成参数名；
// - 命名实参重排后仍需按源码顺序求值。

import scoop.core.*
import scoop.unsafe.*

@Extern("scoop_test_get_add_int_funptr")
fun get_add_int_funptr(): FunPtr<Int.(Int) -> Int>

fun mark(n: Int): Int {
    println(200 + n)
    return n
}

fun main(): Int {
    @Unsafe do {
        val fp: FunPtr<Int.(Int) -> Int> = get_add_int_funptr()
        println(fp(a0 = mark(8), receiver = mark(7)))
    }
    return 0
}
