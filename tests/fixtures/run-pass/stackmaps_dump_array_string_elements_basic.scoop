// EXPECT: pass
// RUN-MODE: dump-stackmaps
// RUN-STDOUT-CONTAINS: records:
// RUN-STDOUT-CONTAINS: verify-roots: ok
// RUN-STDOUT-CONTAINS: root-slots:
// RUN-STACKMAPS-RECORDS-GT: 0
//
// 目标：GC-FIX Phase C2d：补齐端到端回归（数组路径）。
// - `Array<String>` + get + println 在 statepoint/stackmap 下应能产出可解析的 stackmaps。

import scoop.core.*

fun main(): Int {
    val xs: Array<String> = [f"a {1}", f"b {2}", "c"]
    println(xs.get(0))
    __scoop_gc_collect()
    println(xs.get(1))
    return 0
}
