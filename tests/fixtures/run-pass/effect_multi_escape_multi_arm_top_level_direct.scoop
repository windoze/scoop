// EXPECT: pass
// RUN-STDOUT: effect_multi_escape_multi_arm_top_level_direct.stdout
//
// T2003c0c2d1: 无 immediate-resume、无 sibling non-resuming、无 finally 的
// multiple escape-continuation arms（top-level direct single-site）。
// - 两个 escape arm 按 body 中的 perform 顺序依次命中；
// - `resume(...)` 后会继续推进到后续 top-level direct escape site；
// - 不同 escape site 的恢复值类型分别为 `String` / `Int`。

import scoop.core.*

effect Ask {
    fun ask(label: String): String
}

effect Count {
    fun next(seed: Int): Int
}

class Cell(
    var ask_k: Continuation<String>?,
    var count_k: Continuation<Int>?,
)

fun main() {
    val ask_none: Continuation<String>? = None()
    val count_none: Continuation<Int>? = None()
    val cell: Cell = Cell(ask_none, count_none)

    val _: Unit = handle {
        println("body")
        val a: String = Ask.ask("first")
        println("after_ask")
        println(a)
        val b: Int = Count.next(4)
        println("after_count")
        println(b)
        println("body_done")
    } with {
        Count.next(seed: Int), k -> {
            println("count_arm")
            println(seed)
            cell.count_k = Some(k)
        }
        Ask.ask(label: String), k -> {
            println("ask_arm")
            println(label)
            cell.ask_k = Some(k)
        }
    }

    println("after_handle")

    when (cell.ask_k) {
        Some(k1) -> {
            cell.ask_k = ask_none
            val _: Unit = try {
                k1.resume("alpha")
            } catch (e: RuntimeError) {
                println("unexpected_ask")
            }
        }
        None -> println("missing_ask")
    }
    println("after_resume1")

    when (cell.count_k) {
        Some(k2) -> {
            cell.count_k = count_none
            val _: Unit = try {
                k2.resume(9)
            } catch (e: RuntimeError) {
                println("unexpected_count")
            }
        }
        None -> println("missing_count")
    }
    println("after_resume2")
    println("done")
}
