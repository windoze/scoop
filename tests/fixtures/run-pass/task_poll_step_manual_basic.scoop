// EXPECT: pass
// RUN-STDOUT: task_poll_step_manual_basic.stdout
//
// T4009b：`Task.poll()` / `step()` / `Poll<T>` 最小 manual-driving 合同。
//
// 目标覆盖：
// - `async { ... }` 产生的 lazy task 可由 `step()` / `poll()` 手动驱动；
// - 当前阶段 `step()` 与 `poll()` 语义等价：都会推进到“下一次挂起或完成”；
// - 因此当 awaited task 能在同一次驱动里完成时，首个 `step()` 也会直接得到 `Ready(value)`；
// - 任务完成后再次 `step()` / `poll()` 仍应稳定返回缓存结果，而不是重跑 body。

import scoop.core.*

fun main(): Int {
    val inner: Task<Int> = async {
        println("inner")
        41
    }

    val outer: Task<Int> = async {
        println("outer-before")
        val x: Int = await inner
        println("outer-after")
        println(x)
        x + 1
    }

    when (outer.step()) {
        Pending -> println("step0=pending")
        Ready(value) -> {
            println("step0=ready")
            println(value)
        }
    }

    when (outer.poll()) {
        Pending -> println("poll1=pending")
        Ready(value) -> {
            println("poll1=ready")
            println(value)
        }
    }

    when (outer.step()) {
        Pending -> println("step2=pending")
        Ready(value) -> {
            println("step2=ready")
            println(value)
        }
    }

    return 0
}
