// EXPECT: fail
// RUN-STDOUT: async_await_minimal_int_basic.stdout
//
// T0619: async/await（作为 `Async` effect 的语法糖）
// T3009aR: immediate-resume 的 non-block arm body codegen 已接通，
// 本例现在可成功 build；但运行期仍会在打印 `before` 后异常退出。
// 暂继续标记为 fail，待阶段 H 的 structured concurrency / async 任务收口。
//
// 目标覆盖（当前阶段最小可回归语义）：
// - `async { ... }` 捕获 `await` 产生的 `Async` required effects，使 `main` 仍满足 entry-point 纯度规则；
// - T0622：`await` 的参数应为 `Task<T>`，并在 async handler 内同步 `join` 取回结果后恢复。

import scoop.core.*

fun main(): Int {
    val result: Int = async {
        println("before")
        val t: Task<Int> = spawn { 41 }
        val x: Int = await t
        println("after")
        println(x)
        x + 1
    }

    println("done")
    println(result)
    return 0
}
