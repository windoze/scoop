// EXPECT: pass
// RUN-STDOUT: async_await_minimal_int_basic.stdout
//
// T0619: async/await（作为 `Async` effect 的语法糖）
//
// 目标覆盖（当前阶段最小可回归语义）：
// - `async { ... }` 捕获 `await` 产生的 `Async` required effects，使 `main` 仍满足 entry-point 纯度规则；
// - `await expr` 在 async body 内会形成一个 perform 点，并由 async handler 立即恢复（同步 pass-through）。

import scoop.core.*

fun main(): Int {
    val result: Int = async {
        println("before")
        val x: Int = await 41
        println("after")
        println(x)
        x + 1
    }

    println("done")
    println(result)
    return 0
}

