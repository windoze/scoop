// EXPECT: fail
// RUN-STDOUT: async_await_minimal_int_basic.stdout
//
// T0619: async/await（作为 `Async` effect 的语法糖）
// T3006: 暂时标记为 fail——统一 state-machine codegen (T3005) 切换后，
// async/spawn 内部 call callee 尚未在 state-machine 路径上完整支持。
// 待后续任务补齐 async 专用 intrinsic 的 state-machine codegen。
//
// 目标覆盖（当前阶段最小可回归语义）：
// - `async { ... }` 捕获 `await` 产生的 `Async` required effects，使 `main` 仍满足 entry-point 纯度规则；
// - T0622：`await` 的参数应为 `Task<T>`，并在 async handler 内同步 `join` 取回结果后恢复。

import scoop.core.*

fun main(): Int {
    val result: Int = async {
        println("before")
        val t: Task<Int> = spawn { 41 }
        val x: Int = await t
        println("after")
        println(x)
        x + 1
    }

    println("done")
    println(result)
    return 0
}
