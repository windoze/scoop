// EXPECT: pass
// RUN-STDOUT: top_level_val_runtime_read_basic.stdout
// EXPECT-EXIT: 0
//
// 目标：
// - 普通顶层 `val` 可在运行期表达式位置读取；
// - 一个普通顶层 `val` 的 initializer 可读取另一个普通顶层 `val`；
// - 运行期初始化只执行一次，不在重复读取时重复求值。

import scoop.core.*

fun seedInt(): Int {
    println("seed-int")
    return 41
}

fun plusOne(x: Int): Int {
    println("plus-one")
    return x + 1
}

fun seedText(): String {
    println("seed-text")
    return "plain".concat("-top-level")
}

val base: Int = seedInt()
val next: Int = plusOne(base)
val label: String = seedText()
val wrapped: String = label.concat("-val")

fun main(): Int {
    println(next)
    println(base)
    println(wrapped)
    println(label)
    println(next)
    println(wrapped)
    return 0
}
