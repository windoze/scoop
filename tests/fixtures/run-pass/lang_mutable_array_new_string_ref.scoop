import scoop.runtime.test.*

fun main(): Int {
    val xs: MutableArray<String> = mutableArrayNew<String>(capacity = 1)
    xs.push("alpha")
    xs.push("beta")
    __scoop_gc_collect()

    println(xs.size())
    println(xs.get(0))
    println(xs.get(1))
    return 0
}
