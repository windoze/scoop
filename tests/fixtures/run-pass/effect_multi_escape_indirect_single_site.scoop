// EXPECT: fail
// T3006: 暂时标记为 fail——统一 state-machine codegen (T3005) 切换后，
// 部分 main body codegen 节点尚未在 state-machine 路径上支持。
// RUN-STDOUT: effect_multi_escape_indirect_single_site.stdout
//
// T2003c0c2b2: 无 immediate-resume 的 escape-only indirect single-site。
// - body 通过单个 top-level indirect call 命中 escape arm；
// - `k.resume(...)` 后恢复 callee，并继续执行 indirect call 之后的 handle body tail；
// - 作为无-immediate indirect 子集的最小基线，避免该形状回退到旧门禁。

import scoop.core.*

effect Ask {
    fun ask(seed: Int): String
}

fun fetch(base: Int): String / (Ask) {
    println("fetch_enter")
    val msg: String = Ask.ask(base + 1)
    println("fetch_resume")
    println(msg)
    msg
}

fun main() {
    var saved: Continuation<String>? = None()

    val result: Int = handle {
        val prefix: String = "prefix"
        val base: Int = 10
        println("body")
        val reply: String = fetch(base)
        println("after_fetch")
        println(prefix)
        println(base)
        println(reply)
        42
    } with {
        Ask.ask(seed), k -> {
            println("ask_arm")
            println(seed)
            saved = Some(k)
            7
        }
    }

    println("after_handle")
    println(result)

    when (saved) {
        Some(k) -> {
            val _: Unit = try {
                k.resume("hello")
            } catch (e: RuntimeError) {
                println("unexpected_error")
            }
            println("after_resume")
        }
        None -> println("missing")
    }

    println("done")
}
