// EXPECT: pass
// RUN-STDOUT: effect_resume_multi_immediate_top_level.stdout
//
// T2003c0c2c: multiple immediate-resume arms（top-level direct sites）。
// - handler arm 顺序与 perform 顺序不同；
// - 两个 top-level `val = perform` site 都会命中各自的 immediate arm；
// - body 正常跑完后，`finally` 仍恰好执行一次。

import scoop.core.*

effect Yield {
    fun next(): Int
}

effect Step {
    fun take(seed: Int): Int
}

fun main() {
    val result: Int = handle {
        println("body_start")
        val first: Int = Yield.next()
        println("after_first")
        println(first)
        val second: Int = Step.take(first + 1)
        println("after_second")
        println(second)
        first + second
    } with {
        Step.take(seed: Int) -> resume {
            println("step_arm")
            println(seed)
            resume(seed * 2)
        }
        Yield.next() -> resume {
            println("yield_arm")
            resume(10)
        }
    } finally {
        println("finally")
    }

    println("result")
    println(result)
}
