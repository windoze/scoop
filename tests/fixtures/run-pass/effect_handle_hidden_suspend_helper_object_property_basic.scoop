// EXPECT: pass
// RUN-STDOUT: effect_handle_hidden_suspend_helper_object_property_basic.stdout
//
// T3010b2b0a：handle body 内 top-level helper 的 caller-side hidden-suspend 分类。
// - helper() 自身是 ordinary callee，但内部通过 object property 触发 object init；
// - object init 内的 Raise.raise 必须让 handle 立刻进入 dispatch；
// - `handle_unreachable` / `helper_unreachable` 都不能执行。

import scoop.core.*

object BoomObject {
    init {
        println("boom.init")
        Raise.raise(RuntimeError.NullAssertionFailed)
    }

    val x: Int = 1
}

fun helper(): Int {
    println("helper_before")
    val _x: Int = BoomObject.x
    println("helper_unreachable")
    return 0
}

fun main(): Int {
    val result: Int = handle {
        println("handle_before")
        val value: Int = helper()
        println("handle_unreachable")
        value
    } with {
        Raise.raise(err: RuntimeError) -> 10
    }

    println(result)
    println("done")
    return 0
}
