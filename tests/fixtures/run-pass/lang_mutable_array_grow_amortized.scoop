// EXPECT: pass
// RUN-STDOUT: lang_mutable_array_grow_amortized.stdout

fun main(): Int {
    val xs: MutableArray<Int> = mutableArrayNew<Int>()
    var i: Int = 0
    while (i < 1024) {
        xs.push(i)
        i = i + 1
    }

    println(xs.size())
    println(xs.get(0))
    println(xs.get(1023))
    return 0
}
