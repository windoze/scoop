// EXPECT: pass
// RUN-STDOUT: mutable_array_ops_basic.stdout
//
// 目标：T1317e（stdlib：MutableArray 扩展：push/pop/insert/removeAt/splice）

import scoop.core.*

fun printlnSomeInt(value: Int): Unit {
    print("Some(")
    print(value)
    println(")")
}

fun dumpMutableIntArray(xs: MutableArray<Int>): Unit {
    println(xs.size())
    var i: Int = 0
    while (i < xs.size()) {
        println(xs.get(i))
        i = i + 1
    }
}

fun dumpIntArray(xs: Array<Int>): Unit {
    println(xs.size())
    var i: Int = 0
    while (i < xs.size()) {
        println(xs.get(i))
        i = i + 1
    }
}

fun main(): Int {
    var xs: MutableArray<Int> = []

    println(xs.size())
    xs = xs.pop()
    println("None")
    println(xs.size())

    xs.push(1)
    xs.push(2)
    xs.push(3)
    println("after push")
    dumpMutableIntArray(xs)

    val last: Int = xs.get(xs.size() - 1)
    xs = xs.pop()
    printlnSomeInt(last)
    println("after pop")
    dumpMutableIntArray(xs)

    xs = xs.insert(-100, 9)
    println("after insert -100")
    dumpMutableIntArray(xs)

    xs = xs.insert(999, 8)
    println("after insert 999")
    dumpMutableIntArray(xs)

    val removed0: Int = xs.get(0)
    xs = xs.removeAt(-1)
    printlnSomeInt(removed0)
    println("after removeAt -1")
    dumpMutableIntArray(xs)

    println("removed:")
    val start: Int = 1
    println(xs.size() - start)
    println(xs.get(start))
    println(xs.get(start + 1))
    val ins: Array<Int> = [7, 6]
    xs = xs.splice(start, 999, ins)
    println("after splice")
    dumpMutableIntArray(xs)

    return 0
}
