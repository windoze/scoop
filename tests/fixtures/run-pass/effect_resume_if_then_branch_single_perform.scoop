// EXPECT: fail
// T3006: 暂时标记为 fail——统一 state-machine codegen (T3005) 切换后，
// 部分 main body codegen 节点尚未在 state-machine 路径上支持。
// RUN-STDOUT: effect_resume_if_then_branch_single_perform.stdout
//
// T2003b2: immediate-resume 支持 if then-branch 中的单 direct perform。
//
// 目标覆盖：
// - cond=true 时命中 then 分支内的 perform，并在 resume 后继续执行 then tail；
// - cond=false 时不命中 perform，else 分支按普通控制流执行，arm 不会被调用；
// - if 结束后能回到外层 handle body 的后续语句。

import scoop.core.*

effect Yield {
    fun next(): Int
}

fun run(flag: Bool): Int {
    handle {
        println("body_start")
        val seed: Int = 5
        if (flag) {
            println("then_before")
            val base: Int = 2
            val x: Int = Yield.next()
            println("then_after")
            println(seed + base + x)
        } else {
            println("else_plain")
        }
        println("after_if")
        seed + 100
    } with {
        Yield.next() -> resume {
            println("arm_then")
            resume(20)
        }
    }
}

fun main() {
    println("case_true")
    println(run(true))
    println("case_false")
    println(run(false))
}
