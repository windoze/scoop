// IGNORE-UNTIL-FIX: owner-eff/标准委托端到端未完成，Fact 重构批 4（T4-03/T4-04）恢复
// EXPECT: pass
// RUN-STDOUT: delegated_property_lazy_thread_safety_synchronized_once.stdout
// TIMEOUT: 30000
//
// T1326：delegated properties 的线程安全语义（lazy）
// - 默认 `lazy { ... }` 应为 thread-safe（Kotlin-like：Synchronized 模式）
// - 多线程并发首次访问时 initializer 只应执行一次
//
// 说明：当前 LLVM codegen 尚不支持 `object` 成员赋值（assignment lhs 为 member access），
// 当前改用 `scoop.sync` 显式 barrier / result slot 来表达同样的并发断言。
// SYSROOT-DEPS: scoop.thread scoop.sync

import scoop.core.*
import scoop.delegates.*
import scoop.sync.*
import scoop.thread.*

class SyncState(
    val lock: Mutex,
    val cv: CondVar,
    var readyCount: Int,
    var start: Bool,
    var initCalls: Int,
    var resultCount: Int,
    var result1: Int,
    var result2: Int
)

class C() {
    val x: Int by lazy {
        val st: SyncState = Shared.state
        st.lock.lock()
        st.initCalls = st.initCalls + 1
        st.cv.notifyAll()
        st.lock.unlock()

        // 扩大竞争窗口：如果实现是无锁的（或 None），很容易出现多次 init。
        sleepMillis(50)
        7
    }
}

object Shared {
    val c: C = C()
    val state: SyncState = SyncState(mutexCreate(), condVarCreate(), 0, false, 0, 0, 0, 0)
}

fun worker() {
    val st: SyncState = Shared.state
    st.lock.lock()
    st.readyCount = st.readyCount + 1
    st.cv.notifyAll()
    while (st.start == false) {
        st.cv.wait(st.lock)
    }
    st.lock.unlock()

    val value: Int = Shared.c.x

    st.lock.lock()
    when (st.resultCount == 0) {
        true -> {
            st.result1 = value
        }
        false -> {
            st.result2 = value
        }
    }
    st.resultCount = st.resultCount + 1
    st.cv.notifyAll()
    st.lock.unlock()
}

fun main() {
    val st: SyncState = Shared.state

    val t1: Thread = threadSpawn { worker() }
    val t2: Thread = threadSpawn { worker() }

    st.lock.lock()
    while (st.readyCount < 2) {
        st.cv.wait(st.lock)
    }
    st.start = true
    st.cv.notifyAll()
    while (st.resultCount < 2) {
        st.cv.wait(st.lock)
    }
    val v1: Int = st.result1
    val v2: Int = st.result2
    val initCalls: Int = st.initCalls
    st.lock.unlock()

    t1.join()
    t2.join()

    println(v1)
    println(v2)
    println(f"init_calls=${initCalls}")
    println("ok")
}
