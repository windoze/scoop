// EXPECT: pass
// RUN-STDOUT: delegated_property_lazy_thread_safety_synchronized_once.stdout
// TIMEOUT: 3000
//
// T1326：delegated properties 的线程安全语义（lazy）
// - 默认 `lazy { ... }` 应为 thread-safe（Kotlin-like：Synchronized 模式）
// - 多线程并发首次访问时 initializer 只应执行一次
//
// 说明：当前 LLVM codegen 尚不支持 `object` 成员赋值（assignment lhs 为 member access），
// 因此这里用 channel 计数，并在主线程用固定次数 `recv()` 来断言 initializer 次数。

import scoop.core.*
import scoop.delegates.*
import scoop.thread.*
import scoop.channels.*

class C() {
    val x: Int by lazy {
        // 扩大竞争窗口：如果实现是无锁的（或 None），很容易出现多次 init。
        val initNotify: Channel<Int> = Shared.initNotify
        initNotify.send(1)
        sleepMillis(50)
        7
    }
}

object Shared {
    val c: C = C()

    val ready: Channel<Int> = channelCreate<Int>()
    val start: Channel<Int> = channelCreate<Int>()
    val results: Channel<Int> = channelCreate<Int>()
    val initNotify: Channel<Int> = channelCreate<Int>()
}

fun worker() {
    val ready: Channel<Int> = Shared.ready
    val start: Channel<Int> = Shared.start
    val results: Channel<Int> = Shared.results

    ready.send(1)
    val _go: Int? = start.recv()
    val c: C = Shared.c
    val v: Int = c.x
    val _sent: Bool = results.send(v)
}

fun main() {
    val ready: Channel<Int> = Shared.ready
    val start: Channel<Int> = Shared.start
    val results: Channel<Int> = Shared.results
    val initNotify: Channel<Int> = Shared.initNotify

    val t1: Thread = threadSpawn { worker() }
    val t2: Thread = threadSpawn { worker() }

    val _r1: Int? = ready.recv()
    val _r2: Int? = ready.recv()

    start.send(1)
    start.send(1)

    val v1: Int? = results.recv()
    val v2: Int? = results.recv()

    when (v1) {
        Some(x) -> println(x)
        None -> println("missing")
    }
    when (v2) {
        Some(x) -> println(x)
        None -> println("missing")
    }

    t1.join()
    t2.join()

    initNotify.close()
    val a: Int? = initNotify.recv()
    val b: Int? = initNotify.recv()

    when (a) {
        Some(_) -> when (b) {
            None -> println("init_calls=1")
            Some(_) -> println("init_calls=bad")
        }
        None -> println("init_calls=bad")
    }
    println("ok")
}
