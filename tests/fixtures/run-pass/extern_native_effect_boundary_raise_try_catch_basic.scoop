// EXPECT: pass
// RUN-STDOUT: extern_native_effect_boundary_raise_try_catch_basic.stdout
//
// T4017f：ordinary helper 内的 effectful extern/native boundary。
// - helper 自身声明 `Raise<RuntimeError>`，并通过 `@Extern` 进入 native；
// - native helper 在返回前发布 `Raise<RuntimeError>`；
// - outward-effect 后 `helper_unreachable` 不能执行；
// - outer try/catch 仍需命中，caller tail 也不能继续执行。

import scoop.core.*

@Extern("scoop_test_raise_null_assertion_failed_in_native")
fun nativeBoom(): Int / Raise<RuntimeError>

fun helper(): Int / Raise<RuntimeError> {
    println("helper_before")
    val value: Int = @Unsafe do { nativeBoom() }
    println("helper_unreachable")
    return value
}

fun main(): Int {
    val code: Int = try {
        println("main_before_call")
        val value: Int = helper()
        println("main_unreachable")
        value
    } catch (e: RuntimeError) {
        println("caught")
        when (e) {
            NullAssertionFailed -> 10
            ClassCastFailed -> 20
            ContinuationAlreadyResumed -> 30
        }
    }

    println(code)
    println("done")
    return 0
}
