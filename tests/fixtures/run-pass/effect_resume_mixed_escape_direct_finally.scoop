// EXPECT: pass
// RUN-STDOUT: effect_resume_mixed_escape_direct_finally.stdout
//
// T2003r3d2c3: unified mixed multi-resuming leaf（1 immediate + 1 escape，single direct site + finally）。
// - 先命中 immediate-resume arm，并在 resume 后继续执行 body；
// - 随后命中 sibling escape-continuation arm，返回 handle 结果；
// - `finally` 在 handle 表达式返回前执行一次；稍后 `k.resume(...)` 继续 escape site 之后的 tail。

import scoop.core.*

effect Yield {
    fun next(): Int
}

effect Ask {
    fun ask(): String
}

fun main() {
    var saved: Continuation<String, Int>? = None()

    val result: Int = handle {
        val prefix: String = "prefix"
        println("body")
        val x: Int = Yield.next()
        println("after_yield")
        println(x)
        val msg: String = Ask.ask()
        println("after_ask")
        println(prefix)
        println(x)
        println(msg)
        99
    } with {
        Yield.next() , k -> {
            println("yield_arm")
            k.resume(41)
        }
        Ask.ask(), k -> {
            println("ask_arm")
            saved = Some(k)
            7
        }
    } finally {
        println("finally")
    }

    println("after_handle")
    println(result)

    when (saved) {
        Some(k) -> {
            val _: Int = try {
                k.resume("hello world")
            } catch (e: RuntimeError) {
                println("unexpected_error")
                0
            }
            println("after_resume")
        }
        None -> println("missing")
    }

    println("done")
}
