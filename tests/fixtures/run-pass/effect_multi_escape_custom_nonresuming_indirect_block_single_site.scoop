// EXPECT: pass
// RUN-STDOUT: effect_multi_escape_custom_nonresuming_indirect_block_single_site.stdout
//
// T2003c0c2b3c2: 无 immediate-resume 的 multi-arm handle
// 支持 statement-position nested block indirect escape site。
// - nested block 中的 indirect site 初次执行时创建 continuation；
// - `resume(...)` 后会先 replay block tail，再离开 block 继续后续 top-level tail；
// - nested block locals / outer locals 都能在 replay 后继续使用，且 sibling custom non-resuming
//   仍由同一个 source-handle 接住。
// 本回归现在使用 plain `do { ... }` 锁定 nested-block indirect replay，
// 不依赖 safe-region 语义。

import scoop.core.*

effect Ask {
    fun ask(seed: Int): String
}

effect Abort {
    fun stop(text: String): Nothing
}

class Cell(var k: Continuation<String>?)

fun fetch(seed: Int): String / (Ask) {
    println("fetch_enter")
    println(seed)
    val msg: String = Ask.ask(seed + 1)
    println("fetch_resume")
    println(msg)
    msg
}

fun main() {
    val none_k: Continuation<String>? = None()
    val cell: Cell = Cell(none_k)

    val result: Int = handle {
        println("body")
        val prefix: String = "outer"

        do {
            println("block_enter")
            val label: String = "inner"
            val reply: String = fetch(20)
            println("after_fetch")
            println(label)
            println(reply)
            println(prefix)
        }

        println("after_block")
        println(prefix)
        Abort.stop(prefix)
        99
    } with {
        Ask.ask(seed), k -> {
            println("ask_arm")
            println(seed)
            cell.k = Some(k)
            7
        }
        Abort.stop(text: String) -> {
            println("abort_arm")
            println(text)
            5
        }
    }

    println("after_handle")
    println(result)

    when (cell.k) {
        Some(k) -> {
            cell.k = none_k
            val _: Unit = try {
                k.resume("hello")
            } catch (e: RuntimeError) {
                println("unexpected_error")
            }
            println("after_resume")
        }
        None -> println("missing")
    }

    println("done")
}
