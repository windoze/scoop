// EXPECT: pass
// RUN-STDOUT: callable_value_pattern_binder_receiver_named_args_basic.stdout
//
// T4005SR：review callable-value 主线是否真的覆盖 pattern binder，而不是只让局部 `val f = ...`
// 或个别 direct-call 形态偶然通过。
//
// 覆盖面：
// - 顶层命名 receiver function value；
// - 顶层 pattern binder 中的 receiver function value（依赖 tuple expected-context 把 receiver type 下传到 lambda 元素）；
// - 局部 destructuring binder；
// - `when` pattern binder；
// - 顶层 `FunPtr` direct call；
// - 上述调用统一使用 receiver + named args。

import scoop.core.*
import scoop.unsafe.*

@Extern("scoop_test_get_add_int_funptr")
fun get_add_int_funptr(): FunPtr<Int.(Int) -> Int>

val topNamed: String.(Int) -> Int = { n: Int -> this.length() + n }
val topNamedInit: Int = topNamed(receiver = "hi", a0 = 5)

val (topPatternF, topPatternBase): (String.(Int) -> Int, Int) = (
    { n: Int -> this.length() + n + 1 },
    3,
)
val topPatternInit: Int = topPatternF(receiver = "wow", a0 = topPatternBase)

val topFp: FunPtr<Int.(Int) -> Int> = @Unsafe do { get_add_int_funptr() }
val topFpInit: Int = @Unsafe do { topFp(a0 = 4, receiver = 6) }

fun main() {
    val localPair: (String.(Int) -> Int, Int) = (topNamed, 4)
    val (localF, localN) = localPair

    val maybe: (String.(Int) -> Int)? = Some(topPatternF)
    val fromWhen: Int = when (maybe) {
        Some(f) -> f(a0 = 2, receiver = "abc")
        None -> 0
    }

    println(topNamed(receiver = "hello", a0 = 7))
    println(topNamedInit)
    println(topPatternF(receiver = "wow", a0 = topPatternBase))
    println(topPatternInit)
    println(localF(receiver = "abcd", a0 = localN))
    println(fromWhen)
    @Unsafe do {
        println(topFp(a0 = 8, receiver = 7))
    }
    println(topFpInit)
}
