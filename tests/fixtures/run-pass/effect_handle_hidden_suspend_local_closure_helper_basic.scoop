// EXPECT: pass
// RUN-STDOUT: effect_handle_hidden_suspend_local_closure_helper_basic.stdout
//
// T3010b2b0a：handle body 内 local closure/function-value 的 caller-side hidden-suspend 分类。
// - `thunk()` 是局部函数值调用，但 closure body 最终会调用 hidden-suspend helper；
// - 若 caller-side 错误退化为 plain `Call`，`handle_unreachable` 会继续执行。

import scoop.core.*

object BoomObject {
    init {
        println("boom.init")
        Raise.raise(RuntimeError.NullAssertionFailed)
    }

    val x: Int = 1
}

fun helper(): Int {
    println("helper_before")
    val _x: Int = BoomObject.x
    println("helper_unreachable")
    return 0
}

fun main(): Int {
    val thunk: () -> Int = {
        helper()
    }
    val result: Int = handle {
        println("handle_before")
        val value: Int = thunk()
        println("handle_unreachable")
        value
    } with {
        Raise.raise(err: RuntimeError) -> 10
    }

    println(result)
    println("done")
    return 0
}
