// EXPECT: pass
// RUN-STDOUT: effect_handle_object_init_access_inactive_basic.stdout
//
// T3009b0a1d：统一 ObjectInitAccessBoundary 在 object value/property access 上的 inactive-path。
// - `ReadyConfig` 的 direct object value access 触发 init 后，必须继续执行后续语句；
// - `ReadyConfig.x` 在 inactive 返回时必须继续执行 `+ 1` 与 caller-tail；
// - `BoomConfig.x` 在 init 内触发 Raise.raise 后，必须直接进入 handle dispatch，不能继续执行 tail。

import scoop.core.*

object ReadyConfig {
    init {
        println("ready.init")
    }

    val x: Int = 7
}

object BoomConfig {
    init {
        println("boom.init")
        Raise.raise(RuntimeError.NullAssertionFailed)
    }

    val x: Int = 1
}

fun main(): Int {
    val inactive_result: Int = handle {
        println("inactive_before")
        val _ready = ReadyConfig
        println("after_object_value")
        val value: Int = ReadyConfig.x + 1
        println("inactive_after")
        value
    } with {
        Raise.raise(err: RuntimeError) -> 10
    }
    println(inactive_result)

    val active_result: Int = handle {
        println("active_before")
        val value: Int = BoomConfig.x + 1
        println("active_unreachable")
        value
    } with {
        Raise.raise(err: RuntimeError) -> 10
    }
    println(active_result)

    println("done")
    return 0
}
