// EXPECT: pass
// RUN-STDOUT: effect_handle_hidden_suspend_member_helper_basic.stdout
//
// T3010b2b0a：handle body 内 object member helper 的 caller-side hidden-suspend 分类。
// - `Helper.run()` 需要先被识别成统一 suspend boundary；
// - member helper 内部经 `BoomObject.x` 触发 Raise.raise 后，handle 侧不能继续执行 tail。

import scoop.core.*

object BoomObject {
    init {
        println("boom.init")
        Raise.raise(RuntimeError.NullAssertionFailed)
    }

    val x: Int = 1
}

object Helper {
    fun run(): Int {
        println("helper_before")
        val _x: Int = BoomObject.x
        println("helper_unreachable")
        return 0
    }
}

fun main(): Int {
    val result: Int = handle {
        println("handle_before")
        val value: Int = Helper.run()
        println("handle_unreachable")
        value
    } with {
        Raise.raise(err: RuntimeError) -> 10
    }

    println(result)
    println("done")
    return 0
}
