// EXPECT: pass
// RUN-STDOUT: effect_resume_mixed_escape_pre_immediate_if.stdout
//
// T2003c0b2c1b: mixed-arm immediate-resume + sibling escape-continuation
// supports a statement-position if-then direct escape site before the
// immediate site, while the non-matching else branch continues normally.

import scoop.core.*

effect Yield {
    fun next(): Int
}

effect Ask {
    fun ask(seed: Int): String
}

class Cell(var k: Continuation<String>?, var seen: Int)

fun run(flag: Bool, cell: Cell, none_k: Continuation<String>?) {
    cell.seen = 0

    val result: Int = handle {
        if (flag) {
            cell.seen = 1
            val first: String = Ask.ask(10)
            cell.seen = 5
        } else {
            cell.seen = 2
        }
        val x: Int = Yield.next()
        cell.seen = if (flag) 7 else 4
        x + 1
    } with {
        Yield.next() -> resume {
            resume(41)
        }
        Ask.ask(seed), k -> {
            cell.k = Some(k)
            cell.seen = 3
            7
        }
    }

    println(result)
    println(cell.seen)

    when (cell.k) {
        Some(k1) -> {
            cell.k = none_k
            val _: Unit = try {
                k1.resume("resume_then")
            } catch (e: RuntimeError) {
                println(-99)
            }
            println(cell.seen)
        }
        None -> println(-1)
    }
}

fun main() {
    val none_k: Continuation<String>? = None()
    val cell: Cell = Cell(none_k, 0)
    run(false, cell, none_k)
    run(true, cell, none_k)
}
