// EXPECT: pass
// RUN-STDOUT: effect_resume_finally_arm_raise.stdout
//
// T2003a: immediate-resume + finally when arm body raises.
//
// 目标覆盖：
// - handle body perform 后进入 immediate-resume arm；
// - arm body 在调用 `k.resume(value)` 前触发 `Raise.raise`；
// - finally 在 raise 向外传播前恰好执行一次。

import scoop.core.*

effect Yield {
    fun next(): Int
}

fun main() {
    println("before")
    val result: Int = try {
        val v: Int = handle {
            println("body_start")
            val x: Int = Yield.next()
            println("body_unreachable")
            x
        } with {
            Yield.next() , k -> {
                println("arm_start")
                Raise.raise(77)
                println("arm_unreachable")
                k.resume(0)
            }
        } finally {
            println("finally")
        }
        println("handle_unreachable")
        v
    } catch (e: Int) {
        println("caught")
        println(e)
        e
    }
    println("result")
    println(result)
    println("done")
}
