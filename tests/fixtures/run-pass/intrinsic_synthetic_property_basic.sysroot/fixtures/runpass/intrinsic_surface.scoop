package fixtures.runpass

import scoop.core.*

@Global
var LastWritten: Int = 0

@Intrinsic
class NativeCell() {
    @Intrinsic("dummy_ir")
    fun seed(): Int

    val answer: Int
        get() = this.seed() + 1

    var stored: Int
        get() = LastWritten
        set(value) {
            LastWritten = value + 2
        }
}

@Intrinsic
struct NativeCounter() {
    fun base(): Int {
        return 20
    }

    val doubled: Int
        get() = this.base() + 2
}
