package fixtures.runpass

import scoop.core.*

@Global
public var LastWritten: Int = 0

@Intrinsic
public class NativeCell() {
    @Intrinsic("dummy_ir")
    public fun seed(): Int

    public val answer: Int
        get() = this.seed() + 1

    public var stored: Int
        get() = LastWritten
        set(value) {
            LastWritten = value + 2
        }
}

@Intrinsic
public struct NativeCounter() {
    public fun base(): Int {
        return 20
    }

    public val doubled: Int
        get() = this.base() + 2
}
