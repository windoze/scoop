// EXPECT: pass
// RUN-STDOUT: interface_default_method_dispatch_basic.stdout
//
// CG-T03: interface dispatch consumes the selected default-method slot contract.

import scoop.core.*

interface Ping {
    fun ping(): Int {
        return 7
    }
}

class Box() : Ping

fun read(x: Ping): Int {
    return x.ping()
}

fun main(): Int {
    println(read(Box()))
    return 0
}
