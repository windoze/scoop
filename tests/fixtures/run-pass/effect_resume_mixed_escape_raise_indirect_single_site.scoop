// EXPECT: pass
// RUN-STDOUT: effect_resume_mixed_escape_raise_indirect_single_site.stdout
//
// T2003c0c1b: mixed-arm immediate-resume + sibling escape-continuation +
// sibling Raise.raise（top-level single indirect escape site）。
// - body 先命中 immediate-resume arm，再经由单个 top-level indirect call 命中 sibling escape arm；
// - `k.resume(...)` 后重新调用 callee，并继续执行 indirect call 之后的 tail；
// - tail 里的 `Raise.raise` 由同一个 source-handle 的 sibling raise arm 接住。

import scoop.core.*

effect Yield {
    fun next(): Int
}

effect Ask {
    fun ask(seed: Int): String
}

fun fetch(base: Int): String / (Ask) {
    println("fetch_enter")
    val msg: String = Ask.ask(base + 1)
    println("fetch_resume")
    println(msg)
    msg
}

fun main() {
    var saved: Continuation<String>? = None()

    val result: Int = handle {
        val prefix: String = "prefix"
        println("body")
        val x: Int = Yield.next()
        println("after_yield")
        println(x)
        val reply: String = fetch(x)
        println("after_fetch")
        println(prefix)
        println(x)
        println(reply)
        Raise.raise(x + 1)
        99
    } with {
        Yield.next() -> resume {
            println("yield_arm")
            resume(41)
        }
        Ask.ask(seed), k -> {
            println("ask_arm")
            println(seed)
            saved = Some(k)
            7
        }
        Raise.raise(err: Int) -> {
            println("raise_arm")
            println(err)
            5
        }
    }

    println("after_handle")
    println(result)

    when (saved) {
        Some(k) -> {
            val _: Unit = try {
                k.resume("hello")
            } catch (e: RuntimeError) {
                println("unexpected_error")
            }
            println("after_resume")
        }
        None -> println("missing")
    }

    println("done")
}
