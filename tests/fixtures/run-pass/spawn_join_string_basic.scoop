// EXPECT: pass
// RUN-STDOUT: spawn_join_string_basic.stdout
//
// T4009a：`spawn/join` 不再绑定到 `Int`-only handle ABI。
//
// 目标覆盖：
// - `async { ... }` 现在对外返回 lazy `Task<String>`；
// - 内部 `spawn { ... }` 可返回 `String`；
// - 外层 task 可直接通过 `join` 驱动完成。

import scoop.core.*

fun main(): Int {
    val valueTask: Task<String> = async {
        val task: Task<String> = spawn {
            println("body")
            "hello"
        }
        join task
    }

    val value: String = handle {
        Async.await(valueTask)
    } with {
        Async.await(taskArg: Task<String>) -> __scoop_task_join(taskArg)
    }

    println("joined")
    println(value)
    return 0
}
