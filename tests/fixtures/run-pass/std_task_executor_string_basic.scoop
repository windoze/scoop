// EXPECT: pass
// RUN-STDOUT: std_task_executor_string_basic.stdout
//
// T4009a：`Task<T>` / `Executor` 的 object-model 泛型结果回归。
//
// 目标覆盖：
// - `taskCreate<String> { "..." }` 通过 body wrapper + transport 返回 `String`
// - `Task<String>.onComplete(ex, k)` 能恢复 `Continuation<String>`
// - `Task<String>.complete/result()` 不再依赖旧 `Int` ABI

import scoop.core.*
import scoop.task.*

effect Waiter {
    fun wait(): String
}

fun main(): Int {
    val ex: Executor = executorCreate()

    val t: Task<String> = taskCreate<String> {
        println("body")
        "task"
    }

    val _w: Unit = handle {
        val v: String = Waiter.wait()
        println("waiter")
        println(v)
    } with {
        Waiter.wait(), k -> {
            val ok: Bool = t.onComplete(ex, k)
            when (ok) {
                true -> println("registered")
                false -> println("registered_fail")
            }
        }
    }

    val started: Bool = t.tryStart(ex)
    when (started) {
        true -> println("start_ok")
        false -> println("start_fail")
    }

    println("pending1")
    println(ex.debugPendingCount())

    val ranTask: Bool = ex.runNext()
    when (ranTask) {
        true -> println("ran_task")
        false -> println("ran_task_fail")
    }

    println("result1")
    println(t.result())
    println("pending2")
    println(ex.debugPendingCount())

    val ranWaiter: Bool = ex.runNext()
    when (ranWaiter) {
        true -> println("ran_waiter")
        false -> println("ran_waiter_fail")
    }

    println("pending3")
    println(ex.debugPendingCount())

    val manual: Task<String> = taskCreateManual<String>()
    val manualOk: Bool = manual.complete("manual")
    when (manualOk) {
        true -> println("manual_ok")
        false -> println("manual_fail")
    }

    println("result2")
    println(manual.result())

    ex.destroy()
    println("done")
    return 0
}
