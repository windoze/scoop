// EXPECT: pass
//
// P4-T01c：`@Intrinsic struct` 应允许 ordinary instance method body；
// 对 value-type receiver 的 interface dispatch 仍必须走现有 metadata-driven itable 路径，
// 而不是要求新增任何按类型名分支。

@file:AllowIntrinsic

package fixtures.runpass

import scoop.core.*

interface DummyIface {
    fun m(): Int
}

@Intrinsic
struct Dummy() : DummyIface {
    override fun m(): Int {
        return 41
    }
}

fun read(it: DummyIface): Int {
    return it.m()
}

fun main(): Int {
    val value: DummyIface = Dummy()
    if (read(value) != 41) {
        return 1
    }
    return 0
}
