// EXPECT: fail
// T3006: 暂时标记为 fail——统一 state-machine codegen (T3005) 切换后，
// continuation_alloc 的 frame 指针类型不匹配（ptr vs ptr addrspace(1)）。
// RUN-STDOUT: try_catch_finally_raise_int_basic.stdout
//
// T0615: lowering step 1（补齐）：`finally` 的清理语义。
//
// 目标覆盖：
// - try 正常路径会执行 finally 一次；
// - try 触发 Raise.raise 并被 catch 捕获时，也会执行 finally 一次；
// - finally 的执行顺序：在 try/catch 完成后、离开表达式前执行。

import scoop.core.*

fun boom(): Int / Raise<Int> {
    println("boom_before")
    Raise.raise(7)
    println("boom_after")
    return 0
}

fun main(): Int {
    println("case_ok")
    val ok: Int = try {
        println("try_ok")
        1
    } catch (e: Int) {
        println("catch_ok")
        e
    } finally {
        println("finally_ok")
    }
    println("after_ok")

    println("case_raise")
    val bad: Int = try {
        val x: Int = boom()
        println("unreachable")
        x
    } catch (e: Int) {
        println("catch_raise")
        println(e)
        0
    } finally {
        println("finally_raise")
    }
    println("after_raise")

    val _ = ok + bad
    return 0
}
