// EXPECT: pass
// RUN-STDOUT: effect_escape_continuation_indirect_perform_binder_string_use.stdout
//
// T2003c0c2b1a: single-arm indirect escape-continuation arm binder should
// materialize as the real String payload type inside the arm body.

import scoop.core.*

effect Ask {
    fun ask(prompt: String): String
}

fun fetch(): String / (Ask) {
    val prompt: String = "hello"
    val resumed: String = Ask.ask(prompt)
    println("fetch_resumed")
    println(resumed)
    resumed
}

fun main() {
    var saved_k: Continuation<String>? = None()

    val result: String = handle {
        println("body_start")
        val value: String = fetch()
        println("body_done")
        println(value)
        value
    } with {
        Ask.ask(key), k -> {
            println("arm")
            println(key)
            saved_k = Some(k)
            "fallback"
        }
    }
    println("result")
    println(result)

    when (saved_k) {
        Some(k) -> {
            val _: Unit = try {
                k.resume("world")
            } catch (e: RuntimeError) {
                println("resume_error")
            }
            println("after_resume")
        }
        None -> println("no_continuation")
    }
}
