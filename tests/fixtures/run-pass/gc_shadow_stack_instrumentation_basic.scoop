import scoop.core.*

fun foo(): Unit {
    // 这些 `Any` 局部变量会触发 `Int -> Any` 装箱（heap 分配）。
    // 插桩应把这些引用写入当前函数的 `GcFrame.roots[]`，供 runtime 扫描。
    val a: Any = 1
    val b: Any = 2
    val c: Any = 3

    val n: Int = __scoop_gc_debug_count_roots_current_thread()
    println(n)
}

fun main(): Int {
    foo()
    return 0
}
