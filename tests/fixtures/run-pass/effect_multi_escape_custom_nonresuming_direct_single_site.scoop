// EXPECT: pass
// RUN-STDOUT: effect_multi_escape_custom_nonresuming_direct_single_site.stdout
//
// T2003c0c2b1: 无 immediate-resume 的 multi-arm handle（single direct escape site）。
// - body 直接命中 escape-continuation arm；
// - `k.resume(...)` 后继续执行 escape site 之后的 tail；
// - tail 里的 custom non-resuming effect 由同一个 source-handle 的 sibling custom arm 接住。

import scoop.core.*

effect Ask {
    fun ask(): String
}

effect Abort {
    fun stop(text: String): Nothing
}

fun main() {
    var saved: Continuation<String, Int>? = None()

    val result: Int = handle {
        val prefix: String = "prefix"
        println("body")
        val msg: String = Ask.ask()
        println("after_ask")
        println(prefix)
        println(msg)
        Abort.stop(msg)
        99
    } on {
        Ask.ask(), k -> {
            println("ask_arm")
            saved = Some(k)
            7
        }
        Abort.stop(text: String) -> {
            println("abort_arm")
            println(text)
            5
        }
    }

    println("after_handle")
    println(result)

    when (saved) {
        Some(k) -> {
            val _: Int = try {
                k.resume("hello")
            } catch (e: RuntimeError) {
                println("unexpected_error")
                0
            }
            println("after_resume")
        }
        None -> println("missing")
    }

    println("done")
}
