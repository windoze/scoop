// EXPECT: pass
// RUN-STDOUT: effect_resume_mixed_escape_post_immediate_block.stdout
//
// T2003c0b2c1a: mixed-arm immediate-resume + sibling escape-continuation
// supports a statement-position nested block direct escape site after the
// immediate site.

import scoop.core.*

effect Yield {
    fun next(): Int
}

effect Ask {
    fun ask(): String
}

class Cell(var k: Continuation<String>?)

fun main() {
    val none_k: Continuation<String>? = None()
    val cell: Cell = Cell(none_k)
    val note: String? = Some("captured_note")

    val result: Int = handle {
        val prefix: String = "prefix"
        println("body")
        val x: Int = Yield.next()
        println("after_yield")
        @Safe {
            println("block_enter")
            val label: String = "inner"
            val first: String = Ask.ask()
            println("after_first")
            println(label)
            println(first)
        }
        println("after_block")
        println(prefix)
        println(x)
        x + 1
    } with {
        Yield.next() -> resume {
            println("yield_arm")
            resume(41)
        }
        Ask.ask(), k -> {
            println("ask_arm")
            when (note) {
                Some(text) -> println(text)
                None -> println("missing_note")
            }
            cell.k = Some(k)
            7
        }
    }

    println("after_handle")
    println(result)

    when (cell.k) {
        Some(k1) -> {
            cell.k = none_k
            val _: Unit = try {
                k1.resume("hello")
            } catch (e: RuntimeError) {
                println("unexpected_error")
            }
            println("after_resume")
        }
        None -> println("missing")
    }

    println("done")
}
