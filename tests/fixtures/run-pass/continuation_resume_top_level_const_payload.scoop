// RUN-STDOUT: continuation_resume_top_level_const_payload.stdout
//
// T3009b1R: regression for `Continuation.resume(...)` precise payload typing
// when the payload expression is a top-level typed VarRef. HIR lowers top-level
// VarRef as `Any`, so builtin codegen must recover the concrete payload type
// rather than falling back to `Ref` and triggering value coercion failures.

import scoop.core.*

const val RESUME_VALUE: Int = 42

effect Query {
    fun query(): Int
}

fun main() {
    var saved: Continuation<Int>? = None()

    val _h: Unit = handle {
        val value: Int = Query.query()
        println("value")
        println(value)
    } with {
        Query.query(), k -> {
            saved = Some(k)
        }
    }

    println("after_handle")

    when (saved) {
        Some(k) -> {
            val _r: Unit = try {
                k.resume(RESUME_VALUE)
            } catch (e: RuntimeError) {
                println("unexpected_error")
            }
            println("after_resume")
        }
        None -> println("missing")
    }

    println("done")
}
