// EXPECT: pass
// RUN-STDOUT: delegated_property_map_backed_basic.stdout
//
// P5-T02A：member-access delegated properties（spec §10.4）
// - `val p: T by data` / `by this.data` 都必须统一走 `$delegate.getValue(thisRef, PropertyMeta)` 路径。

import scoop.core.*

class Data(val name: String, val city: String) {
    fun getValue(thisRef: Any, property: PropertyMeta): String {
        if (property.name == "name") {
            name
        } else {
            city
        }
    }
}

class JsonObject(val data: Data) {
    val name: String by data
    val city: String by this.data
}

fun main(): Int {
    val d: Data = Data("Alice", "Paris")
    val obj: JsonObject = JsonObject(d)
    println(obj.name)
    println(obj.city)
    return 0
}
