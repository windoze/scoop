// EXPECT: pass
// RUN-STDOUT: delegated_property_lazy_thread_safety_publication_multi_init.stdout
// TIMEOUT: 3000
//
// T1326：delegated properties 的线程安全语义（lazy）
// - `LazyThreadSafetyMode.Publication`：允许多个线程并发执行 initializer（可能执行多次）
// - 但最终只应发布（缓存）一个值供后续读取
//
// 说明：当前 LLVM codegen 尚不支持 `object` 成员赋值（assignment lhs 为 member access），
// 当前改用 `scoop.sync` barrier 让两个线程都进入 initializer 后再统一放行，
// 间接验证 Publication 在执行 initializer 期间不会持有 lazy mutex。

import scoop.core.*
import scoop.delegates.*
import scoop.sync.*
import scoop.thread.*

class SyncState(
    val lock: Mutex,
    val cv: CondVar,
    var readyCount: Int,
    var start: Bool,
    var initStarted: Int,
    var initRelease: Bool,
    var resultCount: Int,
    var result1: Int,
    var result2: Int
)

class C() {
    val x: Int by lazy(LazyThreadSafetyMode.Publication) {
        val st: SyncState = Shared.state
        st.lock.lock()
        st.initStarted = st.initStarted + 1
        st.cv.notifyAll()
        while (st.initRelease == false) {
            st.cv.wait(st.lock)
        }
        st.lock.unlock()
        7
    }
}

object Shared {
    val c: C = C()
    val state: SyncState = SyncState(mutexCreate(), condVarCreate(), 0, false, 0, false, 0, 0, 0)
}

fun worker() {
    val st: SyncState = Shared.state
    st.lock.lock()
    st.readyCount = st.readyCount + 1
    st.cv.notifyAll()
    while (st.start == false) {
        st.cv.wait(st.lock)
    }
    st.lock.unlock()

    val value: Int = Shared.c.x

    st.lock.lock()
    when (st.resultCount == 0) {
        true -> {
            st.result1 = value
        }
        false -> {
            st.result2 = value
        }
    }
    st.resultCount = st.resultCount + 1
    st.cv.notifyAll()
    st.lock.unlock()
}

fun main() {
    val st: SyncState = Shared.state

    val t1: Thread = threadSpawn { worker() }
    val t2: Thread = threadSpawn { worker() }

    st.lock.lock()
    while (st.readyCount < 2) {
        st.cv.wait(st.lock)
    }
    st.start = true
    st.cv.notifyAll()
    while (st.initStarted < 2) {
        st.cv.wait(st.lock)
    }
    st.initRelease = true
    st.cv.notifyAll()
    while (st.resultCount < 2) {
        st.cv.wait(st.lock)
    }
    val v1: Int = st.result1
    val v2: Int = st.result2
    val initStarted: Int = st.initStarted
    st.lock.unlock()

    t1.join()
    t2.join()

    println(v1)
    println(v2)
    println(f"init_started={initStarted}")
    println("ok")
}
