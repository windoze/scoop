// EXPECT: pass
// RUN-STDOUT: delegated_property_lazy_thread_safety_publication_multi_init.stdout
// TIMEOUT: 3000
//
// T1326：delegated properties 的线程安全语义（lazy）
// - `LazyThreadSafetyMode.Publication`：允许多个线程并发执行 initializer（可能执行多次）
// - 但最终只应发布（缓存）一个值供后续读取
//
// 说明：当前 LLVM codegen 尚不支持 `object` 成员赋值（assignment lhs 为 member access），
// 因此这里用 channel barrier 让两个线程都进入 initializer 后再统一放行，
// 间接验证 Publication 在执行 initializer 期间不会持有 lazy mutex。

import scoop.core.*
import scoop.delegates.*
import scoop.thread.*
import scoop.channels.*

class C() {
    val x: Int by lazy(LazyThreadSafetyMode.Publication) {
        val initStarted: Channel<Int> = Shared.initStarted
        val initRelease: Channel<Int> = Shared.initRelease

        initStarted.send(1)
        val _go: Int? = initRelease.recv()
        7
    }
}

object Shared {
    val c: C = C()

    val ready: Channel<Int> = channelCreate<Int>()
    val start: Channel<Int> = channelCreate<Int>()
    val results: Channel<Int> = channelCreate<Int>()

    val initStarted: Channel<Int> = channelCreate<Int>()
    val initRelease: Channel<Int> = channelCreate<Int>()
}

fun worker() {
    val c: C = Shared.c
    val ready: Channel<Int> = Shared.ready
    val start: Channel<Int> = Shared.start
    val results: Channel<Int> = Shared.results

    ready.send(1)
    val _go: Int? = start.recv()
    val v: Int = c.x
    val _sent: Bool = results.send(v)
}

fun main() {
    val ready: Channel<Int> = Shared.ready
    val start: Channel<Int> = Shared.start
    val results: Channel<Int> = Shared.results
    val initStarted: Channel<Int> = Shared.initStarted
    val initRelease: Channel<Int> = Shared.initRelease

    val t1: Thread = threadSpawn { worker() }
    val t2: Thread = threadSpawn { worker() }

    val _r1: Int? = ready.recv()
    val _r2: Int? = ready.recv()

    start.send(1)
    start.send(1)

    // 等待两个 initializer 都已开始（Publication 允许并发执行 initializer）。
    val _i1: Int? = initStarted.recv()
    val _i2: Int? = initStarted.recv()

    // 放行两个 initializer。
    initRelease.send(1)
    initRelease.send(1)

    val v1: Int? = results.recv()
    val v2: Int? = results.recv()

    when (v1) {
        Some(x) -> println(x)
        None -> println("missing")
    }
    when (v2) {
        Some(x) -> println(x)
        None -> println("missing")
    }

    t1.join()
    t2.join()

    println("init_started=2")
    println("ok")
}
