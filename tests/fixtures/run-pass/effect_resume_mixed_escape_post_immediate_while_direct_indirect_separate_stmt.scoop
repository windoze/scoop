// EXPECT: pass
// RUN-STDOUT: effect_resume_mixed_escape_post_immediate_while_direct_indirect_separate_stmt.stdout
//
// T2003u5d1: mixed-arm immediate-resume + sibling escape-continuation
// supports top-level separate-stmt direct -> indirect sites inside a while
// body after the immediate site, including replay into later iterations.

import scoop.core.*

effect Yield {
    fun next(): Int
}

effect Ask {
    fun ask(seed: Int): String
}

class Cell(var k: Continuation<String>?)

fun fetch(base: Int, label: String): String / (Ask) {
    println("fetch_enter")
    println(label)
    val msg: String = Ask.ask(base + 1)
    println("fetch_resume")
    println(msg)
    println(label)
    msg
}

fun main() {
    val none_k: Continuation<String>? = None()
    val cell: Cell = Cell(none_k)

    val result: Int = handle {
        println("body")
        val x: Int = Yield.next()
        println("after_yield")
        var i: Int = 0
        while (i < 2) {
            println("iter_begin")
            val label: String = if (i == 0) "iter0" else "iter1"
            val direct: String = Ask.ask(x + i)
            println("after_direct")
            println(direct)
            println(label)
            val indirect: String = fetch(x + i + 10, label)
            println("after_indirect")
            println(indirect)
            println(label)
            i = i + 1
            println("iter_end")
        }
        println("after_while_done")
        x + i
    } with {
        Yield.next() -> resume {
            println("yield_arm")
            resume(40)
        }
        Ask.ask(seed), k -> {
            println("ask_arm")
            println(seed)
            cell.k = Some(k)
            7
        }
    }

    println("after_handle")
    println(result)

    when (cell.k) {
        Some(k1) -> {
            cell.k = none_k
            val _: Unit = try {
                k1.resume("direct_iter0")
            } catch (e: RuntimeError) {
                println("unexpected_error1")
            }
            println("after_resume1")
        }
        None -> println("missing1")
    }

    when (cell.k) {
        Some(k2) -> {
            cell.k = none_k
            val _: Unit = try {
                k2.resume("indirect_iter0")
            } catch (e: RuntimeError) {
                println("unexpected_error2")
            }
            println("after_resume2")
        }
        None -> println("missing2")
    }

    when (cell.k) {
        Some(k3) -> {
            cell.k = none_k
            val _: Unit = try {
                k3.resume("direct_iter1")
            } catch (e: RuntimeError) {
                println("unexpected_error3")
            }
            println("after_resume3")
        }
        None -> println("missing3")
    }

    when (cell.k) {
        Some(k4) -> {
            cell.k = none_k
            val _: Unit = try {
                k4.resume("indirect_iter1")
            } catch (e: RuntimeError) {
                println("unexpected_error4")
            }
            println("after_resume4")
        }
        None -> println("missing4")
    }

    println("done")
}
