// EXPECT: pass
//
// P4-T01c：generic `@Intrinsic class` 的 ordinary method body 必须沿用现有 generic class member path，
// 同时允许 override interface method 与独立 instance method 共存。

package fixtures.runpass

import scoop.core.*

fun read(it: DummyIter): Int {
    return it.token()
}

fun main(): Int {
    val ints: Container<Int> = Container(9)
    val flags: Container<Bool> = Container(true)

    if (read(ints) != 29) {
        return 1
    }
    if (ints.echo(9) != 9) {
        return 2
    }
    if (flags.echo(true) != true) {
        return 3
    }
    return 0
}
