import scoop.core.*

fun main(): Int {
    println("start")

    // true 分支：lazy message 不应被求值。
    requireLazy(true) {
        println("require(true) message")
    }
    println("after require(true)")

    val a: Int = try {
        requireLazy(false) {
            println("require(false) message")
        }
        1
    } catch (e: RuntimeError) {
        when (e) {
            NullAssertionFailed -> 10
            ClassCastFailed -> 11
            ContinuationAlreadyResumed -> 30
        }
    }
    println(a)

    val b: Int = try {
        checkLazy(false) {
            println("check(false) message")
        }
        2
    } catch (e: RuntimeError) {
        when (e) {
            NullAssertionFailed -> 12
            ClassCastFailed -> 20
            ContinuationAlreadyResumed -> 31
        }
    }
    println(b)

    println("end")
    return 0
}
