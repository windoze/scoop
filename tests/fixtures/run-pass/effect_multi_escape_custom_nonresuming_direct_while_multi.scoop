// EXPECT: pass
// RUN-STDOUT: effect_multi_escape_custom_nonresuming_direct_while_multi.stdout
//
// T2003c0c2b3b3: 无 immediate-resume 的 multi-arm handle
// 支持 while body 中的 direct escape site。
// - 第一次 `resume(...)` 会完成当前迭代尾部，然后再次命中同一个 while-body direct site；
// - 第二次 `resume(...)` 会完成当前迭代、重检 loop condition，并继续 after-while tail；
// - after-while tail 仍可命中 sibling custom non-resuming arm。

import scoop.core.*

effect Ask {
    fun ask(label: String): String
}

effect Abort {
    fun stop(text: String): Nothing
}

class Cell(var k: Continuation<String, Int>?, var seen: Int)

fun main() {
    val none_k: Continuation<String, Int>? = None()
    val cell: Cell = Cell(none_k, 0)

    val result: Int = handle {
        println("body")
        var i: Int = 0
        while (i < 2) {
            println("iter_begin")
            println(i)
            val tag: String = if (i == 0) "zero_tag" else "one_tag"
            val value: String = Ask.ask(if (i == 0) "first" else "second")
            println("after_ask")
            println(tag)
            println(value)
            i = i + 1
            println("iter_end")
            println(i)
        }
        println("after_while")
        Abort.stop(if (i == 2) "stop_done" else "stop_bad")
        99
    } on {
        Ask.ask(label: String), k -> {
            cell.seen = cell.seen + 1
            println("ask_arm")
            println(cell.seen)
            println(label)
            cell.k = Some(k)
            7
        }
        Abort.stop(text: String) -> {
            println("abort_arm")
            println(text)
            5
        }
    }

    println("after_handle")
    println(result)

    when (cell.k) {
        Some(k1) -> {
            cell.k = none_k
            val _: Int = try {
                k1.resume("alpha")
            } catch (e: RuntimeError) {
                println("unexpected_resume1")
                0
            }
        }
        None -> println("missing1")
    }
    println("after_resume1")

    when (cell.k) {
        Some(k2) -> {
            cell.k = none_k
            val _: Int = try {
                k2.resume("beta")
            } catch (e: RuntimeError) {
                println("unexpected_resume2")
                0
            }
        }
        None -> println("missing2")
    }
    println("after_resume2")
    println("done")
}
