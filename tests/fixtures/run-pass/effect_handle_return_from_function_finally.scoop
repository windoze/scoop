// EXPECT: pass
// RUN-STDOUT: effect_handle_return_from_function_finally.stdout
//
// T3016: handle body `return` 命中后，outer `finally` 仍需在真正返回前执行一次。

import scoop.core.*

effect Yield {
    fun next(): Int
}

fun returnThroughFinally(): Int {
    val _: Int = handle {
        println("body")
        return 7
    } with {
        Yield.next() -> resume {
            resume(0)
        }
    } finally {
        println("finally")
    }

    println("after_handle")
    return 0
}

fun main(): Int {
    println(returnThroughFinally())
    return 0
}
