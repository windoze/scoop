// EXPECT: pass
// RUN-STDOUT: effect_resume_mixed_escape_pre_immediate_block.stdout
//
// T2003c0b2c1a: mixed-arm immediate-resume + sibling escape-continuation
// supports a statement-position nested block direct escape site before the
// immediate site.
// Current `@Safe { ... }` is only a temporary naked-block workaround until
// T2203 lands; this fixture does not depend on safe-region semantics.

import scoop.core.*

effect Yield {
    fun next(): Int
}

effect Ask {
    fun ask(seed: Int): String
}

class Cell(var k: Continuation<String>?)

fun main() {
    val none_k: Continuation<String>? = None()
    val cell: Cell = Cell(none_k)

    val result: Int = handle {
        println("body")
        @Safe {
            println("block_enter")
            val seed: Int = 10
            val tag: String = "pre_block"
            val first: String = Ask.ask(seed)
            println("after_first")
            println(first)
            println(tag)
        }
        val x: Int = Yield.next()
        println("after_yield")
        println(x)
        x + 1
    } with {
        Yield.next() -> resume {
            println("yield_arm")
            resume(41)
        }
        Ask.ask(seed), k -> {
            println("ask_arm")
            cell.k = Some(k)
            7
        }
    }

    println("after_handle")
    println(result)

    when (cell.k) {
        Some(k1) -> {
            cell.k = none_k
            val _: Unit = try {
                k1.resume("hello")
            } catch (e: RuntimeError) {
                println("unexpected_error")
            }
            println("after_resume")
        }
        None -> println("missing")
    }

    println("done")
}
