// EXPECT: pass
// RUN-MODE: dump-stackmaps
// RUN-STDOUT-CONTAINS: records:
// RUN-STACKMAPS-RECORDS-GT: 0
//
// 目标：GC-FIX Phase C2d：补齐端到端回归（interface dispatch）。
// - itable 形式的 interface 调用在 statepoint/stackmap 下应能产出可解析的 stackmaps。

import scoop.core.*

interface IFace {
    fun ping(): Int
}

class Impl(val s: String) : IFace {
    fun ping(): Int {
        println(f"iface={this.s}")
        return 0
    }
}

fun main(): Int {
    val x: IFace = Impl(f"hello {7}")
    __scoop_gc_collect()
    return x.ping()
}
