// T4016T1a：`Task` 目标形状 `Created(val start: () -> __TaskStepResult)` 不能再依赖 wrapper/workaround。

import scoop.core.*

enum TaskState {
    Created(val start: () -> __TaskStepResult),
    Running,
}

fun drive(state: TaskState): Int {
    val viaWhen: Int = when (state) {
        Created(start) -> {
            val first: __TaskStepResult = start()
            1
        }
        Running -> 0
    }

    val TaskState.Created(bound) = state
    val second: __TaskStepResult = bound()
    return viaWhen + 1
}

fun main(): Int {
    return drive(Created({ __scoop_task_step_ready(0) }))
}
