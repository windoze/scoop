import scoop.core.*

enum TaskState {
    Created(val start: () -> __TaskStepResult<Int>),
    Running,
}

fun drive(state: TaskState): Int {
    val viaWhen: Int = when (state) {
        Created(start) -> {
            val first: __TaskStepResult<Int> = start()
            1
        }
        Running -> 0
    }

    val TaskState.Created(bound) = state
    val second: __TaskStepResult<Int> = bound()
    return viaWhen + 1
}

fun main(): Int {
    return drive(Created({ __task_step_ready(0) }))
}
