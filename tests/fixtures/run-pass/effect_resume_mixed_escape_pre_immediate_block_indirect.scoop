// EXPECT: pass
// RUN-STDOUT: effect_resume_mixed_escape_pre_immediate_block_indirect.stdout
//
// T2003c0b2c3a: mixed-arm immediate-resume + sibling escape-continuation
// supports a statement-position nested block indirect escape site before the
// immediate site.
// Current `@Safe { ... }` is only a temporary naked-block workaround until
// T2201/T2203 lands; this fixture does not depend on safe-region semantics.

import scoop.core.*

effect Yield {
    fun next(): Int
}

effect Ask {
    fun ask(seed: Int): String
}

fun fetch(base: Int, label: String): String / (Ask) {
    println("fetch_enter")
    println(label)
    val msg: String = Ask.ask(base + 1)
    println("fetch_resume")
    println(msg)
    println(label)
    msg
}

fun main() {
    var saved: Continuation<String>? = None()

    val result: Int = handle {
        println("body")
        @Safe {
            println("block_enter")
            val seed: Int = 40
            val label: String = "pre"
            val reply: String = fetch(seed, label)
            println("after_fetch")
            println(reply)
            println(label)
        }
        println("before_yield")
        val x: Int = Yield.next()
        println("after_yield")
        println(x)
        x + 2
    } with {
        Yield.next() -> resume {
            println("yield_arm")
            resume(41)
        }
        Ask.ask(seed), k -> {
            println("ask_arm")
            println(seed)
            saved = Some(k)
            7
        }
    }

    println("after_handle")
    println(result)

    when (saved) {
        Some(k) -> {
            val _: Unit = try {
                k.resume("hello")
            } catch (e: RuntimeError) {
                println("unexpected_error")
            }
            println("after_resume")
        }
        None -> println("missing")
    }

    println("done")
}
