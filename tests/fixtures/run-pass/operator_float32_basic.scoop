// EXPECT: pass
// RUN-STDOUT: operator_float32_basic.stdout
// P8-T06: Float32 arithmetic, comparison, NaN/Inf, and precision boundary behavior.

import scoop.core.*

fun main() {
    val a: Float32 = 1.5f
    val b: Float32 = 2.0f
    val nan: Float32 = 0.0f / 0.0f
    val posInf: Float32 = 1.0f / 0.0f
    val negInf: Float32 = -1.0f / 0.0f
    val precisionEdge: Float32 = 16777216.0f

    val plusOp: Float32 = a + b
    val plusMethod: Float32 = a.plus(b)
    val minusOp: Float32 = b - a
    val minusMethod: Float32 = b.minus(a)
    val timesOp: Float32 = a * b
    val timesMethod: Float32 = a.times(b)
    val divOp: Float32 = a / b
    val divMethod: Float32 = a.div(b)
    val remOp: Float32 = a % b
    val remMethod: Float32 = a.rem(b)

    if (!(plusOp == 3.5f)) { panic("fixture assertion failed") }
    if (!(plusMethod == 3.5f)) { panic("fixture assertion failed") }
    if (!(minusOp == 0.5f)) { panic("fixture assertion failed") }
    if (!(minusMethod == 0.5f)) { panic("fixture assertion failed") }
    if (!(timesOp == 3.0f)) { panic("fixture assertion failed") }
    if (!(timesMethod == 3.0f)) { panic("fixture assertion failed") }
    if (!(divOp == 0.75f)) { panic("fixture assertion failed") }
    if (!(divMethod == 0.75f)) { panic("fixture assertion failed") }
    if (!(remOp == 1.5f)) { panic("fixture assertion failed") }
    if (!(remMethod == 1.5f)) { panic("fixture assertion failed") }
    if (!((posInf + negInf).isNaN())) { panic("fixture assertion failed") }
    if (!(posInf.plus(negInf).isNaN())) { panic("fixture assertion failed") }
    if (!(nan.isNaN())) { panic("fixture assertion failed") }
    if (!(posInf.isInfinite())) { panic("fixture assertion failed") }
    if (!(!(nan < 1.0f))) { panic("fixture assertion failed") }
    if (!(!nan.lt(1.0f))) { panic("fixture assertion failed") }
    if (!(nan != nan)) { panic("fixture assertion failed") }
    if (!(nan.notEquals(nan))) { panic("fixture assertion failed") }
    if (!((precisionEdge + 1.0f) == precisionEdge)) { panic("fixture assertion failed") }
    if (!(precisionEdge.plus(1.0f).equals(precisionEdge))) { panic("fixture assertion failed") }

    println(plusOp)
    println(plusMethod)
    println(minusOp)
    println(minusMethod)
    println(timesOp)
    println(timesMethod)
    println(divOp)
    println(divMethod)
    println(remOp)
    println(remMethod)
    println((posInf + negInf).isNaN())
    println(posInf.plus(negInf).isNaN())
    println(nan.isNaN())
    println(posInf.isInfinite())
    println(nan < 1.0f)
    println(nan.lt(1.0f))
    println(nan != nan)
    println(nan.notEquals(nan))
    println((precisionEdge + 1.0f) == precisionEdge)
    println(precisionEdge.plus(1.0f).equals(precisionEdge))
}
