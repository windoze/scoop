// EXPECT: pass
// RUN-STDOUT: operator_float32_basic.stdout
// P8-T06: Float32 arithmetic, comparison, NaN/Inf, and precision boundary behavior.

import scoop.core.*

fun main() {
    val a: Float32 = 1.5f
    val b: Float32 = 2.0f
    val nan: Float32 = 0.0f / 0.0f
    val posInf: Float32 = 1.0f / 0.0f
    val negInf: Float32 = -1.0f / 0.0f
    val precisionEdge: Float32 = 16777216.0f

    val plusOp: Float32 = a + b
    val plusMethod: Float32 = a.plus(b)
    val minusOp: Float32 = b - a
    val minusMethod: Float32 = b.minus(a)
    val timesOp: Float32 = a * b
    val timesMethod: Float32 = a.times(b)
    val divOp: Float32 = a / b
    val divMethod: Float32 = a.div(b)
    val remOp: Float32 = a % b
    val remMethod: Float32 = a.rem(b)

    require(plusOp == 3.5f)
    require(plusMethod == 3.5f)
    require(minusOp == 0.5f)
    require(minusMethod == 0.5f)
    require(timesOp == 3.0f)
    require(timesMethod == 3.0f)
    require(divOp == 0.75f)
    require(divMethod == 0.75f)
    require(remOp == 1.5f)
    require(remMethod == 1.5f)
    require((posInf + negInf).isNaN())
    require(posInf.plus(negInf).isNaN())
    require(nan.isNaN())
    require(posInf.isInfinite())
    require(!(nan < 1.0f))
    require(!nan.lt(1.0f))
    require(nan != nan)
    require(nan.notEquals(nan))
    require((precisionEdge + 1.0f) == precisionEdge)
    require(precisionEdge.plus(1.0f).equals(precisionEdge))

    println(plusOp)
    println(plusMethod)
    println(minusOp)
    println(minusMethod)
    println(timesOp)
    println(timesMethod)
    println(divOp)
    println(divMethod)
    println(remOp)
    println(remMethod)
    println((posInf + negInf).isNaN())
    println(posInf.plus(negInf).isNaN())
    println(nan.isNaN())
    println(posInf.isInfinite())
    println(nan < 1.0f)
    println(nan.lt(1.0f))
    println(nan != nan)
    println(nan.notEquals(nan))
    println((precisionEdge + 1.0f) == precisionEdge)
    println(precisionEdge.plus(1.0f).equals(precisionEdge))
}
