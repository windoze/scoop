// EXPECT: pass
// RUN-STDOUT: destructuring_val_variant_match_basic.stdout
// EXPECT-EXIT: 0
// 目标：P3-T04：refutable `val` variant pattern 在匹配路径绑定 payload，嵌套 tuple pattern 也可用。

package fixtures.run_pass

import scoop.core.*

enum PairResult {
    Pair(val left: Int, val right: Int),
    Empty,
}

fun unwrap(opt: Int?): Int {
    val Some(x) = opt
    return x + 1
}

fun nested(pair: (Int?, Int)): Int {
    val (Some(x), y) = pair
    return x + y
}

fun firstPair(value: PairResult): Int {
    val PairResult.Pair(first, ..) = value
    return first
}

fun main(): Int {
    println(unwrap(Some(41)))
    println(nested((Some(5), 7)))
    println(firstPair(Pair(8, 99)))
    return 0
}
