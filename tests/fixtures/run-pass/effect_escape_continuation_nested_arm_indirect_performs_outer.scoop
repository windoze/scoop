// EXPECT: pass
// RUN-STDOUT: effect_escape_continuation_nested_arm_indirect_performs_outer.stdout
//
// T1606g: Nested handle dispatch — inner escape-cont arm indirectly performs outer effect.
// - Outer non-resuming handler catches EffectB.
// - Inner escape-continuation handler catches EffectA.
// - Inner body performs EffectA → inner arm catches.
// - Inner arm calls `doFire()` which performs EffectB → should propagate to outer.
// - Verifies: indirect perform (through function call) from escape-continuation
//   arm body correctly flag-propagates to the nearest matching outer handler.

import scoop.core.*

effect EffectA {
    fun askA(code: Int): Int
}

effect EffectB {
    fun fireB(code: Int): Int
}

fun doFire(c: Int): Int / (EffectB) {
    println("doFire")
    println(c)
    EffectB.fireB(c)
}

fun main(): Int {
    val result: Int = handle {
        println("outer_body")

        val _: Unit = handle {
            println("inner_body")
            val v: Int = EffectA.askA(10)
            // Unreachable: outer handler is non-resuming so this never continues.
            println("unreachable_inner_body")
            println(v)
        } with {
            EffectA.askA(code: Int), k -> {
                println("inner_arm")
                println(code)
                // Indirect perform of EffectB through function call.
                val _: Int = doFire(code * 3)
                // Unreachable: outer handler is non-resuming.
                println("unreachable_arm")
            }
        }

        println("unreachable_outer_body")
        999
    } with {
        EffectB.fireB(code: Int) -> {
            println("outer_catch_B")
            println(code)
            code + 1
        }
    }

    println("result")
    println(result)
    return 0
}
