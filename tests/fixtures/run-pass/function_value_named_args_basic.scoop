// EXPECT: pass
// RUN-STDOUT: function_value_named_args_basic.stdout
//
// T4003c：函数值 direct call 支持命名实参。
// - 使用合成参数名 `a0/a1`；
// - 命名实参重排后仍需按源码顺序求值。

import scoop.core.*

fun mark(n: Int): Int {
    println(100 + n)
    return n
}

fun main(): Int {
    val add: (Int, Int) -> Int = { a: Int, b: Int -> a + b }

    println(add(a1 = mark(2), a0 = mark(1)))
    return 0
}
