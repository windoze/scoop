// EXPECT: pass
// RUN-STDOUT: std_sync_basic.stdout
//
// 目标：T1319b `scoop.sync` 最小同线程 smoke 可回归。
//
// 说明：
// - Mutex：create/lock/unlock/destroy 不崩溃；
// - CondVar：create/notify/destroy 不崩溃；
// - Once：run 只执行一次（同线程重复调用应直接返回）。
// 并发 wait/notify 与后端矩阵由 runtime_gc/std_sync_backend_parity_*.scoop 覆盖。
// SYSROOT-DEPS: scoop.sync

import scoop.core.*
import scoop.sync.*

fun main() {
    val m: Mutex = mutexCreate()
    m.lock()
    println("mutex: locked")
    m.unlock()
    println("mutex: unlocked")
    m.destroy()
    println("mutex: destroyed")

    val cv: CondVar = condVarCreate()
    cv.notifyOne()
    cv.notifyAll()
    cv.destroy()
    println("condvar: destroyed")

    val once: Once = onceCreate()
    when (once.isDone()) {
        true -> println("once: done")
        false -> println("once: not-done")
    }

    once.run { println("once: init") }

    when (once.isDone()) {
        true -> println("once: done")
        false -> println("once: not-done")
    }

    // 第二次 run 不应再次执行 block。
    once.run { println("once: init2") }

    println("ok")
}
