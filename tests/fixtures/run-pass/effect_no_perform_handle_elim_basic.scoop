// EXPECT: pass
// RUN-STDOUT: effect_no_perform_handle_elim_basic.stdout
// T1604：无 perform 的 try/catch（desugar 为 handle）应被消除为纯顺序语义（body -> finally?）。
// 该用例用 stdout 证明：优化前后输出一致；并可用 `python3 tools/run_fixtures.py --gc-stress` 回归。

import scoop.core.*

fun helper(x: Int): Int {
    return x + 1
}

fun main(): Int {
    println("before")

    val v: Int = try {
        helper(41)
    } catch (e: RuntimeError) {
        0
    }

    println(v)
    println("after")
    return 0
}
