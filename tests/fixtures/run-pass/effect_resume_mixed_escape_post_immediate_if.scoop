// EXPECT: pass
// RUN-STDOUT: effect_resume_mixed_escape_post_immediate_if.stdout
//
// T2003c0b2c1b: mixed-arm immediate-resume + sibling escape-continuation
// supports if then/else direct escape sites after the immediate site and
// resumes through the matching branch tail before merging after the if.

import scoop.core.*

effect Yield {
    fun next(): Int
}

effect Ask {
    fun ask(seed: Int): String
}

class Cell(var k: Continuation<String>?, var seen: Int)

fun run(flag: Bool, cell: Cell, none_k: Continuation<String>?) {
    cell.seen = 0

    val result: Int = handle {
        val x: Int = Yield.next()
        if (flag) {
            cell.seen = 10
            val first: String = Ask.ask(10)
            cell.seen = 12
        } else {
            cell.seen = 20
            val first: String = Ask.ask(20)
            cell.seen = 22
        }
        cell.seen = if (flag) 13 else 23
        x + 1
    } with {
        Yield.next() -> resume {
            resume(41)
        }
        Ask.ask(seed), k -> {
            cell.k = Some(k)
            cell.seen = if (flag) 11 else 21
            7
        }
    }

    println(result)
    println(cell.seen)

    when (cell.k) {
        Some(k1) -> {
            cell.k = none_k
            val _: Unit = try {
                k1.resume(if (flag) "resume_then" else "resume_else")
            } catch (e: RuntimeError) {
                println(-99)
            }
            println(cell.seen)
        }
        None -> println(-1)
    }
}

fun main() {
    val none_k: Continuation<String>? = None()
    val cell: Cell = Cell(none_k, 0)
    run(true, cell, none_k)
    run(false, cell, none_k)
}
