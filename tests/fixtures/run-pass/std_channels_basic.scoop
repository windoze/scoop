// EXPECT: pass
// RUN-STDOUT: std_channels_basic.stdout
//
// 目标：T1319d `scoop.channels`（pthread backend）unbounded mpsc 最小可执行语义可回归。
//
// 说明：
// - sender 线程发送 1..3 后 close；
// - main 线程阻塞式 recv 并按 FIFO 顺序打印；
// - drain 完成后验证 close 语义：close 后 send 返回 false。

import scoop.core.*
import scoop.thread.*
import scoop.channels.*

fun drainIntChannel(ch: Channel<Int>): Unit {
    var keep: Bool = true
    while (keep) {
        val v: Int? = ch.recv()
        keep = when (v) {
            Some(x) -> {
                println(x)
                true
            }
            None -> {
                println("recv: closed")
                false
            }
        }
    }
}

fun main() {
    val ch: Channel<Int> = channelCreate<Int>()

    val t: Thread = threadSpawn {
        // 说明：closure body 在当前阶段走“block expression”类型检查路径；
        // 该路径尚未支持 while/break/continue 等语句，因此这里手动展开固定次数发送。
        ch.send(1)
        ch.send(2)
        ch.send(3)
        ch.close()
    }

    drainIntChannel(ch)
    t.join()

    when (ch.send(999)) {
        true -> println("send_after_close: bad")
        false -> println("send_after_close: ok")
    }

    println("ok")
}
