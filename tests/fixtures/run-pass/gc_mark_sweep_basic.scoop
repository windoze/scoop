// EXPECT: pass
// RUN-STDOUT: gc_mark_sweep_basic.stdout
//
// 目标：TODO T0910 GC v0 mark-sweep（单线程，手动触发）。
// - 分配 1 个 live 对象（`Any` 装箱）
// - 通过 runtime debug helper 制造大量垃圾对象（不写入 roots）
// - 手动触发一次 `__scoop_gc_collect()`，应回收垃圾对象但保留 live 对象

import scoop.core.*

fun main(): Unit {
    // live root：会触发 `Int -> Any` 装箱（heap 分配），并写入当前函数的 GC roots slot。
    val keep: Any = 1

    // 1) 仅有 keep：应为 1
    println(__scoop_gc_debug_heap_object_count())

    // 2) 制造垃圾对象：应变为 1 + 1000
    __scoop_gc_debug_alloc_garbage(1000)
    println(__scoop_gc_debug_heap_object_count())

    // 3) 手动触发 GC：应回收垃圾对象，保留 keep
    __scoop_gc_collect()
    println(__scoop_gc_debug_heap_object_count())

    // 避免 keep 被“未使用”优化掉（O0 下通常不需要，但保持语义显式）。
    val _also_keep: Any = keep
}

