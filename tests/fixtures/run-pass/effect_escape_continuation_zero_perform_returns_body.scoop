// EXPECT: pass
// RUN-STDOUT: effect_escape_continuation_zero_perform_returns_body.stdout
// 目标：T1606a
// - `, k ->`（escape continuation）的 handler arm 存在；
// - 但 handle body 内不存在匹配该 arm 的 perform 点；
// - 因此 arm 不可达，`handle` 应退化为顺序执行 body 并返回 body 的值。

import scoop.core.*

effect Yield {
    fun next(): Int
}

fun main() {
    val result: Int = handle {
        println("body")
        7
    } with {
        Yield.next(), k -> {
            println("arm")
            9
        }
    }

    println(result)
}
