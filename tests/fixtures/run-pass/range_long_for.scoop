// EXPECT: pass
// RUN-STDOUT: range_long_for.stdout
// EXPECT-EXIT: 0

import scoop.core.*

fun main(): Int {
    var count: Int = 0
    var firstOk: Bool = false
    var lastOk: Bool = false
    for (x in 0L..10L) {
        if (count == 0) {
            firstOk = x == 0L
        }
        if (x == 10L) {
            lastOk = true
        }
        count = count + 1
    }
    println(count)
    println(firstOk)
    println(lastOk)
    return 0
}
