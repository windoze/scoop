// EXPECT: fail
// T3006: 暂时标记为 fail——统一 state-machine codegen (T3005) 切换后，
// 部分 main body codegen 节点尚未在 state-machine 路径上支持。
// RUN-STDOUT: effect_resume_mixed_custom_nonresuming_dispatch.stdout
//
// T2003c0a: mixed-arm immediate-resume + sibling custom non-resuming dispatch.
// - body 先命中 immediate-resume arm；
// - resume 后继续执行 handle body；
// - 后续 sibling custom non-resuming effect 会由同一个 source-handle 的另一个 arm 接住。

import scoop.core.*

effect Yield {
    fun next(): Int
}

effect Abort {
    fun stop(code: Int): Nothing
}

fun main(): Int {
    val result: Int = handle {
        println("body")
        val x: Int = Yield.next()
        println("after_yield")
        println(x)
        Abort.stop(x + 1)
        99
    } with {
        Yield.next() -> resume {
            println("yield_arm")
            resume(40)
        }
        Abort.stop(code: Int) -> {
            println("abort_arm")
            println(code)
            5
        }
    }

    println("result")
    println(result)
    return 0
}
