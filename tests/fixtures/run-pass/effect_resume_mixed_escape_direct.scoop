// EXPECT: pass
// RUN-STDOUT: effect_resume_mixed_escape_direct.stdout
//
// T2003c0b1: mixed-arm immediate-resume + sibling escape-continuation（single direct site）。
// - 先命中 immediate-resume arm；
// - resume 后在同一个 source-handle 内命中 sibling escape-continuation arm；
// - continuation 恢复后继续执行 escape perform 之后的 top-level tail，并保留 pre-escape locals。

import scoop.core.*

effect Yield {
    fun next(): Int
}

effect Ask {
    fun ask(): String
}

fun main() {
    var saved: Continuation<String>? = None()

    val result: Int = handle {
        val prefix: String = "prefix"
        println("body")
        val x: Int = Yield.next()
        println("after_yield")
        println(x)
        val msg: String = Ask.ask()
        println("after_ask")
        println(prefix)
        println(x)
        println(msg)
        99
    } with {
        Yield.next() -> resume {
            println("yield_arm")
            resume(41)
        }
        Ask.ask(), k -> {
            println("ask_arm")
            saved = Some(k)
            7
        }
    }

    println("after_handle")
    println(result)

    when (saved) {
        Some(k) -> {
            val _: Unit = try {
                k.resume("hello world")
            } catch (e: RuntimeError) {
                println("unexpected_error")
            }
            println("after_resume")
        }
        None -> println("missing")
    }

    println("done")
}
