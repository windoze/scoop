import scoop.asyncio.*
import scoop.http.client.*
import scoop.platform.time.MonotonicTimeSource
import scoop.time.Duration
import scoop.url.Url

internal suspend fun timeoutPool(client: HttpClient, url: Url) {
    val limit = Duration.milliseconds(10L)
    val held = client.execute(HttpRequest.get(url.resolve("/held")))
    val error = timeoutFailure suspend {
        client.execute(HttpRequest.get(url.resolve("/never"),
            options = HttpCallOptions(timeouts = Some(HttpTimeoutOptions(poolAcquire = Some(limit)))))); Unit
    }
    timeoutPhase(error, HttpTimeoutPhase.PoolAcquire, limit)
    timeoutCheck(error.requestBodyBytes + error.encodedResponseBodyBytes + error.responseBodyBytes == 0L)
    timeoutCheck(held.body.text(4L) == "held"); held.close()
    val long = Some(Duration.seconds(3600L))
    client.withResponse(HttpRequest.get(url.resolve("/after"),
        options = HttpCallOptions(timeouts = Some(HttpTimeoutOptions(long, long, long))))) suspend { response ->
        timeoutCheck(response.body.text(2L) == "ok")
    }
}

internal suspend fun timeoutHeaders(client: HttpClient, url: Url, mode: String) {
    val total = mode == "total-boundary"
    val limit = Duration.seconds(if (total) 15L else 5L)
    val began = AtomicBoolean(false)
    val observed = AtomicBoolean(false)
    val body = RequestBody.fromProducer(Some(4L)) suspend { _ ->
        began.store(true)
        throw IllegalStateException(Some("Continue producer must stay unopened"))
    }
    val timeouts = if (total) HttpTimeoutOptions(total = Some(limit)) else HttpTimeoutOptions(responseHeaders = Some(limit))
    val options = HttpCallOptions(expectContinue = true, continueWait = Duration.seconds(3600L),
        timeouts = Some(timeouts), onInformational = suspend { head ->
            timeoutCheck(head.status == 103U)
            observed.store(true)
            if (mode == "boundary" || total) {
                val started = MonotonicTimeSource.markNow()
                while (MonotonicTimeSource.markNow() - started < limit) {}
            } else currentEventLoop().sleep(Duration.seconds(3600L))
        })
    val error = timeoutFailure suspend { client.execute(HttpRequest.post(url, body, options = options)); Unit }
    timeoutPhase(error, if (total) HttpTimeoutPhase.Total else HttpTimeoutPhase.ResponseHeaders, limit)
    timeoutCheck(!began.load() && observed.load())
    timeoutCheck(error.requestBodyBytes + error.encodedResponseBodyBytes + error.responseBodyBytes == 0L)
}

internal suspend fun timeoutDecoded(client: HttpClient, url: Url) {
    val limit = Duration.seconds(15L)
    val response = client.execute(HttpRequest.post(url, RequestBody.fromText("send"),
        options = HttpCallOptions(timeouts = Some(HttpTimeoutOptions(total = Some(limit))))))
    timeoutCheck(response.status == 200U && response.wireContentLength!! > 10L)
    val error = timeoutFailure suspend { response.body.text(32L); Unit }
    timeoutPhase(error, HttpTimeoutPhase.Total, limit)
    timeoutCheck(error.requestBodyBytes == 4L && error.encodedResponseBodyBytes == 10L && error.responseBodyBytes == 0L)
    response.close()
}
