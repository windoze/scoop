fun verifyType(value: Boolean) { if (!value) { throw IllegalStateException() } }

fun main() {
    verifyType(Pair(17, 25).left + Pair(17, 25).right == 42)
    verifyType(Choice.Empty == Choice.Empty && Choice.Count(17) == Choice.Count(17))
    verifyType(Choice.Text("text") == Choice.Text("text"))
    verifyType(storage().read() == 3)
}
