import scoop.collections.*
import scoop.comparisons.*

fun check(value: Boolean, label: String) {
    if (!value) throw Exception(Some(label))
}

fun main() {
    val values = sortedSetOf<Double>(Double.NaN, 1.0, -0.0, 0.0, -Double.NaN, -1.0, Double.POSITIVE_INFINITY)
    check(values.size == 5L, "NaN and signed zero equivalence")
    val sequence = values.toList()
    check(sequence[0L] == -1.0 && sequence[1L] == 0.0 && sequence[2L] == 1.0, "finite order")
    check(sequence[3L] == Double.POSITIVE_INFINITY && sequence[4L].isNaN(), "infinity and NaN order")
    check(values.floor(Double.NaN)!!.isNaN() && values.higher(Double.NaN) == None, "NaN bounds")
    check(values.lower(Double.NaN) == Some(Double.POSITIVE_INFINITY), "NaN predecessor")
    val iterator = values.iterator()
    check(!values.add(-Double.NaN) && iterator.next() == Some(-1.0), "equivalent insert no-op")
    val map = sortedMapOf<Float, Int>((Float.NaN, 1), (-Float.NaN, 2), (-0f, 3), (0f, 4))
    check(map.size == 2L && map[Float.NaN] == Some(2) && map[0f] == Some(4), "float map")
    val reversed = values.toSortedSet(reverseOrder<Double>())
    check(reversed.firstOrNone()!!.isNaN() && reversed.lastOrNone() == Some(-1.0), "reverse floating order")
    println("tree floating passed")
}
