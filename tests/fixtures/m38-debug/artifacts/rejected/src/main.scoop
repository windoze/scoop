import observed.*

object PrivateInspector : ValueInspector<Secret>
object InternalInspector : ValueInspector<InternalState>
object ProtectedInspector : ValueInspector<ProtectedState>

class LocalSecret(private val token: String) {
    fun fromInside(): ValueView = IllegalReader.inspect(this)
}
object IllegalReader : ValueInspector<LocalSecret> {
    public inline override fun inspect(value: LocalSecret): ValueView {
        if (false) { return String.inspect(value.token) }
        return OpaqueInspector<LocalSecret>("hidden").inspect(value)
    }
}
fun main() {}
