import observed.bridge.*
import scoop.json.Json

fun equal(actual: String, expected: String) {
    if (actual != expected) {
        println("actual: " + actual + " expected: " + expected)
        throw IllegalStateException()
    }
}
object Remote : ValueInspector<External>
object RemoteFlow : ValueInspector<Flow<Int>>
object RemotePack : ValueInspector<Pack<String>>
fun main() {
    equal(DebugPrinter.format(Secret.inspect(Secret("private"))), "Secret(token=\"private\")")
    val callback = forwarded(Pack(5), Int.Companion)
    gcCollect()
    equal(DebugPrinter.format(callback()), "Pack<Int>(value=5)")
    equal(DebugPrinter.format(Remote.inspect(External(6))), "External(number=6, body=\"body\")")
    equal(DebugPrinter.format(RemotePack.inspect(Pack("hello"))), "Pack<String>(value=\"hello\")")
    equal(DebugPrinter.format(RemoteFlow.inspect(Flow.Data(7))), "Flow<Int>.Data(value=7)")
    equal(DebugPrinter.format(FlowInspector<String>(String.Companion).inspect(Flow.Data("x"))), "Flow<String>.Data(value=\"x\")")
    equal(Json.encodeToString(DTO(1), DTO.Companion), "{\"wire\":1,\"secret\":\"secret\"}")
    val decoded = Json.decodeFromString("{\"wire\":2}", DTO.Companion)
    equal(DebugPrinter.format(DTO.inspect(decoded)), "DTO(id=2, cache=9, secret=\"<redacted>\", option=Option<Int>.None)")
    println("debug-artifact-ok")
}
