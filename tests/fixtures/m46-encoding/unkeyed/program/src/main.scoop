import scoop.json.Json

object SharedSequence : ValueEncoder<Unit> {
    public override fun encode(value: Unit, encoder: Encoder) {
        val first = encoder.unkeyed()
        first.end()
        first.end()
        val second = encoder.unkeyed()
        Long.encode(1L, first.element())
        String.encode("second", second.element())
        second.end()
        gcCollect()
        Boolean.encode(true, encoder.unkeyed().element())
        first.end()
        second.end()
        val view = encoder.unkeyed()
    }
}

fun main() {
    check(Json.encodeToString(Unit, SharedSequence) == "[1,\"second\",true]")
    val empty = ValueEncoderFunction<Unit>({ value, encoder ->
        encoder.unkeyed().end()
        encoder.unkeyed().end()
    })
    check(Json.encodeToString(Unit, empty) == "[]")
    val arrays = ValueEncoderFunction<Unit>({ value, encoder ->
        val codec = Array<Long>.Companion.encoder(Long.Companion)
        codec.encode([1L, 2L], encoder)
        codec.encode([3L], encoder)
    })
    check(Json.encodeToString(Unit, arrays) == "[1,2,3]")
    println("unkeyed-ok")
}
