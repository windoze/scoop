fun check(value: Boolean) {
    if (!value) { throw IllegalStateException(Some("encoding view assertion failed")) }
}

fun reject(path: String, message: String, action: () -> Unit) {
    var rejected = false
    try { action() }
    catch (error: EncodingException) {
        check(error.path == path)
        check(error.message == Some(message))
        rejected = true
    }
    check(rejected)
}
