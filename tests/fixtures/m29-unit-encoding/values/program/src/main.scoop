import scoop.json.Json

private var evaluations: Int = 0

private fun check(value: Boolean, code: Int) {
    if (!value) { throw IllegalStateException(Some(f"unit encoding assertion ${code}")) }
}

private fun produce(fail: Boolean = false): Unit {
    evaluations += 1
    if (fail) { throw IllegalStateException(Some("unit argument")) }
}

private fun <T> erase(value: T): Any = value
private fun <T> encoded(value: T, codec: ValueEncoder<T>): String = Json.encodeToString(value, codec)

public struct Row(val empty: Unit, val count: Int) {
    public companion object : ValueEncoder<Row>, ValueDecoder<Row>
}
public struct Generic<T>(val value: T)
private class GenericEncoder<T>(private val element: ValueEncoder<T>) : ValueEncoder<Generic<T>>

private class Bound(private val codec: ValueEncoder<Unit>) : ValueEncoder<Unit> {
    public override fun encode(value: Unit, encoder: Encoder) { codec.encode(value, encoder) }
}
private class Throws : ValueEncoder<Unit> {
    public override fun encode(value: Unit, encoder: Encoder) {
        UnitEncoder.encode(produce(true), encoder)
    }
}
private class UsesReference(private val body: (Unit, Encoder) -> Unit) : ValueEncoder<Unit> {
    public override fun encode(value: Unit, encoder: Encoder) { body(value, encoder) }
}

fun main() {
    check(Json.encodeToString(Unit, UnitEncoder) == "null", 1)
    check(encoded((), UnitEncoder) == "null", 2)
    check(Json.encodeToString(produce(), UnitEncoder) == "null" && evaluations == 1, 3)
    val fromAny = erase(Unit)
    check(!(fromAny is ValueEncoder<Unit>), 4)
    check(Json.encodeToString(fromAny as Unit, UnitEncoder) == "null", 5)
    val codec: ValueEncoder<Unit> = UnitEncoder
    check(Json.encodeToString(Unit, codec) == "null", 6)
    check(Json.encodeToString(Unit, Bound(codec)) == "null", 7)
    val record = Json.decodeFromString("{\"count\":7,\"empty\":null}", Row.Companion)
    check(record.empty == Unit && Json.encodeToString(record, Row.Companion) == "{\"empty\":null,\"count\":7}", 8)
    check(Json.encodeToString(Generic<Unit>(Unit), GenericEncoder<Unit>(UnitEncoder)) == "{\"value\":null}", 9)
    check(Json.decodeFromString(Json.encodeToString(Unit, UnitEncoder), UnitDecoder) == (), 10)
    val reference: (Unit, Encoder) -> Unit = codec::encode
    val thunk: () -> Unit = { produce() }
    check(Json.encodeToString(thunk(), UnitEncoder) == "null" && evaluations == 2, 11)
    try { Json.encodeToString(Unit, Throws()); check(false, 12) }
    catch (error: IllegalStateException) { check(error.message == Some("unit argument"), 13) }
    check(evaluations == 3, 14)
    val sequence = Array<Unit>(3L) { _ -> Unit }
    check(sequence.size == 3L && sequence[2L] == Unit, 15)
    // The bound reference captures the codec and keeps Unit as a zero-sized argument.
    check(Json.encodeToString(Unit, UsesReference(reference)) == "null", 16)
    check(erase(UnitEncoder) is ValueEncoder<Unit> && !(erase(Unit) is ValueEncoder<Unit>), 17)
    check(!(erase(produce()) is ValueEncoder<Unit>) && evaluations == 4, 18)
    val unrelated: Any = "unrelated"
    check(!(unrelated is Generic<Unit> && erase(unrelated) is ValueEncoder<Generic<Unit>>), 19)
    check(!(erase(Generic<Unit>(Unit)) is ValueEncoder<Generic<Unit>>), 20)
    println("unit-values-ok")
}
