import scoop.json.Json

private var evaluations: Int = 0

private fun check(value: Boolean, code: Int) {
    if (!value) { throw IllegalStateException(Some(f"unit encoding assertion ${code}")) }
}

private fun produce(fail: Boolean = false): Unit {
    evaluations += 1
    if (fail) { throw IllegalStateException(Some("unit argument")) }
}

private fun <T> erase(value: T): Any = value
private fun <T> encoded(value: T, codec: Encodable<T>): String = Json.encode(value, codec)

public struct Row(val empty: Unit, val count: Int) {
    public companion object : Encodable<Row>, Decodable<Row>
}
public struct Generic<T>(val value: T)
private class GenericEncoder<T>(private val element: Encodable<T>) : Encodable<Generic<T>>

private class Bound(private val codec: Encodable<Unit>) : Encodable<Unit> {
    public override fun encode(value: Unit, encoder: Encoder) { codec.encode(value, encoder) }
}
private class Throws : Encodable<Unit> {
    public override fun encode(value: Unit, encoder: Encoder) {
        UnitEncoder.encode(produce(true), encoder)
    }
}
private class UsesReference(private val body: (Unit, Encoder) -> Unit) : Encodable<Unit> {
    public override fun encode(value: Unit, encoder: Encoder) { body(value, encoder) }
}

fun main() {
    check(Json.encode(Unit, UnitEncoder) == "null", 1)
    check(encoded((), UnitEncoder) == "null", 2)
    check(Json.encode(produce(), UnitEncoder) == "null" && evaluations == 1, 3)
    val fromAny = erase(Unit)
    check(!(fromAny is Encodable<Unit>), 4)
    check(Json.encode(fromAny as Unit, UnitEncoder) == "null", 5)
    val codec: Encodable<Unit> = UnitEncoder
    check(Json.encode(Unit, codec) == "null", 6)
    check(Json.encode(Unit, Bound(codec)) == "null", 7)
    val record = Json.decode("{\"count\":7,\"empty\":null}", Row.Companion)
    check(record.empty == Unit && Json.encode(record, Row.Companion) == "{\"empty\":null,\"count\":7}", 8)
    check(Json.encode(Generic<Unit>(Unit), GenericEncoder<Unit>(UnitEncoder)) == "{\"value\":null}", 9)
    check(Json.decode(Json.encode(Unit, UnitEncoder), UnitDecoder) == (), 10)
    val reference: (Unit, Encoder) -> Unit = codec::encode
    val thunk: () -> Unit = { produce() }
    check(Json.encode(thunk(), UnitEncoder) == "null" && evaluations == 2, 11)
    try { Json.encode(Unit, Throws()); check(false, 12) }
    catch (error: IllegalStateException) { check(error.message == Some("unit argument"), 13) }
    check(evaluations == 3, 14)
    val sequence = Array<Unit>(3L) { _ -> Unit }
    check(sequence.size == 3L && sequence[2L] == Unit, 15)
    // The bound reference captures the codec and keeps Unit as a zero-sized argument.
    check(Json.encode(Unit, UsesReference(reference)) == "null", 16)
    check(erase(UnitEncoder) is Encodable<Unit> && !(erase(Unit) is Encodable<Unit>), 17)
    check(!(erase(produce()) is Encodable<Unit>) && evaluations == 4, 18)
    val unrelated: Any = "unrelated"
    check(!(unrelated is Generic<Unit> && erase(unrelated) is Encodable<Generic<Unit>>), 19)
    check(!(erase(Generic<Unit>(Unit)) is Encodable<Generic<Unit>>), 20)
    println("unit-values-ok")
}
