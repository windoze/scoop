package downstream.methods
import consumer.methods.*

private class Later(val value: Int)

public fun check(): Int {
    val later = Later(42)
    if (exercise<Later>(later, { value -> value.value }) != 42) { return 1 }
    if (exercise<String>("value", { value -> 42 }) != 42) { return 2 }
    if (exercise<Unit>(Unit, { value -> 42 }) != 42) { return 3 }
    if (exercise<Int>(42, { value -> value }) != 42) { return 4 }
    return result()
}
