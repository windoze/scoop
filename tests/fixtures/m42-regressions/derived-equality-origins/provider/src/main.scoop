package repeated

class Probe<T : Equals<T>> {
    fun first(left: T?, right: T?): Boolean = left == right
    fun second(left: T?, right: T?): Boolean = left == right
    fun defaultFirst(left: T?, right: T?, equal: Boolean = left == right): Boolean = equal
    fun defaultSecond(left: T?, right: T?, equal: Boolean = left == right): Boolean = equal
}

public fun <T : Equals<T>> verifyValues(value: T): Boolean {
    val probe = Probe<T>()
    return probe.first(None, None) && !probe.second(Some(value), None) &&
        probe.defaultFirst(Some(value), Some(value)) && !probe.defaultSecond(Some(value), None)
}

public fun verify(): Boolean = verifyValues<Int>(42)
