import scoop.json.Json
import containers.coding
import containers.erase
import containers.eraseList
import containers.capture
import containers.shared
import containers.Envelope
import peers.nested
import peers.independent

private fun check(value: Boolean, code: Int) {
    if (!value) { throw IllegalStateException(Some("container artifact assertion " + code.toString())) }
}
private class Captured<T>(private val write: (T, Encoder) -> Unit) : Encodable<T> {
    public override fun encode(value: T, encoder: Encoder) { write(value, encoder) }
}
private struct Opaque()

fun main() {
    val integers = Array<Int>(3L) { index -> index.toInt32() + 1 }
    check(Json.encode(integers, coding(Int.Companion)) == "[1,2,3]", 1)
    check(Json.encode(Some(Unit), Captured(capture(UnitEncoder))) == "{\"Some\":[null]}", 2)
    val erased = erase(MutableArray<String>(2L) { _ -> "界" })
    check(!(erased is Encodable<MutableArray<String>>), 3)
    check(Json.encode(erased as MutableArray<String>, MutableArray<String>.encoder(String.Companion))
        == "[\"界\",\"界\"]", 4)
    val list = ArrayList<Int>()
    list.add(7)
    val erasedList = eraseList(list)
    check(!(erasedList is Encodable<ArrayList<Int>>), 5)
    check(Json.encode(erasedList as ArrayList<Int>, ArrayList<Int>.encoder(Int.Companion)) == "[7]", 6)
    check(!(erase(MutableArray<Opaque>(0L) { _ -> Opaque() }) is Encodable<MutableArray<Opaque>>), 7)
    check(!(eraseList(ArrayList<Opaque>()) is Encodable<ArrayList<Opaque>>), 8)
    val expected = "[{\"None\":{}},{\"Some\":[1]}]"
    val codec = Array<Option<Int>>.encoder(Option<Int>.encoder(Int.Companion))
    check(Json.encode(shared(), codec) == expected, 9)
    check(Json.encode(nested(), codec) == expected, 10)
    val fromPeer = independent()
    check(!(fromPeer is Encodable<Array<Option<Int>>>), 11)
    check(Json.encode(fromPeer as Array<Option<Int>>, codec) == expected, 12)
    val local = Array<Option<Int>>(2L) { index -> if (index == 0L) { None } else { Some(1) } }
    check(Json.encode(local, codec) == expected, 13)
    check(Json.encode(Envelope(integers, Some(4)), Envelope<Int>.encoder(Int.Companion))
        == "{\"items\":[1,2,3],\"last\":{\"Some\":[4]}}", 14)
    val restored = Json.decode(Json.encode(shared(), codec), Array<Option<Int>>.decoder(
        Option<Int>.decoder(Int.Companion)))
    check(Json.encode(restored, codec) == expected, 15)
    println("container-encoding-artifacts-ok")
}
