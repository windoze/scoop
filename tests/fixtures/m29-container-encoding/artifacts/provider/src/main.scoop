package containers

public fun <T : Encodable> coding(values: Array<T>): Encodable = values
public fun <T> erase(values: MutableArray<T>): Any = values
public fun <T> eraseList(values: ArrayList<T>): Any = values
public fun <T : Encodable> capture(value: Option<T>): (Encoder) -> Unit = value::encode
public fun shared(): Array<Option<Int>> = Array<Option<Int>>(2L) { index ->
    if (index == 0L) { None } else { Some(1) }
}
public struct Envelope<T : Encodable>(val items: Array<T>, val last: Option<T>) : Encodable
