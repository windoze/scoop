import scoop.json.Json

fun check(value: Boolean, code: Int) {
    if (!value) { throw IllegalStateException(Some("container encoding assertion " + code.toString())) }
}

fun main() {
    val integers = Array<Int>.encoder(Int.Companion)
    check(Json.encode(Array<Int>(0L) { _ -> 0 }, integers) == "[]", 1)
    val array = Array<Int>(3L) { index -> index.toInt32() - 1 }
    check(Json.encode(array, integers) == "[-1,0,1]", 2)
    val mutable = MutableArray<String>(2L) { index -> if (index == 0L) { "中" } else { "🙂" } }
    val strings = MutableArray<String>.encoder(String.Companion)
    check(Json.encode(mutable, strings) == "[\"中\",\"🙂\"]", 3)
    mutable[0L] = "文"
    check(Json.encode(mutable, strings) == "[\"文\",\"🙂\"]", 4)
    val list = ArrayList<Int>()
    val lists = ArrayList<Int>.encoder(Int.Companion)
    list.add(1)
    list.add(2)
    list.add(3)
    list.removeAt(1L)
    check(Json.encode(list, lists) == "[1,3]", 5)
    list.clear()
    check(Json.encode(list, lists) == "[]", 6)
    check(Json.encode(Array<Unit>(2L) { _ -> Unit }, Array<Unit>.encoder(UnitEncoder)) == "[null,null]", 7)
    val none: Option<Int> = None
    val some: Option<Int> = Some(7)
    val options = Option<Int>.encoder(Int.Companion)
    check(Json.encode(none, options) == "{\"None\":{}}", 8)
    check(Json.encode(some, options) == "{\"Some\":[7]}", 9)
    check(Json.encode(Some(Unit), Option<Unit>.encoder(UnitEncoder)) == "{\"Some\":[null]}", 10)
    val nested = Array<Option<Array<Int>>>(2L) { index ->
        if (index == 0L) { None } else { Some(array) }
    }
    val nestedCodec = Array<Option<Array<Int>>>.encoder(Option<Array<Int>>.encoder(integers))
    check(Json.encode(nested, nestedCodec) == "[{\"None\":{}},{\"Some\":[[-1,0,1]]}]", 11)
    val roundTrip = Json.decode(Json.encode(nested, nestedCodec), Array<Option<Array<Int>>>.decoder(
        Option<Array<Int>>.decoder(Array<Int>.decoder(Int.Companion))))
    check(Json.encode(roundTrip, nestedCodec) == Json.encode(nested, nestedCodec), 12)
    dynamicCases()
    combinedCases()
    println("container-encoding-ok")
}
