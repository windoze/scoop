import scoop.json.Json

private var visits: Int = 0
private struct Item(val number: Int) {
    public companion object : ValueEncoder<Item> {
        public override fun encode(value: Item, encoder: Encoder) {
            visits += 1
            if (value.number < 0) { throw IllegalStateException(Some("element failure")) }
            Int.encode(value.number, encoder)
        }
    }
}
private struct Record(@Serialize(rename = "wire") val values: Array<Option<Item>>) {
    public companion object : ValueEncoder<Record>
}
private class Captured<T>(private val write: (T, Encoder) -> Unit) : ValueEncoder<T> {
    public override fun encode(value: T, encoder: Encoder) { write(value, encoder) }
}
private fun <T> capture(element: ValueEncoder<T>): (Array<T>, Encoder) -> Unit {
    val codec = Array<T>.encoder(element)
    return codec::encode
}
private fun <T> coding(element: ValueEncoder<T>): ValueEncoder<Option<T>> = Option<T>.encoder(element)

fun combinedCases() {
    val data = Array<Option<Item>>(2L) { index -> Some(Item(index.toInt32())) }
    check(Json.encodeToString(Record(data), Record.Companion) == "{\"wire\":[0,1]}", 40)
    check(visits == 2, 41)
    val array = Array<Int>(2L) { index -> index.toInt32() + 3 }
    check(Json.encodeToString(array, Captured(capture(Int.Companion))) == "[3,4]", 42)
    check(Json.encodeToString(Some(array), coding(Array<Int>.encoder(Int.Companion))) == "[3,4]", 43)
    val maybe: Option<Int> = Some(6)
    val optionCodec = Option<Int>.encoder(Int.Companion)
    check(Json.encodeToString(maybe, Captured(optionCodec::encode)) == "6", 44)
    val mutable = MutableArray<Int>(1L) { _ -> 9 }
    val mutableCodec = MutableArray<Int>.encoder(Int.Companion)
    check(Json.encodeToString(mutable, Captured(mutableCodec::encode)) == "[9]", 45)
    val list = ArrayList<Int>()
    list.add(10)
    val listCodec = ArrayList<Int>.encoder(Int.Companion)
    check(Json.encodeToString(list, Captured(listCodec::encode)) == "[10]", 46)
    try {
        Json.encodeToString(Array<Item>(4L) { index -> Item(1 - index.toInt32()) }, Array<Item>.encoder(Item.Companion))
        check(false, 47)
    } catch (error: IllegalStateException) {
        check(error.message == Some("element failure"), 48)
    }
    check(visits == 5, 49)
}
