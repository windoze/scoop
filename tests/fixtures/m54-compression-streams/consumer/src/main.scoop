import scoop.compression.*
import scoop.platform.fs.*
import scoop.platform.io.*

private fun check(value: Boolean) { if (!value) throw IllegalStateException() }

private fun exercise(directory: Path, options: CompressionOptions) {
    val original = directory.resolve(Path.fromString("original.bin"))
    val encoded = directory.resolve(Path.fromString("encoded.bin"))
    val decoded = directory.resolve(Path.fromString("decoded.bin"))
    val writing = OpenOptions(read = false, write = true, create = true, truncate = true)
    val encodedFile = File.open(encoded, writing)
    CompressionSink.takeOwnership(encodedFile, options, 257L).use { sink ->
        File.open(original).use { source -> check(source.copyTo(sink, 123L) == 17321L) }
        sink.flush(); gcCollect(); sink.finish()
        check(sink.totals.inputBytes == 17321L)
        check(sink.totals.outputBytes == encodedFile.size())
    }
    check(encodedFile.isClosed)
    val sourceFile = File.open(encoded)
    DecompressionSource.takeOwnership(sourceFile, DecompressionOptions(options.format), 17L).use { source ->
        File.open(decoded, writing).use { sink -> check(source.copyTo(sink, 131L) == 17321L) }
        check(source.totals.inputBytes == sourceFile.size())
        check(source.totals.outputBytes == 17321L)
    }
    check(sourceFile.isClosed)
    val bytes = decoded.readAllBytes()
    check(bytes.size == 17321L)
    var index = 0L
    while (index < bytes.size) { check(bytes[index] == (index % 251L).toByte()); index += 1L }
}

fun main(args: Array<String>) {
    check(args.size == 2L)
    val directory = Path.fromString(args[1L]).resolve(Path.fromString("compression-data"))
    directory.createDirectory()
    try {
        directory.resolve(Path.fromString("original.bin")).writeAllBytes(Array<Byte>(17321L) { index -> (index % 251L).toByte() })
        for (options in [CompressionOptions.Gzip(GzipOptions()), CompressionOptions.Zlib(DeflateOptions()),
            CompressionOptions.RawDeflate(DeflateOptions()), CompressionOptions.Brotli(BrotliOptions()),
            CompressionOptions.Zstd(ZstdOptions())]) exercise(directory, options)
    } finally { directory.deleteRecursively() }
    println("compression file streams")
}
