public interface Role {
    public fun read(): Int
}
public open class Envelope {
    protected open class HiddenBase protected constructor(public val number: Int) {
        protected open fun hidden(): Int = number
    }
    protected open class Entry protected constructor(number: Int) : HiddenBase(number), Role {
        public override fun read(): Int = number
        protected override fun hidden(): Int = number
        protected open var slot: Int = number
    }
    protected class Leaf public constructor(number: Int) : Entry(number) {
        public override fun hidden(): Int = 7
    }
    protected object Cache : Role {
        public override fun read(): Int = 4
    }
    protected struct Pair(val number: Int) : Role {
        public override fun read(): Int = number
    }
    protected enum Choice { None, Value(Int) }
    private class Unrelated {}
}
public open class GenericOuter<T> {
    protected class ConcreteChild public constructor() : Role {
        public override fun read(): Int = 5
    }
    protected class GenericChild<U>(val item: U)
}
public class Derived : Envelope()
