public interface Reader {
    public fun empty(): Int
    public fun read(value: Int = 1): Int
}
public open class Envelope {
    protected class Box<T> private constructor(private val stored: T, count: Int = 2) {
        public constructor(value: T): this(value, 1) {}
        internal fun <U> choose(value: T, other: U, count: Int = 3): T = value
        private fun hidden(value: Int = 4): Int = value
        private class Static public constructor(value: Int = 5) {}
    }
    protected enum Choice<T> {
        Empty,
        Positional(T),
        Named { first: T, second: Int },
        Defaulted(val value: T, val count: Int = 6)
    }
    protected struct Pair<T>(val value: T, val count: Int = 7) {
        private constructor(value: T): this(value, 8) {}
    }
}
private fun unrelated(value: Int = 9): Int = value
