public interface View {
    public fun read(value: Int): Int
    public val token: Int
}
public open class Store protected constructor(seed: Int = 1) : View {
    protected open fun step(value: Int = 2): Int = value
    public override fun read(value: Int): Int = value
    public override val token: Int
        get() = 3
    public var exposed: Int
        get() = 4
        protected set(value) {}
    protected class Nested {
        private fun helper(): Int = 5
    }
}
public class Child : Store(1) {
    protected final override fun step(value: Int): Int = value
}
public object Shared : View {
    public override fun read(value: Int): Int = value
    public override val token: Int
        get() = 6
    internal const val marker: Int = 7
}
