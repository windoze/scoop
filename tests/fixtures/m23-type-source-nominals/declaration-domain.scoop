public interface Parent {}
public interface Readable: Parent { public fun read(value: Int): Int }
public open class Catalog protected constructor(seed: Int = 1): Readable {
    protected open fun next(value: Int = 2): Int = value
    public override fun read(value: Int): Int = value
    public var exposed: Int
        get() = 1
        protected set(value) {}
    protected var state: Int
        get() = 3
        private set(value) {}
    protected struct Pair(val first: Int, val second: Int = 4)
    protected enum Choice { None, Some(val value: Int) }
    protected class Generic<T>(private val item: T) {}
    protected object Cache {
        internal const val tag: Int = 5
        private fun empty(): Int = 6
    }
}
public class Leaf: Catalog(1) {
    protected final override fun next(value: Int): Int = value
}
private class Unused { public fun skip(): Int = 7 }
