import scoop.bytes.ByteArrayBuilder
import scoop.http.*
import scoop.platform.concurrent.Thread
import scoop.platform.memory.NativeByteBuffer
import scoop.text.hexToByteArray
import scoop.text.toHexString

private fun check(value: Boolean) {
    if (!value) throw IllegalStateException(Some("HTTP2 empty finish check failed"))
}

private fun request(): HttpRequestHead = HttpRequestHead(HttpVersion.Http2, "POST".toByteArray(),
    HttpRequestTarget.Http2("http".toByteArray(), "example.test".toByteArray(), "/".toByteArray()))

private fun feed(session: Http2Session, hex: String) {
    val bytes = hex.hexToByteArray()
    NativeByteBuffer.allocate(bytes.size).use { buffer ->
        buffer.writeBytes(bytes)
        check(session.receive(buffer) == bytes.size && buffer.readableBytes == 0L)
    }
}

private fun record(session: Http2Session, trace: StringBuilder, phase: String) {
    val bytes = ByteArrayBuilder()
    NativeByteBuffer.allocate(4093L).use { buffer ->
        while (true) {
            buffer.clear()
            val count = session.takeOutput(buffer)
            if (count == 0L) break
            bytes.append(buffer.readBytes(count))
        }
    }
    trace.append(phase).append(":").append(bytes.toByteArray().toHexString()).append("\n")
}

private fun write(session: Http2Session, id: Int, count: Long) {
    NativeByteBuffer.allocate(count).use { buffer ->
        buffer.writeBytes(Array<Byte>(count) { _ -> 120.toByte() })
        check(session.writeBody(id, buffer) == count)
    }
}

private fun exercise(mode: String): String {
    val response = mode == "response"
    val session = if (response) Http2Session.server() else Http2Session.client()
    return session.use {
        val trace = StringBuilder().append("begin\n")
        val window = if (mode == "connection") "0001fffe" else if (mode == "exact" || mode == "blocked") "00000003" else "00000000"
        if (response) feed(session, "505249202a20485454502f322e300d0a0d0a534d0d0a0d0a")
        feed(session, "0000060400000000000004" + window)
        record(session, trace, "settings")
        if (response) {
            feed(session, "000011010500000001828684010c6578616d706c652e74657374")
            session.submitResponse(1, HttpResponseHead(HttpVersion.Http2, 103U), false)
            session.submitResponse(1, HttpResponseHead(HttpVersion.Http2, 200U), false)
            session.finish(1)
        } else {
            val id = session.submitRequest(request(), false)
            check(id == 1)
            if (mode == "late") record(session, trace, "head")
            if (mode == "exact" || mode == "blocked") {
                write(session, id, if (mode == "exact") 3L else 4L)
                if (mode == "exact") record(session, trace, "body")
                session.finish(id, [HttpField("x-end".toByteArray(), "done".toByteArray())])
                if (mode == "blocked") {
                    record(session, trace, "blocked")
                    check(session.hasPendingOutput(id) && !session.wantsWrite)
                    feed(session, "00000408000000000100000001")
                }
            } else {
                if (mode == "connection") { write(session, id, 65535L); record(session, trace, "body") }
                session.finish(id)
                if (mode == "connection") {
                    val other = session.submitRequest(request(), false)
                    check(other == 3)
                    session.finish(other)
                }
            }
        }
        record(session, trace, "end")
        check(!session.hasPendingOutput(1) && !session.hasPendingOutput(3))
        trace.append("done").toString()
    }
}

private class TraceResult { var value: String? = None }

fun main(args: Array<String>) {
    val mode = args[1L]
    val result = TraceResult()
    Thread.start { result.value = Some(exercise(mode)) }.use { thread ->
        val first = exercise(mode)
        thread.join()
        println(first)
        println(result.value!!)
    }
}
