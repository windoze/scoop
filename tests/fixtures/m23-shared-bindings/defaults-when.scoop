package consumer.bindings
import upstream.bindings.*

public fun <T> exercise(seed: T, read: (T) -> Int): Int {
    val pair = Pair<T>(seed, 0)
    if (read(chosen<T>(pair)) != 42) { return 1 }
    if (read(matched<T>(pair)) != 42) { return 2 }
    if (patternBody<T>(pair, read) != 42) { return 3 }
    return when (pair) {
        case Pair { right: extra, left: value } -> read(value) + extra
    }
}

public fun result(): Int {
    val covered = when (Pair<Int?>(Some(40), 2)) {
        case Pair(Some(value), extra) -> value + extra
        case Pair(None, _) -> 1
    }
    if (covered != 42) { return 4 }
    val result = when (IntPair(40, 2)) {
        case IntPair(value, extra) if (extra == 2) -> value + extra
        else -> 1
    }
    return exercise<Int>(result, { item -> item })
}
