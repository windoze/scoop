package downstream.localcalls
import consumer.localcalls.*

private class Later(val value: Int)

public fun check(): Int {
    if (exercise<Later>(Later(42), { value -> value.value }) != 42) { return 1 }
    if (exercise<String>("retained", { value -> 42 }) != 42) { return 2 }
    if (exercise<Unit>(Unit, { value -> 42 }) != 42) { return 3 }
    return result()
}
