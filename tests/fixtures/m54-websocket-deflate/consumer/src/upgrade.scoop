import scoop.asyncio.*
import scoop.http.*
import scoop.platform.memory.NativeByteBuffer

suspend fun readUpgrade(source: AsyncByteSource): (HttpRequestHead, Array<Byte>) =
    Http1Decoder.server().use suspend { decoder ->
        NativeByteBuffer.allocate(1024L).use suspend { buffer ->
            var request: HttpRequestHead? = None
            var ended = false
            while (!ended) {
                when (decoder.nextEvent()) {
                    case Some(Http1Event.Request(head)) -> request = Some(head)
                    case Some(Http1Event.Trailers(fields)) -> check(fields.size == 0L)
                    case Some(Http1Event.End(_)) -> ended = true
                    case Some(_) -> throw IllegalStateException(Some("unexpected WebSocket upgrade body"))
                    case None -> {
                        if (buffer.readableBytes == 0L) {
                            buffer.clear()
                            check(source.readInto(buffer, buffer.writableBytes) > 0L)
                        }
                        check(decoder.receive(buffer) > 0L)
                    }
                }
            }
            (request!!, buffer.readBytes(buffer.readableBytes))
        }
    }
