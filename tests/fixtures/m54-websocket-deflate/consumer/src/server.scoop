import scoop.asyncio.*
import scoop.bytes.ByteArrayBuilder
import scoop.http.*
import scoop.http.asyncio.*
import scoop.platform.memory.NativeByteBuffer

suspend fun serveUpgrade(raw: HttpTransport, scope: CoroutineScope, profile: WsProfile) {
    try {
        val (request, prefix) = readUpgrade(raw)
        val handshake = WebSocketHandshake.parse(request)
        val response = handshake.response(Some("chat"), Some(profile.response()))
        val negotiated = handshake.accept(response)
        val header = Http1Encoder(HttpRole.Server).use { encoder ->
            val bytes = encoder.beginResponse(response, "GET".toByteArray())
            check(encoder.finish().size == 0L)
            bytes
        }
        val combined = ByteArrayBuilder().append(header).append(firstFrame()).toByteArray()
        sendBytes(raw, combined)
        raw.flush()
        val session = AsyncWebSocketSession.takeOwnership(HttpTransport.takeOwnershipWithPrefix(raw, prefix), scope,
            HttpRole.Server, sessionOptions(), negotiated.deflate)
        try {
            for (index in 0L..<3L) {
                val expected = if (index == 1L) "ordinary" else "chunk 🌍 repeating"
                check(session.receive()!!.readText() == expected)
                session.sendText("ack:" + expected, index != 1L)
            }
            val message = session.receive()!!
            val prefixBytes = "prefix 🌍 ".toByteArray()
            NativeByteBuffer.allocate(prefixBytes.size).use suspend { buffer ->
                message.readFully(buffer, prefixBytes.size)
                check(String.fromUtf8(buffer.readBytes(prefixBytes.size)) == "prefix 🌍 ")
            }
            check(!message.isComplete)
            session.sendText("prefix accepted")
            check(message.readText() == "tail")
            session.ping("server".toByteArray())
            session.sendText("stream accepted")
            val binary = session.receive()!!
            check(binary.type == WebSocketMessageType.Binary)
            session.sendBinary(binary.readBytes())
            check(session.receive()!!.readText() == "")
            session.sendText("")
            check(when (session.receive()) { case None -> true; case Some(_) -> false })
            check(session.shutdownGracefully().reason == "finished")
        } finally { session.close() }
    } finally { raw.close() }
}

private fun firstFrame(): Array<Byte> = WebSocketFrameEncoder(HttpRole.Server).use { encoder ->
    val bytes = "ready 🌍".toByteArray()
    val result = ByteArrayBuilder().append(encoder.beginFrame(WebSocketFrameHead(WebSocketOpcode.Text, bytes.size)))
    NativeByteBuffer.allocate(bytes.size).use { buffer ->
        buffer.writeBytes(bytes)
        result.append(encoder.writePayload(buffer))
        encoder.finishFrame()
        result.toByteArray()
    }
}
