import consumer.nominalConditions.result
import consumer.nominalConditions.exercise

@NoGC private struct Later(val value: Int)
private class Allocation(public val value: Int)

public fun check(): Int {
    val allocation = Allocation(result())
    if (exercise<Later>(Later(42), { item -> item.value }) != 42) { return 1 }
    if (exercise<Unit>(Unit, { item -> 42 }) != 42) { return 2 }
    return allocation.value
}
