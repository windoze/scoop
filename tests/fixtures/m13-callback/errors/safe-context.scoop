fun main() {
    val callback = foreignCallback<(Int, Ptr<Unit>) -> Int>(
        { value: Int -> value },
        1,
        ForeignCallbackMode.Reusable
    )
    val retained = retainForeignCallback(callback)
    val state = foreignCallbackState(retained)
    val failure = foreignCallbackFailure(retained)
    releaseForeignCallback(callback)
}
