@Extern(lib = "fixture_native", name = "m13_start_one")
fun startOne(
    callback: FunPtr<(Int, Ptr<Unit>) -> Int>,
    context: Ptr<Unit>,
    value: Int
): Ptr<Unit>

@Extern(lib = "fixture_native", name = "m13_join_one")
fun joinOne(job: Ptr<Unit>): Int

class ForeignResumeError(val payload: String) : Exception(Some("resume failed"))

class FailureGate(
    var job: Ptr<Unit>?,
    var observer: ForeignCallback<(Int, Ptr<Unit>) -> Int>?
)

class FailureRegistration(val gate: FailureGate) : SuspendRegistration<Int> {
    public final override fun register(continuation: Continuation<Int>) {
        @Unsafe {
            val worker = foreignCallback<(Int, Ptr<Unit>) -> Int>(
                { value: Int ->
                    gcCollect()
                    continuation.resumeWithException(
                        ForeignResumeError("foreign failure")
                    )
                    value
                },
                1,
                ForeignCallbackMode.OneShot
            )
            gate.observer = Some(retainForeignCallback(worker))
            gate.job = Some(startOne(worker.function, worker.context, 9))
        }
    }
}

class FailureTask(val gate: FailureGate) : SuspendTask<Int> {
    public final override suspend fun run(): Int {
        try {
            return suspendCoroutine(FailureRegistration(gate))
        } catch (exception: ForeignResumeError) {
            println(exception.payload)
            return 42
        } finally {
            println("finally")
        }
    }
}

class FailureCompletion() : Continuation<Int> {
    public final override fun resume(value: Int) {
        println(value)
    }

    public final override fun resumeWithException(exception: Throwable) {
        println("unexpected failure")
    }
}

fun <T> isNone(value: T?): Boolean = when (value) {
    Some(_) -> false
    None -> true
}

fun main() {
    @Unsafe {
        val gate = FailureGate(
            None,
            None
        )
        startCoroutine(FailureTask(gate), FailureCompletion())
        println("suspended")
        println(joinOne(gate.job!!))
        val observer = gate.observer!!
        println(foreignCallbackState(observer) == ForeignCallbackState.Completed)
        println(isNone(foreignCallbackFailure(observer)))
        releaseForeignCallback(observer)
    }
}
