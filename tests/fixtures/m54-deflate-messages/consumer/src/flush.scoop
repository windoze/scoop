import scoop.bytes.ByteArrayBuilder
import scoop.compression.*
import scoop.platform.memory.NativeByteBuffer

fun exerciseFlush(takeover: Boolean) {
    DeflateMessageEncoder(contextTakeover = takeover).use { encoder ->
        DeflateMessageDecoder(contextTakeover = takeover).use { decoder ->
            for (index in 0L..<3L) {
                if (index != 0L) { encoder.nextMessage(); decoder.nextMessage() }
                for (text in ["prefix 🌍 ", "", "compressed suffix"]) {
                    val bytes = flushPiece(encoder, text, false)
                    gcCollect()
                    if (readPiece(decoder, bytes, false) != text) throw IllegalStateException()
                    if (flushPiece(encoder, "", false).size != 0L) throw IllegalStateException()
                }
                val end = flushPiece(encoder, "", true)
                if (readPiece(decoder, end, true) != "") throw IllegalStateException()
            }
        }
    }
}

private fun flushPiece(encoder: DeflateMessageEncoder, text: String, finish: Boolean): Array<Byte> =
    NativeByteBuffer.allocate(text.byteLength).use { input ->
        NativeByteBuffer.allocate(1L).use { output ->
            input.writeBytes(text.toByteArray())
            val result = ByteArrayBuilder()
            while (true) {
                output.clear()
                val processing = input.readableBytes > 0L
                val step = if (processing) encoder.process(input, output)
                    else if (finish) encoder.finishMessage(output) else encoder.flush(output)
                result.append(output.readBytes(step.produced))
                if (!processing && step.state != CompressionState.NeedOutput) {
                    if ((step.state == CompressionState.Finished) != finish) throw IllegalStateException()
                    break
                }
            }
            result.toByteArray()
        }
    }

private fun readPiece(decoder: DeflateMessageDecoder, bytes: Array<Byte>, finish: Boolean): String =
    NativeByteBuffer.allocate(bytes.size).use { input ->
        NativeByteBuffer.allocate(3L).use { output ->
            input.writeBytes(bytes)
            val result = ByteArrayBuilder()
            while (true) {
                output.clear()
                val processing = input.readableBytes > 0L
                val step = if (processing || !finish) decoder.process(input, output) else decoder.finishMessage(output)
                result.append(output.readBytes(step.produced))
                if (input.readableBytes == 0L && step.state != CompressionState.NeedOutput &&
                    (!finish || step.state == CompressionState.Finished)) break
            }
            String.fromUtf8(result.toByteArray())
        }
    }
