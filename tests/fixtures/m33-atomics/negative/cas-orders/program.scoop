fun badRelaxedAcquire(cell: AtomicInt): Boolean = cell.compareAndSet(0, 1, MemoryOrder.Relaxed, MemoryOrder.Acquire)
fun badRelaxedRelease(cell: AtomicInt): Boolean = cell.compareAndSet(0, 1, MemoryOrder.Relaxed, MemoryOrder.Release)
fun badRelaxedAcqRel(cell: AtomicInt): Boolean = cell.compareAndSet(0, 1, MemoryOrder.Relaxed, MemoryOrder.AcqRel)
fun badRelaxedSeqCst(cell: AtomicInt): Boolean = cell.compareAndSet(0, 1, MemoryOrder.Relaxed, MemoryOrder.SeqCst)
fun badAcquireRelease(cell: AtomicInt): Boolean = cell.compareAndSet(0, 1, MemoryOrder.Acquire, MemoryOrder.Release)
fun badAcquireAcqRel(cell: AtomicInt): Boolean = cell.compareAndSet(0, 1, MemoryOrder.Acquire, MemoryOrder.AcqRel)
fun badAcquireSeqCst(cell: AtomicInt): Boolean = cell.compareAndSet(0, 1, MemoryOrder.Acquire, MemoryOrder.SeqCst)
fun badReleaseAcquire(cell: AtomicInt): Boolean = cell.compareAndSet(0, 1, MemoryOrder.Release, MemoryOrder.Acquire)
fun badReleaseRelease(cell: AtomicInt): Boolean = cell.compareAndSet(0, 1, MemoryOrder.Release, MemoryOrder.Release)
fun badReleaseAcqRel(cell: AtomicInt): Boolean = cell.compareAndSet(0, 1, MemoryOrder.Release, MemoryOrder.AcqRel)
fun badReleaseSeqCst(cell: AtomicInt): Boolean = cell.compareAndSet(0, 1, MemoryOrder.Release, MemoryOrder.SeqCst)
fun badAcqRelRelease(cell: AtomicInt): Boolean = cell.compareAndSet(0, 1, MemoryOrder.AcqRel, MemoryOrder.Release)
fun badAcqRelAcqRel(cell: AtomicInt): Boolean = cell.compareAndSet(0, 1, MemoryOrder.AcqRel, MemoryOrder.AcqRel)
fun badAcqRelSeqCst(cell: AtomicInt): Boolean = cell.compareAndSet(0, 1, MemoryOrder.AcqRel, MemoryOrder.SeqCst)
fun badSeqCstRelease(cell: AtomicInt): Boolean = cell.compareAndSet(0, 1, MemoryOrder.SeqCst, MemoryOrder.Release)
fun badSeqCstAcqRel(cell: AtomicInt): Boolean = cell.compareAndSet(0, 1, MemoryOrder.SeqCst, MemoryOrder.AcqRel)
fun main() {}
