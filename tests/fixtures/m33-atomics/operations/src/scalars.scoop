fun integerOperations() {
    val cell = AtomicInt(7)
    check(cell.load() == 7)
    cell.store(8)
    check(cell.exchange(3) == 8)
    check(cell.fetchAdd(4) == 3)
    check(cell.fetchSub(2) == 7)
    check(cell.fetchAnd(3) == 5)
    check(cell.fetchOr(6) == 1)
    check(cell.fetchXor(3) == 7)
    check(cell.load() == 4)
    check(!cell.compareAndSet(0, 9))
    check(cell.compareAndSet(4, 10))
    check(cell.compareAndExchange(11, 12) == 10)
    check(cell.compareAndExchange(10, 14) == 10)
    check(cell.load() == 14)
    cell.store(2147483647)
    check(cell.fetchAdd(1) == 2147483647)
    check(cell.load() == (0 - 2147483647 - 1))
    check(cell.fetchSub(1) == (0 - 2147483647 - 1))
    check(cell.load() == 2147483647)
    check(classBound(cell) == 2147483647)
    val read: () -> Int = { cell.load(MemoryOrder.Relaxed) }
    check(read() == 2147483647)
}

fun <T> classBound(cell: T): Int where T : AtomicInt = cell.load()

fun longOperations() {
    val cell = AtomicLong(7L)
    check(cell.load() == 7L)
    cell.store(8L)
    check(cell.exchange(3L) == 8L)
    check(cell.fetchAdd(4L) == 3L)
    check(cell.fetchSub(2L) == 7L)
    check(cell.fetchAnd(3L) == 5L)
    check(cell.fetchOr(6L) == 1L)
    check(cell.fetchXor(3L) == 7L)
    check(!cell.compareAndSet(0L, 9L))
    check(cell.compareAndSet(4L, 10L))
    check(cell.compareAndExchange(11L, 12L) == 10L)
    check(cell.compareAndExchange(10L, 14L) == 10L)
    check(cell.load() == 14L)
    cell.store(9223372036854775807L)
    check(cell.fetchAdd(1L) == 9223372036854775807L)
    check(cell.load() == (0L - 9223372036854775807L - 1L))
    check(cell.fetchSub(1L) == (0L - 9223372036854775807L - 1L))
    check(cell.load() == 9223372036854775807L)
}

fun booleanOperations() {
    val cell = AtomicBoolean(false)
    check(!cell.load())
    cell.store(true)
    check(cell.exchange(false))
    check(!cell.fetchOr(true))
    check(cell.fetchAnd(false))
    check(!cell.fetchXor(true))
    check(!cell.compareAndSet(false, false))
    check(cell.compareAndSet(true, false))
    check(!cell.compareAndExchange(true, true))
    check(!cell.compareAndExchange(false, true))
    check(cell.load())
}
