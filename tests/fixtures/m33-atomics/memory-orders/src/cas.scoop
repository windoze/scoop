fun casOrders() {
    val cell = AtomicInt(7)
    val first = Stamp(1)
    val second = Stamp(2)
    val ref = AtomicRef(first)
    cell.store(7)
    check(cell.compareAndSet(7, 8, MemoryOrder.Relaxed, MemoryOrder.Relaxed))
    check(!cell.compareAndSet(7, 9, MemoryOrder.Relaxed, MemoryOrder.Relaxed))
    check(cell.compareAndExchange(8, 7, MemoryOrder.Relaxed, MemoryOrder.Relaxed) == 8)
    check(cell.compareAndExchange(8, 9, MemoryOrder.Relaxed, MemoryOrder.Relaxed) == 7)
    ref.store(first)
    check(ref.compareAndSet(first, second, MemoryOrder.Relaxed, MemoryOrder.Relaxed))
    check(!ref.compareAndSet(first, first, MemoryOrder.Relaxed, MemoryOrder.Relaxed))
    check(ref.compareAndExchange(second, first, MemoryOrder.Relaxed, MemoryOrder.Relaxed) === second)
    check(ref.compareAndExchange(second, second, MemoryOrder.Relaxed, MemoryOrder.Relaxed) === first)
    gcCollect()
    check(ref.load() === first)
    cell.store(7)
    check(cell.compareAndSet(7, 8, MemoryOrder.Acquire, MemoryOrder.Relaxed))
    check(!cell.compareAndSet(7, 9, MemoryOrder.Acquire, MemoryOrder.Relaxed))
    check(cell.compareAndExchange(8, 7, MemoryOrder.Acquire, MemoryOrder.Relaxed) == 8)
    check(cell.compareAndExchange(8, 9, MemoryOrder.Acquire, MemoryOrder.Relaxed) == 7)
    ref.store(first)
    check(ref.compareAndSet(first, second, MemoryOrder.Acquire, MemoryOrder.Relaxed))
    check(!ref.compareAndSet(first, first, MemoryOrder.Acquire, MemoryOrder.Relaxed))
    check(ref.compareAndExchange(second, first, MemoryOrder.Acquire, MemoryOrder.Relaxed) === second)
    check(ref.compareAndExchange(second, second, MemoryOrder.Acquire, MemoryOrder.Relaxed) === first)
    gcCollect()
    check(ref.load() === first)
    cell.store(7)
    check(cell.compareAndSet(7, 8, MemoryOrder.Acquire, MemoryOrder.Acquire))
    check(!cell.compareAndSet(7, 9, MemoryOrder.Acquire, MemoryOrder.Acquire))
    check(cell.compareAndExchange(8, 7, MemoryOrder.Acquire, MemoryOrder.Acquire) == 8)
    check(cell.compareAndExchange(8, 9, MemoryOrder.Acquire, MemoryOrder.Acquire) == 7)
    ref.store(first)
    check(ref.compareAndSet(first, second, MemoryOrder.Acquire, MemoryOrder.Acquire))
    check(!ref.compareAndSet(first, first, MemoryOrder.Acquire, MemoryOrder.Acquire))
    check(ref.compareAndExchange(second, first, MemoryOrder.Acquire, MemoryOrder.Acquire) === second)
    check(ref.compareAndExchange(second, second, MemoryOrder.Acquire, MemoryOrder.Acquire) === first)
    gcCollect()
    check(ref.load() === first)
    cell.store(7)
    check(cell.compareAndSet(7, 8, MemoryOrder.Release, MemoryOrder.Relaxed))
    check(!cell.compareAndSet(7, 9, MemoryOrder.Release, MemoryOrder.Relaxed))
    check(cell.compareAndExchange(8, 7, MemoryOrder.Release, MemoryOrder.Relaxed) == 8)
    check(cell.compareAndExchange(8, 9, MemoryOrder.Release, MemoryOrder.Relaxed) == 7)
    ref.store(first)
    check(ref.compareAndSet(first, second, MemoryOrder.Release, MemoryOrder.Relaxed))
    check(!ref.compareAndSet(first, first, MemoryOrder.Release, MemoryOrder.Relaxed))
    check(ref.compareAndExchange(second, first, MemoryOrder.Release, MemoryOrder.Relaxed) === second)
    check(ref.compareAndExchange(second, second, MemoryOrder.Release, MemoryOrder.Relaxed) === first)
    gcCollect()
    check(ref.load() === first)
    cell.store(7)
    check(cell.compareAndSet(7, 8, MemoryOrder.AcqRel, MemoryOrder.Relaxed))
    check(!cell.compareAndSet(7, 9, MemoryOrder.AcqRel, MemoryOrder.Relaxed))
    check(cell.compareAndExchange(8, 7, MemoryOrder.AcqRel, MemoryOrder.Relaxed) == 8)
    check(cell.compareAndExchange(8, 9, MemoryOrder.AcqRel, MemoryOrder.Relaxed) == 7)
    ref.store(first)
    check(ref.compareAndSet(first, second, MemoryOrder.AcqRel, MemoryOrder.Relaxed))
    check(!ref.compareAndSet(first, first, MemoryOrder.AcqRel, MemoryOrder.Relaxed))
    check(ref.compareAndExchange(second, first, MemoryOrder.AcqRel, MemoryOrder.Relaxed) === second)
    check(ref.compareAndExchange(second, second, MemoryOrder.AcqRel, MemoryOrder.Relaxed) === first)
    gcCollect()
    check(ref.load() === first)
    cell.store(7)
    check(cell.compareAndSet(7, 8, MemoryOrder.AcqRel, MemoryOrder.Acquire))
    check(!cell.compareAndSet(7, 9, MemoryOrder.AcqRel, MemoryOrder.Acquire))
    check(cell.compareAndExchange(8, 7, MemoryOrder.AcqRel, MemoryOrder.Acquire) == 8)
    check(cell.compareAndExchange(8, 9, MemoryOrder.AcqRel, MemoryOrder.Acquire) == 7)
    ref.store(first)
    check(ref.compareAndSet(first, second, MemoryOrder.AcqRel, MemoryOrder.Acquire))
    check(!ref.compareAndSet(first, first, MemoryOrder.AcqRel, MemoryOrder.Acquire))
    check(ref.compareAndExchange(second, first, MemoryOrder.AcqRel, MemoryOrder.Acquire) === second)
    check(ref.compareAndExchange(second, second, MemoryOrder.AcqRel, MemoryOrder.Acquire) === first)
    gcCollect()
    check(ref.load() === first)
    cell.store(7)
    check(cell.compareAndSet(7, 8, MemoryOrder.SeqCst, MemoryOrder.Relaxed))
    check(!cell.compareAndSet(7, 9, MemoryOrder.SeqCst, MemoryOrder.Relaxed))
    check(cell.compareAndExchange(8, 7, MemoryOrder.SeqCst, MemoryOrder.Relaxed) == 8)
    check(cell.compareAndExchange(8, 9, MemoryOrder.SeqCst, MemoryOrder.Relaxed) == 7)
    ref.store(first)
    check(ref.compareAndSet(first, second, MemoryOrder.SeqCst, MemoryOrder.Relaxed))
    check(!ref.compareAndSet(first, first, MemoryOrder.SeqCst, MemoryOrder.Relaxed))
    check(ref.compareAndExchange(second, first, MemoryOrder.SeqCst, MemoryOrder.Relaxed) === second)
    check(ref.compareAndExchange(second, second, MemoryOrder.SeqCst, MemoryOrder.Relaxed) === first)
    gcCollect()
    check(ref.load() === first)
    cell.store(7)
    check(cell.compareAndSet(7, 8, MemoryOrder.SeqCst, MemoryOrder.Acquire))
    check(!cell.compareAndSet(7, 9, MemoryOrder.SeqCst, MemoryOrder.Acquire))
    check(cell.compareAndExchange(8, 7, MemoryOrder.SeqCst, MemoryOrder.Acquire) == 8)
    check(cell.compareAndExchange(8, 9, MemoryOrder.SeqCst, MemoryOrder.Acquire) == 7)
    ref.store(first)
    check(ref.compareAndSet(first, second, MemoryOrder.SeqCst, MemoryOrder.Acquire))
    check(!ref.compareAndSet(first, first, MemoryOrder.SeqCst, MemoryOrder.Acquire))
    check(ref.compareAndExchange(second, first, MemoryOrder.SeqCst, MemoryOrder.Acquire) === second)
    check(ref.compareAndExchange(second, second, MemoryOrder.SeqCst, MemoryOrder.Acquire) === first)
    gcCollect()
    check(ref.load() === first)
    cell.store(7)
    check(cell.compareAndSet(7, 8, MemoryOrder.SeqCst, MemoryOrder.SeqCst))
    check(!cell.compareAndSet(7, 9, MemoryOrder.SeqCst, MemoryOrder.SeqCst))
    check(cell.compareAndExchange(8, 7, MemoryOrder.SeqCst, MemoryOrder.SeqCst) == 8)
    check(cell.compareAndExchange(8, 9, MemoryOrder.SeqCst, MemoryOrder.SeqCst) == 7)
    ref.store(first)
    check(ref.compareAndSet(first, second, MemoryOrder.SeqCst, MemoryOrder.SeqCst))
    check(!ref.compareAndSet(first, first, MemoryOrder.SeqCst, MemoryOrder.SeqCst))
    check(ref.compareAndExchange(second, first, MemoryOrder.SeqCst, MemoryOrder.SeqCst) === second)
    check(ref.compareAndExchange(second, second, MemoryOrder.SeqCst, MemoryOrder.SeqCst) === first)
    gcCollect()
    check(ref.load() === first)
}
