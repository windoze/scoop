fun operationOrders() {
    val cell = AtomicInt(0)
    val flag = AtomicBoolean(false)
    val first = Stamp(1)
    val second = Stamp(2)
    val ref = AtomicRef(first)
    cell.store(0)
    check(cell.exchange(1, MemoryOrder.Relaxed) == 0)
    check(cell.fetchAdd(2, MemoryOrder.Relaxed) == 1)
    check(cell.fetchSub(1, MemoryOrder.Relaxed) == 3)
    check(cell.fetchAnd(3, MemoryOrder.Relaxed) == 2)
    check(cell.fetchOr(4, MemoryOrder.Relaxed) == 2)
    check(cell.fetchXor(7, MemoryOrder.Relaxed) == 6)
    flag.store(false)
    check(!flag.exchange(true, MemoryOrder.Relaxed))
    check(flag.fetchAnd(false, MemoryOrder.Relaxed))
    check(!flag.fetchOr(true, MemoryOrder.Relaxed))
    check(flag.fetchXor(false, MemoryOrder.Relaxed))
    ref.store(first)
    check(ref.exchange(second, MemoryOrder.Relaxed) === first)
    cell.store(0)
    check(cell.exchange(1, MemoryOrder.Acquire) == 0)
    check(cell.fetchAdd(2, MemoryOrder.Acquire) == 1)
    check(cell.fetchSub(1, MemoryOrder.Acquire) == 3)
    check(cell.fetchAnd(3, MemoryOrder.Acquire) == 2)
    check(cell.fetchOr(4, MemoryOrder.Acquire) == 2)
    check(cell.fetchXor(7, MemoryOrder.Acquire) == 6)
    flag.store(false)
    check(!flag.exchange(true, MemoryOrder.Acquire))
    check(flag.fetchAnd(false, MemoryOrder.Acquire))
    check(!flag.fetchOr(true, MemoryOrder.Acquire))
    check(flag.fetchXor(false, MemoryOrder.Acquire))
    ref.store(first)
    check(ref.exchange(second, MemoryOrder.Acquire) === first)
    cell.store(0)
    check(cell.exchange(1, MemoryOrder.Release) == 0)
    check(cell.fetchAdd(2, MemoryOrder.Release) == 1)
    check(cell.fetchSub(1, MemoryOrder.Release) == 3)
    check(cell.fetchAnd(3, MemoryOrder.Release) == 2)
    check(cell.fetchOr(4, MemoryOrder.Release) == 2)
    check(cell.fetchXor(7, MemoryOrder.Release) == 6)
    flag.store(false)
    check(!flag.exchange(true, MemoryOrder.Release))
    check(flag.fetchAnd(false, MemoryOrder.Release))
    check(!flag.fetchOr(true, MemoryOrder.Release))
    check(flag.fetchXor(false, MemoryOrder.Release))
    ref.store(first)
    check(ref.exchange(second, MemoryOrder.Release) === first)
    cell.store(0)
    check(cell.exchange(1, MemoryOrder.AcqRel) == 0)
    check(cell.fetchAdd(2, MemoryOrder.AcqRel) == 1)
    check(cell.fetchSub(1, MemoryOrder.AcqRel) == 3)
    check(cell.fetchAnd(3, MemoryOrder.AcqRel) == 2)
    check(cell.fetchOr(4, MemoryOrder.AcqRel) == 2)
    check(cell.fetchXor(7, MemoryOrder.AcqRel) == 6)
    flag.store(false)
    check(!flag.exchange(true, MemoryOrder.AcqRel))
    check(flag.fetchAnd(false, MemoryOrder.AcqRel))
    check(!flag.fetchOr(true, MemoryOrder.AcqRel))
    check(flag.fetchXor(false, MemoryOrder.AcqRel))
    ref.store(first)
    check(ref.exchange(second, MemoryOrder.AcqRel) === first)
    cell.store(0)
    check(cell.exchange(1, MemoryOrder.SeqCst) == 0)
    check(cell.fetchAdd(2, MemoryOrder.SeqCst) == 1)
    check(cell.fetchSub(1, MemoryOrder.SeqCst) == 3)
    check(cell.fetchAnd(3, MemoryOrder.SeqCst) == 2)
    check(cell.fetchOr(4, MemoryOrder.SeqCst) == 2)
    check(cell.fetchXor(7, MemoryOrder.SeqCst) == 6)
    flag.store(false)
    check(!flag.exchange(true, MemoryOrder.SeqCst))
    check(flag.fetchAnd(false, MemoryOrder.SeqCst))
    check(!flag.fetchOr(true, MemoryOrder.SeqCst))
    check(flag.fetchXor(false, MemoryOrder.SeqCst))
    ref.store(first)
    check(ref.exchange(second, MemoryOrder.SeqCst) === first)
    val wide = AtomicLong(0L)
    wide.store(3L, MemoryOrder.Relaxed)
    check(wide.load(MemoryOrder.Relaxed) == 3L)
    flag.store(true, MemoryOrder.Relaxed)
    check(flag.load(MemoryOrder.Relaxed))
    ref.store(first, MemoryOrder.Relaxed)
    check(ref.load(MemoryOrder.Relaxed) === first)
    wide.store(3L, MemoryOrder.Release)
    check(wide.load(MemoryOrder.Acquire) == 3L)
    flag.store(true, MemoryOrder.Release)
    check(flag.load(MemoryOrder.Acquire))
    ref.store(first, MemoryOrder.Release)
    check(ref.load(MemoryOrder.Acquire) === first)
    wide.store(3L, MemoryOrder.SeqCst)
    check(wide.load(MemoryOrder.SeqCst) == 3L)
    flag.store(true, MemoryOrder.SeqCst)
    check(flag.load(MemoryOrder.SeqCst))
    ref.store(first, MemoryOrder.SeqCst)
    check(ref.load(MemoryOrder.SeqCst) === first)
}
