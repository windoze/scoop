package upstream.references

public fun answer(): Int = 42
public fun <T> identity(value: T): T = value
public fun <T> T.retain(): T = this

public fun <T> declarationOnly(seed: T): T {
    fun neverCalled(): T = seed
    return seed
}

public fun <T> recursiveReference(seed: T, inspect: (T) -> Int): Int {
    fun descend(depth: Int): Box<T> {
        if (depth > 0) {
            val read: () -> T = descend(depth - 1)::read
            return Box<T>(read())
        }
        return Box<T>(seed)
    }
    return inspect(descend(2).read())
}

public fun selfReference(seed: Int): Int {
    fun recur(depth: Int): Int {
        if (depth > 0) {
            val next: (Int) -> Int = ::recur
            return next(depth - 1)
        }
        return seed
    }
    return recur(2)
}

public fun <T> genericSelfReference(seed: T, inspect: (T) -> Int): Int {
    val limit = 0
    fun <U> recur(ignored: U, depth: Int): T {
        if (depth > limit) {
            val next: (U, Int) -> T = ::recur
            return next(ignored, depth - 1)
        }
        return seed
    }
    return inspect(recur<Unit>(Unit, 2)) + inspect(recur<Int>(0, 2)) - inspect(seed)
}

public class Box<T> public constructor(public val value: T) {
    public fun read(): T = value
}

public fun <T, U> captured(seed: T, inspect: (T) -> Int): () -> Int {
    fun <V> value(ignored: V): Int = inspect(seed)
    val first: (Int) -> Int = ::value
    val repeated: (Int) -> Int = ::value
    val alternate: (Unit) -> Int = ::value
    return { first(0) + repeated(0) + alternate(Unit) - 84 }
}

public fun <T, U> fromDefault(
    seed: T,
    marker: U,
    read: () -> T = if (true) {
        fun keep(): T = seed
        val first: () -> T = ::keep
        val repeated: () -> T = ::keep
        first()
        repeated
    } else {
        val fallback: () -> T = { seed }
        fallback
    }
): T = read()

public fun <T> copyDefault(seed: T, copy: (T) -> T = ::identity): T = copy(seed)
public fun <T> memberDefault(owner: Box<T>, read: () -> T = owner::read): T = read()
