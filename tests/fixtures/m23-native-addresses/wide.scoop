package consumer.nativeAddresses

import dependency.nativeAddresses.Wide
import dependency.nativeAddresses.roundWide

@Extern(name = "m23_call_wide")
private fun nativeWide(callback: FunPtr<(Wide) -> Wide>): Long

public fun callWide(callback: FunPtr<(Wide) -> Wide>): Long {
    @Unsafe { return nativeWide(callback) }
}

public fun <T> exercise(value: T): Long {
    val callback: FunPtr<(Wide) -> Wide> = ::roundWide
    @Unsafe { return callWide(callback) }
}
public fun result(): Long = exercise<Int>(0)
