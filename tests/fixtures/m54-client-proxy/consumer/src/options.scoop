import scoop.http.*
import scoop.http.client.*
import scoop.time.Duration
import scoop.url.Url

private fun proxyInvalid(block: () -> Unit) {
    try { block() }
    catch (_: IllegalArgumentException) { return }
    throw IllegalStateException(Some("expected invalid proxy configuration"))
}

internal fun proxyOptions() {
    for (text in ["http://localhost", "https://localhost/", "http://[::1]:8080"])
        proxyCheck(HttpProxyEndpoint(Url.parse(text)).url == Url.parse(text))
    proxyCheck(HttpSocks5Endpoint(Url.parse("socks5://bücher.example.")).url.scheme == Some("socks5"))
    for (text in ["ftp://localhost", "http://user@localhost", "http://localhost/path", "http://localhost?", "http://localhost#", "http://localhost:0"])
        proxyInvalid { HttpProxyEndpoint(Url.parse(text)) }
    for (text in ["http://localhost", "socks5://user:password@localhost", "socks5://localhost/path", "socks5://localhost:0"])
        proxyInvalid { HttpSocks5Endpoint(Url.parse(text)) }
    proxyInvalid { HttpTimeoutOptions(proxyHandshake = Some(Duration.seconds(-1L))) }
    proxyCheck(HttpTimeoutOptions().proxyHandshake == Some(Duration.seconds(30L)))
    proxyInvalid { HttpRequest.get(Url.parse("http://localhost"), [proxyCredentials().toProxyAuthorizationField()]) }
}
