import scoop.text.*

fun check(value: Boolean, label: String) { if (!value) { println(label); throw Exception(Some(label)) } }
fun expect(text: String, expected: Double) {
    val value = text.toDouble()
    check(value == expected, text)
    if (value == 0.0) check(1.0 / value == 1.0 / expected, "zero sign: " + text)
}
fun reject(text: String) { check(text.toDoubleOrNull() == None, "overflow: " + text) }
fun main() {
    vectors0()
    vectors1()
    vectors2()
    vectors3()
    vectors4()
    vectors5()
    vectors6()
    println("text float64 passed")
}
