import scoop.text.*
import scoop.collections.listOf

fun check(value: Boolean, label: String) { if (!value) { println(label); throw Exception(Some(label)) } }
fun matches(text: List<Char>, needle: List<Char>, start: Long): Boolean {
    if (needle.size > text.size - start) return false
    var offset = 0L
    while (offset < needle.size) {
        if (text[start + offset] != needle[offset]) return false
        offset += 1L
    }
    return true
}
fun main() {
    val texts = listOf<String>("", "a", "aaaaa", "abababa", "abcabc", "雪😀雪", "A\u0000😀A", "e\u0301é")
    val needles = listOf<String>("", "a", "aa", "aba", "bc", "abcabcx", "雪", "😀", "\u0000", "é", "e\u0301")
    for (text in texts) {
        val chars = text.toCharArray()
        for (needle in needles) {
            val pattern = needle.toCharArray()
            var start = 0L
            while (start <= chars.size) {
                var first = -1L
                var last = -1L
                var index = 0L
                while (index <= chars.size) {
                    if (matches(chars, pattern, index)) {
                        if (index >= start && first < 0L) first = index
                        if (index <= start) last = index
                    }
                    index += 1L
                }
                check(text.indexOf(needle, start) == first && text.lastIndexOf(needle, start) == last, "scalar search model")
                start += 1L
            }
            check(text.startsWith(needle) == matches(chars, pattern, 0L), "prefix")
            check(text.endsWith(needle) == (pattern.size <= chars.size && matches(chars, pattern, chars.size - pattern.size)), "suffix")
            check(text.contains(needle) == (text.indexOf(needle) >= 0L), "contains")
        }
    }
    check("A雪😀".indexOf('😀') == 2L && "😀雪😀".lastIndexOf('😀') == 2L, "Char search")
    check("雪😀".startsWith('雪') && "雪😀".endsWith('😀') && ('😀' in "雪😀"), "Char boundary APIs")
    check("A雪😀".substring(1L) == "雪😀" && "A雪😀".substring(1L, 2L) == "雪", "substring")
    check("雪:😀".substringBefore(':') == "雪" && "雪:😀".substringAfter(":") == "😀", "before after")
    check("x".substringBefore("missing") == "x" && "x".substringAfter('!', "absent") == "absent", "missing delimiter")
    check("雪😀".substringBefore("") == "" && "雪😀".substringAfter("") == "雪😀", "empty delimiter")
    check("雪😀雪".removePrefix("雪") == "😀雪" && "雪😀雪".removeSuffix("雪") == "雪😀", "remove")
    check("x".removePrefix("y") == "x" && "x".removeSuffix("") == "x", "unmatched remove")
    var errors = 0
    try { "x".indexOf("", -1L) } catch (error: IndexOutOfBoundsException) { errors += 1 }
    try { "x".lastIndexOf("", 2L) } catch (error: IndexOutOfBoundsException) { errors += 1 }
    try { "x".substring(1L, 0L) } catch (error: IndexOutOfBoundsException) { errors += 1 }
    check(errors == 3, "invalid indexes")
    val long = "a".repeat(4096L) + "b"
    val repeated = "a".repeat(512L) + "b"
    check(long.indexOf(repeated) == 3584L && long.lastIndexOf(repeated) == 3584L && long.indexOf(repeated, 3585L) == -1L, "repeated prefix adversary")
    println("text search passed")
}
