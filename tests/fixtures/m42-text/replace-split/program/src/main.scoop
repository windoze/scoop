import scoop.text.*
import scoop.collections.*

fun check(value: Boolean, label: String) { if (!value) { println(label); throw Exception(Some(label)) } }
fun main() {
    check("aaaaa".replace("aa", "x") == "xxa" && "aaaaa".replaceFirst("aa", "x") == "xaaa", "non-overlap")
    check("ababa".replace("aba", "x") == "xba" && "abc".replace("missing", "") == "abc", "match restart")
    check("雪😀雪".replace('雪', 'A') == "A😀A" && "雪😀雪".replaceFirst('雪', 'A') == "A😀雪", "Char replacement")
    check("雪😀".replace("", "-") == "-雪-😀-" && "雪😀".replaceFirst("", "-") == "-雪😀", "empty pattern")
    check("".replace("", "😀") == "😀" && "abc".replace("", "") == "abc", "empty input and identity")
    check("a\u0000b".replace("\u0000", "雪") == "a雪b" && "e\u0301".replace("é", "x") == "e\u0301", "literal scalars")
    check(",a,,".split(',').joinToString("|") == "|a||", "empty split fields")
    check("".split("x").size == 1L && "".split("x")[0L] == "", "empty split input")
    check("a--b--c".split("--", 1L).joinToString("|") == "a--b--c", "limit one")
    check("a--b--c".split("--", 2L).joinToString("|") == "a|b--c", "limited suffix")
    check("a--b--".split("--", Long.MAX_VALUE).joinToString("|") == "a|b|", "large limit")
    check("aaaaa".split("aa").joinToString("|") == "||a", "non-overlap split")
    check("😀雪😀".split('😀').joinToString("|") == "|雪|", "multibyte split")
    check(!("a,b".split(',') is MutableList<String>), "split readonly")
    var errors = 0
    try { "x".split("") } catch (error: IllegalArgumentException) { errors += 1 }
    try { "x".split("", 1L) } catch (error: IllegalArgumentException) { errors += 1 }
    try { "x".split(',', -1L) } catch (error: IllegalArgumentException) { errors += 1 }
    check(errors == 3, "split argument errors")
    val repeated = "aa雪".repeat(1024L)
    check(repeated.replace("aa", "😀").length == 2048L && repeated.split("aa").size == 1025L, "many pieces")
    println("text replace-split passed")
}
