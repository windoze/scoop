import scoop.asyncio.*
import scoop.platform.concurrent.Thread
import scoop.platform.io.*
import scoop.platform.memory.NativeByteBuffer
import scoop.platform.net.*
import scoop.platform.system.OsString
import scoop.time.Duration

private fun check(value: Boolean) {
    if (!value) throw IllegalStateException(Some("TCP connection race check failed"))
}

private fun serve(listener: TcpListener) {
    for (_ in 0..<2) {
        listener.accept().use { peer ->
            NativeByteBuffer.allocate(2L).use { bytes ->
                peer.readFully(bytes, 2L)
                val first = bytes.readByte()
                val second = bytes.readByte()
                bytes.clear()
                bytes.writeByte(second)
                bytes.writeByte(first)
                peer.writeFully(bytes)
                peer.shutdownOutput()
                bytes.clear()
                check(peer.readInto(bytes, 1L) == 0L)
            }
        }
    }
}

private fun exercise(ip: IpAddress) {
    TcpListener.bind(SocketAddress(ip, 0)).use { listener ->
        val address = listener.localAddress()
        Thread.start { serve(listener) }.use { server ->
            val loop: EventLoop = LibuvEventLoop()
            loop.run suspend { scope ->
                for (maximum in [1L, 2L]) {
                    val options = TcpConnectOptions(Duration.ZERO, Duration.ZERO, maximum)
                    // System localhost records need not include both address families.
                    loop.connectTcp(OsString.fromString(ip.toString()), address.port, options).useAsync suspend { client ->
                        check(client.peerAddress == address)
                        NativeByteBuffer.allocate(2L).use suspend { bytes ->
                            bytes.writeByte(maximum.toByte())
                            bytes.writeByte(42)
                            client.writeFully(bytes)
                            client.shutdownOutput()
                            bytes.clear()
                            gcCollect()
                            client.readFully(bytes, 2L)
                            check(bytes.readByte() == 42.toByte())
                            check(bytes.readByte() == maximum.toByte())
                            bytes.clear()
                            check(client.readInto(bytes, 1L) == 0L)
                        }
                    }
                    check(!scope.job.isCancelled)
                }
            }
            server.join()
        }
    }
}

fun main() {
    Thread.start { exercise(IpAddress.IPV4_LOOPBACK) }.use { first ->
        Thread.start { exercise(IpAddress.IPV6_LOOPBACK) }.use { second ->
            first.join()
            second.join()
        }
    }
    println("TCP connection races preserve structured stream ownership")
}
