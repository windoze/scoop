import 组合.转发.*
import 组合.转发.`位置 标记` as Label

typealias Words = @Label `跨 库 值`<@Label String>
fun main() {
    val value: @Label Words = boxed("ok")
    gcCollect()
    println(执行(前缀 = "跨 库:") { `保留 值`(`入 参` = value.read()) })
    println(Level.High.toString())
    println(`保留 值`(`入 参` = value.read()))
    val construct: (String) -> Words = ::Words
    val read: (Words) -> String = Words::read
    println(read(construct("reference")))
}
