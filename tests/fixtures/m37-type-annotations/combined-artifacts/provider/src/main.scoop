package 组合.提供

public enum Level : Int { High = 7 }
public annotation class Nested(val level: Level)
@Repeatable
@Target([AnnotationTarget.TYPE, AnnotationTarget.FUNCTION, AnnotationTarget.VALUE_PARAMETER])
public annotation class `位置 标记`(
    val value: Nested = Nested(Level.High),
    val levels: Array<Level> = [Level.High, Level.High]
)
public class `容 器`<T> public constructor(val value: @`位置 标记` T) {
    public fun read() = value
}
public typealias Container<T> = @`位置 标记` `容 器`<@`位置 标记` T>
@`位置 标记` @`位置 标记`(Nested(Level.High), [Level.High])
public fun <T> `保留 值`(@`位置 标记` `入 参`: @`位置 标记` T): @`位置 标记` T = `入 参`
public fun 执行(前缀: String, 操作: () -> String) = 前缀 + 操作()
