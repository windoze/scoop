@Repeatable @Target([AnnotationTarget.TYPE])
annotation class Mark(val n: Int)
typealias Text = @Mark(1) String
fun identity(value: @Mark(2) Text): @Mark(3) Text = value
fun main() {
    val outer: @Mark(4) Int? = Some(42)
    val inner: (@Mark(5) Int)? = Some(21)
    val tuple: @Mark(6) (@Mark(7) Int, @Mark(8) String) = (inner!! * 2, identity("type"))
    println(outer!!)
    println(tuple._1)
    println(tuple._2)
}
