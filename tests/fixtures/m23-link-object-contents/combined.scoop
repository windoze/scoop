import dependency.api.runtimeValue as remote
import dependency.api.imageValue
import dependency.api.imageMutable
import dependency.api.computedValue

// Keep a StorageBridge alongside the scalar DirectC call below.
@Extern(name = "scoop_test_identity", captureErrno = true)
fun nativeIdentity(value: Int): (Int, Int)

@Extern(name = "scoop_test_other")
fun nativeOther(value: Int): Int

fun defaultRead(value: Int = remote): Int = value
public val localDefault: Int = defaultRead()
public val localExplicit: Int = defaultRead(3)
public val localTwice: Int = if (true) { remote } else { remote }
public val localWrite: Int = if (true) { remote = 4; remote } else { remote }
public val localComputed: Int = computedValue
public val localImage: Int = imageValue
public val localImageWrite: Int = if (true) { imageMutable = 6; imageMutable } else { imageMutable }
public fun outside(): Int = remote
public fun unusedDefault(value: Int = remote): Int = value
public fun nativeCalls(value: Int): Int {
    @Unsafe {
        val (result, _) = nativeIdentity(value)
        return result + nativeOther(value)
    }
}
