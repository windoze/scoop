import scoop.bytes.*
import scoop.text.*

fun check(ok: Boolean) { if (!ok) throw IllegalStateException() }
fun golden(bytes: List<Byte>, hex: String) {
    check(bytes.size * 2L == hex.length)
    var index = 0L
    while (index < bytes.size) {
        check(bytes[index].toUInt8() == hex.substring(index * 2L, index * 2L + 2L).toUInt8(16))
        index += 1L
    }
}
fun exercise(order: ByteOrder, expected: String) {
    val builder = ByteArrayBuilder()
    builder.writeInt8(Int8.MIN_VALUE)
    builder.writeUInt8(UInt8.MAX_VALUE)
    builder.writeInt16(Int16.MIN_VALUE, order)
    builder.writeUInt16(UInt16.MAX_VALUE, order)
    builder.writeInt(Int.MIN_VALUE, order)
    builder.writeUInt(UInt.MAX_VALUE, order)
    builder.writeLong(Long.MIN_VALUE, order)
    builder.writeULong(ULong.MAX_VALUE, order)
    golden(builder.toByteArray(), expected)
    val reader = ByteArrayReader(builder.toByteArray())
    check(reader.size == 30L && reader.position == 0L && reader.remaining == 30L)
    check(reader.readInt8() == Int8.MIN_VALUE && reader.readUInt8() == UInt8.MAX_VALUE)
    check(reader.readInt16(order) == Int16.MIN_VALUE && reader.readUInt16(order) == UInt16.MAX_VALUE)
    check(reader.readInt(order) == Int.MIN_VALUE && reader.readUInt(order) == UInt.MAX_VALUE)
    check(reader.readLong(order) == Long.MIN_VALUE && reader.readULong(order) == ULong.MAX_VALUE)
    check(reader.position == 30L && reader.remaining == 0L)
    reader.seek(2L)
    check(reader.readBytes(2L)[0L] == builder.toByteArray()[2L] && reader.position == 4L)
    reader.skip(2L)
    check(reader.readInt(order) == Int.MIN_VALUE)
}
fun main() {
    exercise(ByteOrder.BIG_ENDIAN, "80ff8000ffff80000000ffffffff8000000000000000ffffffffffffffff")
    exercise(ByteOrder.LITTLE_ENDIAN, "80ff0080ffff00000080ffffffff0000000000000080ffffffffffffffff")
    val builder = ByteArrayBuilder()
    builder.writeULong(0x0123456789abcdefuL, ByteOrder.BIG_ENDIAN)
    builder.writeULong(0x0123456789abcdefuL, ByteOrder.LITTLE_ENDIAN)
    golden(builder.toByteArray(), "0123456789abcdefefcdab8967452301")
    builder.clear()
    var index = 0L
    while (index < 512L) { builder.writeLong(index - 256L, ByteOrder.LITTLE_ENDIAN); index += 1L }
    check(builder.size == 4096L)
    val reader = ByteArrayReader(builder.toByteArray())
    index = 0L
    while (index < 512L) { check(reader.readLong(ByteOrder.LITTLE_ENDIAN) == index - 256L); index += 1L }
    println("bytes integers passed")
}
