import scoop.bytes.*

fun check(ok: Boolean) { if (!ok) throw IllegalStateException() }
class Source public constructor(private val builder: ByteArrayBuilder, private val fail: Boolean) : List<Byte> {
    public override val size: Long get() = 3L
    public override operator fun get(index: Long): Byte {
        if (fail && index == 1L) throw IllegalArgumentException(Some("source getter"))
        return builder.toByteArray()[index]
    }
    public override operator fun iterator(): Iterator<Byte> = builder.toByteArray().iterator()
}
class Huge : List<Byte> {
    public override val size: Long get() = Long.MAX_VALUE
    public override operator fun get(index: Long): Byte { throw IllegalStateException() }
    public override operator fun iterator(): Iterator<Byte> { throw IllegalStateException() }
}
fun main() {
    val builder = ByteArrayBuilder()
    builder.append(1.toInt8()); builder.append(2.toInt8()); builder.append(3.toInt8())
    val first = builder.toByteArray()
    val mutable = builder.toMutableByteArray()
    mutable[0L] = 99.toInt8()
    check(builder.toByteArray()[0L] == 1.toInt8() && first[0L] == 1.toInt8())
    builder.append(Source(builder, false))
    check(builder.size == 6L && builder.toByteArray()[3L] == 1.toInt8() && first.size == 3L)
    var failed = false
    try { builder.append(Source(builder, true)) } catch (error: IllegalArgumentException) { failed = true }
    check(failed && builder.size == 6L && builder.toByteArray()[5L] == 3.toInt8())
    val reader = ByteArrayReader(mutable)
    mutable[0L] = 0.toInt8()
    check(reader.readInt8() == 99.toInt8())
    val slice = reader.readBytes(2L)
    reader.seek(0L)
    builder.clear()
    check(builder.size == 0L && first.size == 3L && first[2L] == 3.toInt8() && slice[0L] == 2.toInt8())
    builder.append(first)
    builder.append(Array<Byte>(0L) { _ -> 0.toInt8() })
    check(builder.size == 3L && reader.readInt8() == 99.toInt8())
    var constructorFailed = false
    try { ByteArrayReader(Source(builder, true)) } catch (error: IllegalArgumentException) { constructorFailed = true }
    check(constructorFailed)
    var overflow = false
    try { builder.append(Huge()) } catch (error: ArithmeticException) { overflow = true }
    check(overflow && builder.size == 3L)
    println("bytes snapshots passed")
}
