import scoop.asyncio.*
import scoop.crypto.x509.TrustStore
import scoop.http.client.*
import scoop.time.Duration
import scoop.tls.TlsTrustSource
import scoop.url.Url

internal fun digestRouting(mode: String, url: Url, trust: TrustStore) {
    val loop: EventLoop = LibuvEventLoop()
    loop.run suspend { _ ->
        val calls = AtomicLong(0L)
        val algorithms = MutableArray<HttpDigestAlgorithm>(1L) { HttpDigestAlgorithm.Sha256 }
        val provider = HttpAuthenticator.digest(url.httpOrigin(), algorithms = algorithms,
            sendWithoutChallenge = mode != "no-preempt") suspend { _ ->
            calls.fetchAdd(1L)
            digestCheck(digestContext() == "route")
            HttpPasswordCredentials("Mufasa", "Circle of Life")
        }
        algorithms[0L] = HttpDigestAlgorithm.Md5
        withHttpClient(HttpClientConfig(tls = HttpClientTlsConfig(TlsTrustSource.Store(trust)),
            authentication = HttpAuthenticationOptions([provider]), retries = HttpRetryOptions(maxRetries = 1L,
                statuses = [503U], initialDelay = Duration.ZERO, maxDelay = Duration.ZERO))) suspend { client ->
            context(DigestContext("route")) {
                val request = if (mode == "routing" || mode == "domain") HttpRequest.post(url, RequestBody.Empty) else HttpRequest.get(url)
                client.withResponse(request) suspend { response ->
                    digestCheck(response.body.text(4L) == "done")
                    digestCheck(response.authenticationCount == 1L)
                    digestCheck(response.retryCount == if (mode == "retry") 1L else 0L)
                    digestCheck(response.redirectHistory.size == if (mode == "routing" || mode == "domain") 3L else 0L)
                }
                if (mode == "no-preempt") client.withResponse(HttpRequest.get(url)) suspend { response ->
                    digestCheck(response.authenticationCount == 1L && response.body.text(4L) == "done")
                }
                digestCheck(calls.load() == if (mode == "no-preempt") 2L else 1L)
            }
        }
    }
}
