import scoop.asyncio.*
import scoop.http.client.*
import scoop.time.Duration
import scoop.url.Url

internal suspend fun networkClear(client: HttpClient, port: String) {
    val zero = Some(Duration.ZERO)
    val dns = Url.parse("http://localhost:" + port + "/dns")
    val ip = Url.parse("http://127.0.0.1:" + port + "/ip")
    val resolve = networkFailure suspend {
        client.execute(HttpRequest.get(dns, options = HttpCallOptions(timeouts = Some(HttpTimeoutOptions(resolve = zero))))); Unit
    }
    networkPhase(resolve, HttpTimeoutPhase.Resolve, Duration.ZERO)
    val cause = resolve.cause!!
    networkCheck(cause is TcpConnectException)
    if (cause is TcpConnectException) {
        networkCheck(cause.attempts.size == 0L && cause.resolutionFailures.size == 2L)
        for (failure in cause.resolutionFailures) networkCheck(failure.cause is TcpResolutionTimeoutException)
    }
    for (url in [dns, ip]) {
        val connect = networkFailure suspend {
            client.execute(HttpRequest.get(url, options = HttpCallOptions(timeouts = Some(HttpTimeoutOptions(connect = zero))))); Unit
        }
        networkPhase(connect, HttpTimeoutPhase.Connect, Duration.ZERO)
        if (url === dns) networkCheck(connect.cause!! is TcpConnectTimeoutException)
        else when (connect.cause) { case Some(_) -> throw IllegalStateException(); case None -> {} }
        client.withResponse(HttpRequest.get(url)) suspend { response -> networkCheck(response.body.text(2L) == "ok") }
        val allZero = HttpTimeoutOptions(resolve = zero, connect = zero, tlsHandshake = zero)
        client.withResponse(HttpRequest.get(url, options = HttpCallOptions(timeouts = Some(allZero)))) suspend { response ->
            networkCheck(response.body.text(2L) == "ok")
        }
    }
}

internal suspend fun networkTlsFailure(client: HttpClient, port: String, mode: String) {
    val limit = if (mode == "zero-tls") Duration.ZERO else Duration.seconds(15L)
    val options = HttpTimeoutOptions(total = if (mode == "total") Some(limit) else None,
        tlsHandshake = Some(if (mode == "total") Duration.seconds(3600L) else limit))
    val started = AtomicBoolean(false)
    val body = RequestBody.fromProducer(Some(4L)) suspend { _ ->
        started.store(true)
        throw IllegalStateException(Some("a failed handshake started the request body"))
    }
    val error = networkFailure suspend {
        client.execute(HttpRequest.post(Url.parse("https://127.0.0.1:" + port + "/"), body,
            options = HttpCallOptions(timeouts = Some(options)))); Unit
    }
    networkPhase(error, if (mode == "total") HttpTimeoutPhase.Total else HttpTimeoutPhase.TlsHandshake, limit)
    networkCheck(!started.load())
}
