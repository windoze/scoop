enum Nested {
    Item((Int, Boolean)),
    Empty
}

enum BooleanBox {
    Value(Boolean)
}

struct Flags(val first: Boolean, val second: Boolean)

enum Structured {
    Value(Flags, Unit)
}

enum Never {}

fun impossible(value: Never): Int = when (value) {}

fun optionValue(value: Int?): Int = when (value) {
    Some(number) -> number
    None -> -1
}

fun nestedValue(value: Nested): Int = when (value) {
    Item((number, flag)) if (flag) -> number
    Item((number, _)) -> number + 100
    Empty -> -1
}

fun booleanValue(value: BooleanBox): Int = when (value) {
    Value(false) -> 0
    Value(true) -> 1
}

fun pairValue(value: (Boolean, Boolean)): Int = when (value) {
    (false, _) -> 10
    (true, false) -> 20
    (true, true) -> 30
}

fun structuredValue(value: Structured): Int = when (value) {
    Value(Flags(false, _), ()) -> 40
    Value(Flags(true, _), Unit) -> 50
}

fun explicitEmpty(value: BooleanBox) {
    when (value) {
        Value(_) -> {}
        else -> {}
    }
}

fun explicitFallback(value: Int?): Int = when (value) {
    Some(0) -> 0
    None -> 1
    else -> 2
}

fun main() {
    println(optionValue(Some(7)))
    println(optionValue(None))
    println(nestedValue(Nested.Item((7, true))))
    println(nestedValue(Nested.Item((7, false))))
    println(nestedValue(Nested.Empty))
    println(booleanValue(BooleanBox.Value(false)))
    println(booleanValue(BooleanBox.Value(true)))
    println(pairValue((false, true)))
    println(pairValue((true, false)))
    println(pairValue((true, true)))
    println(structuredValue(Structured.Value(Flags(false, true), Unit)))
    println(structuredValue(Structured.Value(Flags(true, false), ())))
    explicitEmpty(BooleanBox.Value(false))
    println(explicitFallback(Some(1)))
}
