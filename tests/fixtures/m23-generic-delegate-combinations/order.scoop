package consumer.delegates

import templates.delegateCombinations.*

private fun <T> receiver(value: T): Receiver<T> {
    Trace.order = Trace.order * 10 + 1
    return Receiver<T>(value)
}
private fun rhs(value: Int): Int {
    Trace.order = Trace.order * 10 + 2
    val allocated = Payload(value)
    return allocated.value
}

public fun <T> exercise(value: T): Int {
    Trace.order = 0
    receiver<T>(value).ordered = rhs(42)
    if (Trace.order != 12345) { return 1 }
    Trace.order = 0
    receiver<T>(value).compound += rhs(2)
    if (Trace.order != 134625) { return 2 }
    Trace.order = 0
    val previous = receiver<T>(value).compound++
    if (Trace.order != 165 || previous != 12) { return 3 }
    Trace.order = 0
    val current = ++receiver<T>(value).compound
    if (Trace.order != 165 || current != 14) { return 4 }
    Trace.order = 0
    val read = receiver<T>(value).ordered
    if (Trace.order != 16 || read != 42) { return 5 }
    return read
}

public fun result(): Int = exercise<Int>(1)
