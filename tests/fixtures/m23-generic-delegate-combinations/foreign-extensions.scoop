package consumer.delegates

import templates.delegateCombinations.Receiver
import templates.delegateCombinations.Trace
import templates.delegateCombinations.Payload
import templates.delegateCombinations.ExtensionSeed
import templates.delegateCombinations.provideDelegate as prepare
import templates.delegateCombinations.getValue as read
import templates.delegateCombinations.setValue as write

private var <T> Receiver<T>.foreign: Int by ExtensionSeed()

public fun <T> exercise(value: T): Int {
    Trace.order = 0
    Receiver<T>(value).foreign = 42
    if (Trace.order != 45) { return 1 }
    Payload(0)
    val answer = Receiver<T>(value).foreign
    return if (Trace.order == 456) { answer } else { 2 }
}
public fun result(): Int = exercise<Int>(1)
