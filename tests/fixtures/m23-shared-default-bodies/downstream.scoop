import consumer.defaults.result
import consumer.defaults.exercise

private class Later(public val value: Int)
private struct Wide(val text: String, val value: Int, val extra: Long)

public fun check(): Int {
    if (result() != 42) { return 1 }
    val value = Later(42)
    if (exercise<Later>(value, { item -> item.value }) != 42) { return 2 }
    if (exercise<Int>(42, { item -> item }) != 42) { return 3 }
    if (exercise<Unit>(Unit, { item -> 42 }) != 42) { return 4 }
    if (exercise<Wide>(Wide("retained", 42, 0L), { item -> item.value }) != 42) { return 5 }
    return value.value
}
