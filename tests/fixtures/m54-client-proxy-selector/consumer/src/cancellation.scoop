import scoop.asyncio.*
import scoop.crypto.x509.TrustStore
import scoop.http.client.*
import scoop.time.Duration

internal fun selectorCancellation(trust: TrustStore, mode: String, cleanup: String) {
    withSelectorRuntime suspend { loop, scope, listener ->
        val entered = SelectorGate()
        val cancelled = SelectorGate()
        val cleaning = SelectorGate()
        val finish = SelectorGate()
        val closed = AtomicBoolean(false)
        val connected = AtomicBoolean(false)
        val cleanupFailure = Throwable()
        val selections = AtomicLong(0L)
        val route = selectorRoute(listener)
        val selector = HttpProxySelector(suspend { _ ->
            selectorCheck(selectorContext() == "caller")
            selections.fetchAdd(1L)
            val registration = currentJobOrNone()!!.invokeOnCancellation { _ -> cancelled.signal() }
            try {
                entered.signal(); loop.sleep(Duration.seconds(3600L)); route
            } finally {
                selectorCheck(selectorContext() == "caller")
                cleaning.signal(); finish.await()
                closed.store(true); registration.dispose()
                if (cleanup == "wrapped") throw ResourceUseException(CancellationException(), cleanupFailure)
                else if (cleanup == "plain") throw cleanupFailure
                else Unit
            }
        })
        val observing = scope.launch suspend {
            try { listener.accept().useAsync suspend { _ -> connected.store(true) } }
            catch (error: CancellationException) { selectorCheck(!connected.load()) }
        }
        val client = context(SelectorContext("owner")) {
            HttpClient.open(scope, selectorConfig(trust, selector, mode == "total"))
        }
        val failure = SelectorFailure()
        val closeFailure = SelectorFailure()
        val executing = context(SelectorContext("caller")) {
            scope.launch suspend {
                try { selectorDone(client) } catch (error: Throwable) { failure.value = Some(error) }
            }
        }
        entered.await()
        val closing = if (mode == "client") Some(scope.launch suspend {
            try { client.close() } catch (error: Throwable) { closeFailure.value = Some(error) }
        }) else None
        if (mode == "caller") executing.cancel()
        try {
            cancelled.await(); cleaning.await()
            selectorCheck(!executing.isCompleted && !closed.load() && !connected.load())
            if (selectorPresent(closing)) selectorCheck(!closing!!.isCompleted)
            finish.signal(); executing.join(); closing?.join()
            selectorCheck(closed.load() && selections.load() == 1L && !connected.load())
            val error = failure.value!!
            if (cleanup == "none") selectorCheck(!(error is ResourceUseException))
            else {
                selectorCheck(error is ResourceUseException, "selector cleanup failure was discarded")
                if (error is ResourceUseException) selectorCheck(error.cleanupFailure === cleanupFailure)
            }
            val primary = if (error is ResourceUseException) error.primaryFailure else error
            when (mode) {
                case "caller" -> selectorCheck(primary is CancellationException)
                case "client" -> selectorCheck(primary is HttpClientClosedException)
                else -> {
                    selectorCheck(primary is HttpTimeoutException)
                    if (primary is HttpTimeoutException) selectorCheck(primary.phase == HttpTimeoutPhase.Total)
                }
            }
            if (mode == "client" && cleanup != "none") selectorCheck(closeFailure.value!! === cleanupFailure)
            else selectorCheck(!selectorPresent(closeFailure.value))
        } finally {
            finish.signal(); observing.cancel(); observing.join(); client.close()
        }
    }
}
