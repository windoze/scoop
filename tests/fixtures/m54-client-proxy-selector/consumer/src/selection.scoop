import scoop.asyncio.*
import scoop.crypto.x509.TrustStore
import scoop.http.client.*
import scoop.platform.system.PlatformErrorKind
import scoop.platform.system.PlatformException
import scoop.time.Duration

internal fun selectorSuspension(trust: TrustStore) {
    withSelectorRuntime suspend { loop, scope, listener ->
        val entered = SelectorGate()
        val release = SelectorGate()
        val selections = AtomicLong(0L)
        val connected = AtomicBoolean(false)
        val route = selectorRoute(listener)
        val selector = HttpProxySelector(suspend { request ->
            selectorCheck(selectorContext() == "caller" && request.url == selectorTarget())
            selectorCheck(selectorPresent(currentJobOrNone()))
            selections.fetchAdd(1L); entered.signal(); release.await()
            selectorCheck(selectorContext() == "caller")
            route
        })
        val serving = selectorServe(scope, listener, connected)
        val client = context(SelectorContext("owner")) { HttpClient.open(scope, selectorConfig(trust, selector)) }
        val failure = SelectorFailure()
        val executing = context(SelectorContext("caller")) {
            scope.launch suspend {
                try { selectorDone(client) } catch (error: Throwable) { failure.value = Some(error) }
            }
        }
        try {
            entered.await(); loop.sleep(Duration.milliseconds(5L))
            selectorCheck(!executing.isCompleted && !connected.load(), "connection started while selector was suspended")
            release.signal(); executing.join(); serving.join()
            if (selectorPresent(failure.value)) throw failure.value!!
            selectorCheck(selections.load() == 1L && connected.load())
        } finally { release.signal(); client.close() }
    }
}

internal fun selectorCallbackFailure(trust: TrustStore, nested: Boolean) {
    withSelectorRuntime suspend { loop, scope, listener ->
        val original = PlatformException("proxy selection callback", PlatformErrorKind.ConnectionReset)
        val selections = AtomicLong(0L)
        val connected = AtomicBoolean(false)
        val selector = HttpProxySelector(suspend { _ ->
            selectorCheck(selectorContext() == "caller")
            selections.fetchAdd(1L)
            loop.sleep(Duration.milliseconds(5L))
            if (nested) coroutineScope<Unit> suspend { child ->
                child.launch suspend {
                    selectorCheck(selectorContext() == "caller")
                    loop.sleep(Duration.milliseconds(5L)); throw original
                }
                Unit
            }
            throw original
        })
        val serving = selectorServe(scope, listener, connected)
        withHttpClient(selectorConfig(trust, selector)) suspend { client ->
            val failure = SelectorFailure()
            context(SelectorContext("caller")) {
                try { selectorDone(client) } catch (error: Throwable) { failure.value = Some(error) }
            }
            selectorCheck(failure.value!! === original && selections.load() == 1L && !connected.load())
            selectorDone(client, HttpCallOptions(proxy = Some(HttpProxySelector.fixed(selectorRoute(listener)))))
            selectorCheck(selections.load() == 1L && !scope.job.isCancelled)
        }
        serving.join()
    }
}
