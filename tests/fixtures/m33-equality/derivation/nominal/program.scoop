struct Point(val x: Int, val y: Int)
struct Declared(val value: Int) : Equality<Declared> {
    public override fun equalTo(other: Declared): Boolean = this.equals(other)
}
struct Empty()
struct Record(val label: String, val point: Point)
struct Floating(val single: Float, val double: Double)
enum Choice { Empty, Value(Record), Number(Long) }
class Opaque(val value: Int)
struct Incomparable(val value: Opaque)

fun check(value: Boolean) {
    if (!value) { throw IllegalStateException() }
}

fun main() {
    val point = Point(1, 2)
    check(point == Point(1, 2))
    check(point != Point(2, 1))
    check(point.equals(Point(1, 2)))
    check(!point.equals(Point(2, 1)))
    val pointBox: Any = point
    check(!(pointBox is Equality<Point>))
    check(Declared(7) == Declared(7))
    check(Declared(7) != Declared(8))
    val declared: Equality<Declared> = Declared(7)
    check(declared.equalTo(Declared(7)))
    check(!declared.equalTo(Declared(8)))
    check(Empty() == Empty())
    val record = Record("value", point)
    check(record == Record("value", Point(1, 2)))
    check(record != Record("other", point))
    check(Choice.Empty == Choice.Empty)
    check(Choice.Value(record) == Choice.Value(Record("value", point)))
    check(Choice.Value(record) != Choice.Number(3L))
    check(Choice.Number(3L) != Choice.Number(4L))
    check(Choice.Empty.equals(Choice.Empty))
    check(Floating(Float.NaN, 1.0) != Floating(Float.NaN, 1.0))
    check(Floating(1f, Double.NaN) != Floating(1f, Double.NaN))
    check(Floating(0f, -0.0) == Floating(-0f, 0.0))
    val opaque: Any = Incomparable(Opaque(3))
    check(!(opaque is Equality<Incomparable>))
    println("derived nominal equality")
}
