import derived.*

fun check(value: Boolean) {
    if (!value) { throw IllegalStateException() }
}

fun <T : Equality<T>> verify(left: T, right: T, expected: Boolean) {
    check(compare(left, right) == expected)
    val view: Equality<T> = left
    check(view.equals(right) == expected)
    val boxed: Any = left
    check(boxed is Equality<T>)
    check((boxed as Equality<T>).equals(right) == expected)
}

fun main() {
    val point = Point(1, 2)
    verify(point, Point(1, 2), true)
    verify(point, Point(1, 3), false)
    check(point.equals(Point(1, 2)))
    check(point == Point(1, 2))
    check(pointView(point).equals(point))
    verify(Secret(3), Secret(3), true)
    verify(Secret(3), Secret(4), false)
    val record = Record(Secret(3), "stored")
    verify(record, Record(Secret(3), "stored"), true)
    verify(record, Record(Secret(3), "changed"), false)
    val boxed = boxedRecord(record)
    check(boxed is Equality<Record>)
    check((boxed as Equality<Record>).equals(record))
    verify(Choice.Empty, Choice.Empty, true)
    verify(Choice.Value(record), Choice.Value(record), true)
    verify(Choice.Value(record), Choice.Number(3L), false)
    verify(Declared(9), Declared(9), true)
    verify(Declared(9), Declared(8), false)
    verify(Multiple(7), Multiple(7), true)
    val multiple = Multiple(7)
    check(multiple.equals(7))
    check(multiple.equals(Multiple(7)))
    val opaque: Any = Incomparable(Opaque(1))
    check(!(opaque is Equality<Incomparable>))
    println("derived equality artifacts")
}
