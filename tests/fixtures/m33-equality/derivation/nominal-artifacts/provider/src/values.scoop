package derived

public struct Point(val x: Int, val y: Int)
public class Secret public constructor(private val key: Int) : Equality<Secret> {
    public override operator fun equals(other: Secret): Boolean = key == other.key
}
public struct Record(val secret: Secret, val label: String)
public struct Declared(val value: Int) : Equality<Declared>
public enum Choice { Empty, Value(Record), Number(Long) }
public class Opaque public constructor(val key: Int)
public struct Incomparable(val value: Opaque)

public struct Multiple(val value: Int) : Equality<Int> {
    public override operator fun equals(other: Int): Boolean = value == other
}

public fun <T : Equality<T>> compare(left: T, right: T): Boolean = left == right

public fun pointView(point: Point): Equality<Point> = point
public fun boxedRecord(record: Record): Any = record
