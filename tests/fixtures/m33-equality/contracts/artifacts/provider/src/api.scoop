package equality.api

public interface Match<T> : Equality<T> {}

public struct Key<T>(val payload: T, val number: Int) : Match<Key<T>>, Hash {
    public operator fun equals(other: Key<T>): Boolean = number == other.number
    public override fun equalTo(other: Key<T>): Boolean = this.equals(other)
    public override fun hash(): Long = number.toInt64()
}

public class Number public constructor(public val value: Int) {
    public operator fun equals(other: Int): Boolean = value == other
}

public interface Operator<T> {
    public operator fun equals(other: T): Boolean
}

public class Split public constructor() : Operator<Split>, Equality<Split> {
    public override operator fun equals(other: Split): Boolean = false
    public override fun equalTo(other: Split): Boolean = true
}

public fun <T : Operator<T>> operatorSame(left: T, right: T): Boolean = left == right
public fun <T : Equality<T>> same(left: T, right: T): Boolean = left.equalTo(right)
public fun <T> through(view: Equality<T>, other: T): Boolean = view.equalTo(other)

public fun <T> sameKey(left: T, right: T): Boolean where T : Equality<T>, T : Hash =
    left.hash() == right.hash() && left.equalTo(right)
