import equality.api.Key
import equality.api.Match
import equality.api.Number
import equality.api.Split
import equality.api.operatorSame
import equality.api.same
import equality.api.sameKey
import equality.api.through

struct Local(val value: Int) : Match<Local> {
    @NoGC
    public operator fun equals(other: Local): Boolean = value == other.value
    @NoGC
    public override fun equalTo(other: Local): Boolean = this.equals(other)
}

fun check(value: Boolean) {
    if (!value) { throw IllegalStateException() }
}

fun main() {
    check(same(42, 42))
    check(!same(42, 43))
    check(same("跨库", "跨库"))
    check(same(0f, -0f))
    check(!same(Float.NaN, Float.NaN))
    check(same(Key("left", 7), Key("right", 7)))
    check(sameKey(Key(1, 7), Key(2, 7)))
    check(through(42, 42))
    check(through(Key(1, 7), Key(2, 7)))
    check(Number(42) == 42)
    check(same(Local(42), Local(42)))
    val view: Match<Local> = Local(42)
    check(view.equalTo(Local(42)))
    val boxed: Any = Local(42)
    check(boxed is Equality<Local>)
    check((boxed as Equality<Local>).equalTo(Local(42)))
    val key: Any = Key("payload", 7)
    check(key is Equality<Key<String>>)
    check((key as Equality<Key<String>>).equalTo(Key("other", 7)))
    val split = Split()
    check(!operatorSame(split, split))
    check(split != split)
    check(same(split, split))
    check(through(split, split))
    println("artifact equality contracts")
}
