interface Same<T> : Equals<T> {}

struct Key(val value: Int) : Same<Key>, Hash {
    @NoGC
    public override operator fun equals(other: Key): Boolean = value == other.value
    public override fun hash(): Long = value.toInt64()
}

class Trace(var visits: Int)

class Ordered(val value: Int, val trace: Trace) {
    public operator fun equals(other: Ordered): Boolean {
        trace.visits = trace.visits * 10 + 3
        return value == other.value
    }
    public operator fun equals(other: Int): Boolean = value == other
}

class Explicit() : Equals<Explicit> {
    public override operator fun equals(other: Explicit): Boolean = true
}

class Split() : Equals<Split> {
    public override operator fun equals(other: Split): Boolean = false
}

fun make(trace: Trace, digit: Int): Ordered {
    trace.visits = trace.visits * 10 + digit
    return Ordered(7, trace)
}

fun check(value: Boolean) {
    if (!value) { throw IllegalStateException() }
}

fun <T : Equals<T>> same(left: T, right: T): Boolean = left.equals(right)

fun <T> keyMatch(left: T, right: T): Boolean where T : Equals<T>, T : Hash =
    left.hash() == right.hash() && left.equals(right)

fun <T : Equals<T>> verify(value: T) {
    check(same(value, value))
    val view: Equals<T> = value
    check(view.equals(value))
    val boxed: Any = value
    check(boxed is Equals<T>)
    check((boxed as Equals<T>).equals(value))
}

@NoGC
fun direct(integer: Int, character: Char, floating: Float, key: Key): Boolean =
    integer == 42 && character == 'x' && floating == 1f && key == Key(42)

fun main() {
    val i8: Int8 = -8
    val i16: Int16 = -16
    val u8: UInt8 = 8u
    val u16: UInt16 = 16u
    verify(i8)
    verify(i16)
    verify(42)
    verify(42L)
    verify(u8)
    verify(u16)
    verify(42u)
    verify(42uL)
    verify(true)
    verify('x')
    verify("Equals")
    verify(1f)
    verify(1.0)
    verify(Unit)
    verify(Key(42))
    verify(Explicit())
    val split = Split()
    check(!same(split, split))
    check(split != split)
    check(!split.equals(split))
    check(direct(42, 'x', 1f, Key(42)))
    check(keyMatch(Key(42), Key(42)))
    check(!keyMatch(Key(42), Key(41)))
    check(!same(Float.NaN, Float.NaN))
    check(!same(Double.NaN, Double.NaN))
    check(same(0f, -0f))
    check(same(0.0, -0.0))
    val nan: Equals<Float> = Float.NaN
    check(!nan.equals(Float.NaN))
    val trace = Trace(0)
    check(make(trace, 1) == make(trace, 2))
    check(trace.visits == 123)
    trace.visits = 0
    check(!(make(trace, 1) != make(trace, 2)))
    check(trace.visits == 123)
    check(Ordered(7, trace) == 7)
    println("equality contracts")
}
