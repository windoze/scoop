import scoop.text.*

fun check(ok: Boolean) { if (!ok) throw IllegalStateException() }
fun vector(text: String, encoded: String) {
    val bytes = text.toByteArray()
    check(bytes.toHexString() == encoded && bytes.toHexString(true) == encoded.uppercaseAscii())
    val decoded = encoded.uppercaseAscii().hexToByteArray()
    check(decoded.size == bytes.size)
    var index = 0L
    while (index < bytes.size) { check(decoded[index] == bytes[index]); index += 1L }
}
fun invalid(text: String, position: Long) {
    val missing = when (text.hexToByteArrayOrNull()) { case None -> true; case Some(_) -> false }
    check(missing)
    var failed = false
    try { text.hexToByteArray() } catch (error: IllegalArgumentException) {
        check(error.message == Some("invalid hex at index " + position.toString()))
        failed = true
    }
    check(failed)
}
fun main() {
    vector("", ""); vector("f", "66"); vector("fo", "666f"); vector("foo", "666f6f")
    vector("foob", "666f6f62"); vector("fooba", "666f6f6261"); vector("foobar", "666f6f626172")
    vector("雪\u{0}", "e99baa00")
    val all = MutableArray<Byte>(256L) { index -> index.toByte() }
    val encoded = all.toHexString()
    val decoded = encoded.hexToByteArray()
    check(encoded.length == 512L && encoded.startsWith("00010203") && encoded.endsWith("fcfdfeff"))
    var index = 0L
    while (index < 256L) {
        check(decoded[index] == all[index] && encoded.substring(index * 2L, index * 2L + 2L).toInt(16) == index.toInt())
        index += 1L
    }
    all[0L] = 99.toByte()
    check(decoded[0L] == 0.toByte() && encoded.startsWith("00"))
    invalid("0", 1L); invalid("123", 3L); invalid("G0", 0L); invalid("0g", 1L)
    invalid("0x00", 1L); invalid("00 00", 2L); invalid("00_00", 2L); invalid("00\n", 2L)
    invalid("ＦＦ", 0L); invalid("00雪0", 2L); invalid("0😀", 1L); invalid("00\u{0}", 2L)
    check("aAbB00fF".hexToByteArray().toHexString() == "aabb00ff")
    println("encoding hex passed")
}
