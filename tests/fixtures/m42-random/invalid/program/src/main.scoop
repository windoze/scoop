import scoop.random.*

fun check(ok: Boolean) { if (!ok) throw IllegalStateException() }
class Counter : Random {
    public var calls: Long = 0L
    public override fun nextBits(bitCount: Int): Int { calls += 1L; return 0 }
}
class Failing : Random {
    public var calls: Long = 0L
    public override fun nextBits(bitCount: Int): Int {
        if (calls == 2L) throw IllegalStateException(Some("random failure"))
        calls += 1L
        return calls.toInt()
    }
}
fun invalid(random: Counter, action: () -> Unit, bounds: Boolean = false) {
    var failed = false
    try { action() }
    catch (error: IllegalArgumentException) { check(!bounds); failed = true }
    catch (error: IndexOutOfBoundsException) { check(bounds); failed = true }
    check(failed && random.calls == 0L)
}
fun main() {
    val random = Counter()
    invalid(random, { random.nextInt(0) }); invalid(random, { random.nextInt(1, 1) })
    invalid(random, { random.nextInt(Int.MAX_VALUE, Int.MIN_VALUE) })
    invalid(random, { random.nextLong(-1L) }); invalid(random, { random.nextLong(2L, 1L) })
    invalid(random, { random.nextUInt(0u) }); invalid(random, { random.nextUInt(UInt.MAX_VALUE, 0u) })
    invalid(random, { random.nextULong(0uL) }); invalid(random, { random.nextULong(9uL, 9uL) })
    invalid(random, { random.nextBytes(-1L) })
    val array = MutableArray<Byte>(4L) { _ -> 9.toByte() }
    invalid(random, { random.nextBytes(array, -1L, 2L) }, true)
    invalid(random, { random.nextBytes(array, 0L, 5L) }, true)
    invalid(random, { random.nextBytes(array, 3L, 2L) })
    invalid(random, { random.nextBytes(array, 0L, Long.MAX_VALUE) }, true)
    check(random.nextBytes(0L).size == 0L)
    random.nextBytes(array, 4L, 4L)
    check(random.calls == 0L)
    val failing = Failing()
    var failed = false
    try { failing.nextBytes(array) } catch (error: IllegalStateException) { failed = true }
    check(failed && failing.calls == 2L && array[0L] == 1.toByte() && array[1L] == 2.toByte() && array[2L] == 9.toByte())
    println("random invalid passed")
}
