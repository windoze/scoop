import dependency.api.configure
import dependency.api.callCount

fun verifyCalls(value: Boolean) { if (!value) { throw IllegalStateException() } }


fun main() {
    configure(false)
    verifyCalls(!repeated())
    verifyCalls(callCount() == 3)
    configure(true)
    verifyCalls(repeated())
    verifyCalls(callCount() == 3)
}
