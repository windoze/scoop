package api
public import models.*
public import Serialize as Wire

public fun <T> encoder(element: ValueEncoder<T>): ValueEncoder<Box<T>> = BoxEncoder<T>(element)
public fun <T> decoder(element: ValueDecoder<T>): ValueDecoder<Box<T>> = BoxDecoder<T>(element)
public object Concrete : ValueEncoder<Box<String?>>, ValueDecoder<Box<String?>>
