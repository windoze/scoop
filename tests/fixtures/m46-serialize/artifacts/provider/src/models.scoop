package models

public struct Box<T>(
    @Serialize(rename = "required") val raw: T,
    val maybe: T?,
    val label: String? = Some("guest"),
    val empty: String? = None,
    @Serialize(ignore = true) val ignored: T?
)
public class BoxEncoder<T> public constructor(private val codec: Encodable<T>) : Encodable<Box<T>>
public class BoxDecoder<T> public constructor(private val codec: Decodable<T>) : Decodable<Box<T>>

public class Row public constructor(public val id: Long, public val text: String? = None) {
    public companion object : Encodable<Row>, Decodable<Row> {}
}

public enum Choice {
    @Serialize(rename = "item") Named(val text: String? = None)
    public companion object : Encodable<Choice>, Decodable<Choice> {}
}
