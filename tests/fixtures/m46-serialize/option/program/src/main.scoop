import scoop.json.Json

object Pair : Encodable<(Long?, String?)>, Decodable<(Long?, String?)> {}
struct Nested(val value: Long) {
    companion object : Encodable<Nested>, Decodable<Nested> {}
}

fun main() {
    val encoder = Option<Long>.encoder(Long.Companion)
    val decoder = Option<Long>.decoder(Long.Companion)
    check(Json.encode(None, encoder) == "null")
    check(Json.encode(Some(7L), encoder) == "7")
    check(Json.decode("null", decoder) == None)
    check(Json.decode("7", decoder) == Some(7L))
    reject("") { Json.decode("\"wrong\"", decoder) }
    reject("") { Json.decode("{\"Some\":[7]}", decoder) }
    val array = Array<Long?>.encoder(encoder)
    check(Json.encode([None, Some(7L)], array) == "[null,7]")
    check(Json.encode((None, Some("text")), Pair) == "[null,\"text\"]")
    check(Json.decode("[null,\"text\"]", Pair) == (None, Some("text")))
    val nested = Option<Long?>.encoder(encoder)
    check(Json.encode(Some(None), nested) == "null")
    check(Json.decode("null", Option<Long?>.decoder(decoder)) == None)
    check(Json.decode("{\"value\":9}", Option<Nested>.decoder(Nested.Companion))!! == Nested(9L))
    check(Json.encode(Some(Nested(9L)), Option<Nested>.encoder(Nested.Companion)) == "{\"value\":9}")
    println("option-ok")
}
