import scoop.json.Json

struct Plain(val id: Long, val name: String?) {
    companion object : Encodable<Plain>, Decodable<Plain> {}
}

struct Flags(
    @Serialize(rename = "user_id") val id: Long,
    @Serialize(required = true) val email: String? = None,
    @Serialize(emitNull = true) val note: String? = None,
    @Serialize(ignore = true) val cache: Long = 9L,
    @Serialize(ignore = true) val ignored: String?,
    @Serialize() val name: String? = None
) {
    companion object : Encodable<Flags>, Decodable<Flags> {}
}

struct EncodeOnly(@Serialize(ignore = true) val action: () -> Unit, val id: Long) {
    companion object : Encodable<EncodeOnly> {}
}

fun main() {
    check(Json.decode("{\"id\":7}", Plain.Companion) == Plain(7L, None))
    check(Json.decode("{\"id\":7,\"name\":null}", Plain.Companion) == Plain(7L, None))
    check(Json.encode(Plain(7L, None), Plain.Companion) == "{\"id\":7}")
    check(Json.encode(Plain(7L, Some("Ada")), Plain.Companion) == "{\"id\":7,\"name\":\"Ada\"}")
    reject("/id") { Json.decode("{}", Plain.Companion) }
    reject("/id") { Json.decode("{\"id\":null}", Plain.Companion) }
    reject("/name") { Json.decode("{\"id\":7,\"name\":1}", Plain.Companion) }
    val flags = Flags(1L, ignored = Some("local"))
    check(Json.encode(flags, Flags.Companion) == "{\"user_id\":1,\"email\":null,\"note\":null}")
    val decoded = Json.decode("{\"user_id\":1,\"email\":null}", Flags.Companion)
    check(decoded.cache == 9L && decoded.ignored == None && decoded.note == None)
    reject("/email") { Json.decode("{\"user_id\":1}", Flags.Companion) }
    reject("/user_id") { Json.decode("{\"id\":1,\"email\":null}", Flags.Companion) }
    check(Json.encode(EncodeOnly({ Unit }, 3L), EncodeOnly.Companion) == "{\"id\":3}")
    println("fields-ok")
}
