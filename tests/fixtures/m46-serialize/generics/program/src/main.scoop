import scoop.json.Json

typealias Maybe<T> = Option<T>
typealias Identity<T> = T
struct Box<T>(val required: Identity<T>, val optional: Maybe<T>)
class BoxEncoder<T>(val codec: ValueEncoder<T>) : ValueEncoder<Box<T>>
class BoxDecoder<T>(val codec: ValueDecoder<T>) : ValueDecoder<Box<T>>
object Concrete : ValueEncoder<Box<String?>>, ValueDecoder<Box<String?>>

fun main() {
    val encoder = BoxEncoder<String?>(Option<String>.encoder(String.Companion))
    val decoder = BoxDecoder<String?>(Option<String>.decoder(String.Companion))
    val value: Box<String?> = Box(None, None)
    check(Json.encodeToString(value, encoder) == "{\"required\":null}")
    check(Json.encodeToString(value, Concrete) == "{\"required\":null}")
    reject("/required") { Json.decodeFromString("{}", decoder) }
    reject("/required") { Json.decodeFromString("{}", Concrete) }
    val decoded = Json.decodeFromString("{\"required\":null}", decoder)
    check(decoded.required == None && decoded.optional == None)
    val concrete = Json.decodeFromString("{\"required\":null}", Concrete)
    check(concrete.required == None && concrete.optional == None)
    val words = BoxEncoder<String>(String.Companion)
    check(Json.encodeToString(Box("yes", Some("maybe")), words) == "{\"required\":\"yes\",\"optional\":\"maybe\"}")
    println("generics-ok")
}
