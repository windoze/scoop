package numeric

public typealias Small = Float32
public typealias Wide = Float64
public const val NEGATIVE_ZERO: Small = -0f
public const val NEGATIVE_NAN: Wide = -Double.NaN
public annotation class Scale(val small: Small = 1.000000059604644775390625000001,
                              val wide: Wide = NEGATIVE_NAN)

@Scale
public struct Record(@Scale(-0f, NEGATIVE_NAN) val small: Small, val wide: Wide = -0.0) {
    public companion object : Encodable<Record>, Decodable<Record>
}
public struct Cell<T>(val value: T)
public fun <T> identity(value: T): T = value
public fun <T> cell(value: T): Cell<T> = Cell(value)
public fun fromProvider(): Small = identity(NEGATIVE_ZERO)

public fun patternDefault(value: Small = when (-0f) {
    case 0f -> 1.000000059604644775390625000001
    case _ -> 0f
}): Small = value
public fun arithmeticDefault(value: Small = 5.5f % 2f + 1f): Small = value
public fun classify(value: Small): Int = when (value) { case -0f -> 1; case _ -> 2 }
public fun remainder(value: Small): Small = value % 2f
public fun wideRemainder(value: Wide, divisor: Wide): Wide = value % divisor
