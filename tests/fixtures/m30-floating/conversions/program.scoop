@NoGC fun narrow(value: Double): Int8 = value.toByte()
@NoGC fun widen(value: Float): Double = value.toDouble()
@NoGC fun shorten(value: Double): Float = value.toFloat()
fun main() {
    val nan = 0.0 / 0.0
    val positive = 1.0 / 0.0
    val negative = -positive
    println(f"${narrow(1000.0)} ${narrow(-1000.0)} ${narrow(-12.75)} ${narrow(nan)}")
    println(f"${positive.toByte()} ${positive.toShort()} ${positive.toInt()} ${positive.toLong()}")
    println(f"${negative.toByte()} ${negative.toShort()} ${negative.toInt()} ${negative.toLong()}")
    println(f"${positive.toUByte()} ${positive.toUShort()} ${positive.toUInt()} ${positive.toULong()}")
    println(f"${negative.toUByte()} ${negative.toUShort()} ${negative.toUInt()} ${negative.toULong()}")
    println(f"${nan.toUByte()} ${nan.toUShort()} ${nan.toUInt()} ${nan.toULong()}")
    println(f"${255.9.toUByte()} ${256.0.toUByte()} ${65536.0.toUShort()} ${4294967296.0.toUInt()}")
    println(f"${18446744073709551616.0.toULong()} ${9223372036854775808.0.toLong()}")
    val fnan = 0f / 0f
    val fpositive = 1f / 0f
    val fnegative = -fpositive
    println(f"${fpositive.toByte()} ${fpositive.toShort()} ${fpositive.toInt()} ${fpositive.toLong()}")
    println(f"${fnegative.toByte()} ${fnegative.toShort()} ${fnegative.toInt()} ${fnegative.toLong()}")
    println(f"${fpositive.toUByte()} ${fpositive.toUShort()} ${fpositive.toUInt()} ${fpositive.toULong()}")
    println(f"${fnan.toByte()} ${fnan.toShort()} ${fnan.toInt()} ${fnan.toLong()}")
    println(f"${fnegative.toUByte()} ${fnegative.toUShort()} ${fnegative.toUInt()} ${fnegative.toULong()}")
    val i8: Int8 = -128
    val i16: Int16 = -32768
    val i32: Int32 = -2147483648
    val i64: Int64 = -9223372036854775808
    val u8: UInt8 = 255U
    val u16: UInt16 = 65535U
    val u32: UInt32 = 4294967295U
    val u64: UInt64 = 18446744073709551615UL
    println(f"${i8.toFloat()} ${i16.toFloat()} ${i32.toFloat()} ${i64.toFloat()}")
    println(f"${u8.toFloat()} ${u16.toFloat()} ${u32.toFloat()} ${u64.toFloat()}")
    println(f"${i8.toDouble()} ${i16.toDouble()} ${i32.toDouble()} ${i64.toDouble()}")
    println(f"${u8.toDouble()} ${u16.toDouble()} ${u32.toDouble()} ${u64.toDouble()}")
    println(f"${widen(0.1f)} ${shorten(0.1)} ${shorten(-0.0)} ${widen(-0f)}")
    println(f"${(-0.0).toDouble()} ${(-0f).toFloat()} ${shorten(1e40)}")
}
