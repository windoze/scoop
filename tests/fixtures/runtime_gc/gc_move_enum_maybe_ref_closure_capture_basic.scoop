// EXPECT: pass
// ENV: SCOOP_GC_MOVE=1
// ENV: SCOOP_GC_VERIFY_ROOTS=1
// RUN-STDOUT: gc_move_enum_maybe_ref_closure_capture_basic.stdout.txt
//
// T1517：enum（maybe ref variant）在 closure capture 环境中的 roots/moving GC 回归。
// - A：boxed variant（payload 为 GC-managed heap object，内部含 String ref）。
// - B：纯标量 variant（必须保证 enum 的 ref slots 不被污染）。
//
// 覆盖点：
// - closure env（heap object）直接捕获 enum value；
// - moving GC 后，closure 中读取与解构 enum（含 boxed variant payload）仍正确。
// SYSROOT-DEPS: scoop.runtime.test

package fixtures.codegen

import scoop.core.*
import scoop.runtime.test.*

enum E {
    A(val n: Int, val s: String),
    B(val x: Int),
}

fun render(e: E): String {
    return when (e) {
        A(n, s) -> f"A n={n} s={s}"
        B(x) -> f"B x={x}"
    }
}

fun callAfterGc(f: () -> Int): Int {
    // 先制造一些垃圾对象，再触发一次 moving GC。
    __scoop_gc_debug_alloc_garbage(30)
    __scoop_gc_collect()
    return f()
}

fun main(): Int {
    val e0: E = A(0, f"cap {0}")
    val e1: E = B(1)

    val _r0: Int = callAfterGc {
        println(render(e0))
        0
    }
    val _r1: Int = callAfterGc {
        println(render(e1))
        0
    }

    println("done")
    return 0
}
