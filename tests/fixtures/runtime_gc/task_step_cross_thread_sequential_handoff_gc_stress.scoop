// EXPECT: pass
// ENV: SCOOP_GC_MOVE=1
// ENV: SCOOP_GC_STRESS=1
// ENV: SCOOP_GC_VERIFY_ROOTS=1
// RUN-STDOUT: task_step_cross_thread_sequential_handoff_gc_stress.stdout.txt
// TIMEOUT: 5000
//
// T4016T8：无锁 Task 的顺序跨线程 handoff 需要同时满足：
// - worker thread 在注册前，`threadSpawn { ... }` 捕获的 closure env 仍被 GC 正确保活；
// - worker 接手 `outer.step()` 后，`TaskStep` / continuation / completed 缓存结果在 moving GC 下仍稳定；
// - 整个 handoff 过程不依赖 per-task mutex，也不把竞争编码成 `Pending`。

package fixtures.codegen

import scoop.core.*
import scoop.thread.*

@Unsafe
@Extern("scoop_test_thread_spawn_gate_reset")
fun spawnGateReset(): Unit

@Unsafe
@Extern("scoop_test_thread_spawn_gate_enable")
fun spawnGateEnable(): Unit

@Unsafe
@Extern("scoop_test_thread_spawn_gate_entered")
fun spawnGateEntered(): Int

@Unsafe
@Extern("scoop_test_thread_spawn_gate_release")
fun spawnGateRelease(): Unit

struct Payload(val label: String, val value: Int)

fun waitSpawnGateEntered(): Unit {
    while (@Unsafe do { spawnGateEntered() } == 0) {
        yield()
    }
}

fun makePayload(label: String, value: Int): Payload {
    __scoop_gc_debug_alloc_garbage(64)
    __scoop_gc_collect()
    return Payload { label: label, value: value }
}

fun printPayload(prefix: String, payload: Payload): Unit {
    println(prefix)
    println(payload.label)
    println(payload.value)
}

fun main() {
    @Unsafe do {
        spawnGateReset()
        spawnGateEnable()
    }

    val inner: Task<Payload> = async {
        val payload: Payload = makePayload("inner", 41)
        printPayload("inner-ready", payload)
        payload
    }

    val outer: Task<Payload> = async {
        println("outer-before")
        val awaited: Payload = await inner
        printPayload("outer-after-await", awaited)
        makePayload(awaited.label, awaited.value + 1)
    }

    when (outer.step()) {
        TaskStep.Pending -> println("main-pending")
        TaskStep.Ready(value) -> printPayload("main-ready", value)
    }

    val worker: Thread = threadSpawn {
        __scoop_gc_collect()
        when (outer.step()) {
            TaskStep.Pending -> println("worker-pending")
            TaskStep.Ready(value) -> printPayload("worker-ready", value)
        }
    }

    waitSpawnGateEntered()
    __scoop_gc_debug_alloc_garbage(64)
    __scoop_gc_collect()
    @Unsafe do { spawnGateRelease() }

    worker.join()

    __scoop_gc_collect()
    when (outer.step()) {
        TaskStep.Pending -> println("main-final-pending")
        TaskStep.Ready(value) -> printPayload("main-final-ready", value)
    }
}
