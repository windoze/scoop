// EXPECT: pass
// RUN-STDOUT: gc_stw_cross_thread_in_native_roots_basic.stdout.txt
// TIMEOUT: 30000
// 说明：在 GC stress + verify-roots 的整组 runtime_gc 回归里，`scoop run`
// 的编译+执行耗时会显著抖动；完整并行 fixture suite 在负载较高时会接近 10s，
// 这里保留与同类 STW fixture 一致且仍低于单 fixture 1 分钟上限的预算，避免误报超时。
//
// 目标：T1512c：跨线程 stop-the-world 边界 + InNative 线程 roots（native_roots）smoke。
//
// 关键点：
// - worker 线程通过 `@Extern` 进入 native，并在 native 内阻塞一段时间；
// - main 线程在确认 worker 已进入 native 后触发一次 `__scoop_gc_collect()`；
// - 期望：GC 不会等待 InNative 线程 park（避免死锁），并能通过 `native_roots` 保活 call-site 的 `x`。
// SYSROOT-DEPS: scoop.runtime.test scoop.thread

package fixtures.codegen

import scoop.core.*
import scoop.runtime.test.*
import scoop.thread.*

@Extern("scoop_test_gc_native_sleep_reset")
fun nativeSleepReset(): Unit

@Extern("scoop_test_gc_native_sleep_entered")
fun nativeSleepEntered(): Int

@Extern("scoop_test_gc_sleep_in_native_ms")
fun sleepInNativeMillis(ms: Int): Unit

fun waitWorkerInNative(): Unit {
    // 等待 worker 已进入 native（由 runtime test-only 符号在 native 内部设置 flag）。
    while (@Unsafe do { nativeSleepEntered() } == 0) {
        yield()
    }
}

fun worker(): Unit {
    val x: String = f"native {42}"

    // 进入 native 并阻塞：该调用点会被编译器插入 enter_native/leave_native，
    // 从而让当前线程处于 InNative 状态并暴露 native_roots 供 GC 扫描。
    @Unsafe do { sleepInNativeMillis(200) }

    println(x)
}

fun main() {
    @Unsafe do { nativeSleepReset() }

    val t: Thread = threadSpawn { worker() }

    waitWorkerInNative()

    __scoop_gc_collect()

    t.join()
    println("ok")
}
