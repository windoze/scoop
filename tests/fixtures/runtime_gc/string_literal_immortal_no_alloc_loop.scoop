// EXPECT: pass
// EXPECT-EXIT: 0
// SYSROOT-DEPS: scoop.runtime.test
// P5-T02: repeated String literal evaluation must not allocate ScoopString wrappers.
// P7-T02: keep default pacing on; immortal literals are off-heap, so the zero-allocation
// assertion must hold without `SCOOP_GC_PACING=off`.

import scoop.core.*
import scoop.runtime.test.*

fun main(): Int {
    val before: Int = @Unsafe do { __scoop_gc_debug_heap_bytes_allocated() }
    var i: Int = 0
    var checksum: Int = 0
    while (i < 10000000) {
        val s: String = "hot_loop_literal"
        checksum = checksum + s.length()
        i = i + 1
    }
    val after: Int = @Unsafe do { __scoop_gc_debug_heap_bytes_allocated() }
    if (after != before) {
        return 1
    }
    if (checksum == 0) {
        return 2
    }
    return 0
}
