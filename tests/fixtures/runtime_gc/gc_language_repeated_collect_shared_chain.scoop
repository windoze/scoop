// EXPECT: pass
// RUN-STDOUT: gc_language_repeated_collect_shared_chain.stdout.txt
// TIMEOUT: 30000
//
// 目标：在 Scoop worker 持续分配链表节点时反复触发 GC，验证最终跨线程发布的链仍可追踪。
// SYSROOT-DEPS: scoop.runtime.test scoop.thread scoop.sync

package fixtures.runtime_gc

import scoop.core.*
import scoop.runtime.test.*
import scoop.sync.*
import scoop.thread.*
import scoop.unsafe.*

class ChainNode(val label: String, val weight: Int) {
    var next: ChainNode? = None()
}

class ChainState(
    val lock: Mutex,
    val cv: CondVar,
    var readyCount: Int,
    var checkpointCount: Int,
    var doneCount: Int,
    var headA: ChainNode?,
    var headB: ChainNode?,
)

object ChainShared {
    val state: ChainState = ChainState(mutexCreate(), condVarCreate(), 0, 0, 0, None(), None())
}

@Global
var chainPhase: __AtomicInt = __AtomicInt(0)

fun markChainReady(): Unit {
    val st: ChainState = ChainShared.state
    st.lock.lock()
    st.readyCount = st.readyCount + 1
    st.cv.notifyAll()
    st.lock.unlock()
}

fun markChainCheckpoint(): Unit {
    val st: ChainState = ChainShared.state
    st.lock.lock()
    st.checkpointCount = st.checkpointCount + 1
    st.cv.notifyAll()
    st.lock.unlock()
}

fun publishChainA(head: ChainNode): Unit {
    val st: ChainState = ChainShared.state
    st.lock.lock()
    st.headA = Some(head)
    st.doneCount = st.doneCount + 1
    st.cv.notifyAll()
    st.lock.unlock()
}

fun publishChainB(head: ChainNode): Unit {
    val st: ChainState = ChainShared.state
    st.lock.lock()
    st.headB = Some(head)
    st.doneCount = st.doneCount + 1
    st.cv.notifyAll()
    st.lock.unlock()
}

fun waitForChainPhaseAdvance(phase: Int): Unit {
    while (@Unsafe do { __atomicIntLoad(chainPhase) } == phase) {
        sleepMillis(1)
    }
}

fun extendChain(prefix: String, phase: Int, head: ChainNode): ChainNode {
    var current: ChainNode = head
    var i: Int = 0
    while (i < 32) {
        val next: ChainNode = ChainNode(f"${prefix}-live-${phase}-${i}", i)
        next.next = Some(current)
        current = next
        val _garbage: Any = ChainNode(f"${prefix}-garbage-${phase}-${i}", i)
        i = i + 1
    }
    return current
}

fun chainWorkerA(): Unit {
    var head: ChainNode = ChainNode("A-root", 1)
    markChainReady()

    var phase: Int = 0
    while (phase < 3) {
        head = extendChain("A", phase, head)
        markChainCheckpoint()
        waitForChainPhaseAdvance(phase)
        phase = phase + 1
    }

    val finalHead: ChainNode = ChainNode("A-final", 1000)
    finalHead.next = Some(head)
    publishChainA(finalHead)
}

fun chainWorkerB(): Unit {
    var head: ChainNode = ChainNode("B-root", 2)
    markChainReady()

    var phase: Int = 0
    while (phase < 3) {
        head = extendChain("B", phase, head)
        markChainCheckpoint()
        waitForChainPhaseAdvance(phase)
        phase = phase + 1
    }

    val finalHead: ChainNode = ChainNode("B-final", 2000)
    finalHead.next = Some(head)
    publishChainB(finalHead)
}

fun waitChainReady(expected: Int): Unit {
    val st: ChainState = ChainShared.state
    st.lock.lock()
    while (st.readyCount < expected) {
        st.cv.wait(st.lock)
    }
    st.lock.unlock()
}

fun waitChainCheckpoints(expected: Int): Unit {
    val st: ChainState = ChainShared.state
    st.lock.lock()
    while (st.checkpointCount < expected) {
        st.cv.wait(st.lock)
    }
    st.lock.unlock()
}

fun expectChainNode(value: ChainNode?): ChainNode {
    return when (value) {
        Some(node) -> node
        None -> ChainNode("missing", -1)
    }
}

fun readHeadA(): ChainNode {
    val st: ChainState = ChainShared.state
    st.lock.lock()
    val got: ChainNode? = st.headA
    st.lock.unlock()
    return expectChainNode(got)
}

fun readHeadB(): ChainNode {
    val st: ChainState = ChainShared.state
    st.lock.lock()
    val got: ChainNode? = st.headB
    st.lock.unlock()
    return expectChainNode(got)
}

fun main() {
    val ta: Thread = threadSpawn { chainWorkerA() }
    val tb: Thread = threadSpawn { chainWorkerB() }

    waitChainReady(2)
    waitChainCheckpoints(2)
    __scoop_gc_debug_alloc_garbage(64)
    __scoop_gc_collect()
    @Unsafe do { __atomicIntStore(chainPhase, 1) }

    waitChainCheckpoints(4)
    __scoop_gc_debug_alloc_garbage(64)
    __scoop_gc_collect()
    @Unsafe do { __atomicIntStore(chainPhase, 2) }

    waitChainCheckpoints(6)
    __scoop_gc_debug_alloc_garbage(64)
    __scoop_gc_collect()
    @Unsafe do { __atomicIntStore(chainPhase, 3) }

    ta.join()
    tb.join()

    __scoop_gc_debug_alloc_garbage(64)
    __scoop_gc_collect()

    println(readHeadA().label)
    println(readHeadB().label)
    println("ok")
}
