package consumer.options

private class Cell(public val number: Int)
private var stored: Int?

public fun <T> exercise(value: T): Int {
    stored = None
    val held = reorderedWrap(value)
    val nested: T?? = Some(held)
    val missing: T? = None
    val callback: () -> T? = { Some(value) }
    val read = reorderedForce(callback())
    val defaulted = reorderedDefault(value)
    if (when (nested) { case Some(Some(payload)) -> false; else -> true }) { return 1 }
    if (when (missing) { case Some(payload) -> true; case None -> false }) { return 2 }
    if ((stored ?: 40) != 40) { return 3 }
    stored = Some(40)
    val cell = reorderedWrap(Cell(2))
    val allocated = Cell(0)
    var caught = false
    try { reorderedForce<Int>(None) } catch (error: UnwrapException) { caught = true }
    if (!caught) { return 4 }
    return (stored ?: 0) + reorderedForce(cell).number + allocated.number
}

public fun result(): Int = exercise<Int>(1)
