package consumer.members

import templates.members.*

public class Derived<T> public constructor(value: T): ProtectedBox<T>(value) {
    public fun replace(next: T): T {
        val previous = this.state
        this.state = next
        return previous
    }
    public fun replacePeer(peer: Derived<T>, next: T): Unit { peer.state = next }
}

public fun result(): Int {
    val value = Derived<Int>(20)
    val old = value.replace(1)
    value.replacePeer(value, 22)
    return old + value.state
}

public fun <T> make(value: T): T {
    val holder = Derived<T>(value)
    holder.replacePeer(holder, value)
    return holder.state
}
