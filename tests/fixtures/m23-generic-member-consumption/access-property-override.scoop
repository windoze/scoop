package consumer.members

import templates.members.*

public class Derived<T> public constructor(value: T): ProtectedBox<T>(value) {
    public override var state: T = value
        protected set(next) { field = next }
}

public fun result(): Int {
    val value = Derived<Int>(20)
    val base: ProtectedBox<Int> = value
    val previous = base.replaceVirtual(22)
    if (base.state != value.state) { return 0 }
    return previous + value.state
}

public fun <T> make(value: T): T {
    val holder: ProtectedBox<T> = Derived<T>(value)
    holder.replaceVirtual(value)
    return holder.state
}
