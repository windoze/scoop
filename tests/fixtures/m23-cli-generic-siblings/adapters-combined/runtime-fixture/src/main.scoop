import consumer.union.check

@Extern(lib = "m23_union", name = "m23_register_union_check")
private fun registerUnionCheck()

@Extern(lib = "m23_class_gc", name = "m23_class_gc_collected")
fun collected(): Int

fun main() {
    @Unsafe { registerUnionCheck() }
    if (check() != 42) {
        throw IllegalStateException()
    }
    @Unsafe {
        if (collected() != 1) {
            throw IllegalStateException()
        }
    }
}
