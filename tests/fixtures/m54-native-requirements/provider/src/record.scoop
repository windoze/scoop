package regression

@CLayout
public struct NativeRecord(
    val kind: Int, val permissions: Int, val size: Long,
    val accessedSeconds: Long, val accessedNanos: Long,
    val modifiedSeconds: Long, val modifiedNanos: Long,
    val changedSeconds: Long, val changedNanos: Long,
    val createdSeconds: Long, val createdNanos: Long
)

public fun same(left: NativeRecord, right: NativeRecord): Boolean = left == right

public fun record(changed: Int): NativeRecord = NativeRecord(
    if (changed == 0) 257 else 1,
    if (changed == 1) 258 else 2,
    if (changed == 2) 0x0100000000000003L else 3L,
    if (changed == 3) 0x0100000000000004L else 4L,
    if (changed == 4) 0x0100000000000005L else 5L,
    if (changed == 5) 0x0100000000000006L else 6L,
    if (changed == 6) 0x0100000000000007L else 7L,
    if (changed == 7) 0x0100000000000008L else 8L,
    if (changed == 8) 0x0100000000000009L else 9L,
    if (changed == 9) 0x010000000000000AL else 10L,
    if (changed == 10) 0x010000000000000BL else 11L
)
