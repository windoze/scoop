import scoop.cli.*

enum Temperature { @Serialize(rename = "hot-wire") Hot, Cold
    companion object : ValueDecoder<Temperature>
}
struct Port(val value: Int)

fun main() {
    val schema = CliSchema(typeInfo<Decoder>(), CliConfig("raw"), [
        CliEntry("value", "value", CliRole.Option, CliValueShape.Text, ["--value"]),
        CliEntry("items", "items", CliRole.Option, CliValueShape.Repeated(CliElementShape.Text), ["--items"]),
        CliEntry("flag", "flag", CliRole.Flag, CliValueShape.Flag, ["--flag"], ["--no-flag"]),
        CliEntry("choice", "choice", CliRole.Option, CliValueShape.Choice([CliChoice("Hot", "hot-wire"), CliChoice("Cold", "Cold")]), ["--choice"]),
        CliEntry("leftover", "leftover", CliRole.Option, CliValueShape.Text, ["--leftover"]),
        CliEntry("escaped", "key/name~", CliRole.Option, CliValueShape.Text, ["--escaped"])
    ])
    val parser = CliParser(schema, ValueDecoderFunction<Decoder>({ value -> value }))
    val root = parsed(parser.parse(["--value=auto", "--items=1", "--items=2", "--flag", "--choice=Hot", "--leftover=x", "--escaped=bad"]))
    gcCollect()
    check(!root.singleValue().isNull())
    fails("", { root.singleValue().readNull() })
    fails("", { root.unkeyed() })
    val keyed = root.keyed()
    check(keyed.keys.size == 6L)
    equal(keyed.keys[0L], "value")
    equal(keyed.keys[5L], "key/name~")
    keyed.end(); keyed.end()
    val value = keyed.required("value")
    fails("/value", { value.singleValue().readLong() })
    equal(value.singleValue().readString(), "auto")
    equal(keyed.required("value").singleValue().readString(), "auto")
    fails("/value", { value.keyed() })
    fails("/value", { value.singleValue().readFloat() })
    equal(value.singleValue().readString(), "auto")
    check(when (keyed.optional("missing")) { case None -> true; case Some(_) -> false })
    fails("/missing", { keyed.required("missing") })
    val copiedKeys = keyed.keys
    check(copiedKeys.size == 6L && root.keyed().keys.size == 6L)

    val sequence = keyed.required("items")
    val first = sequence.unkeyed()
    val second = sequence.unkeyed()
    val shared = first
    fails("/items", { first.end() })
    val child = first.element()
    check(child.singleValue().readLong() == 1L)
    fails("/items/0", { child.singleValue().readNull() })
    check(child.singleValue().readLong() == 1L && second.element().singleValue().readLong() == 1L)
    check(shared.element().singleValue().readLong() == 2L && !first.hasNext && second.hasNext)
    first.end(); first.end()
    fails("/items/2", { first.element() })
    check(!first.hasNext)
    check(second.element().singleValue().readLong() == 2L)
    second.end()
    check(sequence.unkeyed().element().singleValue().readLong() == 1L)
    val choice = keyed.required("choice")
    check(!choice.singleValue().isNull())
    fails("/choice", { choice.singleValue().readString() })
    equal(choice.keyed().keys[0L], "hot-wire")
    check(Option<Temperature>.decoder(Temperature.Companion).decode(choice) == Some(Temperature.Hot))
    check(Temperature.decode(choice) == Temperature.Hot)
    check(keyed.required("flag").singleValue().readBoolean())
    fails("/flag", { keyed.required("flag").singleValue().readString() })
    check(keyed.required("flag").singleValue().readBoolean())
    try { keyed.required("key/name~").singleValue().readLong(); throw IllegalStateException() }
    catch (error: DecodingException) {
        equal(error.path, "/key~1name~0")
        check(contains(error.message!!, "token 6") && contains(error.message!!, "--escaped=bad"))
    }
    keyed.end()
    equal(keyed.required("leftover").singleValue().readString(), "x")

    val portSchema = CliSchema(typeInfo<Port>(), CliConfig("port"), [
        CliEntry("port", "port", CliRole.Option, CliValueShape.Text, ["--port"])
    ])
    val portCodec = ValueDecoderFunction<Port>({ decoder -> Port(Int.decode(decoder.keyed().required("port"))) })
    check(parsed(CliParser(portSchema, portCodec).parse(["--port=8080"])).value == 8080)
    val partial = ValueDecoderFunction<String>({ decoder -> decoder.keyed().required("value").singleValue().readString() })
    val partialSchema = CliSchema(typeInfo<String>(), CliConfig("partial"), schema.entries)
    equal(parsed(CliParser(partialSchema, partial).parse(["--value=kept", "--leftover=unused"])), "kept")
    val throwing = CliParser(schema, ValueDecoderFunction<Decoder>({ _ -> throw IllegalArgumentException(Some("codec failure")) }))
    check(when (throwing.parse(["--help"])) { case CliResult.HelpRequested -> true; else -> false })
    try { throwing.parse([]); throw IllegalStateException() }
    catch (error: IllegalArgumentException) { equal(error.message!!, "codec failure") }
    println("cli-stable-decoder-ok")
}
