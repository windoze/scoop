import scoop.asyncio.*
import scoop.http.HttpException
import scoop.http.client.*
import scoop.platform.fs.OpenOptions
import scoop.platform.fs.Path
import scoop.platform.system.PlatformErrorKind
import scoop.platform.system.PlatformException
import scoop.test.*

internal suspend fun seedResume(client: HttpClient, mode: String, request: HttpRequest, target: Path, resume: HttpResumeOptions) {
    val complete = mode == "complete-416" || mode == "bad-416" || mode == "digest-prefix"
    val failed = DownloadFailure()
    try { client.resumeDownload(request, target, resume, HttpDownloadOptions(bufferSize = 4L)) }
    catch (error: Throwable) { failed.value = Some(error) }
    assertTrue(downloadPresent(failed.value))
    if (complete) {
        assertTrue(failed.value!! is PlatformException)
        assertEquals(PlatformErrorKind.AlreadyExists, (failed.value!! as PlatformException).kind)
    } else assertTrue(failed.value!! is HttpException)
    assertEquals("original", String.fromUtf8(downloadRead(target)))
    assertTrue(downloadExists(resume.metadataFile))
    val size = downloadRead(resume.partialFile).size
    assertEquals(if (complete) 48L else if (mode == "digest-incomplete") 0L else 8L, size)
    if (mode == "digest-prefix") {
        currentEventLoop().openFile(resume.partialFile, OpenOptions(write = true)).useAsync suspend { file -> file.truncate(8L) }
        val interrupted = DownloadFailure()
        try { client.resumeDownload(request, target, resume, HttpDownloadOptions(bufferSize = 4L)) }
        catch (error: Throwable) { interrupted.value = Some(error) }
        assertTrue(downloadPresent(interrupted.value))
        assertTrue(interrupted.value!! is HttpException)
        assertEquals(8L, downloadRead(resume.partialFile).size)
        assertEquals("original", String.fromUtf8(downloadRead(target)))
    }
}
