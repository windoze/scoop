import fixtures.model.*

fun check(condition: Boolean): Unit {
    if (!condition) { throw IllegalStateException() }
}

fun text(annotation: AnnotationInfo): String = when (annotation.arguments[0L].value) {
    case AnnotationValue.String(value) -> value
    else -> throw IllegalStateException()
}

fun main() {
    val descriptor = withType<Long>(recordType()).describe()
    val shape = when (descriptor.shape) {
        case TypeShape.Struct(value) -> value
        else -> throw IllegalStateException()
    }
    gcCollect()
    val field = shape.fields[0L]
    check(field.owner == descriptor.type)
    check(field.type == textType())
    check(!field.isOptionAtDeclaration)
    check(field.constructorParameter!! == shape.constructors[0L].parameters[0L].id)
    check(shape.constructors[0L].parameters[0L].hasDefault)
    check(when (shape.constructors[0L].parameters[0L].member) {
        case ParameterMember.Field(id) -> id == field.id
        else -> false
    })
    check(text(descriptor.annotations[0L]) == "declaration")
    check(text(field.annotations[0L]) == "field")
    check(text(field.typeUse.annotations[0L]) == "type use")
    check(field.type.describe().annotations.size == 0L)

    val key = helpKey()
    check(key == helpKey())
    check(key != helpKey("annotation:other"))
    val declaration = key.describe()
    check(declaration.key == key)
    check(declaration.parameters[0L].id == field.annotations[0L].arguments[0L].parameter)
    check(when (declaration.parameters[0L].defaultValue!!) {
        case AnnotationValue.String(value) -> value == "default"
        else -> false
    })
    val repeatable = findAnnotations([help("first"), AnnotationInfo(helpKey("other"), []), help("last")], key)
    check(repeatable.size == 2L)
    check(text(repeatable[0L]) == "first" && text(repeatable[1L]) == "last")
    check(findAnnotations([], key).size == 0L)

    val values = annotationValues()
    gcCollect()
    check(values.size == 14L)
    check(when (values[9L]) {
        case AnnotationValue.Integer(IntegerValue.ULong(value)) -> value == 18446744073709551615uL
        else -> false
    })
    check(when (values[10L]) {
        case AnnotationValue.FloatBits(bits) -> bits == 2147483648u
        else -> false
    })
    check(when (values[11L]) {
        case AnnotationValue.DoubleBits(bits) -> bits == 9223372036854775808uL
        else -> false
    })
    check(when (values[12L]) {
        case AnnotationValue.Array(AnnotationAtomType.Annotation(nestedKey), items) -> {
            check(nestedKey == key)
            when (items[0L]) {
                case AnnotationValue.Annotation(item) -> text(item) == "nested"
                else -> false
            }
        }
        else -> false
    })
    check(when (values[13L]) {
        case AnnotationValue.Array(AnnotationAtomType.Scalar(element), items) ->
            element == textType() && items.size == 0L
        else -> false
    })
    println("combined-type-model-ok")
}
