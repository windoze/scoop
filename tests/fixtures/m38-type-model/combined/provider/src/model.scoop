package fixtures.model

public fun textType(): TypeRef = TypeRef("core:string", "String", Some(NominalRef("core:string")), [], {
    gcCollect()
    TypeDescription(textType(), [], TypeShape.Intrinsic(IntrinsicInfo(IntrinsicKind.String)))
})

public fun helpKey(identity: String = "annotation:help"): AnnotationKey =
    AnnotationKey(identity, "Help", {
        gcCollect()
        AnnotationDeclarationInfo(helpKey(identity), DeclarationVisibility.Public, [
            AnnotationParameterInfo(
                ParameterRef("help:text"), "text", AnnotationParameterType.Scalar(textType()),
                Some(AnnotationValue.String("default"))
            )
        ], [])
    })

public fun help(text: String): AnnotationInfo = AnnotationInfo(helpKey(), [
    AnnotationArgument(ParameterRef("help:text"), "text",
        AnnotationParameterType.Scalar(textType()), AnnotationValue.String(text))
])

public fun recordType(): TypeRef = TypeRef("record:1", "Record", Some(NominalRef("record")), [], {
    val owner = recordType()
    val field = FieldRef("record:name")
    val parameter = ParameterRef("record:primary:0")
    val use = TypeUseInfo(textType(), [help("type use")], [])
    val fields = [FieldInfo(
        field, owner, MemberName.Named("name"), use, false, 0L, [help("field")],
        DeclarationVisibility.Public, StorageOrigin.Declared, Some(parameter)
    )]
    val parameters = [ParameterInfo(parameter, "name", use, 0L, [], true, false,
        ParameterMember.Field(field))]
    val constructors = [ConstructorInfo(ConstructorRef("record:primary"), owner,
        ConstructorKind.Primary, DeclarationVisibility.Public, [], parameters)]
    gcCollect()
    TypeDescription(owner, [help("declaration")], TypeShape.Struct(StructInfo(fields, constructors, [])))
})

public fun <T> withType(type: TypeRef): TypeInfo<T> = TypeInfo<T>(type)

public fun annotationValues(): Array<AnnotationValue> = [
    AnnotationValue.Boolean(true),
    AnnotationValue.Char('雪'),
    AnnotationValue.Integer(IntegerValue.Int8(-128)),
    AnnotationValue.Integer(IntegerValue.Int16(-32768)),
    AnnotationValue.Integer(IntegerValue.Int(-2147483648)),
    AnnotationValue.Integer(IntegerValue.Long(-9223372036854775808L)),
    AnnotationValue.Integer(IntegerValue.UInt8(255u)),
    AnnotationValue.Integer(IntegerValue.UInt16(65535u)),
    AnnotationValue.Integer(IntegerValue.UInt(4294967295u)),
    AnnotationValue.Integer(IntegerValue.ULong(18446744073709551615uL)),
    AnnotationValue.FloatBits(2147483648u),
    AnnotationValue.DoubleBits(9223372036854775808uL),
    AnnotationValue.Array(AnnotationAtomType.Annotation(helpKey()), [
        AnnotationValue.Annotation(help("nested"))
    ]),
    AnnotationValue.Array(AnnotationAtomType.Scalar(textType()), [])
]
