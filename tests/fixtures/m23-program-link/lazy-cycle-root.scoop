import startup.cycle.*
private fun trace(value: Long) { println(value) }
private fun failure(): IllegalStateException = try {
    readCycle()
    throw IllegalStateException()
} catch (error: IllegalStateException) { error }
fun main() {
    val first = failure()
    val firstMessage = when (first.message) {
        case Some(value) -> value
        case None -> { throw IllegalStateException() }
    }
    val allocated = Box(42L)
    val second = failure()
    val secondMessage = when (second.message) {
        case Some(value) -> value
        case None -> { throw IllegalStateException() }
    }
    if (count() != 1 || firstMessage !== secondMessage) {
        throw IllegalStateException()
    }
    @Unsafe { trace(allocated.value) }
}
