fun check(condition: Boolean, message: String) {
    if (!condition) { throw IllegalStateException(Some(message)) }
}

fun intrinsic(reference: TypeRef): IntrinsicKind = when (reference.describe().shape) {
    case TypeShape.Intrinsic(value) -> value.kind
   ; else -> throw IllegalStateException()
}

struct Empty()
struct Functions(
    val function: suspend String.(Int, Long) -> Boolean,
    val pointer: FunPtr<(Int) -> Long>,
    val raw: Ptr<Char>,
    val tuple: (Int, String)
)

fun main() {
    check(intrinsic(typeInfo<Boolean>().type) == IntrinsicKind.Boolean, "Boolean")
    check(intrinsic(typeInfo<Char>().type) == IntrinsicKind.Char, "Char")
    check(intrinsic(typeInfo<Float>().type) == IntrinsicKind.Float, "Float")
    check(intrinsic(typeInfo<Double>().type) == IntrinsicKind.Double, "Double")
    check(intrinsic(typeInfo<String>().type) == IntrinsicKind.String, "String")
    check(intrinsic(typeInfo<Any>().type) == IntrinsicKind.Any, "Any")
    check(intrinsic(typeInfo<Nothing>().type) == IntrinsicKind.Nothing, "Nothing")
    check(intrinsic(typeInfo<MutableArray<Int>>().type) == IntrinsicKind.MutableArray, "MutableArray")
    check(intrinsic(typeInfo<MaybeUninit<Long>>().type) == IntrinsicKind.MaybeUninit, "MaybeUninit")
    check(intrinsic(typeInfo<AtomicInt>().type) == IntrinsicKind.Atomic(AtomicTypeKind.Int), "AtomicInt")
    check(intrinsic(typeInfo<AtomicRef<String>>().type) == IntrinsicKind.Atomic(AtomicTypeKind.Reference), "AtomicRef")
    check(when (intrinsic(typeInfo<UInt16>().type)) { case IntrinsicKind.Integer(signed, bits) -> !signed && bits == 16L; else -> false }, "UInt16")
    check(typeInfo<Empty>().type != typeInfo<Unit>().type, "empty nominal identity")

    val shape = when (typeInfo<Functions>().describe().shape) { case TypeShape.Struct(value) -> value; else -> throw IllegalStateException() }
    val action = when (shape.fields[0L].type.describe().shape) { case TypeShape.Function(value) -> value; else -> throw IllegalStateException() }
    check(action.isSuspend && action.receiver!!.type == typeInfo<String>().type, "receiver and effect")
    check(action.parameters.size == 2L && action.parameters[1L].type == typeInfo<Long>().type, "function parameters")
    check(action.result.type == typeInfo<Boolean>().type, "function result")
    check(shape.fields[0L].type != typeInfo<String.(Int, Long) -> Boolean>().type, "effect identity")
    check(shape.fields[0L].typeUse.children[0L].role == TypeUseRole.Receiver, "receiver role")
    check(shape.fields[0L].typeUse.children[3L].role == TypeUseRole.Result, "result role")
    check(when (shape.fields[1L].type.describe().shape) { case TypeShape.Pointer(PointerTypeInfo.FunPtr(value)) -> value.parameters[0L].type == typeInfo<Int>().type && value.result.type == typeInfo<Long>().type; else -> false }, "native signature")
    check(shape.fields[1L].typeUse.children[0L].role == TypeUseRole.Pointee, "function pointer role")
    check(shape.fields[2L].typeUse.children[0L].value.type == typeInfo<Char>().type, "raw pointer role")
    check(shape.fields[3L].typeUse.children[1L].role == TypeUseRole.TupleElement(1L), "tuple role")
    gcCollect()
    check(action.result.type == typeInfo<Boolean>().type, "description after GC")
    println("structural-type-query-ok")
}
