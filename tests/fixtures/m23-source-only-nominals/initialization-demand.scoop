public interface DeferredSuspend {
    public suspend fun fetch(): Int
}

public object DeferredRegistry : DeferredSuspend {
    public override suspend fun fetch(): Int = 1
}

public class DeferredHost<T> {
    public companion object ReadyFactory {
        public val seed: Int = 6
        public fun read(): Int = seed
    }
}

public object ReadyRegistry {
    public val count: Int = DeferredHost.read() + 1
    public fun read(): Int = count
}

public val eager: Int = ReadyRegistry.read()
