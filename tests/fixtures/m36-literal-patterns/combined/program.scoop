struct Payload(val number: Int, val text: String)
enum Event {
    Ready(Payload)
    Empty
}
fun <T> check(value: T, test: (T) -> Boolean): Boolean = test(value)
fun describe(event: Event): Int = when (event) {
    case Ready(Payload { number: -1, text }) if check(text) { s -> s == "ok" } -> 11
    case Ready(Payload { number: 0, text: "zero" }) -> 12
    case Ready(_) -> 13
    case Empty -> 14
}
fun main() {
    println(describe(Event.Ready(Payload(-1, "ok"))))
    println(describe(Event.Ready(Payload(-1, "other"))))
    println(describe(Event.Ready(Payload(0, "zero"))))
    println(describe(Event.Empty))
    val pair = (false, Unit)
    println(when (pair) {
        case (false, Unit) -> 15
        case (true, ()) -> 16
    })
}
