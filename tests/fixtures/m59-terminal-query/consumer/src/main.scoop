import scoop.platform.io.standardOutput
import scoop.terminal.*
import scoop.terminal.cursor.MoveTo
import scoop.terminal.event.*
import scoop.terminal.screen.SetTitle
import scoop.time.Duration

fun main() {
    TerminalSession.open().use { session ->
        @Unsafe { check(redirect() == 0, "redirect stdin/stdout") }
        try {
            basic(session)
            failures(session)
            queued(session)
        } finally { @Unsafe { check(restore() == 0, "restore stdin/stdout") } }
    }
    standardOutput.execute(SetTitle("query-finished"))
}

fun basic(session: TerminalSession) {
    session.execute(MoveTo(8L, 3L))
    stage(session, "query-cursor")
    check(session.cursorPosition() == CursorPosition(8L, 3L), "cursor query")
    restored(session)
    expect(session, key('a'))
    expect(session, Event.FocusGained)
    expect(session, key('b'))
    stage(session, "query-primary")
    val primary = session.deviceAttributes()
    check(primary.size == 2L && primary[0L] == 1L && primary[1L] == 2L, "primary attributes")
    restored(session)
    stage(session, "query-secondary")
    val secondary = session.deviceAttributes(DeviceAttributeKind.Secondary)
    check(secondary.size == 3L && secondary[1L] == 100L, "secondary attributes")
    restored(session)
    stage(session, "query-kitty-zero")
    val flags = session.keyboardEnhancementFlags()
    check(flags != None && flags!!.bits == 0u, "zero Kitty flags mean supported")
    restored(session)
    expect(session, key('m'))
    expect(session, Event.FocusLost)
    expect(session, key('n'))
    stage(session, "query-kitty-no")
    check(!session.supportsKeyboardEnhancement(), "unsupported Kitty")
    stage(session, "query-kitty-yes")
    check(session.supportsKeyboardEnhancement(), "supported Kitty")
    restored(session)
}

fun queued(session: TerminalSession) {
    session.withRawMode {
        stage(session, "query-late-queued")
        check(session.poll(Duration.seconds(1L)), "key ahead of stale replies")
        stage(session, "query-fresh-cursor")
        check(session.cursorPosition() == CursorPosition(2L, 1L), "stale reply completed a new query")
        check(session.isRawMode, "query changed an existing raw scope")
        expect(session, key('x'))
        check(!session.poll(Duration.ZERO), "device reply escaped as user input")
    }
    restored(session)
}
