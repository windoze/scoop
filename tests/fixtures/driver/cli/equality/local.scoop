public enum Flag { Off, On }
public enum Packet {
    Empty,
    Item(Int),
    Named { value: String, flag: Flag }
}
public struct Envelope(val packet: Packet, val flag: Flag)
public struct Manual(val number: Int) {
    public operator fun equals(other: Manual): Boolean = true
}
public struct Overloaded(val number: Int) {
    public operator fun equals(other: Int): Boolean = this.number == other
}
public class Missing public constructor()
public enum Broken { Empty, Value(Missing) }

public fun <T> defaultSame(left: Flag, right: Flag, same: Boolean = left == right): Int {
    if (same) { return 42 }
    return 0
}

struct Generic<T>(val value: T)

fun main() {
    println(Flag.On == Flag.On)
    println(Flag.Off != Flag.On)
    println(Packet.Empty == Packet.Empty)
    println(Packet.Item(3) == Packet.Item(3))
    println(Packet.Item(3) != Packet.Item(4))
    println(Packet.Item(3) != Packet.Empty)
    println(Packet.Named(value = "x", flag = Flag.On) == Packet.Named(flag = Flag.On, value = "x"))
    println(Packet.Named(value = "x", flag = Flag.On) != Packet.Named(value = "x", flag = Flag.Off))
    println(Envelope(Packet.Item(3), Flag.On) == Envelope(Packet.Item(3), Flag.On))
    println(Manual(1) == Manual(2))
    println(Overloaded(3) == Overloaded(3))
    println(Overloaded(3) == 3)
    println(Generic(Flag.On) == Generic(Flag.On))
    println(defaultSame<Unit>(Flag.On, Flag.On))
}
