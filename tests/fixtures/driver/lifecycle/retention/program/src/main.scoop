package dev.m43
import scoop.test.*
import scoop.test.execution.*

class Payload(val value: Int)
class CleanupFailure(val payload: Payload) : Throwable(), ToString {
    public override fun toString(): String { throw Exception(Some("must not render caught failure")) }
}

class Settings(val value: Int)
context(settings: Settings)
fun readSetting(): Int = settings.value

fun allocate() {
    gcCollect()
    var i: Int = 0
    while (i < 40) {
        val payload = Payload(i)
        assertEquals(i, payload.value)
        i += 1
    }
}

fun main() {
    val payload = Payload(73)
    val assertionSite = SourceLocation("assertion.scoop", 7, 9, "assertion", "Case")
    val bodySite = SourceLocation("body.scoop", 11, 3, "body", "Case")
    val cleanupSite = SourceLocation("cleanup.scoop", 21, 3, "after", "Case")
    val result = context(Settings(4)) {
        runTestCase {
            val initialized = Payload(1)
            TestActions(TestAction({
                assertEquals(1, initialized.value)
                assertEquals(4, readSetting())
                context(Settings(9)) {
                    assertEquals(9, readSetting())
                    assertEquals(1, 2, Some("original failure"), assertionSite)
                }
            }, bodySite), after = Some(TestAction({
                assertEquals(4, readSetting())
                allocate()
                throw CleanupFailure(payload)
            }, cleanupSite)))
        }
    }
    allocate()
    when (result) {
        case TestResult.Passed -> fail(Some("expected both failures"))
        case TestResult.Failed(_, None) -> fail(Some("missing cleanup failure"))
        case TestResult.Failed(first, Some(second)) -> {
            assertTrue(first.phase == TestPhase.Body)
            assertTrue(first.location == assertionSite)
            val cause = first.cause
            assertTrue(cause is AssertionFailure)
            if (cause is AssertionFailure) {
                assertEquals("assertEquals", cause.kind)
                assertTrue(cause.message == Some("original failure"))
                assertTrue(when (cause.expected) {
                    case AssertionValue.Text(text) -> text == "1"
                    else -> false
                })
                assertTrue(when (cause.actual) {
                    case AssertionValue.Text(text) -> text == "2"
                    else -> false
                })
            }
            assertTrue(second.phase == TestPhase.AfterTest)
            assertTrue(second.location == cleanupSite)
            val secondCause = second.cause
            assertTrue(secondCause is CleanupFailure)
            if (secondCause is CleanupFailure) {
                assertSame(payload, secondCause.payload)
                assertEquals(73, secondCause.payload.value)
            }
        }
    }
    val normalAction = TestAction({ allocate() })
    assertEquals("main", normalAction.location.functionName)
    assertTrue(normalAction.location.line > 0)
    println("lifecycle retention passed")
}
