package dev.m43
import scoop.test.*
import scoop.test.execution.*

class Trace {
    var events: Int = 0
    var instances: Int = 0
    fun record(event: Int) { events = events * 10 + event }
}

class Case(val trace: Trace) {
    var state: Int = 0
    init { trace.instances += 1; trace.record(1) }
    fun before() { assertEquals(0, state); state = 1; trace.record(2) }
    fun body() { assertEquals(1, state); state = 2; trace.record(3) }
    fun after() { assertEquals(2, state); state = 3; trace.record(4) }
}

fun passed(result: TestResult) {
    when (result) {
        case TestResult.Passed -> return
        case TestResult.Failed(error, _) -> throw error.cause
    }
}

fun runCase(trace: Trace) {
    val initialize: () -> TestActions = {
        val current = Case(trace)
        TestActions(TestAction({ current.body() }),
            Some(TestAction({ current.before() })), Some(TestAction({ current.after() })))
    }
    assertEquals(trace.instances * 1234, trace.events)
    passed(runTestCase(initialize = initialize))
}

fun main() {
    val trace = Trace()
    runCase(trace)
    assertEquals(1234, trace.events)
    runCase(trace)
    assertEquals(12341234, trace.events)
    assertEquals(2, trace.instances)

    trace.events = 0
    passed(runTestCase { trace.record(1); TestActions(TestAction({ trace.record(3) })) })
    assertEquals(13, trace.events)
    trace.events = 0
    passed(runTestCase {
        trace.record(1)
        TestActions(TestAction({ trace.record(3) }), before = Some(TestAction({ trace.record(2) })))
    })
    assertEquals(123, trace.events)
    trace.events = 0
    passed(runTestCase {
        trace.record(1)
        TestActions(TestAction({ trace.record(3) }), after = Some(TestAction({ trace.record(4) })))
    })
    assertEquals(134, trace.events)
    println("lifecycle order passed")
}
