import bridge.*
fun main() {
    println(read())
    println(read(Code.Cold))
    println(forwarded(Token<String>.High))
    val value: Any = keep(boxed(Code.Cold))
    println(value is Code)
    println(value is Int16)
    println(value as Int16)
    println(describe(value as Code))
    println(less(Code.Cold, 0))
    val equality: Equals<Int16> = Code.Hot
    println(equality.equals(13))
    val text: ToString = Code.Hot
    println(text.toString())
    val tokens = Array(2) { _: Long -> Token<Int>.High }
    gcCollect()
    println(forwarded(tokens[1]))
    println(sizeOf<Packet>())
    println(localCode("local"))
}
