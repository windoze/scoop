import scoop.asyncio.*
import scoop.platform.io.*
import scoop.platform.memory.NativeByteBuffer
import scoop.platform.net.*
import scoop.tls.*
import scoop.tls.asyncio.AsyncTlsStream

fun synchronousIdentity(port: Int, version: TlsVersion) {
    identityContext(version).use { context ->
        TlsStream.takeOwnershipAsClient(TcpStream.connect(SocketAddress(IpAddress.IPV4_LOOPBACK, port)),
            context, TlsPeerName.Dns("localhost")).use { stream ->
            context.close()
            check(stream.connectionInfo.version == version)
            stream.writeAllBytes("mtls".toByteArray())
            NativeByteBuffer.allocate(4L).use { buffer ->
                stream.readFully(buffer)
                check(String.fromUtf8(buffer.readBytes(4L)) == "peer")
            }
            stream.shutdownGracefully()
        }
    }
}

fun asynchronousIdentity(port: Int, version: TlsVersion) {
    val context = identityContext(version)
    val loop: EventLoop = LibuvEventLoop()
    try {
        loop.run suspend { _ ->
            val raw = loop.connectTcp(SocketAddress(IpAddress.IPV4_LOOPBACK, port))
            val stream = AsyncTlsStream.takeOwnershipAsClient(raw, context, TlsPeerName.Dns("localhost"))
            try {
                context.close()
                check(stream.connectionInfo.version == version)
                NativeByteBuffer.allocate(4L).use suspend { buffer ->
                    buffer.writeBytes("mtls".toByteArray())
                    stream.writeFully(buffer)
                    buffer.clear()
                    stream.readFully(buffer, 4L)
                    check(String.fromUtf8(buffer.readBytes(4L)) == "peer")
                    stream.shutdownGracefully()
                }
            } finally { stream.close() }
        }
    } finally { context.close() }
}
