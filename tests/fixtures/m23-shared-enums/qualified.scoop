package consumer.enums
import upstream.enums.*
import upstream.enums.Choice as Selected

public enum Local<T> { Item(T) }
public struct Envelope<T>(val payload: T)

public fun <T> exercise(seed: T, read: (T) -> Int): Int {
    val selected = when (pack<T>(seed)) {
        Choice.Empty -> seed
        Selected.Item(payload) -> payload
        upstream.enums.Choice.Named { payload, .. } -> payload
        Choice.Defaults { payload, .. } -> payload
    }
    val wrapped = Local.Item(Envelope<T>(selected))
    return when (wrapped) {
        consumer.enums.Local.Item(consumer.enums.Envelope(payload)) -> read(payload)
    }
}

public fun result(): Int {
    val selected: IntChoice = Selected.Named(payload = 40, amount = 2)
    val number = when (selected) {
        upstream.enums.IntChoice.Empty -> 0
        IntChoice.Item(payload) -> payload
        upstream.enums.IntChoice.Named { amount, payload } -> payload + amount
        IntChoice.Defaults { payload, amount } -> payload + amount
    }
    return exercise<Int>(number, { value -> value })
}
