package consumer.enums
import upstream.enums.*

public enum Carrier<T> { Vacant, Wrapped(Choice<T>, T?) }

public fun <T> selected(value: Carrier<T>, fallback: T, result: T = when (value) {
    Vacant -> fallback
    Wrapped(choice, Some(payload)) -> select<T>(choice, payload)
    Wrapped(choice, None) -> select<T>(choice, fallback)
}): T = result

public fun <T> exercise(seed: T, read: (T) -> Int): Int {
    val choice: Choice<T> = Choice.Defaults(seed)
    val value: Carrier<T> = Carrier.Wrapped(choice, Some(seed))
    if (read(selected<T>(value, seed)) != 42) { return 1 }
    return when (value) {
        Vacant -> 2
        Wrapped(Defaults { payload, amount }, Some(extra)) if (amount == 2) -> {
            if (read(extra) != 42) { return 3 }
            read(payload)
        }
        Wrapped(_, _) -> 4
    }
}

public fun result(): Int = exercise<Int>(42, { value -> value })
