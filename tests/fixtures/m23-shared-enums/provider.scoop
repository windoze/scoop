package upstream.enums

public enum Choice<T> {
    Empty,
    Item(T),
    Named { payload: T, amount: Int },
    Defaults(val payload: T, val amount: Int = 2)
}

public fun <T> select(value: Choice<T>, fallback: T, selected: T = when (value) {
    case Empty -> fallback
    case Item(payload) -> payload
    case Named { payload, .. } -> payload
    case Defaults { payload, .. } -> payload
}): T = selected

public fun <T> pack(value: T): Choice<T> = Choice.Item(value)
public fun <T> score(value: Choice<T>, read: (T) -> Int): Int = when (value) {
    case Empty -> 0
    case Item(payload) -> read(payload)
    case Named { payload, amount } -> read(payload) + amount
    case Defaults { payload, amount } -> read(payload) + amount
}

public typealias IntChoice = Choice<Int>
public typealias TextChoice = Choice<String>
