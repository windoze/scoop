package provider
public interface Source<T> {
    public fun get(): T
    public fun echo(value: T): T = value
    public val current: T get() = get()
    public fun tagged(prefix: String = "default"): String = prefix
}
public class Impl<T> public constructor(public val item: T) : Source<T> {
    public override fun get(): T = item
}
public open class Wrapped<T> public constructor(delegate: Source<T>) : Source<T> by delegate
public abstract class Base<T> public constructor() { public abstract fun get(): T }
public interface Number { public var number: Int }
public open class GetterBase public constructor() { public open val number: Int get() = 5 }
public class NumberImpl public constructor(public var state: Int) : Number {
    public override var number: Int
        get() = state
        set(value) { state = value }
}
public object Default : Number by NumberImpl(6)
public class Owner<T> { public companion object : Number by NumberImpl(7) }
