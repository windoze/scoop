class Pair<A, B>(val first: A, val second: B)
typealias Row<T> = Pair<String, T>
fun <T> build(value: T): T {
    typealias Local<U> = Pair<T, U>
    val make: (T, Int) -> Local<Int> = ::Local
    return make(value, 42).first
}
class Choice<T>(val first: T, val n: Int) {
    constructor(first: T, n: Any): this(first, 1) {}
}
typealias Pick<T> = Choice<T>
fun <T> choose(value: T): Int {
    typealias Local = Choice<T>
    val make: (T, Int) -> Local = ::Local
    return make(value, 42).n
}
fun main() {
    val make: (String, Int) -> Row<Int> = ::Row
    println(make("reference", 42).second)
    println(build("captured"))
    println(choose("owner"))
    val pick: (String, Int) -> Pick<String> = ::Pick
    println(pick("generic", 42).n)
}
