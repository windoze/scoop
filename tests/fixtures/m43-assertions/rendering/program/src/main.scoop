import scoop.test.*

class Calls { var rendered: Int = 0 }
class RenderFailure : Throwable()
class CompareFailure : Throwable()
class Value(val id: Int, val calls: Calls, val broken: Boolean) : Equals<Value>, ToString {
    public override operator fun equals(other: Value): Boolean = id == other.id
    public override fun toString(): String {
        calls.rendered += 1
        if (broken) throw RenderFailure()
        return f"value ${id}"
    }
}
class BrokenComparison : Equals<BrokenComparison> {
    public override operator fun equals(other: BrokenComparison): Boolean { throw CompareFailure() }
}

fun verify(condition: Boolean, message: String) {
    if (!condition) {
        println(message)
        throw Exception(Some(message))
    }
}

fun main() {
    val calls = Calls()
    assertEquals(Value(1, calls, true), Value(1, calls, true))
    verify(calls.rendered == 0, "successful assertions do not render values")
    val error = assertFailsWith<AssertionFailure> {
        assertEquals(Value(1, calls, true), Value(2, calls, false), Some("original failure"))
    }
    verify(error.kind == "assertEquals" && error.message == Some("original failure"), "preserve original failure")
    verify(when (error.expected) { case AssertionValue.RenderingFailed(cause) -> cause is RenderFailure; else -> false }, "preserve rendering exception")
    verify(when (error.actual) { case AssertionValue.Text(text) -> text == "value 2"; else -> false }, "render the other value")
    verify(calls.rendered == 2, "render each failed value once")
    assertFailsWith<CompareFailure> { assertEquals(BrokenComparison(), BrokenComparison()) }
    gcCollect()
    verify(when (error.expected) { case AssertionValue.RenderingFailed(cause) -> cause is RenderFailure; else -> false }, "keep rendering exception alive")
    println("rendering assertions passed")
}
