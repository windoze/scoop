import scoop.test.*

fun verify(condition: Boolean) {
    if (!condition) throw Exception(Some("location assertion contract"))
}

fun helper(location: SourceLocation = getCurrentSourceLocation()) {
    assertTrue(false, location = location)
}

fun main() {
    val expected = getCurrentSourceLocation()
    val direct = assertFailsWith<AssertionFailure> { assertTrue(false) }
    verify(direct.location.file == expected.file)
    verify(direct.location.line == expected.line + 1L)
    val forwarded = getCurrentSourceLocation()
    val indirect = assertFailsWith<AssertionFailure> { helper() }
    verify(indirect.location.file == forwarded.file)
    verify(indirect.location.line == forwarded.line + 1L)
    val supplied = SourceLocation("explicit.scoop", 9L, 11L, "check", "Container")
    val explicit = assertFailsWith<AssertionFailure> { assertEquals(1, 2, location = supplied) }
    verify(explicit.location == supplied)
    println("location assertions passed")
}
