import m33.utf8.*

struct Result(val value: String, val count: Long)
fun expect(value: Boolean) { if (!value) { throw IllegalStateException() } }

fun main() {
    val result = decodeThen([231.toInt8(), 149.toInt8(), 140.toInt8(), 0.toInt8()], fun(value: String): Result {
        gcCollect()
        return Result(value, value.length)
    })
    gcCollect()
    expect(result.value == "界\u0000" && result.count == 2L)
    expect(failureOffset([65.toInt8(), 225.toInt8(), 128.toInt8()]) == 1L)
    expect(recover([225.toInt8(), 128.toInt8(), 65.toInt8()]) == "�A")
    expect(String.fromUtf8OrNone([239.toInt8(), 191.toInt8(), 189.toInt8()]) == Some("�"))
    println("utf8-artifacts-ok")
}
