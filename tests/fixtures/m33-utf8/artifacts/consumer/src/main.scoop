import m33.utf8.*

struct Result(val value: String, val count: Long)
fun expect(value: Boolean) { if (!value) { throw IllegalStateException() } }

fun main() {
    val result = decodeThen([231.toByte(), 149.toByte(), 140.toByte(), 0.toByte()], fun(value: String): Result {
        gcCollect()
        return Result(value, value.length)
    })
    gcCollect()
    expect(result.value == "界\u0000" && result.count == 2L)
    expect(failureOffset([65.toByte(), 225.toByte(), 128.toByte()]) == 1L)
    expect(recover([225.toByte(), 128.toByte(), 65.toByte()]) == "�A")
    expect(String.fromUtf8OrNull([239.toByte(), 191.toByte(), 189.toByte()]) == Some("�"))
    println("utf8-artifacts-ok")
}
