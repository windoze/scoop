package m33.utf8

public fun <R> decodeThen(bytes: List<Byte>, block: (String) -> R): R =
    block(String.fromUtf8(bytes))

public fun recover(bytes: List<Byte>): String = String.fromUtf8Lossy(bytes)

public fun failureOffset(bytes: List<Byte>): Long {
    try {
        val value = String.fromUtf8(bytes)
        return -1L
    } catch (error: CharacterCodingException) {
        return error.byteOffset
    }
}
