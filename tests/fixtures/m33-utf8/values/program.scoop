fun expect(value: Boolean) { if (!value) { throw IllegalStateException() } }

fun valid(bytes: Array<Byte>, text: String, scalars: Long) {
    val strict = String.fromUtf8(bytes)
    val optional = String.fromUtf8OrNone(bytes)
    val replaced = String.fromUtf8Lossy(bytes)
    gcCollect()
    expect(strict == text && optional == Some(text) && replaced == text)
    expect(strict.length == scalars && strict.byteLength == bytes.size)
    expect(replaced.byteLength == bytes.size)
}

fun invalid(bytes: Array<Byte>, offset: Long, text: String) {
    var caught = false
    try {
        val unexpected = String.fromUtf8(bytes)
        expect(unexpected.byteLength < 0L)
    } catch (error: CharacterCodingException) {
        gcCollect()
        expect(error.byteOffset == offset)
        caught = true
    }
    expect(caught && String.fromUtf8OrNone(bytes) == None)
    val replaced = String.fromUtf8Lossy(bytes)
    gcCollect()
    expect(replaced == text && replaced.byteLength == text.byteLength)
}

fun main() {
    valid([], "", 0L)
    valid([65.toInt8(), 0.toInt8(), 66.toInt8()], "A\u0000B", 3L)
    valid([194.toInt8(), 128.toInt8(), 223.toInt8(), 191.toInt8()], "\u0080\u07FF", 2L)
    valid([224.toInt8(), 160.toInt8(), 128.toInt8(), 237.toInt8(), 159.toInt8(), 191.toInt8(), 238.toInt8(), 128.toInt8(), 128.toInt8()], "\u0800\uD7FF\uE000", 3L)
    valid([240.toInt8(), 144.toInt8(), 128.toInt8(), 128.toInt8(), 244.toInt8(), 143.toInt8(), 191.toInt8(), 191.toInt8()], "\u{10000}\u{10FFFF}", 2L)
    valid([239.toInt8(), 191.toInt8(), 189.toInt8(), 101.toInt8(), 204.toInt8(), 129.toInt8()], "�e\u0301", 3L)
    expect(String.fromUtf8([101.toInt8(), 204.toInt8(), 129.toInt8()]) != "é")

    invalid([65.toInt8(), 128.toInt8(), 66.toInt8()], 1L, "A�B")
    invalid([128.toInt8(), 128.toInt8()], 0L, "��")
    invalid([192.toInt8(), 175.toInt8()], 0L, "��")
    invalid([224.toInt8(), 159.toInt8(), 191.toInt8()], 0L, "���")
    invalid([237.toInt8(), 160.toInt8(), 128.toInt8()], 0L, "���")
    invalid([240.toInt8(), 143.toInt8(), 191.toInt8(), 191.toInt8()], 0L, "����")
    invalid([244.toInt8(), 144.toInt8(), 128.toInt8(), 128.toInt8()], 0L, "����")
    invalid([245.toInt8(), 128.toInt8(), 128.toInt8(), 128.toInt8()], 0L, "����")
    invalid([255.toInt8(), 65.toInt8()], 0L, "�A")
    invalid([194.toInt8()], 0L, "�")
    invalid([225.toInt8(), 128.toInt8()], 0L, "�")
    invalid([240.toInt8(), 144.toInt8(), 128.toInt8()], 0L, "�")
    invalid([225.toInt8(), 128.toInt8(), 65.toInt8()], 0L, "�A")
    invalid([241.toInt8(), 128.toInt8(), 128.toInt8(), 65.toInt8()], 0L, "�A")
    invalid([194.toInt8(), 162.toInt8(), 0.toInt8(), 225.toInt8(), 128.toInt8(), 65.toInt8(), 239.toInt8(), 191.toInt8(), 189.toInt8()], 3L, "¢\u0000�A�")
    println("utf8-values-ok")
}
