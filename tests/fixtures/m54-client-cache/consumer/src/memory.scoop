import scoop.asyncio.*
import scoop.collections.emptyList
import scoop.http.*
import scoop.http.client.*
import scoop.test.*

internal suspend fun cacheMemoryRules() {
    val cache = MemoryHttpCache(maxBytes = 12L, maxEntryBytes = 8L, maxEntries = 2L)
    val a = cacheRequest("/a")
    val b = cacheRequest("/b")
    val c = cacheRequest("/c")
    assertEquals(0L, cache.entryCount)
    val writing = cache.begin(cacheRecord(a, 3L))!!
    cacheWrite(writing, "abc")
    assertFalse(cachePresent(cache.lookup(a)))
    writing.commit([cacheField("Checksum", "accepted")]); writing.close(); writing.close()
    val old = cache.lookup(a)!!
    assertEquals(3L, old.bodyLength)
    assertTrue(old.trailers[0L].hasName("Checksum".toByteArray()))
    cacheStore(cache, b, "bbbb")
    assertEquals(Some("abc"), cacheRead(cache, a))
    cacheStore(cache, c, "ccccc")
    assertFalse(cachePresent(cache.lookup(b)))
    assertEquals(8L, cache.sizeBytes)
    cacheStore(cache, a, "updated")
    assertEquals("abc", String.fromUtf8(old.body.readAllBytes(20L)))
    old.close()
    assertEquals(Some("updated"), cacheRead(cache, a))
    assertFalse(cachePresent(cache.begin(cacheRecord(b, 9L))))
    val abandoned = cache.begin(cacheRecord(b, 4L))!!
    cacheWrite(abandoned, "bbb"); abandoned.close()
    assertFalse(cachePresent(cache.lookup(b)))
    val invalid = cache.begin(cacheRecord(b, 4L))!!
    var rejected = false
    try { cacheWrite(invalid, "bbb"); invalid.commit(emptyList<HttpField>()) }
    catch (_: IllegalStateException) { rejected = true }
    finally { invalid.close() }
    assertTrue(rejected)
    val pending = cache.begin(cacheRecord(b, 4L))!!
    cacheWrite(pending, "bbbb")
    cache.invalidate("tests", "https://example.com/b")
    pending.commit(emptyList<HttpField>()); pending.close()
    assertFalse(cachePresent(cache.lookup(b)))
    val clearing = cache.begin(cacheRecord(c, 4L))!!
    cacheWrite(clearing, "cccc"); cache.clear(); clearing.commit(emptyList<HttpField>()); clearing.close()
    assertEquals(0L, cache.entryCount)
    assertEquals(0L, cache.sizeBytes)
}

internal suspend fun cacheVaryRules() {
    val cache = MemoryHttpCache()
    val a = cacheRequest(fields = [cacheField("X-Mode", "a"), cacheField("X-Mode", "bc")])
    val b = cacheRequest(fields = [cacheField("X-Mode", "ab"), cacheField("X-Mode", "c")])
    val missing = cacheRequest()
    val empty = cacheRequest(fields = [cacheField("X-Mode", "")])
    val vary = [cacheField("Vary", "X-Mode, x-mode")]
    val record = cacheRecord(a, 1L, vary)
    assertEquals(1L, record.vary.size)
    assertEquals("x-mode", record.vary[0L].name)
    assertTrue(record.matches(a)); assertFalse(record.matches(b))
    assertFalse(record.matches(cacheRequest(partition = "other")))
    assertFalse(record.matches(cacheRequest(identity = "user")))
    cacheStore(cache, a, "a", vary)
    cacheStore(cache, b, "b", vary)
    cacheStore(cache, missing, "missing", vary)
    cacheStore(cache, empty, "empty", vary)
    assertEquals(4L, cache.entryCount)
    assertEquals(Some("a"), cacheRead(cache, a))
    assertEquals(Some("b"), cacheRead(cache, b))
    assertEquals(Some("missing"), cacheRead(cache, missing))
    assertEquals(Some("empty"), cacheRead(cache, empty))
    cacheStore(cache, a, "all")
    assertEquals(1L, cache.entryCount)
    assertEquals(Some("all"), cacheRead(cache, b))
    var wildcard = false
    try { cacheRecord(a, 0L, [cacheField("Vary", "*")]) }
    catch (_: IllegalArgumentException) { wildcard = true }
    assertTrue(wildcard)
    cache.invalidate("other", "https://example.com/item")
    assertEquals(1L, cache.entryCount)
    cache.invalidate("tests", "https://example.com/item")
    assertEquals(0L, cache.entryCount)
}
