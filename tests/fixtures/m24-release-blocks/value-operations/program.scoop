@Extern(lib = "m24_release", name = "m24_release_add")
private fun record(value: Int)

@Extern(lib = "m24_release", name = "m24_release_count")
private fun count(): Int

struct Parts(val first: Int, val second: Int) {
    @NoGC operator fun plus(other: Parts): Parts =
        Parts(first + other.first, second + other.second)
    @NoGC operator fun get(index: Int, extra: Int = 3): Int = index + extra
}

@NoGC private fun even(value: Int): Int {
    if (value == 0) { return 0 }
    return odd(value - 1)
}

@NoGC private fun odd(value: Int): Int = even(value)
@NoGC private fun Parts.extra(): Int = this[0]

struct Node(val next: Option<Ptr<Node>>, val value: Int)

class RecursiveOwner(private val node: Node) {
    release { val copied = node }
}

class Owner(private val parts: Parts) {
    release {
        val combined = parts + Parts(1, 2)
        val (first, second) = combined
        var total = first + second + combined.extra() + even(3)
        var remaining = 3
        @Unsafe {
            val pointer = addressOf(remaining)
            while (pointer.load() > 0) {
                total += pointer.load()
                pointer.store(pointer.load() - 1)
            }
            record(total)
        }
    }
}

private fun allocate() {
    val owner = Owner(Parts(10, 20))
    val recursive = RecursiveOwner(Node(None, 1))
}

fun main() {
    allocate()
    gcCollect()
    gcCollect()
    @Unsafe { println(count()) }
}
