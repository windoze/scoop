class Gate(var waiter: Continuation<Int>?) {}
class Registration(val gate: Gate) : SuspendRegistration<Int> {
    public override fun register(continuation: Continuation<Int>) { gate.waiter = Some(continuation) }
}
class Outer(val text: String, val gate: Gate) {
    inner class Task : SuspendTask<Int> {
        public override suspend fun run(): Int {
            val reference: () -> Outer.Task = ::Task
            val result = suspendCoroutine(Registration(gate))
            gcCollect()
            println(text)
            println(reference().same(this@Outer))
            return result
        }
        fun same(outer: Outer): Boolean = this@Outer === outer
    }
}
class Completion : Continuation<Int> {
    public override fun resume(value: Int) { println(value) }
    public override fun resumeWithException(exception: Throwable) { println("failed") }
}
fun main() {
    val gate = Gate(None)
    startCoroutine(Outer("retained", gate).Task(), Completion())
    println("suspended")
    gcCollect()
    val continuation = gate.waiter!!
    gate.waiter = None
    continuation.resume(42)
}
