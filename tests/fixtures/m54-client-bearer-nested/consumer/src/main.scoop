import scoop.asyncio.*
import scoop.crypto.testdata.rootPem
import scoop.crypto.x509.TrustStore
import scoop.http.*
import scoop.http.asyncio.AsyncHttp1Connection
import scoop.http.client.*
import scoop.platform.concurrent.Thread
import scoop.tls.TlsTrustSource

private fun exercise(trust: TrustStore) {
    withBearerRuntime suspend { _, scope, listener ->
        val url = bearerUrl(listener)
        val holder = BearerClientHolder()
        val entered = BearerGate()
        val release = BearerGate()
        val loads = AtomicLong(0L)
        val refreshes = AtomicLong(0L)
        val bypass = HttpCallOptions(authentication = Some(HttpAuthenticationOptions()))
        val provider = HttpAuthenticator.bearer(url.httpOrigin(), refreshTokens = suspend { rejected ->
            refreshes.fetchAdd(1L)
            bearerCheck(bearerContext() == "outer" && rejected.tokens.refreshToken == Some("local"))
            val access = holder.value!!.withResponse(HttpRequest.post(url.resolve("/refresh"),
                RequestBody.fromText(rejected.tokens.refreshToken!!), options = bypass)) suspend { response ->
                bearerCheck(response.authenticationCount == 0L)
                response.body.text(3L)
            }
            Some(HttpBearerTokens(access))
        }) suspend { _ ->
            loads.fetchAdd(1L)
            bearerCheck(bearerContext() == "outer")
            val access = holder.value!!.withResponse(HttpRequest.get(url.resolve("/load"), options = bypass)) suspend { response ->
                bearerCheck(response.authenticationCount == 0L)
                response.body.text(3L)
            }
            HttpBearerTokens(access, Some("local"))
        }
        val serving = scope.launch suspend {
            val completed = AtomicLong(0L)
            while (completed.load() < 2L) {
                AsyncHttp1Connection.takeOwnershipAsServer(listener.accept(), scope).useAsync suspend { connection ->
                    val request = connection.receiveRequest()!!
                    val path = when (request.head.target) {
                        case Http1(value) -> String.fromUtf8(value)
                        else -> throw IllegalStateException()
                    }
                    if (path == "/load" || path == "/refresh") {
                        bearerCheck(!bearerPresent(bearerToken(request.head)))
                        val body = String.fromUtf8(request.body.readAllBytes(5L))
                        bearerCheck(body == if (path == "/load") "" else "local")
                        if (path == "/load") { entered.signal(); release.await() }
                        bearerRespond(connection, 200U, if (path == "/load") "old" else "new")
                    } else {
                        request.body.readAllBytes(0L)
                        val token = bearerToken(request.head)
                        if (token == Some("old")) bearerRespond(connection, 401U,
                            extra = [bearerField("WWW-Authenticate", "Bearer error=\"invalid_token\"")])
                        else {
                            bearerCheck(token == Some("new"))
                            bearerRespond(connection, 200U, "done"); completed.fetchAdd(1L)
                        }
                    }
                }
            }
        }
        val config = HttpClientConfig(tls = HttpClientTlsConfig(TlsTrustSource.Store(trust)),
            authentication = HttpAuthenticationOptions([provider]), retries = HttpRetryOptions(maxRetries = 0L),
            pool = HttpConnectionPoolOptions(maxConnectionsPerOrigin = 1L))
        try {
            withHttpClient(config) suspend { client ->
                holder.value = Some(client)
                context(BearerContext("outer")) {
                    val first = scope.async<Unit> suspend {
                        client.withResponse(HttpRequest.get(url)) suspend { response ->
                            bearerCheck(response.authenticationCount == 1L && response.body.text(4L) == "done")
                        }
                    }
                    entered.await()
                    val second = scope.async<Unit> suspend {
                        client.withResponse(HttpRequest.get(url.resolve("other"))) suspend { response ->
                            bearerCheck(response.authenticationCount == 1L && response.body.text(4L) == "done")
                        }
                    }
                    bearerCheck(loads.load() == 1L)
                    release.signal(); first.await(); second.await()
                }
            }
        } finally { release.signal() }
        serving.join()
        bearerCheck(loads.load() == 1L && refreshes.load() == 1L)
    }
}

fun main() {
    TrustStore.fromPem(rootPem()).use { trust ->
        Thread.start { exercise(trust) }.use { thread -> exercise(trust); thread.join() }
    }
    println("nested Bearer token requests passed")
}
