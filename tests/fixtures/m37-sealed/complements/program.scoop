sealed interface Root<T> {}
class Entry<T, U>(val value: U) : Root<T>
fun classify(value: Root<Int>): Int = when (value) {
    !is Entry<Int, String> -> 1
    !is Entry<Int, Int> -> 2
}
sealed interface Middle<A, B> : Root<A> {}
class Leaf<X, Y>(val value: Y) : Middle<X, Y>
interface Tagged {}
sealed interface Nested<A, B> : Root<A>, Tagged {}
class Item<X, Y>(val value: Y) : Nested<X, Y>
fun <T> generic(value: Root<T>): Int = when (value) {
    is Middle<T, Int> -> 3
    !is Middle<T, Int> -> 4
}
class Matcher {
    operator fun contains(value: Root<Int>): Boolean { println("contains"); return false }
}
fun mixed(value: Root<Int>): Int = when (value) {
    !is Entry<Int, String>, in (if (true) { println("matcher"); Matcher() } else Matcher()) -> 1
    !is Entry<Int, Int> -> 2
}
fun main() {
    println(classify(Entry<Int, String>("x")))
    println(classify(Entry<Int, Int>(42)))
    println(classify(Entry<Int, Boolean>(true)))
    println(generic(Leaf<Int, Int>(42)))
    println(generic(Item<Int, String>("x")))
    println(mixed(Entry<Int, String>("x")))
    println(mixed(Entry<Int, Int>(42)))
}
