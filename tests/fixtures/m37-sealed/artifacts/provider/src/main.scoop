package provider
public sealed interface Result<T> {}
public class Success<T> public constructor(public val value: T) : Result<T>
public class Failure<T> public constructor(public val code: Int) : Result<T>
public sealed class State protected constructor() {}
public class Ready public constructor() : State()
private class Hidden : State()
public fun state(hidden: Boolean): State = if (hidden) Hidden() else Ready()
public fun make(value: Int): Result<Int> = Success(value)
public fun <T> classify(value: Result<T>): Int = when (value) {
    is Success<T> -> 1
    is Failure<T> -> 2
}
public fun defaultClassify(value: Int = when (make(9)) {
    is Success<Int> -> 9
    is Failure<Int> -> 0
}): Int = value
