import scoop.asyncio.*
import scoop.http.HttpProtocol
import scoop.http.client.*
import scoop.platform.memory.NativeByteBuffer
import scoop.time.Duration
import scoop.url.Url

internal suspend fun idleBackground(client: HttpClient, url: Url, loop: EventLoop, scope: CoroutineScope) {
    val delivered = IdleSignal()
    val queued = IdleSignal()
    val cleanup = AtomicBoolean(false)
    val release = IdleSignal()
    val body = RequestBody.fromProducer(Some(6L)) suspend { output ->
        delivered.await()
        try {
            NativeByteBuffer.allocate(6L).use suspend { buffer ->
                buffer.writeBytes("queued".toByteArray()); output.writeFully(buffer)
            }
            queued.signal()
            loop.sleep(Duration.seconds(60L))
            idleCheck(false)
        } finally { cleanup.store(true); release.await() }
    }
    try {
        val options = HttpCallOptions(duplex = true, timeouts = Some(HttpTimeoutOptions(writeIdle = Some(idleLimit()))))
        val response = client.execute(HttpRequest.post(url, body, options = options))
        idleCheck(response.status == 200U)
        delivered.signal(); queued.await()
        loop.sleep(idleLimit() + Duration.milliseconds(100L))
        idleCheck(cleanup.load())
        val following = scope.async suspend { client.execute(HttpRequest.get(url)) }
        loop.sleep(Duration.milliseconds(20L))
        idleCheck(!following.isCompleted)
        release.signal()
        val next = following.await()
        idleCheck(next.status == 204U && next.body.bytes(0L).size == 0L)
        next.close()
        val error = idleFailure suspend { response.close() }
        idleCause(error, HttpTimeoutPhase.WriteIdle, HttpProtocol.Http2, 1, sent = 6L)
        response.close()
    } finally { release.signal(); delivered.signal() }
}
