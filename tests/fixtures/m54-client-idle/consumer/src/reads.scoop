import scoop.asyncio.*
import scoop.http.*
import scoop.http.client.*
import scoop.platform.time.MonotonicTimeSource
import scoop.platform.time.elapsedNow
import scoop.time.Duration
import scoop.url.Url

private fun readOptions(): HttpCallOptions =
    HttpCallOptions(timeouts = Some(HttpTimeoutOptions(readIdle = Some(idleLimit()))))

internal suspend fun idleProgress(client: HttpClient, url: Url, loop: EventLoop) {
    val started = MonotonicTimeSource.markNow()
    val response = client.execute(HttpRequest.get(url, options = readOptions()))
    idleCheck(response.status == 200U && started.elapsedNow() > idleLimit())
    loop.sleep(idleLimit() + Duration.milliseconds(100L))
    idleCheck(response.body.text(3L) == "abc")
    response.close()
}

internal suspend fun idleGzip(client: HttpClient, url: Url) {
    val response = client.execute(HttpRequest.post(url, RequestBody.fromText("send"), options = readOptions()))
    idleCheck(response.status == 200U && response.wireContentLength!! > 8L)
    val error = idleFailure suspend { response.body.bytes(7L); Unit }
    idleCause(error, HttpTimeoutPhase.ReadIdle, HttpProtocol.Http1, 0,
        sent = 4L, encoded = response.wireContentLength!! - 8L, received = 7L)
    response.close()
}

internal suspend fun idleIsolation(client: HttpClient, url: Url, scope: CoroutineScope) {
    val waiting = scope.async<HttpTimeoutException> suspend {
        idleFailure suspend { client.execute(HttpRequest.get(url, options = readOptions())); Unit }
    }
    val second = client.execute(HttpRequest.get(url))
    idleCheck(second.status == 200U)
    val error = waiting.await()
    idleCause(error, HttpTimeoutPhase.ReadIdle, HttpProtocol.Http2, 1)
    val bytes = second.body.bytes(1024L)
    idleCheck(bytes.size > 0L)
    for (byte in bytes) idleCheck(byte == 120.toByte())
    second.close()
    client.withResponse(HttpRequest.get(url)) suspend { response ->
        idleCheck(response.status == 204U && response.body.bytes(0L).size == 0L)
    }
}

internal suspend fun idleUpgrade(client: HttpClient, url: Url) {
    val error = idleFailure suspend {
        client.execute(HttpRequest.post(url, RequestBody.fromText("send"), options = readOptions())); Unit
    }
    idleCause(error, HttpTimeoutPhase.ReadIdle, HttpProtocol.Http2, 1, sent = 4L)
    client.withResponse(HttpRequest.get(url)) suspend { response ->
        idleCheck(response.version == HttpVersion.Http2 && response.status == 204U)
        idleCheck(response.body.bytes(0L).size == 0L)
    }
}
