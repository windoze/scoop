fun updateLists() {
    val values = ArrayList<Int>()
    values.add(10)
    values.add(20)
    val indices = ArrayList<Long>()
    indices.add(0L)
    val view: MutableList<Int> = values
    view[indices[0L]++] += 3
    check(indices[0L] == 1L && values[0L] == 13)
    check(view[indices[0L]]++ == 20)
    check(++values[0L] == 14 && values[1L] == 21)
    val index = 1L
    values[index] *= 2
    check(values[index] == 42)
}
