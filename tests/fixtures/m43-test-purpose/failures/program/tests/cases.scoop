import scoop.test.*

private var serial: Int = 0
private fun next(): Int {
    serial += 1
    println(f"init ${serial}")
    if (serial == 1) { throw IllegalArgumentException() }
    return serial
}

@Test
class Cases private constructor(val id: Int = next()) {
    @BeforeTest
    fun prepare() {
        println(f"before ${id}")
        if (id == 2) { throw IllegalArgumentException() }
    }

    @AfterTest
    fun cleanup() {
        println(f"after ${id}")
        if (id == 3 || id == 4) { fail(Some("cleanup")) }
    }

    @Test
    fun initializationFails() { println("must not reach initialization body") }

    @Test
    fun preparationFails() { println("must not reach preparation body") }

    @Test
    fun bodyFails() { println("body 3"); fail(Some("body")) }

    @Test
    fun cleanupFails() { println("body 4") }

    @Test
    fun executionContinues() { assertEquals(5, id); println("body 5") }
}
