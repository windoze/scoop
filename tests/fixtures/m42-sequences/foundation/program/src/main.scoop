import scoop.sequences.*
import scoop.collections.joinToString

class State { var opens: Int = 0; var reads: Int = 0 }
class Source(private val state: State) : Iterable<Int> {
    public override operator fun iterator(): Iterator<Int> { state.opens += 1; return Items(state) }
}
class Items(private val state: State) : Iterator<Int> {
    private var index: Int = 0
    public override fun next(): Int? {
        state.reads += 1
        if (index == 2) return None
        index += 1
        return Some(index)
    }
}
fun check(value: Boolean, label: String) { if (!value) { println(label); throw Exception(Some(label)) } }

fun main() {
    check(emptySequence<Int>().toList().size == 0L, "empty")
    check(sequenceOf<Int>(1, 2, 3).toList().joinToString() == "1, 2, 3", "sequenceOf")
    var sum = 0
    for (value in sequenceOf<Int>(2, 3, 5)) sum += value
    check(sum == 10, "ordinary for protocol")
    val state = State()
    val source = Source(state).asSequence()
    val iterator = source.iterator()
    check(state.opens == 0 && state.reads == 0, "deferred iterator")
    check(iterator.next() == Some(1) && state.opens == 1 && state.reads == 1, "first pull")
    check(iterator.next() == Some(2) && iterator.next() == None && iterator.next() == None && state.reads == 3, "permanent exhaustion")
    check(source.toList().joinToString() == "1, 2" && state.opens == 2, "repeatable source")
    val calls = State()
    val generated = generateSequence<Int>(4) { previous -> calls.reads += 1; if (previous == 6) None else Some(previous + 1) }
    val first = generated.iterator()
    val second = generated.iterator()
    check(first.next() == Some(4) && second.next() == Some(4) && calls.reads == 0, "seed is not a callback")
    check(first.next() == Some(5) && first.next() == Some(6) && second.next() == Some(5) && calls.reads == 3, "independent iterator state")
    check(first.next() == None && first.next() == None && calls.reads == 4, "generator exhausted")
    val nested = generateSequence<Int?>(None) { previous -> when (previous) { case None -> Some(Some(7)); case Some(_) -> None } }.toList()
    check(nested.size == 2L && nested[0L] == None && nested[1L] == Some(7), "nested Option seed")
    val once: Iterator<Int> = Items(state)
    val onceSequence = once.asSequence()
    val reserved = onceSequence.iterator()
    var caught = false
    try { onceSequence.iterator() } catch (error: IllegalStateException) { caught = true }
    check(caught && reserved.next() == Some(1), "iterator reservation before consuming")
    val poll = State()
    val polling = generateSequence<Int> { poll.reads += 1; if (poll.reads == 1) Some(9) else None }
    check(polling.toList().joinToString() == "9" && poll.reads == 2, "polling generator")
    caught = false
    try { polling.iterator() } catch (error: IllegalStateException) { caught = true }
    check(caught && poll.reads == 2, "polling once only")
    println("sequences foundation passed")
}
