import scoop.sequences.*
import scoop.collections.joinToString
import scoop.comparisons.comparatorOf

class State { var opens: Int = 0; var reads: Int = 0; var keys: Int = 0 }
struct Item(val key: Int, val label: String)
class Source(private val state: State) : Iterable<Item> {
    public override operator fun iterator(): Iterator<Item> { state.opens += 1; return Rows(state) }
}
class Rows(private val state: State) : Iterator<Item> {
    private var index: Int = 0
    public override fun next(): Item? {
        state.reads += 1
        index += 1
        return when (index) { case 1 -> Some(Item(2, "a")); case 2 -> Some(Item(1, "b")); case 3 -> Some(Item(2, "c")); else -> None }
    }
}
fun check(value: Boolean, label: String) { if (!value) { println(label); throw Exception(Some(label)) } }
fun main() {
    val state = State()
    val sorted = Source(state).asSequence().sortedBy<Item, Int> { value -> state.keys += 1; value.key }
    val iterator = sorted.iterator()
    check(state.opens == 0 && state.reads == 0 && state.keys == 0, "sort deferred until next")
    check(iterator.next()!!.label == "b" && state.opens == 1 && state.reads == 4 && state.keys == 3, "first pull sorts all")
    check(iterator.next()!!.label == "a" && iterator.next()!!.label == "c" && iterator.next() == None && state.reads == 4 && state.keys == 3, "stable cached sorted iterator")
    check(sorted.map<Item, String> { value -> value.label }.joinToString() == "b, a, c" && state.opens == 2 && state.keys == 6, "independent sorted iterator")
    check(sequenceOf<Int>(3, 1, 2).sorted().joinToString() == "1, 2, 3" && sequenceOf<Int>(3, 1, 2).sortedDescending().joinToString() == "3, 2, 1", "natural order variants")
    val explicit = Source(state).asSequence().sortedWith(comparatorOf<Item> { a, b -> b.key.compareTo(a.key) })
    check(explicit.map<Item, String> { value -> value.label }.joinToString() == "a, c, b", "explicit stable reverse order")
    println("sequences sorting passed")
}
