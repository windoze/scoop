import scoop.asyncio.*
import scoop.platform.concurrent.Thread
import scoop.platform.fs.*
import scoop.platform.net.*

private fun check(value: Boolean) {
    if (!value) throw IllegalStateException(Some("asynchronous file control check failed"))
}

private fun transfer(parent: Path) {
    val directory = createTempDirectory(Some(parent), "文件 ")
    try {
        val source = directory.resolve(Path.fromString("source"))
        val destination = directory.resolve(Path.fromString("download"))
        val link = directory.resolve(Path.fromString("link"))
        source.writeText("abcdef")
        destination.writeText("abc stale data")
        link.createSymbolicLink(source)
        val loop: EventLoop = LibuvEventLoop()
        loop.run suspend { scope ->
            val listener = loop.listenTcp(SocketAddress(IpAddress.IPV4_LOOPBACK, 0))
            val connecting = scope.async<AsyncTcpStream> suspend { loop.connectTcp(listener.localAddress) }
            val server = listener.accept()
            val client = connecting.await()
            val sending = scope.async<Long> suspend {
                val count = loop.openFile(source).useAsync suspend { input ->
                    check(input.metadata().kind == FileKind.Regular)
                    input.seek(3L)
                    check(input.position() == 3L)
                    input.copyTo(server, 2L)
                }
                server.shutdownOutput()
                count
            }
            loop.openFile(destination, OpenOptions(write = true)).useAsync suspend { output ->
                output.truncate(3L)
                output.seek(3L)
                gcCollect()
                check(client.copyTo(output, 2L) == 3L)
                check(output.position() == 6L)
                check(output.size() == 6L)
                output.syncAll()
            }
            check(sending.await() == 3L)
            check(loop.metadata(link, followLinks = false).kind == FileKind.SymbolicLink)
            check(loop.metadata(link).size == 6L)
            check(loop.metadata(destination).size == 6L)
            client.close()
            server.close()
            listener.close()
        }
        check(destination.readText() == "abcdef")
    } finally { directory.deleteRecursively() }
}

fun main(args: Array<String>) {
    check(args.size == 2L)
    val directory = Path.fromString(args[1L])
    Thread.start { transfer(directory) }.use { first ->
        Thread.start { transfer(directory) }.use { second ->
            first.join()
            second.join()
        }
    }
    println("asynchronous file controls compose with resumed TCP copies")
}
