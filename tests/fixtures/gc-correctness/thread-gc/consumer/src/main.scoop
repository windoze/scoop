package dev.m45
import scoop.platform.concurrent.*
import scoop.platform.system.PlatformException
import scoop.time.Duration

@GCLeaf @Extern(name = "m45_sync_fail") private fun fail(kind: Int)
@GCLeaf @Extern(name = "m45_sync_count") private fun count(kind: Int): Int
@Extern(name = "m45_gate_block") private fun block()
@Extern(name = "m45_gate_wait_started") private fun waitStarted()
@Extern(name = "m45_gate_finish") private fun finish()
@Extern(name = "m45_cleanup_held_mutex") private fun cleanupHeld()

private fun verify(value: Boolean) { if (!value) throw IllegalStateException(Some("thread ownership assertion failed")) }
private fun fails(body: () -> Unit) {
    try { body() } catch (error: PlatformException) { return }
    throw IllegalStateException(Some("expected native failure"))
}

private fun creationFailures() {
    val ran = AtomicBoolean(false)
    @Unsafe {
        fail(1)
        fails { Thread.start { ran.store(true) } }
        verify(count(0) == 1 && !ran.load())
        fail(2)
        fails { Mutex() }
        verify(count(2) == 1)
    }
    Mutex().use { mutex ->
        @Unsafe { fail(3) }
        fails { ConditionVariable(mutex) }
        verify(mutex.withLock { 42 } == 42)
    }
    gcCollect()
    @Unsafe { verify(count(2) == 2 && count(3) == 1) }
}

private fun abandonThread(done: AtomicInt) {
    Thread.start { @Unsafe { block() }; done.store(7) }
}

private fun threadOwnership() {
    val done = AtomicInt(0)
    abandonThread(done)
    @Unsafe { waitStarted() }
    gcCollect()
    @Unsafe {
        verify(count(1) == 1 && count(0) == 1 && done.load() == 0)
        finish()
        verify(count(0) == 2 && done.load() == 7)
    }
    Thread.start { gcCollect() }.join()
    gcCollect()
    @Unsafe { verify(count(0) == 3 && count(1) == 1) }
}

private fun temporaryMutex() {
    val value = Mutex().withLock {
        gcCollect()
        @Unsafe { verify(count(2) == 2) }
        42
    }
    verify(value == 42)
}

private fun temporaryCondition() {
    Mutex().use { mutex ->
        mutex.withLock { verify(!ConditionVariable(mutex).await(Duration.ZERO)) }
    }
}

private fun abandonHeldMutex() { Mutex().lock() }

private fun synchronizationOwnership() {
    temporaryMutex()
    gcCollect()
    @Unsafe { verify(count(2) == 3) }
    temporaryCondition()
    gcCollect()
    @Unsafe { verify(count(2) == 4 && count(3) == 2) }
    abandonHeldMutex()
    gcCollect()
    @Unsafe {
        verify(count(2) == 4)
        cleanupHeld()
        verify(count(2) == 5)
    }
}

fun main() {
    creationFailures()
    threadOwnership()
    synchronizationOwnership()
    println("thread and synchronization ownership passed")
}
