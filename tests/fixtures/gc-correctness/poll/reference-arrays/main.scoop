package dev.performance

@Extern(lib = "m34_poll_threads", name = "m13_run_many")
fun workers(function: FunPtr<(Int, Ptr<Unit>) -> Int>, context: Ptr<Unit>, base: Int, count: Int): Int
@Extern(name = "usleep") fun pause(microseconds: UInt): Int

fun check(ok: Boolean) { if (!ok) throw IllegalStateException() }

fun findReference(values: Array<Node>, wanted: Node): Node {
    var i = 0L
    while (i < values.size) {
        val value = values[i]
        if (value === wanted) return value
        i += 1L
    }
    return wanted
}

fun exercise(worker: Int): Int {
    val count = 1025L + worker.toLong()
    var round = 0L
    while (round < 16L) {
        val seed = worker.toLong() * 100L + round
        val first = Node(seed)
        val last = Node(seed + 1L)
        val child: ChildToken<Long> = first
        val boxed: ChildToken<Long> = Boxed(seed + 2L)
        val parent: Token<Long> = first
        val nodes = Array<Node>(count) { i -> if (i == count - 1L) last else first }
        val target = fillNodes(count, first, first)
        val children = Array<ChildToken<Long>>(count) { i -> if (i.and(1L) == 0L) child else boxed }
        val views = Array<Token<Long>>(count) { i -> if (i.and(1L) == 0L) parent else boxed }
        val viewTarget = fillInterfaces(count, parent, parent)
        val optional = Array<Node?>(count) { i -> if (i.and(1L) == 0L) Some(first) else None }
        val optionTarget = MutableArray<Node?>(count) { _ -> None }
        val text = "moving-" + seed.toString()
        val strings = Array<String>(count) { _ -> text }
        val stringTarget = MutableArray<String>(count) { _ -> "" }
        val action: (Long) -> Long = { value -> value + first.value }
        val functions = Array<(Long) -> Long>(count) { _ -> action }
        val functionTarget = MutableArray<(Long) -> Long>(count) { _ -> action }
        val wrapped = MutableArray<MaybeUninit<Node>>(count) { _ -> MaybeUninit<Node>.initialized(last) }
        copyNodes(nodes, target)
        copyInterfaces(views, viewTarget)
        projectInterfaces(children, viewTarget)
        copyOptional(optional, optionTarget)
        copyStrings(strings, stringTarget)
        copyFunctions(functions, functionTarget)
        clearWrapped(wrapped)
        check(emptyStorage(count).size == count)
        check(sumNodes(nodes) == seed * count + 1L)
        check(sumOptional(optional) == ((count + 1L) / 2L) * seed)
        check(findNode(nodes, last) == count - 1L)
        val found = findReference(nodes, last)
        gcCollect()
        check(found === last && found.value == seed + 1L)
        var i = 0L
        while (i < count) {
            val even = i.and(1L) == 0L
            check(target[i].value == (if (i == count - 1L) seed + 1L else seed))
            check(viewTarget[i].number() == (if (even) seed else seed + 2L))
            check(when (optionTarget[i]) { case None -> !even; case Some(value) -> even && value.value == seed })
            check(stringTarget[i] == text && functionTarget[i](3L) == seed + 3L)
            i += 1L
        }
        round += 1L
    }
    return worker
}

@Unsafe fun main() {
    oldArrayWrites()
    wideArrayWrites()
    val ready = AtomicInt(0)
    val finished = AtomicInt(0)
    val start = AtomicBoolean(false)
    val action: (Int) -> Int = { worker ->
        if (worker == 0) {
            while (ready.load(MemoryOrder.Acquire) < 2) {}
            gcCollect()
            start.store(true, MemoryOrder.Release)
            while (finished.load(MemoryOrder.Acquire) < 2) {
                gcCollect()
                @Unsafe { pause(100u) }
            }
            0
        } else {
            ready.fetchAdd(1, MemoryOrder.Release)
            while (!start.load(MemoryOrder.Acquire)) {}
            try { exercise(worker) }
            finally { finished.fetchAdd(1, MemoryOrder.Release) }
        }
    }
    val callback = foreignCallback<(Int, Ptr<Unit>) -> Int>(action, 1, ForeignCallbackMode.Reusable)
    try {
        check(workers(callback.function, callback.context, 0, 3) == 3)
        check(when (foreignCallbackFailure(callback)) { case None -> true; case Some(_) -> false })
    } finally { releaseForeignCallback(callback) }
    println("reference arrays retain young values and moving views")
}
