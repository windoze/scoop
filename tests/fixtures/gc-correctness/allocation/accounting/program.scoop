interface Measured { fun measure(): Int }
class Node(val value: Int): Measured { override fun measure(): Int = value }
class Empty()
struct Words(val a: Long, val b: Long, val c: Long, val d: Long)
class Wide(val node: Node, val value: Long, val left: Words, val middle: Words, val right: Words)
class Beyond(val node: Node, val value: Long, val left: Words, val middle: Words, val right: Words, val tail: Long)
fun check(value: Boolean) { if (!value) { throw IllegalStateException() } }

fun fill(values: MutableArray<Node?>) {
    var index = 0L
    while (index < values.size) {
        values[index] = Some(Node(index.toInt()))
        index += 1L
    }
}

fun clearEven(values: MutableArray<Node?>) {
    var index = 0L
    while (index < values.size) { values[index] = None; index += 2L }
}

fun checkAllocationBoundaries() {
    val wide = MutableArray<Wide?>(257L) { _ -> None }
    val beyond = MutableArray<Beyond?>(257L) { _ -> None }
    val empty = MutableArray<Any?>(257L) { _ -> None }
    val boxed = MutableArray<Any?>(257L) { _ -> None }
    var index = 0L
    while (index < wide.size) {
        val words = Words(index, index + 1L, index + 2L, index + 3L)
        wide[index] = Some(Wide(Node(index.toInt()), index, words, words, words))
        beyond[index] = Some(Beyond(Node(index.toInt()), index, words, words, words, index + 4L))
        empty[index] = Some(Empty())
        boxed[index] = Some(index)
        index += 1L
    }
    gcCollect()
    index = 0L
    while (index < wide.size) {
        val small = wide[index]!!
        val large = beyond[index]!!
        check(small.node.value == index.toInt() && small.value == index)
        check(small.left.a == index && small.middle.c == index + 2L && small.right.d == index + 3L)
        check(large.node.value == index.toInt() && large.value == index)
        check(large.left.a == index && large.middle.c == index + 2L && large.right.d == index + 3L)
        check(large.tail == index + 4L && empty[index]!! is Empty)
        check((boxed[index]!! as Long) == index)
        index += 1L
    }
}

fun checkAllocationAcrossCatch(values: MutableArray<Node?>, fail: Boolean) {
    try {
        if (fail) {
            values[0L] = Some(Node(41))
            gcCollect()
            throw IllegalStateException()
        }
    } catch (error: IllegalStateException) {
        values[1L] = Some(Node(42))
        gcCollect()
        check(values[0L]!!.value == 41 && values[1L]!!.value == 42)
    }
    values[0L] = Some(Node(43))
    gcCollect()
    check(values[0L]!!.value == 43)
}

struct Padded(val flag: Byte, val value: Long)
struct RefPair(val node: Node, val other: Measured)
class Initialized<T>(val node: Node?, val tag: Byte, val value: T) {
    init { gcCollect() }
}
class Interrupted(val head: Long, fail: Boolean) {
    init {
        gcCollect()
        if (fail) { throw IllegalStateException() }
    }
    val tail: Node = Node(head.toInt())
}

fun checkInitializationStorage() {
    val kept = MutableArray<Any?>(10L) { _ -> None }
    kept[0L] = Some(Initialized<Long>(Some(Node(71)), 1.toByte(), 72L))
    kept[1L] = Some(Initialized<Padded>(None, 2.toByte(), Padded(3.toByte(), 73L)))
    kept[2L] = Some(Initialized<Node>(Some(Node(74)), 4.toByte(), Node(75)))
    val words = Words(76L, 77L, 78L, 79L)
    kept[3L] = Some(Initialized<Words>(None, 5.toByte(), words))
    try {
        kept[4L] = Some(Interrupted(80L, true))
        check(false)
    } catch (error: IllegalStateException) {
        check(when (kept[4L]) { case None -> true; case Some(value) -> false })
    }
    kept[4L] = Some(Interrupted(81L, false))
    kept[5L] = Some(Initialized<Measured>(Some(Node(82)), 6.toByte(), Node(83)))
    kept[6L] = Some(Initialized<Measured?>(None, 7.toByte(), Some(Node(84))))
    kept[7L] = Some(Initialized<RefPair>(None, 8.toByte(), RefPair(Node(85), Node(86))))
    kept[8L] = Some(Initialized<(Node, Measured)>(None, 9.toByte(), (Node(87), Node(88) as Measured)))
    kept[9L] = Some(Initialized<Measured?>(None, 10.toByte(), None))
    gcCollect()
    val scalar = kept[0L]!! as Initialized<Long>
    val padded = kept[1L]!! as Initialized<Padded>
    val rooted = kept[2L]!! as Initialized<Node>
    val aggregate = kept[3L]!! as Initialized<Words>
    val interrupted = kept[4L]!! as Interrupted
    val measured = kept[5L]!! as Initialized<Measured>
    val optional = kept[6L]!! as Initialized<Measured?>
    val pair = kept[7L]!! as Initialized<RefPair>
    val tuple = kept[8L]!! as Initialized<(Node, Measured)>
    val absent = kept[9L]!! as Initialized<Measured?>
    check(scalar.node!!.value == 71 && scalar.tag == 1.toByte() && scalar.value == 72L)
    check(when (padded.node) { case None -> true; case Some(value) -> false })
    check(padded.tag == 2.toByte())
    check(padded.value.flag == 3.toByte() && padded.value.value == 73L)
    check(rooted.node!!.value == 74 && rooted.value.value == 75)
    check(aggregate.value.a == 76L && aggregate.value.d == 79L)
    check(interrupted.head == 81L && interrupted.tail.value == 81)
    check(measured.node!!.value == 82 && measured.value.measure() == 83)
    check(optional.value!!.measure() == 84)
    check(pair.value.node.value == 85 && pair.value.other.measure() == 86)
    val (left, right) = tuple.value
    check(left.value == 87 && right.measure() == 88)
    check(when (absent.value) { case None -> true; case Some(value) -> false })
}

fun main() {
    val values = MutableArray<Node?>(64L) { index -> None }
    gcCollect()
    val before = gcStats()
    fill(values)
    gcCollect()
    val filled = gcStats()
    check(filled >= before + 64uL)
    clearEven(values)
    gcCollect()
    check(filled >= gcStats() + 32uL)
    var index = 0L
    var sum = 0
    while (index < values.size) {
        sum += when (values[index]) { case None -> 0; case Some(value) -> value.value }
        index += 1L
    }
    check(sum == 1024)
    checkAllocationBoundaries()
    val caught = MutableArray<Node?>(2L) { _ -> None }
    gcCollect()
    checkAllocationAcrossCatch(caught, false)
    checkAllocationAcrossCatch(caught, true)
    checkInitializationStorage()
    println("allocation counters")
}
