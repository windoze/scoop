package consumer.constructors

import templates.constructors.*

private class Payload(public val value: Int)

public fun result(): Int {
    val box = Derived<Payload>(Payload(37))
    val pair = Pair<Payload>(box.echoed)
    box.value = Payload(8)
    val first = Payload(1)
    val second = Payload(2)
    return pair.first.value + box.count
}

public fun <T> make(value: T): Box<T> = Box<T>(value)
