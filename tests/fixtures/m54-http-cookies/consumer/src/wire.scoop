import scoop.bytes.ByteArrayBuilder
import scoop.http.*
import scoop.platform.memory.NativeByteBuffer

fun responseBytes(): Array<Byte> {
    val output = ByteArrayBuilder()
    output.append(("HTTP/1.1 200 OK\r\n" +
        "Set-Cookie: __Host-SID=abc%2F; Secure; Path=/; HttpOnly; SameSite=Lax\r\n" +
        "Set-Cookie: SID=old; Max-Age=0; Path=/\r\n" +
        "Set-Cookie: theme=dark; Domain=.example.com; Path=/a%2Fb; Expires=bogus, 19-Oct-26 0:0:0 GMT\r\n" +
        "Set-Cookie: invalid=x; Domain=com\r\n" +
        "Set-Cookie: same=first\r\nSet-Cookie: same=second\r\n" +
        "Set-Cookie: strict=x; SameSite=Strict\r\nSet-Cookie: raw=").toByteArray())
    output.append(255.toByte())
    output.append("; Extension=a=b\r\nContent-Length: 0\r\n\r\n".toByteArray())
    return output.toByteArray()
}

fun requestBytes(cookies: HttpCookieHeader): Array<Byte> = Http1Encoder(HttpRole.Client).use { encoder ->
    val head = HttpRequestHead(HttpVersion.Http11, "GET".toByteArray(), HttpRequestTarget.Http1("/a%2Fb/next".toByteArray()),
        [HttpField("Host".toByteArray(), "www.example.com".toByteArray()), cookies.toHttpField()])
    val bytes = ByteArrayBuilder()
    bytes.append(encoder.beginRequest(head, Http1BodyFraming.Length(0L)))
    bytes.append(encoder.finish())
    bytes.toByteArray()
}

fun decodeFields(bytes: Array<Byte>, role: HttpRole): Array<HttpField> {
    val heads = ArrayList<Array<HttpField>>()
    val ends = ArrayList<Boolean>()
    val parser = if (role == HttpRole.Client) Http1Decoder.client() else Http1Decoder.server()
    parser.use { decoder ->
        if (role == HttpRole.Client) decoder.expectResponse("GET".toByteArray())
        NativeByteBuffer.allocate(1L).use { input ->
            for (byte in bytes) {
                input.clear(); input.writeByte(byte)
                if (decoder.receive(input) != 1L) throw IllegalStateException()
                while (true) {
                    val next = decoder.nextEvent()
                    when (next) { case None -> break; case Some(_) -> {} }
                    when (next!!) {
                        case Request(head) -> heads.add(head.fields)
                        case Response(head) -> heads.add(head.fields)
                        case End(value) -> ends.add(value)
                        case Data(_) -> throw IllegalStateException()
                        else -> {}
                    }
                }
            }
            decoder.endInput()
        }
        Unit
    }
    if (heads.size != 1L || ends.size != 1L) throw IllegalStateException()
    return heads[0L]
}
