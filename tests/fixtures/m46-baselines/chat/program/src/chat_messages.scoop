enum ChatMessage {
    Developer(ChatTextMessage), System(ChatTextMessage), User(ChatTextMessage), Assistant(ChatAssistant), Tool(ChatToolMessage), Function(ChatFunctionMessage)
    companion object : Encodable<ChatMessage>, Decodable<ChatMessage> {
        public override fun encode(value: ChatMessage, encoder: Encoder) {
            val fields = encoder.keyed()
            when (value) {
                case ChatMessage.Developer(payload) -> {
                    String.encode("developer", fields.field("role"))
                    ChatTextMessage.Companion.encode(payload, encoder)
                }
                case ChatMessage.System(payload) -> {
                    String.encode("system", fields.field("role"))
                    ChatTextMessage.Companion.encode(payload, encoder)
                }
                case ChatMessage.User(payload) -> {
                    String.encode("user", fields.field("role"))
                    ChatTextMessage.Companion.encode(payload, encoder)
                }
                case ChatMessage.Assistant(payload) -> {
                    String.encode("assistant", fields.field("role"))
                    ChatAssistant.Companion.encode(payload, encoder)
                }
                case ChatMessage.Tool(payload) -> {
                    String.encode("tool", fields.field("role"))
                    ChatToolMessage.Companion.encode(payload, encoder)
                }
                case ChatMessage.Function(payload) -> {
                    String.encode("function", fields.field("role"))
                    ChatFunctionMessage.Companion.encode(payload, encoder)
                }
            }
            fields.end()
        }
        public override fun decode(decoder: Decoder): ChatMessage {
            val fields = decoder.keyed()
            return when (String.decode(fields.required("role"))) {
                case "developer" -> ChatMessage.Developer(decodeChatText(decoder))
                case "system" -> ChatMessage.System(decodeChatText(decoder))
                case "user" -> ChatMessage.User(ChatTextMessage.Companion.decode(decoder))
                case "assistant" -> ChatMessage.Assistant(ChatAssistant.Companion.decode(decoder))
                case "tool" -> ChatMessage.Tool(ChatToolMessage.Companion.decode(decoder))
                case "function" -> ChatMessage.Function(ChatFunctionMessage.Companion.decode(decoder))
                else -> throw DecodingException(fields.required("role").path, "unknown ChatMessage branch")
            }
        }
    }
}

fun decodeChatText(decoder: Decoder): ChatTextMessage {
    val value = ChatTextMessage.Companion.decode(decoder)
    when (value.content) {
        case ChatContent.Blocks(parts) -> {
            val sequence = decoder.keyed().required("content").unkeyed()
            for (part in parts) {
                val child = sequence.element()
                when (part) {
                    case ChatPart.Text(_) -> {}
                    else -> throw DecodingException(child.path, "expected a text block")
                }
            }
            sequence.end()
        }
        case ChatContent.Text(_) -> {}
    }
    return value
}
