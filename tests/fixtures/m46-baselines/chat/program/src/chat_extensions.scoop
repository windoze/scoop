import scoop.json.*
import scoop.collections.*

struct CompletionWithExtensions(val completion: ChatCompletion, val extra: Extensions)
class CompletionReader(val collect: Boolean, val deny: Boolean) : ValueDecoder<CompletionWithExtensions> {
    public override fun decode(decoder: Decoder): CompletionWithExtensions {
        val completion = ChatCompletion.Companion.decode(decoder)
        val fields = decoder.keyed()
        val extra = LinkedHashMap<String, JsonValue>()
        for (name in fields.keys) {
            if (!member(["id", "object", "created", "model", "choices", "usage"], name)) {
                val child = fields.required(name)
                if (deny) { throw DecodingException(child.path, "unknown completion field") }
                if (collect) { extra.put(name, JsonValue.Companion.decode(child)) }
            }
        }
        fields.end()
        return CompletionWithExtensions(completion, Extensions(extra))
    }
}
object CompletionWriter : ValueEncoder<CompletionWithExtensions> {
    public override fun encode(value: CompletionWithExtensions, encoder: Encoder) {
        ChatCompletion.Companion.encode(value.completion, encoder)
        Extensions.Companion.encode(value.extra, encoder)
    }
}
