struct ChatCompletion(
    val id: String,
    @Serialize(rename = "object") val kind: String,
    val created: Long,
    val model: String,
    val choices: Array<ChatCompletionChoice>,
    @Serialize(required = true) val usage: ChatUsage?
) {
    companion object : ValueEncoder<ChatCompletion>, ValueDecoder<ChatCompletion> {}
}
struct ChatCompletionChoice(
    val index: Long,
    val message: ChatResponseMessage,
    val finish_reason: String,
    @Serialize(required = true) val logprobs: ChatLogprobs?
) {
    companion object : ValueEncoder<ChatCompletionChoice>, ValueDecoder<ChatCompletionChoice> {}
}
struct ChatResponseMessage(
    val role: String,
    @Serialize(required = true) val content: String?,
    @Serialize(required = true) val refusal: String?,
    val tool_calls: Array<ChatCall>? = None,
    val annotations: Array<ChatAnnotation> = []
) {
    companion object : ValueEncoder<ChatResponseMessage>, ValueDecoder<ChatResponseMessage> {}
}
struct ChatUsage(
    val prompt_tokens: Long,
    val completion_tokens: Long,
    val total_tokens: Long,
    val prompt_tokens_details: PromptTokens? = None,
    val completion_tokens_details: CompletionTokens? = None
) {
    companion object : ValueEncoder<ChatUsage>, ValueDecoder<ChatUsage> {}
}
struct PromptTokens(val cached_tokens: Long, val audio_tokens: Long) {
    companion object : ValueEncoder<PromptTokens>, ValueDecoder<PromptTokens> {}
}
struct CompletionTokens(
    val reasoning_tokens: Long,
    val audio_tokens: Long,
    val accepted_prediction_tokens: Long,
    val rejected_prediction_tokens: Long
) {
    companion object : ValueEncoder<CompletionTokens>, ValueDecoder<CompletionTokens> {}
}
struct ChatLogprobs(val content: Array<TokenProbability>?, val refusal: Array<TokenProbability>?) {
    companion object : ValueEncoder<ChatLogprobs>, ValueDecoder<ChatLogprobs> {}
}
struct TokenProbability(
    val token: String,
    val logprob: Double,
    val bytes: Array<Long>?,
    val top_logprobs: Array<AlternativeProbability>
) {
    companion object : ValueEncoder<TokenProbability>, ValueDecoder<TokenProbability> {}
}
struct AlternativeProbability(val token: String, val logprob: Double, val bytes: Array<Long>?) {
    companion object : ValueEncoder<AlternativeProbability>, ValueDecoder<AlternativeProbability> {}
}
struct ChatCitation(val url_citation: URLCitation) {
    companion object : ValueEncoder<ChatCitation>, ValueDecoder<ChatCitation> {}
}
struct URLCitation(val start_index: Long, val end_index: Long, val title: String, val url: String) {
    companion object : ValueEncoder<URLCitation>, ValueDecoder<URLCitation> {}
}
struct APIError(val message: String, val type: String, val param: String? = None, val code: String? = None) {
    companion object : ValueEncoder<APIError>, ValueDecoder<APIError> {}
}
struct ErrorEnvelope(val error: APIError) {
    companion object : ValueEncoder<ErrorEnvelope>, ValueDecoder<ErrorEnvelope> {}
}
enum ChatAnnotation {
    URL(ChatCitation)
    companion object : ValueEncoder<ChatAnnotation>, ValueDecoder<ChatAnnotation> {
        public override fun encode(value: ChatAnnotation, encoder: Encoder) {
            val fields = encoder.keyed()
            when (value) {
                case ChatAnnotation.URL(payload) -> {
                    String.encode("url_citation", fields.field("type"))
                    ChatCitation.Companion.encode(payload, encoder)
                }
            }
            fields.end()
        }
        public override fun decode(decoder: Decoder): ChatAnnotation {
            val fields = decoder.keyed()
            return when (String.decode(fields.required("type"))) {
                case "url_citation" -> ChatAnnotation.URL(ChatCitation.Companion.decode(decoder))
                else -> throw DecodingException(fields.required("type").path, "unknown ChatAnnotation branch")
            }
        }
    }
}
