enum ChatTool {
    Function(NestedFunction), Custom(NestedCustom)
    companion object : ValueEncoder<ChatTool>, ValueDecoder<ChatTool> {
        public override fun encode(value: ChatTool, encoder: Encoder) {
            val fields = encoder.keyed()
            when (value) {
                case ChatTool.Function(payload) -> {
                    String.encode("function", fields.field("type"))
                    NestedFunction.Companion.encode(payload, encoder)
                }
                case ChatTool.Custom(payload) -> {
                    String.encode("custom", fields.field("type"))
                    NestedCustom.Companion.encode(payload, encoder)
                }
            }
            fields.end()
        }
        public override fun decode(decoder: Decoder): ChatTool {
            val fields = decoder.keyed()
            return when (String.decode(fields.required("type"))) {
                case "function" -> ChatTool.Function(NestedFunction.Companion.decode(decoder))
                case "custom" -> ChatTool.Custom(NestedCustom.Companion.decode(decoder))
                else -> throw DecodingException(fields.required("type").path, "unknown ChatTool branch")
            }
        }
    }
}
enum ChatNamedTool {
    Function(NestedNamedFunction), Custom(NestedCustom), Allowed(AllowedChoice)
    companion object : ValueEncoder<ChatNamedTool>, ValueDecoder<ChatNamedTool> {
        public override fun encode(value: ChatNamedTool, encoder: Encoder) {
            val fields = encoder.keyed()
            when (value) {
                case ChatNamedTool.Function(payload) -> {
                    String.encode("function", fields.field("type"))
                    NestedNamedFunction.Companion.encode(payload, encoder)
                }
                case ChatNamedTool.Custom(payload) -> {
                    String.encode("custom", fields.field("type"))
                    NestedCustom.Companion.encode(payload, encoder)
                }
                case ChatNamedTool.Allowed(payload) -> {
                    String.encode("allowed_tools", fields.field("type"))
                    AllowedChoice.Companion.encode(payload, encoder)
                }
            }
            fields.end()
        }
        public override fun decode(decoder: Decoder): ChatNamedTool {
            val fields = decoder.keyed()
            return when (String.decode(fields.required("type"))) {
                case "function" -> ChatNamedTool.Function(NestedNamedFunction.Companion.decode(decoder))
                case "custom" -> ChatNamedTool.Custom(NestedCustom.Companion.decode(decoder))
                case "allowed_tools" -> ChatNamedTool.Allowed(AllowedChoice.Companion.decode(decoder))
                else -> throw DecodingException(fields.required("type").path, "unknown ChatNamedTool branch")
            }
        }
    }
}
enum ChatChoice {
    Text(String), Named(NamedChatChoice)
    companion object : ValueEncoder<ChatChoice>, ValueDecoder<ChatChoice> {
        public override fun encode(value: ChatChoice, encoder: Encoder) {
            when (value) {
                case ChatChoice.Text(text) -> String.encode(text, encoder)
                case ChatChoice.Named(payload) -> NamedChatChoice.Companion.encode(payload, encoder)
            }
        }
        public override fun decode(decoder: Decoder): ChatChoice {
            var text: String? = None
            try { text = Some(String.decode(decoder)) }
            catch (error: DecodingException) { text = None }
            if (text != None) { return ChatChoice.Text(text!!) }
            return ChatChoice.Named(NamedChatChoice.Companion.decode(decoder))
        }
    }
}
enum ChatFormat {
    Text, Object, Schema(SchemaFormat)
    companion object : ValueEncoder<ChatFormat>, ValueDecoder<ChatFormat> {
        public override fun encode(value: ChatFormat, encoder: Encoder) {
            val fields = encoder.keyed()
            when (value) {
                case ChatFormat.Text -> {
                    String.encode("text", fields.field("type"))
                }
                case ChatFormat.Object -> {
                    String.encode("json_object", fields.field("type"))
                }
                case ChatFormat.Schema(payload) -> {
                    String.encode("json_schema", fields.field("type"))
                    SchemaFormat.Companion.encode(payload, encoder)
                }
            }
            fields.end()
        }
        public override fun decode(decoder: Decoder): ChatFormat {
            val fields = decoder.keyed()
            return when (String.decode(fields.required("type"))) {
                case "text" -> ChatFormat.Text
                case "json_object" -> ChatFormat.Object
                case "json_schema" -> ChatFormat.Schema(SchemaFormat.Companion.decode(decoder))
                else -> throw DecodingException(fields.required("type").path, "unknown ChatFormat branch")
            }
        }
    }
}

struct NamedChatChoice(val tool: ChatNamedTool) {
    companion object : ValueEncoder<NamedChatChoice>, ValueDecoder<NamedChatChoice> {
        public override fun encode(value: NamedChatChoice, encoder: Encoder) { ChatNamedTool.Companion.encode(value.tool, encoder) }
        public override fun decode(decoder: Decoder): NamedChatChoice = NamedChatChoice(ChatNamedTool.Companion.decode(decoder))
    }
}
