struct Manifest(val schema: Long, val cone: Coordinate, val dependencies: Dependencies = Dependencies(),
    val sources: Array<Selection>? = None, val test: TestConfig = TestConfig(),
    @Serialize(rename = "test-dependencies") val testDependencies: Dependencies = Dependencies(),
    val native: Native = Native()) {
    companion object : Encodable<Manifest>, Decodable<Manifest> {
        public override fun decode(decoder: Decoder): Manifest {
            val fields = strict(decoder, ["schema", "cone", "dependencies", "sources", "test", "test-dependencies", "native"])
            val value = ManifestFields.decode(decoder)
            requireValid(value.schema == 1L, fields.required("schema"), "unsupported schema")
            for (entry in value.testDependencies.values) {
                if (value.dependencies.values.containsKey(entry.key)) {
                    throw DecodingException(fields.required("test-dependencies").keyed().required(entry.key).path, "duplicate dependency")
                }
            }
            fields.end()
            return value
        }
    }
}
object ManifestFields : Decodable<Manifest> {}

struct Coordinate(val group: String, val name: String, val version: String, val kind: String) {
    companion object : Encodable<Coordinate>, Decodable<Coordinate> {
        public override fun decode(decoder: Decoder): Coordinate {
            val fields = strict(decoder, ["group", "name", "version", "kind"])
            val value = CoordinateFields.decode(decoder)
            requireValid(coordinatePart(value.group), fields.required("group"), "invalid group")
            requireValid(coordinatePart(value.name), fields.required("name"), "invalid name")
            requireValid(version(value.version), fields.required("version"), "invalid version")
            requireValid(member(["library", "executable"], value.kind), fields.required("kind"), "invalid kind")
            fields.end()
            return value
        }
    }
}
object CoordinateFields : Decodable<Coordinate> {}

struct TestConfig(val sources: Array<Selection>? = None) {
    companion object : Encodable<TestConfig>, Decodable<TestConfig> {
        public override fun decode(decoder: Decoder): TestConfig {
            val fields = strict(decoder, ["sources"])
            val value = TestConfigFields.decode(decoder)

            fields.end()
            return value
        }
    }
}
object TestConfigFields : Decodable<TestConfig> {}
