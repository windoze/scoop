enum ResponsePart {
    Text(TextPart), Image(ResponseImage), File(ResponseFile), Audio(AudioPart), Output(OutputText), Refusal(RefusalPart)
    companion object : ValueEncoder<ResponsePart>, ValueDecoder<ResponsePart> {
        public override fun encode(value: ResponsePart, encoder: Encoder) {
            val fields = encoder.keyed()
            when (value) {
                case ResponsePart.Text(payload) -> {
                    String.encode("input_text", fields.field("type"))
                    TextPart.Companion.encode(payload, encoder)
                }
                case ResponsePart.Image(payload) -> {
                    String.encode("input_image", fields.field("type"))
                    ResponseImage.Companion.encode(payload, encoder)
                }
                case ResponsePart.File(payload) -> {
                    String.encode("input_file", fields.field("type"))
                    ResponseFile.Companion.encode(payload, encoder)
                }
                case ResponsePart.Audio(payload) -> {
                    String.encode("input_audio", fields.field("type"))
                    AudioPart.Companion.encode(payload, encoder)
                }
                case ResponsePart.Output(payload) -> {
                    String.encode("output_text", fields.field("type"))
                    OutputText.Companion.encode(payload, encoder)
                }
                case ResponsePart.Refusal(payload) -> {
                    String.encode("refusal", fields.field("type"))
                    RefusalPart.Companion.encode(payload, encoder)
                }
            }
            fields.end()
        }
        public override fun decode(decoder: Decoder): ResponsePart {
            val fields = decoder.keyed()
            return when (String.decode(fields.required("type"))) {
                case "input_text" -> ResponsePart.Text(TextPart.Companion.decode(decoder))
                case "input_image" -> ResponsePart.Image(ResponseImage.Companion.decode(decoder))
                case "input_file" -> ResponsePart.File(ResponseFile.Companion.decode(decoder))
                case "input_audio" -> ResponsePart.Audio(AudioPart.Companion.decode(decoder))
                case "output_text" -> ResponsePart.Output(OutputText.Companion.decode(decoder))
                case "refusal" -> ResponsePart.Refusal(RefusalPart.Companion.decode(decoder))
                else -> throw DecodingException(fields.required("type").path, "unknown ResponsePart branch")
            }
        }
    }
}
enum ResponseContent {
    Text(String), Blocks(Array<ResponsePart>)
    companion object : ValueEncoder<ResponseContent>, ValueDecoder<ResponseContent> {
        public override fun encode(value: ResponseContent, encoder: Encoder) {
            when (value) {
                case ResponseContent.Text(text) -> String.encode(text, encoder)
                case ResponseContent.Blocks(payload) -> Array<ResponsePart>.encoder(ResponsePart.Companion).encode(payload, encoder)
            }
        }
        public override fun decode(decoder: Decoder): ResponseContent {
            var text: String? = None
            try { text = Some(String.decode(decoder)) }
            catch (error: DecodingException) { text = None }
            if (text != None) { return ResponseContent.Text(text!!) }
            return ResponseContent.Blocks(Array<ResponsePart>.decoder(ResponsePart.Companion).decode(decoder))
        }
    }
}
