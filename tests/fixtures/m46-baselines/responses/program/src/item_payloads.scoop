struct EasyMessage(val role: String, val content: ResponseContent) {
    companion object : ValueEncoder<EasyMessage>, ValueDecoder<EasyMessage> {}
}
struct InputMessage(val role: String, val content: Array<ResponsePart>) {
    companion object : ValueEncoder<InputMessage>, ValueDecoder<InputMessage> {}
}
struct OutputMessage(val id: String, val role: String, val status: String, val content: Array<ResponsePart>) {
    companion object : ValueEncoder<OutputMessage>, ValueDecoder<OutputMessage> {}
}
struct ReasoningItem(val id: String, val summary: Array<SummaryPart>, val encrypted_content: String? = None) {
    companion object : ValueEncoder<ReasoningItem>, ValueDecoder<ReasoningItem> {}
}
struct SummaryPart(val type: String, val text: String) {
    companion object : ValueEncoder<SummaryPart>, ValueDecoder<SummaryPart> {}
}
struct CompactionItem(val encrypted_content: String, val id: String? = None) {
    companion object : ValueEncoder<CompactionItem>, ValueDecoder<CompactionItem> {}
}
struct FunctionItem(
    val call_id: String,
    val name: String,
    val arguments: String,
    val id: String? = None,
    val status: String? = None
) {
    companion object : ValueEncoder<FunctionItem>, ValueDecoder<FunctionItem> {}
}
struct FunctionResult(val call_id: String, val output: ResponseContent, val id: String? = None) {
    companion object : ValueEncoder<FunctionResult>, ValueDecoder<FunctionResult> {}
}
struct FileSearchItem(
    val id: String,
    val status: String,
    val queries: Array<String>,
    val results: Array<FileSearchResult>? = None
) {
    companion object : ValueEncoder<FileSearchItem>, ValueDecoder<FileSearchItem> {}
}
struct FileSearchResult(
    val file_id: String? = None,
    val filename: String? = None,
    val score: Double? = None,
    val text: String? = None
) {
    companion object : ValueEncoder<FileSearchResult>, ValueDecoder<FileSearchResult> {}
}
struct WebSearchItem(val id: String, val status: String, val action: SearchAction) {
    companion object : ValueEncoder<WebSearchItem>, ValueDecoder<WebSearchItem> {}
}
struct ImageItem(val id: String, val status: String, @Serialize(required = true) val result: String?) {
    companion object : ValueEncoder<ImageItem>, ValueDecoder<ImageItem> {}
}
struct CodeItem(
    val id: String,
    val status: String,
    val container_id: String,
    @Serialize(required = true) val code: String?,
    @Serialize(required = true) val outputs: Array<CodeOutput>?
) {
    companion object : ValueEncoder<CodeItem>, ValueDecoder<CodeItem> {}
}
struct CodeLogs(val logs: String) {
    companion object : ValueEncoder<CodeLogs>, ValueDecoder<CodeLogs> {}
}
struct CodeImage(val url: String) {
    companion object : ValueEncoder<CodeImage>, ValueDecoder<CodeImage> {}
}
