struct TextPart(val text: String) {
    companion object : ValueEncoder<TextPart>, ValueDecoder<TextPart> {}
}
struct RefusalPart(val refusal: String) {
    companion object : ValueEncoder<RefusalPart>, ValueDecoder<RefusalPart> {}
}
struct ResponseImage(val detail: String = "auto", val file_id: String? = None, val image_url: String? = None) {
    companion object : ValueEncoder<ResponseImage>, ValueDecoder<ResponseImage> {}
}
struct ResponseFile(
    val file_id: String? = None,
    val file_data: String? = None,
    val filename: String? = None,
    val file_url: String? = None
) {
    companion object : ValueEncoder<ResponseFile>, ValueDecoder<ResponseFile> {}
}
struct AudioPart(val input_audio: InputAudio) {
    companion object : ValueEncoder<AudioPart>, ValueDecoder<AudioPart> {}
}
struct InputAudio(val data: String, val format: String) {
    companion object : ValueEncoder<InputAudio>, ValueDecoder<InputAudio> {}
}
struct OutputText(val text: String, val annotations: Array<ResponseAnnotation> = []) {
    companion object : ValueEncoder<OutputText>, ValueDecoder<OutputText> {}
}
struct URLCitation(val start_index: Long, val end_index: Long, val title: String, val url: String) {
    companion object : ValueEncoder<URLCitation>, ValueDecoder<URLCitation> {}
}
struct FileCitation(val file_id: String, val index: Long, val filename: String) {
    companion object : ValueEncoder<FileCitation>, ValueDecoder<FileCitation> {}
}
enum ResponseAnnotation {
    URL(URLCitation), File(FileCitation)
    companion object : ValueEncoder<ResponseAnnotation>, ValueDecoder<ResponseAnnotation> {
        public override fun encode(value: ResponseAnnotation, encoder: Encoder) {
            val fields = encoder.keyed()
            when (value) {
                case ResponseAnnotation.URL(payload) -> {
                    String.encode("url_citation", fields.field("type"))
                    URLCitation.Companion.encode(payload, encoder)
                }
                case ResponseAnnotation.File(payload) -> {
                    String.encode("file_citation", fields.field("type"))
                    FileCitation.Companion.encode(payload, encoder)
                }
            }
            fields.end()
        }
        public override fun decode(decoder: Decoder): ResponseAnnotation {
            val fields = decoder.keyed()
            return when (String.decode(fields.required("type"))) {
                case "url_citation" -> ResponseAnnotation.URL(URLCitation.Companion.decode(decoder))
                case "file_citation" -> ResponseAnnotation.File(FileCitation.Companion.decode(decoder))
                else -> throw DecodingException(fields.required("type").path, "unknown ResponseAnnotation branch")
            }
        }
    }
}
