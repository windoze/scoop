import scoop.json.*
import scoop.text.*

struct Location(val location: String) {
    companion object : Encodable<Location>, Decodable<Location> {}
}
fun responsesBaseline(moving: Boolean) {
    if (moving) {
        val value = Json.decode(movingResponseRequest(), ResponseRequest.Companion)
        gcCollect()
        val encoded = Json.encode(value, ResponseRequest.Companion)
        check(encoded.contains("18446744073709551616") && value.metadata!!.values["case"]!! == "moving")
        return
    }
    val request = Json.decode(responseRequestText(), ResponseRequest.Companion)
    check(request.tools.size == 7L && request.instructions == None)
    check(request.prompt!!.variables.values.size == 3L)
    check(when (request.input) { case ResponseInput.Items(items) -> items.size == 17L; else -> false })
    val encoded = Json.encode(request, ResponseRequest.Companion)
    check(encoded.contains("\"instructions\":null"))
    check(encoded.contains("\"type\":\"function\",\"name\":\"weather\""))
    check(Json.encode(Json.decode(encoded, ResponseRequest.Companion), ResponseRequest.Companion) == encoded)
    val body = Json.decode(responseBodyText(), ResponseBody.Companion)
    check(body.output.size == 15L && body.usage!!.output_tokens_details.reasoning_tokens == 5L)
    check(when (body.output[1L]) { case ResponseItem.Reasoning(value) -> value.encrypted_content == Some("opaque+/=="); else -> false })
    val output = Json.encode(body.output, Array<ResponseItem>.encoder(ResponseItem.Companion))
    check(Json.encode(Json.decode(output, Array<ResponseItem>.decoder(ResponseItem.Companion)), Array<ResponseItem>.encoder(ResponseItem.Companion)) == output)
    for (text in extraResponseItems()) {
        val item = Json.decode(text, ResponseItem.Companion)
        val canonical = Json.encode(item, ResponseItem.Companion)
        check(Json.encode(Json.decode(canonical, ResponseItem.Companion), ResponseItem.Companion) == canonical)
    }
    for (text in ["""{"model":"m","input":"short"}""", """{"model":"m","input":[],"conversation":"conv-1"}""", """{"model":"m","input":[],"conversation":null,"instructions":null}"""]) {
        val value = Json.decode(text, ResponseRequest.Companion)
        val canonical = Json.encode(value, ResponseRequest.Companion)
        check(Json.encode(Json.decode(canonical, ResponseRequest.Companion), ResponseRequest.Companion) == canonical)
    }
    for (text in ["\"auto\"", "\"required\"", "\"none\"", """{"type":"web_search"}""", """{"type":"code_interpreter"}"""]) {
        check(Json.encode(Json.decode(text, ResponseChoice.Companion), ResponseChoice.Companion) == text)
    }
    for (text in ["""{"type":"text"}""", """{"type":"json_object"}"""]) {
        check(Json.encode(Json.decode(text, ResponseFormat.Companion), ResponseFormat.Companion) == text)
    }
    check(Json.encode(Json.decode("\"cn-1\"", ContainerChoice.Companion), ContainerChoice.Companion) == "\"cn-1\"")
    var arguments = ""
    var unknown = 0L
    for (text in responseEvents()) {
        val event = Json.decode(text, ResponseEvent.Companion)
        when (event) {
            case ResponseEvent.ArgumentsDelta(value) -> { arguments += value.delta }
            case ResponseEvent.Failed(value) -> { check(value.response.error!!.code == "server_error") }
            case ResponseEvent.Incomplete(value) -> { check(value.response.incomplete_details!!.reason == "max_output_tokens") }
            case ResponseEvent.Unknown(raw) -> { check(Json.encode(raw, JsonValue.Companion) == text); unknown += 1L }
            else -> {}
        }
        val canonical = Json.encode(event, ResponseEvent.Companion)
        check(Json.encode(Json.decode(canonical, ResponseEvent.Companion), ResponseEvent.Companion) == canonical)
    }
    check(unknown == 1L && Json.decode(arguments, Location.Companion).location == "Paris")
    responsesFailures()
}
