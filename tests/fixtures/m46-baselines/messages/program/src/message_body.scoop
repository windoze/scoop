struct MessageBody(
    val id: String,
    val type: String,
    val role: String,
    val model: String,
    val content: Array<Block>,
    @Serialize(required = true) val stop_reason: String?,
    @Serialize(required = true) val stop_sequence: String?,
    val usage: Usage,
    val container: ResponseContainer? = None,
    val diagnostics: Diagnostics? = None
) {
    companion object : Encodable<MessageBody>, Decodable<MessageBody> {}
}
struct Usage(
    val input_tokens: Long,
    val output_tokens: Long,
    val cache_creation_input_tokens: Long? = None,
    val cache_read_input_tokens: Long? = None,
    val server_tool_use: ServerUsage? = None
) {
    companion object : Encodable<Usage>, Decodable<Usage> {}
}
struct ServerUsage(val web_search_requests: Long, val web_fetch_requests: Long) {
    companion object : Encodable<ServerUsage>, Decodable<ServerUsage> {}
}
struct ResponseContainer(val id: String, val expires_at: String) {
    companion object : Encodable<ResponseContainer>, Decodable<ResponseContainer> {}
}
struct Diagnostics(@Serialize(required = true) val cache_miss_reason: CacheMiss?) {
    companion object : Encodable<Diagnostics>, Decodable<Diagnostics> {}
}
