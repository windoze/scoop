import scoop.json.*

struct UserTool(val name: String, val input_schema: JsonValue, val description: String? = None) {
    companion object : ValueEncoder<UserTool>, ValueDecoder<UserTool> {}
}
struct ComputerConfig(
    val name: String,
    val display_width_px: Long,
    val display_height_px: Long,
    val display_number: Long? = None
) {
    companion object : ValueEncoder<ComputerConfig>, ValueDecoder<ComputerConfig> {}
}
struct SearchConfig(val name: String, val max_uses: Long? = None, val allowed_domains: Array<String>? = None) {
    companion object : ValueEncoder<SearchConfig>, ValueDecoder<SearchConfig> {}
}
struct BasicToolConfig(val name: String) {
    companion object : ValueEncoder<BasicToolConfig>, ValueDecoder<BasicToolConfig> {}
}
struct ChoiceOptions(val disable_parallel_tool_use: Boolean = false) {
    companion object : ValueEncoder<ChoiceOptions>, ValueDecoder<ChoiceOptions> {}
}
struct NamedChoice(val name: String, val disable_parallel_tool_use: Boolean = false) {
    companion object : ValueEncoder<NamedChoice>, ValueDecoder<NamedChoice> {}
}
struct ThinkingBudget(val budget_tokens: Long) {
    companion object : ValueEncoder<ThinkingBudget>, ValueDecoder<ThinkingBudget> {}
}
enum ToolChoice {
    Auto(ChoiceOptions), Any(ChoiceOptions), None, Named(NamedChoice)
    companion object : ValueEncoder<ToolChoice>, ValueDecoder<ToolChoice> {
        public override fun encode(value: ToolChoice, encoder: Encoder) {
            val fields = encoder.keyed()
            when (value) {
                case ToolChoice.Auto(payload) -> {
                    String.encode("auto", fields.field("type"))
                    ChoiceOptions.Companion.encode(payload, encoder)
                }
                case ToolChoice.Any(payload) -> {
                    String.encode("any", fields.field("type"))
                    ChoiceOptions.Companion.encode(payload, encoder)
                }
                case ToolChoice.None -> {
                    String.encode("none", fields.field("type"))
                }
                case ToolChoice.Named(payload) -> {
                    String.encode("tool", fields.field("type"))
                    NamedChoice.Companion.encode(payload, encoder)
                }
            }
            fields.end()
        }
        public override fun decode(decoder: Decoder): ToolChoice {
            val fields = decoder.keyed()
            return when (String.decode(fields.required("type"))) {
                case "auto" -> ToolChoice.Auto(ChoiceOptions.Companion.decode(decoder))
                case "any" -> ToolChoice.Any(ChoiceOptions.Companion.decode(decoder))
                case "none" -> ToolChoice.None
                case "tool" -> ToolChoice.Named(NamedChoice.Companion.decode(decoder))
                else -> throw DecodingException(fields.required("type").path, "unknown ToolChoice branch")
            }
        }
    }
}
enum Thinking {
    Enabled(ThinkingBudget), Disabled, Adaptive
    companion object : ValueEncoder<Thinking>, ValueDecoder<Thinking> {
        public override fun encode(value: Thinking, encoder: Encoder) {
            val fields = encoder.keyed()
            when (value) {
                case Thinking.Enabled(payload) -> {
                    String.encode("enabled", fields.field("type"))
                    ThinkingBudget.Companion.encode(payload, encoder)
                }
                case Thinking.Disabled -> {
                    String.encode("disabled", fields.field("type"))
                }
                case Thinking.Adaptive -> {
                    String.encode("adaptive", fields.field("type"))
                }
            }
            fields.end()
        }
        public override fun decode(decoder: Decoder): Thinking {
            val fields = decoder.keyed()
            return when (String.decode(fields.required("type"))) {
                case "enabled" -> Thinking.Enabled(ThinkingBudget.Companion.decode(decoder))
                case "disabled" -> Thinking.Disabled
                case "adaptive" -> Thinking.Adaptive
                else -> throw DecodingException(fields.required("type").path, "unknown Thinking branch")
            }
        }
    }
}
