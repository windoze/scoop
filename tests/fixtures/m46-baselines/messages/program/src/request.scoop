import scoop.json.*

struct MessagesRequest(
    val model: String,
    val max_tokens: Long,
    val messages: Array<Turn>,
    val system: SystemContent? = None,
    val tools: Array<Tool>? = None,
    val tool_choice: ToolChoice? = None,
    val thinking: Thinking? = None,
    val output_config: OutputConfig? = None,
    val container: Container? = None,
    val cache_control: CacheControl? = None,
    val diagnostics: RequestDiagnostics? = None,
    val metadata: Metadata? = None
) {
    companion object : Encodable<MessagesRequest>, Decodable<MessagesRequest> {}
}
struct Turn(val role: String, val content: Content) {
    companion object : Encodable<Turn>, Decodable<Turn> {}
}
struct RequestDiagnostics(val previous_message_id: String? = None) {
    companion object : Encodable<RequestDiagnostics>, Decodable<RequestDiagnostics> {}
}
struct Metadata(val user_id: String? = None) {
    companion object : Encodable<Metadata>, Decodable<Metadata> {}
}
struct OutputConfig(val effort: String? = None, val format: OutputFormat? = None) {
    companion object : Encodable<OutputConfig>, Decodable<OutputConfig> {}
}
struct OutputFormat(val type: String, val schema: JsonValue) {
    companion object : Encodable<OutputFormat>, Decodable<OutputFormat> {}
}
struct ContainerConfig(val id: String? = None, val skills: Array<Skill>? = None) {
    companion object : Encodable<ContainerConfig>, Decodable<ContainerConfig> {}
}
struct Skill(val type: String, val skill_id: String, val version: String? = None) {
    companion object : Encodable<Skill>, Decodable<Skill> {}
}
enum Container {
    Text(String), Config(ContainerConfig)
    companion object : Encodable<Container>, Decodable<Container> {
        public override fun encode(value: Container, encoder: Encoder) {
            when (value) {
                case Container.Text(text) -> String.encode(text, encoder)
                case Container.Config(payload) -> ContainerConfig.Companion.encode(payload, encoder)
            }
        }
        public override fun decode(decoder: Decoder): Container {
            var text: String? = None
            try { text = Some(String.decode(decoder)) }
            catch (error: DecodingException) { text = None }
            if (text != None) { return Container.Text(text!!) }
            return Container.Config(ContainerConfig.Companion.decode(decoder))
        }
    }
}
