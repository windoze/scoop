import scoop.asyncio.*
import scoop.crypto.x509.TrustStore
import scoop.http.*
import scoop.http.client.*
import scoop.time.Duration
import scoop.url.Url

internal fun authBasic(mode: String, proxy: Url, second: Url, target: Url, trust: TrustStore) {
    val loop: EventLoop = LibuvEventLoop()
    loop.run suspend { scope ->
        val calls = AtomicLong(0L)
        val originCalls = AtomicLong(0L)
        val started = AtomicLong(0L)
        val provider = HttpAuthenticator.basic(if (mode == "basic-wrong-origin") second.httpOrigin() else proxy.httpOrigin()) suspend { request ->
            authCheck(request.proxyUrl == Some(proxy) && request.request.url == target && request.attempt == 1L)
            authCheck(request.challenge!!.scheme == "basic" && authContext() == "application")
            authCheck(started.load() == 0L)
            loop.sleep(Duration.milliseconds(2L))
            authCheck(authContext() == "application")
            calls.fetchAdd(1L)
            HttpPasswordCredentials("José", "päss:word")
        }
        val origin = HttpAuthenticator.basic(target.httpOrigin()) suspend { request ->
            authCheck(request.proxyUrl == None && request.attempt == 1L && started.load() == 0L)
            originCalls.fetchAdd(1L)
            HttpPasswordCredentials("origin", "secret")
        }
        val endpoint = HttpProxyEndpoint(proxy, authTls(trust),
            authorization = if (mode == "basic-static") Some(HttpCredentials.withToken68("Bearer", "static")) else None,
            authentication = HttpAuthenticationOptions([provider], maxAttempts = if (mode == "basic-limit") 1L else 3L))
        val options = if (mode == "basic-sent") HttpCallOptions() else authContinue()
        val body = if (mode == "basic-rejected" || mode == "basic-limit") RequestBody.Empty else authOnce(started)
        withHttpClient<Unit>(authConfig(trust, authSelector(endpoint),
            if (mode == "basic-layered") HttpAuthenticationOptions([origin]) else HttpAuthenticationOptions())) suspend { client ->
            context(AuthContext("application")) {
                val request = HttpRequest.post(target, body, options = options)
                if (mode == "basic-static" || mode == "basic-wrong-origin" || mode == "basic-wrong-field") {
                    client.withResponse(request) suspend { response ->
                        authCheck(response.status == 407U && response.authenticationCount == 0L && response.proxyAuthenticationCount == 0L)
                        authCheck(response.body.text(4L) == "deny")
                    }
                } else if (mode == "basic-rejected" || mode == "basic-limit" || mode == "basic-malformed" || mode == "basic-sent") {
                    val error = authFailure<HttpAuthenticationException> suspend { client.execute(request).close() }
                    val reason = when (mode) {
                        case "basic-rejected" -> HttpAuthenticationFailure.Rejected
                        case "basic-limit" -> HttpAuthenticationFailure.LimitExceeded
                        case "basic-sent" -> HttpAuthenticationFailure.BodyNotReplayable
                        else -> HttpAuthenticationFailure.InvalidChallenge
                    }
                    authCheck(error.reason == reason && error.url == proxy && error.head!!.status == 407U)
                    if (mode == "basic-malformed") authCheck(error.cause!! is HttpFieldParseException)
                    Unit
                } else authDone(client, request, originCount = if (mode == "basic-layered") 1L else 0L)
            }
        }
        val unused = mode == "basic-static" || mode == "basic-wrong-origin" || mode == "basic-wrong-field" || mode == "basic-malformed" || mode == "basic-sent"
        authCheck(calls.load() == if (unused) 0L else 1L)
        authCheck(originCalls.load() == if (mode == "basic-layered") 1L else 0L)
        authCheck(started.load() == if (mode == "basic-forward" || mode == "basic-connect" || mode == "basic-https-proxy" ||
            mode == "basic-layered" || mode == "basic-sent") 1L else 0L)
        authCheck(!scope.job.isCancelled)
    }
}

internal fun authRedirect(proxy: Url, second: Url, target: Url, trust: TrustStore) {
    val loop: EventLoop = LibuvEventLoop()
    loop.run suspend { _ ->
        val calls = AtomicLong(0L)
        val first = HttpAuthenticator.basic(proxy.httpOrigin()) suspend { request ->
            authCheck(request.proxyUrl == Some(proxy) && request.attempt == 1L && request.request.url == target)
            calls.fetchAdd(1L); HttpPasswordCredentials("first", "password")
        }
        val next = HttpAuthenticator.basic(second.httpOrigin()) suspend { request ->
            authCheck(request.proxyUrl == Some(second) && request.attempt == 2L && request.request.url.encodedPath == "/changed")
            calls.fetchAdd(1L); HttpPasswordCredentials("next", "password")
        }
        val left = HttpProxy.Http(HttpProxyEndpoint(proxy, authentication = HttpAuthenticationOptions([first])))
        val right = HttpProxy.Http(HttpProxyEndpoint(second, authentication = HttpAuthenticationOptions([next])))
        val selector = HttpProxySelector(suspend { request -> if (request.url == target) left else right })
        withHttpClient(authConfig(trust, selector)) suspend { client ->
            context(AuthContext("application")) {
                authDone(client, HttpRequest.get(target, [HttpField("Authorization".toByteArray(), "Bearer original".toByteArray(), true)]),
                    proxyCount = 2L, redirects = 1L)
            }
        }
        authCheck(calls.load() == 2L)
    }
}
