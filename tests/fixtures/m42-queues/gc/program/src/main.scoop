import scoop.collections.*
import scoop.comparisons.*

class Cell(val value: Long)
struct Item(val rank: Long, val cell: Cell, val data: (Long, Long, Long, Long))
fun check(value: Boolean) { if (!value) throw Exception(Some("queue GC")) }

fun fill(deque: ArrayDeque<Item>, heap: PriorityQueue<Item>) {
    var index = 0L
    while (index < 80L) {
        val item = Item(index, Cell(index + 1L), (index, index + 2L, index + 3L, index + 4L))
        deque.addFirst(item)
        heap.add(item)
        index += 1L
    }
}

fun removePair(deque: ArrayDeque<Item>, heap: PriorityQueue<Item>) {
    val front = heap.removeFirst()
    val back = deque.removeLast()
    check(front.rank == back.rank && front.cell === back.cell && front.data == back.data)
    check(front.cell.value == front.rank + 1L)
}

fun removeBatch(deque: ArrayDeque<Item>, heap: PriorityQueue<Item>) {
    var index = 0
    while (index < 40) { removePair(deque, heap); index += 1 }
}

fun main() {
    val deque = ArrayDeque<Item>()
    val heap = PriorityQueue<Item>(comparatorOf<Item> { a, b -> a.rank.compareTo(b.rank) })
    val oldDeque = deque.iterator()
    val oldHeap = heap.iterator()
    fill(deque, heap)
    gcCollect()
    var before = gcStats()
    removeBatch(deque, heap)
    gcCollect()
    check(before >= gcStats() + 40uL && heap.peek().rank == 40L && deque.lastOrNull()!!.rank == 40L)
    before = gcStats()
    deque.clear()
    heap.clear()
    gcCollect()
    check(before >= gcStats() + 40uL)
    var invalid = 0
    try { oldDeque.next() } catch (error: ConcurrentModificationException) { invalid += 1 }
    try { oldHeap.next() } catch (error: ConcurrentModificationException) { invalid += 1 }
    check(invalid == 2)
    println("queue gc passed")
}
