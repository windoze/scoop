import scoop.collections.*

fun check(value: Boolean) { if (!value) throw Exception(Some("deque model")) }

fun main() {
    val values = ArrayDeque<Long>()
    val model = ArrayList<Long>()
    var step = 0L
    while (step < 1500L) {
        if (step % 7L < 2L || model.size == 0L) { values.addFirst(step); model.add(0L, step) }
        else if (step % 7L < 5L) { values.addLast(step); model.add(step) }
        else if (step % 7L == 5L) check(values.removeFirst() == model.removeAt(0L))
        else check(values.removeLast() == model.removeAt(model.size - 1L))
        check(values.size == model.size && values.firstOrNone() == Some(model[0L]))
        check(values.lastOrNone() == Some(model[model.size - 1L]))
        val iterator = values.iterator()
        var index = 0L
        while (index < model.size) { check(iterator.next() == Some(model[index])); index += 1L }
        check(iterator.next() == None && iterator.next() == None)
        step += 1L
    }
    while (model.size > 0L) check(values.removeFirst() == model.removeAt(0L))
    var round = 0L
    while (round < 100L) {
        var index = 0L
        while (index < 25L) { values.addLast(index); index += 1L }
        index = 0L
        while (index < 25L) { check(values.removeFirst() == index); index += 1L }
        round += 1L
    }
    values.addFirst(7L)
    val iterator = values.iterator()
    values.clear()
    var caught = false
    try { iterator.next() } catch (error: ConcurrentModificationException) { caught = true }
    check(caught && values.size == 0L)
    println("queue deque-model passed")
}
