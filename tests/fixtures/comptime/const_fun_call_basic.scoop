// EXPECT: pass
// 目标：T1202c：`const fun` 调用 + `const val` 常量折叠（fixtures/comptime phase）。
// - 覆盖：参数绑定、局部 val、显式 return、block 末尾表达式返回。

package fixtures.comptime_

import scoop.core.*

const fun add(a: Int, b: Int): Int {
    val c = a + b
    return c
}

const fun add3(x: Int): Int {
    val y = x + 2
    y + 1
}

const val A: Int = add(1, 2)
const val B: Int = add3(10)
