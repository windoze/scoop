// EXPECT: pass
// 目标：T0146b comptime：Char const val、比较，以及 `Char.toInt()` 折叠。

package fixtures.comptime_

import scoop.core.*

const val UPPER_A: Char = 'A'
const val ESCAPED_NL: Char = '\n'
const val CODE_A: Int = UPPER_A.toInt()
const val CODE_Z: Int = '\u005A'.toInt()
const val EQ_A: Bool = UPPER_A == 'A'
const val ORDER_A_B: Bool = UPPER_A < 'B'
const val ORDER_B_A: Bool = 'B' > UPPER_A
