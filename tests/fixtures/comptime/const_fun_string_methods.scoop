// EXPECT: pass
// 目标：T0123：String 方法 intrinsics（substring, indexOf, contains, startsWith, endsWith,
//       split, trim, replace, charAt, repeat, compareTo, concat, toString, hash, isEmpty）。

package fixtures.comptime_

import scoop.core.*

// --- substring ---
const val SUB1: String = "hello world".substring(0, 5)
const val SUB2: String = "hello world".substring(6, 11)
const val SUB3: String = "hello".substring(0, 0)
const val SUB_CLAMP: String = "abc".substring(0 - 1, 100)

// --- indexOf ---
const val IDX1: Int = "hello world".indexOf("world")
const val IDX2: Int = "hello world".indexOf("xyz")
const val IDX3: Int = "aabaa".indexOf("a")
const val IDX_EMPTY: Int = "hello".indexOf("")

// --- contains ---
const val CON1: Bool = "hello world".contains("world")
const val CON2: Bool = "hello world".contains("xyz")

// --- startsWith / endsWith ---
const val SW1: Bool = "hello".startsWith("hel")
const val SW2: Bool = "hello".startsWith("xyz")
const val SW3: Bool = "hello".startsWith("")
const val EW1: Bool = "hello".endsWith("llo")
const val EW2: Bool = "hello".endsWith("xyz")

// --- split ---
const val SP1: Array<String> = "a,b,c".split(",")
const val SP2: Array<String> = "hello".split(",")
const val SP3: Array<String> = "a::b".split("::")

// --- trim / trimStart / trimEnd ---
const val T1: String = "  hello  ".trim()
const val T2: String = "  hello  ".trimStart()
const val T3: String = "  hello  ".trimEnd()
const val T4: String = "hello".trim()

// --- replace ---
const val R1: String = "aabbcc".replace("bb", "XX")
const val R2: String = "hello".replace("l", "r")
const val R3: String = "hello".replace("xyz", "!")

// --- charAt ---
const val CH1: Int = "ABC".charAt(0)
const val CH2: Int = "ABC".charAt(2)
const val CH_OOB: Int = "ABC".charAt(5)

// --- repeat ---
const val REP1: String = "ab".repeat(3)
const val REP2: String = "x".repeat(0)
const val REP3: String = "".repeat(5)

// --- compareTo ---
const val CMP1: Int = "abc".compareTo("abc")
const val CMP2: Int = "abc".compareTo("abd")
const val CMP3: Int = "abd".compareTo("abc")

// --- concat ---
const val CAT: String = "foo".concat("bar")

// --- toString ---
const val TS: String = "hello".toString()

// --- isEmpty ---
const val EM1: Bool = "".isEmpty()
const val EM2: Bool = "a".isEmpty()

// --- hash ---
const val H1: Int = "hello".hash()
const val H2: Int = "".hash()
const val H_SAME: Bool = "hello".hash() == "hello".hash()

// --- 组合：const fun 使用 String methods ---
const fun extractDomain(url: String): String {
    val noProto = url.substring(url.indexOf("://") + 3, url.byteLength())
    val slashIdx = noProto.indexOf("/")
    return noProto.substring(0, slashIdx)
}

const val DOMAIN: String = extractDomain("https://example.com/path")
