// EXPECT: pass
// 目标：T1203：`comptime { ... }` 与 `comptime if` 在 const 解释器路径可执行。
// - 覆盖：comptime block、局部 val、comptime if 分支裁剪、else-if 链。

package fixtures.comptime_

import scoop.core.*

const fun choose(flag: Bool): Int {
    // v0：comptime block 的最后表达式值会向外层 block 传播，便于通过 const val fixtures 验收。
    comptime {
        val base = 10
        comptime if (flag) {
            base + 1
        } else {
            base + 2
        }
    }
}

const fun pick(x: Int): Int {
    comptime if (x == 0) {
        0
    } else comptime if (x == 1) {
        10
    } else {
        20
    }
}

const fun safe(flag: Bool): Int {
    // 未选中分支不应被求值：这里放一个除以 0，确保分支裁剪生效。
    comptime if (flag) {
        1
    } else {
        1 / 0
    }
}

const val A: Int = choose(true)
const val B: Int = choose(false)
const val C: Int = pick(0)
const val D: Int = pick(1)
const val E: Int = pick(2)
const val F: Int = safe(true)

