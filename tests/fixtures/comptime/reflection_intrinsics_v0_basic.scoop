// EXPECT: pass
// 目标：T1204：反射 intrinsics v0（`nameOf/sizeOf/fieldsOf`）在 comptime 常量折叠中可用。
// - 覆盖：
//   - `nameOf<T>()`：返回类型名
//   - `sizeOf<T>()`：返回基础类型的大小（字节）
//   - `fieldsOf<T>()`：返回 struct/class 字段元数据列表（v0：tuple of FieldMeta）
//   - `FieldMeta.type`：可读取字段类型名（`TypeMeta.name`）

package fixtures.comptime_

import scoop.core.*

struct Point(val x: Int, val y: Int) {
    val tag: String
    // 计算属性：v0 的 fieldsOf 不应把它当作字段。
    val computed: Int get() = 0
}

const val N: String = nameOf<Point>()
const val S: Int = sizeOf<Int64>()
const val F = fieldsOf<Point>()
const val F0N: String = fieldsOf<Point>()._0.name
const val F0T: String = fieldsOf<Point>()._0.type.name
