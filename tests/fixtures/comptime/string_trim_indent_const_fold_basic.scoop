// EXPECT: pass
// 目标：T1216：`trimIndent()` 编译期求值（receiver 为编译期常量时折叠）。
// - 覆盖：直接对 raw string 调用；以及在 const fun 内部调用后再被 const val 折叠。

package fixtures.comptime_

import scoop.core.*

const fun banner(): String {
    return """
        a
          b
        c
    """.trimIndent()
}

const val DIRECT: String = """
    a
      b
    c
""".trimIndent()

const val VIA_FUN: String = banner()

