// EXPECT: pass
// 目标：T4015a2：generic `const fun` 调用复用 typecheck 选定的实例化结果。
// - 覆盖：显式/推断类型实参、generic 返回类型、generic const fun 内部的 `nameOf<T>()`，
//   以及外层 `T` 继续传给内层 generic const fun 的 type-substitution。

package fixtures.comptime_

import scoop.core.*

const fun <T> identity(x: T): T {
    return x
}

const fun <T> typeNameOf(): String {
    return nameOf<T>()
}

const fun <T> wrapName(x: T): String {
    return typeNameOf<T>()
}

const val A: Int = identity(41)
const val B: String = identity<String>("hi")
const val C: String = typeNameOf<Int>()
const val D: String = wrapName("hello")
