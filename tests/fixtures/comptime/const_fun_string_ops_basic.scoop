// EXPECT: pass
// 目标：T0123：String `+`（concatenation）、`==`/`!=`、byteLength、getByte、length。

package fixtures.comptime_

import scoop.core.*

const fun greet(name: String): String {
    return "Hello, " + name
}

const fun strEq(a: String, b: String): Bool {
    return a == b
}

const fun strNe(a: String, b: String): Bool {
    return a != b
}

const val HELLO: String = greet("World")
const val CONCAT: String = "abc" + "def"
const val MULTI_CONCAT: String = "a" + "b" + "c" + "d"
const val EMPTY_CONCAT: String = "" + "x" + "" + "y"

const val EQ1: Bool = strEq("abc", "abc")
const val EQ2: Bool = strEq("abc", "def")
const val NE1: Bool = strNe("abc", "def")
const val NE2: Bool = strNe("abc", "abc")

const val BLEN: Int = "hello".byteLength()
const val BLEN_EMPTY: Int = "".byteLength()
const val LEN: Int = "hello".length()

const val B0: Int = "ABC".getByte(0)
const val B1: Int = "ABC".getByte(1)
const val B2: Int = "ABC".getByte(2)
const val B_OOB: Int = "ABC".getByte(3)
const val B_NEG: Int = "ABC".getByte(0 - 1)
