import scoop.asyncio.*
import scoop.http.*
import scoop.http.asyncio.*
import scoop.http.client.RequestBody
import scoop.platform.net.*

private fun request(body: RequestBody, version: HttpVersion): HttpRequestHead {
    val fields = ArrayList<HttpField>()
    fields.add(body.contentType!!.toHttpField())
    fields.add(HttpField("Content-Encoding".toByteArray(), body.contentEncodings[0L].toByteArray()))
    val target = if (version == HttpVersion.Http2)
        HttpRequestTarget.Http2("http".toByteArray(), "localhost".toByteArray(), "/upload".toByteArray())
        else HttpRequestTarget.Http1("/upload".toByteArray())
    if (version == HttpVersion.Http11) fields.add(HttpField("Host".toByteArray(), "localhost".toByteArray()))
    return HttpRequestHead(version, "POST".toByteArray(), target, fields)
}

suspend fun sendHttp1Body(loop: EventLoop, scope: CoroutineScope, body: RequestBody) {
    val listener = loop.listenTcp(SocketAddress(IpAddress.IPV4_LOOPBACK, 0))
    try {
        val serving = scope.launch suspend {
            AsyncHttp1Connection.takeOwnershipAsServer(listener.accept(), scope).useAsync suspend { server ->
                val incoming = server.receiveRequest()!!
                receiveBody(incoming.body, incoming.head.fields)
                check(incoming.body.isComplete)
                incoming.body.close()
                server.sendResponse(HttpResponseHead(HttpVersion.Http11, 204U)).finish()
            }
        }
        AsyncHttp1Connection.takeOwnershipAsClient(loop.connectTcp(listener.localAddress), scope).useAsync suspend { client ->
            val writer = client.sendRequest(request(body, HttpVersion.Http11), Http1BodyFraming.Chunked)
            try { body.writeTo(writer, 97L); writer.finish() }
            finally { writer.close() }
            val response = client.receiveResponse()
            check(response.head.status == 204U)
            checkEmpty(response.body)
            response.body.close()
        }
        serving.join()
    } finally { listener.close() }
}

suspend fun sendHttp2Body(loop: EventLoop, scope: CoroutineScope, body: RequestBody) {
    val listener = loop.listenTcp(SocketAddress(IpAddress.IPV4_LOOPBACK, 0))
    try {
        val serving = scope.launch suspend {
            val server = AsyncHttp2Connection.takeOwnershipAsServer(listener.accept(), scope,
                settings = Http2Settings(initialWindowSize = 128U))
            try {
                val incoming = server.acceptRequest()!!
                receiveBody(incoming.stream, incoming.head.fields)
                check(incoming.stream.isReadComplete)
                incoming.stream.sendResponse(HttpResponseHead(HttpVersion.Http2, 204U))
            } finally { server.close() }
        }
        val client = AsyncHttp2Connection.takeOwnershipAsClient(loop.connectTcp(listener.localAddress), scope,
            limits = Http2Limits(maxPendingBodyBytes = 64L))
        try {
            val stream = client.openRequest(request(body, HttpVersion.Http2), false)
            body.writeTo(stream, 97L)
            stream.finish()
            check(stream.receiveResponse().status == 204U)
            checkEmpty(stream)
            stream.close()
            serving.join()
        } finally { client.close() }
    } finally { listener.close() }
}
