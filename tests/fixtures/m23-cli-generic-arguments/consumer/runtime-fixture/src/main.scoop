private class ReaderProbe(public val value: Int)

@Extern(lib = "m23_class_gc", name = "m23_class_gc_collected")
fun collected(): Int

fun main() {
    val retained = ReaderProbe(42)
    if (check() != retained.value) {
        throw IllegalStateException()
    }
    @Unsafe {
        if (collected() != 1) {
            throw IllegalStateException()
        }
    }
}

private fun check(): Int {
    if (explicitAndInferred() != 42) { return 1 }
    if (consumerLocalValue() != 43) { return 1 }
    if (useRelay() != 44) { return 1 }
    if (extension() != 45) { return 1 }
    if (defaults() != 46) { return 1 }
    if (consumerLocalDefault() != 47) { return 1 }
    if (nativeCall() != 48) { return 1 }
    if (recursiveCall() != 49) { return 1 }
    return 42
}
