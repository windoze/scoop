package lib

public struct Point {}

// public extension：供 app 侧通过显式 import / star import 发现（T0322）。
public fun Point.ext() {}

public struct WithMember {
    // 不可见 member 不会压制调用点可见的 extension。
    private fun ext() {}
}

// 同名 extension：用于验证 star import 引入的 visible extension 不会被 invisible member 压制。
public fun WithMember.ext() {}
