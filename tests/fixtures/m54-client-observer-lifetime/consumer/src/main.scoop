import scoop.crypto.testdata.rootPem
import scoop.crypto.x509.TrustStore
import scoop.http.client.HttpCallEventKind
import scoop.test.AssertionFailure

fun main(args: Array<String>) {
    try {
        TrustStore.fromPem(rootPem()).use { trust ->
            when (args[1L]) {
                "cancel" -> observerLifetime(trust, observerKind(args[2L]), args[3L], args[4L] == "child", args[5L] == "cleanup")
                "self" -> observerSelfWait(trust, observerKind(args[2L]), args[3L] == "child", args[4L] == "response")
                "fail" -> observerThrows(trust, observerKind(args[2L]), args[3L] == "timeout")
                "h2" -> observerHttp2(trust, observerKind(args[2L]))
                "rethrow" -> observerRethrowsNetworkFailure(trust)
                "queue" -> observerQueue(trust)
                "source" -> observerSourceCleanup(trust)
                else -> throw IllegalArgumentException(Some("unknown observer lifetime case"))
            }
        }
    } catch (error: AssertionFailure) {
        eprintln(error.kind + " " + (error.message ?: "failure") + " at " + error.location.file + ":" + error.location.line.toString())
        throw error
    } catch (error: Exception) { eprintln(error.message ?: "observer lifecycle failed"); throw error }
    println("observer lifecycle case passed")
}

private fun observerKind(text: String): HttpCallEventKind = when (text) {
    "start" -> HttpCallEventKind.AttemptStarted
    "connection" -> HttpCallEventKind.ConnectionAcquired
    "request" -> HttpCallEventKind.RequestHeaders
    "upload" -> HttpCallEventKind.RequestProgress
    "headers" -> HttpCallEventKind.ResponseHeaders
    "read" -> HttpCallEventKind.ResponseProgress
    "complete" -> HttpCallEventKind.Completed
    else -> throw IllegalArgumentException(Some("unknown observer event"))
}
