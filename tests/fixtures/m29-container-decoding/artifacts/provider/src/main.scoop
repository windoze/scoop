package containers

public fun <T> arrayDecoder(element: Decodable<T>): Decodable<Array<T>> = Array<T>.decoder(element)

public fun integers(): Decodable<Array<Int>> = arrayDecoder(Int.Companion)

public fun <T> nested(element: Decodable<T>): Decodable<Option<MutableArray<ArrayList<T>>>> =
    Option<MutableArray<ArrayList<T>>>.decoder(
        MutableArray<ArrayList<T>>.decoder(ArrayList<T>.decoder(element))
    )
