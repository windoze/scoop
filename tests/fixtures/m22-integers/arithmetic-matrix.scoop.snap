    @Extern(name = "scoop_rt_write", abi = "scoop")
  public fun write(message: String)
  public fun print<T : ToString>(value: T)
    =
      Call write
        MethodCall toString
          Var value
  public fun println<T : ToString>(value: T)
    Call write
      MethodCall toString
        Var value
    Call write
      StringLiteral "\n"
