  public enum ForeignCallbackMode
    Reusable
    OneShot
  public enum ForeignCallbackState
    Registered
    Active
    Completed
    Failed
  public struct ForeignCallback<F>
    field function: FunPtr<F>
    field context: Ptr<Unit>
    @Unsafe
    @Intrinsic("foreign_callback_register")
  public fun foreignCallback<F>(callback: Any, contextIndex: Long, mode: ForeignCallbackMode): ForeignCallback<F>
    @Unsafe
    @Intrinsic("foreign_callback_retain")
  public fun retainForeignCallback<F>(callback: ForeignCallback<F>): ForeignCallback<F>
    @Unsafe
    @Intrinsic("foreign_callback_release")
  public fun releaseForeignCallback<F>(callback: ForeignCallback<F>)
    @Unsafe
    @Intrinsic("foreign_callback_state")
  public fun foreignCallbackState<F>(callback: ForeignCallback<F>): ForeignCallbackState
    @Unsafe
    @Intrinsic("foreign_callback_failure")
  public fun foreignCallbackFailure<F>(callback: ForeignCallback<F>): Throwable?
