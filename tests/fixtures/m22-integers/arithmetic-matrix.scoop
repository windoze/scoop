    println(I64_DIVIDEND.rem(I64_DIVISOR) == -1L)
    println(minimum.div(minusOne) == -9223372036854775808L)
    println(minimum.rem(minusOne) == 0L)
    try {
        println(one / zero)
    } catch (error: ArithmeticException) {
        println("Long/div-zero")
    }
    try {
        println(one % zero)
    } catch (error: ArithmeticException) {
        println("Long/rem-zero")
    }
}

fun checkUInt8() {
    println("UInt8")
    val zero: UInt8 = 0u
    val one: UInt8 = 1u
    val maximum: UInt8 = 255u
    val maskLeft: UInt8 = 0xa5u
    val maskRight: UInt8 = 0x3cu
    val dividend: UInt8 = 250u
    val divisor: UInt8 = 7u
    println(maximum + one == U8_ADD)
    println(zero - one == U8_SUB)
    println(maximum * 2u == U8_MUL)
    println(-one == U8_NEG)
    println(+one == U8_PLUS)
    println(U8_ADD == 0u)
    println(U8_SUB == 255u)
    println(U8_MUL == 254u)
    println(U8_NEG == 255u)
    var incremented = maximum
    val beforeIncrement = incremented++
    println(incremented == U8_INC_EXPECTED)
    println(beforeIncrement == maximum)
    var decremented = zero
    val beforeDecrement = decremented--
    println(decremented == U8_DEC_EXPECTED)
    println(beforeDecrement == zero)
    println((maskLeft and maskRight) == U8_AND)
    println((maskLeft or maskRight) == U8_OR)
    println((maskLeft xor maskRight) == U8_XOR)
    println(zero.inv() == U8_INV)
    println((one shl 9L) == U8_SHL)
    println((maximum shr 9L) == U8_SHR)
    println((maximum > zero) == U8_COMPARE)
    println(maximum.compareTo(zero) == U8_COMPARE_TO)
    println(maximum.equals(maximum) == U8_EQUALS)
    println(U8_COMPARE)
    println(U8_COMPARE_TO == 1L)
    println(U8_EQUALS)
    println(U8_EQUALS_FALSE == false)
    println(maximum.equals(zero) == false)
    println((dividend / divisor) == U8_DIV)
    println((dividend % divisor) == U8_REM)
    println(dividend.div(divisor) == 35u)
    println(dividend.rem(divisor) == 5u)
    try {
        println(one / zero)
    } catch (error: ArithmeticException) {
        println("UInt8/div-zero")
    }
    try {
        println(one % zero)
    } catch (error: ArithmeticException) {
        println("UInt8/rem-zero")
    }
}

