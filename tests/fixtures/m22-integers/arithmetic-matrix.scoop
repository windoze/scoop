fun checkInt32() {
    println("Int")
    val zero: Int = 0
    val one: Int = 1
    val minusOne: Int = -1
    val minimum: Int = -2147483648
    val maximum: Int = 2147483647
    println(maximum + one == I32_ADD)
    println(minimum - one == I32_SUB)
    println(maximum * 2 == I32_MUL)
    println(-minimum == I32_NEG)
    println(+one == I32_PLUS)
    println(I32_ADD == -2147483648)
    println(I32_SUB == 2147483647)
    println(I32_MUL == -2)
    println(I32_NEG == -2147483648)
    var incremented = maximum
    val beforeIncrement = incremented++
    println(incremented == I32_INC_EXPECTED)
    println(beforeIncrement == maximum)
    var decremented = minimum
    val beforeDecrement = decremented--
    println(decremented == I32_DEC_EXPECTED)
    println(beforeDecrement == minimum)
    println((0x5aa5_aa55 and 0x0ff0_0ff0) == I32_AND)
    println((0x5aa5_aa55 or 0x0ff0_0ff0) == I32_OR)
    println((0x5aa5_aa55 xor 0x0ff0_0ff0) == I32_XOR)
    println(zero.inv() == I32_INV)
    println((one shl 33L) == I32_SHL)
    println((minimum shr 33L) == I32_SHR)
    println((minimum ushr 33L) == I32_USHR)
    println(I32_SHR == -1073741824)
    println(I32_USHR == 1073741824)
    println((minimum < maximum) == I32_COMPARE)
    println(minimum.compareTo(maximum) == I32_COMPARE_TO)
    println(minimum.equals(minimum) == I32_EQUALS)
    println(I32_COMPARE)
    println(I32_COMPARE_TO == -1L)
    println(I32_EQUALS)
    println(I32_EQUALS_FALSE == false)
    println(minimum.equals(maximum) == false)
    println((-7 / 3) == I32_DIV)
    println((-7 % 3) == I32_REM)
    println((minimum / minusOne) == I32_MIN_DIV)
    println((minimum % minusOne) == I32_MIN_REM)
    println(I32_DIVIDEND.div(I32_DIVISOR) == -2)
    println(I32_DIVIDEND.rem(I32_DIVISOR) == -1)
    println(minimum.div(minusOne) == -2147483648)
    println(minimum.rem(minusOne) == 0)
    try {
        println(one / zero)
    } catch (error: ArithmeticException) {
        println("Int/div-zero")
    }
    try {
        println(one % zero)
    } catch (error: ArithmeticException) {
        println("Int/rem-zero")
