    }
}

fun checkUInt32() {
    println("UInt")
    val zero: UInt = 0u
    val one: UInt = 1u
    val maximum: UInt = 4294967295u
    println(maximum + one == U32_ADD)
    println(zero - one == U32_SUB)
    println(maximum * 2u == U32_MUL)
    println(-one == U32_NEG)
    println(+one == U32_PLUS)
    println(U32_ADD == 0u)
    println(U32_SUB == 4294967295u)
    println(U32_MUL == 4294967294u)
    println(U32_NEG == 4294967295u)
    var incremented = maximum
    val beforeIncrement = incremented++
    println(incremented == U32_INC_EXPECTED)
    println(beforeIncrement == maximum)
    var decremented = zero
    val beforeDecrement = decremented--
    println(decremented == U32_DEC_EXPECTED)
    println(beforeDecrement == zero)
    println((0xa5a5_a5a5u and 0x3c3c_3c3cu) == U32_AND)
    println((0xa5a5_a5a5u or 0x3c3c_3c3cu) == U32_OR)
    println((0xa5a5_a5a5u xor 0x3c3c_3c3cu) == U32_XOR)
    println(zero.inv() == U32_INV)
    println((one shl 33L) == U32_SHL)
    println((maximum shr 33L) == U32_SHR)
    println((maximum > zero) == U32_COMPARE)
    println(maximum.compareTo(zero) == U32_COMPARE_TO)
    println(maximum.equals(maximum) == U32_EQUALS)
    println(U32_COMPARE)
    println(U32_COMPARE_TO == 1L)
    println(U32_EQUALS)
    println(U32_EQUALS_FALSE == false)
    println(maximum.equals(zero) == false)
    println((4000000000u / 7u) == U32_DIV)
    println((4000000000u % 7u) == U32_REM)
    println(U32_DIVIDEND.div(U32_DIVISOR) == 571428571u)
    println(U32_DIVIDEND.rem(U32_DIVISOR) == 3u)
    try {
        println(one / zero)
    } catch (error: ArithmeticException) {
        println("UInt/div-zero")
    }
    try {
        println(one % zero)
    } catch (error: ArithmeticException) {
        println("UInt/rem-zero")
    }
}

fun checkUInt64() {
    println("ULong")
    val zero: ULong = 0uL
    val one: ULong = 1uL
    val maximum: ULong = 18446744073709551615uL
    println(maximum + one == U64_ADD)
    println(zero - one == U64_SUB)
    println(maximum * 2uL == U64_MUL)
    println(-one == U64_NEG)
    println(+one == U64_PLUS)
    println(U64_ADD == 0uL)
    println(U64_SUB == 18446744073709551615uL)
    println(U64_MUL == 18446744073709551614uL)
    println(U64_NEG == 18446744073709551615uL)
    var incremented = maximum
    val beforeIncrement = incremented++
    println(incremented == U64_INC_EXPECTED)
    println(beforeIncrement == maximum)
    var decremented = zero
    val beforeDecrement = decremented--
    println(decremented == U64_DEC_EXPECTED)
    println(beforeDecrement == zero)
    println((0xa5a5_a5a5_a5a5_a5a5uL and 0x3c3c_3c3c_3c3c_3c3cuL) == U64_AND)
    println((0xa5a5_a5a5_a5a5_a5a5uL or 0x3c3c_3c3c_3c3c_3c3cuL) == U64_OR)
    println((0xa5a5_a5a5_a5a5_a5a5uL xor 0x3c3c_3c3c_3c3c_3c3cuL) == U64_XOR)
    println(zero.inv() == U64_INV)
    println((one shl 65L) == U64_SHL)
    println((maximum shr 65L) == U64_SHR)
    println((maximum > zero) == U64_COMPARE)
    println(maximum.compareTo(zero) == U64_COMPARE_TO)
    println(maximum.equals(maximum) == U64_EQUALS)
    println(U64_COMPARE)
    println(U64_COMPARE_TO == 1L)
    println(U64_EQUALS)
    println(U64_EQUALS_FALSE == false)
    println(maximum.equals(zero) == false)
    println((18000000000000000000uL / 7uL) == U64_DIV)
    println((18000000000000000000uL % 7uL) == U64_REM)
    println(U64_DIVIDEND.div(U64_DIVISOR) == 2571428571428571428uL)
    println(U64_DIVIDEND.rem(U64_DIVISOR) == 4uL)
    try {
        println(one / zero)
    } catch (error: ArithmeticException) {
        println("ULong/div-zero")
    }
    try {
        println(one % zero)
    } catch (error: ArithmeticException) {
        println("ULong/rem-zero")
    }
}

fun main() {
    checkInt8()
    checkInt16()
    checkInt32()
    checkInt64()
    checkUInt8()
    checkUInt16()
    checkUInt32()
    checkUInt64()
}
