fun checkInt8() {
    println("Int8")
    val zero: Int8 = 0
    val one: Int8 = 1
    val minusOne: Int8 = -1
    val minimum: Int8 = -128
    val maximum: Int8 = 127
    val maskLeft: Int8 = 0x5a
    val maskRight: Int8 = 0x3c
    val dividend: Int8 = -7
    val divisor: Int8 = 3
    println(maximum + one == I8_ADD)
    println(minimum - one == I8_SUB)
    println(maximum * 2 == I8_MUL)
    println(-minimum == I8_NEG)
    println(+one == I8_PLUS)
    println(I8_ADD == -128)
    println(I8_SUB == 127)
    println(I8_MUL == -2)
    println(I8_NEG == -128)
    var incremented = maximum
    val beforeIncrement = incremented++
    println(incremented == I8_INC_EXPECTED)
    println(beforeIncrement == maximum)
    var decremented = minimum
    val beforeDecrement = decremented--
    println(decremented == I8_DEC_EXPECTED)
    println(beforeDecrement == minimum)
    println((maskLeft and maskRight) == I8_AND)
    println((maskLeft or maskRight) == I8_OR)
    println((maskLeft xor maskRight) == I8_XOR)
    println(zero.inv() == I8_INV)
    println((one shl 9L) == I8_SHL)
    println((minimum shr 9L) == I8_SHR)
    println((minimum ushr 9L) == I8_USHR)
    println(I8_SHR == -64)
    println(I8_USHR == 64)
    println((minimum < maximum) == I8_COMPARE)
    println(minimum.compareTo(maximum) == I8_COMPARE_TO)
    println(minimum.equals(minimum) == I8_EQUALS)
    println(I8_COMPARE)
    println(I8_COMPARE_TO == -1L)
    println(I8_EQUALS)
    println(I8_EQUALS_FALSE == false)
    println(minimum.equals(maximum) == false)
    println((dividend / divisor) == I8_DIV)
    println((dividend % divisor) == I8_REM)
    println((minimum / minusOne) == I8_MIN_DIV)
    println((minimum % minusOne) == I8_MIN_REM)
    println(dividend.div(divisor) == -2)
    println(dividend.rem(divisor) == -1)
    println(minimum.div(minusOne) == -128)
    println(minimum.rem(minusOne) == 0)
    try {
        println(one / zero)
    } catch (error: ArithmeticException) {
        println("Int8/div-zero")
    }
    try {
        println(one % zero)
    } catch (error: ArithmeticException) {
        println("Int8/rem-zero")
    }
}

