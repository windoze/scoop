import scoop.collections.*

class ModuloSet : MutableSet<Int> {
    private val values: MutableSet<Int> = mutableSetOf<Int>()
    public override val size: Long get() = values.size
    public override operator fun contains(value: Int): Boolean = values.contains(value % 10)
    public override operator fun iterator(): Iterator<Int> = values.iterator()
    public override fun add(value: Int): Boolean = values.add(value % 10)
    public override fun remove(value: Int): Boolean = values.remove(value % 10)
    public override fun clear() { values.clear() }
    public override fun retainAll(elements: Iterable<Int>): Boolean {
        val normalized = ArrayList<Int>()
        for (element in elements) normalized.add(element % 10)
        return values.retainAll(normalized)
    }
}
