package equality.origin

public enum Flag { Off, On }
public enum Packet {
    Empty,
    Item(Int),
    Named { value: String, flag: Flag }
}
public struct Envelope(val packet: Packet, val flag: Flag)
public struct Manual(val number: Int) : Equality<Manual> {
    public override operator fun equals(other: Manual): Boolean = true
}
public struct Overloaded(val number: Int) : Equality<Int> {
    public override operator fun equals(other: Int): Boolean = this.number == other
}
public class Missing public constructor()
public enum Broken { Empty, Value(Missing) }
