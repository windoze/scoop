package scoop.tests
import scoop.asyncio.*
import scoop.crypto.x509.TrustStore
import scoop.http.*
import scoop.http.client.*
import scoop.platform.fs.Path
import scoop.test.*
import scoop.tls.TlsTrustSource
import scoop.url.Url

internal fun resumeNetwork(trust: TrustStore, mode: String, url: Url, directory: Path) {
    LibuvEventLoop().run suspend { _ ->
        val target = directory.resolve(Path.fromString("result"))
        val resume = HttpResumeOptions(directory.resolve(Path.fromString("partial")), directory.resolve(Path.fromString("metadata")),
            if (mode == "restart" || mode == "mismatch") HttpResumeMismatch.Restart else HttpResumeMismatch.Fail)
        downloadStore(target, "original")
        val authentication = if (mode == "digest-incomplete" || mode == "digest-prefix") HttpAuthenticationOptions([
            HttpAuthenticator.digest(url.httpOrigin()) suspend { _ -> HttpPasswordCredentials("user", "password") }
        ]) else HttpAuthenticationOptions()
        val config = HttpClientConfig(tls = HttpClientTlsConfig(TlsTrustSource.Store(trust)), authentication = authentication,
            retries = HttpRetryOptions(maxRetries = 0L), cache = if (mode == "cache") Some(HttpCacheOptions(MemoryHttpCache())) else None)
        withHttpClient(config) suspend { client ->
            val request = resumeRequest(mode, url, false)
            if (mode == "cache") {
                client.execute(HttpRequest.get(url, [downloadField("Accept-Encoding", "identity")])).useAsync suspend { value ->
                    assertEquals(48L, value.body.readAllBytes(1024L).size)
                }
            }
            seedResume(client, mode, request, target, resume)
            checkResumeAttempt(client, mode, resumeRequest(mode, url, true), target, resume)
        }
        assertEquals(if (downloadExists(resume.partialFile)) 3L else 1L, downloadFiles(directory))
    }
}

private fun resumeRequest(mode: String, url: Url, changed: Boolean): HttpRequest {
    val fields = ArrayList<HttpField>()
    if (mode == "raw") fields.add(downloadField("Accept-Encoding", "gzip"))
    if (mode == "cookie") fields.add(downloadField("Cookie", if (changed) "session=two" else "session=one"))
    if (mode == "authorization") fields.add(downloadField("Authorization", if (changed) "Bearer two" else "Bearer one"))
    return HttpRequest.get(url, fields)
}
