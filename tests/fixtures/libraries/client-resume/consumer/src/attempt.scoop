package scoop.tests
import scoop.http.HttpException
import scoop.http.client.*
import scoop.platform.fs.Path
import scoop.test.*

private class ResumeProgress { var calls: Long = 0L; var written: Long = 0L; var resumed: Long = 0L }

internal suspend fun checkResumeAttempt(client: HttpClient, mode: String, request: HttpRequest, target: Path, resume: HttpResumeOptions) {
    val progress = ResumeProgress()
    val failed = DownloadFailure()
    val reason = resumeFailureReason(mode)
    val expectedFailure = downloadPresent(reason) || mode == "truncated-range" || mode == "status"
    try {
        val result = context(DownloadMarker("resume-context")) {
            client.resumeDownload(request, target, resume, HttpDownloadOptions(replaceExisting = true, syncOnCommit = true,
                bufferSize = 4L, onProgress = suspend { value ->
                    assertEquals("resume-context", downloadMarker())
                    assertEquals("original", String.fromUtf8(downloadRead(target)))
                    assertTrue(value.bytesWritten >= progress.written)
                    progress.calls += 1L; progress.written = value.bytesWritten; progress.resumed = value.resumedBytes
                }))
        }
        assertFalse(expectedFailure)
        assertEquals(target, result.path)
        assertEquals(downloadRead(target).size, result.byteCount)
        assertEquals(result.byteCount, progress.written)
        assertTrue(progress.calls > 0L)
        val kept = if (mode == "restart" || mode == "mismatch" || mode == "digest-incomplete") 0L
            else if (mode == "complete-416") 48L else 8L
        assertEquals(kept, result.resumedBytes)
        assertEquals(kept, progress.resumed)
        assertEquals(if (mode == "complete-416") 416U else if (kept == 0L) 200U else 206U, result.head.status)
        assertFalse(downloadExists(resume.partialFile))
        assertFalse(downloadExists(resume.metadataFile))
    } catch (error: Throwable) { failed.value = Some(error) }
    if (expectedFailure) {
        assertTrue(downloadPresent(failed.value))
        assertEquals("original", String.fromUtf8(downloadRead(target)))
        assertTrue(downloadExists(resume.metadataFile))
        if (downloadPresent(reason)) {
            assertTrue(failed.value!! is HttpResumeException)
            assertEquals(reason!!, (failed.value!! as HttpResumeException).reason)
        } else if (mode == "status") {
            assertTrue(failed.value!! is HttpStatusException)
            assertEquals(404U, (failed.value!! as HttpStatusException).head.status)
        } else assertTrue(failed.value!! is HttpException)
    } else if (downloadPresent(failed.value)) throw failed.value!!
}

private fun resumeFailureReason(mode: String): HttpResumeFailureReason? = when (mode) {
    "fail-200", "fail-tag", "encoding", "cookie", "authorization", "final-url" -> Some(HttpResumeFailureReason.RepresentationChanged)
    "start", "total", "unknown-range", "length", "long", "bad-416" -> Some(HttpResumeFailureReason.InvalidRange)
    "short" -> Some(HttpResumeFailureReason.IncompleteRange)
    else -> None
}
