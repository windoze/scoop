package scoop.tests

import scoop.asyncio.*
import scoop.crypto.x509.TrustStore
import scoop.http.client.*
import scoop.url.Url

internal fun proxyRouting(mode: String, first: Url, second: Url, target: Url, trust: TrustStore) {
    val left = HttpProxy.Http(HttpProxyEndpoint(first, proxyTls(trust), Some(proxyCredentials())))
    val right =
        HttpProxy.Http(
            HttpProxyEndpoint(
                if (mode == "identity")
                    first
                else
                    second,
                proxyTls(trust),
                Some(proxyCredentials("cHJveHk6b3RoZXI="))
            )
        )
    val selections = AtomicLong(0L)
    val selector =
        HttpProxySelector(
            suspend {
                request ->
                proxyCheck(request.url.httpOrigin() == target.httpOrigin())
                val number = selections.fetchAdd(1L)
                if (mode == "routes") {
                    if (number == 1L)
                        right
                    else
                        left
                }
                else
                    if (mode == "identity" && number == 1L)
                        right
                    else
                        left
            }
        )
    val loop: EventLoop = PlatformEventLoop()
    loop.run suspend {
        _ -> withHttpClient(proxyConfig(trust, selector, mode)) suspend {
            client ->
            proxyDone(
                client,
                target,
                if (mode == "routes")
                    "one"
                else
                    "ok"
            )
            if (mode == "override") {
                proxyDone(
                    client,
                    target,
                    options = HttpCallOptions(proxy = Some(HttpProxySelector.direct()))
                )
                proxyCheck(selections.load() == 1L)
            } else {
                proxyDone(
                    client,
                    target,
                    if (mode == "routes")
                        "two"
                    else
                        "ok"
                )
                if (mode == "routes")
                    proxyDone(client, target, "one")
                proxyCheck(
                    selections.load() ==
                        (
                            if (mode == "routes")
                                3L
                            else
                                2L
                        )
                )
            }
        }
    }
}

internal fun proxyDigest(proxy: Url, target: Url, trust: TrustStore) {
    val endpoint =
        HttpProxy.Http(HttpProxyEndpoint(proxy, proxyTls(trust), Some(proxyCredentials())))
    val selections = AtomicLong(0L)
    val credentials = AtomicLong(0L)
    val selector =
        HttpProxySelector(
            suspend {
                _ ->
                selections.fetchAdd(1L);
                endpoint
            }
        )
    val authenticator =
        HttpAuthenticator.digest(target.httpOrigin()) suspend {
            request ->
            proxyCheck(request.attempt == 1L)
            credentials.fetchAdd(1L)
            HttpPasswordCredentials("Mufasa", "Circle of Life")
        }
    val loop: EventLoop = PlatformEventLoop()
    loop.run suspend {
        _ -> withHttpClient(
            proxyConfig(trust, selector, "digest", HttpAuthenticationOptions([authenticator]))
        ) suspend {
            client -> client.withResponse(HttpRequest.get(target)) suspend {
                response -> proxyCheck(
                    response.authenticationCount == 1L && response.body.text(2L) == "ok"
                )
            }
        }
    }
    proxyCheck(selections.load() == 2L && credentials.load() == 1L)
}
