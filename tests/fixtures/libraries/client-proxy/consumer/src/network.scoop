package scoop.tests
import scoop.asyncio.*
import scoop.crypto.x509.TrustStore
import scoop.http.*
import scoop.http.client.*
import scoop.text.*
import scoop.tls.*
import scoop.url.Url

internal fun proxyNetwork(mode: String, proxy: Url, target: Url, trust: TrustStore) {
    val route: HttpProxy = if (mode.startsWith("socks-")) {
        val credentials = if (mode == "socks-auth") Some(Socks5Credentials.fromUtf8("代理", "secret\u{0000}")) else None
        HttpProxy.Socks5(HttpSocks5Endpoint(proxy, credentials,
            if (mode == "socks-local") Socks5Resolution.Local else Socks5Resolution.Proxy))
    } else HttpProxy.Http(HttpProxyEndpoint(proxy, proxyTls(trust, mode == "proxy-untrusted"), Some(proxyCredentials())))
    val loop: EventLoop = LibuvEventLoop()
    loop.run suspend { _ ->
        withHttpClient<Unit>(proxyConfig(trust, HttpProxySelector.fixed(route), mode)) suspend { client ->
            if (mode == "reject") {
                val started = AtomicLong(0L)
                val body = RequestBody.fromProducer(Some(6L)) suspend { output ->
                    started.fetchAdd(1L); proxyWrite(output, "abcdef")
                }
                val failure = proxyFailure<HttpProxyConnectException> suspend {
                    client.execute(HttpRequest.post(target, body)).close()
                }
                proxyCheck(failure.proxyUrl == proxy && failure.responseHead.status == 407U && started.load() == 0L)
                proxyCheck(failure.responseHead.fields.findAll("Proxy-Authenticate".toByteArray()).size == 1L)
            } else if (mode == "socks-reject") {
                val failure = proxyFailure<Socks5Exception> suspend { client.execute(HttpRequest.get(target)).close() }
                proxyCheck(failure.phase == Socks5Phase.Connect && failure.replyCode == Some(5.toUByte()))
            } else if (mode == "proxy-zero" || mode == "socks-zero" || mode == "proxy-deadline" || mode == "socks-deadline") {
                val started = AtomicLong(0L)
                val body = RequestBody.fromProducer(Some(6L)) suspend { output ->
                    started.fetchAdd(1L); proxyWrite(output, "abcdef")
                }
                val failure = proxyFailure<HttpTimeoutException> suspend { client.execute(HttpRequest.post(target, body)).close() }
                proxyCheck(failure.phase == HttpTimeoutPhase.ProxyHandshake && failure.requestBodyBytes == 0L && started.load() == 0L)
                if (mode == "proxy-deadline" || mode == "socks-deadline") {
                    proxyDone(client, target, options = HttpCallOptions(timeouts = Some(HttpTimeoutOptions(
                        resolve = None, connect = None, tlsHandshake = None, proxyHandshake = None))))
                }
            } else if (mode == "proxy-untrusted" || mode == "target-untrusted") {
                val failure = proxyFailure<TlsException> suspend { client.execute(HttpRequest.get(target)).close() }
                proxyCheck(failure.kind == TlsFailureKind.Verification)
            } else if (mode == "forward" || mode == "forward-tls") {
                val started = AtomicLong(0L)
                val body = RequestBody.fromProducer() suspend { output ->
                    started.fetchAdd(1L); proxyWrite(output, "abc"); output.flush(); proxyWrite(output, "def")
                }
                client.withResponse(HttpRequest.post(target, body, proxyFields())) suspend { response ->
                    proxyCheck(response.version == HttpVersion.Http11 && response.body.text(2L) == "ok")
                }
                proxyCheck(started.load() == 1L)
            } else {
                proxyDone(client, target, version = if (proxyH2(mode)) HttpVersion.Http2
                    else if (mode == "http10") HttpVersion.Http10 else HttpVersion.Http11)
            }
        }
    }
}
