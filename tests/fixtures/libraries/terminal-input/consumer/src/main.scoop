package test
import scoop.platform.time.*
import scoop.terminal.*
import scoop.terminal.event.*
import scoop.time.Duration

fun main() {
    installResize(0)
    TerminalSession.open(Duration.milliseconds(250L)).use { session ->
        session.withRawMode { inputs(session) }
    }
    verifyResize()
    for (mode in 1L..4L) {
        installResize(mode.toInt())
        TerminalSession.open().use { session ->
            stage("resize-" + mode.toString())
            expect(session.read(), Event.Resize(30L + mode, 12L + mode), "resize notification")
        }
        verifyResize()
    }
    eof()
    stage("input-finished")
}

fun inputs(session: TerminalSession) {
    check(!session.poll(Duration.ZERO), "empty poll")
    val start = MonotonicTimeSource.markNow()
    check(!session.poll(Duration.milliseconds(20L)), "finite poll without input")
    check(start.elapsedNow() >= Duration.milliseconds(20L), "poll deadline")
    var rejected = false
    try { session.poll(Duration.milliseconds(-1L)) }
    catch (error: IllegalArgumentException) { rejected = true }
    check(rejected, "negative poll duration")
    stage("utf8-prefix")
    check(!session.poll(Duration.milliseconds(20L)), "UTF-8 prefix is not an event")
    stage("utf8-tail")
    expect(session.read(), key('é'), "fragmented UTF-8")
    stage("pair")
    check(session.poll(Duration.seconds(1L)), "complete key available")
    check(session.poll(Duration.ZERO), "poll must retain the event")
    expect(session.read(), key('a'), "first queued key")
    expect(session.read(), key('b'), "second queued key")
    stage("escape")
    check(!session.poll(Duration.milliseconds(1L)), "poll must not wait the Escape delay")
    stage("escape-pending")
    expect(session.read(), Event.Key(KeyEvent(KeyCode.Esc)), "standalone Escape")
    stage("escape-done")
    events(session)
}

fun events(session: TerminalSession) {
    stage("events")
    expect(session.read(), Event.FocusGained, "focus")
    expect(session.read(), Event.Mouse(MouseEvent(MouseEventKind.Down(MouseButton.Left), 6L, 2L)), "mouse")
    expect(session.read(), Event.Paste("hello"), "paste")
    expect(session.read(), Event.Key(KeyEvent(KeyCode.Char('a'),
        KeyModifiers().with(KeyModifier.Control), KeyEventKind.Release)), "Kitty release")
    stage("invalid")
    var rejected = false
    try { session.read() } catch (error: TerminalInputException) { rejected = true }
    check(rejected, "invalid UTF-8")
    expect(session.read(), key('z'), "input after invalid byte")
    stage("resize-0")
    val first = session.read()
    val second = session.read()
    check((first == Event.Resize(30L, 12L) && second == key('k'))
        || (second == Event.Resize(30L, 12L) && first == key('k')), "resize with input")
}

fun eof() {
    TerminalSession.open(Duration.milliseconds(250L)).use { session ->
        stage("eof-prefix")
        check(!session.poll(Duration.milliseconds(1L)), "partial Escape before EOF")
        stage("eof-next")
        expect(session.read(), Event.Key(KeyEvent(KeyCode.Esc)), "EOF preserves Escape")
        var disconnected = false
        try { session.read() } catch (error: TerminalDisconnectedException) { disconnected = true }
        check(disconnected, "read EOF")
        disconnected = false
        try { session.poll(Duration.ZERO) } catch (error: TerminalDisconnectedException) { disconnected = true }
        check(disconnected, "poll EOF")
    }
}
