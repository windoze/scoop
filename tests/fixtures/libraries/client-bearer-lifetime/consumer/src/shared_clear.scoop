package scoop.tests
import scoop.asyncio.*
import scoop.crypto.x509.TrustStore
import scoop.http.client.*

internal fun bearerSharedClear(trust: TrustStore) {
    withBearerRuntime suspend { _, scope, listener ->
        val entered = BearerGate()
        val release = BearerGate()
        val cleaning = BearerGate()
        val finish = BearerGate()
        val url = bearerUrl(listener)
        val cleanup = Throwable()
        val provider = HttpAuthenticator.bearer(url.httpOrigin()) suspend { _ ->
            try { entered.signal(); release.await(); HttpBearerTokens("unused") }
            finally { cleaning.signal(); finish.await(); throw cleanup }
        }
        val client = HttpClient.open(scope, bearerConfig(trust, HttpAuthenticationOptions([provider])))
        val firstFailure = BearerFailureHolder()
        val secondFailure = BearerFailureHolder()
        val closeFailure = BearerFailureHolder()
        val first = scope.launch suspend {
            try { client.execute(HttpRequest.get(url)).close() }
            catch (error: Throwable) { firstFailure.value = Some(error) }
        }
        entered.await()
        val second = scope.launch suspend {
            try { client.execute(HttpRequest.get(url)).close() }
            catch (error: Throwable) { secondFailure.value = Some(error) }
        }
        try {
            client.clearAuthenticationCache(provider)
            bearerCheck(!first.isCompleted && !second.isCompleted)
            release.signal(); cleaning.await()
            val closing = scope.launch suspend {
                try { client.close() }
                catch (error: Throwable) { closeFailure.value = Some(error) }
            }
            bearerCheck(!closing.isCompleted)
            finish.signal(); first.join(); second.join(); closing.join()
            for (holder in [firstFailure, secondFailure]) {
                val error = holder.value!!
                bearerCheck(error is ResourceUseException)
                if (error is ResourceUseException)
                    bearerCheck(error.cleanupFailure === cleanup && error.primaryFailure is CancellationException)
            }
            bearerCheck(closeFailure.value!! === cleanup, "client.close repeated one shared cleanup failure")
        } finally { release.signal(); finish.signal(); client.close() }
    }
}
