package test
import scoop.asyncio.*
import scoop.platform.memory.NativeByteBuffer
import scoop.platform.system.PlatformException
import scoop.terminal.TerminalSession

fun check(value: Boolean, message: String) {
    if (!value) {
        eprintln(message)
        throw IllegalStateException(Some(message))
    }
}

suspend fun stage(tty: AsyncTty, name: String) {
    val bytes = ("\u001b]0;" + name + "\u0007").toByteArray()
    NativeByteBuffer.allocate(bytes.size).use suspend { output ->
        output.writeBytes(bytes)
        tty.writeFully(output)
        check(output.readableBytes == 0L, "TTY write progress")
        tty.flush()
    }
    gcCollect()
}

suspend fun readByte(tty: AsyncTty, expected: Byte) {
    NativeByteBuffer.allocate(1L).use suspend { buffer ->
        check(tty.receive(buffer, 1L) == TtyRead.Bytes(1L), "TTY read count")
        check(buffer.readByte() == expected, "TTY read byte")
    }
}

suspend fun ownership(loop: EventLoop, tty: AsyncTty) {
    var rejected = false
    try { TerminalSession.open().close() }
    catch (_: PlatformException) { rejected = true }
    check(rejected, "sync owner conflicts with async owner")
    rejected = false
    try { loop.openTty().close() }
    catch (_: PlatformException) { rejected = true }
    check(rejected, "second async owner")
    check(!tty.isClosed, "failed open preserves original owner")
}
