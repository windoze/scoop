package scoop.tests

import scoop.asyncio.*
import scoop.tests.scoop.crypto.testdata.*
import scoop.platform.fs.Path
import scoop.platform.io.*
import scoop.platform.memory.NativeByteBuffer
import scoop.platform.net.*
import scoop.tls.*
import scoop.tls.asyncio.*

fun synchronousCaFile(path: Path, port: Int, version: TlsVersion) {
    val context =
        TlsIdentity.fromPem(clientPem() + intermediatePem(), serverKeyPem()).use {
            identity -> TlsClientContext.fromCaFile(
                path,
                TlsOptions(version, version),
                Some(identity)
            )
        }
    context.use {
        TlsStream.takeOwnershipAsClient(
            TcpStream.connect(SocketAddress(IpAddress.IPV4_LOOPBACK, port)),
            context,
            TlsPeerName.Dns("localhost")
        ).use {
            stream ->
            context.close()
            check(stream.connectionInfo.version == version)
            stream.writeAllBytes("mtls".toByteArray())
            NativeByteBuffer.allocate(4L).use {
                buffer ->
                stream.readFully(buffer)
                check(String.fromUtf8(buffer.readBytes(4L)) == "peer")
            }
            stream.shutdownGracefully()
        }
    }
}

fun asynchronousCaFile(path: Path, port: Int, version: TlsVersion) {
    val loop: EventLoop = PlatformEventLoop()
    loop.run suspend {
        _ ->
        val context =
            TlsIdentity.fromPem(clientPem() + intermediatePem(), serverKeyPem()).use suspend {
                identity -> openTlsClientContext(path, TlsOptions(version, version), Some(identity))
            }
        try {
            val raw = loop.connectTcp(SocketAddress(IpAddress.IPV4_LOOPBACK, port))
            val stream =
                AsyncTlsStream.takeOwnershipAsClient(raw, context, TlsPeerName.Dns("localhost"))
            try {
                context.close()
                check(stream.connectionInfo.version == version)
                NativeByteBuffer.allocate(4L).use suspend {
                    buffer ->
                    buffer.writeBytes("mtls".toByteArray())
                    stream.writeFully(buffer)
                    buffer.clear()
                    stream.readFully(buffer, 4L)
                    check(String.fromUtf8(buffer.readBytes(4L)) == "peer")
                    stream.shutdownGracefully()
                }
            } finally {
                stream.close()
            }
        } finally {
            context.close()
        }
    }
}
