package scoop.tests
import scoop.asyncio.*
import scoop.crypto.*
import scoop.tls.TlsTrustSource
import scoop.crypto.x509.TrustStore
import scoop.http.*
import scoop.http.asyncio.AsyncHttp2Connection
import scoop.http.client.*
import scoop.platform.memory.NativeByteBuffer
import scoop.time.Duration

internal fun digestHttp2(trust: TrustStore) {
    withDigestRuntime suspend { _, scope, listener ->
        val url = digestUrl(listener)
        val firstSeen = DigestGate()
        val credentialsReady = DigestGate()
        val done = DigestGate()
        val started = AtomicLong(0L)
        val callback = AtomicLong(0L)
        val provider = HttpAuthenticator.digest(url.httpOrigin()) suspend { request ->
            digestCheck(request.attempt == 1L && started.load() == 0L)
            callback.fetchAdd(1L)
            credentialsReady.await()
            HttpPasswordCredentials("Aladdin", "open sesame")
        }
        val serving = scope.launch suspend {
            AsyncHttp2Connection.takeOwnershipAsServer(listener.accept(), scope).useAsync suspend { connection ->
                val first = connection.acceptRequest()!!
                digestCheck(first.stream.id == 1)
                firstSeen.signal()
                val other = connection.acceptRequest()!!
                digestCheck(other.stream.id == 3)
                first.stream.sendResponse(HttpResponseHead(HttpVersion.Http2, 401U, fields = [
                    digestField("WWW-Authenticate", "Digest realm=\"private\", nonce=\"nonce\", algorithm=SHA-256, qop=auth-int"),
                    digestField("Content-Encoding", "unneeded-coding")
                ]), false)
                other.stream.sendResponse(HttpResponseHead(HttpVersion.Http2, 200U), false)
                digestWrite(other.stream, "left")
                other.stream.flush()
                val authenticated = connection.acceptRequest()!!
                digestCheck(authenticated.stream.id == 5)
                val field = authenticated.head.fields.findAll("Authorization".toByteArray())[0L]
                val authorization = HttpCredentials.parse(field.value)
                digestCheck(field.neverIndex && authorization.scheme == "digest")
                digestCheck(String.fromUtf8(authorization.parameter("qop")!!.value) == "auth-int")
                digestCheck(String.fromUtf8(authorization.parameter("uri")!!.value) == "/private/start")
                digestCheck(String.fromUtf8(authorization.parameter("nc")!!.value) == "00000001")
                authenticated.stream.sendResponse(HttpResponseHead(HttpVersion.Http2, 100U), false)
                digestCheck(String.fromUtf8(authenticated.stream.readAllBytes(4L)) == "once")
                authenticated.stream.sendResponse(HttpResponseHead(HttpVersion.Http2, 200U), false)
                digestWrite(authenticated.stream, "done"); authenticated.stream.finish()
                digestWrite(other.stream, "right"); other.stream.finish()
                done.await()
            }
        }
        try {
            withHttpClient(HttpClientConfig(tls = HttpClientTlsConfig(TlsTrustSource.Store(trust)),
                authentication = HttpAuthenticationOptions([provider]), cleartext = HttpCleartextProtocol.Http2PriorKnowledge)) suspend { client ->
                val failure = DigestFailureHolder()
                val body = RequestBody.fromProducer(Some(4L)) suspend { output ->
                    started.fetchAdd(1L); digestWrite(output, "once")
                }.withDigest(HttpDigestAlgorithm.Sha256, digest(DigestAlgorithm.Sha256, "once".toByteArray()))
                val executing = scope.launch suspend {
                    try {
                        client.withResponse(HttpRequest.post(url, body, options = HttpCallOptions(expectContinue = true,
                            continueWait = Duration.seconds(3600L)))) suspend { response ->
                            digestCheck(response.authenticationCount == 1L && response.body.text(4L) == "done")
                        }
                    } catch (error: Throwable) { failure.value = Some(error) }
                }
                firstSeen.await()
                client.withResponse(HttpRequest.get(url.resolve("/public"))) suspend { response ->
                    NativeByteBuffer.allocate(4L).use suspend { buffer ->
                        response.body.readFully(buffer)
                        digestCheck(String.fromUtf8(buffer.readBytes(4L)) == "left")
                    }
                    credentialsReady.signal()
                    digestCheck(response.body.text(5L) == "right" && response.authenticationCount == 0L)
                }
                executing.join()
                digestCheck(!digestPresent(failure.value) && started.load() == 1L && callback.load() == 1L)
            }
        } finally { credentialsReady.signal(); done.signal() }
        serving.join()
    }
}
