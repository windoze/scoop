package scoop.tests
import scoop.asyncio.*
import scoop.crypto.x509.TrustStore
import scoop.http.client.*
import scoop.time.Duration
import scoop.url.Url

internal fun digestConcurrent(mode: String, url: Url, trust: TrustStore) {
    val loop: EventLoop = LibuvEventLoop()
    loop.run suspend { scope ->
        val calls = AtomicLong(0L)
        val provider = HttpAuthenticator.digest(url.httpOrigin()) suspend { request ->
            val saved = digestContext()
            digestCheck(request.request.url.encodedPath == "/private/" + saved)
            calls.fetchAdd(1L)
            loop.sleep(Duration.milliseconds(2L))
            digestCheck(digestContext() == saved)
            HttpPasswordCredentials("Mufasa", "Circle of Life")
        }
        withHttpClient(digestConfig(trust, provider)) suspend { client ->
            if (mode == "clear-active") {
                context(DigestContext("start")) {
                    client.withResponse(HttpRequest.get(url)) suspend { response ->
                        client.clearAuthenticationCache(provider)
                        val next = context(DigestContext("new")) {
                            scope.async<Unit> suspend { digestDone(client, url.resolve("new"), 1L) }
                        }
                        digestCheck(response.body.text(4L) == "done")
                        next.await()
                    }
                }
                context(DigestContext("final")) { digestDone(client, url.resolve("final"), 0L) }
                digestCheck(calls.load() == 3L)
            } else {
                context(DigestContext("start")) { digestDone(client, url, 1L) }
                val first = context(DigestContext("a")) { scope.async<Unit> suspend { digestDone(client, url.resolve("a"), 0L) } }
                val second = context(DigestContext("b")) {
                    scope.async<Unit> suspend { digestDone(client, url.resolve("b"), if (mode == "late-401") 1L else 0L) }
                }
                first.await()
                context(DigestContext("ack")) { digestDone(client, url.resolve("ack"), 0L) }
                second.await()
                context(DigestContext("final")) { digestDone(client, url.resolve("final"), 0L) }
                digestCheck(calls.load() == 5L)
            }
        }
    }
}

private suspend fun digestDone(client: HttpClient, url: Url, attempts: Long) {
    client.withResponse(HttpRequest.get(url)) suspend { response ->
        digestCheck(response.authenticationCount == attempts && response.body.text(4L) == "done")
    }
}
