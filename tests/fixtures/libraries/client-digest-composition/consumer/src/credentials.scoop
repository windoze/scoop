package scoop.tests
import scoop.asyncio.*
import scoop.charset.CharsetException
import scoop.crypto.x509.TrustStore
import scoop.http.client.*
import scoop.platform.system.PlatformErrorKind
import scoop.platform.system.PlatformException
import scoop.time.Duration
import scoop.tls.TlsTrustSource

internal fun digestCredentials(trust: TrustStore, mode: String) {
    withDigestRuntime suspend { _, scope, listener ->
        val url = digestUrl(listener)
        val calls = AtomicLong(0L)
        val original = PlatformException("credentials", PlatformErrorKind.ConnectionReset)
        val provider = HttpAuthenticator.digest(url.httpOrigin()) suspend { request ->
            digestCheck(request.attempt == 1L && request.challenge!!.scheme == "digest")
            calls.fetchAdd(1L)
            if (mode == "callback") throw original
            if (mode == "nested") coroutineScope<Unit> suspend { child ->
                child.async<Unit> suspend { throw original }; Unit
            }
            HttpPasswordCredentials(if (mode == "user") "user:bad" else if (mode == "encoding") "中文" else "user",
                if (mode == "password") "bad\u{007F}" else "password")
        }
        val serving = scope.launch suspend { digestChallengeOnce(listener, scope) }
        withHttpClient(HttpClientConfig(tls = HttpClientTlsConfig(TlsTrustSource.Store(trust)),
            authentication = HttpAuthenticationOptions([provider]),
            retries = HttpRetryOptions(maxRetries = 2L, initialDelay = Duration.ZERO, maxDelay = Duration.ZERO))) suspend { client ->
            val failure = digestFailure<Throwable> suspend { client.execute(HttpRequest.get(url)).close() }
            if (mode == "callback" || mode == "nested") digestCheck(failure === original)
            else {
                digestCheck(failure is HttpAuthenticationException)
                if (failure is HttpAuthenticationException) {
                    digestCheck(failure.reason == HttpAuthenticationFailure.InvalidCredentials)
                    if (mode == "encoding") digestCheck(failure.cause!! is CharsetException)
                }
            }
            Unit
        }
        serving.join()
        digestCheck(calls.load() == 1L)
    }
}
