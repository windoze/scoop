package scoop.tests
import scoop.tests.scoop.crypto.testdata.rootPem
import scoop.crypto.x509.TrustStore
import scoop.platform.concurrent.Thread
import scoop.url.Url

private fun exercise(args: Array<String>, trust: TrustStore, index: Long) {
    when (args[1L]) {
        case "credentials" -> digestCredentials(trust, args[2L])
        case "http2" -> digestHttp2(trust)
        case "metadata" -> digestMetadata(Url.parse(args[index]), trust)
        case "late-401" -> digestConcurrent(args[1L], Url.parse(args[index]), trust)
        case "late-nextnonce" -> digestConcurrent(args[1L], Url.parse(args[index]), trust)
        case "clear-active" -> digestConcurrent(args[1L], Url.parse(args[index]), trust)
        else -> digestRouting(args[1L], Url.parse(args[index]), trust)
    }
}

private fun runMain(args: Array<String>) {
    digestCheck(args.size >= 2L && args.size <= 4L)
    TrustStore.fromPem(rootPem()).use { trust ->
        Thread.start { exercise(args, trust, 2L) }.use { thread -> exercise(args, trust, 3L); thread.join() }
    }
    println("Digest composition " + args[1L])
}

fun main(args: Array<String>) {
    try { runMain(args) }
    catch (error: Throwable) { digestReport(error); throw error }
}
