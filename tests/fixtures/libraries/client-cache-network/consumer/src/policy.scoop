package scoop.tests

import scoop.asyncio.*
import scoop.collections.emptyList
import scoop.crypto.x509.TrustStore
import scoop.http.*
import scoop.http.client.*
import scoop.test.*
import scoop.time.*
import scoop.url.Url

private class PolicyCache(
    val fields: Array<HttpField>,
    val sent: Instant,
    val received: Instant
): HttpCache {
    private val storage: MemoryHttpCache = MemoryHttpCache()
    public override suspend fun lookup(request: HttpCacheRequest): HttpCacheSnapshot? {
        storage.clear()
        val record =
            HttpCacheRecord(
                request.key,
                HttpResponseHead(HttpVersion.Http11, 200U, fields = fields),
                sent,
                received
            )
        storage.begin(record)!!.useAsync suspend { writer -> writer.commit(emptyList<HttpField>()) }
        return storage.lookup(request)
    }
    public override suspend fun begin(record: HttpCacheRecord): HttpCacheWriter? = None
    public override suspend fun invalidate(partition: String, url: String) {}
}

private class PolicyCase(
    val name: String,
    val fields: Array<HttpField>,
    val now: Long,
    val hit: Boolean,
    val request: Array<HttpField> = [],
    val sent: Long = 0L,
    val received: Long = 0L,
    val age: Long = 0L
)

internal fun cachePolicies(trust: TrustStore) {
    val origin = Instant.parse("2026-10-20T00:00:00Z")
    val date = cacheField("Date", HttpDate.format(origin))
    val maximum = cacheField("Cache-Control", "max-age=60")
    val cases =
        [
            PolicyCase(
                "age and response delay",
                [date, maximum, cacheField("Age", "5")],
                30L,
                true,
                received = 10L,
                age = 35L
            ),
            PolicyCase("expired", [date, maximum, cacheField("Age", "70")], 0L, false),
            PolicyCase("invalid age", [date, maximum, cacheField("Age", "oops")], 0L, false),
            PolicyCase(
                "first age",
                [date, maximum, cacheField("Age", "1"), cacheField("Age", "90")],
                0L,
                true,
                age = 1L
            ),
            PolicyCase("invalid date", [maximum, cacheField("Date", "not-a-date")], 0L, false),
            PolicyCase("duplicate date", [date, date, maximum], 0L, false),
            PolicyCase(
                "invalid max-age",
                [date, cacheField("Cache-Control", "max-age=x")],
                0L,
                false
            ),
            PolicyCase(
                "duplicate max-age",
                [date, cacheField("Cache-Control", "max-age=60, max-age=120")],
                0L,
                false
            ),
            PolicyCase(
                "expires",
                [date, cacheField("Expires", HttpDate.format(origin + Duration.seconds(120L)))],
                20L,
                true,
                age = 20L
            ),
            PolicyCase("invalid expires", [date, cacheField("Expires", "0")], 0L, false),
            PolicyCase(
                "heuristic fresh",
                [
                    date,
                    cacheField("Last-Modified", HttpDate.format(origin - Duration.seconds(100L)))
                ],
                5L,
                true,
                age = 5L
            ),
            PolicyCase(
                "heuristic stale",
                [
                    date,
                    cacheField("Last-Modified", HttpDate.format(origin - Duration.seconds(100L)))
                ],
                11L,
                false
            ),
            PolicyCase(
                "max-stale",
                [date, maximum],
                90L,
                true,
                [cacheField("Cache-Control", "max-stale=30")],
                age = 90L
            ),
            PolicyCase(
                "max-stale exceeded",
                [date, maximum],
                91L,
                false,
                [cacheField("Cache-Control", "max-stale=30")]
            ),
            PolicyCase(
                "must-revalidate",
                [date, cacheField("Cache-Control", "max-age=60, must-revalidate")],
                70L,
                false,
                [cacheField("Cache-Control", "max-stale")]
            ),
            PolicyCase(
                "response no-cache",
                [date, cacheField("Cache-Control", "max-age=60, no-cache")],
                0L,
                false
            ),
            PolicyCase(
                "request no-cache",
                [date, maximum],
                0L,
                false,
                [cacheField("Cache-Control", "no-cache")]
            ),
            PolicyCase(
                "request no-store",
                [date, maximum],
                0L,
                false,
                [cacheField("Cache-Control", "no-store")]
            ),
            PolicyCase(
                "min-fresh",
                [date, maximum],
                10L,
                false,
                [cacheField("Cache-Control", "min-fresh=50")]
            ),
            PolicyCase(
                "request max-age",
                [date, maximum],
                10L,
                false,
                [cacheField("Cache-Control", "max-age=5")]
            ),
            PolicyCase(
                "private",
                [
                    date,
                    cacheField("Cache-Control", "private, max-age=60, s-maxage=0, proxy-revalidate")
                ],
                10L,
                true,
                age = 10L
            ),
            PolicyCase("wildcard", [date, maximum, cacheField("Vary", "*")], 0L, false),
            PolicyCase("pragma", [date, maximum], 0L, false, [cacheField("Pragma", "no-cache")]),
            PolicyCase(
                "cache-control overrides pragma",
                [date, maximum],
                0L,
                true,
                [cacheField("Cache-Control", "max-age=50"), cacheField("Pragma", "no-cache")]
            )
        ]
    PlatformEventLoop().run suspend {
        _ -> for (value in cases) {
            val clock = CacheClock(origin + Duration.seconds(value.now))
            val storage =
                PolicyCache(
                    value.fields,
                    origin + Duration.seconds(value.sent),
                    origin + Duration.seconds(value.received)
                )
            withHttpClient(cacheConfig(trust, storage, clock)) suspend {
                client -> client.withResponse(
                    HttpRequest.get(
                        Url.parse("http://policy.invalid/value"),
                        value.request,
                        HttpCallOptions(cacheMode = HttpCacheMode.OnlyIfCached)
                    )
                ) suspend {
                    response ->
                    assertEquals(
                        if (value.hit)
                            HttpCacheStatus.Hit
                        else
                            HttpCacheStatus.Unsatisfied,
                        response.cacheStatus,
                        Some(value.name)
                    )
                    assertEquals(
                        if (value.hit)
                            200U
                        else
                            504U,
                        response.status
                    )
                    if (value.hit)
                        assertEquals(value.age, HttpAge.parseFields(response.fields)!!.seconds)
                    assertEquals("", response.body.text(0L))
                }
            }
        }
    }
}
