package scoop.tests

import scoop.asyncio.*
import scoop.crypto.x509.TrustStore
import scoop.http.*
import scoop.http.client.*
import scoop.test.*
import scoop.url.Url

internal fun cacheExternal(trust: TrustStore, mode: String, url: Url) {
    val storage = MemoryHttpCache()
    val clock = CacheClock()
    PlatformEventLoop().run suspend {
        _ -> withHttpClient(cacheConfig(trust, storage, clock)) suspend {
            client -> when (
                if (mode == "modified")
                    "etag"
                else
                    mode
            ) {
                case "fresh" -> {
                    cacheGet(client, url, "encoded-cache", HttpCacheStatus.Network)
                    clock.advance(10L)
                    client.withResponse(HttpRequest.get(url)) suspend {
                        response ->
                        assertEquals(HttpCacheStatus.Hit, response.cacheStatus)
                        assertEquals(15L, HttpAge.parseFields(response.fields)!!.seconds)
                        assertEquals("encoded-cache", response.body.text(64L))
                    }
                    val raw =
                        HttpCallOptions(
                            decoding = Some(HttpDecodingOptions(HttpContentDecoding.Raw))
                        )
                    client.withResponse(
                        HttpRequest.get(
                            url,
                            [cacheField("Accept-Encoding", "gzip, deflate, br, zstd")],
                            raw
                        )
                    ) suspend {
                        response ->
                        assertEquals(HttpCacheStatus.Hit, response.cacheStatus)
                        val bytes = response.body.bytes(64L)
                        assertEquals(31.toByte(), bytes[0L]);
                        assertEquals(139.toByte(), bytes[1L])
                        assertEquals(Some(bytes.size), response.wireContentLength)
                    }
                }
                case "etag" -> {
                    cacheGet(client, url, "original", HttpCacheStatus.Network)
                    clock.advance(10L)
                    client.withResponse(HttpRequest.get(url)) suspend {
                        response ->
                        assertEquals(HttpCacheStatus.Revalidated, response.cacheStatus)
                        assertEquals("original", response.body.text(32L))
                        assertEquals(
                            "updated",
                            String.fromUtf8(
                                response.fields.findAll("X-Meta".toByteArray())[0L].value
                            )
                        )
                    }
                    clock.advance(5L)
                    cacheGet(client, url, "original", HttpCacheStatus.Hit)
                }
                case "mismatch" -> {
                    cacheGet(client, url, "original", HttpCacheStatus.Network)
                    clock.advance(10L)
                    client.withResponse(HttpRequest.get(url)) suspend {
                        response ->
                        assertEquals(HttpCacheStatus.Network, response.cacheStatus)
                        assertEquals(0L, response.retryCount)
                        assertEquals("changed", response.body.text(32L))
                    }
                    cacheGet(client, url, "changed", HttpCacheStatus.Hit)
                }
                case "controls" -> {
                    cacheGet(client, url, "first", HttpCacheStatus.Network)
                    cacheGet(
                        client,
                        url,
                        "bypass",
                        HttpCacheStatus.Network,
                        options = HttpCallOptions(cacheMode = HttpCacheMode.Bypass)
                    )
                    cacheGet(client, url, "first", HttpCacheStatus.Hit)
                    cacheGet(
                        client,
                        url,
                        "reload",
                        HttpCacheStatus.Network,
                        options = HttpCallOptions(cacheMode = HttpCacheMode.Reload)
                    )
                    cacheGet(
                        client,
                        url,
                        "reload",
                        HttpCacheStatus.Hit,
                        options = HttpCallOptions(cacheMode = HttpCacheMode.OnlyIfCached)
                    )
                    cacheGet(
                        client,
                        url,
                        "private",
                        HttpCacheStatus.Network,
                        fields = [cacheField("Cache-Control", "no-store")]
                    )
                    cacheGet(client, url, "reload", HttpCacheStatus.Hit)
                    cacheGet(
                        client,
                        url,
                        "conditional",
                        HttpCacheStatus.Network,
                        fields = [cacheField("If-None-Match", "\"manual\"")]
                    )
                    cacheGet(client, url, "reload", HttpCacheStatus.Hit)
                    client.withResponse(
                        HttpRequest.get(
                            url.resolve("/missing"),
                            options = HttpCallOptions(cacheMode = HttpCacheMode.OnlyIfCached)
                        )
                    ) suspend {
                        response ->
                        assertEquals(HttpCacheStatus.Unsatisfied, response.cacheStatus)
                        assertEquals(504U, response.status);
                        assertEquals("", response.body.text(0L))
                    }
                }
                case "vary" -> {
                    for (value in ["red", "blue"])
                        cacheGet(
                            client,
                            url,
                            value,
                            HttpCacheStatus.Network,
                            [cacheField("X-Mode", value)]
                        )
                    cacheGet(client, url, "red", HttpCacheStatus.Hit, [cacheField("X-Mode", "red")])
                    cacheGet(client, url, "missing", HttpCacheStatus.Network)
                    cacheGet(
                        client,
                        url,
                        "empty",
                        HttpCacheStatus.Network,
                        [cacheField("X-Mode", "")]
                    )
                    cacheGet(client, url, "missing", HttpCacheStatus.Hit)
                    cacheGet(client, url.resolve("?a=1&b=2"), "query-one", HttpCacheStatus.Network)
                    cacheGet(client, url.resolve("?b=2&a=1"), "query-two", HttpCacheStatus.Network)
                    cacheGet(client, url.resolve("?a=1&b=2"), "query-one", HttpCacheStatus.Hit)
                }
                case "nostore" -> {
                    for (suffix in ["no-store", "wildcard", "invalid", "partial"])
                        for (_ in 0L ..< 2L)
                            cacheGet(
                                client,
                                url.resolve("/" + suffix),
                                suffix,
                                HttpCacheStatus.Network
                            )
                    assertEquals(1L, storage.entryCount)
                }
                case "invalidate" -> {
                    cacheGet(client, url, "first", HttpCacheStatus.Network)
                    cacheGet(client, url.resolve("/linked"), "linked", HttpCacheStatus.Network)
                    client.withResponse(HttpRequest(url, "POST")) suspend {
                        response -> assertEquals("changed", response.body.text(32L))
                    }
                    cacheGet(client, url, "updated", HttpCacheStatus.Network)
                    cacheGet(
                        client,
                        url.resolve("/linked"),
                        "updated-linked",
                        HttpCacheStatus.Network
                    )
                }
                case "abort" -> {
                    client.execute(HttpRequest.get(url)).close()
                    assertEquals(0L, storage.entryCount)
                    cacheGet(client, url, "complete", HttpCacheStatus.Network)
                    cacheGet(client, url, "complete", HttpCacheStatus.Hit)
                    var failed = false
                    try {
                        client.withResponse(HttpRequest.get(url.resolve("/bad-gzip"))) suspend {
                            response -> response.body.bytes(64L)
                        }
                    }
                    catch (_: Throwable) {
                        failed = true
                    }
                    assertTrue(failed)
                    assertEquals(1L, storage.entryCount)
                }
                else -> throw IllegalArgumentException()
            }
        }
    }
}

internal fun cacheIdentity(trust: TrustStore, url: Url) {
    val storage = MemoryHttpCache()
    val clock = CacheClock()
    val a = [cacheField("Authorization", "Bearer A"), cacheField("Cookie", "user=A")]
    val b = [cacheField("Authorization", "Bearer B"), cacheField("Cookie", "user=A")]
    val c = [cacheField("Authorization", "Bearer A"), cacheField("Cookie", "user=B")]
    PlatformEventLoop().run suspend {
        _ ->
        withHttpClient(cacheConfig(trust, storage, clock, Some("shared"))) suspend {
            client ->
            cacheGet(client, url, "A-A", HttpCacheStatus.Network, a)
            cacheGet(client, url, "B-A", HttpCacheStatus.Network, b)
            cacheGet(client, url, "A-B", HttpCacheStatus.Network, c)
            cacheGet(client, url, "A-A", HttpCacheStatus.Hit, a)
        }
        withHttpClient(cacheConfig(trust, storage, clock, Some("shared"))) suspend {
            client ->
            cacheGet(client, url, "A-A", HttpCacheStatus.Hit, a)
            cacheGet(client, url, "B-A", HttpCacheStatus.Hit, b)
        }
        withHttpClient(cacheConfig(trust, storage, clock)) suspend {
            client -> cacheGet(client, url, "isolated", HttpCacheStatus.Network, a)
        }
        withHttpClient(cacheConfig(trust, storage, clock)) suspend {
            client -> cacheGet(client, url, "isolated-again", HttpCacheStatus.Network, a)
        }
    }
}
