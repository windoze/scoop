package scoop.tests
import scoop.asyncio.*
import scoop.crypto.x509.TrustStore
import scoop.http.*
import scoop.http.asyncio.*
import scoop.http.client.*
import scoop.platform.net.*
import scoop.tls.TlsTrustSource
import scoop.url.Url

private class TrailerContext(val value: String)

context(binding: TrailerContext)
private fun trailerContextValue(): String = binding.value

private class TrailerGate {
    private var done: Boolean = false
    private var waiter: Continuation<Unit>? = None
    fun signal() { done = true; val saved = waiter; waiter = None; saved?.resume(Unit) }
    suspend fun await() {
        suspendCoroutine<Unit> { continuation ->
            if (done) continuation.resume(Unit) else waiter = Some(continuation)
        }
    }
}

internal fun exerciseTrailerHttp2(trust: TrustStore) {
    val loop: EventLoop = LibuvEventLoop()
    loop.run suspend { scope ->
        loop.listenTcp(SocketAddress(IpAddress.IPV4_LOOPBACK, 0)).useAsync suspend { listener ->
            val done = TrailerGate()
            val serving = scope.launch suspend {
                AsyncHttp2Connection.takeOwnershipAsServer(listener.accept(), scope,
                    settings = Http2Settings(initialWindowSize = 3U, maxConcurrentStreams = 2U)).useAsync suspend { connection ->
                    val requests = [connection.acceptRequest()!!, connection.acceptRequest()!!]
                    for (incoming in requests) {
                        val text = String.fromUtf8(incoming.stream.readAllBytes(10L))
                        val fields = incoming.stream.trailers!!
                        trailerCheck(parseHttpContentLength(incoming.head.fields) == Some(text.toByteArray().size))
                        trailerCheck(fields.size == 1L && fields[0L].hasName("X-Call".toByteArray()))
                        trailerCheck(String.fromUtf8(fields[0L].value) == text && fields[0L].neverIndex)
                        incoming.stream.sendResponse(HttpResponseHead(HttpVersion.Http2, 200U), false)
                        writeTrailerText(incoming.stream, "ok")
                        incoming.stream.finish()
                    }
                    done.await()
                }
            }
            val calls = AtomicLong(0L)
            val body = RequestBody.fromProducerWithTrailersFactory(["X-Call"]) suspend {
                calls.fetchAdd(1L)
                val text = trailerContextValue();
                suspend { output ->
                    writeTrailerText(output, text)
                    trailerCheck(trailerContextValue() == text)
                    [HttpField("X-Call".toByteArray(), text.toByteArray(), true)]
                }
            }
            val config = HttpClientConfig(cleartext = HttpCleartextProtocol.Http2PriorKnowledge,
                tls = HttpClientTlsConfig(TlsTrustSource.Store(trust)))
            withHttpClient(config) suspend { client ->
                val jobs = ArrayList<Deferred<Unit>>()
                for (text in ["first", "second"]) {
                    jobs.add(context(TrailerContext(text)) { scope.async suspend {
                        val url = Url.parse("http://127.0.0.1:" + listener.localAddress.port.toString() + "/" + text)
                        val fields = [HttpField("Content-Length".toByteArray(), text.toByteArray().size.toString().toByteArray())]
                        client.withResponse(HttpRequest.post(url, body, fields)) suspend { response ->
                            trailerCheck(response.version == HttpVersion.Http2)
                            trailerCheck(String.fromUtf8(response.body.readAllBytes(2L)) == "ok")
                            trailerCheck(response.trailers!!.size == 0L)
                        }
                    } })
                }
                for (job in jobs) job.await()
            }
            done.signal()
            serving.join()
            trailerCheck(calls.load() == 2L && !scope.job.isCancelled)
        }
    }
}
