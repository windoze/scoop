package scoop.tests

import scoop.asyncio.*
import scoop.tests.scoop.crypto.testdata.rootPem
import scoop.crypto.x509.TrustStore
import scoop.http.*
import scoop.http.client.*
import scoop.platform.concurrent.Thread
import scoop.platform.memory.NativeByteBuffer
import scoop.time.Duration
import scoop.tls.TlsTrustSource
import scoop.url.Url

internal fun trailerCheck(value: Boolean) {
    if (!value)
        throw IllegalStateException(Some("client trailer integration check failed"))
}

internal suspend fun writeTrailerText(output: AsyncByteSink, text: String) {
    val bytes = text.toByteArray()
    if (bytes.size == 0L)
        return
    NativeByteBuffer.allocate(bytes.size).use suspend {
        buffer ->
        buffer.writeBytes(bytes)
        output.writeFully(buffer)
    }
}

private fun exerciseClient(mode: String, url: Url, trust: TrustStore) {
    val started = AtomicBoolean(false)
    val text =
        if (mode == "empty")
            ""
        else
            "请求"
    val body =
        RequestBody.fromProducerWithTrailers(
            ["X-Plain-Bytes", "X-End"],
            Some(text.toByteArray().size)
        ) suspend {
            output ->
            trailerCheck(!started.exchange(true))
            writeTrailerText(output, text)
            [
                HttpField(
                    "X-Plain-Bytes".toByteArray(),
                    text.toByteArray().size.toString().toByteArray()
                ),
                HttpField("X-End".toByteArray(), "one".toByteArray()),
                HttpField("x-end".toByteArray(), "two".toByteArray())
            ]
        }
    val loop: EventLoop = PlatformEventLoop()
    loop.run suspend {
        scope ->
        val config =
            HttpClientConfig(
                cleartext =
                    if (mode == "h2c")
                        HttpCleartextProtocol.H2cUpgrade
                    else
                        HttpCleartextProtocol.Http1,
                tls = HttpClientTlsConfig(TlsTrustSource.Store(trust))
            )
        withHttpClient(config) suspend {
            client ->
            val actual =
                if (mode == "compressed")
                    body.compressed()
                else
                    body
            val request =
                HttpRequest.post(
                    url,
                    actual,
                    options =
                        HttpCallOptions(
                            expectContinue = mode == "h2c" || mode == "reject",
                            continueWait = Duration.seconds(60L)
                        )
                )
            client.withResponse(request) suspend {
                response ->
                trailerCheck(
                    response.version ==
                        (
                            if (mode == "h2c")
                                HttpVersion.Http2
                            else
                                HttpVersion.Http11
                        )
                )
                trailerCheck(
                    response.status ==
                        (
                            if (mode == "reject")
                                417U
                            else
                                200U
                        )
                )
                trailerCheck(
                    String.fromUtf8(response.body.readAllBytes(2L)) ==
                        (
                            if (mode == "reject")
                                "no"
                            else
                                "ok"
                        )
                )
                trailerCheck(response.trailers!!.size == 0L)
            }
        }
        trailerCheck(!scope.job.isCancelled)
    }
    trailerCheck(started.load() == (mode != "reject"))
}

private fun exercise(mode: String, args: Array<String>, trust: TrustStore) {
    if (mode == "h2")
        exerciseTrailerHttp2(trust)
    else
        exerciseClient(mode, Url.parse(args[2L]), trust)
}

fun main(args: Array<String>) {
    trailerCheck(args.size >= 2L)
    val mode = args[1L]
    trailerCheck(
        args.size ==
            (
                if (mode == "h2")
                    2L
                else
                    3L
            )
    )
    TrustStore.fromPem(rootPem()).use {
        trust -> Thread.start { exercise(mode, args, trust) }.use {
            thread ->
            exercise(mode, args, trust)
            thread.join()
        }
    }
    println("trailers " + mode)
}
