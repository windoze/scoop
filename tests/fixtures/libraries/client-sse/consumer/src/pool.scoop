package scoop.tests
import scoop.asyncio.*
import scoop.crypto.x509.TrustStore
import scoop.http.HttpException
import scoop.http.client.*
import scoop.platform.net.*
import scoop.test.*
import scoop.url.Url

// A new ordinary request must not reuse a connection whose response ended prematurely.
internal fun ssePoolFailure(trust: TrustStore, url: Url, notifyPort: Int) {
    val loop: EventLoop = LibuvEventLoop()
    loop.run suspend { _ ->
        withHttpClient(sseConfig(trust, true)) suspend { client ->
            val response = client.execute(HttpRequest.get(url))
            try {
                assertEquals(200U, response.status)
                loop.connectTcp(SocketAddress(IpAddress.IPV4_LOOPBACK, notifyPort)).useAsync suspend { signal ->
                    sseWrite(signal, "go")
                    assertEquals("x", String.fromUtf8(signal.readAllBytes(1L)))
                }
                val error = sseFailure suspend { response.body.readAllBytes(100L); Unit }
                assertTrue(error is HttpException)
                assertTrue((error as HttpException).isUnexpectedEof)
            } finally { response.close() }
            client.withResponse(HttpRequest.get(url)) suspend { next ->
                assertEquals(204U, next.status)
                assertEquals(0L, next.body.readAllBytes(0L).size)
            }
        }
    }
}
