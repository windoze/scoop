package scoop.tests
import scoop.tests.scoop.crypto.testdata.rootPem
import scoop.crypto.x509.TrustStore
import scoop.test.AssertionFailure
import scoop.text.toInt
import scoop.url.Url

fun main(args: Array<String>) {
    val mode = args[1L]
    try {
        TrustStore.fromPem(rootPem()).use { trust ->
            if (mode == "pool-eof") ssePoolFailure(trust, Url.parse(args[2L]), args[3L].toInt())
            else if (args.size == 4L) sseTransport(trust, mode, Url.parse(args[2L]), args[3L].toInt())
            else sseNetwork(trust, mode, Url.parse(args[2L]))
        }
    } catch (error: AssertionFailure) {
        println(mode + " " + error.kind + " " + (error.message ?: "failure") + " at " + error.location.line.toString())
        throw error
    }
    println("client SSE " + mode)
}
