package scoop.tests
import scoop.asyncio.*
import scoop.tests.scoop.crypto.testdata.rootPem
import scoop.crypto.x509.TrustStore
import scoop.http.client.*
import scoop.platform.concurrent.Thread
import scoop.url.Url

private fun exercise(mode: String, url: Url, trust: TrustStore) {
    val loop: EventLoop = LibuvEventLoop()
    loop.run suspend { _ ->
        val calls = AtomicLong(0L)
        val separate = mode == "qop" || mode == "nonce" || mode == "opaque"
        val provider = HttpAuthenticator.digest(url.httpOrigin(), sendWithoutChallenge = false,
            algorithms = [HttpDigestAlgorithm.Sha256, HttpDigestAlgorithm.Md5]) suspend { _ ->
            calls.fetchAdd(1L)
            digestCheck(digestContext() == "transition")
            HttpPasswordCredentials(if (mode == "charset") "café" else "Mufasa",
                if (mode == "charset") "päss" else "Circle of Life")
        }
        withHttpClient(digestConfig(trust, provider)) suspend { client ->
            context(DigestContext("transition")) {
                for (_ in 0..<(if (separate) 2 else 1)) {
                    client.withResponse(HttpRequest.get(url)) suspend { response ->
                        digestCheck(response.body.text(4L) == "done")
                        digestCheck(response.authenticationCount == if (separate) 1L else 2L)
                    }
                }
                Unit
            }
        }
        digestCheck(calls.load() == 2L)
    }
}

private fun runMain(args: Array<String>) {
    digestCheck(args.size == 4L)
    TrustStore.fromPem(rootPem()).use { trust ->
        Thread.start { exercise(args[1L], Url.parse(args[2L]), trust) }.use { thread ->
            exercise(args[1L], Url.parse(args[3L]), trust)
            thread.join()
        }
    }
    println("Digest transition " + args[1L])
}

fun main(args: Array<String>) {
    try { runMain(args) }
    catch (error: Throwable) { digestReport(error); throw error }
}
