package scoop.tests
import scoop.asyncio.*
import scoop.crypto.x509.TrustStore
import scoop.http.*
import scoop.http.client.*
import scoop.platform.fs.*
import scoop.platform.memory.NativeByteBuffer
import scoop.platform.system.PlatformErrorKind
import scoop.platform.system.PlatformException
import scoop.tls.TlsTrustSource

internal class DownloadGate {
    private var ready: Boolean = false
    private var waiter: Continuation<Unit>? = None
    fun signal() { ready = true; val saved = waiter; waiter = None; saved?.resume(Unit) }
    suspend fun await() { suspendCoroutine<Unit> { next -> if (ready) next.resume(Unit) else waiter = Some(next) } }
}
internal class DownloadFailure { var value: Throwable? = None }
internal class DownloadMarker(val value: String)
context(marker: DownloadMarker)
internal fun downloadMarker(): String = marker.value
internal fun <T> downloadPresent(value: T?): Boolean = when (value) { case Some(_) -> true; case None -> false }
internal fun downloadField(name: String, value: String): HttpField = HttpField(name.toByteArray(), value.toByteArray())
internal fun downloadConfig(trust: TrustStore, h2: Boolean = false): HttpClientConfig =
    HttpClientConfig(tls = HttpClientTlsConfig(TlsTrustSource.Store(trust)),
        cleartext = if (h2) HttpCleartextProtocol.Http2PriorKnowledge else HttpCleartextProtocol.Http1,
        retries = HttpRetryOptions(maxRetries = 0L), pool = HttpConnectionPoolOptions(maxConnectionsPerOrigin = 1L))
internal suspend fun downloadWrite(sink: AsyncByteSink, text: String) {
    val bytes = text.toByteArray()
    NativeByteBuffer.allocate(bytes.size).use suspend { buffer -> buffer.writeBytes(bytes); sink.writeFully(buffer) }
}
internal suspend fun downloadStore(path: Path, text: String) {
    currentEventLoop().openFile(path, OpenOptions(write = true, create = true, truncate = true)).useAsync suspend { file ->
        downloadWrite(file, text)
    }
}
internal suspend fun downloadRead(path: Path): Array<Byte> =
    currentEventLoop().openFile(path).useAsync suspend { file -> file.readAllBytes(1048576L) }
internal suspend fun downloadExists(path: Path): Boolean {
    try { currentEventLoop().metadata(path); return true }
    catch (error: PlatformException) { if (error.kind == PlatformErrorKind.NotFound) return false; throw error }
}
internal suspend fun downloadFiles(path: Path): Long =
    currentEventLoop().openDirectory(path).useAsync suspend { directory ->
        var count = 0L
        while (directory.next() != None) count += 1L
        count
    }
