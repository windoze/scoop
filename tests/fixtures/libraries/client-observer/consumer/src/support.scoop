package scoop.tests
import scoop.asyncio.*
import scoop.crypto.x509.TrustStore
import scoop.http.*
import scoop.http.client.*
import scoop.test.*
import scoop.text.*
import scoop.time.Duration
import scoop.tls.TlsTrustSource
import scoop.url.Url

internal class ObservationMarker(val value: String)
context(marker: ObservationMarker)
internal fun observationMarker(): String = marker.value
internal fun <T> observationPresent(value: T?): Boolean = when (value) { case Some(_) -> true; case None -> false }
internal fun observationField(name: String, value: String): HttpField = HttpField(name.toByteArray(), value.toByteArray())
internal fun observationValue(fields: List<HttpField>, name: String): String = String.fromUtf8(fields.findAll(name.toByteArray())[0L].value)
internal suspend fun observationFailure(block: suspend () -> Unit): Throwable {
    try { block() } catch (error: Throwable) { return error }
    throw IllegalStateException(Some("expected observed request failure"))
}

internal class ObservationLog(val checkContext: Boolean = false) {
    val events: ArrayList<HttpCallEvent> = ArrayList<HttpCallEvent>()
    fun observer(): HttpObserver = HttpObserver(suspend { event ->
        if (checkContext) assertEquals(if (event.kind == HttpCallEventKind.ResponseProgress) "reader" else "caller", observationMarker())
        assertTrue(event.metrics.urlDisplay.endsWith("/[redacted]"))
        val summary = event.formatSummary()
        for (secret in ["PASSWORD", "QUERY_SECRET", "FRAGMENT_SECRET", "HEADER_SECRET", "BODY_SECRET", "Bearer", "Cookie"])
            assertFalse(summary.contains(secret))
        events.add(event)
        if (event.kind != HttpCallEventKind.Completed) currentEventLoop().sleep(Duration.milliseconds(1L))
    })
    fun ofKind(kind: HttpCallEventKind): Array<HttpCallEvent> {
        val result = ArrayList<HttpCallEvent>()
        for (event in events) if (event.kind == kind) result.add(event)
        return result.toArray()
    }
}

internal fun observationConfig(trust: TrustStore, log: ObservationLog): HttpClientConfig =
    HttpClientConfig(tls = HttpClientTlsConfig(TlsTrustSource.Store(trust)), observer = Some(log.observer()),
        pool = HttpConnectionPoolOptions(maxConnectionsPerOrigin = 1L), retries = HttpRetryOptions(maxRetries = 0L))

internal suspend fun observationGet(client: HttpClient, url: Url, expected: String) {
    client.withResponse(HttpRequest.get(url)) suspend { response -> assertEquals(expected, response.body.text(4096L)) }
}

internal fun checkObservationPhases(metrics: HttpAttemptMetrics) {
    assertTrue(metrics.finishedAt!! >= metrics.startedAt)
    for (phase in [metrics.queue, metrics.resolve, metrics.connect, metrics.proxyTls, metrics.proxyHandshake, metrics.originTls]) {
        if (observationPresent(phase)) {
            assertTrue(phase!!.startedAt >= metrics.startedAt)
            assertTrue(phase!!.finishedAt!! >= phase!!.startedAt)
            assertTrue(phase!!.finishedAt!! <= metrics.finishedAt!!)
        }
    }
}
