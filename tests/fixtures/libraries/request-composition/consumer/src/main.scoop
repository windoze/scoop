package fixture
import scoop.asyncio.*
import scoop.compression.*
import scoop.http.*
import scoop.http.client.*
import scoop.platform.concurrent.Thread
import scoop.platform.fs.*

fun check(value: Boolean) {
    if (!value) throw IllegalStateException(Some("request composition integration check failed"))
}

fun fileText(): String = "文件字节\n--scoop-body-fixturex\ntail\n"

private fun createBody(input: Path): RequestBody {
    val nested = RequestBody.fromMultipart([RequestBodyPart(RequestBody.fromText("inside"))],
        MultipartBoundary("inner-body"), "mixed")
    val body = RequestBody.fromMultipart([
        RequestBodyPart.formData("note", RequestBody.fromText("值 🌍")),
        RequestBodyPart.formData("file", RequestBody.fromFile(input, contentType = Some(HttpMediaType("application", "octet-stream"))),
            Some("report.bin")),
        RequestBodyPart.formData("coded", RequestBody.fromText("coded part data").compressed(CompressionOptions.Zlib(DeflateOptions()))),
        RequestBodyPart.formData("empty", RequestBody.Empty),
        RequestBodyPart.formData("nested", nested)
    ], MultipartBoundary("scoop-body-fixture"))
    return body.compressed()
}

private fun exercise(version: HttpVersion, body: RequestBody, output: Path) {
    val loop: EventLoop = LibuvEventLoop()
    loop.run suspend { scope ->
        check(body.isReplayable && body.contentLength == None)
        check(body.contentEncodings.size == 1L && body.contentEncodings[0L] == "gzip")
        val options = OpenOptions(read = false, write = true, create = true, truncate = true)
        loop.openFile(output, options).useAsync suspend { file ->
            check(body.writeTo(file, 4096L) > 0L)
            file.syncAll()
        }
        if (version == HttpVersion.Http11) sendHttp1Body(loop, scope, body)
        else sendHttp2Body(loop, scope, body)
    }
}

fun main(args: Array<String>) {
    check(args.size == 4L)
    val body = createBody(Path.fromString(args[1L]))
    val firstPath = Path.fromString(args[2L])
    val secondPath = Path.fromString(args[3L])
    Thread.start { exercise(HttpVersion.Http11, body, firstPath) }.use { first ->
        Thread.start { exercise(HttpVersion.Http2, body, secondPath) }.use { second ->
            first.join()
            second.join()
        }
    }
    println("multipart and compression bodies share replayable streams across HTTP versions")
}
