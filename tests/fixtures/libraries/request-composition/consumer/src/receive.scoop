package fixture
import scoop.asyncio.*
import scoop.compression.*
import scoop.compression.asyncio.AsyncDecompressionSource
import scoop.http.*
import scoop.http.asyncio.*

private fun field(part: MultipartPart, name: String): Array<Byte> = part.head.fields.findAll(name.toByteArray())[0L].value

private fun checkName(part: MultipartPart, expected: String) {
    val disposition = HttpContentDisposition.parse(field(part, "Content-Disposition"))
    check(disposition.disposition == "form-data")
    check(String.fromUtf8(disposition.parameter("name")!!.value) == expected)
}

suspend fun receiveBody(input: AsyncByteSource, fields: Array<HttpField>) {
    check(String.fromUtf8(fields.findAll("Content-Encoding".toByteArray())[0L].value) == "gzip")
    val media = HttpMediaType.parse(fields.findAll("Content-Type".toByteArray())[0L].value)
    val decoded = AsyncDecompressionSource(input, DecompressionOptions(CompressionFormat.Gzip), 4096L)
    MultipartSource.takeOwnership(decoded, MultipartBoundary.fromMediaType(media), bufferSize = 4096L).useAsync suspend { source ->
        val note = source.nextPart()!!
        checkName(note, "note")
        check(String.fromUtf8(note.body.readAllBytes(100L)) == "值 🌍")
        val file = source.nextPart()!!
        checkName(file, "file")
        check(String.fromUtf8(HttpContentDisposition.parse(field(file, "Content-Disposition")).parameter("filename")!!.value) == "report.bin")
        check(String.fromUtf8(file.body.readAllBytes(1000L)) == fileText())
        val coded = source.nextPart()!!
        checkName(coded, "coded")
        check(String.fromUtf8(field(coded, "Content-Encoding")) == "deflate")
        check(String.fromUtf8(decompress(coded.body.readAllBytes(1000L), DecompressionOptions(CompressionFormat.Zlib))) == "coded part data")
        val empty = source.nextPart()!!
        checkName(empty, "empty")
        check(empty.body.readAllBytes(0L).size == 0L)
        val nested = source.nextPart()!!
        checkName(nested, "nested")
        val innerMedia = HttpMediaType.parse(field(nested, "Content-Type"))
        check(innerMedia.subtype == "mixed")
        MultipartSource(nested.body, MultipartBoundary.fromMediaType(innerMedia), bufferSize = 97L).useAsync suspend { inner ->
            check(String.fromUtf8(inner.nextPart()!!.body.readAllBytes(100L)) == "inside")
            check(when (inner.nextPart()) { case None -> true; case Some(_) -> false })
        }
        check(when (source.nextPart()) { case None -> true; case Some(_) -> false })
        check(source.isFinished)
    }
}

suspend fun checkEmpty(source: AsyncByteSource) { check(source.readAllBytes(0L).size == 0L) }
