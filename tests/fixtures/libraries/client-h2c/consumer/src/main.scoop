package scoop.tests
import scoop.asyncio.*
import scoop.tests.scoop.crypto.testdata.rootPem
import scoop.crypto.x509.TrustStore
import scoop.http.*
import scoop.http.client.*
import scoop.platform.concurrent.Thread
import scoop.platform.memory.NativeByteBuffer
import scoop.tls.TlsTrustSource
import scoop.url.Url

private fun check(value: Boolean) { if (!value) throw IllegalStateException(Some("HTTP h2c integration check failed")) }

private suspend fun reply(client: HttpClient, request: HttpRequest, version: HttpVersion, text: String) {
    client.withResponse(request) suspend { response ->
        check(response.version == version && response.status == 200U)
        check(String.fromUtf8(response.body.readAllBytes(100L)) == text)
        if (request.method == "POST" && version == HttpVersion.Http2)
            check(String.fromUtf8(response.trailers!![0L].value) == "yes")
        if (request.method == "HEAD") check(response.wireContentLength == Some(123L))
        Unit
    }
}

private suspend fun exercise(client: HttpClient, mode: String, base: Url) {
    if (mode == "cancel") {
        val first = client.execute(HttpRequest.get(base.resolve("first")))
        val second = client.execute(HttpRequest.get(base.resolve("second")))
        first.close()
        check(String.fromUtf8(second.body.readAllBytes(5L)) == "other")
        second.close()
        client.withResponse(HttpRequest.get(base.resolve("third"))) suspend { response ->
            check(response.version == HttpVersion.Http2 && response.status == 204U)
            response.body.readAllBytes(0L)
            Unit
        }
        return
    }
    val started = AtomicBoolean(false)
    val payload = "请求一次".toByteArray()
    val body = RequestBody.fromProducer(Some(payload.size)) suspend { output ->
        check(!started.exchange(true))
        NativeByteBuffer.allocate(payload.size).use suspend { buffer ->
            buffer.writeBytes(payload)
            output.writeFully(buffer)
        }
    }
    val request = if (mode == "head") HttpRequest.head(base) else HttpRequest.post(base, body)
    if (mode == "required" || mode == "malformed") {
        var failed = false
        try { client.execute(request).close() }
        catch (_: HttpNegotiationException) { failed = true }
        check(failed && started.load())
    } else {
        val version = if (mode == "declined") HttpVersion.Http11 else HttpVersion.Http2
        reply(client, request, version, if (mode == "head") "" else if (mode == "declined") "declined" else "post-result")
        reply(client, HttpRequest.get(base.resolve("next")), version, "next")
    }
}

private fun runClient(mode: String, base: Url, trust: TrustStore) {
    val loop: EventLoop = LibuvEventLoop()
    loop.run suspend { scope ->
        val config = HttpClientConfig(cleartext = HttpCleartextProtocol.H2cUpgrade,
            versionPolicy = if (mode == "required") HttpVersionPolicy.Http2Only else HttpVersionPolicy.Auto,
            tls = HttpClientTlsConfig(TlsTrustSource.Store(trust)), http2Settings = Http2Settings(initialWindowSize = 32U),
            pool = HttpConnectionPoolOptions(maxConnectionsPerOrigin = 1L))
        withHttpClient(config) suspend { client -> exercise(client, mode, base) }
        check(!scope.job.isCancelled)
    }
}

fun main(args: Array<String>) {
    check(args.size == 3L)
    val mode = args[1L]
    val base = Url.parse(args[2L])
    TrustStore.fromPem(rootPem()).use { trust ->
        Thread.start { runClient(mode, base, trust) }.use { thread ->
            runClient(mode, base, trust)
            thread.join()
        }
    }
    println("h2c " + mode)
}
