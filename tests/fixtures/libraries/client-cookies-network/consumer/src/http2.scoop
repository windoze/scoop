package scoop.tests
import scoop.asyncio.*
import scoop.crypto.x509.TrustStore
import scoop.http.*
import scoop.http.asyncio.AsyncHttp2Connection
import scoop.http.client.*
import scoop.test.*

internal fun cookieHttp2(trust: TrustStore) {
    withCookieRuntime suspend { _, scope, listener, url ->
        val entered = CookieGate()
        val release = CookieGate()
        val done = CookieGate()
        val jar = CookieCallbacks(saving = suspend { request, _ ->
            if (request.url.encodedPath == "/start") { entered.signal(); release.await() }
        })
        val serving = scope.launch suspend {
            AsyncHttp2Connection.takeOwnershipAsServer(listener.accept(), scope).useAsync suspend { connection ->
                val first = connection.acceptRequest()!!
                first.stream.sendResponse(HttpResponseHead(HttpVersion.Http2, 200U,
                    fields = [cookieField("Set-Cookie", "a=1; Path=/")]), false)
                cookieWrite(first.stream, "first"); first.stream.finish()
                val second = connection.acceptRequest()!!
                assertEquals(3, second.stream.id)
                second.stream.sendResponse(HttpResponseHead(HttpVersion.Http2, 200U,
                    fields = [cookieField("Set-Cookie", "b=2; Path=/")]), false)
                cookieWrite(second.stream, "second"); second.stream.finish()
                val third = connection.acceptRequest()!!
                val fields = third.head.fields.findAll("Cookie".toByteArray())
                assertEquals(1L, fields.size)
                assertTrue(fields[0L].neverIndex)
                assertEquals("b=2; a=1", String.fromUtf8(fields[0L].value))
                third.stream.sendResponse(HttpResponseHead(HttpVersion.Http2, 200U), false)
                cookieWrite(third.stream, "last"); third.stream.finish()
                done.await()
            }
        }
        val failure = CookieFailure()
        try {
            withHttpClient(cookieNetworkConfig(trust, Some(jar), true)) suspend { client ->
                val first = scope.launch suspend {
                    try { client.withResponse(HttpRequest.get(url)) suspend { response -> assertEquals("first", response.body.text(16L)) } }
                    catch (error: Throwable) { failure.value = Some(error) }
                }
                entered.await()
                assertFalse(first.isCompleted)
                client.withResponse(HttpRequest.get(url.resolve("/second"))) suspend { response -> assertEquals("second", response.body.text(16L)) }
                assertFalse(first.isCompleted)
                release.signal()
                first.join()
                assertFalse(cookieNetworkPresent(failure.value))
                client.withResponse(HttpRequest.get(url.resolve("/third"))) suspend { response -> assertEquals("last", response.body.text(16L)) }
            }
        } finally { release.signal(); done.signal() }
        serving.join()
    }
}
