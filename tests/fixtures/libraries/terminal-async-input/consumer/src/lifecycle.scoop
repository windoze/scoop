package test
import scoop.asyncio.*
import scoop.terminal.*
import scoop.terminal.asyncio.*
import scoop.terminal.event.*
import scoop.time.Duration

suspend fun progress(loop: EventLoop, scope: CoroutineScope, session: AsyncTerminalSession) {
    val pending = scope.launch suspend { expect(session, key('t')) }
    loop.sleep(Duration.milliseconds(10L))
    var rejected = false
    try { session.poll(Duration.ZERO) } catch (_: IllegalStateException) { rejected = true }
    check(rejected, "one input reader")
    rejected = false
    try { session.cursorPosition() } catch (_: IllegalStateException) { rejected = true }
    check(rejected, "query conflicts with read")
    stage(session, "async-tick")
    pending.join()
}

suspend fun events(session: AsyncTerminalSession) {
    stage(session, "async-events")
    expect(session, Event.FocusGained)
    expect(session, Event.Mouse(MouseEvent(MouseEventKind.Down(MouseButton.Left), 6L, 2L)))
    expect(session, Event.Paste("hello"))
    expect(session, Event.Key(KeyEvent(KeyCode.Char('a'), KeyModifiers().with(KeyModifier.Control),
        KeyEventKind.Release)))
    stage(session, "async-invalid")
    var invalid = false
    try { session.read() } catch (_: TerminalInputException) { invalid = true }
    check(invalid, "async invalid byte")
    expect(session, key('z'))
    stage(session, "async-resize")
    val first = session.read()
    val second = session.read()
    check((first == Event.Resize(35L, 15L) && second == key('r'))
        || (second == Event.Resize(35L, 15L) && first == key('r')), "resize with key")
}

suspend fun cancellation(loop: EventLoop, scope: CoroutineScope, session: AsyncTerminalSession) {
    val child = scope.launch suspend {
        session.withRawMode suspend { session.read() }
    }
    loop.sleep(Duration.milliseconds(10L))
    child.cancel()
    child.join()
    check(!session.isRawMode(), "cancelled raw scope restored")
    stage(session, "async-cancel-restored")
    expect(session, Event.Key(KeyEvent(KeyCode.Enter)))
    session.enableRawMode()
    val closed = AtomicBoolean(false)
    val reading = scope.launch suspend {
        try { session.read(); check(false, "closed read succeeded") }
        catch (_: IoClosedException) { closed.store(true) }
    }
    loop.sleep(Duration.nanoseconds(1L))
    val first = scope.launch suspend { session.close() }
    val second = scope.launch suspend { session.close() }
    first.join()
    second.join()
    reading.join()
    check(closed.load() && session.isClosed, "concurrent close drains read")
}
