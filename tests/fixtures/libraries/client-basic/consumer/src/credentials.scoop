package scoop.tests
import scoop.asyncio.*
import scoop.charset.CharsetException
import scoop.crypto.x509.TrustStore
import scoop.http.*
import scoop.http.asyncio.AsyncHttp1Connection
import scoop.http.client.*
import scoop.platform.system.PlatformErrorKind
import scoop.platform.system.PlatformException
import scoop.time.Duration

internal fun basicCredentialFailures(trust: TrustStore, mode: String) {
    var rejected = false
    try { HttpAuthenticationOptions(maxAttempts = -1L) }
    catch (_: IllegalArgumentException) { rejected = true }
    basicCheck(rejected)
    withBasicRuntime suspend { _, scope, listener ->
        val url = basicUrl(listener)
        val count = AtomicLong(0L)
        val original = PlatformException("credential callback", PlatformErrorKind.ConnectionReset)
        val provider = HttpAuthenticator.basic(url.httpOrigin(), sendWithoutChallenge = true,
            charset = if (mode == "preemptive") HttpBasicCharset.Utf8 else HttpBasicCharset.Iso8859_1) suspend { request ->
            basicCheck(request.attempt == 0L && !basicPresent(request.challenge))
            count.fetchAdd(1L)
            if (mode == "callback") throw original
            if (mode == "nested") coroutineScope<Unit> suspend { scope ->
                scope.async<Unit> suspend { throw original }; Unit
            }
            HttpPasswordCredentials(
                when (mode) { case "user" -> "bad:name"; case "encoding" -> "中文"; else -> "Jose\u{0301}" },
                if (mode == "password") "bad\u{0000}password" else "pa\u{0308}ss")
        }
        val successful = mode == "preemptive" || mode == "zero"
        val serving = if (successful) Some(scope.launch suspend {
            AsyncHttp1Connection.takeOwnershipAsServer(listener.accept(), scope).useAsync suspend { connection ->
                val request = connection.receiveRequest()!!
                val credentials = HttpCredentials.parse(request.head.fields.findAll("Authorization".toByteArray())[0L].value)
                basicCheck(credentials.token68 == Some("Sm9zw6k6cMOkc3M="))
                request.body.readAllBytes(0L)
                basicRespond(connection, 200U, "done")
            }
        }) else None
        val actual = if (mode == "zero") HttpAuthenticator.basic(url.httpOrigin(), sendWithoutChallenge = true,
            charset = HttpBasicCharset.Utf8) suspend { _ -> count.fetchAdd(1L); HttpPasswordCredentials("José", "päss") }
            else provider
        val options = HttpAuthenticationOptions([actual], maxAttempts = if (mode == "zero") 0L else 3L)
        withHttpClient(basicConfig(trust, options, retries = HttpRetryOptions(
            maxRetries = if (mode == "callback" || mode == "nested") 2L else 0L,
            initialDelay = Duration.ZERO, maxDelay = Duration.ZERO))) suspend { client ->
            if (successful) client.withResponse(HttpRequest.get(url)) suspend { response ->
                basicCheck(response.authenticationCount == 0L && response.body.text(4L) == "done")
            } else {
                val failure = basicFailure<Throwable> suspend { client.execute(HttpRequest.get(url)).close() }
                when (mode) {
                    case "callback" -> basicCheck(failure === original)
                    case "nested" -> basicCheck(failure === original)
                    case "encoding" -> basicCheck(failure is CharsetException)
                    else -> {
                        basicCheck(failure is HttpAuthenticationException)
                        if (failure is HttpAuthenticationException) basicCheck(failure.reason == HttpAuthenticationFailure.InvalidCredentials)
                        Unit
                    }
                }
            }
        }
        serving?.join()
        basicCheck(count.load() == 1L)
    }
}
