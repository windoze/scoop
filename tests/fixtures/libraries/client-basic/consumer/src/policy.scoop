package scoop.tests
import scoop.asyncio.*
import scoop.crypto.x509.TrustStore
import scoop.http.*
import scoop.http.asyncio.AsyncHttp1Connection
import scoop.http.client.*

internal fun basicPolicies(trust: TrustStore, mode: String) {
    withBasicRuntime suspend { _, scope, listener ->
        val url = basicUrl(listener)
        val calls = AtomicLong(0L)
        val started = AtomicLong(0L)
        val provider = HttpAuthenticator.basic(url.httpOrigin(),
            realm = if (mode == "realm") Some<List<Byte>>("private".toByteArray()) else None) suspend { _ ->
            calls.fetchAdd(1L)
            HttpPasswordCredentials("Aladdin", "open sesame")
        }
        val serving = scope.launch suspend {
            val attempts = if (mode == "rejected" || mode == "limit") 2 else 1
            for (index in 0..<attempts) {
                AsyncHttp1Connection.takeOwnershipAsServer(listener.accept(), scope).useAsync suspend { connection ->
                    val incoming = connection.receiveRequest()!!
                    val authorization = incoming.head.fields.findAll("Authorization".toByteArray())
                    if (mode == "manual") basicCheck(String.fromUtf8(authorization[0L].value) == "Bearer supplied")
                    else if (index == 0) basicCheck(authorization.size == 0L)
                    else basicCheck(HttpCredentials.parse(authorization[0L].value).token68 == Some("QWxhZGRpbjpvcGVuIHNlc2FtZQ=="))
                    val body = incoming.body.readAllBytes(4L)
                    basicCheck(String.fromUtf8(body) == if (mode == "sent") "once" else "")
                    val challenge = when (mode) {
                        case "missing" -> "Basic charset=UTF-8"
                        case "malformed" -> "Basic realm=\"unterminated"
                        case "realm" -> "Basic realm=\"other\""
                        case "limit" -> if (index == 0) "Basic realm=\"first\"" else "Basic realm=\"second\""
                        else -> "Basic realm=\"private\""
                    }
                    basicRespond(connection, 401U, if (mode == "manual" || mode == "disabled" || mode == "realm") "deny" else "",
                        [basicField("WWW-Authenticate", challenge)])
                }
            }
        }
        withHttpClient(basicConfig(trust, HttpAuthenticationOptions([provider], maxAttempts = if (mode == "limit") 1L else 3L))) suspend { client ->
            val body = if (mode == "sent") RequestBody.fromProducer(Some(4L)) suspend { output ->
                started.fetchAdd(1L); basicWrite(output, "once")
            } else RequestBody.Empty
            val fields: Array<HttpField> = if (mode == "manual") [basicField("Authorization", "Bearer supplied")] else []
            val options = HttpCallOptions(authentication = if (mode == "disabled") Some(HttpAuthenticationOptions()) else None)
            val request = HttpRequest(url, if (mode == "sent") "POST" else "GET", fields, body, options)
            if (mode == "manual" || mode == "disabled" || mode == "realm") {
                client.withResponse(request) suspend { response ->
                    basicCheck(response.status == 401U && response.authenticationCount == 0L)
                    basicCheck(response.body.text(4L) == "deny")
                }
            } else {
                val error = basicFailure<HttpAuthenticationException> suspend { client.execute(request).close() }
                val reason = when (mode) {
                    case "sent" -> HttpAuthenticationFailure.BodyNotReplayable
                    case "rejected" -> HttpAuthenticationFailure.Rejected
                    case "limit" -> HttpAuthenticationFailure.LimitExceeded
                    else -> HttpAuthenticationFailure.InvalidChallenge
                }
                basicCheck(error.reason == reason && error.head!!.status == 401U)
                if (mode == "malformed") basicCheck(error.cause!! is HttpFieldParseException)
                Unit
            }
        }
        serving.join()
        basicCheck(calls.load() == if (mode == "rejected" || mode == "limit") 1L else 0L)
        basicCheck(started.load() == if (mode == "sent") 1L else 0L)
    }
}
