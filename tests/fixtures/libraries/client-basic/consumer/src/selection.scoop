package scoop.tests
import scoop.asyncio.*
import scoop.charset.Charset
import scoop.crypto.x509.TrustStore
import scoop.http.*
import scoop.http.asyncio.AsyncHttp1Connection
import scoop.http.client.*

internal fun basicSelection(trust: TrustStore) {
    withBasicRuntime suspend { _, scope, listener ->
        val url = basicUrl(listener).toBuilder().setEncodedUserInfo(Some("ignored:credentials")).build()
        val realm = MutableArray<Byte>(Charset.Iso8859_1.encode("préféré"))
        val calls = AtomicLong(0L)
        val preferred = HttpAuthenticator.basic(url.httpOrigin(), realm = Some<List<Byte>>(realm)) suspend { request ->
            basicCheck(request.request.url == url && request.attempt == 1L)
            basicCheck(Charset.Iso8859_1.decode(request.challenge!!.parameter("realm")!!.value) == "préféré")
            calls.fetchAdd(1L)
            HttpPasswordCredentials("selected", "secret")
        }
        val fallback = HttpAuthenticator.basic(url.httpOrigin()) suspend { _ ->
            throw IllegalStateException(Some("fallback credentials selected before the preferred provider"))
        }
        val providers = ArrayList<HttpAuthenticator>()
        providers.add(preferred); providers.add(fallback)
        val options = HttpAuthenticationOptions(providers)
        providers.clear(); providers.add(fallback)
        realm[0L] = 'x'.code.toByte()
        val serving = scope.launch suspend {
            AsyncHttp1Connection.takeOwnershipAsServer(listener.accept(), scope).useAsync suspend { connection ->
                val request = connection.receiveRequest()!!
                basicCheck(request.head.fields.findAll("Authorization".toByteArray()).size == 0L)
                request.body.readAllBytes(0L)
                basicRespond(connection, 401U, extra = [
                    basicField("WWW-Authenticate", "Bearer realm=\"irrelevant\""),
                    basicField("WWW-Authenticate", "Basic realm=\"other\""),
                    HttpField("WWW-Authenticate".toByteArray(), Charset.Iso8859_1.encode("Basic realm=\"préféré\""))
                ])
            }
            AsyncHttp1Connection.takeOwnershipAsServer(listener.accept(), scope).useAsync suspend { connection ->
                val request = connection.receiveRequest()!!
                val field = request.head.fields.findAll("Authorization".toByteArray())[0L]
                basicCheck(HttpCredentials.parse(field.value).token68 == Some("c2VsZWN0ZWQ6c2VjcmV0"))
                request.body.readAllBytes(0L)
                basicRespond(connection, 200U, "done")
            }
        }
        withHttpClient(basicConfig(trust, options)) suspend { client ->
            client.withResponse(HttpRequest.get(url)) suspend { response ->
                basicCheck(response.authenticationCount == 1L && response.body.text(4L) == "done")
            }
        }
        serving.join()
        basicCheck(calls.load() == 1L)
    }
}
