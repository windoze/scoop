package scoop.tests
import scoop.tests.scoop.crypto.testdata.rootPem
import scoop.crypto.x509.TrustStore
import scoop.platform.concurrent.Thread
import scoop.text.startsWith
import scoop.url.Url

private fun exercise(args: Array<String>, first: Long, trust: TrustStore) {
    val mode = args[1L]
    val proxy = Url.parse(args[first])
    val second = Url.parse(args[first + 1L])
    val target = Url.parse(args[first + 2L])
    if (mode == "basic-redirect") authRedirect(proxy, second, target, trust)
    else if (mode == "bearer-cache-isolation") authIsolation(proxy, trust)
    else if (mode.startsWith("basic-")) authBasic(mode, proxy, second, target, trust)
    else if (mode.startsWith("nested-")) authNested(mode, proxy, second.resolve("/token"), target, trust)
    else if (mode.startsWith("bearer-")) authBearer(mode, proxy, target, trust)
    else if (mode == "digest-double") authDouble(proxy, trust)
    else authDigest(mode, proxy, target, trust)
}
private fun report(error: Throwable) {
    if (error is Exception) println(error.message ?: "no exception message")
    if (error is ResourceUseException) { report(error.primaryFailure); report(error.cleanupFailure) }
}
fun main(args: Array<String>) {
    try {
        authCheck(args.size == 8L)
        TrustStore.fromPem(rootPem()).use { trust ->
            Thread.start { exercise(args, 2L, trust) }.use { thread -> exercise(args, 5L, trust); thread.join() }
        }
        println("proxy authentication " + args[1L])
    } catch (error: Throwable) { report(error); throw error }
}
