package scoop.tests
import scoop.asyncio.*
import scoop.collections.emptyList
import scoop.crypto.x509.TrustStore
import scoop.http.*
import scoop.http.client.*
import scoop.test.*
import scoop.tls.TlsTrustSource
import scoop.url.Url

internal class ExtensionState {
    val order: ArrayList<String> = ArrayList<String>()
    var calls: Long = 0L
    var attempts: Long = 0L
    var credentials: Long = 0L
    var chain: HttpCallChain? = None
    var client: HttpClient? = None
    var other: HttpClient? = None
    var token: String = "one"
    var variant: String = "a"
    val failure: Throwable = IoClosedException()
}
internal class ExtensionMarker(val text: String)
context(marker: ExtensionMarker)
internal fun extensionMarker(): String = marker.text
internal fun extensionField(name: String, value: String): HttpField = HttpField(name.toByteArray(), value.toByteArray())
internal fun extensionFields(fields: List<HttpField>, field: HttpField): Array<HttpField> {
    val result = ArrayList<HttpField>()
    for (saved in fields) result.add(saved)
    result.add(field)
    return result.toArray()
}
internal fun extensionValue(fields: List<HttpField>, name: String): String =
    String.fromUtf8(fields.findAll(name.toByteArray())[0L].value)
internal suspend fun extensionFailure(block: suspend () -> Unit): Throwable {
    try { block() } catch (error: Throwable) { return error }
    throw IllegalStateException(Some("expected extension failure"))
}
internal fun extensionConfig(trust: TrustStore, interceptors: List<HttpInterceptor> = emptyList<HttpInterceptor>(),
    callback: (suspend (HttpAttempt) -> List<HttpField>)? = None): HttpClientConfig =
    HttpClientConfig(tls = HttpClientTlsConfig(TlsTrustSource.Store(trust)), interceptors = interceptors, onAttempt = callback,
        retries = HttpRetryOptions(maxRetries = 2L), pool = HttpConnectionPoolOptions(maxConnectionsPerOrigin = 2L))
internal suspend fun extensionGet(client: HttpClient, url: Url, expected: String) {
    client.withResponse(HttpRequest.get(url)) suspend { response ->
        assertEquals(200U, response.status)
        assertEquals(expected, response.body.text(1024L))
    }
}
