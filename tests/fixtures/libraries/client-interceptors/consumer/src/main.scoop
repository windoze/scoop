package scoop.tests
import scoop.tests.scoop.crypto.testdata.rootPem
import scoop.crypto.x509.TrustStore
import scoop.test.AssertionFailure
import scoop.text.toInt
import scoop.url.Url

fun main(args: Array<String>) {
    try { runExtensionCase(args) }
    catch (error: AssertionFailure) {
        eprintln(error.kind + " " + (error.message ?: "failure") + " at " + error.location.file + ":" + error.location.line.toString())
        throw error
    }
}

private fun runExtensionCase(args: Array<String>) {
    val mode = args[1L]
    val url = Url.parse("http://127.0.0.1:" + args[2L].toInt().toString() + "/start")
    TrustStore.fromPem(rootPem()).use { trust ->
        when (mode) {
            case "chain" -> extensionChain(trust, url)
            case "cache" -> extensionCache(trust, url)
            case "cache-refresh" -> extensionCacheRefresh(trust, url)
            case "proxy" -> extensionProxy(trust, url)
            case "auth" -> extensionExplicitAuthentication(trust, url)
            case "attempt-throw" -> extensionAttemptValidation(trust, url, false)
            case "fields" -> extensionAttemptValidation(trust, url, true)
            case "websocket" -> extensionWebSocket(trust, url)
            case "websocket-invalid" -> extensionWebSocketValidation(trust, url)
            else -> extensionOwnership(trust, url, mode)
        }
    }
    println("client interceptor case passed: " + mode)
}
