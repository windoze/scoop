package scoop.tests

import scoop.asyncio.*
import scoop.tests.scoop.crypto.testdata.rootPem
import scoop.crypto.x509.TrustStore
import scoop.http.*
import scoop.http.asyncio.*
import scoop.http.client.*
import scoop.platform.concurrent.Thread
import scoop.time.Duration
import scoop.tls.TlsTrustSource
import scoop.url.Url

internal fun idleCheck(value: Boolean) {
    if (!value)
        throw IllegalStateException(Some("HTTP client idle integration check failed"))
}

internal fun idleLimit(): Duration = Duration.seconds(5L)

internal suspend fun idleFailure(block: suspend () -> Unit): HttpTimeoutException {
    try {
        block()
    }
    catch (error: HttpTimeoutException) {
        return error
    }
    throw IllegalStateException(Some("expected HTTP idle timeout"))
}

internal fun idleCause(
    error: HttpTimeoutException,
    phase: HttpTimeoutPhase,
    protocol: HttpProtocol,
    id: Int,
    sent: Long = 0L,
    encoded: Long = 0L,
    received: Long = 0L
) {
    idleCheck(error.phase == phase && error.limit == idleLimit() && error.elapsed >= error.limit)
    idleCheck(
        error.requestBodyBytes ==
            sent &&
            error.encodedResponseBodyBytes ==
            encoded &&
            error.responseBodyBytes ==
            received
    )
    val cause = error.cause!!
    idleCheck(cause is HttpIoTimeoutException)
    if (cause is HttpIoTimeoutException) {
        idleCheck(cause.protocol == protocol && cause.streamId == id)
        idleCheck(cause.limit == error.limit && cause.elapsed == error.elapsed)
        idleCheck(
            cause.direction ==
                if (phase == HttpTimeoutPhase.ReadIdle)
                    HttpIoDirection.Read
                else
                    HttpIoDirection.Write
        )
    }
}

internal class IdleSignal {
    private var open: Boolean = false
    private var waiter: Continuation<Unit>? = None
    fun signal() {
        open = true;
        val saved = waiter;
        waiter = None;
        saved?.resume(Unit)
    }
    suspend fun await() {
        suspendCoroutine<Unit> {
            continuation -> if (open)
                continuation.resume(Unit)
            else
                waiter = Some(continuation)
        }
    }
}

private fun exercise(mode: String, url: Url, trust: TrustStore) {
    val cleartext =
        if (mode == "h2c")
            HttpCleartextProtocol.H2cUpgrade
        else
            if (mode == "h1-progress" || mode == "h1-gzip")
                HttpCleartextProtocol.Http1
            else
                HttpCleartextProtocol.Http2PriorKnowledge
    val config =
        HttpClientConfig(
            cleartext = cleartext,
            tls = HttpClientTlsConfig(TlsTrustSource.Store(trust)),
            pool =
                HttpConnectionPoolOptions(
                    maxConnectionsPerOrigin = 1L,
                    maxStreamsPerHttp2 =
                        if (mode == "h2-isolation")
                            2L
                        else
                            1L
                )
        )
    val loop: EventLoop = PlatformEventLoop()
    loop.run suspend {
        scope ->
        withHttpClient(config) suspend {
            client -> when (mode) {
                case "h1-progress" -> idleProgress(client, url, loop)
                case "h1-gzip" -> idleGzip(client, url)
                case "h2-isolation" -> idleIsolation(client, url, scope)
                case "h2-write" -> idleBackground(client, url, loop, scope)
                case "h2c" -> idleUpgrade(client, url)
                else -> throw IllegalArgumentException(Some("unknown idle fixture mode"))
            }
        }
        idleCheck(!scope.job.isCancelled)
    }
}

fun main(args: Array<String>) {
    idleCheck(args.size == 3L)
    val mode = args[1L]
    val url = Url.parse(args[2L])
    TrustStore.fromPem(rootPem()).use {
        trust -> Thread.start { exercise(mode, url, trust) }.use {
            thread ->
            exercise(mode, url, trust);
            thread.join()
        }
    }
    println("client idle " + mode)
}
