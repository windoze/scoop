package scoop.tests
import scoop.asyncio.*
import scoop.crypto.x509.TrustStore
import scoop.http.*
import scoop.http.asyncio.*
import scoop.http.client.*
import scoop.platform.net.*
import scoop.test.*
import scoop.url.Url

internal class InterceptorGate {
    var ready: Boolean = false
    private var waiter: Continuation<Unit>? = None
    fun signal() { ready = true; val saved = waiter; waiter = None; saved?.resume(Unit) }
    suspend fun await() { suspendCoroutine<Unit> { next -> if (ready) next.resume(Unit) else waiter = Some(next) } }
}
internal class InterceptorFailure { var value: Throwable? = None }
internal class InterceptorMarker(val text: String)
context(marker: InterceptorMarker)
internal fun interceptorMarker(): String = marker.text
internal fun <T> interceptorPresent(value: T?): Boolean = when (value) { case Some(_) -> true; case None -> false }
internal suspend fun interceptorFailure(block: suspend () -> Unit): Throwable {
    try { block() } catch (error: Throwable) { return error }
    throw IllegalStateException(Some("expected interceptor failure"))
}
internal suspend fun interceptorIgnoreClose(client: HttpClient) { try { client.close() } catch (_: Throwable) {} }
internal fun interceptorCleanupCount(error: Throwable, target: Throwable): Long {
    if (error === target) return 1L
    if (error is ResourceUseException)
        return interceptorCleanupCount(error.primaryFailure, target) + interceptorCleanupCount(error.cleanupFailure, target)
    return 0L
}
internal fun withInterceptorRuntime(block: suspend (EventLoop, CoroutineScope, AsyncTcpListener, Url) -> Unit) {
    val loop: EventLoop = LibuvEventLoop()
    loop.run suspend { scope ->
        loop.listenTcp(SocketAddress(IpAddress.IPV4_LOOPBACK, 0)).useAsync suspend { listener ->
            block(loop, scope, listener, Url.parse("http://127.0.0.1:" + listener.localAddress.port.toString() + "/"))
        }
    }
}
internal suspend fun interceptorResponse(client: HttpClient, url: Url) {
    client.withResponse(HttpRequest.get(url)) suspend { response ->
        assertEquals(200U, response.status)
        assertEquals(0L, response.body.bytes(0L).size)
    }
}
