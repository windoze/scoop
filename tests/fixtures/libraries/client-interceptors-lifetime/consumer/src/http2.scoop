package scoop.tests
import scoop.asyncio.*
import scoop.collections.emptyList
import scoop.crypto.x509.TrustStore
import scoop.http.*
import scoop.http.asyncio.*
import scoop.http.client.*
import scoop.test.*
import scoop.tls.TlsTrustSource

internal fun interceptorHttp2(trust: TrustStore) {
    withInterceptorRuntime suspend { _, scope, listener, url ->
        val entered = InterceptorGate()
        val release = InterceptorGate()
        val done = InterceptorGate()
        val serving = scope.launch suspend {
            AsyncHttp2Connection.takeOwnershipAsServer(listener.accept(), scope).useAsync suspend { connection ->
                for (id in [1, 3, 5]) {
                    val request = connection.acceptRequest()!!
                    assertEquals(id, request.stream.id)
                    request.stream.sendResponse(HttpResponseHead(HttpVersion.Http2, 200U), true)
                }
                done.await()
            }
        }
        val callback: suspend (HttpAttempt) -> List<HttpField> = suspend { attempt ->
            if (attempt.request.url.httpRequestTarget() == "/held") { entered.signal(); release.await() }
            emptyList<HttpField>()
        }
        val config = HttpClientConfig(tls = HttpClientTlsConfig(TlsTrustSource.Store(trust)), onAttempt = Some(callback),
            cleartext = HttpCleartextProtocol.Http2PriorKnowledge, pool = HttpConnectionPoolOptions(maxConnectionsPerOrigin = 1L))
        try {
            withHttpClient(config) suspend { client ->
                interceptorResponse(client, url)
                val failed = InterceptorFailure()
                val held = scope.launch suspend {
                    try { interceptorResponse(client, url.resolve("/held")) }
                    catch (error: Throwable) { failed.value = Some(error) }
                }
                entered.await()
                interceptorResponse(client, url.resolve("/other"))
                assertFalse(held.isCompleted)
                release.signal(); held.join()
                assertFalse(interceptorPresent(failed.value))
            }
        } finally { release.signal(); done.signal() }
        serving.join()
    }
}
