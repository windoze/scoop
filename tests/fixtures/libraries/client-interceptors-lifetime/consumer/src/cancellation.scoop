package scoop.tests
import scoop.asyncio.*
import scoop.collections.emptyList
import scoop.crypto.x509.TrustStore
import scoop.http.*
import scoop.http.asyncio.*
import scoop.http.client.*
import scoop.test.*
import scoop.time.Duration
import scoop.tls.TlsTrustSource

private class InterceptorHold(val child: Boolean, val failCleanup: Boolean) {
    val started: InterceptorGate = InterceptorGate()
    val cleaning: InterceptorGate = InterceptorGate()
    val release: InterceptorGate = InterceptorGate()
    val cleanup: Throwable = ResourceUseException(Throwable(), Throwable())
    var active: Boolean = false
    var finished: Boolean = false
    suspend fun hold() {
        if (child) coroutineScope<Unit> suspend { scope -> scope.launch suspend { waitForStop() }; Unit }
        else waitForStop()
    }
    private suspend fun waitForStop() {
        assertEquals("callback", interceptorMarker())
        try { active = true; started.signal(); suspendCancellableCoroutine<Unit> { _ -> } }
        finally {
            cleaning.signal(); release.await(); finished = true
            if (failCleanup) throw ResourceUseException(CancellationException(), cleanup)
        }
    }
}

internal fun interceptorLifetime(trust: TrustStore, where: String, stop: String, child: Boolean, cleanup: Boolean) {
    withInterceptorRuntime suspend { _, scope, listener, url ->
        val source = InterceptorHold(child, cleanup)
        val peerDone = InterceptorGate()
        val serving: Job? = if (where != "after") None else Some(scope.launch suspend {
            AsyncHttp1Connection.takeOwnershipAsServer(listener.accept(), scope).useAsync suspend { connection ->
                val request = connection.receiveRequest()!!
                assertEquals(0L, request.body.readAllBytes(0L).size)
                connection.sendResponse(HttpResponseHead(HttpVersion.Http11, 200U), Http1BodyFraming.Length(32L)).useAsync suspend { _ ->
                    peerDone.await()
                }
            }
        })
        val interceptor = HttpInterceptor(suspend { chain ->
            val result: HttpCallResult? = if (where == "after") Some(chain.proceed()) else None
            source.hold()
            result ?: chain.proceed()
        })
        val callback: suspend (HttpAttempt) -> List<HttpField> = suspend { _ -> source.hold(); emptyList<HttpField>() }
        val config = HttpClientConfig(tls = HttpClientTlsConfig(TlsTrustSource.Store(trust)),
            interceptors = if (where == "attempt") emptyList<HttpInterceptor>() else [interceptor], onAttempt = if (where == "attempt") Some(callback) else None,
            retries = HttpRetryOptions(maxRetries = 2L))
        val client = HttpClient.open(scope, config)
        val failed = InterceptorFailure()
        val closed = InterceptorFailure()
        val running = scope.launch suspend {
            try {
                context(InterceptorMarker("callback")) {
                    val options = HttpCallOptions(timeouts = if (stop == "total")
                        Some(HttpTimeoutOptions(total = Some(Duration.seconds(2L)))) else None)
                    client.execute(HttpRequest.get(url, options = options))
                }
            } catch (error: Throwable) { failed.value = Some(error) }
            finally { source.started.signal() }
            if (stop != "caller") ensureActive()
        }
        source.started.await()
        val closing: Job? = if (stop != "client") None else Some(scope.launch suspend {
            try { client.close() } catch (error: Throwable) { closed.value = Some(error) }
        })
        if (stop == "caller") running.cancel()
        try {
            assertTrue(source.active, Some("request finished before the selected interceptor"))
            source.cleaning.await()
            assertFalse(source.finished || running.isCompleted || client.isClosed)
            if (stop == "client") assertFalse(closing!!.isCompleted)
            source.release.signal()
            running.join(); closing?.join()
            assertTrue(source.finished)
            val failure = failed.value!!
            val primary = if (cleanup) (failure as ResourceUseException).primaryFailure else failure
            if (cleanup) {
                assertEquals(1L, interceptorCleanupCount(failure, source.cleanup))
                assertSame(source.cleanup, (failure as ResourceUseException).cleanupFailure)
            }
            when (stop) {
                "caller" -> assertTrue(primary is CancellationException)
                "client" -> {
                    assertTrue(primary is HttpClientClosedException)
                    assertTrue(client.isClosed)
                    if (cleanup) assertSame(source.cleanup, closed.value!!)
                    else assertFalse(interceptorPresent(closed.value))
                }
                else -> {
                    assertTrue(primary is HttpTimeoutException)
                    assertEquals(HttpTimeoutPhase.Total, (primary as HttpTimeoutException).phase)
                }
            }
            ensureActive()
        } finally {
            source.release.signal(); peerDone.signal()
            interceptorIgnoreClose(client)
            running.join(); closing?.join(); serving?.join()
        }
    }
}
