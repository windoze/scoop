package scoop.tests
import scoop.asyncio.*
import scoop.collections.emptyList
import scoop.crypto.x509.TrustStore
import scoop.http.*
import scoop.http.asyncio.*
import scoop.http.client.*
import scoop.test.*
import scoop.tls.TlsTrustSource

private class InterceptorChecks {
    var client: HttpClient? = None
    var result: HttpCallResult? = None
    var checked: Boolean = false
    suspend fun check(child: Boolean) {
        if (child) coroutineScope<Unit> suspend { scope -> scope.launch suspend { check(false) }; Unit }
        else {
            assertTrue(interceptorFailure suspend { client!!.close() } is IllegalStateException)
            assertFalse(client!!.isClosed)
            checked = true
        }
    }
}

internal fun interceptorSelfWait(trust: TrustStore, where: String, child: Boolean) {
    withInterceptorRuntime suspend { _, scope, listener, url ->
        val state = InterceptorChecks()
        val peerDone = InterceptorGate()
        val serving = scope.launch suspend {
            AsyncHttp1Connection.takeOwnershipAsServer(listener.accept(), scope).useAsync suspend { connection ->
                val request = connection.receiveRequest()!!
                assertEquals(0L, request.body.readAllBytes(0L).size)
                connection.sendResponse(HttpResponseHead(HttpVersion.Http11, 200U), Http1BodyFraming.Length(0L)).useAsync suspend { writer -> writer.finish() }
                peerDone.await()
            }
        }
        val interceptor = HttpInterceptor(suspend { chain ->
            if (where == "before") state.check(child)
            val result = chain.proceed()
            if (where == "after") state.check(child)
            result
        })
        val callback: suspend (HttpAttempt) -> List<HttpField> = suspend { _ -> state.check(child); emptyList<HttpField>() }
        val config = HttpClientConfig(tls = HttpClientTlsConfig(TlsTrustSource.Store(trust)),
            interceptors = if (where == "attempt") emptyList<HttpInterceptor>() else [interceptor], onAttempt = if (where == "attempt") Some(callback) else None)
        try {
            withHttpClient(config) suspend { client ->
                state.client = Some(client)
                interceptorResponse(client, url)
                assertTrue(state.checked)
            }
        } finally { peerDone.signal() }
        serving.join()
    }
}

internal fun interceptorConcurrentProceed(trust: TrustStore) {
    withInterceptorRuntime suspend { _, scope, listener, url ->
        val received = InterceptorGate()
        val respond = InterceptorGate()
        val peerDone = InterceptorGate()
        val state = InterceptorChecks()
        val serving = scope.launch suspend {
            AsyncHttp1Connection.takeOwnershipAsServer(listener.accept(), scope).useAsync suspend { connection ->
                val request = connection.receiveRequest()!!
                assertEquals(0L, request.body.readAllBytes(0L).size)
                received.signal(); respond.await()
                connection.sendResponse(HttpResponseHead(HttpVersion.Http11, 200U), Http1BodyFraming.Length(0L)).useAsync suspend { writer -> writer.finish() }
                peerDone.await()
            }
        }
        val interceptor = HttpInterceptor(suspend { chain ->
            coroutineScope<Unit> suspend { nested ->
                val first = nested.launch suspend { state.result = Some(chain.proceed()) }
                received.await()
                assertTrue(interceptorFailure suspend { chain.proceed(); Unit } is IllegalStateException)
                respond.signal(); first.join()
            }
            state.result!!
        })
        try {
            withHttpClient(HttpClientConfig(tls = HttpClientTlsConfig(TlsTrustSource.Store(trust)), interceptors = [interceptor])) suspend { client ->
                interceptorResponse(client, url)
            }
        } finally { respond.signal(); peerDone.signal() }
        serving.join()
    }
}
