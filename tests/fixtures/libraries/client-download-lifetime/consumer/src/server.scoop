package scoop.tests
import scoop.asyncio.*
import scoop.http.*
import scoop.http.asyncio.AsyncHttp1Connection
import scoop.platform.fs.Path
import scoop.platform.net.*
import scoop.url.Url

internal fun downloadWithServer(directory: Path,
    block: suspend (EventLoop, CoroutineScope, Url, DownloadGate) -> Unit) {
    val loop: EventLoop = LibuvEventLoop()
    loop.run suspend { scope ->
        loop.createDirectories(directory)
        loop.listenTcp(SocketAddress(IpAddress.IPV4_LOOPBACK, 0)).useAsync suspend { listener ->
            val finish = DownloadGate()
            val serving = scope.launch suspend {
                AsyncHttp1Connection.takeOwnershipAsServer(listener.accept(), scope).useAsync suspend { connection ->
                    val request = connection.receiveRequest()!!
                    request.body.close()
                    connection.sendResponse(HttpResponseHead(HttpVersion.Http11, 200U), Http1BodyFraming.Length(4L)).useAsync suspend { writer ->
                        downloadWrite(writer, "body"); writer.finish()
                    }
                    finish.await()
                }
            }
            try { block(loop, scope, Url.parse("http://127.0.0.1:" + listener.localAddress.port.toString() + "/"), finish) }
            finally { finish.signal() }
            serving.join()
        }
    }
}
