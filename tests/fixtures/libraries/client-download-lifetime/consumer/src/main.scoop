package scoop.tests
import scoop.tests.scoop.crypto.testdata.rootPem
import scoop.crypto.x509.TrustStore
import scoop.http.client.HttpDownloadOptions
import scoop.platform.fs.Path
import scoop.test.*

fun main(args: Array<String>) {
    assertTrue(args.size >= 3L)
    val root = Path.fromString(args[1L])
    val name = args[2L]
    assertFailsWith<IllegalArgumentException> { HttpDownloadOptions(bufferSize = 0L) }
    assertFailsWith<IllegalArgumentException> { HttpDownloadOptions(bufferSize = -1L) }
    TrustStore.fromPem(rootPem()).use { trust ->
        try {
            when (name) {
                case "cancel" -> {
                    assertEquals(6L, args.size)
                    downloadCancellation(trust, root, downloadBoolean(args[3L]), args[4L], args[5L])
                }
                case "callback" -> {
                    assertEquals(4L, args.size)
                    downloadCallbackFailure(trust, root, downloadBoolean(args[3L]))
                }
                case "self-close" -> { assertEquals(3L, args.size); downloadSelfClose(trust, root) }
                case "file-error" -> { assertEquals(3L, args.size); downloadFileFailure(trust, root) }
                case "invalid-path" -> { assertEquals(3L, args.size); downloadInvalidPath(trust) }
                else -> throw IllegalArgumentException()
            }
        } catch (error: AssertionFailure) { reportDownloadAssertion(name, error); throw error }
    }
    println("download lifetime case passed")
}

private fun downloadBoolean(value: String): Boolean = when (value) {
    case "false" -> false
    case "true" -> true
    else -> throw IllegalArgumentException()
}

private fun reportDownloadAssertion(name: String, error: AssertionFailure) {
    println(name + " " + error.kind + " " + (error.message ?: "failure") + " at " + error.location.line.toString())
}
