package scoop.tests
import scoop.asyncio.*
import scoop.crypto.x509.TrustStore
import scoop.http.*
import scoop.http.asyncio.AsyncHttp1Connection
import scoop.http.client.*
import scoop.platform.memory.NativeByteBuffer

private class LifeSource(val holding: Boolean, val failure: Throwable?) : AsyncByteSource, AsyncCloseable {
    val cleaning: LifeGate = LifeGate()
    val release: LifeGate = LifeGate()
    var closed: Boolean = false
    private var consumed: Boolean = false
    public override suspend fun readInto(buffer: NativeByteBuffer, count: Long): Long {
        if (consumed || count == 0L) return 0L
        lifeCheck(count >= 4L, "source read count " + count.toString())
        buffer.writeBytes("sent".toByteArray()); consumed = true
        return 4L
    }
    public override suspend fun close() {
        cleaning.signal()
        if (holding) release.await()
        closed = true
        if (lifePresent(failure)) throw failure!!
    }
}

internal fun lifeSourceCleanup(trust: TrustStore, fail: Boolean) {
    withLifeRuntime suspend { _, scope, listener ->
        val url = lifeUrl(listener)
        val cleanup = IllegalStateException(Some("source cleanup"))
        val first = LifeSource(true, if (fail) Some<Throwable>(cleanup) else None)
        val next = LifeSource(false, None)
        val created = AtomicLong(0L)
        val callbacks = AtomicLong(0L)
        val challenged = LifeGate()
        val provider = HttpAuthenticator.basic(url.httpOrigin()) suspend { _ ->
            lifeCheck(first.closed, "credentials ran before source close completed")
            callbacks.fetchAdd(1L)
            HttpPasswordCredentials("user", "password")
        }
        val body = RequestBody.fromSourceFactory(Some(4L)) suspend {
            if (created.fetchAdd(1L) == 0L) first else next
        }
        val serving = scope.launch suspend {
            AsyncHttp1Connection.takeOwnershipAsServer(listener.accept(), scope).useAsync suspend { connection ->
                lifeCheck(String.fromUtf8(connection.receiveRequest()!!.body.readAllBytes(4L)) == "sent")
                lifeRespond(connection, 407U, extra = [lifeField("Proxy-Authenticate", "Basic realm=\"private\"")])
                challenged.signal()
            }
            if (!fail) AsyncHttp1Connection.takeOwnershipAsServer(listener.accept(), scope).useAsync suspend { connection ->
                lifeCheck(String.fromUtf8(connection.receiveRequest()!!.body.readAllBytes(4L)) == "sent")
                lifeRespond(connection, 200U, "done")
            }
        }
        withHttpClient(lifeConfig(trust, lifeSelector(HttpProxyEndpoint(url, authentication = HttpAuthenticationOptions([provider]))))) suspend { client ->
            val failure = LifeFailure()
            val executing = scope.launch suspend {
                try {
                    client.withResponse(HttpRequest.post(url, body)) suspend { response ->
                        lifeCheck(response.proxyAuthenticationCount == 1L && response.authenticationCount == 0L && response.body.text(4L) == "done")
                    }
                } catch (error: Throwable) { failure.value = Some(error) }
            }
            try {
                first.cleaning.await(); challenged.await()
                lifeCheck(callbacks.load() == 0L, "credentials started during held source close")
                lifeCheck(created.load() == 1L, "another source was opened during held source close")
                lifeCheck(!executing.isCompleted, "execute returned during held source close")
                first.release.signal()
                executing.join()
                if (fail) lifeCheck(failure.value!! === cleanup && callbacks.load() == 0L)
                else {
                    if (lifePresent(failure.value)) throw failure.value!!
                    lifeCheck(created.load() == 2L, "source factory count " + created.load().toString())
                    lifeCheck(next.closed, "second source is still open")
                    lifeCheck(callbacks.load() == 1L, "credentials callback count " + callbacks.load().toString())
                }
            } finally { first.release.signal() }
        }
        serving.join()
    }
}
