package scoop.tests
import scoop.asyncio.EventLoop
import scoop.http.client.*
import scoop.time.Duration
import scoop.url.Url

internal suspend fun networkTlsReuse(client: HttpClient, port: String, loop: EventLoop) {
    val url = Url.parse("https://127.0.0.1:" + port + "/reuse")
    val limit = Duration.seconds(15L)
    val options = HttpCallOptions(timeouts = Some(HttpTimeoutOptions(tlsHandshake = Some(limit))))
    client.withResponse(HttpRequest.get(url, options = options)) suspend { response ->
        loop.sleep(limit + Duration.milliseconds(20L))
        networkCheck(response.body.text(2L) == "ok")
    }
    val zero = Some(Duration.ZERO)
    val allZero = HttpTimeoutOptions(resolve = zero, connect = zero, tlsHandshake = zero)
    client.withResponse(HttpRequest.get(url, options = HttpCallOptions(timeouts = Some(allZero)))) suspend { response ->
        networkCheck(response.body.text(2L) == "ok")
    }
}
