package scoop.tests
import scoop.asyncio.*
import scoop.crypto.x509.TrustStore
import scoop.http.client.*
import scoop.test.*
import scoop.time.Duration
import scoop.tls.TlsTrustSource

private class ObserverHold(val child: Boolean, val failCleanup: Boolean) {
    val started: ObserverGate = ObserverGate()
    val cleaning: ObserverGate = ObserverGate()
    val release: ObserverGate = ObserverGate()
    val returned: ObserverGate = ObserverGate()
    val cleanup: Throwable = ResourceUseException(Throwable(), Throwable())
    var finished: Boolean = false
    suspend fun hold() {
        if (child) coroutineScope<Unit> suspend { scope -> scope.launch suspend { waitForStop() }; Unit }
        else waitForStop()
    }
    private suspend fun waitForStop() {
        assertEquals("callback", observerMarker())
        try { started.signal(); suspendCancellableCoroutine<Unit> { _ -> } }
        finally {
            cleaning.signal(); release.await(); finished = true; returned.signal()
            if (failCleanup) throw ResourceUseException(CancellationException(), cleanup)
        }
    }
}

internal fun observerLifetime(trust: TrustStore, where: HttpCallEventKind, stop: String, child: Boolean, cleanup: Boolean) {
    withObserverRuntime suspend { _, scope, listener, url ->
        val hold = ObserverHold(child, cleanup)
        val peerDone = ObserverGate()
        val serving: Job? = if (where == HttpCallEventKind.AttemptStarted) None
            else Some(scope.launch suspend { observerServe(scope, listener, where, peerDone) })
        val observer = HttpObserver(suspend { event -> if (event.kind == where) hold.hold() })
        val config = HttpClientConfig(tls = HttpClientTlsConfig(TlsTrustSource.Store(trust)), observer = Some(observer),
            retries = HttpRetryOptions(maxRetries = 2L))
        val client = HttpClient.open(scope, config)
        val failed = ObserverFailure()
        val closed = ObserverFailure()
        val running = scope.launch suspend {
            try {
                context(ObserverMarker("callback")) {
                    val options = HttpCallOptions(timeouts = if (stop == "total")
                        Some(HttpTimeoutOptions(total = Some(Duration.seconds(2L)))) else None)
                    val request = if (where == HttpCallEventKind.RequestProgress)
                        HttpRequest(url, "POST", body = RequestBody.fromText("x"), options = options) else HttpRequest.get(url, options = options)
                    val response = client.execute(request)
                    response.useAsync suspend { response ->
                        response.body.bytes(4L)
                        if (where == HttpCallEventKind.Completed) {
                            hold.returned.await()
                            ensureActive()
                        }
                        Unit
                    }
                }
            } catch (error: Throwable) { failed.value = Some(error) }
            assertTrue(hold.finished)
            if (stop != "caller") ensureActive()
        }
        hold.started.await()
        val closing: Job? = if (stop != "client") None else Some(scope.launch suspend {
            try { client.close() } catch (error: Throwable) { closed.value = Some(error) }
        })
        if (stop == "caller") running.cancel()
        try {
            hold.cleaning.await()
            assertFalse(hold.finished || running.isCompleted || client.isClosed)
            if (stop == "client") assertFalse(closing!!.isCompleted)
            hold.release.signal()
            running.join(); closing?.join()
            assertTrue(hold.finished)
            val failure = failed.value!!
            val primary = observerPrimary(failure)
            if (cleanup) assertEquals(1L, observerCleanupCount(failure, hold.cleanup))
            when (stop) {
                "caller" -> assertTrue(primary is CancellationException)
                "client" -> {
                    assertTrue(primary is HttpClientClosedException)
                    assertTrue(client.isClosed)
                    if (cleanup) assertEquals(1L, observerCleanupCount(closed.value!!, hold.cleanup))
                    else assertFalse(observerPresent(closed.value))
                }
                else -> {
                    assertTrue(primary is HttpTimeoutException)
                    assertEquals(HttpTimeoutPhase.Total, (primary as HttpTimeoutException).phase)
                }
            }
            ensureActive()
        } finally {
            hold.release.signal(); peerDone.signal()
            observerIgnoreClose(client)
            running.join(); closing?.join(); serving?.join()
        }
    }
}
