package scoop.tests
import scoop.asyncio.*
import scoop.http.*
import scoop.http.client.*
import scoop.test.*
import scoop.url.Url

internal suspend fun wsClientSession(client: HttpClient, session: HttpWebSocketSession, mode: String) {
    assertEquals(101U, session.head.status)
    assertEquals(HttpVersion.Http11, session.head.version)
    assertEquals(Some("chat"), session.protocol)
    assertTrue(session.url.scheme == Some("ws") || session.url.scheme == Some("wss"))
    assertEquals(mode == "deflate", wsClientPresent(session.deflate))
    assertEquals(if (mode == "retry") 1L else 0L, session.retryCount)
    if (mode == "redirect" || mode == "ws-redirect") {
        assertEquals(1L, session.redirectHistory.size)
        assertEquals(Some("ws"), session.redirectHistory[0L].url.scheme)
        assertEquals(Some("ws"), session.redirectHistory[0L].nextUrl.scheme)
        assertEquals("/final?x=%2F", session.url.httpRequestTarget())
    } else assertEquals(0L, session.redirectHistory.size)
    assertEquals("ready 🌍", session.receive()!!.readText())
    if (mode != "force-h2") wsClientProbe(client, session.url)
    session.sendText("client 🌍")
    assertEquals("echo:client 🌍", session.receive()!!.readText())
    session.ping("health".toByteArray())
    val bytes = Array<Byte>(257L) { index -> index.toByte() }
    session.sendBinary(bytes, false)
    val echo = session.receive()!!
    assertEquals(WebSocketMessageType.Binary, echo.type)
    val actual = echo.readBytes()
    assertEquals(bytes.size, actual.size)
    for (index in 0L..<bytes.size) assertEquals(bytes[index], actual[index])
    val close = session.shutdownGracefully(WebSocketClose(Some(1000U), "finished"))
    assertEquals(Some(1000U), close.code)
    assertEquals("finished", close.reason)
    session.awaitClosed()
    assertTrue(session.isClosed)
    assertFalse(wsClientPresent(session.failure) || wsClientPresent(session.receive()))
}

internal suspend fun wsClientProbe(client: HttpClient, url: Url) {
    val scheme = if (url.scheme == Some("wss")) "https" else "http"
    val target = url.toBuilder().setScheme(Some(scheme)).build().resolve(Url.parse("/probe"))
    client.withResponse(HttpRequest.get(target)) suspend { response ->
        assertEquals("probe", response.body.text(128L))
    }
}
internal fun <T> wsClientPresent(value: T?): Boolean = when (value) { case Some(_) -> true; case None -> false }
internal suspend fun wsClientFailure(block: suspend () -> Unit): Throwable {
    try { block() } catch (error: Throwable) { return error }
    throw IllegalStateException(Some("expected WebSocket client failure"))
}
