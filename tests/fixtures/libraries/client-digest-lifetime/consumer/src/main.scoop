package scoop.tests
import scoop.tests.scoop.crypto.testdata.rootPem
import scoop.crypto.x509.TrustStore
import scoop.platform.concurrent.Thread

private fun exercise(args: Array<String>, trust: TrustStore) {
    when (args[1L]) {
        case "callback" -> digestCancellation(trust, args[2L])
        case "callback-cleanup" -> digestCancellation(trust, args[2L], true)
        case "callback-wrapped" -> digestCancellation(trust, args[2L], true, true)
        case "prehash" -> digestPrehash(trust, args[2L], false)
        case "prehash-cleanup" -> digestPrehash(trust, args[2L], true)
        else -> throw IllegalArgumentException()
    }
}

private fun runMain(args: Array<String>) {
    digestCheck(args.size == 3L)
    TrustStore.fromPem(rootPem()).use { trust ->
        Thread.start { exercise(args, trust) }.use { thread -> exercise(args, trust); thread.join() }
    }
    println("Digest lifetime " + args[1L] + " " + args[2L])
}

fun main(args: Array<String>) {
    try { runMain(args) }
    catch (error: Throwable) { digestReport(error); throw error }
}
