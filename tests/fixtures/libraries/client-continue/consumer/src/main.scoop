package scoop.tests
import scoop.asyncio.*
import scoop.tests.scoop.crypto.testdata.rootPem
import scoop.crypto.x509.TrustStore
import scoop.http.*
import scoop.http.client.*
import scoop.platform.concurrent.Thread
import scoop.platform.memory.NativeByteBuffer
import scoop.time.Duration
import scoop.tls.TlsTrustSource
import scoop.url.Url

private fun check(value: Boolean) { if (!value) throw IllegalStateException(Some("HTTP Continue integration check failed")) }

private suspend fun send(client: HttpClient, mode: String, url: Url, text: String = "一次上传") {
    val started = AtomicBoolean(false)
    val information = ArrayList<UInt>()
    val payload = text.toByteArray()
    val body = if (mode == "empty") RequestBody.Empty else RequestBody.fromProducer(Some(payload.size)) suspend { output ->
        check(!started.exchange(true))
        NativeByteBuffer.allocate(payload.size).use suspend { buffer ->
            buffer.writeBytes(payload)
            output.writeFully(buffer)
        }
    }
    val options = HttpCallOptions(expectContinue = true,
        continueWait = if (mode == "timeout") Duration.milliseconds(2L) else Duration.seconds(60L),
        onInformational = suspend { head ->
            information.add(head.status)
            if (head.status == 103U) {
                check(!started.load())
                if (mode == "cancel") throw CancellationException()
            }
            Unit
        })
    val request = if (mode == "empty") HttpRequest.get(url, options = options) else HttpRequest.post(url, body, options = options)
    if (mode == "cancel") {
        var cancelled = false
        try { client.execute(request).close() }
        catch (_: CancellationException) { cancelled = true }
        check(cancelled && !started.load())
        return
    }
    client.withResponse(request) suspend { response ->
        check(response.version == (if (mode == "h2" || mode == "h2c") HttpVersion.Http2 else HttpVersion.Http11))
        check(response.status == (if (mode == "reject") 417U else 200U))
        check(String.fromUtf8(response.body.readAllBytes(2L)) == (if (mode == "reject") "no" else "ok"))
        check(started.load() == (mode != "empty" && mode != "reject"))
    }
    check(information.size == (if (mode == "continue") 3L else if (mode == "reject" || mode == "empty") 0L else 1L))
}

private fun runClient(mode: String, base: Url, trust: TrustStore) {
    val loop: EventLoop = LibuvEventLoop()
    loop.run suspend { scope ->
        val cleartext = if (mode == "h2") HttpCleartextProtocol.Http2PriorKnowledge
            else if (mode == "h2c") HttpCleartextProtocol.H2cUpgrade else HttpCleartextProtocol.Http1
        val config = HttpClientConfig(cleartext = cleartext, tls = HttpClientTlsConfig(TlsTrustSource.Store(trust)),
            pool = HttpConnectionPoolOptions(maxConnectionsPerOrigin = 1L))
        withHttpClient(config) suspend { client ->
            if (mode == "h2") {
                val first = scope.launch suspend { send(client, mode, base.resolve("first"), "first") }
                val second = scope.launch suspend { send(client, mode, base.resolve("second"), "second") }
                first.join(); second.join()
            } else send(client, mode, base)
        }
        check(!scope.job.isCancelled)
    }
}

fun main(args: Array<String>) {
    check(args.size == 3L)
    val mode = args[1L]
    val base = Url.parse(args[2L])
    TrustStore.fromPem(rootPem()).use { trust ->
        Thread.start { runClient(mode, base, trust) }.use { thread ->
            runClient(mode, base, trust)
            thread.join()
        }
    }
    println("continue " + mode)
}
