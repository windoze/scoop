package test
import scoop.asyncio.*
import scoop.terminal.asyncio.*
import scoop.terminal.event.*
import scoop.time.Duration

suspend fun cancelled(loop: EventLoop, scope: CoroutineScope, session: AsyncTerminalSession) {
    stage(session, "query-cancel")
    val waiting = scope.launch suspend { session.cursorPosition(Duration.seconds(10L)) }
    loop.sleep(Duration.milliseconds(500L))
    waiting.cancel()
    waiting.join()
    check(waiting.isCancelled, "query cancellation")
    restored(session)
    stage(session, "query-after-cancel")
    expect(session, key('u'))
    expect(session, Event.FocusGained)
    expect(session, Event.Key(KeyEvent(KeyCode.Enter)))
}
