package consumer.closures
import upstream.closures.*

private fun <T, U> localDefault(
    seed: T,
    marker: U,
    read: () -> T = { defaultAnonymous<T, U>(seed, marker) }
): T = read()

public fun <T> exercise(seed: T, inspect: (T) -> Int): Int {
    val expected = inspect(seed)
    val first = readers<T, Int>(seed, 0, inspect)
    val repeated = readers<T, Unit>(seed, Unit, inspect)
    val different = readers<Int, T>(43, seed, { value -> value })
    if (first() != expected || repeated() != expected || different() != 43) { return 1 }
    if (inspect(defaultLambda<T, Unit>(seed, Unit)) != expected) { return 2 }
    if (inspect(defaultAnonymous<T, Int>(seed, 0)) != expected) { return 3 }
    if (defaultAnonymous<Int, Unit>(42, Unit) != 42) { return 4 }
    if (defaultAnonymous<Int, Unit>(43, Unit) != 43) { return 5 }
    val outer = nested<T, Unit>(seed, Unit)
    val inner = outer()
    if (inspect(inner()) != expected) { return 6 }
    if (inspect(nestedDefault<T, Int>(seed, 0)) != expected) { return 7 }
    if (inspect(localDefault<T, Unit>(seed, Unit)) != expected) { return 8 }
    val box = Box<T>(seed)
    val fromForeign = readers<Box<T>, Unit>(box, Unit, { value -> inspect(value.value) })
    if (fromForeign() != expected) { return 9 }
    return first()
}

public fun result(): Int = exercise<Int>(42, { value -> value })
