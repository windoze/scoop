import scoop.platform.memory.NativeByteBuffer
import scoop.platform.fs.*
import scoop.platform.io.*
import scoop.platform.env.*
import scoop.platform.random.SystemRandom
import scoop.platform.time.*
import scoop.platform.system.*
import scoop.platform.concurrent.*

fun main() {
    val path = Path.fromString("/alpha/../beta//").normalizeLexically()
    println(path.decodeUtf8())
    println(path.fileName!!.decodeUtf8())
    println(path.hash() == Path.fromString("/beta").hash())
    val raw = OsString.fromBytes(Array<Byte>(2L) { index -> if (index == 0L) 97 else -1 })
    println(Path.fromOsString(raw).toOsString().toBytes()[1L])
    try { raw.decodeUtf8() } catch (error: CharacterCodingException) { println(error.byteOffset) }
    val error = NativeError(NativeErrorDomain.PosixErrno, Int.MAX_VALUE)
    println(error.kind == PlatformErrorKind.Other)
    val failure = PlatformException("open", error.kind, Some(error), Some(raw))
    println(failure.operation)
    val buffer = NativeByteBuffer.allocate(2L)
    println(buffer.use { current ->
        current.writeByte(7.toInt8())
        @Unsafe {
            return@use current.withReadableBytes { pointer, _ ->
                @Unsafe { return@withReadableBytes pointer!!.load() }
            }
        }
    })
    println(buffer.isDisposed)
    val directory = Files.createTempDirectory(prefix = "scoop-artifact-")
    try {
        val file = directory.resolve(Path.fromString("text"))
        BufferedSink.takeOwnership(File.open(file, OpenOptions(write = true, createNew = true))).use {
            it.writeLine("artifact 中")
        }
        BufferedSource.takeOwnership(File.open(file)).use {
            if (it.readLine()!! != "artifact 中" || it.readLine() != None) throw IllegalStateException()
            Unit
        }
    } finally { Files.deleteRecursively(directory) }
    if (arguments().size == 0L || logicalProcessorCount <= 0L) throw IllegalStateException()
    if (SystemRandom.nextBytes(32L).size != 32L) throw IllegalStateException()
    if (SystemClock.now().nanosecondsOfSecond < 0) throw IllegalStateException()
    val mark = MonotonicTimeSource.markNow()
    if (MonotonicTimeSource.markNow() < mark) throw IllegalStateException()
    for ((name, value) in environment()) {
        if (environmentVariable(name)!! != value) throw IllegalStateException()
    }
    Mutex().use { mutex ->
        ConditionVariable(mutex).use { condition ->
            val completed = AtomicBoolean(false)
            val worker = Thread.start {
                mutex.withLock { completed.store(true); condition.signal() }
            }
            mutex.withLock { while (!completed.load()) condition.await() }
            worker.join()
        }
    }
}
