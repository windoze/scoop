package consumer.callprobes
import upstream.callprobes.*

public fun <T> exercise(seed: T, inspect: (T) -> Int): Int {
    val empty: Empty<T> = Empty()
    if (empty.identity<_>(42) != 42) { return 1 }
    val pair = Pair<_, Int>(seed, 42)
    if (inspect(pair.first) != 42 || pair.second != 42) { return 2 }
    val holder = Holder<_>(seed)
    if (holder.apply<_>(2, { value, increment -> inspect(value) + increment }) != 44) { return 3 }
    val packet: Packet<T> = Packet.Item(seed)
    if (when (packet) { Item(value) -> inspect(value); Missing -> 0 } != 42) { return 4 }
    val identity: (T) -> T = { value -> value }
    if (inspect(map(identity, seed)) != 42) { return 5 }
    val mapped: Int = map<Int, _>({ value -> value + 1 }, 41)
    if (mapped != 42) { return 6 }
    val counter = Counter()
    val chosen = choose(41, { value -> counter.calls = counter.calls + 1; value + 1 })
    if (chosen != 42 || counter.calls != 1) { return 7 }
    if (plain(41, fun(value: Int): Int { return value + 1 }) != 42) { return 8 }
    return 42
}

public fun result(): Int = exercise<Int>(42, { value -> value })
