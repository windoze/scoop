package tuple.provider

public struct Envelope(val pair: (Int, String)) {
    public companion object : ValueEncoder<Envelope>, ValueDecoder<Envelope>
}
public class PairEncoder<A, B> public constructor(private val first: ValueEncoder<A>, private val second: ValueEncoder<B>)
    : ValueEncoder<(A, B)>
public fun pair(): (Int, String) = (41, "provider")
public fun <T> erasePair(value: T): Any = (value, Unit)
public fun <T> encoding(element: ValueEncoder<T>): ((T, String), Encoder) -> Unit {
    val codec = PairEncoder(element, String.Companion)
    return codec::encode
}
public fun array(): Array<(Int, String)> = Array<(Int, String)>(1L) { _ -> pair() }
public object PairCodec : ValueEncoder<(Int, String)>, ValueDecoder<(Int, String)>
