import scoop.json.Json
import tuple.provider.Envelope
import tuple.provider.PairCodec
import tuple.provider.PairEncoder
import tuple.provider.pair
import tuple.provider.array
import tuple.provider.erasePair
import tuple.provider.encoding
import tuple.peer.combine
import tuple.peer.erased

private struct Opaque()
private class Captured<T>(private val write: (T, Encoder) -> Unit) : Encodable<T> {
    public override fun encode(value: T, encoder: Encoder) { write(value, encoder) }
}
private fun check(value: Boolean) { if (!value) { throw IllegalStateException(None) } }

fun main() {
    check(Json.encode(pair(), PairCodec) == "[41,\"provider\"]")
    check(Json.encode((44, "local"), PairCodec) == "[44,\"local\"]")
    check(Json.encode(combine(), PairEncoder(PairCodec, PairCodec)) == "[[41,\"provider\"],[42,\"peer\"]]")
    check(Json.encode(array(), Array<(Int, String)>.encoder(PairCodec)) == "[[41,\"provider\"]]")
    check(Json.encode((45, "reference"), Captured(encoding(Int.Companion))) == "[45,\"reference\"]")
    val good = erasePair((46, "generic"))
    check(!(good is Encodable<((Int, String), Unit)>))
    check(Json.encode(good as ((Int, String), Unit), PairEncoder(PairCodec, UnitEncoder))
        == "[[46,\"generic\"],null]")
    check(!(erasePair(Opaque()) is Encodable<(Opaque, Unit)>))
    val other = erased()
    check(!(other is Encodable<(Int, String)>))
    check(Json.encode(other as (Int, String), PairCodec) == "[43,\"erased\"]")
    check(Json.encode(Json.decode("[47,\"decode\"]", PairCodec), PairCodec) == "[47,\"decode\"]")
    check(Json.encode(Json.decode("{\"pair\":[48,\"field\"]}", Envelope.Companion), Envelope.Companion)
        == "{\"pair\":[48,\"field\"]}")
    println("tuple-encoding-artifacts-ok")
}
