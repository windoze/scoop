import scoop.*
import scoop.collections.*
import scoop.comparisons.*
import scoop.datetime.*
import scoop.time.*
import scoop.uuid.Uuid
import scoop.json.Json

fun check(ok: Boolean) { if (!ok) throw IllegalStateException() }
fun <T> bad(text: String, codec: ValueDecoder<T>, path: String) {
    var failed = false
    try { Json.decodeFromString(text, codec) } catch (error: DecodingException) { check(error.path == path); failed = true }
    check(failed)
}
fun propagates(block: () -> Unit) {
    var failed = false
    try { block() } catch (error: IllegalStateException) { failed = true }
    check(failed)
}
class BadKey : Equals<BadKey>, Hash {
    public override operator fun equals(other: BadKey): Boolean = false
    public override fun hash(): Long = throw IllegalStateException()
}
fun main() {
    bad("[[1,2],[1,3]]", HashMap<Int, Int>.decoder(Int.Companion, Int.Companion), "/1/0")
    bad("[[1,2],[1,3]]", LinkedHashMap<Int, Int>.decoder(Int.Companion, Int.Companion), "/1/0")
    bad("[[1,2,3]]", HashMap<Int, Int>.decoder(Int.Companion, Int.Companion), "/0")
    bad("[[1]]", HashMap<Int, Int>.decoder(Int.Companion, Int.Companion), "/0/1")
    bad("[[]]", HashMap<Int, Int>.decoder(Int.Companion, Int.Companion), "/0/0")
    bad("[[1,null],[1,2]]", HashMap<Int, Int?>.decoder(Int.Companion, Option<Int>.decoder(Int.Companion)), "/1/0")
    bad("[1,1]", HashSet<Int>.decoder(Int.Companion), "/1")
    bad("[1,1]", LinkedHashSet<Int>.decoder(Int.Companion), "/1")
    val magnitude = comparatorOf<Int> { a, b -> (if (a < 0) -a else a).compareTo(if (b < 0) -b else b) }
    bad("[1,-1]", TreeSet<Int>.decoder(Int.Companion, magnitude), "/1")
    bad("[[1,2],[-1,3]]", TreeMap<Int, Int>.decoder(Int.Companion, Int.Companion, magnitude), "/1/0")
    bad("[1,\"bad\"]", ArrayDeque<Int>.decoder(Int.Companion), "/1")
    bad("[1,\"bad\"]", PriorityQueue<Int>.decoder(Int.Companion, naturalOrder<Int>()), "/1")
    bad("[\"2023-02-29\"]", listDecoder(LocalDate.Companion), "/0")
    bad("\"invalid\"", Uuid.Companion, ""); bad("\"PT\"", Duration.Companion, "")
    bad("\"1970-01-01T00:00:00\"", Instant.Companion, "")
    bad("\"24:00:00\"", LocalTime.Companion, ""); bad("\"2024-01-01\"", LocalDateTime.Companion, "")
    bad("\"+18:00:01\"", UtcOffset.Companion, ""); bad("\"2024-13\"", YearMonth.Companion, "")
    bad("\"2024-01-01T00:00:00\"", OffsetDateTime.Companion, "")
    bad("{}", DatePeriod.Companion, "/years")
    bad("{\"years\":0,\"months\":0}", DatePeriod.Companion, "/days")
    bad("{\"years\":2147483648,\"months\":0,\"days\":0}", DatePeriod.Companion, "/years")
    bad("{\"date\":{\"years\":0,\"months\":0,\"days\":0},\"time\":\"bad\"}", DateTimePeriod.Companion, "/time")
    val failure = ValueDecoderFunction<Int> { decoder -> throw IllegalStateException() }
    propagates { Json.decodeFromString("[1]", listDecoder(failure)) }
    propagates { Json.decodeFromString("{\"success\":1}", Result<Int, Int>.decoder(failure, Int.Companion)) }
    val key = ValueDecoderFunction<BadKey> { decoder -> Int.decode(decoder); BadKey() }
    propagates { Json.decodeFromString("[[1,2]]", HashMap<BadKey, Int>.decoder(key, Int.Companion)) }
    val brokenOrder = comparatorOf<Int> { a, b -> throw IllegalStateException() }
    propagates { Json.decodeFromString("[1,2]", TreeSet<Int>.decoder(Int.Companion, brokenOrder)) }
    val encoder = ValueEncoderFunction<Int> { value, target -> throw IllegalStateException() }
    propagates { Json.encodeToString(hashMapOf((1, 2)), HashMap<Int, Int>.encoder(Int.Companion, encoder)) }
    println("codecs errors passed")
}
