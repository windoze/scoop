import scoop.collections.*
import scoop.comparisons.*
import scoop.json.Json

struct Item(val number: Int)
fun check(ok: Boolean) { if (!ok) throw IllegalStateException() }
fun main() {
    val list = Json.decode("[3,1,2]", listDecoder(Int.Companion))
    check(!(list is MutableList<Int>) && Json.encode(list, listEncoder(Int.Companion)) == "[3,1,2]")
    check(Json.decode("[]", listDecoder(Int.Companion)).size == 0L)
    val again = Json.decode("[3,1,2]", listDecoder(Int.Companion))
    check(list !== again && again[0L] == 3)
    val hash = Json.decode("[3,1,2]", HashSet<Int>.decoder(Int.Companion))
    check(hash.size == 3L && hash.contains(1) && hash.contains(2) && hash.contains(3))
    val hashCopy = Json.decode(Json.encode(hash, HashSet<Int>.encoder(Int.Companion)), HashSet<Int>.decoder(Int.Companion))
    check(hashCopy.size == 3L && hashCopy.contains(2))
    val linked = Json.decode("[3,1,2]", LinkedHashSet<Int>.decoder(Int.Companion))
    check(Json.encode(linked, LinkedHashSet<Int>.encoder(Int.Companion)) == "[3,1,2]")
    val tree = Json.decode("[1,3,2]", TreeSet<Int>.decoder(Int.Companion, reverseOrder<Int>()))
    check(Json.encode(tree, TreeSet<Int>.encoder(Int.Companion)) == "[3,2,1]")
    val deque = Json.decode("[3,1,2]", ArrayDeque<Int>.decoder(Int.Companion))
    check(Json.encode(deque, ArrayDeque<Int>.encoder(Int.Companion)) == "[3,1,2]")
    check(deque.removeFirst() == 3 && deque.removeLast() == 2 && deque.firstOrNull() == Some(1))
    val itemDecoder = DecodeFunction<Item> { decoder -> Item(Int.decode(decoder)) }
    val itemEncoder = EncodeFunction<Item> { item, encoder -> Int.encode(item.number, encoder) }
    val order = comparatorOf<Item> { a, b -> a.number.compareTo(b.number) }
    val queueDecoder = PriorityQueue<Item>.decoder(itemDecoder, order)
    val queueEncoder = PriorityQueue<Item>.encoder(itemEncoder)
    val queue = Json.decode("[4,1,3,1,2]", queueDecoder)
    val copy = Json.decode(Json.encode(queue, queueEncoder), queueDecoder)
    check(copy.comparator === order && copy.size == 5L && queue.size == 5L)
    check(copy.removeFirst().number == 1 && copy.removeFirst().number == 1)
    check(copy.removeFirst().number == 2 && copy.removeFirst().number == 3 && copy.removeFirst().number == 4)
    check(Json.decode("[]", queueDecoder).size == 0L)
    val items = Json.decode("[9]", ArrayDeque<Item>.decoder(itemDecoder))
    check(Json.encode(items, ArrayDeque<Item>.encoder(itemEncoder)) == "[9]")
    println("codecs sequences passed")
}
