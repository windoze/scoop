import scoop.*
import scoop.json.Json
import scoop.collections.listDecoder

fun check(ok: Boolean) { if (!ok) throw IllegalStateException() }
fun <T> bad(text: String, codec: ValueDecoder<T>, path: String) {
    var failed = false
    try { Json.decodeFromString(text, codec) } catch (error: DecodingException) { check(error.path == path); failed = true }
    check(failed)
}
fun main() {
    val encoder = Result<Int, String>.encoder(Int.Companion, String.Companion)
    val decoder = Result<Int, String>.decoder(Int.Companion, String.Companion)
    check(Json.encodeToString(Result.Success<Int, String>(42), encoder) == "{\"success\":42}")
    check(Json.encodeToString(Result.Failure<Int, String>("oops"), encoder) == "{\"failure\":\"oops\"}")
    check(Json.decodeFromString("{\"success\":42}", decoder).getOrNone<Int, String>() == Some(42))
    check(Json.decodeFromString("{\"failure\":\"oops\"}", decoder).errorOrNone<Int, String>() == Some("oops"))
    val nestedEncoder = Result<Int?, Int>.encoder(Option<Int>.encoder(Int.Companion), Int.Companion)
    val nestedDecoder = Result<Int?, Int>.decoder(Option<Int>.decoder(Int.Companion), Int.Companion)
    val nested = Result.Success<Int?, Int>(None)
    val roundtrip = Json.decodeFromString(Json.encodeToString(nested, nestedEncoder), nestedDecoder)
    check(roundtrip.getOrNone<Int?, Int>() == Some(None))
    val rejectFailure = ValueDecoderFunction<String> { decoder -> throw IllegalStateException() }
    check(Json.decodeFromString("{\"success\":7}", Result<Int, String>.decoder(Int.Companion, rejectFailure)).getOrNone<Int, String>() == Some(7))
    val rejectEncode = ValueEncoderFunction<String> { value, encoder -> throw IllegalStateException() }
    check(Json.encodeToString(Result.Success<Int, String>(7), Result<Int, String>.encoder(Int.Companion, rejectEncode)) == "{\"success\":7}")
    bad("{}", decoder, ""); bad("{\"unknown\":1}", decoder, "")
    bad("{\"success\":1,\"failure\":\"x\"}", decoder, "")
    bad("{\"success\":1,\"other\":2}", decoder, "")
    bad("{\"success\":\"bad\"}", decoder, "/success")
    bad("[{\"unknown\":1}]", listDecoder(decoder), "/0")
    println("codecs result passed")
}
