class Configuration(val text: String)
context(configuration: Configuration)
fun active(): String = configuration.text

class Gate(var waiter: Continuation<Unit>?) {
    fun complete() { val current = waiter!!; waiter = None; current.resume(Unit) }
}
class Registration(val gate: Gate) : SuspendRegistration<Unit> {
    public override fun register(continuation: Continuation<Unit>) { gate.waiter = Some(continuation) }
}
suspend fun waitFor(gate: Gate) { suspendCoroutine(Registration(gate)) }

context(configuration: Configuration)
suspend fun after(gate: Gate, kept: String, count: Int): Boolean {
    println("condition-" + active())
    waitFor(gate)
    println(kept)
    return count < 2
}

class Task(val gate: Gate, val text: String) : SuspendTask<Int> {
    public override suspend fun run(): Int = context(Configuration("outer")) {
        var count = 0
        outer@ do {
            count += 1
            val kept = text
            context(Configuration("inner")) {
                try {
                    val item: Int? = if (count == 1) None else Some(count)
                    val chosen = item ?: continue@outer
                    println(chosen)
                } finally {
                    println("finally-" + active())
                    gcCollect()
                }
            }
        } while (after(gate, kept, count))
        count
    }
}
class Completion : Continuation<Int> {
    public override fun resume(value: Int) { println(value) }
    public override fun resumeWithException(exception: Throwable) { println("unexpected") }
}
fun main() {
    val gate = Gate(None)
    context(Configuration("caller")) {
        startCoroutine(Task(gate, "alive"), Completion())
        println(active())
        gcCollect(); gate.complete(); println(active())
        gcCollect(); gate.complete(); println(active())
    }
}
