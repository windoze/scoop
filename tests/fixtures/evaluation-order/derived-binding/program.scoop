interface Wide {
    public operator fun equals(other: Wide): Boolean
}

struct Key(val id: Int) : Wide {
    public override operator fun equals(other: Wide): Boolean = false
    public operator fun equals(other: Key): Boolean = true
}

struct Box<T>(val value: T)

fun <T : Wide> genericSame(a: Box<T>, b: Box<T>): Boolean = a == b
fun <T : Wide> namedSame(a: Box<T>, b: Box<T>): Boolean = a.equals(b)
fun <T : Wide> defaultSame(a: Box<T>, b: Box<T>, same: Boolean = a == b): Boolean = same

fun main() {
    val a = Box(Key(1))
    val b = Box(Key(1))
    println(a == b)
    println(genericSame(a, b))
    println(namedSame(a, b))
    println(defaultSame(a, b))
    println(a != b)
}
