// EXPECT: fail
// EXPECT-ERROR-CODE: scoop::llvm::unsupported_main_body
// EXPECT-ERROR: handle mixed-arm escape continuation (only same-body-stmt direct / indirect coexistence in while body supported)
// ARGS: --emit-llvm
//
// T2003c0b2c3d3 only supports a single direct + single indirect pair when both
// sites live in the same while-body statement. Separate body statements must
// keep producing a stable diagnostic until richer while mixed-site replay lands.

import scoop.core.*

effect Yield {
    fun next(): Int
}

effect Ask {
    fun ask(seed: Int): String
}

fun fetch(base: Int): String / (Ask) {
    val msg: String = Ask.ask(base + 1)
    msg
}

fun main() {
    val result: Int = handle {
        val x: Int = Yield.next()
        var i: Int = x
        while (i > 0) {
            val direct: String = Ask.ask(i)
            println(direct)
            val indirect: String = fetch(i + 10)
            println(indirect)
            i = i - 1
        }
        x + 1
    } with {
        Yield.next() -> resume {
            resume(1)
        }
        Ask.ask(seed), k -> {
            7
        }
    }
    println(result)
}
