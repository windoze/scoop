// EXPECT: fail
// EXPECT-ERROR-CODE: scoop::llvm::unsupported_main_body
// EXPECT-ERROR: handle mixed-arm escape continuation (multiple direct perform points not yet supported)
// ARGS: --emit-llvm

import scoop.core.*

effect Yield {
    fun next(): Int
}

effect Ask {
    fun ask(): String
}

fun main() {
    val result: Int = handle {
        val x: Int = Yield.next()
        val first: String = Ask.ask()
        println(first)
        val second: String = Ask.ask()
        println(second)
        x + 1
    } with {
        Yield.next() -> resume {
            resume(41)
        }
        Ask.ask(), k -> {
            val keep: Continuation<String> = k
            val _ = keep
            7
        }
    }
    println(result)
}
