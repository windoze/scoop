// EXPECT: fail
// EXPECT-ERROR-CODE: scoop::llvm::unsupported_main_body
// EXPECT-ERROR: handle mixed-arm escape continuation not yet supported
// ARGS: --emit-llvm

import scoop.core.*

effect Yield {
    fun next(): Int
}

effect Ask {
    fun current(): Int
}

fun main() {
    val result: Int = handle {
        val x: Int = Yield.next()
        x + 1
    } with {
        Yield.next() -> resume {
            resume(41)
        }
        Ask.current(), k -> {
            val keep: Continuation<Int> = k
            val _ = keep
            7
        }
    }
    println(result)
}
