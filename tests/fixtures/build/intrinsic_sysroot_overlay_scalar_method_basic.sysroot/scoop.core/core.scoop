package scoop.core

import scoop.unsafe.*

@Extern(name = "scoop_int_to_string", abi = "scoop")
fun __scoop_int_to_string(value: Int): String

@Extern(name = "scoop_string_unsafe_slice_bytes", abi = "scoop")
fun __scoop_string_unsafe_slice_bytes(value: String, byteOffset: Int, byteLength: Int): String

interface Any
sealed interface AnyRef
sealed interface AnyValue

interface Hashable {
    fun hash(): Int {
        return 0
    }
}

interface ToString {
    fun toString(): String {
        return ""
    }
}

@Intrinsic
struct Bool : Hashable, ToString {
    override fun toString(): String {
        if (this) {
            return "true"
        }
        return "false"
    }

    fun negate(): Bool {
        if (this) {
            return false
        }
        return true
    }
}

struct Char : Hashable, ToString
struct Float64 : Hashable, ToString
struct Float32 : Hashable, ToString
class String : Hashable, ToString {
    fun length(): Int { return __scoop_string_length(this) }
    fun toInt(): Int { return __scoop_string_to_int(this) }
    fun concat(other: String): String { return __scoop_string_concat(this, other) }
    fun hash(): Int { return __scoop_string_hash(this) }
    fun isEmpty(): Bool { return __scoop_string_is_empty(this) }
    fun replace(old: String, new: String): String { return __scoop_string_replace(this, old, new) }
    fun charAt(index: Int): Int { return __scoop_string_char_at(this, index) }
    fun repeat(n: Int): String { return __scoop_string_repeat(this, n) }
    fun compareTo(other: String): Int { return __scoop_string_compare_to(this, other) }
    fun trimIndent(): String { return __scoop_string_trim_indent(this) }

    @Unsafe
    fun unsafeSliceBytes(byteOffset: Int, byteLength: Int): String {
        return __scoop_string_unsafe_slice_bytes(this, byteOffset, byteLength)
    }
}
typealias Double = Float64

@Intrinsic
class Array<T> {
    @Intrinsic("array_size_inline")
    fun size(): Int

    @Intrinsic("array_get_inline")
    fun get(index: Int): T

    @Intrinsic("array_data_ptr_inline")
    fun __dataPtr(): UIntPtr
}

@Intrinsic
class MutableArray<T> {
    @Intrinsic("array_size_outofline")
    fun size(): Int

    @Intrinsic("array_get_outofline")
    fun get(index: Int): T

    @Intrinsic("array_set_outofline")
    fun set(index: Int, value: T): Unit

    @Intrinsic("array_data_ptr_outofline")
    fun __dataPtr(): UIntPtr
}

typealias List<T> = Array<T>
typealias MutableList<T> = MutableArray<T>

@Intrinsic
fun MutableArray<Int>.toArray(): Array<Int>

@Extern(name = "scoop_mutable_array_new", abi = "scoop")
fun __scoop_mutable_array_new(
    elemKind: Int,
    elemSize: Int,
    elemAlign: Int,
    elemDesc: UIntPtr,
    capacity: Int,
): MutableArray<Any>

@Extern(name = "scoop_mutable_array_push_word", abi = "scoop")
fun __scoop_mutable_array_push_word(arr: MutableArray<Any>, value: UIntPtr): Unit

@Extern(name = "scoop_mutable_array_push_ref", abi = "scoop")
fun __scoop_mutable_array_push_ref(arr: MutableArray<Any>, value: Any): Unit

@Extern(name = "scoop_mutable_array_push_composite", abi = "scoop")
fun __scoop_mutable_array_push_composite(arr: MutableArray<Any>, slot: UIntPtr, elemSize: Int): Unit

@Extern(name = "scoop_mutable_array_freeze", abi = "scoop")
fun __scoop_mutable_array_freeze(arr: MutableArray<Any>): Array<Any>

fun <T> mutableArrayNew(capacity: Int = ARRAY_ELEM_KIND_WORD - ARRAY_ELEM_KIND_WORD): MutableArray<T> {
    val raw: MutableArray<Any> = __scoop_mutable_array_new(
        kindOf<T>(),
        sizeOf<T>(),
        alignOf<T>(),
        descOf<T>(),
        capacity,
    )
    return @Unsafe do { __scoop_unsafe_mutable_array_cast<T>(raw) }
}

fun <T> MutableArray<T>.push(value: T): Unit {
    val kind: Int = kindOf<T>()
    val raw: MutableArray<Any> = @Unsafe do { __scoop_unsafe_mutable_array_erase<T>(this) }

    if (kind == ARRAY_ELEM_KIND_WORD) {
        val word: UIntPtr = @Unsafe do { __scoop_unsafe_value_to_word<T>(value) }
        __scoop_mutable_array_push_word(raw, word)
        return
    }

    if (kind == ARRAY_ELEM_KIND_REF) {
        val refValue: Any = @Unsafe do { __scoop_unsafe_value_to_any<T>(value) }
        __scoop_mutable_array_push_ref(raw, refValue)
        return
    }

    if (kind == ARRAY_ELEM_KIND_COMPOSITE) {
        val slot: UIntPtr = @Unsafe do { __scoop_unsafe_value_slot<T>(value) }
        __scoop_mutable_array_push_composite(raw, slot, sizeOf<T>())
        return
    }
}

fun <T> MutableArray<T>.freeze(): Array<T> {
    val raw: Array<Any> = __scoop_mutable_array_freeze(@Unsafe do { __scoop_unsafe_mutable_array_erase<T>(this) })
    return @Unsafe do { __scoop_unsafe_array_cast<T>(raw) }
}

class ComptimeList<T>
struct Unit
enum Nothing

enum AnnotationTarget {
    Function,
    Property,
    Field,
    Param,
    Type,
    Constructor,
    LocalVariable,
    Expression,
    Module,
    TypeParam,
    EnumVariant,
}

annotation class TailRec

@Target(AnnotationTarget.Function)
annotation class Inline

annotation class AllowIntrinsic
annotation class Deprecated(val message: String = "", val replaceWith: String = "")
annotation class Suppress(vararg val warnings: String)
annotation class Experimental(val feature: String)
annotation class CLayout(val aligned: Int = 0, val packed: Int = 0)
annotation class Target(val targets: AnnotationTarget)
annotation class Retention(val policy: String)
annotation class ThreadLocal
annotation class Global

