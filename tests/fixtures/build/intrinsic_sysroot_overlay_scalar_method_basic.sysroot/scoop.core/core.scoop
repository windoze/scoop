fun Char.toInt(): Int
@Intrinsic
fun Float64.toInt(): Int
@Intrinsic
fun Float64.hash(): Int
@Intrinsic
fun Float64.abs(): Float64
@Intrinsic
fun Float64.isNaN(): Bool
@Intrinsic
fun Float64.isInfinite(): Bool
@Intrinsic
fun Float32.toInt(): Int
@Intrinsic
fun Float32.hash(): Int
@Intrinsic
fun Float32.abs(): Float32
@Intrinsic
fun Float32.isNaN(): Bool
@Intrinsic
fun Float32.isInfinite(): Bool
@Intrinsic
fun Char.hash(): Int

@Extern(name = "scoop_print", abi = "scoop")
fun __scoop_print(value: String): Unit
@Extern(name = "scoop_println", abi = "scoop")
fun __scoop_println(value: String): Unit

@Intrinsic
object GC {
    @Intrinsic @Unsafe
    fun handleNew(obj: Any): GcHandle

    @Intrinsic @NoGC @Unsafe
    fun handleGet(h: GcHandle): Any

    @Intrinsic @NoGC @Unsafe
    fun handleDrop(h: GcHandle): Unit

    @Intrinsic @NoGC @Unsafe
    fun pin(obj: Any): Pinned

    @Intrinsic @NoGC @Unsafe
    fun unpin(pinned: Pinned): Unit
}

struct GcHandle(val raw: UIntPtr)
struct Pinned(val value: Any)

enum TypeKind {
    Struct,
    Enum,
    Class,
    Interface,
    Effect,
    Tuple,
    Primitive,
}

struct TypeMeta {
    val name: String
    val kind: TypeKind
    val annotations: ComptimeList<AnnotationMeta>
}

struct FieldMeta {
    val name: String
    val type: TypeMeta
    val index: Int
    val annotations: ComptimeList<AnnotationMeta>
}

struct VariantMeta {
    val name: String
    val fields: ComptimeList<FieldMeta>
    val index: Int
    val annotations: ComptimeList<AnnotationMeta>
}

struct ParamMeta {
    val name: String
    val type: TypeMeta
    val index: Int
    val annotations: ComptimeList<AnnotationMeta>
}

struct PropertyMeta {
    val name: String
    val type: TypeMeta
    val owner: TypeMeta
}

struct FunctionMeta {
    val name: String
}

struct AnnotationMeta {
    val name: String
    val args: ComptimeList<AnnotationArgMeta>
}

struct AnnotationArgMeta {
    val name: String
    val value: Any
}

@Intrinsic
struct Int : Hashable, ToString {
    override fun toString(): String {
        return __scoop_int_to_string(this)
    }

    @Intrinsic("int_hash")
    fun hash(): Int
}
struct UInt : Hashable
struct Int8 : Hashable
struct Int16 : Hashable
struct Int32 : Hashable
struct Int64 : Hashable
struct UInt8 : Hashable
struct UInt16 : Hashable
struct UInt32 : Hashable
struct UInt64 : Hashable

struct IntProgression(val first: Int, val last: Int, val step: Int, val increasing: Bool)

typealias Byte = UInt8
typealias Short = Int16
typealias UShort = UInt16
typealias Long = Int64
typealias ULong = UInt64
typealias UIntPtr = UInt

@Intrinsic
fun sizeOf(value: Int): Int
@Intrinsic
fun sizeOf(value: String): Int

@Intrinsic
const fun <T> nameOf(): String
@Intrinsic
const fun <T> sizeOf(): Int
@Intrinsic
const fun <T> alignOf(): Int
@Intrinsic
const fun <T> kindOf(): Int
@Intrinsic
const fun <T> descOf(): UIntPtr
@Intrinsic
const fun <T> fieldsOf(): ComptimeList<FieldMeta>
@Intrinsic
const fun <T> variantsOf(): ComptimeList<VariantMeta>
@Intrinsic
const fun <T> superTypesOf(): ComptimeList<TypeMeta>
@Intrinsic
const fun <T> annotationsOf(): ComptimeList<AnnotationMeta>
@Intrinsic
const fun paramsOf(fn: FunctionMeta): ComptimeList<ParamMeta>

const val ARRAY_ELEM_KIND_WORD: Int = 1
const val ARRAY_ELEM_KIND_REF: Int = 2
const val ARRAY_ELEM_KIND_COMPOSITE: Int = 3

struct Platform {
    val triple: String
    val arch: String
    val vendor: String
    val os: String
    val env: String
}

@Intrinsic
const fun getPlatform(): Platform

enum Option<T> {
    Some(val value: T),
    None
}

interface Continuation<Resume, Answer, eff E = Pure> {
    fun resume(value: Resume): Answer / (E + Raise<RuntimeError>)
}

enum RuntimeError {
    NullAssertionFailed,
    ClassCastFailed,
    ContinuationAlreadyResumed,
}

@Intrinsic
fun panic(message: String): Nothing

effect Raise<in E> {
    fun raise(error: E): Nothing
}
