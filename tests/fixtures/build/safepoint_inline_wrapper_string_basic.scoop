// EXPECT: pass

package fixtures.build

import scoop.core.*

fun <T> id(x: T): T {
    return x
}

fun <T> apply(f: (T) -> T / Pure!, x: T): T {
    return f(x)
}

fun caller(text: String): String {
    return apply<String>(id<String>, text)
}

fun main(): Int {
    val text: String = f"hello {7}"
    println(caller(text))
    return 0
}
