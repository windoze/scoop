// 目标：P6-T06 后，NoOutward callable carrier 必须保持普通 callable ABI。
// - `Derived()` 会触发 class vtable / interface itable 的物化；
// - `makeClosure(41)` 会触发 closure callable object 的物化；
// - 这些 target 都没有 outward case，因此不得再发布 dynamic entry / `Step_F` shell。
// ARGS: --emit-llvm --opt-level 0
// BUILD-LLVM-REGEX: @__scoop_priv0__class_vtable__h[0-9a-f]{32} = internal constant \[1 x ptr\] \[ptr @__scoop_abi0_fun__fixtures_build_Base_ping__h
// BUILD-LLVM-REGEX: @__scoop_priv0__itable_methods__h[0-9a-f]{32} = internal constant \[1 x ptr\]
// BUILD-LLVM-CONTAINS: [1 x ptr] [ptr @__scoop_abi0_fun__fixtures_build_Base_ping__h
// BUILD-LLVM-CONTAINS: store ptr @__scoop_priv0__closure_body__h
// BUILD-LLVM-NOT-CONTAINS: __scoop_lowered_vtable_dynamic_entry__fixtures_build_Base_ping
// BUILD-LLVM-NOT-CONTAINS: __scoop_lowered_itable_dynamic_entry__fixtures_build_Base_ping
// BUILD-LLVM-NOT-CONTAINS: __scoop_lowered_closure_dynamic_entry__fixtures_build_makeClosure__lambda0
// BUILD-LLVM-NOT-CONTAINS: %scoop.lowered.Step__
package fixtures.build

interface IFace {
    fun ping(value: Int): Int
}

open class Base() : IFace {
    open fun ping(value: Int): Int {
        return value + 1
    }
}

class Derived() : Base() {
    override fun ping(value: Int): Int {
        return value + 2
    }
}

fun makeClosure(seed: Int): (Int) -> Int {
    return { value: Int ->
        seed + value
    }
}

fun main() {
    val base: Base = Derived()
    val iface: IFace = base
    val closureValue: (Int) -> Int = makeClosure(41)
    val keepBase: Base = base
    val keepIface: IFace = iface
    val keepClosure: (Int) -> Int = closureValue
}
