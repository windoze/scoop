public val ARRAY_ELEM_KIND_WORD: Int = 1
public val ARRAY_ELEM_KIND_REF: Int = 2
public val ARRAY_ELEM_KIND_COMPOSITE: Int = 3

public struct Platform {
    val triple: String
    val arch: String
    val vendor: String
    val os: String
    val env: String
}

@Intrinsic
public fun getPlatform(): Platform

public enum Option<T> {
    Some(val value: T),
    None
}

public interface Continuation<Resume, Answer, eff E = Pure> {
    public fun resume(value: Resume): Answer / (E + Raise<RuntimeError>)
}

public enum RuntimeError {
    NullAssertionFailed,
    ClassCastFailed,
    ContinuationAlreadyResumed,
}

@Intrinsic
public fun panic(message: String): Nothing

public effect Raise<in E> {
    public fun raise(error: E): Nothing
}
