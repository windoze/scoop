@Intrinsic
public object GC {
    @Intrinsic @Unsafe
    public fun handleNew(obj: Any): GcHandle

    @Intrinsic @NoGC @Unsafe
    public fun handleGet(h: GcHandle): Any

    @Intrinsic @NoGC @Unsafe
    public fun handleDrop(h: GcHandle): Unit

    @Intrinsic @NoGC @Unsafe
    public fun pin(obj: Any): Pinned

    @Intrinsic @NoGC @Unsafe
    public fun unpin(pinned: Pinned): Unit
}

public struct GcHandle(val raw: UIntPtr)
public struct Pinned(val value: Any)

public enum TypeKind {
    Struct,
    Enum,
    Class,
    Interface,
    Effect,
    Tuple,
    Primitive,
}

public struct TypeMeta {
    val name: String
    val kind: TypeKind
    val annotations: MetaList<AnnotationMeta>
}

public struct FieldMeta {
    val name: String
    val type: TypeMeta
    val index: Int
    val annotations: MetaList<AnnotationMeta>
}

public struct VariantMeta {
    val name: String
    val fields: MetaList<FieldMeta>
    val index: Int
    val annotations: MetaList<AnnotationMeta>
}

public struct ParamMeta {
    val name: String
    val type: TypeMeta
    val index: Int
    val annotations: MetaList<AnnotationMeta>
}

public struct PropertyMeta {
    val name: String
    val type: TypeMeta
    val owner: TypeMeta
}

public struct FunctionMeta {
    val name: String
}

public struct AnnotationMeta {
    val name: String
    val args: MetaList<AnnotationArgMeta>
}

public struct AnnotationArgMeta {
    val name: String
    val value: Any
}

