// EXPECT: pass
// ARGS: --emit-llvm
// BUILD-LLVM-CONTAINS: define internal void @__scoop_release_
// BUILD-LLVM-CONTAINS: ptr %object
// BUILD-LLVM-CONTAINS: class_payload_gep
// BUILD-LLVM-CONTAINS: class_field_gep
// BUILD-LLVM-REGEX: (?s)release_hook_arg_raw.*release_hook_arg_tag
// BUILD-LLVM-CONTAINS: call void @scoop_test_release_ptr_uint(i64 %release_hook_arg_raw, i64 %release_hook_arg_tag)
// BUILD-LLVM-NOT-CONTAINS: @scoop_enter_native
// BUILD-LLVM-NOT-CONTAINS: @scoop_leave_native

package fixtures.build.releasehook

import scoop.core.*
import scoop.unsafe.*

@Extern("scoop_test_release_ptr_uint", abi = "c")
fun releaseNative(raw: Ptr<Int>, tag: UInt): Unit

@Experimental(feature = "releaseHook")
@ReleaseHook(name = "fixtures.build.releasehook.releaseNative", args = ["raw", "tag"])
class NativeResource(val raw: Ptr<Int>, val tag: UInt)

fun main() {}
