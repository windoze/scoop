// EXPECT: pass
// ARGS: --emit-llvm
//
// T1604 / T3006：统一 state-machine codegen 会为所有 handle 表达式生成
// handler push/pop + dispatch loop（包括 is_active 检查）。
// 将来会添加"pure body 不需要 handler machinery"的优化，届时可恢复
// BUILD-LLVM-NOT-CONTAINS 断言。
//
// 覆盖点：
// - `try/catch` 的 body 为纯计算（仅调用 pure helper），handler arms 虽在
//   codegen 中生成但运行期不可达——验证生成的 IR 可通过 LLVM 验证。

package fixtures.build

import scoop.core.*

fun helper(x: Int): Int {
    return x + 1
}

fun main() {
    val v: Int = try {
        helper(41)
    } catch (e: RuntimeError) {
        0
    }

    // 说明：println 属于 sysroot intrinsic 映射，单独保留（用于让 fixture 有可观测 side effect）。
    println(v)
}

