// EXPECT: pass
// ARGS: --emit-llvm
// BUILD-LLVM-NOT-CONTAINS: scoop_effect_is_active
// BUILD-LLVM-NOT-CONTAINS: scoop_effect_handler_stack_push
// BUILD-LLVM-NOT-CONTAINS: scoop_effect_handler_stack_pop
// BUILD-LLVM-NOT-CONTAINS: scoop_effect_perform_slot_read_len_words
//
// T1604：无 perform 的作用域不应引入 effect handler 符号。
//
// 覆盖点：
// - `try/catch` 的 body 为纯计算（仅调用 pure helper），因此 handler arms 不可达；
//   codegen 应直接生成 `body; return body_value`（并避免 push/pop handler frame、读取 perform slot 等）。
// - 对 pure helper 的调用点不应插入 `scoop_effect_is_active` 检查。

package fixtures.build

import scoop.core.*

fun helper(x: Int): Int {
    return x + 1
}

fun main() {
    val v: Int = try {
        helper(41)
    } catch (e: RuntimeError) {
        0
    }

    // 说明：println 属于 sysroot intrinsic 映射，单独保留（用于让 fixture 有可观测 side effect）。
    println(v)
}

