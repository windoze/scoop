// 目标：P6-T02 continuation object / resume interface 必须保留完整 method 集。
// - `continuationCarrier` 的 allowed row 是 `Ping`，因此 canonical resume interface 必须保留 `hit$ret` / `pong$ret`；
// - `P6-T01b` 之后，这里直接观察 request-source ABI visibility 发布的 continuation shell，不再依赖 reachable handle；
// - 对应的 resume vtable 仍必须同时发布 `hit$ret` / `pong$ret` 两个 method slot。
// ARGS: --emit-llvm --opt-level 0
// BUILD-LLVM-REGEX: @__scoop_priv0__lowered_resume_vtable_layout__h[0-9a-f]+ = internal constant %scoop\.lowered\.ResumeVtable__h[0-9a-f]+ zeroinitializer
// BUILD-LLVM-REGEX: %scoop\.lowered\.ResumeVtable__h[0-9a-f]+ = type \{ ptr, ptr \}
// BUILD-LLVM-REGEX: define internal %scoop\.lowered\.Step__h[0-9a-f]+ @__scoop_priv0__lowered_resume__h[0-9a-f]+\(ptr addrspace\(1\) %0\)
package fixtures.build

effect Ping {
    fun hit(): Unit
    fun pong(): Unit
}

fun continuationCarrier(): Unit / Ping {
    Ping.hit()
}

fun main() {}
