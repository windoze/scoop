// EXPECT-ERROR: handle multiple escape-continuation arms with sibling non-resuming and finally not yet supported

import scoop.core.*

effect Ask {
    fun ask(): String
}

effect Count {
    fun next(): Int
}

effect Abort {
    fun stop(text: String): Nothing
}

fun main() {
    val _: Int = handle {
        val a: String = Ask.ask()
        println(a)
        val b: Int = Count.next()
        println(b)
        Abort.stop(a)
        0
    } with {
        Ask.ask(), k -> {
            11
        }
        Count.next(), k -> {
            22
        }
        Abort.stop(text: String) -> {
            println(text)
            33
        }
    } finally {
        println("cleanup")
    }
}
