// 目标：P6-T02 `invoke(args_tuple) -> Step_F` / `resume()` 的 `Unit` ABI 必须零载荷退化。
// - `unitWorker()` 必须真实 outward `Ping.tick()`，避免 NoOutward/plain ABI 正确收口后退化为普通函数；
// - `unitWorker()` 没有 source 参数，因此 dynamic/direct invoke 必须是零参函数签名；
// - `Ping.tick(): Unit` 的 resume tuple 也是 `Unit`，因此 resume method 只保留 receiver；
// - outward step case payload 只应留下 continuation object 指针，而不是额外 `Unit` 载荷。
// ARGS: --emit-llvm --opt-level 0
// BUILD-LLVM-REGEX: define internal %scoop\.lowered\.Step__h[0-9a-f]+ @__scoop_priv0__lowered_dynamic_invoke__h[0-9a-f]+\(\)
// BUILD-LLVM-REGEX: define internal %scoop\.lowered\.Step__h[0-9a-f]+ @__scoop_priv0__lowered_direct_invoke__h[0-9a-f]+\(\)
// BUILD-LLVM-REGEX: define internal %scoop\.lowered\.Step__h[0-9a-f]+ @__scoop_priv0__lowered_resume__h[0-9a-f]+\(ptr addrspace\(1\) %0\)
// BUILD-LLVM-REGEX: %scoop\.lowered\.StepCase__h[0-9a-f]+ = type \{ ptr addrspace\(1\) \}
package fixtures.build

effect Ping {
    fun tick(): Unit
}

fun unitWorker(): Unit / Ping {
    Ping.tick()
}

fun main() {}
