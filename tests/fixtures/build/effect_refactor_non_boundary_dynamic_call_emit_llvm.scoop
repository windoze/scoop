// 目标：P6-T06 要求 NoOutward / plain callable 的 non-boundary virtual call 使用普通 vtable ABI。
// - `helper(base)` 内的 `base.ping()` 是 Virtual + CandidateSet，但没有 outward case；
// - refactor LLVM lowering 必须发出普通 vtable indirect call，不得包装成 `Step_F` dynamic invoke；
// - `main()` 调用 `helper(DerivedA())`，真实覆盖 plain virtual call 的 ordinary ABI 路径；
// - 该路径仍不得触发 legacy effect lowering。
// ARGS: --emit-llvm --opt-level 0
// BUILD-LLVM-CONTAINS: define i64 @fixtures.build.helper(
// BUILD-LLVM-CONTAINS: refactor_plain_dispatch_call = call i64 %load_vtable_fn
// BUILD-LLVM-CONTAINS: %pass_mir_call = call i64 @fixtures.build.helper(
// BUILD-LLVM-NOT-CONTAINS: __scoop_refactor_dynamic_invoke__fixtures_build_helper
// BUILD-LLVM-NOT-CONTAINS: %scoop.refactor.Step__
// BUILD-LLVM-NOT-CONTAINS: scoop.effect.frame.
package fixtures.build

open class Base() {
    open fun ping(): Int {
        return 1
    }
}

class DerivedA() : Base() {
    override fun ping(): Int {
        return 11
    }
}

class DerivedB() : Base() {
    override fun ping(): Int {
        return 22
    }
}

fun helper(base: Base): Int {
    val first: Int = base.ping()
    return first + 1
}

fun main() {
    val base: Base = DerivedA()
    val got: Int = helper(base)
}
