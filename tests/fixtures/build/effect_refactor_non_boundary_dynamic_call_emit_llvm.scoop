// 目标：P6-T02f 要求 source-slice 中的 non-boundary dynamic call 也发布 authoritative ABI query。
// - `helper(base)` 内的 `base.ping()` 是 Virtual + CandidateSet，但因为它是 pure call，不会进入 boundary_map；
// - refactor LLVM ABI materializer 仍必须为该 site 发布 canonical dynamic-invoke contract，供 P6-T03 whole-body lowering 直接消费；
// - `main()` 调用 `helper(DerivedA())`，让 P6-T03e 的 body lowering 真实发出 dynamic invoke；
// - 该路径仍不得触发 legacy effect lowering。
// ARGS: --emit-llvm --opt-level 0
// BUILD-LLVM-CONTAINS: __scoop_refactor_dynamic_invoke__fixtures_build_helper
// BUILD-LLVM-CONTAINS: refactor_dynamic_call_step = call %scoop.refactor.Step__
// BUILD-LLVM-NOT-CONTAINS: scoop.effect.frame.
package fixtures.build

open class Base() {
    open fun ping(): Int {
        return 1
    }
}

class DerivedA() : Base() {
    override fun ping(): Int {
        return 11
    }
}

class DerivedB() : Base() {
    override fun ping(): Int {
        return 22
    }
}

fun helper(base: Base): Int {
    val first: Int = base.ping()
    return first + 1
}

fun main() {
    val base: Base = DerivedA()
    val got: Int = helper(base)
}
