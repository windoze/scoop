// 目标：P6-T05 build matrix 覆盖 direct perform / handle / resume 的真实 refactor body lowering。
// ARGS: --emit-llvm --opt-level 0
// BUILD-LLVM-REGEX: define internal %scoop\.refactor\.Step__h[0-9a-f]+ @__scoop_priv0__refactor_resume__h[0-9a-f]+\(ptr addrspace\(1\) %0, i64 %1\)
// BUILD-LLVM-REGEX: @__scoop_priv0__refactor_surface_resume__h[0-9a-f]+
// BUILD-LLVM-CONTAINS: @scoop_alloc_typed
// BUILD-LLVM-NOT-CONTAINS: scoop_effect_handler_stack
// BUILD-LLVM-NOT-CONTAINS: scoop_effect_outcome

package fixtures.build

effect Ping {
    fun hit(): Int
}

fun main(): Int {
    val result: Int = handle {
        val value: Int = Ping.hit()
        value + 1
    } with {
        Ping.hit(), k -> {
            k.resume(41)
        }
    }
    return result
}
