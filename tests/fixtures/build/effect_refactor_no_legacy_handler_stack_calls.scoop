// 目标：P6-T04 要求 clean refactor LLVM path 的 frame / continuation / Step 运行时语义
// 只依赖 typed GC allocation、explicit roots 与普通 Step_F case，不再调用 legacy handler-stack/outcome runtime。
// ARGS: --emit-llvm --opt-level 0
// BUILD-LLVM-CONTAINS: @scoop_alloc_typed
// BUILD-LLVM-CONTAINS: @scoop_alloc_typed(ptr @__scoop_priv0__refactor_frame_layout__h
// BUILD-LLVM-CONTAINS: @scoop_alloc_typed(ptr @__scoop_priv0__refactor_continuation_layout__h
// BUILD-LLVM-CONTAINS: @scoop_gc_write_barrier
// BUILD-LLVM-NOT-CONTAINS: scoop_effect_handler_stack
// BUILD-LLVM-NOT-CONTAINS: scoop_effect_outcome
// BUILD-LLVM-NOT-CONTAINS: @malloc

package fixtures.build

import scoop.core.*

effect Ping {
    fun hit(): Int
}

fun main(): Int {
    var saved: String = "none"

    val result: Int = handle {
        Ping.hit()
    } with {
        Ping.hit(), k -> {
            saved = "ok".concat("!")
            0
        }
    }

    println(result)
    println(saved)
    return result
}
