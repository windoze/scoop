// EXPECT-ERROR: handle multiple escape-continuation arms (finally not yet supported)

import scoop.core.*

effect Ask {
    fun ask(): String
}

effect Count {
    fun next(): Int
}

fun main() {
    val _: Unit = handle {
        val a: String = Ask.ask()
        println(a)
        val b: Int = Count.next()
        println(b)
    } with {
        Ask.ask(), k -> {
            println("ask_arm")
        }
        Count.next(), k -> {
            println("count_arm")
        }
    } finally {
        println("cleanup")
    }
}
