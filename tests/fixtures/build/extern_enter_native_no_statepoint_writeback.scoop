// EXPECT: pass
// ARGS: --emit-llvm
// BUILD-LLVM-CONTAINS: call void @scoop_enter_native(
// BUILD-LLVM-CONTAINS: call void @scoop_test_gc_collect_in_native()
// BUILD-LLVM-CONTAINS: call void @scoop_leave_native()
// BUILD-LLVM-CONTAINS: load ptr addrspace(1), ptr %explicit_root_frame_slot_0, align 8
// BUILD-LLVM-NOT-CONTAINS: @llvm.experimental.gc.statepoint.p0(i64 2882400000, i32 0, ptr elementtype(void ()) @scoop_test_gc_collect_in_native
// BUILD-LLVM-NOT-CONTAINS: @llvm.experimental.gc.statepoint.p0(i64 2882400000, i32 0, ptr elementtype(void (ptr, i32)) @scoop_enter_native
// BUILD-LLVM-NOT-CONTAINS: @llvm.experimental.gc.statepoint.p0(i64 2882400000, i32 0, ptr elementtype(void ()) @scoop_leave_native

package fixtures.build

import scoop.core.*

@Extern("scoop_test_gc_collect_in_native")
fun gcCollectInNative(): Unit

fun main() {
    val x: Any = f"hello {7}"
    @Unsafe do { gcCollectInNative() }
    val h: GcHandle = @Unsafe do { GC.handleNew(x) }
    @Unsafe do { GC.handleDrop(h) }
}
