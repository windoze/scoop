// EXPECT: fail
// EXPECT-ERROR-CODE: scoop::llvm::unsupported_main_body
// EXPECT-ERROR: handle mixed-arm escape continuation (only top-level val-bound direct perform supported)
// ARGS: --emit-llvm

import scoop.core.*

effect Yield {
    fun next(): Int
}

effect Ask {
    fun ask(seed: Int): String
}

fun main() {
    val result: Int = handle {
        if (true) {
            val first: String = Ask.ask(0)
            println(first)
        } else {
            println("skip")
        }
        val x: Int = Yield.next()
        x + 1
    } with {
        Yield.next() -> resume {
            resume(41)
        }
        Ask.ask(seed), k -> {
            7
        }
    }
    println(result)
}
