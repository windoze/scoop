// EXPECT: fail
// EXPECT-ERROR-CODE: scoop::llvm::unsupported_main_body
// EXPECT-ERROR: handle multi-arm without immediate-resume (only same-body-stmt direct / indirect coexistence in while body supported)
// ARGS: --emit-llvm
//
// T2003c0c2b3d4 已放开 while body 里“同一个 statement”的 direct + indirect mixed；
// 这个负例继续锁定 separate-stmt while mixed 边界。

import scoop.core.*

effect Ask {
    fun ask(seed: Int): String
}

effect Abort {
    fun stop(text: String): Nothing
}

fun fetch(i: Int): String / (Ask) {
    val msg: String = Ask.ask(i + 10)
    msg
}

fun main() {
    val _: Unit = handle {
        var i: Int = 0
        while (i < 1) {
            val direct: String = Ask.ask(1)
            println(direct)
            val indirect: String = fetch(i)
            println(indirect)
            i = i + 1
            Abort.stop(indirect)
        }
    } with {
        Ask.ask(seed), k -> {
            println(seed)
        }
        Abort.stop(text: String) -> {
            println(text)
        }
    }
}
