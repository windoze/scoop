// EXPECT: fail
// EXPECT-ERROR-CODE: scoop::llvm::unsupported_main_body
// EXPECT-ERROR: handle multi-arm without immediate-resume (only top-level, statement-position nested block, or paired if-branch direct sites supported)
// ARGS: --emit-llvm
//
// T2003c0c2b3b2 先补 if-branch direct site；
// while body direct site 留给后续 `T2003c0c2b3b3`。

import scoop.core.*

effect Ask {
    fun ask(label: String): String
}

effect Abort {
    fun stop(text: String): Nothing
}

fun main() {
    val _: Unit = handle {
        while (true) {
            val first: String = Ask.ask("first")
            println(first)
            Abort.stop(first)
        }
    } with {
        Ask.ask(label: String), k -> {
            println(label)
        }
        Abort.stop(text: String) -> {
            println(text)
        }
    }
}
