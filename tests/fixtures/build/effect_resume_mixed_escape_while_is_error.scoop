// EXPECT: fail
// EXPECT-ERROR-CODE: scoop::llvm::unsupported_main_body
// EXPECT-ERROR: handle mixed-arm escape continuation (nested direct site in while body not yet supported)
// ARGS: --emit-llvm

import scoop.core.*

effect Yield {
    fun next(): Int
}

effect Ask {
    fun ask(seed: Int): String
}

fun main() {
    val result: Int = handle {
        var i: Int = 0
        while (i < 1) {
            if (i == 0) {
                val first: String = Ask.ask(i)
                println(first)
            }
            i = i + 1
        }
        val x: Int = Yield.next()
        x + 1
    } with {
        Yield.next() -> resume {
            resume(41)
        }
        Ask.ask(seed), k -> {
            7
        }
    }
    println(result)
}
