// ARGS: --emit-llvm
//
// Current `@Safe { ... }` is only a temporary naked-block workaround until
// T2004 lands; this fixture is locking the mixed-arm while-nested-shape
// diagnostic, not safe-region semantics.

import scoop.core.*

effect Yield {
    fun next(): Int
}

effect Ask {
    fun ask(seed: Int): String
}

fun main() {
    val result: Int = handle {
        var i: Int = 0
        while (i < 1) {
            @Safe {
                if (i == 0) {
                    val first: String = Ask.ask(i)
                    println(first)
                }
            }
            i = i + 1
        }
        val x: Int = Yield.next()
        x + 1
    } with {
        Yield.next() -> resume {
            resume(41)
        }
        Ask.ask(seed), k -> {
            7
        }
    }
    println(result)
}
