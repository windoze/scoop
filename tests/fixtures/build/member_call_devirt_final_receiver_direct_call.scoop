// EXPECT: pass
// ARGS: --emit-llvm --opt-level 0
// BUILD-LLVM-CONTAINS: call i64 @__scoop_abi0_fun__fixtures_build_Derived_ping__h
// BUILD-LLVM-NOT-CONTAINS: call_vtable
//
// T1603：去虚化：当 receiver 的静态类型为“无已知子类”的 class 时，虚调用应降级为 direct call。
// T5001f 后默认 explicit mode 不再经 statepoint 包装，因此这里直接断言 ordinary LLVM call。

package fixtures.build

import scoop.core.*

open class Base() {
    open fun ping(): Int {
        return 1
    }
}

class Derived() : Base() {
    override fun ping(): Int {
        return 2
    }
}

fun main(): Int {
    val d: Derived = Derived()
    val x: Int = d.ping()
    println(x)
    return 0
}
