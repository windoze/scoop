// EXPECT: fail
// EXPECT-ERROR-CODE: scoop::llvm::unsupported_main_body
// EXPECT-ERROR: handle mixed-arm escape continuation (deeper nested indirect site in while body not yet supported)
// ARGS: --emit-llvm

import scoop.core.*

effect Yield {
    fun next(): Int
}

effect Ask {
    fun ask(seed: Int): String
}

fun fetch(base: Int): String / (Ask) {
    val msg: String = Ask.ask(base + 1)
    msg
}

fun main() {
    val result: Int = handle {
        val x: Int = Yield.next()
        var outer: Int = x
        while (outer > 0) {
            var inner: Int = 1
            while (inner > 0) {
                val reply: String = fetch(outer + inner)
                println(reply)
                inner = inner - 1
            }
            outer = outer - 1
        }
        x + 1
    } with {
        Yield.next() -> resume {
            resume(41)
        }
        Ask.ask(seed), k -> {
            7
        }
    }
    println(result)
}
