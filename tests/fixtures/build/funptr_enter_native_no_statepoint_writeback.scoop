// EXPECT: pass
// ARGS: --emit-llvm
// BUILD-LLVM-CONTAINS: call i64 @scoop_test_get_gc_collect_in_native_funptr()
// BUILD-LLVM-CONTAINS: inttoptr i64
// BUILD-LLVM-CONTAINS: call void @scoop_enter_native(
// BUILD-LLVM-CONTAINS: call void @scoop_leave_native()
// BUILD-LLVM-CONTAINS: load ptr addrspace(1), ptr %explicit_root_frame_slot_0, align 8
// BUILD-LLVM-NOT-CONTAINS: @llvm.experimental.gc.statepoint.p0(i64 2882400000, i32 0, ptr elementtype(void ()) @scoop_enter_native
// BUILD-LLVM-NOT-CONTAINS: @llvm.experimental.gc.statepoint.p0(i64 2882400000, i32 0, ptr elementtype(void ()) @scoop_leave_native

package fixtures.build

import scoop.core.*
import scoop.unsafe.*

@Extern("scoop_test_get_gc_collect_in_native_funptr")
fun get_gc_collect_in_native_funptr(): FunPtr<() -> Unit>

fun main() {
    val x: Any = f"hello ${7}"
    @Unsafe do {
        val fp: FunPtr<() -> Unit> = get_gc_collect_in_native_funptr()
        fp()
    }
    val h: GcHandle = @Unsafe do { GC.handleNew(x) }
    @Unsafe do { GC.handleDrop(h) }
}
