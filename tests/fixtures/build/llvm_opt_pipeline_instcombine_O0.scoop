// EXPECT: pass
// ARGS: --emit-llvm -O0
// BUILD-LLVM-CONTAINS: 123456789
// BUILD-LLVM-NOT-CONTAINS: llvm.experimental.gc.statepoint
//
// 目标：T1602（O0 vs O2）回归证据
// - O0：不启用 LLVM 默认优化 pipeline，应保留可被 instcombine 简化的模式。
// - T5001f 后默认 explicit mode 不再走 statepoint rewrite，因此 IR 中也不应出现 gc.statepoint。

package fixtures.build

import scoop.core.*

fun roundtrip(x: Int): Int {
    val y: Int = x + 123456789
    return y - 123456789
}

fun main(): Int {
    val _: Any = 1
    return roundtrip(7)
}
