// 目标：P6-T05 build matrix 的 `CanonicalFull` 样本。
// `canonicalFullWorker` 可能 outward `Alpha + Beta`，O0 下必须保留 full Step case layout。
// ARGS: --emit-llvm --opt-level 0
// BUILD-LLVM-REGEX: @__scoop_priv0__lowered_step_case_tag_complete__h[0-9a-f]+ = internal constant i32 0
// BUILD-LLVM-REGEX: @__scoop_priv0__lowered_step_case_tag_case__h[0-9a-f]+ = internal constant i32 1
// BUILD-LLVM-REGEX: @__scoop_priv0__lowered_step_case_tag_case__h[0-9a-f]+ = internal constant i32 2

package fixtures.build

effect Alpha {
    fun go(): Unit
}

effect Beta {
    fun go(): Unit
}

fun canonicalFullWorker(useAlpha: Bool): Unit / (Alpha + Beta) {
    if (useAlpha) {
        Alpha.go()
    } else {
        Beta.go()
    }
}

fun main(): Int {
    return 0
}
