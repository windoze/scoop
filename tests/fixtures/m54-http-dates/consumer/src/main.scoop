import scoop.http.*
import scoop.platform.memory.NativeByteBuffer
import scoop.time.Instant
import scoop.time.Duration

fun main() {
    val wire = "HTTP/1.1 503 Service Unavailable\r\nDate: Sunday, 18-Oct-26 11:22:33 GMT\r\nRetry-After: Sun Oct 18 11:22:38 2026\r\nContent-Length: 0\r\n\r\n".toByteArray()
    val heads = ArrayList<HttpResponseHead>()
    Http1Decoder.client().use { decoder ->
        decoder.expectResponse("GET".toByteArray())
        NativeByteBuffer.allocate(1L).use { input ->
            for (byte in wire) {
                input.clear(); input.writeByte(byte)
                if (decoder.receive(input) != 1L) throw IllegalStateException()
                while (true) {
                    val next = decoder.nextEvent()
                    when (next) {
                        case None -> break
                        case Some(_) -> when (next!!) {
                            case Response(head) -> heads.add(head)
                            else -> {}
                        }
                    }
                }
            }
            decoder.endInput()
        }
        Unit
    }
    if (heads.size != 1L || heads[0L].status != 503U) throw IllegalStateException()
    val now = Instant.parse("2026-10-18T11:22:33Z")
    val fields = heads[0L].fields
    val date = HttpDate.parse(fields.findAll("date".toByteArray())[0L].value, now)
    val retry = HttpRetryAfter.parse(fields.findAll("retry-after".toByteArray())[0L].value, now)
    gcCollect()
    if (date != now || retry.delayFrom(now) != Duration.seconds(5L)) throw IllegalStateException()
    if (String.fromUtf8(retry.toHttpField().value) != "Sun, 18 Oct 2026 11:22:38 GMT") throw IllegalStateException()
    if (HttpRetryAfter.parse("9223372036854775807", now).delayFrom(now).floorSeconds != Long.MAX_VALUE) throw IllegalStateException()
    if (HttpDate.format(Instant.fromEpochSeconds(-1L, 999999999L)) != "Wed, 31 Dec 1969 23:59:59 GMT") throw IllegalStateException()
    println("HTTP dates and Retry-After")
}
