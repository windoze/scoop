import scoop.asyncio.*
import scoop.crypto.x509.TrustStore
import scoop.http.*
import scoop.http.asyncio.AsyncHttp1Connection
import scoop.http.client.*

internal fun bearerCache(trust: TrustStore) {
    withBearerRuntime suspend { _, scope, listener ->
        val url = bearerUrl(listener)
        val entered = BearerGate()
        val release = BearerGate()
        val loads = AtomicLong(0L)
        val provider = HttpAuthenticator.bearer(url.httpOrigin()) suspend { request ->
            val number = loads.fetchAdd(1L) + 1L
            if (number == 1L) {
                bearerCheck(bearerContext() == "first" && request.attempt == 0L && !bearerPresent(request.challenge))
                entered.signal(); release.await()
                bearerCheck(bearerContext() == "first")
            }
            HttpBearerTokens("token" + number.toString(), Some("refresh token stays local\u{0000}"))
        }
        val other = HttpAuthenticator.bearer(url.httpOrigin()) suspend { _ -> HttpBearerTokens("other") }
        val config = bearerConfig(trust, HttpAuthenticationOptions([provider]))
        val serving = scope.launch suspend {
            val expected = ["token1", "token1", "token1", "token2", "token3", "other", "token2"]
            for (token in expected) {
                AsyncHttp1Connection.takeOwnershipAsServer(listener.accept(), scope).useAsync suspend { connection ->
                    val request = connection.receiveRequest()!!
                    bearerCheck(bearerToken(request.head) == Some(token))
                    request.body.readAllBytes(0L)
                    bearerRespond(connection, 200U, "done")
                }
            }
        }
        try {
            withHttpClient(config) suspend { client ->
                val firstContext = BearerContext("first")
                val first = context(firstContext) {
                    scope.async<Unit> suspend {
                        client.withResponse(HttpRequest.get(url)) suspend { response ->
                            bearerCheck(response.body.text(4L) == "done" && bearerContext() == "first")
                        }
                    }
                }
                entered.await()
                val secondContext = BearerContext("second")
                val second = context(secondContext) {
                    scope.async<Unit> suspend {
                        client.withResponse(HttpRequest.get(url.resolve("/else"))) suspend { response ->
                            bearerCheck(response.body.text(4L) == "done" && bearerContext() == "second")
                        }
                    }
                }
                bearerCheck(loads.load() == 1L && !second.isCompleted)
                release.signal(); first.await(); second.await()
                bearerDone(client, HttpRequest.get(url.resolve("/cached")))
                bearerCheck(loads.load() == 1L)
                client.clearAuthenticationCache(provider)
                bearerDone(client, HttpRequest.get(url))
                bearerCheck(loads.load() == 2L)
                withHttpClient(config) suspend { separate -> bearerDone(separate, HttpRequest.get(url)) }
                bearerCheck(loads.load() == 3L)
                bearerDone(client, HttpRequest.get(url, options = HttpCallOptions(authentication = Some(HttpAuthenticationOptions([other])))))
                bearerDone(client, HttpRequest.get(url))
                bearerCheck(loads.load() == 3L)
            }
        } finally { release.signal() }
        serving.join()
    }
}
