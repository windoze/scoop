import scoop.asyncio.*
import scoop.crypto.x509.TrustStore
import scoop.http.asyncio.AsyncHttp1Connection
import scoop.http.client.*
import scoop.platform.system.PlatformErrorKind
import scoop.platform.system.PlatformException
import scoop.text.startsWith
import scoop.time.Duration

internal fun bearerCredentialFailures(trust: TrustStore, mode: String) {
    withBearerRuntime suspend { _, scope, listener ->
        val url = bearerUrl(listener)
        val refreshing = mode.startsWith("refresh-")
        val loads = AtomicLong(0L)
        val refreshes = AtomicLong(0L)
        val original = PlatformException("token callback", PlatformErrorKind.ConnectionReset)
        val provider = HttpAuthenticator.bearer(url.httpOrigin(), refreshTokens = suspend { request ->
            refreshes.fetchAdd(1L)
            bearerCheck(request.tokens.accessToken == "old" && request.tokens.refreshToken == Some("local"))
            if (mode == "refresh-callback") throw original
            if (mode == "refresh-nested") coroutineScope<Unit> suspend { scope ->
                scope.async<Unit> suspend { throw original }; Unit
            }
            when (mode) {
                case "refresh-none" -> None
                case "refresh-same" -> Some(HttpBearerTokens("old", Some("changed-refresh-only")))
                else -> Some(HttpBearerTokens("bad token"))
            }
        }) suspend { _ ->
            loads.fetchAdd(1L)
            if (mode == "load-callback") throw original
            if (mode == "load-nested") coroutineScope<Unit> suspend { scope ->
                scope.async<Unit> suspend { throw original }; Unit
            }
            HttpBearerTokens(when (mode) {
                case "empty" -> ""
                case "space" -> "bad token"
                case "unicode" -> "令牌"
                case "control" -> "bad\u{0000}token"
                case "padding" -> "a=b"
                else -> "old"
            }, Some("local"))
        }
        val serving = scope.launch suspend {
            if (refreshing) {
                AsyncHttp1Connection.takeOwnershipAsServer(listener.accept(), scope).useAsync suspend { connection ->
                    val request = connection.receiveRequest()!!
                    bearerCheck(bearerToken(request.head) == Some("old"))
                    request.body.readAllBytes(0L)
                    bearerRespond(connection, 401U, extra = [bearerField("WWW-Authenticate", "Bearer error=\"invalid_token\"")])
                }
            }
            AsyncHttp1Connection.takeOwnershipAsServer(listener.accept(), scope).useAsync suspend { connection ->
                val request = connection.receiveRequest()!!
                bearerCheck(bearerToken(request.head) == Some("manual"))
                request.body.readAllBytes(0L); bearerRespond(connection, 200U, "done")
            }
        }
        withHttpClient(bearerConfig(trust, HttpAuthenticationOptions([provider]), retries = HttpRetryOptions(
            maxRetries = 2L, initialDelay = Duration.ZERO, maxDelay = Duration.ZERO))) suspend { client ->
            val error = bearerFailure<Throwable> suspend { client.execute(HttpRequest.get(url)).close() }
            if (mode == "load-callback" || mode == "load-nested" || mode == "refresh-callback" || mode == "refresh-nested")
                bearerCheck(error === original)
            else {
                bearerCheck(error is HttpAuthenticationException)
                if (error is HttpAuthenticationException) {
                    val expected = if (mode == "refresh-none" || mode == "refresh-same") HttpAuthenticationFailure.Rejected
                        else HttpAuthenticationFailure.InvalidCredentials
                    bearerCheck(error.reason == expected)
                }
            }
            bearerDone(client, HttpRequest.get(url, fields = [bearerField("Authorization", "Bearer manual")]))
            bearerCheck(loads.load() == 1L && refreshes.load() == if (refreshing) 1L else 0L)
        }
        serving.join()
    }
}
