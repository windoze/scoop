import scoop.asyncio.*
import scoop.crypto.testdata.rootPem
import scoop.crypto.x509.TrustStore
import scoop.http.*
import scoop.http.asyncio.AsyncHttp1Connection
import scoop.http.client.*
import scoop.platform.io.UnexpectedEofException
import scoop.test.*

private fun cacheCallbackFailure(trust: TrustStore, stage: String) {
    withCacheRuntime suspend { _, scope, listener, url ->
        val expected = UnexpectedEofException()
        val storage = FailingCache(stage, expected)
        val serving = if (stage != "lookup") Some(scope.launch suspend {
            AsyncHttp1Connection.takeOwnershipAsServer(listener.accept(), scope).useAsync suspend { connection ->
                val request = connection.receiveRequest()!!
                request.body.close()
                connection.sendResponse(HttpResponseHead(HttpVersion.Http11, 200U,
                    fields = [cacheField("Cache-Control", "max-age=60")]), Http1BodyFraming.Length(4L)).useAsync suspend { writer ->
                    cacheWrite(writer, "body"); writer.finish()
                }
            }
        }) else None
        withHttpClient(cacheConfig(trust, storage, CacheClock(), retries = HttpRetryOptions(maxRetries = 1L))) suspend { client ->
            var failed = false
            try { client.withResponse(HttpRequest.get(url)) suspend { response -> response.body.bytes(16L) } }
            catch (error: Throwable) { assertSame(expected, error); failed = true }
            assertTrue(failed)
            assertEquals(0L, storage.storage.entryCount)
            assertEquals(1L, storage.lookups)
        }
        serving?.join()
    }
}

fun main(args: Array<String>) {
    assertEquals(4L, args.size)
    val stage = args[1L]
    val mode = args[2L]
    val cleanupError = when (args[3L]) {
        case "plain" -> false
        case "cleanup" -> true
        else -> throw IllegalArgumentException()
    }
    assertTrue(stage == "lookup" || stage == "begin" || stage == "write" || stage == "commit")
    TrustStore.fromPem(rootPem()).use { trust ->
        try {
            if (mode == "failure") {
                assertFalse(cleanupError)
                cacheCallbackFailure(trust, stage)
            } else {
                assertTrue(mode == "caller" || mode == "client" || mode == "total")
                cacheCancellation(trust, stage, mode, cleanupError)
            }
        } catch (error: AssertionFailure) {
            println(stage + " " + mode + ": " + error.kind + " " + (error.message ?: "failure") + " at " + error.location.line.toString())
            throw error
        }
    }
    println("cache lifetime case passed")
}
