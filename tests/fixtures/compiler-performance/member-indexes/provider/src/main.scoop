package performance.indexes

public interface Reader {
    public fun read(): Int
}

public class Meter public constructor(public var value: Int): Reader {
    public constructor(): this(40) {}
    public override fun read(): Int = value
    public fun adjust(amount: Int = 2): Int = value + amount
    public fun adjust(label: String): Int = value + 100
    public operator fun plus(other: Meter): Meter = Meter(value + other.value)
    public val doubled: Int get() = value * 2
    public fun <T> map(transform: (Int) -> T): T = transform(value)
}

public class Other public constructor(public var value: Int): Reader {
    public override fun read(): Int = value + 100
    public fun adjust(amount: Int = 500): Int = value + amount
    public operator fun plus(other: Other): Other = Other(value + other.value + 100)
    public val doubled: Int get() = value * 200
}

public fun offset(value: Int, amount: Int = 3): Int = value + amount
