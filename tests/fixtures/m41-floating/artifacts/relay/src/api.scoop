package relayed
import numeric.*
import numeric.ieee as providerIeee
public import numeric.bitValues
public import numeric.bitPatterns
public typealias Pair = numeric.Pair
public typealias Sample = numeric.Sample
public fun <T> compare(a: T, b: T): Boolean where T : Equals<T>, T : Compare<T> = consistent(a, b)
public fun ieee(a: Float, b: Float): IeeeComparison = providerIeee(a, b)
public fun constants(): Boolean = sameNaN && nanOrder == 1L
