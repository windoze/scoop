import scoop.http.*
import scoop.compression.*
import scoop.bytes.ByteArrayBuilder
import scoop.platform.memory.NativeByteBuffer

fun main() {
    val text = "HTTP 压缩表示的字节范围 preserves the encoded representation"
    val encoded = compress(text.toByteArray(), CompressionOptions.Gzip(GzipOptions()))
    val request = HttpRange.parse("BYTES=0-4,5-")
    val parts = HttpRange.parse(request.toHttpField().value).resolve(encoded.size)
    if (!parts.isSatisfiable || parts.ranges.size != 2L) throw IllegalStateException()
    val received = ByteArrayBuilder()
    for (range in parts.ranges) {
        val metadata = HttpContentRange(range, Some(encoded.size))
        val wire = ByteArrayBuilder()
        wire.append(("HTTP/1.1 206 Partial Content\r\nContent-Range: " + metadata.toString() +
            "\r\nContent-Encoding: gzip\r\nContent-Length: " + range.length.toString() + "\r\n\r\n").toByteArray())
        wire.append(Array<Byte>(range.length) { index -> encoded[range.first + index] })
        val (head, body) = readResponse(wire.toByteArray())
        val parsed = HttpContentRange.parse(head.fields.findAll("content-range".toByteArray())[0L].value)
        if (head.status != 206U || parsed.range!!.first != range.first || parsed.range!!.length != body.size ||
            parsed.completeLength!! != encoded.size) throw IllegalStateException()
        received.append(body)
    }
    gcCollect()
    val decoded = decompress(received.toByteArray(), DecompressionOptions(format = CompressionFormat.Gzip))
    if (String.fromUtf8(decoded) != text) throw IllegalStateException()
    val failed = HttpRange([HttpByteRange.From(encoded.size)]).resolve(encoded.size)
    if (failed.isSatisfiable || failed.ranges.size != 0L) throw IllegalStateException()
    val unsatisfied = HttpContentRange.unsatisfied(encoded.size)
    val (head, body) = readResponse(("HTTP/1.1 416 Range Not Satisfiable\r\nContent-Range: " + unsatisfied.toString() +
        "\r\nContent-Length: 0\r\n\r\n").toByteArray())
    val parsed = HttpContentRange.parse(head.fields.findAll("content-range".toByteArray())[0L].value)
    if (head.status != 416U || body.size != 0L || parsed.completeLength!! != encoded.size) throw IllegalStateException()
    if (!HttpRange.parse("bytes=-1").resolve(0L).isSatisfiable) throw IllegalStateException()
    println("HTTP byte ranges over encoded content")
}

fun readResponse(data: Array<Byte>): (HttpResponseHead, Array<Byte>) {
    val heads = ArrayList<HttpResponseHead>()
    val body = ByteArrayBuilder()
    Http1Decoder.client().use { decoder ->
        decoder.expectResponse("GET".toByteArray())
        NativeByteBuffer.allocate(3L).use { input ->
            var offset = 0L
            var ends = 0L
            while (offset < data.size) {
                input.clear()
                val count = if (data.size - offset < 3L) data.size - offset else 3L
                input.writeBytes(data, offset, count)
                if (decoder.receive(input) != count) throw IllegalStateException()
                offset += count
                while (true) {
                    val next = decoder.nextEvent()
                    when (next) {
                        case None -> break
                        case Some(_) -> when (next!!) {
                            case Response(head) -> heads.add(head)
                            case Data(bytes) -> body.append(bytes)
                            case End(_) -> ends += 1L
                            else -> {}
                        }
                    }
                }
                gcCollect()
            }
            decoder.endInput()
            if (ends != 1L) throw IllegalStateException()
            Unit
        }
        Unit
    }
    if (heads.size != 1L) throw IllegalStateException()
    return (heads[0L], body.toByteArray())
}
