internal class Cell<T>(private var stored: T) {
    internal var value: T
        get() = stored
        private set(next) { stored = next }
    private fun <U> echo(seed: U, result: U = seed): U = result
}
internal val <T> Cell<T>.item: T
    get() = value
internal interface View {
    public fun read(): Int = helper()
    private fun helper(value: Int = 1): Int = value
}
internal enum Choice {
    Empty,
    Present(val value: Int = 1)
}
internal object Cache {
    private const val fixed: Int = 2
    internal fun read(value: Int = 1): Int = value
}
