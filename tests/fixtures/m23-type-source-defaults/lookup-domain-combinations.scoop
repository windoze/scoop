internal open class GenericHost<T>(protected var seed: T) {
    protected fun choose(value: T = seed): T = value
    protected class Static {
        public fun exposed(): Int = 1
        protected fun both(): Int = 1
        internal class Again {
            internal fun duplicate(): Int = 1
        }
    }
    protected class Middle<U> {
        protected class Inner<V> {
            protected fun deep(value: Int = 1): Int = value
        }
    }
}
internal val <T> GenericHost<T>.marker: Int
    get() = 1
