private struct Packet(val value: Int)
private fun packet(source: Packet, value: Int = source.value): Int = value
internal class Cell(private var stored: Int) {
    private fun read(value: Int = this.stored): Int = value
}
internal object Cache {
    private var stored: Int = 3
    private fun read(value: Int = this.stored): Int = value
}
internal fun tuple(source: (Int, Int), value: Int = source._1): Int = value
