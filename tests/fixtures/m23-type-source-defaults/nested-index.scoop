public fun String.indexCopy(): String = this
public class NestedIndexHost {
    internal fun bound(seed: String, value: () -> String = (if (true) {
        val callback: () -> String = { seed }
        callback()
    } else { seed })::indexCopy): () -> String = value
    internal fun local(seed: String, value: () -> String = if (true) {
        fun copy(): String { return seed }
        val result = copy()
        val callback: () -> String = { result }
        callback
    } else {
        val fallback: () -> String = { seed }
        fallback
    }): () -> String = value
}
