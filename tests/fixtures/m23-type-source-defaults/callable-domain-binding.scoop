internal fun plain(): Int = 1
internal fun <T> keep(value: T): T = value
internal fun Int.extensionValue(): Int = this
public class Cell(private var backing: Int) {
    public var number: Int
        get() = backing
        set(next) { backing = next }
}
public struct Value()
public class Host {
    internal fun direct(value: Int = plain()): Int = value
    internal fun repeated(value: Int = plain() + plain()): Int = value
    internal fun <T> generic(source: T, value: T = keep<T>(source)): T = value
    public fun getter(source: Cell, value: Int = source.number): Int = value
    public fun setter(source: Cell, value: Int = if (true) {
        source.number = 3
        source.number
    } else { 4 }): Int = value
    public fun lambda(value: () -> Int = { 1 }): () -> Int = value
    public fun anonymous(value: () -> Int = fun(): Int { return 1 }): () -> Int = value
    internal fun reference(value: () -> Int = ::plain): () -> Int = value
    internal fun extension(source: Int, value: () -> Int = source::extensionValue): () -> Int = value
    public fun local(value: Int = if (true) {
        fun leaf(): Int { return 1 }
        leaf()
    } else { 2 }): Int = value
    public fun localReference(value: () -> Int = if (true) {
        fun leaf(): Int { return 1 }
        ::leaf
    } else { fun(): Int { return 2 } }): () -> Int = value
    public fun equality(left: Value, right: Value, value: Boolean = left == right): Boolean = value
    public fun unit(left: Unit, right: Unit, value: Boolean = left == right): Boolean = value
    public fun tuple(left: (Value, Unit), right: (Value, Unit), value: Boolean = left == right): Boolean = value
    public fun literal(value: Int = 0): Int = value
}
