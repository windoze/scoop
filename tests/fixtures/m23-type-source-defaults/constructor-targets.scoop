private struct Packet(val value: Int) {
    internal constructor() : this(1) {}
}
internal class Cell internal constructor(value: Int = 2) {
    protected constructor() : this(3) {}
    private fun nested(value: Cell = Cell()): Cell = value
}
internal class Hidden private constructor(value: Int) {
    private fun nested(value: Hidden = Hidden(4)): Hidden = value
}
internal enum Choice {
    Present(val value: Int)
}
private fun packet(value: Packet = Packet(1)): Packet = value
private fun packetSecondary(value: Packet = Packet()): Packet = value
internal fun cell(value: Cell = Cell(2)): Cell = value
internal fun choice(value: Choice = Choice.Present(3)): Choice = value
internal object Registry
private fun callback(): () -> Int = { 1 }
