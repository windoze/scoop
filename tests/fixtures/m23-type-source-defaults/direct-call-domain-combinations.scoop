public open class DirectDomainBase {
    protected open fun inherited(value: Int = 1): Int = value
}
public class DirectDomainChild : DirectDomainBase() {
    public final override fun inherited(value: Int): Int = value
}
public open class DirectGenericDomain<T> {
    protected fun own(value: Int = 1): Int = value
    protected class Static {
        public fun exposed(value: Int = 1): Int = value
        protected fun both(value: Int = 1): Int = value
    }
}
