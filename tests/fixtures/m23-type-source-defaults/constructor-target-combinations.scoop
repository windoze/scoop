internal open class Envelope<T> {
    protected struct Packet<U>(val value: U)
    protected class Cell<U> internal constructor(value: U)
    protected enum Choice<U> {
        Present(val value: U)
    }
    protected class Nested {}
    private fun <U> packet(seed: U, value: Packet<U> = Packet<U>(seed)): Packet<U> = value
    private fun <U> cell(seed: U, value: Cell<U> = Cell<U>(seed)): Cell<U> = value
    private fun <U> choice(seed: U, value: Choice<U> = Choice.Present(seed)): Choice<U> = value
    private fun nested(value: Nested = Nested()): Nested = value
}
