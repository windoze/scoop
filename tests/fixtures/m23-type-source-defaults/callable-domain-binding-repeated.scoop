public class Repeated {
    public fun <T> choose(value: T): T = value
    public fun <T> factory(source: T, value: () -> T = { source }): () -> T = value
    public fun <T> reference(value: (T) -> T = this::choose): (T) -> T = value
    public fun <T, U> pair(
        left: T,
        right: U,
        lambdas: (() -> T, () -> U) = (factory<T>(left), factory<U>(right)),
        references: ((T) -> T, (U) -> U) = (reference<T>(), reference<U>())
    ): Int = 1
}
