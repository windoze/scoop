private class Outer<T> {
    protected struct Entry<U>(val value: U)
    protected enum Choice<U> {
        Present(val value: U)
    }
    protected class Cell<U>(private var stored: U)
    internal object Cache {
        private var stored: Int = 3
    }
}
internal class Delegate {
    internal operator fun getValue(thisRef: DelegatedHost): Int = 1
}
internal class DelegatedHost {
    private val stored: Int by Delegate()
}
