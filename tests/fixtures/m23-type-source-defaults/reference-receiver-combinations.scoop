public struct ReceiverCombinationPair(val value: Int)
public class ReceiverCombinationHost(public var number: Int) {
    public fun read(): Int = number
    internal fun combined(other: ReceiverCombinationHost, pair: ReceiverCombinationPair,
        value: Int = if (true) {
            val copy = pair.value
            val thunk: () -> Int = { other.read() }
            fun nested(): Int { return copy }
            thunk()
            nested()
        } else { this.read() }): Int = value
    internal fun update(value: Int = if (true) {
        this.number = 5
        this.number
    } else { this.number }): Int = value
}
