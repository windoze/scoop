internal class Container(private var root: Int) {
    internal struct Alpha(val value: Int)
    internal struct Beta(val value: Int)
    internal struct Gamma(val value: Int)
    internal struct Delta(val value: Int)
    internal class Cell(private var stored: Int)
    internal enum Choice { Present(val value: Int) }
    internal object Cache { private val stored: Int = 1 }
    private fun alpha(value: Alpha = Alpha(1)): Alpha = value
    private fun cell(value: Cell = Cell(2)): Cell = value
    private fun choice(value: Choice = Choice.Present(3)): Choice = value
}
internal class GenericContainer<T>(private var root: T) {
    internal struct Alpha<U>(val value: U)
    internal struct Beta<U>(val value: U)
    internal struct Gamma<U>(val value: U)
    internal struct Delta<U>(val value: U)
    internal class Cell<U>(private var stored: U)
    internal enum Choice<U> { Present(val value: U) }
    private fun <U> alpha(seed: U, value: Alpha<U> = Alpha<U>(seed)): Alpha<U> = value
    private fun <U> cell(seed: U, value: Cell<U> = Cell<U>(seed)): Cell<U> = value
    private fun <U> choice(seed: U, value: Choice<U> = Choice.Present(seed)): Choice<U> = value
}
