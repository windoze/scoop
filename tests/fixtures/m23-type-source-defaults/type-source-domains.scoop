private struct Item()
private struct Box<T>(val value: T)
public struct Visible()
private fun visible(first: Visible, value: Visible = first): Visible = value
private fun nominal(first: Item, value: Item = first): Item = value
private fun applied(first: Box<Item>, value: Box<Item> = first): Box<Item> = value
private fun tuple(first: Item, value: (Item, Item) = (first, first)): (Item, Item) = value
private fun function(first: (Item) -> Item, value: (Item) -> Item = first): (Item) -> Item = value
private fun suspended(first: suspend (Item) -> Item, value: suspend (Item) -> Item = first): suspend (Item) -> Item = value
private fun <T> binder(first: T, value: T = first): T = value
private fun builtin(first: Any, value: Any = first): Any = value

internal class Enclosing<T> {
    protected struct Value<U>(val item: U)
    private fun <U> combined(first: (Value<T>, (U) -> T), value: (Value<T>, (U) -> T) = first): (Value<T>, (U) -> T) = value

    protected class Static {
        private struct Hidden()
        private fun copy(first: Hidden, value: (Hidden, Hidden) = (first, first)): (Hidden, Hidden) = value
    }
}

internal class Outer<A> {
    protected class Inner<B> {
        protected struct Both<C>(val item: C)
        private fun preserve(first: Both<B>, value: (Both<B>, Both<B>) = (first, first)): (Both<B>, Both<B>) = value
    }
}
