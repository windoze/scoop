public open class BindingBase<A, B> {
    protected open fun copy(first: A, second: B, value: (A, B) = when ((first, second)) { else -> {
        fun <C, D> keep(a: C, b: D): (A, B) { return (first, second) }
        keep<A, B>(first, second)
    } }): (A, B) = value
}
public class BindingChild<T>: BindingBase<T, T>() {
    protected final override fun copy(first: T, second: T, value: (T, T)): (T, T) = value
}
public class BindingOuter<A> {
    protected class Inner<B> {
        protected struct Value<C>(val item: C)
        private fun preserve(first: Value<B>, value: (Value<B>, Value<B>) = (first, first)): (Value<B>, Value<B>) = value
    }
    protected class Static {
        private struct Hidden()
        private fun copy(first: Hidden, value: Hidden = when (first) { else -> {
            fun keep(): Hidden { return first }
            keep()
        } }): Hidden = value
    }
}
