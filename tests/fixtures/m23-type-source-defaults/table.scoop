private fun topLevel(value: Int = 1): Int = value
public struct Value(val field: Int = 2)
public enum Choice { Empty, Item(val field: Int = 3) }
public open class TableBase protected constructor(seed: Int = 4) {
    protected open fun choose(seed: Int, value: Int = seed): Int = value
    private fun hidden(value: String = "hidden-default"): String = value
    internal fun <T> generic(seed: T, value: T = seed): T = value
    public fun zero(): Int = 0
    public fun required(value: Int): Int = value
    private class Nested {
        private fun nested(value: Int = 5): Int = value
    }
}
public class TableChild: TableBase(0) {
    protected final override fun choose(seed: Int, value: Int): Int = value
}
public open class Generic<T>(protected val seed: T) {
    protected fun choose(value: T = seed): T = value
}
