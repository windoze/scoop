import scoop.asyncio.*
import scoop.charset.*
import scoop.compression.*
import scoop.crypto.x509.TrustStore
import scoop.http.*
import scoop.http.client.*
import scoop.tls.TlsTrustSource
import scoop.url.Url

private fun responseField(name: String, value: String): HttpField = HttpField(name.toByteArray(), value.toByteArray())

private suspend fun readData(client: HttpClient, base: Url) {
    client.withResponse(HttpRequest.get(base.resolve("/gzip"))) suspend { response ->
        responseCheck(response.wireContentLength!! > 0L && response.body.contentLength == None)
        responseCheck(String.fromUtf8(response.fields.findAll("Content-Encoding".toByteArray())[0L].value) == "gzip")
        responseCheck(response.body.text(32L) == "来自 Python")
    }
    client.withResponse(HttpRequest.get(base.resolve("/stacked"))) suspend { response ->
        responseCheck(response.body.text(32L) == "多层内容")
        responseCheck(response.body.isComplete && response.trailers!!.size == 1L)
        responseCheck(String.fromUtf8(response.trailers!![0L].value) == "verified")
    }
    client.withResponse(HttpRequest.get(base.resolve("/latin"))) suspend { response ->
        responseCheck(response.body.text(4L) == "café")
    }
    client.withResponse(HttpRequest.get(base.resolve("/json"))) suspend { response ->
        val codec = ValueDecoderFunction<String> { decoder -> decoder.singleValue().readString() }
        responseCheck(response.body.json(codec, 11L) == "中文")
    }
    client.withResponse(HttpRequest.get(base.resolve("/override"))) suspend { response ->
        var rejected = false
        try { response.body.text(4L) } catch (_: HttpFieldParseException) { rejected = true }
        responseCheck(rejected && !response.body.isComplete)
        responseCheck(response.body.text(4L, Some(Charset.Iso8859_1)) == "café")
    }
}

private suspend fun readPolicy(client: HttpClient, base: Url) {
    val raw = HttpCallOptions(decoding = Some(HttpDecodingOptions(HttpContentDecoding.Raw)))
    client.withResponse(HttpRequest.get(base.resolve("/raw"),
        [responseField("Range", "bytes=0-2"), responseField("Accept-Encoding", "gzip")], raw)) suspend { response ->
        responseCheck(response.body.contentLength == Some(3L))
        responseCheck(String.fromUtf8(response.body.bytes(3L)) == "raw")
    }
    client.withResponse(HttpRequest.get(base.resolve("/range"), [responseField("Range", "bytes=0-2")])) suspend { response ->
        responseCheck(response.body.contentLength == Some(3L))
        responseCheck(response.body.text(3L) == "abc")
    }
    val metadata = [HttpRequest.head(base.resolve("/head")), HttpRequest.get(base.resolve("/not-modified"))]
    for (request in metadata) {
        client.withResponse(request) suspend { response ->
            responseCheck(response.wireContentLength == Some(123L) && response.body.contentLength == None)
            responseCheck(response.body.bytes(0L).size == 0L && response.body.isComplete)
        }
    }
    client.withResponse(HttpRequest.get(base.resolve("/limit"))) suspend { response ->
        var limited = false
        try { response.body.bytes(2L) } catch (error: ReadLimitException) { limited = error.maxBytes == 2L }
        responseCheck(limited && response.body.text(3L) == "def")
    }
    val response = client.execute(HttpRequest.get(base.resolve("/truncated")))
    var rejected = false
    try { response.body.bytes(20L) }
    catch (error: CompressionException) { rejected = error.kind == CompressionFailureKind.Truncated }
    responseCheck(rejected && !response.body.isComplete)
    response.close()
}

internal fun exerciseResponseHttp1(mode: String, url: Url, trust: TrustStore) {
    val loop: EventLoop = LibuvEventLoop()
    loop.run suspend { scope ->
        val config = HttpClientConfig(tls = HttpClientTlsConfig(TlsTrustSource.Store(trust)), decoding = HttpDecodingOptions(bufferSize = 3L))
        withHttpClient(config) suspend { client ->
            if (mode == "data") readData(client, url) else readPolicy(client, url)
        }
        responseCheck(!scope.job.isCancelled)
    }
}
