import scoop.http.PublicSuffixList
import scoop.http.client.*
import scoop.test.*
import scoop.url.Url

internal suspend fun cookieSameSite(suffixes: PublicSuffixList) {
    val jar = MemoryCookieJar(suffixes = suffixes, enforceSameSite = true)
    val same = Some(HttpCookieContext(Some(Url.parse("https://site.example.com/"))))
    val cross = Some(HttpCookieContext(Some(Url.parse("https://other.test/"))))
    val navigation = Some(HttpCookieContext(Some(Url.parse("https://other.test/")), true))
    val unknownNavigation = Some(HttpCookieContext(isTopLevelNavigation = true))
    cookieSave(jar, ["strict=s; SameSite=Strict; Domain=example.com; Path=/", "lax=l; SameSite=Lax; Domain=example.com; Path=/",
        "default=d; Domain=example.com; Path=/", "none=n; SameSite=None; Secure; Domain=example.com; Path=/"], context = same)
    assertEquals("strict=s; lax=l; default=d; none=n", cookieLoad(jar, context = same))
    assertEquals("strict=s; lax=l; default=d; none=n", cookieLoad(jar, "https://sub.example.com:8080/", same))
    assertEquals("none=n", cookieLoad(jar, context = cross))
    assertEquals("none=n", cookieLoad(jar))
    assertEquals("lax=l; default=d; none=n", cookieLoad(jar, context = navigation))
    assertEquals("lax=l; default=d; none=n", cookieLoad(jar, context = unknownNavigation))
    assertEquals("none=n", cookieLoad(jar, context = navigation, method = "POST"))
    assertEquals("none=n", cookieLoad(jar, context = navigation, method = "get"))
    for (method in ["HEAD", "OPTIONS", "TRACE"])
        assertEquals("lax=l; default=d; none=n", cookieLoad(jar, context = navigation, method = method))
    assertEquals("", cookieLoad(jar, "http://example.com/", same))
    val settings = MemoryCookieJar(suffixes = suffixes, enforceSameSite = true)
    cookieSave(settings, ["strict=s; SameSite=Strict", "lax=l; SameSite=Lax", "default=d", "none=n; SameSite=None; Secure"], context = cross)
    assertEquals("none=n", cookieLoad(settings, context = same))
    cookieSave(settings, ["strict=s; SameSite=Strict", "lax=l; SameSite=Lax", "default=d"], context = navigation)
    assertEquals("none=n; strict=s; lax=l; default=d", cookieLoad(settings, context = same))
    val unrestricted = MemoryCookieJar(suffixes = suffixes)
    cookieSave(unrestricted, ["strict=s; SameSite=Strict"])
    assertEquals("strict=s", cookieLoad(unrestricted, context = cross))
    val privateSite = MemoryCookieJar(suffixes = suffixes, enforceSameSite = true)
    val own = Some(HttpCookieContext(Some(Url.parse("https://one.github.io/"))))
    cookieSave(privateSite, ["sid=s; SameSite=Strict"], "https://one.github.io/", own)
    assertEquals("sid=s", cookieLoad(privateSite, "https://one.github.io/", own))
    assertEquals("", cookieLoad(privateSite, "https://one.github.io/", Some(HttpCookieContext(Some(Url.parse("https://two.github.io/"))))))
}
