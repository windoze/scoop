import scoop.bytes.ByteArrayBuilder
import scoop.http.*
import scoop.platform.concurrent.Thread
import scoop.platform.memory.NativeByteBuffer
import scoop.text.hexToByteArray

private fun check(value: Boolean) {
    if (!value) throw IllegalStateException(Some("HTTP2 input progress check failed"))
}

private fun exercise(bytes: Array<Byte>, capacity: Long): String = Http2Session.server(
    limits = Http2Limits(headers = HttpHeaderLimits(maxFieldBytes = 65536L))).use { session ->
    val trace = StringBuilder().append("begin\n")
    NativeByteBuffer.allocate(capacity).use { buffer ->
        var offset = 0L
        while (offset < bytes.size) {
            buffer.clear()
            val count = if (bytes.size - offset < capacity) bytes.size - offset else capacity
            buffer.writeBytes(bytes, offset, count)
            val step = session.receiveWithProgress(buffer)
            check(step.count == count && buffer.readableBytes == 0L)
            trace.append(offset.toString()).append(":").append(step.count.toString()).append(":")
            for (part in step.progress) {
                check(part.streamId > 0 && part.count > 0L)
                trace.append(part.streamId.toString()).append(",").append(part.count.toString()).append(";")
            }
            trace.append("\n")
            offset += step.count
        }
        check(session.receiveWithProgress(buffer, 0L).progress.size == 0L)
    }
    val first = ByteArrayBuilder()
    val second = ByteArrayBuilder()
    var heads = 0
    var ends = 0
    var reset = false
    while (true) {
        val event = session.nextEvent()
        when (event) {
            case None -> break
            case Some(_) -> when (event!!) {
                case Request(id, _) -> { check(id == 1 || id == 3); heads += 1 }
                case Data(id, data) -> {
                    check(id == 1 || id == 3)
                    if (id == 1) first.append(data)
                    if (id == 3) second.append(data)
                }
                case End(_) -> ends += 1
                case StreamClosed(id, code) -> { check(id == 3 && code == 8U); reset = true }
                case Failure(error) -> throw error
                else -> {}
            }
        }
    }
    check(heads == 2 && ends == 2 && reset)
    check(String.fromUtf8(first.toByteArray()) == "alpha")
    check(String.fromUtf8(second.toByteArray()) == "omega")
    trace.append("end").toString()
}

private class TraceResult { var value: String? = None }

fun main(args: Array<String>) {
    check(args.size == 3L)
    val bytes = args[1L].hexToByteArray()
    val capacity = when (args[2L]) {
        case "tiny" -> 1L
        case "short" -> 7L
        case "large" -> 4093L
        else -> throw IllegalArgumentException(Some("unknown input chunk mode"))
    }
    val result = TraceResult()
    Thread.start { result.value = Some(exercise(bytes, capacity)) }.use { thread ->
        val first = exercise(bytes, capacity)
        thread.join()
        println(first)
        println(result.value!!)
    }
}
