import scoop.compression.CompressionException
import scoop.http.*
import scoop.http.client.*
import scoop.test.*
import scoop.text.endsWith

internal fun sseInitialFailure(mode: String): Boolean = when (mode) {
    "missing", "media", "duplicate", "bad-media", "status", "other-success", "bad-chunk" -> true
    else -> false
}

internal suspend fun checkSseInitialFailure(client: HttpClient, request: HttpRequest, options: HttpSseOptions, mode: String) {
    val failure = sseFailure suspend {
        client.withSse(request, options) suspend { source -> if (mode == "bad-chunk") source.next(); Unit }
    }
    when (mode) {
        "status" -> { assertTrue(failure is HttpStatusException); assertEquals(404U, (failure as HttpStatusException).head.status) }
        "other-success" -> {
            assertTrue(failure is HttpSseException)
            assertEquals(HttpSseFailureReason.UnexpectedStatus, (failure as HttpSseException).reason)
        }
        "missing", "media" -> {
            assertTrue(failure is HttpSseException)
            assertEquals(HttpSseFailureReason.UnsupportedContentType, (failure as HttpSseException).reason)
        }
        "bad-chunk" -> { assertTrue(failure is HttpException); assertFalse((failure as HttpException).isUnexpectedEof) }
        else -> assertTrue(failure is HttpFieldParseException)
    }
}

internal suspend fun consumeSseNetwork(source: HttpEventSource, probe: SseNetworkProbe, mode: String) {
    if (mode == "stop") {
        assertEquals(204U, source.head.status)
        assertTrue(source.isFinished && source.isClosed)
        assertFalse(ssePresent(source.next()))
        assertEquals(0L, probe.calls)
        return
    }
    if (mode == "line-limit" || mode == "bad-gzip") {
        val failure = sseFailure suspend { source.next(); Unit }
        when (mode) {
            "line-limit" -> assertTrue(failure is SseLimitException)
            else -> assertTrue(failure is CompressionException)
        }
        assertSame(failure, source.failure!!)
        assertSame(failure, sseFailure suspend { source.next(); Unit })
        assertTrue(source.isClosed)
        assertEquals(0L, probe.calls)
        return
    }
    val first = source.next()!!
    if (mode == "plain" || mode == "gzip") {
        assertEquals("price", first.event)
        assertEquals("hello\n雪", first.data)
        assertEquals("first", first.lastEventId)
        val second = source.next()!!
        assertEquals("message", second.event)
        assertEquals("bad:�", second.data)
        assertFalse(ssePresent(source.next()))
        assertEquals("tail", source.lastEventId)
    } else {
        assertEquals("one", first.data)
        if (mode == "redirect") assertTrue(source.url.toString().endsWith("/events"))
        if (mode == "callback-error" || mode == "informational-error") {
            val failure = sseFailure suspend { source.next(); Unit }
            assertSame(probe.error, failure)
            assertSame(failure, source.failure!!)
            assertTrue(source.isClosed)
            assertEquals(1L, probe.calls)
            return
        }
        if (mode == "reconnect" || mode == "post-reconnect" || mode == "cookie" || mode == "limit")
            assertEquals("two", source.next()!!.data)
        assertFalse(ssePresent(source.next()))
    }
    assertTrue(source.isClosed && source.isFinished)
    assertFalse(ssePresent(source.failure) || ssePresent(source.next()))
    assertEquals(when (mode) {
        "reconnect", "post-reconnect", "cookie" -> 2L
        "truncated", "limit", "callback-close", "redirect" -> 1L
        else -> 0L
    }, probe.calls)
}
