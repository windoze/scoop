interface Marker {}

fun <T : Marker> trace(value: T): T = value
fun trace(left: Int, right: Int): Int = left

fun select(operation: (Int) -> Int): Int = operation(1)
fun select(operation: (String) -> String): String = operation("value")

fun merge(a: Int, b: Any): Int = a
fun merge(a: Any, b: Int): Int = b

fun main() {
    trace(1)
    select({ false })
    merge(1, 1)
}
