import scoop.asyncio.*
import scoop.collections.emptyList
import scoop.crypto.x509.TrustStore
import scoop.http.*
import scoop.http.client.*
import scoop.test.*
import scoop.tls.TlsTrustSource
import scoop.url.Url

internal fun observedProxyTls(trust: TrustStore, port: Int, mode: String) {
    val log = ObservationLog()
    val socks = mode == "socks-wss"
    val endpoint = Url.parse((if (socks) "socks5" else if (mode == "secure-connect") "https" else "http") +
        "://127.0.0.1:" + port.toString())
    val url = Url.parse("wss://localhost:9443/resource?q=%2f")
    val provider = HttpAuthenticator.basic(endpoint.toBuilder().setScheme(Some("http")).build().httpOrigin()) suspend { _ ->
        HttpPasswordCredentials("proxy", "secret")
    }
    LibuvEventLoop().run suspend { _ ->
        val tls = HttpClientTlsConfig(TlsTrustSource.Store(trust))
        val proxy: HttpProxy = if (socks) HttpProxy.Socks5(HttpSocks5Endpoint(endpoint)) else HttpProxy.Http(HttpProxyEndpoint(endpoint, tls,
            authorization = if (mode == "connect-auth") None else Some(HttpCredentials.withToken68("Basic", "cHJveHk6c2VjcmV0")),
            authentication = HttpAuthenticationOptions(if (mode == "connect-auth") [provider] else emptyList<HttpAuthenticator>())))
        val config = HttpClientConfig(tls = tls, observer = Some(log.observer()), proxy = HttpProxySelector.fixed(proxy))
        withHttpClient(config) suspend { client ->
            client.withWebSocket(HttpWebSocketRequest(url, [observationField("Authorization", "Bearer origin"),
                observationField("Cookie", "origin=cookie")])) suspend { result ->
                when (result) {
                    case Opened(session) -> {
                        assertTrue(observationPresent(session.metrics!!.finishedAt))
                        assertEquals("tunneled", session.receive()!!.readText())
                        session.sendText("through proxy")
                        assertEquals("echo:through proxy", session.receive()!!.readText())
                        session.shutdownGracefully()
                    }
                    case Rejected(_, error) -> throw error
                }
            }
        }
    }
    val completed = log.ofKind(HttpCallEventKind.Completed)
    val authenticated = mode == "connect-auth"
    assertEquals(if (authenticated) 2L else 1L, completed.size)
    if (authenticated) {
        val first = completed[0L].metrics
        assertFalse(observationPresent(first.originTls) || observationPresent(first.version) || observationPresent(first.status))
        assertTrue(observationPresent(first.proxyHandshake))
        assertFalse(observationPresent(completed[0L].failure))
        assertSame(completed[0L].call, completed[1L].call)
        assertEquals(HttpAttemptReason.ProxyAuthentication, completed[1L].metrics.reason)
    }
    val metrics = completed[completed.size - 1L].metrics
    checkObservationPhases(metrics)
    assertFalse(observationPresent(metrics.resolve))
    assertTrue(observationPresent(metrics.connect) && observationPresent(metrics.proxyHandshake) && observationPresent(metrics.originTls))
    assertEquals(mode == "secure-connect", observationPresent(metrics.proxyTls))
    assertTrue(metrics.connect!!.finishedAt!! <= metrics.proxyHandshake!!.startedAt)
    assertTrue(metrics.proxyHandshake!!.finishedAt!! <= metrics.originTls!!.startedAt)
    if (mode == "secure-connect") {
        assertTrue(metrics.connect!!.finishedAt!! <= metrics.proxyTls!!.startedAt)
        assertTrue(metrics.proxyTls!!.finishedAt!! <= metrics.proxyHandshake!!.startedAt)
    }
    assertEquals(Some(HttpVersion.Http11), metrics.version)
    assertEquals(Some(101U), metrics.status)
    assertEquals(0L, metrics.requestBodyBytes); assertEquals(0L, metrics.responseBodyBytes)
}
