import scoop.core.*
import scoop.runtime.test.*

// 说明：用于在优化 pass（例如 SROA）存在时，仍然让某个 ref 在 safepoint 之后保持“可观测的 use”，
// 避免被当作 dead value 提前裁剪导致 GC roots 不完整。
fun blackBoxAny(value: Any): Unit {}

fun main(): Unit {
    // 1) 创建一个 heap 对象（Int -> Any boxing 会调用 `scoop_alloc`）。
    // 2) 在 unsafe context 内 pin，并返回 `Pinned` 值类型 handle。
    // 3) 让 keep 离开作用域：此时对象是否保活完全取决于 runtime pin（而不是栈 roots）。
    val pinned: Pinned = @Unsafe do {
        val keep: Any = 1
        val pinned_inner: Pinned = GC.pin(keep)
        pinned_inner
    }

    // keep 已离开作用域：对象仍应存在（pinned roots）。
    println(@Unsafe do { __scoop_gc_debug_heap_object_count() })
    __scoop_gc_collect()
    println(@Unsafe do { __scoop_gc_debug_heap_object_count() })

    // unpin 前先把引用放入一个 ref local（stackmap roots），保证 unpin 后仍可访问。
    val keep_again: Any = pinned.value

    @Unsafe do { GC.unpin(pinned) }
    __scoop_gc_collect()
    println(@Unsafe do { __scoop_gc_debug_heap_object_count() })

    // 让 keep_again 在 safepoint（collect）之后仍然有 use，确保它在 GC 时是 live root。
    blackBoxAny(keep_again)
}
