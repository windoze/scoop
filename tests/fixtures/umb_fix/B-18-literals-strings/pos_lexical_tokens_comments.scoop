package fixtures.parse

val plain: Char = 'A'
val newline: Char = '\n'
val quote: Char = '\''
val unicode: Char = '\u0041'

fun classify(c: Char) {
    when (c) {
        'a' -> 1
        '\n' -> 2
        else -> 3
    }
}
