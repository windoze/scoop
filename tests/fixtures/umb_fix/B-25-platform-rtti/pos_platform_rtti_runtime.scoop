// EXPECT: ok
// SPEC: docs/spec/language_spec-part5.md#10-runtime-type-info;docs/spec/language_spec-part5.md#11-class-literal;docs/spec/language_spec-part5.md#9-platform-introspection
// COVERS: NONE
// BUCKETS: B-25
// REASON: P7-C2 retired B-25 rows; active smoke covers getPlatform, runtime type tests, as?, and is-pattern lowering.
// SOURCE-FIXTURE: tests/fixtures/run-pass/get_platform_runtime_basic.scoop;tests/fixtures/umb_fix/B-14-cast-typecheck/pos_cast_typecheck_runtime.scoop

import scoop.core.*

interface Marker {
    fun tag(): Int
}

open class Base()

class Impl() : Base(), Marker {
    fun tag(): Int {
        return 42
    }
}

class Other()

fun main(): Int {
    val p: Platform = getPlatform()
    println(p.triple != "")
    println(p.arch != "")
    println(p.vendor != "")
    println(p.os != "")
    println(p.env == p.env)

    val x: Any = Impl()
    println(x is Marker)
    println(x !is Other)

    val maybe: Marker? = x as? Marker
    when (maybe) {
        Some(m) -> println(m.tag())
        None -> println(0)
    }

    val patternResult: Int = when (x) {
        is Marker -> 1
        else -> 0
    }
    println(patternResult)
    return 0
}
