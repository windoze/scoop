import scoop.core.*

fun main(): Int {
    val s: String = "abc"
    val len: Int = s.byteLength()
    val byte: Int = s.getByte(1)
    val c: Char = 'C'
    val ch: Int = c.hash()
    val i: Int = 42
    val ih: Int = i.hash()
    val f: Float64 = 7.0
    val ti: Int = f.toInt()
    if (len != 3) { return 1 }
    if (byte != 98) { return 2 }
    if (ch != c.toInt().hash()) { return 3 }
    if (ih != 42.hash()) { return 4 }
    if (ti != 7) { return 5 }
    return 0
}
