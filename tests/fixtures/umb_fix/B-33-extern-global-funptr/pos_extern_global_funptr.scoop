package fixtures.codegen

import scoop.core.*

@Extern(name = "scoop_test_extern_global_counter")
var NativeCounter: Int

fun main(): Int {
    @Unsafe do { NativeCounter = 40 }
    val readBack: Int = @Unsafe do { NativeCounter }
    @Unsafe do { NativeCounter = readBack + 2 }
    val finalValue: Int = @Unsafe do { NativeCounter }
    return finalValue - 42
}
