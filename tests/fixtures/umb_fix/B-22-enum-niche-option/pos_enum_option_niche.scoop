import scoop.core.*

enum MyOpt {
    Some(val value: Int),
    None,
}

fun main(): Int {
    val some: MyOpt = Some(1)
    val none: MyOpt = None()

    val x: Int = when (some) {
        Some(v) -> v
        None -> 0
    }

    val y: Int = when (none) {
        Some(v) -> v
        None -> 2
    }

    return x + y
}
