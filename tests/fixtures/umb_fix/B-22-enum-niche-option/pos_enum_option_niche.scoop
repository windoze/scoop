// EXPECT: ok
// SPEC: docs/spec/language_spec-part2.md#52-enum;docs/spec/language_spec-part2.md#53-value-only-enum
// COVERS: NONE
// BUCKETS: B-15, B-22
// REASON: U5-T02 records the spec surface before the matching implementation gate is enabled.
// SOURCE-FIXTURE: tests/fixtures/run-pass/enum_rich_when_basic.scoop

import scoop.core.*

enum MyOpt {
    Some(val value: Int),
    None,
}

fun main(): Int {
    val some: MyOpt = Some(1)
    val none: MyOpt = None()

    val x: Int = when (some) {
        Some(v) -> v
        None -> 0
    }

    val y: Int = when (none) {
        Some(v) -> v
        None -> 2
    }

    return x + y
}
