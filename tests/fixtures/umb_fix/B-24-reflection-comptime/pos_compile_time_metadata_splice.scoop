package fixtures.typecheck

import scoop.core.*

struct Point(val x: Int, val y: Int)

fun get_x(p: Point): Int {
    return p.["x"]
}

fun get_by_meta(p: Point): Int {
    return p.[FieldMeta { name: "y" }]
}
