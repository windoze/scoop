// EXPECT: ok
// SPEC: docs/spec/language_spec-part4.md#13-程序边界与-entry-point;docs/spec/language_spec-part4.md#8-try--catch--finally;docs/spec/language_spec-part4.md#9-runtimeerror
// COVERS: NONE
// BUCKETS: B-34
// REASON: P7-B2.7 retired B-34 rows; active try/catch/finally runtime-error smoke coverage remains.
// SOURCE-FIXTURE: tests/fixtures/run-pass/try_catch_finally_raise_int_basic.scoop

import scoop.core.*

fun boom(): Int / Raise<Int> {
    println("boom_before")
    Raise.raise(7)
    println("boom_after")
    return 0
}

fun main(): Int {
    println("case_ok")
    val ok: Int = try {
        println("try_ok")
        1
    } catch (e: Int) {
        println("catch_ok")
        e
    } finally {
        println("finally_ok")
    }
    println("after_ok")

    println("case_raise")
    val bad: Int = try {
        val x: Int = boom()
        println("unreachable")
        x
    } catch (e: Int) {
        println("catch_raise")
        println(e)
        0
    } finally {
        println("finally_raise")
    }
    println("after_raise")

    val _ = ok + bad
    return 0
}
