// EXPECT: ok
// IGNORE-UNTIL-FIX:B-02
// SPEC: docs/spec/language_spec-part2.md#2-根类型与特殊类型;docs/spec/language_spec-part2.md#21-any;docs/spec/language_spec-part2.md#22-nothing;docs/spec/language_spec-part2.md#23-unit
// COVERS: NONE
// BUCKETS: B-02, B-17
// REASON: U5-T02 records the spec surface before the matching implementation gate is enabled.
// SOURCE-FIXTURE: tests/fixtures/run-pass/nothing_raise_coerce_to_any_type.scoop

import scoop.core.*

fun main(): Int {
    // Simple raise + catch
    val r1: Int = try {
        println("try1")
        Raise.raise(10)
        println("unreachable1")
        0
    } catch (e: Int) {
        println("catch1")
        e
    }
    println(r1)

    // Nested try/catch: inner raise is caught by inner handler
    val r2: Int = try {
        val inner: Int = try {
            println("inner_try")
            Raise.raise(20)
            println("unreachable_inner")
            0
        } catch (e: Int) {
            println("inner_catch")
            e
        }
        println("outer_try_after_inner")
        inner + 1
    } catch (e: Int) {
        println("outer_catch_unreachable")
        e
    }
    println(r2)

    println("done")
    return 0
}
