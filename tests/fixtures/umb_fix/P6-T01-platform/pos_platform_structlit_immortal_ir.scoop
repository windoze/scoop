// EXPECT: pass
// ARGS: --emit-llvm
// BUILD-LLVM-CONTAINS: @__scoop_immortal_agg_
// BUILD-LLVM-CONTAINS: @__scoop_str_lit_
// BUILD-LLVM-REGEX: @__scoop_immortal_agg_[0-9a-f]+ = internal unnamed_addr constant %scoop\.core\.Platform \{ ptr addrspace\(1\) @__scoop_str_lit_
// BUILD-LLVM-NOT-CONTAINS: scoop.core.getPlatform
// BUILD-LLVM-NOT-CONTAINS: scoop_alloc_typed
// P6-T01: Platform lowers to an ordinary StructLit and is folded by the generic immortal aggregate path.

package fixtures.umb_fix.p6_t01_platform

import scoop.core.*

fun platformMetric(): Int {
    val platform: Platform = getPlatform()
    return platform.os.length() + platform.triple.length()
}

fun main(): Int {
    return platformMetric()
}
