// EXPECT: pass
// ARGS: --emit-llvm
// BUILD-LLVM-CONTAINS: @__scoop_str_lit_
// BUILD-LLVM-CONTAINS: %lir_struct_insert_env = insertvalue %scoop.core.Platform
// BUILD-LLVM-NOT-CONTAINS: scoop.core.getPlatform
// BUILD-LLVM-NOT-CONTAINS: scoop_alloc_typed
// P6-T01: Platform lowers to an ordinary LIR StructLit backed by string literals, without runtime getPlatform/alloc calls.

package fixtures.umb_fix.p6_t01_platform

import scoop.core.*

fun platformMetric(): Int {
    val platform: Platform = getPlatform()
    return platform.os.length() + platform.triple.length()
}

fun main(): Int {
    return platformMetric()
}
