import scoop.core.*

fun main(): Int {
    val names = ["a", "b", "c"]
    println(names.size())
    println(names.get(1))

    val chars = ['a', 'b', 'c']
    println(chars.size())
    val last: Char = chars.get(2)
    println(last.toInt())

    val nums = [1.0, 2.0, 3.0]
    println(nums.size())
    println(nums.get(0).toInt())
    println(nums.get(2).toInt())

    return 0
}
