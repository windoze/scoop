// EXPECT: pass
// RUN-STDOUT: pos_range_progression_for.stdout
// SPEC: docs/spec/language_spec-part3.md#13-range-与-progression-语法
// COVERS: NONE
// BUCKETS: B-13
// REASON: P7-C3 keeps range/progression transport on the active runtime codegen path.
// SOURCE-FIXTURE: tests/fixtures/run-pass/kotlin_ranges_progressions_basic.scoop

import scoop.core.*

fun main(): Int {
    println("up")
    val upStart: Int = 1
    val up: IntProgression = upStart.rangeTo(5, 2)
    up.forEach { println(it) }

    println("down")
    val downStart: Int = 5
    val down: IntProgression = downStart.downTo(1, 2)
    down.forEach { println(it) }

    println("done")
    return 0
}
