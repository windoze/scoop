import scoop.core.*
import scoop.thread.*

fun main() {
    val id: Int = currentId()
    val t: Thread = threadSpawn {
        yield()
    }
    t.join()
    sleepMillis(0)
    if (id == 0) {
        println("thread id unsupported")
    }
}
