package fixtures.typecheck

import scoop.core.*
import scoop.thread.*

effect Boom {
    fun ping(): Unit
}

fun main(): Int / Pure! {
    val entry: () -> Unit / (Boom) = {
        Boom.ping()
    }
    val t = threadSpawn(entry)
    t.join()
    return 0
}
