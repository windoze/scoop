// EXPECT: ok
// SPEC: docs/spec/language_spec-part2.md#3-内建标量类型;docs/spec/language_spec-part2.md#31-bool;docs/spec/language_spec-part2.md#32-char;docs/spec/language_spec-part2.md#33-整数类型;docs/spec/language_spec-part2.md#34-浮点类型;docs/spec/language_spec-part2.md#35-string
// COVERS: UMB-0575, UMB-0576, UMB-0577, UMB-0578, UMB-0579, UMB-0580, UMB-0584, UMB-0585, UMB-0586, UMB-0587, UMB-0591, UMB-0592
// BUCKETS: B-17, B-18, B-31
// REASON: P7-B2.5 retired B-17/B-18 rows; fixture remains active and only covers still-active B-31 scalar-method rows.
// SOURCE-FIXTURE: tests/fixtures/run-pass/operator_int_arithmetic.scoop

import scoop.core.*

fun main() {
    val min: Int = -9223372036854775807 - 1
    val max: Int = 9223372036854775807
    val seven: Int = 7
    val three: Int = 3
    val zero: Int = 0
    val one: Int = 1

    val plusOp: Int = seven + three
    val plusMethod: Int = seven.plus(three)
    val minusOp: Int = seven - three
    val minusMethod: Int = seven.minus(three)
    val timesOp: Int = seven * three
    val timesMethod: Int = seven.times(three)
    val divOp: Int = seven / three
    val divMethod: Int = seven.div(three)
    val remOp: Int = seven % three
    val remMethod: Int = seven.rem(three)
    val maxPlusOneOp: Int = max + one
    val maxPlusOneMethod: Int = max.plus(one)
    val minMinusOneOp: Int = min - one
    val minMinusOneMethod: Int = min.minus(one)
    val minTimesTwoOp: Int = min * 2
    val minTimesTwoMethod: Int = min.times(2)
    val negMinOp: Int = -min
    val negMinMethod: Int = min.unaryMinus()
    val zeroDivOneOp: Int = zero / one
    val zeroDivOneMethod: Int = zero.div(one)

    if (!(plusOp == 10)) { panic("fixture assertion failed") }
    if (!(plusMethod == 10)) { panic("fixture assertion failed") }
    if (!(minusOp == 4)) { panic("fixture assertion failed") }
    if (!(minusMethod == 4)) { panic("fixture assertion failed") }
    if (!(timesOp == 21)) { panic("fixture assertion failed") }
    if (!(timesMethod == 21)) { panic("fixture assertion failed") }
    if (!(divOp == 2)) { panic("fixture assertion failed") }
    if (!(divMethod == 2)) { panic("fixture assertion failed") }
    if (!(remOp == 1)) { panic("fixture assertion failed") }
    if (!(remMethod == 1)) { panic("fixture assertion failed") }
    if (!(maxPlusOneOp == min)) { panic("fixture assertion failed") }
    if (!(maxPlusOneMethod == min)) { panic("fixture assertion failed") }
    if (!(minMinusOneOp == max)) { panic("fixture assertion failed") }
    if (!(minMinusOneMethod == max)) { panic("fixture assertion failed") }
    if (!(minTimesTwoOp == 0)) { panic("fixture assertion failed") }
    if (!(minTimesTwoMethod == 0)) { panic("fixture assertion failed") }
    if (!(negMinOp == min)) { panic("fixture assertion failed") }
    if (!(negMinMethod == min)) { panic("fixture assertion failed") }
    if (!(zeroDivOneOp == 0)) { panic("fixture assertion failed") }
    if (!(zeroDivOneMethod == 0)) { panic("fixture assertion failed") }

    println(plusOp)
    println(plusMethod)
    println(minusOp)
    println(minusMethod)
    println(timesOp)
    println(timesMethod)
    println(divOp)
    println(divMethod)
    println(remOp)
    println(remMethod)
    println(maxPlusOneOp)
    println(maxPlusOneMethod)
    println(minMinusOneOp)
    println(minMinusOneMethod)
    println(minTimesTwoOp)
    println(minTimesTwoMethod)
    println(negMinOp)
    println(negMinMethod)
    println(zeroDivOneOp)
    println(zeroDivOneMethod)
}
