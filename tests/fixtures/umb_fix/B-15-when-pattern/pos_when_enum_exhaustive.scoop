// EXPECT: ok
// SPEC: docs/spec/language_spec-part3.md#10-when-与模式匹配;docs/spec/language_spec-part3.md#101-穷尽性
// COVERS: NONE
// BUCKETS: B-15
// REASON: P7-A3 keeps verified enum/or-pattern/guard `when` codegen on the normal path after B-15 fallbacks are retired.
// SOURCE-FIXTURE: tests/fixtures/run-pass/when_or_pattern_and_guard_basic.scoop

import scoop.core.*

enum Dir {
    A,
    B,
    C,
}

enum Opt {
    Some(val value: Int),
    None,
}

fun main(): Int {
    val dir: Dir = A()
    val x: Int = when (dir) {
        A | B -> 1
        else -> 2
    }

    val pos: Opt = Some(1)
    val y: Int = when (pos) {
        Some(n) if n > 0 -> 3
        Some(_) -> 4
        else -> 5
    }

    val zero: Opt = Some(0)
    val z: Int = when (zero) {
        Some(n) if n > 0 -> 3
        Some(_) -> 4
        else -> 5
    }

    return x + y + z
}
