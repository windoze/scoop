package fixtures.parse

struct Point(val x: Int)

fun apply(v: Int, f: (Int) -> Int): Int {
    return f(v)
}

fun main() {
    val p: Point = Point { x: 1 }
    val y: Int = apply(1, { it: Int -> it })
