// EXPECT: ok
// SPEC: docs/spec/language_spec-part2.md#51-struct
// COVERS: NONE
// BUCKETS: B-21
// REASON: P7-A2 keeps valid struct field literals accepted after frontend field gates retire stale UMB rows.
// SOURCE-FIXTURE: tests/fixtures/run-pass/struct_ctor_call_literal_equivalence_basic.scoop

import scoop.core.*

struct Point(val x: Int, val y: Int)

struct Size {
    val w: Int
    val h: Int
}

fun main(): Int {
    val fromCall: Point = Point(1, 2)
    val fromLit: Point = Point { x: 1, y: 2 }
    val named: Size = Size(h = 6, w = 5)
    val lit: Size = Size { w: 5, h: 6 }
    val code: Int = if (fromCall.x != fromLit.x) {
        10
    } else if (fromCall.y != fromLit.y) {
        11
    } else if (named.w != lit.w) {
        12
    } else if (named.h != lit.h) {
        13
    } else {
        0
    }
    return code
}
