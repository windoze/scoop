// EXPECT: ok
// SPEC: docs/spec/language_spec-part6.md#1-低层边界总览;docs/spec/language_spec-part6.md#18-与标准库的关系
// COVERS: NONE
// BUCKETS: B-27
// REASON: P7-B3.2 retired B-27 rows; coverage is now tracked by the retired ledger.
// SOURCE-FIXTURE: tests/fixtures/run-pass/std_sync_basic.scoop

import scoop.core.*
import scoop.sync.*

fun main() {
    val m: Mutex = mutexCreate()
    m.lock()
    println("mutex: locked")
    m.unlock()
    println("mutex: unlocked")
    m.destroy()
    println("mutex: destroyed")

    val cv: CondVar = condVarCreate()
    cv.notifyOne()
    cv.notifyAll()
    cv.destroy()
    println("condvar: destroyed")

    val once: Once = onceCreate()
    when (once.isDone()) {
        true -> println("once: done")
        false -> println("once: not-done")
    }

    once.run { println("once: init") }

    when (once.isDone()) {
        true -> println("once: done")
        false -> println("once: not-done")
    }

    // 第二次 run 不应再次执行 block。
    once.run { println("once: init2") }

    println("ok")
}
