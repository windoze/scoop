// EXPECT: ok
// SPEC: docs/spec/language_spec-part6.md#15-internal-atomic-value-types
// COVERS: NONE
// BUCKETS: B-26
// REASON: P7-B3.3 retired B-26 rows; coverage is owned by the retired ledger.
// SOURCE-FIXTURE: tests/fixtures/run-pass/unsafe_atomic_int_basic.scoop

import scoop.core.*
import scoop.unsafe.*

fun main() {
    @Unsafe do {
        var x: __AtomicInt = __AtomicInt(0)

        println(__atomicIntLoad(x))

        __atomicIntStore(x, 1)
        println(__atomicIntLoad(x))

        val ok1: Bool = __atomicIntCompareExchange(x, 1, 2)
        when (ok1) {
            true -> println("cas1_ok")
            false -> println("cas1_fail")
        }
        println(__atomicIntLoad(x))

        val ok2: Bool = __atomicIntCompareExchange(x, 1, 3)
        when (ok2) {
            true -> println("cas2_ok")
            false -> println("cas2_fail")
        }
        println(__atomicIntLoad(x))
    }
}
