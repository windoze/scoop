import scoop.core.*

struct Point {
    val x: Int
    val y: Int
}

fun main(): Int {
    val pair: (Int, Int) = (1, 2)
    val (a, b) = pair

    val point: Point = Point { x: a + 10, y: b + 20 }
    println(point.x)
    println(point.y)
    val Point { x, y } = point

    val total: Int = x + y

    println(a)
    println(b)
    println(x)
    println(y)
    println(total)
    return 0
}
