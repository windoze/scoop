import scoop.crypto.testdata.rootPem
import scoop.crypto.x509.TrustStore
import scoop.http.HttpException
import scoop.test.AssertionFailure
import scoop.text.toInt
import scoop.url.Url

fun main(args: Array<String>) {
    try {
        val mode = args[1L]
        val host = if (mode == "tcp-callback" || mode == "dns") "localhost" else "127.0.0.1"
        val url = Url.parse("http://" + host + ":" + args[2L].toInt().toString() + "/start")
        TrustStore.fromPem(rootPem()).use { trust ->
            when (mode) {
                "h1" -> observedHttp1(trust, url)
                "off" -> observationDisabled(trust, url)
                "follow-up" -> observedFollowUp(trust, url)
                "cache" -> observedCache(trust, url)
                "tcp-callback" -> observedTcpCallback(trust, url)
                "dns" -> observedDns(trust, url)
                "partial-head" -> observedFailure(trust, url, false)
                "partial-body" -> observedFailure(trust, url, true)
                "websocket" -> observedWebSocket(trust, url, true)
                "websocket-rejected" -> observedWebSocket(trust, url, false)
                "websocket-failure" -> observedWebSocketFailure(trust, url, false)
                "websocket-total" -> observedWebSocketFailure(trust, url, true)
                "sse" -> observedSse(trust, url)
                else -> throw IllegalArgumentException(Some("unknown observer case"))
            }
        }
        println("client observer case passed: " + mode)
    } catch (error: AssertionFailure) {
        eprintln(error.kind + " " + (error.message ?: "failure") + " at " + error.location.file + ":" + error.location.line.toString())
        throw error
    } catch (error: ResourceUseException) { diagnoseObservationFailure(error); throw error }
    catch (error: HttpException) { eprintln(error.operation + " " + error.detail + " code=" + error.code.toString()); throw error }
    catch (error: Exception) { eprintln(error.message ?: "observer fixture failed"); throw error }
}

private fun diagnoseObservationFailure(error: Throwable) {
    if (error is ResourceUseException) {
        eprintln("primary:"); diagnoseObservationFailure(error.primaryFailure)
        eprintln("cleanup:"); diagnoseObservationFailure(error.cleanupFailure)
    } else if (error is AssertionFailure)
        eprintln(error.kind + " " + (error.message ?: "assertion") + " at " + error.location.file + ":" + error.location.line.toString())
    else if (error is CancellationException) eprintln("CancellationException")
    else if (error is Exception) eprintln(error.message ?: "exception")
    else eprintln("Throwable")
}
