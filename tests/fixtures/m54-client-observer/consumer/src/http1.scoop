import scoop.asyncio.*
import scoop.crypto.x509.TrustStore
import scoop.http.*
import scoop.http.client.*
import scoop.test.*
import scoop.text.toLong
import scoop.tls.TlsTrustSource
import scoop.url.Url

internal fun observedHttp1(trust: TrustStore, url: Url) {
    val log = ObservationLog(true)
    LibuvEventLoop().run suspend { _ ->
        withHttpClient(observationConfig(trust, log)) suspend { client ->
            context(ObservationMarker("caller")) {
                val privateUrl = Url.parse("http://name:PASSWORD@127.0.0.1:" + url.httpOrigin().port.toString() +
                    "/private/BODY_SECRET?q=QUERY_SECRET#FRAGMENT_SECRET")
                val request = HttpRequest(privateUrl, "POST", [observationField("Authorization", "Bearer HEADER_SECRET"),
                    observationField("Cookie", "private=HEADER_SECRET")], RequestBody.fromText("BODY_SECRET 雪").compressed())
                client.withResponse(request) suspend { response ->
                    assertEquals(200U, response.status)
                    assertEquals(Some(HttpVersion.Http11), response.metrics!!.version)
                    context(ObservationMarker("reader")) { assertEquals("response 雪 BODY_SECRET", response.body.text(4096L)) }
                    val metrics = response.metrics!!
                    assertEquals(observationValue(response.fields, "X-Received-Bytes").toLong(), metrics.requestBodyBytes)
                    assertEquals(response.wireContentLength!!, metrics.encodedResponseBodyBytes)
                    assertEquals("response 雪 BODY_SECRET".toByteArray().size, metrics.responseBodyBytes)
                }
                client.withResponse(HttpRequest.get(url.resolve("/reuse"))) suspend { response ->
                    context(ObservationMarker("reader")) { assertEquals("reuse", response.body.text(5L)) }
                }
            }
        }
    }
    val completed = log.ofKind(HttpCallEventKind.Completed)
    assertEquals(2L, completed.size)
    val first = completed[0L].metrics
    val second = completed[1L].metrics
    checkObservationPhases(first); checkObservationPhases(second)
    assertEquals(Some(false), first.connectionReused); assertEquals(Some(true), second.connectionReused)
    assertTrue(observationPresent(first.connect) && observationPresent(first.queue))
    assertFalse(observationPresent(first.resolve) || observationPresent(first.originTls))
    assertFalse(observationPresent(second.connect) || observationPresent(second.resolve))
    assertTrue(first.queue!!.finishedAt!! <= first.connect!!.startedAt)
    assertTrue(first.firstResponseByteAt!! <= first.responseHeadersAt!!)
    assertEquals(0L, second.requestBodyBytes); assertEquals(5L, second.responseBodyBytes)
    assertTrue(completed[0L].call !== completed[1L].call)
    assertEquals("POST", completed[0L].call.method)
    val starts = log.ofKind(HttpCallEventKind.AttemptStarted)
    assertEquals(2L, starts.size)
    assertFalse(observationPresent(starts[0L].metrics.finishedAt) || observationPresent(starts[0L].metrics.queue))
    assertSame(starts[0L].call, completed[0L].call)
    val heads = log.ofKind(HttpCallEventKind.ResponseHeaders)
    assertEquals(3L, heads.size)
    assertEquals(Some(103U), heads[0L].metrics.status); assertEquals(Some(200U), heads[1L].metrics.status)
    assertTrue(first.firstResponseByteAt!! <= heads[0L].metrics.responseHeadersAt!!)
    assertTrue(log.ofKind(HttpCallEventKind.RequestProgress).size > 0L)
    assertTrue(log.ofKind(HttpCallEventKind.ResponseProgress).size > 0L)
}

internal fun observationDisabled(trust: TrustStore, url: Url) {
    LibuvEventLoop().run suspend { _ ->
        withHttpClient(HttpClientConfig(tls = HttpClientTlsConfig(TlsTrustSource.Store(trust)))) suspend { client ->
            client.withResponse(HttpRequest.get(url)) suspend { response ->
                assertEquals("probe", response.body.text(5L))
                assertFalse(observationPresent(response.metrics))
            }
        }
    }
}
