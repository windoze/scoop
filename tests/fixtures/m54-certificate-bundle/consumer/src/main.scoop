import scoop.crypto.CryptoException
import scoop.crypto.testdata.rootPem
import scoop.crypto.x509.*
import scoop.time.Instant

fun main() {
    val certificates = parseCertificatesPem(rootPem() + "\r\n" + rootPem())
    try {
        if (certificates.size != 2L) throw IllegalStateException()
        certificates[0L].close()
        gcCollect()
        TrustStore.fromPem(rootPem()).use { store ->
            val result = store.verify(certificates[1L], Instant.fromEpochSeconds(1800000000L), CertificatePurpose.Any)
            if (!result.isSuccess) throw IllegalStateException()
            Unit
        }
        try {
            parseCertificatesPem(rootPem() + "corrupt tail")
            throw IllegalStateException(Some("invalid bundle accepted"))
        } catch (error: CryptoException) {}
    } finally { for (certificate in certificates) certificate.close() }
    println("certificate bundle")
}
