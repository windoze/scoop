fun <T> choose(value: T, fallback: T = value): T = fallback

fun main() {
    val narrow: Int8 = 1
    val wide: Int16 = 2
    println((narrow + wide.toByte()).toInt())
    val signed: Int = 1
    val unsigned: UInt = 2u
    println(signed + unsigned.toInt())
    val distance: Int = 1
    println(signed shl distance.toLong())
    println(choose(3).toLong())
    val small: UInt8 = 1u
    println(small + 2.toUByte())
}
