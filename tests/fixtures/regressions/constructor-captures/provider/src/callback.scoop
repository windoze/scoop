package scoop.tests.m54.captures

public class Callback<T> public constructor(seed: T) {
    public val nested: () -> () -> T = {
        val inner: () -> T = { seed }
        inner
    }
    public val anonymous: () -> () -> T = fun(): () -> T {
        return fun(): T { return seed }
    }
    public val local: () -> T = {
        fun read(): T = seed
        read()
    }
    public val generic: () -> T = {
        fun <U> read(value: U): T = seed
        read<Int>(1)
    }
    public val shadow: (T) -> () -> () -> T = { seed ->
        val middle: () -> () -> T = {
            val inner: () -> T = { seed }
            inner
        }
        middle
    }
}
