import scoop.crypto.testdata.rootPem
import scoop.crypto.x509.TrustStore
import scoop.http.client.HttpDownloadOptions
import scoop.platform.fs.Path
import scoop.test.*

fun main(args: Array<String>) {
    val root = Path.fromString(args[1L])
    assertFailsWith<IllegalArgumentException> { HttpDownloadOptions(bufferSize = 0L) }
    assertFailsWith<IllegalArgumentException> { HttpDownloadOptions(bufferSize = -1L) }
    TrustStore.fromPem(rootPem()).use { trust ->
        for (last in [false, true]) for (mode in ["caller", "client"]) for (cleanup in ["none", "direct", "wrapped", "nested"]) {
            val name = last.toString() + "-" + mode + "-" + cleanup
            try { downloadCancellation(trust, root.resolve(Path.fromString(name)), last, mode, cleanup) }
            catch (error: AssertionFailure) { reportDownloadAssertion(name, error); throw error }
        }
        for (last in [false, true]) {
            val name = last.toString() + "-total"
            try { downloadCancellation(trust, root.resolve(Path.fromString(name)), last, "total", "wrapped") }
            catch (error: AssertionFailure) { reportDownloadAssertion(name, error); throw error }
        }
        for (nested in [false, true]) {
            val name = "callback-" + nested.toString()
            try { downloadCallbackFailure(trust, root.resolve(Path.fromString(name)), nested) }
            catch (error: AssertionFailure) { reportDownloadAssertion(name, error); throw error }
        }
        downloadSelfClose(trust, root.resolve(Path.fromString("self-close")))
        downloadFileFailure(trust, root.resolve(Path.fromString("file-error")))
        downloadInvalidPath(trust)
    }
    println("client download cancellation callbacks cleanup and close ownership passed")
}

private fun reportDownloadAssertion(name: String, error: AssertionFailure) {
    println(name + " " + error.kind + " " + (error.message ?: "failure") + " at " + error.location.line.toString())
}
