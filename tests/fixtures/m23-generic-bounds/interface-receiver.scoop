package consumer.bounds

import templates.bounds.*

public fun <T> exercise(value: T): Int {
    val receiver: Readable = PlainDerived()
    val read = readReference(receiver)
    val boxed: Readable = Value(42)
    val valueRead = readReference(boxed)
    val allocated = GenericValue<T>(value, 0)
    if (readBound(receiver) != 42 || readBound(boxed) != 42 || allocated.read() != 0) { return 1 }
    if (valueRead() != 42) { return 2 }
    return read()
}

public fun result(): Int = exercise<Int>(1)
