package consumer.bounds

import templates.bounds.*

public fun <T> exercise(value: T): Int {
    val receiver: Base<T> = Derived<T>(value)
    val read = readReference(receiver)
    val get = genericClassReference<Base<T>, T>(receiver)
    val copied = GenericValue<T>(genericClassGet<Base<T>, T>(receiver), 42)
    val retained = GenericValue<T>(get(), 42)
    if (readBound(receiver) != 42 || copied.read() != 42 || retained.read() != 42) { return 1 }
    return read()
}

public fun result(): Int = exercise<Int>(1)
