import scoop.crypto.testdata.*
import scoop.platform.concurrent.Thread
import scoop.platform.fs.*
import scoop.tls.TlsVersion

fun check(value: Boolean, location: SourceLocation = currentSourceLocation()) {
    if (!value) throw IllegalStateException(Some("CA file assertion at " + location.file + ":" + location.line.toString()))
}

fun main() {
    val directory = createTempDirectory(prefix = "scoop-ca-file-")
    try {
        val path = directory.resolve(Path.fromString("CA bundle 中.pem"))
        var bundle = intermediatePem()
        for (index in 0L..<20L) bundle += rootPem()
        check(bundle.toByteArray().size > 8192L)
        path.writeText(bundle)
        val worker = Thread.start {
            for (version in [TlsVersion.Tls12, TlsVersion.Tls13])
                withPeer(version) { port -> synchronousCaFile(path, port, version) }
        }
        try {
            for (version in [TlsVersion.Tls12, TlsVersion.Tls13])
                withPeer(version) { port -> asynchronousCaFile(path, port, version) }
        } finally { worker.join() }
    } finally { directory.deleteRecursively() }
    println("Explicit CA files authenticate synchronous and suspend mTLS without retaining input resources")
}
