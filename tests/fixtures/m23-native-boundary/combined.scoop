@CLayout(aligned = 8, packed = 1)
struct Packed(val value: Int8, val flag: Boolean)

enum Choice {
    Data(Packed),
    Text(String),
    Empty
}

struct Wrapper(val choice: Choice)
struct Unused(val ignored: ULong)

@Extern(name = "native_mixed", abi = "scoop")
fun nativeMixed(value: Wrapper, i8: Int8, i16: Int16, i32: Int, i64: Long,
                u8: UInt8, u16: UInt16, u32: UInt, u64: ULong)
