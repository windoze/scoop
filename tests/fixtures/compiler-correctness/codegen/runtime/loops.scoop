@NoGC @Unsafe
fun transform(source: Ptr<Int>, destination: Ptr<Int>, count: Long) {
    var index = 0L
    while (index < count) {
        destination.store(index, source.load(index) * 3 + 7)
        index += 1L
    }
}

@NoGC
fun strictDifference(x: Double, y: Double, z: Double): Double {
    return ((x + y) + z) - ((y + z) + x)
}

@Unsafe
fun main() {
    val source = Array<Int>(4097L) { i -> if (i == 0L) 2147483647 else i.toInt() }
    val destination = MutableArray<Int>(4097L) { _ -> 0 }
    source.withDataPointer<Int, Unit>() { from: Ptr<Int>, count: Long ->
        @Unsafe {
            destination.withDataPointer<Int, Unit>() { to: Ptr<Int>, _: Long ->
                @Unsafe {
                    transform(from, to, count)
                    transform(from, to, 0L)
                }
            }
        }
    }
    if (destination[0L] != -2147483644 || destination[4096L] != 12295) {
        throw IllegalStateException()
    }
    var index = 1L
    while (index < destination.size) {
        if (destination[index] != index.toInt() * 3 + 7) { throw IllegalStateException() }
        index += 1L
    }
    val overlap = MutableArray<Int>(8L) { _ -> 1 }
    overlap.withDataPointer<Int, Unit>() { data: Ptr<Int>, _: Long ->
        @Unsafe { transform(data, data + 1L, 7L) }
    }
    var expected = 1
    index = 0L
    while (index < overlap.size) {
        if (overlap[index] != expected) { throw IllegalStateException() }
        expected = expected * 3 + 7
        index += 1L
    }
    if (strictDifference(1.0e20, -1.0e20, 1.0) != 1.0) { throw IllegalStateException() }
    println("NoGC loops, aliases and strict arithmetic preserved")
}
