@Extern(lib = "profiling_threads", name = "m13_run_many")
fun workers(function: FunPtr<(Int, Ptr<Unit>) -> Int>, context: Ptr<Unit>, base: Int, count: Int): Int

fun leaf(value: Int): Int { return value + 1 }

fun choose(value: Int): Int {
    if (value == 0) return 10
    return leaf(value)
}

fun notObserved(depth: Int): Int {
    if (depth == 0) return choose(0)
    return notObserved(depth - 1)
}

fun worker(id: Int): Int {
    var i = 0
    while (i < 1000) {
        leaf(i)
        i += 1
    }
    return 0
}

@Unsafe fun main(arguments: Array<String>): Int {
    val action: (Int) -> Int = { id -> worker(id) }
    val callback = foreignCallback<(Int, Ptr<Unit>) -> Int>(action, 1, ForeignCallbackMode.Reusable)
    try {
        if (workers(callback.function, callback.context, 0, 4) != 0) return 3
    } finally { releaseForeignCallback(callback) }
    var total = 0
    var i = 0
    while (i < 3) {
        total += choose(i)
        i += 1
    }
    println(total)
    if (arguments.size > 2L) println(notObserved(2))
    if (arguments.size > 1L) exit(7)
    return 0
}
