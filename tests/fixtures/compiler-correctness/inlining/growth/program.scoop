fun check(value: Boolean) { if (!value) { throw IllegalStateException() } }
fun step(value: Int): Int {
    val first = value + 1
    val second = first + 2
    return second + 3
}
fun expanded(input: Int): Int {
    var value = input
    value = step(value)
