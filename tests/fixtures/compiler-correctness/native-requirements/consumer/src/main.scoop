package m54
import m54.regression.record
import m54.regression.same
import m54.regression.NativeRecord

class Holder<T>(val value: T)
struct Entry<T>(val label: String, val value: T)

fun nested(left: NativeRecord, right: NativeRecord): Boolean {
    val retained = Holder(Entry("live value", left))
    val entries = Array(24) { _ -> Entry("live value", right) }
    return Some(retained.value) == Some(entries[23])
}

fun main() {
    val baseline = record(-1)
    if (!same(baseline, baseline) || !nested(baseline, baseline)) {
        throw IllegalStateException(Some("equal records differ"))
    }
    var index = 0
    while (index < 11) {
        val changed = record(index)
        if (same(baseline, changed) || same(changed, baseline) || nested(baseline, changed)) {
            throw IllegalStateException(Some("a changed field compares equal"))
        }
        index += 1
    }
    println("native comparison helpers link and preserve every field")
}
