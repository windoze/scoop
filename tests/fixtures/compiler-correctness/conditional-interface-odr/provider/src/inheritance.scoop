package test.m57.provider

public interface Marker {}

public open class Gated<T> public constructor() {
    override interface Counter where T : Hash {
        public open override fun next(): Int = 51
    }
    override interface Marker where T : Hash {}
    public open fun stable(): Int = 61
}

public class Inherited<T> public constructor() : Gated<T>()
public class Relisted<T> public constructor() : Gated<T>() {
    override interface Counter where T : Hash { public override fun next(): Int = 52 }
    override interface Marker where T : Hash {}
}

public abstract class ConditionalAbstract<T> protected constructor() {
    override interface Counter where T : Hash { public abstract override fun next(): Int }
}

public interface CompanionValue<X> { public fun get(): X }
public struct CompanionSeed() { public companion object {} }
public open class Projected<T> public constructor() {
    override interface CompanionValue<T.Companion> where T.Companion : ref {
        public open override fun get(): T.Companion = T.Companion
    }
}
public class ProjectedChild<T> public constructor() : Projected<T>()
