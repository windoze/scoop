package test.m57.provider

public interface Counter { public fun next(): Int }
public struct Plain()

public struct Envelope<T>(val value: T) {
    public companion object {
        override interface ValueEncoder<Envelope<T>> where T.Companion : ValueEncoder<T> {}
        override interface ValueDecoder<Envelope<T>> where T.Companion : ValueDecoder<T> {}
    }
}

public object Always {
    override interface Counter {
        public override fun next(): Int = 41
    }
}

public struct Box<T>(val value: T) {
    override interface Hash where T : Hash {
        public override fun hash(): Long = value.hash()
    }

    public companion object {
        private var state: Int = 0
        public fun count(): Int = state

        override interface Counter where T : Hash {
            public override fun next(): Int {
                state += 1
                return state
            }
        }
    }
}
