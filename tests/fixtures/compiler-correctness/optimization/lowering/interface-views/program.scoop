interface Parent { fun first(): Int; fun second(): Int }
interface Child : Parent { fun own(): Int }
interface Empty {}
open class Base(val value: Int) : Child, Empty {
    public override fun first(): Int = value
    public override fun second(): Int = value + 1
    public override fun own(): Int = value + 2
}
class Derived(value: Int) : Base(value) {
    public override fun second(): Int = value + 10
}
struct Boxed(val value: Int) : Parent {
    public override fun first(): Int = value
    public override fun second(): Int = value + 1
}
class Holder(var value: Child)

fun check(ok: Boolean) { if (!ok) throw IllegalStateException() }
fun parent(value: Parent): Int = value.first() + value.second()
fun child(value: Child): Int = value.first() + value.second() + value.own()
fun smartParent(value: Any): Int {
    if (value is Parent) return value.first() + value.second()
    return -1
}
fun smartChild(value: Any): Int {
    if (value is Child) return value.first() + value.second() + value.own()
    return -1
}
fun smartOpen(value: Any): Int {
    if (value is Base) return value.first() + value.second()
    return -1
}
fun smartFinal(value: Any): Int {
    if (value is Derived) return value.first() + value.second()
    return -1
}

fun changedLocal(first: Child, second: Child): Int {
    var current = first
    val old = current
    val before = current.first() + current.second()
    current = second
    return before + old.first() + old.second() + current.first() + current.second()
}
fun changedView(first: Child, second: Child): Int {
    var view: Parent = first
    val old = view.first() + view.second()
    view = second
    return old + first.first() + first.second() + view.first() + view.second()
}
fun changedField(holder: Holder, second: Child): Int {
    val old = holder.value.first()
    holder.value = second
    return old + holder.value.second()
}
fun changedLoop(first: Child, second: Child): Int {
    var current = first
    var total = 0
    var index = 0
    while (index < 4) {
        total += current.first() + current.second()
        current = second
        index += 1
    }
    return total
}
fun fail(early: Boolean) { if (early) throw IllegalStateException() }
fun exception(first: Child, second: Child, early: Boolean): Int {
    var current = first
    try {
        val old = current.first() + current.second()
        fail(early)
        current = second
        fail(old > 0)
    } catch (error: IllegalStateException) {
        return current.first() + current.second()
    }
    return -1
}
fun empty(value: Any): Boolean {
    if (value is Empty) {
        val saved: Empty = value
        val erased: Any = saved
        return erased === value && erased is Empty
    }
    return false
}

interface Generic<T> { fun get(): T }
class GenericValue<T>(val item: T) : Generic<T> {
    public override fun get(): T = item
}
fun generic(value: Any): Int {
    if (value is Generic<Int>) return value.get()
    return -1
}
fun guardedLoop(value: Any, count: Int): Int {
    if (!(value is Child)) return -1
    var total = 0
    var index = 0
    while (index < count) {
        if (index % 2 == 0) total += value.first()
        else total += value.second()
        index += 1
    }
    return total + value.own()
}
fun guardedTry(value: Any, early: Boolean): Int {
    if (value is Child) {
        try {
            fail(early)
            return value.first() + value.second()
        } catch (error: IllegalStateException) {
            return value.own()
        }
    }
    return -1
}
fun castParent(value: Any): Int {
    val view = value as Parent
    return view.first() + view.second()
}
fun tryParent(value: Any): Int {
    return when (value as? Parent) {
        case Some(view) -> view.first() + view.second()
        case None -> -1
    }
}

fun repeatedChecks(value: Any, count: Int): Int {
    var total = 0
    var index = 0
    while (index < count) {
        if (value is Child) total += value.first()
        if (value is Empty) total += 100
        if (value is Generic<Int>) total += value.get()
        if (value is Generic<String>) total += 1000
        index += 1
    }
    return total
}
fun changingChecks(first: Any, second: Any, count: Int): Int {
    var value = first
    var total = 0
    var index = 0
    while (index < count) {
        val source = value
        if (source is Child) total += source.first()
        value = if (index % 2 == 0) second else first
        index += 1
    }
    return total
}
fun repeatedCasts(value: Any, count: Int): Int {
    var total = 0
    var index = 0
    while (index < count) {
        try {
            val view = value as Parent
            total += view.first()
        } catch (error: ClassCastException) { total -= 1 }
        when (value as? Parent) {
            case Some(view) -> total += view.second()
            case None -> total -= 2
        }
        index += 1
    }
    return total
}

fun main() {
    val first = Base(3)
    val second = Derived(7)
    check(parent(first) == 7 && child(first) == 12)
    check(parent(second) == 24 && child(second) == 33)
    check(smartParent(first) == 7 && smartParent(second) == 24)
    check(smartChild(first) == 12 && smartChild(second) == 33)
    check(smartOpen(second) == 24 && smartFinal(second) == 24)
    check(smartParent(Boxed(4)) == 9 && smartChild(Boxed(4)) == -1)
    check(smartParent("absent") == -1 && smartChild("absent") == -1)
    check(changedLocal(first, second) == 38)
    check(changedView(first, second) == 38)
    check(changedField(Holder(first), second) == 20)
    check(changedLoop(first, second) == 79)
    check(exception(first, second, true) == 7 && exception(first, second, false) == 24)
    check(empty(first) && empty(second) && !empty("absent"))
    check(generic(GenericValue<Int>(23)) == 23 && generic(GenericValue<String>("other")) == -1)
    check(guardedLoop(first, 4) == 19 && guardedLoop(second, 4) == 57)
    check(guardedLoop("absent", 4) == -1)
    check(guardedTry(second, false) == 24 && guardedTry(second, true) == 9)
    check(guardedTry("absent", false) == -1)
    check(castParent(Boxed(4)) == 9 && tryParent(second) == 24 && tryParent("absent") == -1)
    check(repeatedChecks(first, 0) == 0 && repeatedChecks(first, 1) == 103)
    check(repeatedChecks(first, 5) == 515 && repeatedChecks(second, 5) == 535)
    check(repeatedChecks(Boxed(4), 5) == 0 && repeatedChecks("absent", 5) == 0)
    check(repeatedChecks(GenericValue<Int>(23), 5) == 115)
    check(repeatedChecks(GenericValue<String>("other"), 5) == 5000)
    check(changingChecks(first, "absent", 4) == 6 && changingChecks(first, second, 4) == 20)
    check(repeatedCasts("absent", 0) == 0 && repeatedCasts("absent", 4) == -12)
    check(repeatedCasts(first, 4) == 28 && repeatedCasts(second, 4) == 96)
    check(repeatedCasts(Boxed(4), 4) == 36)
    var failed = false
    try { castParent("absent") } catch (error: ClassCastException) { failed = true }
    check(failed)
    println("interface views preserve receivers and control flow")
}
