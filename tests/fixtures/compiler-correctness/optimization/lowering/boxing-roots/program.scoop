class Node(var value: Long)
struct Payload<T>(val value: T, val nested: (Node, String))
enum Wrapped { Item(Payload<Node>), Empty }
struct WidePayload(val first: (Long, Long, Long, Long, Long, Long, Long, Long),
                   val last: (Long, Long, Long, Long, Long, Long, Long, Long),
                   val refs: Payload<Node>)
struct Empty()

fun check(ok: Boolean) { if (!ok) throw IllegalStateException() }
fun <T> roundTrip(value: T): T {
    val boxed: Any = value
    gcCollect()
    return boxed as T
}

fun references(index: Long) {
    val node = Node(index)
    val payload = Payload(node, (Node(index + 1L), "left" + "right"))
    val boxed: Any = payload
    val tuple: Any = (Node(index + 2L), "tuple" + "value")
    val wrapped: Any = Wrapped.Item(payload)
    var turn = 0
    while (turn < 3) {
        gcCollect()
        val result = boxed as Payload<Node>
        check(result.value === node && result.nested._1.value == index + 1L)
        check(result.nested._2 == "leftright")
        result.value.value += 1L
        val pair = tuple as (Node, String)
        check(pair._1.value == index + 2L && pair._2 == "tuplevalue")
        val item = wrapped as Wrapped
        check(when (item) { case Item(value) -> value.value === node; case Empty -> false })
        turn += 1
    }
    val generic = roundTrip(payload)
    check(generic.value.value == index + 3L)
    check(generic.nested._1.value == index + 1L)
}

fun wideBoxes() {
    val node = Node(29L)
    val payload = WidePayload((0L, 1L, 2L, 3L, 4L, 5L, 6L, 7L),
                              (8L, 9L, 10L, 11L, 12L, 13L, 14L, 15L),
                              Payload(node, (Node(31L), "wide")))
    val boxes = MutableArray<Any>(4L) { index -> if (index < 2L) payload else Empty() }
    gcCollect()
    check(boxes[0L] !== boxes[1L] && boxes[2L] !== boxes[3L])
    val copy = Array<Any>(boxes)
    boxes[0L] = Empty()
    gcCollect()
    val result = copy[0L] as WidePayload
    check(result.first._8 == 7L && result.last._8 == 15L)
    check(result.refs.value === node && result.refs.nested._1.value == 31L)
    check(result.refs.nested._2 == "wide")
}

fun main() {
    wideBoxes()
    var index = 0L
    while (index < 8L) {
        references(index)
        index += 1L
    }
    println("boxed aggregate snapshots retain relocated references")
}
