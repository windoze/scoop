package dev.m34
import dev.m34.maybe.provider.Pair
import dev.m34.maybe.provider.Read
import dev.m34.maybe.provider.Payload
import dev.m34.maybe.provider.storage
import dev.m34.maybe.provider.wrap
import dev.m34.maybe.provider.extract
import dev.m34.maybe.provider.identity
import dev.m34.maybe.provider.roundTrip
import dev.m34.maybe.provider.captured

fun check(value: Boolean) { if (!value) { throw IllegalStateException() } }
@Unsafe fun main() {
    check(storage<Int>().assumeInit() == 0)
    val value = wrap(Pair(42L, 7))
    check(extract(value).number == 42L)
    check(identity(value).assumeInit().tag == 7)
    val callable: (MaybeUninit<Pair>) -> MaybeUninit<Pair> = ::identity
    check(callable(value).assumeInit().number == 42L)
    val payload = MaybeUninit<Read>.initialized(Payload(53))
    val returned = roundTrip(payload)
    val capturedValue = captured(Payload(64))
    gcCollect()
    check(returned.assumeInit().value() == 53)
    check(capturedValue().assumeInit().value() == 64)
    val optional: MaybeUninit<Read>? = Some(returned)
    gcCollect()
    check(optional!!.assumeInit().value() == 53)
    println("maybe artifacts")
}
