package scoop.tests
import scoop.tests.compilerinput.*
fun inspect(bytes: Array<Byte>): Boolean {
    val value: Any = bytes
    return value is Array<Byte> && bytes.size == 4 && bytes[0] == 0 && bytes[1] == 127 && bytes[2] == -128 && bytes[3] == -1
}
fun main() {
    val bytes = [embedded, generic(1), generic("type"), defaulted(), direct()]
    gcCollect()
    for (value in bytes) println(inspect(value))
}
