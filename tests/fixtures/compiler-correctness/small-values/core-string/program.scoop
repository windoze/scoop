fun check(value: Boolean) { if (!value) { throw IllegalStateException() } }

fun badIndex(text: String, index: Long) {
    try { text.getCharAt(index) }
    catch (error: IndexOutOfBoundsException) { return }
    throw IllegalStateException()
}

fun main() {
    val text = "A" + "雪🙂"
    check(text.getCharAt(0L) == 'A' && text.getCharAt(1L) == '雪' && text.getCharAt(2L) == '🙂')
    badIndex(text, -1L)
    badIndex(text, 3L)
    badIndex("", 0L)
    check(text.slice(1L, 3L) == "雪🙂")
    val bytes: List<Byte> = [65.toByte(), 0xe9.toByte(), 0x9b.toByte(), 0xaa.toByte()]
    val decoded = String.fromUtf8(bytes)
    gcCollect()
    check(decoded.getCharAt(1L) == '雪')
    val invalid: List<Byte> = [0xff.toByte()]
    check(String.fromUtf8OrNone(invalid) == None)
    println("core string ABI")
}
