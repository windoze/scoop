package consumer.pointers

import dependency.pointers.typeAddress

public fun <T> exercise(value: T): Int {
    var number = 0
    @Unsafe {
        val pointer = addressOf(number)
        val changed = pointer.cast<Boolean>().cast<Int>()
        val inferred: Ptr<Int> = pointer.cast()
        if (typeAddress<Int>(pointer) != inferred.toULong()) { return 2 }
        changed.store(0L, 42)
        val forward = changed + 0L
        val backward = forward - 0L
        if (backward.toULong() != pointer.toULong()) { return 1 }
        return backward.load(0L) + number - 42
    }
}

public fun result(): Int = exercise<Int>(0)
