package dev.example
import dev.example.dependency.classes.Counter
import dev.example.dependency.classes.InterfaceParent
import dev.example.dependency.classes.Readable

public class Derived public constructor(): InterfaceParent() {
    public override fun read(): Long = seed + 1
}
public fun primary(): Counter {
    val value: Readable = Derived()
    return Counter(value.answer() - 1)
}
