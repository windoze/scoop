package dev.example
import dev.example.dependency.classes.Counter
import dev.example.dependency.classes.Readable
import dev.example.dependency.classes.retainReadable

public class LocalReader public constructor(val value: Long): Readable {
    public override fun read(): Long = value
}
public fun primary(): Counter {
    val reader: Readable = LocalReader(20)
    return Counter(retainReadable(reader).answer())
}
