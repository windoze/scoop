package dev.programlink
import dev.programlink.programlink.shadow.String as OrdinaryString

@Extern(name = "abs")
private fun rootAbsolute(value: Int): Int

fun main() {
    @Unsafe { if (rebuiltAbsolute(-42) != 42) throw IllegalStateException() }
    write("rebuilt\n")
    @Unsafe { if (rootAbsolute(-7) != 7) throw IllegalStateException() }
    write("root\n")
    println(("te" + "xt").rebuiltAnswer())
    println(OrdinaryString(40).value + 2)
}
