package dev.programlink.schedule.join
import dev.programlink.schedule.next.*
import dev.programlink.schedule.peer.*

private fun trace(value: Long) { println(value) }

private fun initialize(): Long {
    @Unsafe { trace(40) }
    return if (next == 20L && peer == "cpeer") { 40L } else { 0L }
}
public val joined: Long = initialize()
