package dev.programlink.consumer.union

import dev.programlink.dependency.union.*
import dev.programlink.sibling.left.action as leftAction
import dev.programlink.sibling.right.action as rightAction
import dev.programlink.sibling.left.sameType as leftType
import dev.programlink.sibling.right.sameType as rightType

public fun check(): Int {
    val left = leftAction()(Payload(0)) as Payload
    val right = rightAction()(Payload(0)) as Other
    if ((leftType() as Readable).read() != 42) { return 1 }
    if ((rightType() as Readable).read() != 42) { return 2 }
    return left.number + right.number
}

fun main() { println(check()) }
