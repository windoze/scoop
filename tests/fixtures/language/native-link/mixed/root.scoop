package dev.programlink
import dev.programlink.nativelink.mixed.*
import dev.programlink.nativelink.mixedleft.*
import dev.programlink.nativelink.mixedright.*

struct Marker(val text: String)

fun main() {
    val marker = Marker("mixed-" + "alive")
    println(0)
    println(left())
    println(right())
    println(shared(marker, 30))
    gcCollect()
    println(marker.text)
}
