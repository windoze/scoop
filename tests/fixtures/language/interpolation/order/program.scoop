class Journal(var log: String)
class Value(val journal: Journal, val id: Int, val fail: Boolean) : ToString {
    public override fun toString(): String {
        journal.log = journal.log + "T" + id.toString()
        gcCollect()
        if (fail) { throw IllegalStateException() }
        return id.toString()
    }
}
fun make(journal: Journal, id: Int, fail: Boolean): Value {
    journal.log = journal.log + "E" + id.toString()
    return Value(journal, id, fail)
}
fun explode(journal: Journal): Int {
    journal.log = journal.log + "X"
    throw IllegalArgumentException()
}
fun check(value: Boolean) { if (!value) { throw IllegalStateException() } }
fun main() {
    val journal = Journal("")
    val text = f"${make(journal, 1, false)}|${make(journal, 2, false)}"
    check(text == "1|2" && journal.log == "E1T1E2T2")
    journal.log = ""
    var failed = false
    try { val ignored = f"${make(journal, 3, false)}${make(journal, 4, true)}${make(journal, 5, false)}" }
    catch (error: IllegalStateException) { failed = true }
    check(failed && journal.log == "E3T3E4T4")
    journal.log = ""
    failed = false
    try { val ignored = f"before${explode(journal)}${make(journal, 6, false)}" }
    catch (error: IllegalArgumentException) { failed = true }
    check(failed && journal.log == "X")
    println(42)
}
