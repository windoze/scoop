package dev.m37.provider
public typealias Base = Int16
public enum Code : Base { Cold = -3, Hot = 13 }
public enum Token<T> : UInt8 { Low = 0u, High = 7u }
@CLayout public struct Packet(val code: Code, val token: Token<String>)
public fun <T> keep(value: T): T { gcCollect(); return value }
public fun <T> raw(value: Token<T>): UInt8 = value
public fun read(code: Code = Code.Hot): Base = code
public fun boxed(code: Code): Any = code
public fun less(code: Code, other: Base): Boolean = code < other
public fun <T> localCode(value: T): Base {
    enum Local: Base { Cold = -3, Hot = 13 }
    val pair = (value, Local.Hot)
    gcCollect()
    return pair._2
}
