private struct Payload(val flag: Boolean) {}
private enum Selection { Empty, Present(Payload) }
private struct Box<T>(val value: T) {}
@CLayout private struct CValue(val value: Boolean) {}
@CLayout private struct Result(val value: Boolean) {}
private class Fields private constructor(
    private val boxed: Box<Payload>,
    private val pair: (CValue, Payload),
    private val callback: (CValue) -> Result,
    private val pointer: Ptr<CValue>,
    private val native: FunPtr<(CValue) -> Result>
) {}
public object Storage {
    private val selected: Selection = Empty
    private val fields: Fields? = None
}
private struct Unrelated() {}
