package dev.m33
import dev.m33.m33.cstrings.*

struct Result(val text: String, val count: Long)
fun expect(value: Boolean) { if (!value) { throw IllegalStateException() } }

fun main() {
    val text = String.fromUtf8([231.toByte(), 149.toByte(), 140.toByte()])
    @Unsafe {
        val result = useCString(text, fun(pointer: Ptr<Int8>): Result {
            @Unsafe {
                gcCollect()
                return Result(String.fromCString(pointer), 3L)
            }
        })
        gcCollect()
        expect(result.text == "界" && result.count == 3L)
    }
    expect(roundTrip("A界B") == "A界B" && roundTrip("") == "")
    var rejected = false
    try {
        val unexpected = roundTrip("\u0000")
        expect(unexpected.charLength < 0L)
    } catch (error: IllegalArgumentException) { rejected = true }
    expect(rejected)
    println("cstrings-artifacts-ok")
}
