class NativeNode(val left: NativeNode?, val right: NativeNode?)

@Extern(lib = "fixture_native", name = "native_root_round_trip", abi = "scoop")
fun nativeRootRoundTrip(message: String, prototype: NativeNode): String

struct ManagedAggregate(val value: String, val left: Long, val right: Long)

@Extern(lib = "fixture_native", name = "native_aggregate_round_trip", abi = "scoop")
fun nativeAggregateRoundTrip(value: ManagedAggregate): ManagedAggregate

fun <T : ToString> stringify(value: T): String = value.toString()

fun main() {
    write("direct managed ref")
    println(nativeRootRoundTrip(stringify(42), NativeNode(None, None)))
    val aggregate = nativeAggregateRoundTrip(ManagedAggregate("agg" + "regate", 10, 20))
    println(aggregate.value)
    println(aggregate.left)
    println(aggregate.right)
}
