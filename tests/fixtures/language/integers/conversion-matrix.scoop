// EXPECT-COMPILE

fun main() {
    val i8: Int8 = -1
    println(i8.toByte())
    println(i8.toShort())
    println(i8.toInt())
    println(i8.toLong())
    println(i8.toUByte())
    println(i8.toUShort())
    println(i8.toUInt())
    println(i8.toULong())

    val i16: Int16 = -257
    println(i16.toByte())
    println(i16.toShort())
    println(i16.toInt())
    println(i16.toLong())
    println(i16.toUByte())
    println(i16.toUShort())
    println(i16.toUInt())
    println(i16.toULong())

    val i32: Int = -65537
    println(i32.toByte())
    println(i32.toShort())
    println(i32.toInt())
    println(i32.toLong())
    println(i32.toUByte())
    println(i32.toUShort())
    println(i32.toUInt())
    println(i32.toULong())

    val i64: Long = -4294967297L
    println(i64.toByte())
    println(i64.toShort())
    println(i64.toInt())
    println(i64.toLong())
    println(i64.toUByte())
    println(i64.toUShort())
    println(i64.toUInt())
    println(i64.toULong())

    val u8: UInt8 = 255u
    println(u8.toByte())
    println(u8.toShort())
    println(u8.toInt())
    println(u8.toLong())
    println(u8.toUByte())
    println(u8.toUShort())
    println(u8.toUInt())
    println(u8.toULong())

    val u16: UInt16 = 65535u
    println(u16.toByte())
    println(u16.toShort())
    println(u16.toInt())
    println(u16.toLong())
    println(u16.toUByte())
    println(u16.toUShort())
    println(u16.toUInt())
    println(u16.toULong())

    val u32: UInt = 4294967295u
    println(u32.toByte())
    println(u32.toShort())
    println(u32.toInt())
    println(u32.toLong())
    println(u32.toUByte())
    println(u32.toUShort())
    println(u32.toUInt())
    println(u32.toULong())

    val u64: ULong = 18446744073709551615uL
    println(u64.toByte())
    println(u64.toShort())
    println(u64.toInt())
    println(u64.toLong())
    println(u64.toUByte())
    println(u64.toUShort())
    println(u64.toUInt())
    println(u64.toULong())
}
