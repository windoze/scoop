interface Describable {
    fun describe(): String
}

class Doc(val title: String) : Describable {
    override fun describe(): String = title
}

struct Tag(val v: Int) : Describable {
    override fun describe(): String = "tag"
}

fun <T> isPresent(value: T?): Boolean = when (value) {
    case Some(_) -> true
    case None -> false
}

fun main() {
    val d = Doc("report")
    println(d.describe())
    val i: Describable = d
    println(i.describe())
    val t = Tag(1)
    val ti: Describable = t
    println(ti.describe())
    val a: Any = t
    println(a is Tag)
    println(isPresent(a as? Describable))
}
