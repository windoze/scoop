package dev.example.consumer.nesting

import dev.example.facade.nesting.Outer
import dev.example.facade.nesting.Outer.Companion.*
import dev.example.facade.nesting.Outer.Tools.keep

public fun <T> exercise(value: T, read: (T) -> Int): Int {
    val leaf = CompanionLeaf(Outer<Int>.companionAdd(Outer<Int>.companionBase))
    return if (read(keep<T>(value)) == 42) { leaf.number } else { 0 }
}

private fun readInt(value: Int): Int = value
public fun result(): Int = exercise<Int>(42, ::readInt)
