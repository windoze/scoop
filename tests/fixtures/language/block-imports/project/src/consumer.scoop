package scoped.consumer

fun before(): Int {
    selected()
    import scoped.api.answer as selected
    return 0
}

fun after(): Int {
    {
        import scoped.api.answer as selected
        val value = selected()
    }
    return selected()
}

fun inaccessible(): Int {
    import scoped.api.hidden
    return 0
}

fun missing(): Int {
    import scoped.missing.value
    return 0
}

fun ambiguous(): Int {
    import scoped.api.first as value
    import scoped.api.second as value
    return value
}

fun conflictingImports(): Int {
    import Int as Value
    import String as Value
    return 0
}
