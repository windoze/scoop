class Counter {
    var value = 2
        get() = field + 1
        set(next) { field = next }
    val plain = 9
        get() = field
}
val String.echo get() = this
val <T> Box<T>.item get() = value
class Box<T>(val value: T)
var Counter.twice
    get() = value + value
    set(next) { value = next }
fun main() {
    val counter = Counter()
    println(counter.value)
    counter.value = 4
    println(counter.twice)
    counter.twice = 8
    println(counter.value)
    println(counter.plain)
    println("extension".echo)
    println(Box(42).item)
}
