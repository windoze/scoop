package dev.m37
import dev.m37.annotated.bridge.*
import dev.m37.annotated.bridge.Mark as Label
@Label
struct Defaulted(val value: Int)
@Mark(Level.Low, Name("consumer", [Level.High]), [Token<Int>.First], [])
struct Explicit(val value: Int)
fun main() {
    println(Item(Defaulted(7).value).value)
    println(Bridge("bridge").text)
    println(forwarded("local"))
}
