package dev.m41.additions

public struct Key(val value: Int) : Add<Key, Key> {
    @NoGC
    public override operator fun plus(other: Key): Key = Key(value + other.value)
}
public struct Foreign(val value: Int)
public operator fun Foreign.plus(other: Foreign): Foreign = Foreign(value + other.value)
public fun <T : Add<T, T>> add(left: T, right: T): T = left + right
public fun dispatch(left: Add<Int, Int>, right: Int): Int = left + right
public fun dispatchKey(left: Add<Key, Key>, right: Key): Key = left + right
public fun <T> selected(left: Foreign, right: Foreign, token: T): Foreign = left + right
