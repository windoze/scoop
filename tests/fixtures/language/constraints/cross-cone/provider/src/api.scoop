package dev.m55.m55.provider
public interface Debug {}
public interface Other {}
public class Traced public constructor() : Debug {}
public struct Plain(val value: Int)
public fun <T> foo(value: T): String = "general"
public fun <T : !Debug> foo(value: T): String = "opaque"
public fun <T> bar(value: T): String = foo(value)
public fun <T : !Debug> baz(value: T): String = foo(value)
public fun <T : !Debug> defaults(value: T, result: String = foo(value)): String = result
public fun <T> both(value: T): String where T : !Debug, T : !Other = "both"
public interface I<T> {}
public struct Box<T>(val value: T) : I<T>
public class Host<U> public constructor(val outer: U) {
    public fun <T> choose(value: T): String = "general-method"
    public fun <T : !I<U>> choose(value: T): String = "negative-method"
}
public fun <T> T.describe(): String = "general-extension"
public fun <T : !Debug> T.describe(): String = "negative-extension"
public fun <T : !Debug> recursive(value: T, depth: Int): String {
    fun <U : !Debug> local(item: U): String = foo(item)
    if (depth == 0) return local(value)
    return recursive(value, depth - 1)
}
