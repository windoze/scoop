package dev.m55
import dev.m55.m55.facade.*
fun <T : !Debug> forward(value: T): String = baz(value)
fun <T> pair(value: T): String where T : !Other, T : !Debug = both(value)
fun main() {
    println(foo(Plain(1)))
    println(foo(Traced()))
    println(bar(Plain(2)))
    println(forward(Plain(3)))
    println(defaults(Plain(4)))
    println(pair(Plain(5)))
    val reference: (Plain) -> String = ::foo
    println(reference(Plain(6)))
    println(Host("outer").choose(Box(1)))
    println(Host("outer").choose(Box("value")))
    println(Plain(7).describe())
    println(Traced().describe())
    println(recursive(Plain(8), 3))
}
