import scoop.compiler.includeStr as embed
fun invalid(path: String) {
    val empty = embed("")
    val nul = embed("a\u{0}b")
    val dynamic = embed(path)
    val reference = ::embed
    val utf8 = embed("invalid.bin")
    val directory = embed(".")
    val outside = embed("../outside.txt")
    val symlink = embed("escape.txt")
    val missing = embed("missing.txt")
}
fun <T> unused(value: T): String = embed("")
fun defaulted(value: String = embed("")) {}
fun main() {}
