fun expect(value: Boolean) { if (!value) { throw IllegalStateException() } }

fun valid(bytes: Array<Byte>, text: String, scalars: Long) {
    val strict = String.fromUtf8(bytes)
    val optional = String.fromUtf8OrNone(bytes)
    val replaced = String.fromUtf8Lossy(bytes)
    gcCollect()
    expect(strict == text && optional == Some(text) && replaced == text)
    expect(strict.charLength == scalars && strict.byteLength == bytes.size)
    expect(replaced.byteLength == bytes.size)
}

fun invalid(bytes: Array<Byte>, offset: Long, text: String) {
    var caught = false
    try {
        val unexpected = String.fromUtf8(bytes)
        expect(unexpected.byteLength < 0L)
    } catch (error: CharacterCodingException) {
        gcCollect()
        expect(error.byteOffset == offset)
        caught = true
    }
    expect(caught && String.fromUtf8OrNone(bytes) == None)
    val replaced = String.fromUtf8Lossy(bytes)
    gcCollect()
    expect(replaced == text && replaced.byteLength == text.byteLength)
}

fun main() {
    valid([], "", 0L)
    valid([65.toByte(), 0.toByte(), 66.toByte()], "A\u0000B", 3L)
    valid([194.toByte(), 128.toByte(), 223.toByte(), 191.toByte()], "\u0080\u07FF", 2L)
    valid([224.toByte(), 160.toByte(), 128.toByte(), 237.toByte(), 159.toByte(), 191.toByte(), 238.toByte(), 128.toByte(), 128.toByte()], "\u0800\uD7FF\uE000", 3L)
    valid([240.toByte(), 144.toByte(), 128.toByte(), 128.toByte(), 244.toByte(), 143.toByte(), 191.toByte(), 191.toByte()], "\u{10000}\u{10FFFF}", 2L)
    valid([239.toByte(), 191.toByte(), 189.toByte(), 101.toByte(), 204.toByte(), 129.toByte()], "�e\u0301", 3L)
    expect(String.fromUtf8([101.toByte(), 204.toByte(), 129.toByte()]) != "é")

    invalid([65.toByte(), 128.toByte(), 66.toByte()], 1L, "A�B")
    invalid([128.toByte(), 128.toByte()], 0L, "��")
    invalid([192.toByte(), 175.toByte()], 0L, "��")
    invalid([224.toByte(), 159.toByte(), 191.toByte()], 0L, "���")
    invalid([237.toByte(), 160.toByte(), 128.toByte()], 0L, "���")
    invalid([240.toByte(), 143.toByte(), 191.toByte(), 191.toByte()], 0L, "����")
    invalid([244.toByte(), 144.toByte(), 128.toByte(), 128.toByte()], 0L, "����")
    invalid([245.toByte(), 128.toByte(), 128.toByte(), 128.toByte()], 0L, "����")
    invalid([255.toByte(), 65.toByte()], 0L, "�A")
    invalid([194.toByte()], 0L, "�")
    invalid([225.toByte(), 128.toByte()], 0L, "�")
    invalid([240.toByte(), 144.toByte(), 128.toByte()], 0L, "�")
    invalid([225.toByte(), 128.toByte(), 65.toByte()], 0L, "�A")
    invalid([241.toByte(), 128.toByte(), 128.toByte(), 65.toByte()], 0L, "�A")
    invalid([194.toByte(), 162.toByte(), 0.toByte(), 225.toByte(), 128.toByte(), 65.toByte(), 239.toByte(), 191.toByte(), 189.toByte()], 3L, "¢\u0000�A�")
    println("utf8-values-ok")
}
