package dev.example.consumer.pointers

import dev.example.dependency.pointers.copy
import dev.example.dependency.pointers.replace
import dev.example.dependency.pointers.bytes
import dev.example.dependency.pointers.alignment
import dev.example.dependency.pointers.layoutDefault

public fun <T> exercise(value: T): Int {
    @Unsafe {
        val number = copy<Int>(40)
        if (bytes<Int>() != 4uL || alignment<Int>() != 4uL || layoutDefault<Int>() != 8uL) { return 1 }
        return replace<Int>(0, number + 2)
    }
}

public fun result(): Int = exercise<Int>(0)

@Unsafe
public fun <P: value> roundTrip(value: P): P = copy<P>(value)
