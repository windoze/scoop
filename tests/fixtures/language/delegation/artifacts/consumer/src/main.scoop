package dev.m37
import dev.m37.bridge.*
fun main() {
    val via = Via(Impl("retained"))
    gcCollect()
    println(via.get())
    println(via.current)
    println(via.echo("echo"))
    println(via.tagged())
    println(via.tagged(prefix = "named"))
    val reference: (Via<String>) -> String = Via<String>::get
    println(reference(via))
    val fromBase: Base<Int> = FromBase(Impl(42))
    println(fromBase.get())
    val child: Source<Int> = Child(Impl(43))
    println(child.echo(0))
    Shared.number = 9
    println(Default.number)
    val mixed: Number = Mixed(Default)
    mixed.number = 10
    println(mixed.number)
    println(Shared.number)
    println(Owner<Int>.number)
    Owner<Int>.number = 8
    println(Owner<Int>.number)
    println(Owner<String>.number)
}
