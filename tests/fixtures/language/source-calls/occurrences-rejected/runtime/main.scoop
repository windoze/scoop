package test
import test.dependency.api.configure
import test.dependency.api.callCount

fun verifyCalls(value: Boolean) { if (!value) { throw IllegalStateException() } }


fun main() {
    configure(false)
    verifyCalls(rejected())
    verifyCalls(callCount() == 0)
    configure(true)
    verifyCalls(rejected())
    verifyCalls(callCount() == 0)
}
