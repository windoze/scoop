interface Read { public fun read(): Int }
struct Empty()
struct Box<T>(val value: T) {
    override interface Read where T : Read {
        public override fun read(): Int = value.read()
    }
}
fun <T> unknown(value: Box<T>): Int = value.read()
fun absent(value: Box<Empty>): Int = value.read()

interface Value<X> { public fun get(): X }
open class Projected<T> {
    override interface Value<T.Companion> where T.Companion : ref {
        public open override fun get(): T.Companion = T.Companion
    }
}
fun <T> unknownProjection(value: Projected<T>): Any = value.get()
fun absentProjection(value: Projected<Empty>): Any = value.get()
interface DefaultRead { public fun defaultRead(): Int = 1 }
struct Defaults<T>(val value: T) {
    override interface DefaultRead where T : Read {}
}
fun <T> unknownDefault(value: Defaults<T>): Int = value.defaultRead()
fun absentDefault(value: Defaults<Empty>): Int = value.defaultRead()
fun main() {}
