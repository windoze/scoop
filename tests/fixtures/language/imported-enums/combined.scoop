package dev.example.consumer.enums

import dev.example.dependency.enums.Choice
import dev.example.dependency.enums.Flag
import dev.example.dependency.enums.Token
import dev.example.dependency.enums.make
import dev.example.dependency.enums.sum
import dev.example.dependency.enums.flag
import dev.example.dependency.enums.flagValue

public struct Carrier(val value: Choice, val marker: (Token, Token))
enum Wrapper { Empty, Wrapped(Choice, (Token, Token)) }

@NoGC public fun relay(value: Choice): Choice = value
@NoGC public fun relayFlag(value: Flag): Flag = value
@NoGC public fun test(): Long {
    val value = Carrier(make(53, 42), (Token(), Token()))
    val wrapped = Wrapper.Wrapped(relay(value.value), value.marker)
    val total = when (wrapped) { case Empty -> 0; case Wrapped(choice, _) -> sum(choice) }
    return total + sum(relay(make(17, -29))) + flagValue(relayFlag(flag())) - 1
}
