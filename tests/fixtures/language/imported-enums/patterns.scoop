package dev.example.consumer.enums

import dev.example.dependency.enums.Choice
import dev.example.dependency.enums.Packet
import dev.example.dependency.enums.Flag
import dev.example.dependency.enums.make
import dev.example.dependency.enums.empty
import dev.example.dependency.enums.packet
import dev.example.dependency.enums.flag

public typealias Selected = Choice

@NoGC public fun relay(value: Choice): Choice = value
@NoGC public fun score(value: Choice): Long = when (value) {
    case Selected.Empty -> 0
    case Selected.Pair { left, right, .. } if (left < 0) -> 0
    case Selected.Pair { left, right, .. } -> left + right
}
@NoGC public fun packetScore(value: Packet): Long = when (value) {
    case Missing -> 0
    case Data((left, _, right), _) -> left + right
}
@NoGC public fun flagScore(value: Flag): Long = when (value) {
    case Off -> 0
    case On -> 1
}
@NoGC public fun defaultScore(value: Choice, result: Long = when (value) {
    case Empty -> 0
    case Pair { left, right, .. } -> left + right
}): Long = result

@NoGC public fun test(): Long = score(relay(make(17, -29))) + packetScore(packet()) + defaultScore(empty()) + flagScore(flag()) - 1
