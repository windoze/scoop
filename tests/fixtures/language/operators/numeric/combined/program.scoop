struct Amount(val value: Int) : Sub<Int, Amount>, Mul<Int, Amount>, Compare<Amount>,
    Increment<Amount>, Decrement<Amount>, UnaryMinus<Amount>, Not<Boolean> {
    public override operator fun minus(other: Int): Amount = Amount(value - other)
    public override operator fun times(other: Int): Amount = Amount(value * other)
    public override operator fun compareTo(other: Amount): Long = value.compareTo(other.value)
    public override operator fun inc(): Amount = Amount(value + 1)
    public override operator fun dec(): Amount = Amount(value - 1)
    public override operator fun unaryMinus(): Amount = Amount(-value)
    public override operator fun not(): Boolean = value == 0
}
typealias Money = Amount
class Account(var current: Money) {
    var evaluations: Int = 0
    var reads: Int = 0
    var writes: Int = 0
    public operator fun get(index: Int): Money { reads += 1; return current }
    public operator fun set(index: Int, value: Money) { writes += 1; current = value }
}
fun <T : Sub<R, O>, R, O> subtract(a: T, b: R): O = a - b
fun <T> adjust(value: T): T where T : Increment<T>, T : Decrement<T> {
    var result = value;
    ++result
    result--
    return result
}
fun check(ok: Boolean) { if (!ok) { throw IllegalStateException() } }
fun main() {
    check(subtract(Money(10), 3).value == 7)
    check((Money(7) * 6).value == 42 && Money(7) < Money(8))
    check((-Money(7)).value == -7 && !Money(0))
    check(adjust(Money(42)).value == 42)
    val account = Account(Money(40))
    fun index(): Int { account.evaluations += 1; return 0 }
    check(account[index()]++.value == 40)
    check((++account[index()]).value == 42)
    check(account.current.value == 42 && account.reads == 2 && account.writes == 2 && account.evaluations == 2)
    val boxed: Any = Money(1)
    check(boxed is Sub<Int, Money> && boxed is Compare<Money>)
    println("operator combined")
}
