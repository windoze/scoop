package dev.m41.counters

public struct Counter(val value: Int) : Increment<Counter>, Decrement<Counter>, Compare<Counter> {
    @NoGC public override operator fun inc(): Counter = Counter(value + 1)
    @NoGC public override operator fun dec(): Counter = Counter(value - 1)
    @NoGC public override operator fun compareTo(other: Counter): Long = value.compareTo(other.value)
}
public fun <T : Increment<T>> next(value: T): T {
    var result = value;
    ++result
    return result
}
public fun <T> product(left: T, right: T): T where T : Mul<T, T> = left * right
