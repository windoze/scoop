package dev.m45
import scoop.platform.concurrent.Thread
import scoop.platform.io.*
import scoop.platform.memory.NativeByteBuffer
import scoop.platform.net.*
import scoop.platform.system.*

@Extern(name = "m45_network_callback") private fun setCallback(function: FunPtr<(Ptr<Unit>) -> Int>, context: Ptr<Unit>)
@Extern(name = "m45_network_clear_callback") private fun clearCallback()
@GCLeaf @Extern(name = "m45_network_flags") private fun flags(value: Int)
@GCLeaf @Extern(name = "m45_network_descriptors") private fun descriptors(): Int
@GCLeaf @Extern(name = "m45_network_resolutions") private fun resolutions(): Int
@GCLeaf @Extern(name = "m45_network_eai_system") private fun systemError(): Int
@GCLeaf @Extern(name = "m45_network_eai_noname") private fun nameError(): Int
@Extern(name = "m45_network_signal_setup") private fun signalSetup()
@Extern(name = "m45_network_signal_restore") private fun signalRestore()

private fun verify(value: Boolean, location: SourceLocation = currentSourceLocation()) {
    if (!value) {
        eprintln("network assertion failed at line " + location.line.toString())
        throw IllegalStateException()
    }
}
private fun fails(location: SourceLocation = currentSourceLocation(), body: () -> Unit): PlatformException {
    try { body() } catch (error: PlatformException) { return error }
    eprintln("expected network failure at line " + location.line.toString())
    throw IllegalStateException(Some("expected network failure"))
}
private fun loopback(): SocketAddress = SocketAddress(IpAddress.IPV4_LOOPBACK, 0)

private fun rollback() {
    for (failure in [1, 2, 4]) {
        @Unsafe { flags(failure) }
        fails { UdpSocket.bind(loopback()) }
        gcCollect()
        @Unsafe { verify(descriptors() == 0) }
    }
    @Unsafe {
        flags(8192)
        val failure = fails { TcpStream.connect(loopback()) }
        verify(failure.kind == PlatformErrorKind.ConnectionRefused && descriptors() == 0)
    }
    val socket = UdpSocket.bind(loopback())
    @Unsafe { flags(4096) }
    verify(fails { socket.dispose() }.kind == PlatformErrorKind.Interrupted)
    socket.dispose()
    gcCollect()
    @Unsafe { verify(descriptors() == 0) }
}

private fun resolutionErrors() {
    @Unsafe {
        val before = resolutions()
        flags(512)
        val system = fails { resolve("127.0.0.1", 80) }
        verify(system.kind == PlatformErrorKind.PermissionDenied)
        verify(system.nativeError!!.domain == NativeErrorDomain.AddressResolution)
        verify(system.nativeError!!.code == systemError() && system.nativeError!!.systemCode == Some(13))
        flags(1024)
        val name = fails { resolve("127.0.0.1", 80) }
        verify(name.nativeError!!.code == nameError() && name.nativeError!!.systemCode == None)
        verify(resolutions() == before)
        val addresses = resolve("127.0.0.1", 4321)
        verify(addresses.size > 0L && addresses[0L] == SocketAddress(IpAddress.IPV4_LOOPBACK, 4321))
        verify(resolutions() == before + 1)
    }
}

private fun temporaryWrite(address: SocketAddress) { TcpStream.connect(address).writeText("short transfer") }
private fun temporaryAccept() {
    @Unsafe { flags(64 + 128 + 32) }
    TcpListener.bind(loopback()).accept().use { verify(it.readText() == "peer") }
}

private fun streamOwnership() {
    temporaryAccept()
    gcCollect()
    @Unsafe { verify(descriptors() == 0) }
    TcpListener.bind(loopback()).use { listener ->
        Thread.start { listener.accept().use { verify(it.readText() == "short transfer") } }.use {
            @Unsafe { flags(8 + 2048) }
            temporaryWrite(listener.localAddress())
            gcCollect()
        }
    }
    gcCollect()
    @Unsafe { flags(0); verify(descriptors() == 0) }
    TcpListener.bind(loopback()).use { listener ->
        Thread.start { listener.accept().use { it.readAllBytes() } }.use {
            TcpStream.connect(listener.localAddress()).use { stream ->
                stream.shutdownOutput()
                verify(fails { stream.writeText("closed") }.kind == PlatformErrorKind.BrokenPipe)
            }
        }
    }
}

private fun temporaryReceive(buffer: NativeByteBuffer) {
    @Unsafe { flags(16 + 256) }
    val packet = UdpSocket.bind(loopback()).receiveFrom(buffer)
    verify(packet.count == 3L && packet.truncated && packet.source.port > 0)
    verify(OsString.fromByteArray(buffer.readBytes(3L)).decodeUtf8() == "abc")
}
private fun temporarySend(address: SocketAddress, buffer: NativeByteBuffer) {
    @Unsafe { flags(8) }
    verify(UdpSocket.bind(loopback()).sendTo(buffer, address) == 3L)
}
private fun datagramOwnership() {
    NativeByteBuffer.allocate(3L).use { buffer ->
        temporaryReceive(buffer)
        gcCollect()
        @Unsafe { verify(descriptors() == 0) }
        UdpSocket.bind(loopback()).use { receiver ->
            buffer.clear()
            buffer.writeBytes(Array<Byte>(3L) { (it + 1L).toByte() })
            temporarySend(receiver.localAddress(), buffer)
            gcCollect()
            @Unsafe { verify(descriptors() == 1) }
            buffer.clear()
            val packet = receiver.receiveFrom(buffer)
            verify(packet.count == 3L && !packet.truncated && buffer.readByte() == 1.toByte())
        }
    }
}

fun main() {
    @Unsafe {
        signalSetup()
        val callback = foreignCallback<(Ptr<Unit>) -> Int>({ gcCollect(); 0 }, 0, ForeignCallbackMode.Reusable)
        setCallback(callback.function, callback.context)
        try {
            rollback()
            resolutionErrors()
            streamOwnership()
            datagramOwnership()
            gcCollect()
            verify(descriptors() == 0)
            verify(when (foreignCallbackFailure(callback)) { case None -> true; case Some(_) -> false })
        } catch (error: Exception) {
            eprintln(error.message ?: "network native failure")
            throw error
        } finally { clearCallback(); releaseForeignCallback(callback); signalRestore() }
    }
    println("network ownership, native errors and SIGPIPE passed")
}
