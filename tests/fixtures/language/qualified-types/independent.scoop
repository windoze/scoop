package dev.example.consumer.paths

import dev.example.facade.paths.Point
import dev.example.facade.paths.IntBox
import dev.example.facade.paths.Outer
import dev.example.dependency.paths.Outer.marker

public fun <T> exercise(value: T): Int {
    val point = Point(40)
    val box = IntBox(2)
    val nested = Outer.Nested(point.number + box.value)
    return nested.number + marker()
}

private class Later()
public fun check(): Int = exercise<Later>(Later())
