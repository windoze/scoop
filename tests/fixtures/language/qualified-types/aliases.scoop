package dev.example.consumer.paths

import dev.example.dependency.paths.IntBox
import dev.example.dependency.paths.IntPointer

public typealias Again = dev.example.dependency.paths.IntPointer
public typealias BoxAlias = dev.example.dependency.paths.IntBox

public fun <T> exercise(value: T): Int {
    var number = 40
    val box: dev.example.dependency.paths.IntBox = IntBox(2)
    @Unsafe {
        val raw = addressOf(number).toULong()
        val first: dev.example.dependency.paths.IntPointer = IntPointer(raw)
        val second = Again(raw)
        first.store(second.load() + box.value)
    }
    return number
}

public fun result(): Int = exercise<Int>(0)
