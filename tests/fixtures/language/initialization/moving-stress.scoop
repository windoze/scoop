open class MovingBase(val base: String) {
    val baseCopy: String = "base-copy-" + base

    init {
        gcCollect()
        println(base)
        println(baseCopy)
    }
}

class MovingDerived(seed: String) : MovingBase("base-" + seed) {
    val self: MovingDerived = this
    val state: OwnedState = makeState("state-" + seed)
    val readLater: () -> String = { this.derived }
    val target: () -> String = this::read
    val derived: String = "derived-" + seed

    init {
        gcCollect()
        println(derived)
    }

    constructor(seed: String, secondary: String) : this(seed) {
        gcCollect()
        println(secondary)
        println(base)
        println(derived)
    }

    fun verify(): Boolean = this is MovingDerived
    fun makeState(value: String): OwnedState = OwnedState(this, value)
    fun read(): String = derived
}

class OwnedState(val owner: MovingDerived, val value: String) {
    init { gcCollect() }
}

var retained: Failed? = None

class Failed(seed: String) {
    val ready: String = "retained-" + seed

    init {
        retained = Some(this)
        gcCollect()
        throw UnwrapException()
    }

    val later: String = "not reached"
}

fun main() {
    val moving = MovingDerived("seed", "secondary-alive")
    gcCollect()
    println(moving.base)
    println(moving.baseCopy)
    println(moving.derived)
    println(moving.verify())
    println(moving.self === moving)
    println(moving.state.owner === moving)
    println(moving.state.value)
    println(moving.readLater())
    println(moving.target())

    try {
        val failed = Failed("seed")
    } catch (error: UnwrapException) {
        gcCollect()
        println(retained!!.ready)
    }
    retained = None
}
