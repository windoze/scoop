package dev.m37.bridge
public import dev.m37.references.*
public fun <T> relay(value: T) = read(make(value))
public fun <T> forwarded(value: T) = references(value)
public val virtualRead = Base::read
public val interfaceRead = Reading::read
public val words = ::Words
public val readWords = Words::read
public val plain: (String) -> Plain = ::Plain
public val empty: () -> Plain = ::Plain
public val pair = ::Pair
