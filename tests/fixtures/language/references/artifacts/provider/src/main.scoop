package dev.m37.references
public class Box<T> public constructor(public val value: T) {
    public fun read() = value
    public fun <U> choose(other: U) = other
}
public typealias Words = Box<String>
public interface Reading { public fun read(): Int }
public open class Base public constructor(): Reading {
    public override open fun read() = 1
}
public class Child public constructor(): Base() {
    public override fun read() = 42
}
public fun <T> make(value: T, construct: (T) -> Box<T> = ::Box) = construct(value)
public fun <T> read(box: Box<T>, operation: (Box<T>) -> T = Box<T>::read) = operation(box)
public val construct: (Int) -> Box<Int> = ::Box
public val member = Box<Int>::read
public fun <T> references(value: T): T {
    val make: (T) -> Box<T> = ::Box
    val read: (Box<T>) -> T = Box<T>::read
    return read(make(value))
}
public class Plain public constructor(public val text: String) {
    public constructor(): this("secondary") {}
}
public struct Pair(val left: Int, val right: Int)
