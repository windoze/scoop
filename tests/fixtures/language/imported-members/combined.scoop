package dev.example.consumer.members

import dev.example.dependency.members.Token
import dev.example.dependency.members.Wide
import dev.example.dependency.members.Managed
import dev.example.dependency.members.Nested
import dev.example.dependency.members.defaultField
import dev.example.dependency.members.defaultMember
import dev.example.dependency.members.defaultProperty
import dev.example.dependency.members.defaultMarker

public typealias Payload = Wide
public struct Container(val marker: Token, val payload: Payload)

@NoGC public fun keepToken(value: Token): Token = value.sameToken()
@NoGC public fun keepWide(value: Payload): Wide {
    val copy = value.copyWide(other = value)
    return value + copy.copyWide()
}
@NoGC public fun total(value: Payload): Long = value.total() + 7
@NoGC public fun fieldSum(value: Payload): Long = value.copyWide().first + value.second + value.third + 7
@NoGC public fun computedTotal(value: Payload): Long = value.copyWide().calculated + 7
public fun keepManaged(value: Managed): Managed = value.sameManaged()
public fun text(value: Managed): String = value.text
@NoGC public fun marker(value: Nested): Token = value.marker
@NoGC public fun nestedFirst(value: Nested): Long = value.value.first

public val Wide.first: Long
    @NoGC get() = 999

@NoGC public fun first(value: Wide): Long = value.first

@NoGC public fun fromField(value: Wide): Long = defaultField(value.copyWide())
@NoGC public fun fromMember(value: Wide): Long = defaultMember(value = value.copyWide())
@NoGC public fun fromProperty(value: Wide): Long = defaultProperty(value.copyWide())
@NoGC public fun fromMarker(value: Nested): Token = defaultMarker(value)

@NoGC public fun republished(value: Wide, selected: Long = value.copyWide().first): Long = selected
