package dev.example.consumer.members

import dev.example.templates.members.*

public fun result(): Int {
    val holder = PropertyItem<Int>(20)
    holder.extensionState = 42
    return holder.extensionState
}

public fun <T> make(value: T): T {
    val holder = PropertyItem<T>(value)
    holder.extensionState = value
    return holder.extensionState
}
