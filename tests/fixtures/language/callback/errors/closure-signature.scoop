fun suspendClosure() {
    @Unsafe {
        foreignCallback<(Int, Ptr<Unit>) -> Int>(
            suspend { 0 },
            1,
            ForeignCallbackMode.Reusable
        )
    }
}

fun parameterMismatch() {
    @Unsafe {
        foreignCallback<(Int, Ptr<Unit>) -> Int>(
            { value: String -> 0 },
            1,
            ForeignCallbackMode.Reusable
        )
    }
}

fun returnMismatch() {
    @Unsafe {
        foreignCallback<(Int, Ptr<Unit>) -> Int>(
            { value: Int -> "wrong" },
            1,
            ForeignCallbackMode.Reusable
        )
    }
}

fun main() {}
