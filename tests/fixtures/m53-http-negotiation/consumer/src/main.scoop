import scoop.bytes.ByteArrayBuilder
import scoop.http.*
import scoop.platform.memory.NativeByteBuffer

fun check(value: Boolean) { if (!value) throw IllegalStateException(Some("HTTP negotiation failed")) }

fun transfer(from: Http2Session, to: Http2Session): Long {
    val buffer = NativeByteBuffer.allocate(3L)
    var total = 0L
    try {
        while (true) {
            buffer.clear()
            val count = from.takeOutput(buffer)
            if (count == 0L) return total
            check(to.receive(buffer) == count)
            total += count
        }
    } finally { buffer.close() }
}

fun drive(client: Http2Session, server: Http2Session) {
    while (true) {
        val request = transfer(client, server)
        val response = transfer(server, client)
        if (request == 0L && response == 0L) return
    }
}

fun main() {
    check(selectHttpAlpn(Some("h2".toByteArray()), [HttpProtocol.Http2]) == HttpProtocol.Http2)
    try { selectHttpAlpn(None, [HttpProtocol.Http2]); throw IllegalStateException() }
    catch (error: HttpNegotiationException) { check(error.operation == "select ALPN") }
    val probe = HttpCleartextProbe([HttpProtocol.Http1, HttpProtocol.Http2])
    NativeByteBuffer.allocate(32L).use { input ->
        input.writeBytes("POST / HTTP/1.1\r\n".toByteArray())
        check(probe.receive(input) == 2L)
        check(probe.protocol == Some(HttpProtocol.Http1) && String.fromUtf8(probe.prefix) == "PO")
    }
    val offer = prepareHttp2Upgrade(HttpRequestHead(HttpVersion.Http11, "GET".toByteArray(),
        HttpRequestTarget.Http1("/upgrade".toByteArray())))
    check(http2UpgradeAccepted(http2UpgradeResponse()))
    val client = Http2Session.upgradedClient(offer.method)
    val server = Http2Session.upgradedServer(offer.method, readHttp2UpgradeSettings(offer))
    try {
        drive(client, server)
        gcCollect()
        server.submitResponse(1, HttpResponseHead(HttpVersion.Http2, 200U), false)
        NativeByteBuffer.allocate(2L).use { body -> body.writeBytes("42".toByteArray()); check(server.writeBody(1, body) == 2L) }
        server.finish(1)
        drive(client, server)
        val body = ByteArrayBuilder()
        var done = false
        while (!done) {
            val next = client.nextEvent()
            when (next) {
                case None -> done = true
                case Some(_) -> when (next!!) {
                    case Data(id, bytes) -> { body.append(bytes); client.consume(id, bytes.size) }
                    case Failure(error) -> throw error
                    else -> {}
                }
            }
        }
        check(String.fromUtf8(body.toByteArray()) == "42")
        check(client.submitRequest(HttpRequestHead(HttpVersion.Http2, "GET".toByteArray(),
            HttpRequestTarget.Http2("http".toByteArray(), "example.test".toByteArray(), "/next".toByteArray()))) == 3)
        println(String.fromUtf8(body.toByteArray()))
    } finally { server.close(); client.close() }
}
