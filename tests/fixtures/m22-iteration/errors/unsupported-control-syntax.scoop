// EXPECT-DIAGNOSTICS

fun labelledBreak() {
    break@outer
}

fun labelledContinue() {
    continue@outer
}

fun labelledWhile() {
    outer@ while (true) {}
}

fun labelledFor(values: Array<Int>) {
    outer@ for (value in values) {}
}

fun breakExpression(value: Int?) {
    val selected = value ?: break
}

fun consume(value: Int) {}

fun continueExpression() {
    consume(continue)
}

fun main() {}
