package profiles.provider

public interface Reader { public suspend fun read(): Int }
public struct Value(val value: Int) : Reader {
    public override suspend fun read(): Int = increment(value)
}
public suspend fun increment(value: Int): Int { gcCollect(); return value + 1 }
public suspend fun delayed(registration: SuspendRegistration<Int>): Int = suspendCoroutine(registration)
public suspend fun forwarded(registration: SuspendRegistration<Int>): Int = delayed(registration)
