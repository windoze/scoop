fun verifyDefault(value: Boolean) { if (!value) { throw IllegalStateException() } }


fun main() {
    val child = defaultGenericChild<Int>()
    verifyDefault(child.choose((3, 4)) == (3, 4))
    val parent: GenericParent<(Int, Int)> = child
    verifyDefault(parent.choose((5, 6)) == (5, 6))
    verifyDefault(child.choose((3, 4), value = (7, 8)) == (7, 8))
    verifyDefault(defaultGenericChild<String>().choose(("a", "b")) == ("a", "b"))
}
