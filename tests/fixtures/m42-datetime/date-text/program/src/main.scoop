import scoop.datetime.*

fun check(ok: Boolean) { if (!ok) throw IllegalStateException() }
fun rejectDate(text: String) {
    check(LocalDate.parseOrNone(text) == None)
    var failed = false
    try { LocalDate.parse(text) } catch (error: IllegalArgumentException) { failed = true }
    check(failed)
}
fun rejectMonth(text: String) {
    check(YearMonth.parseOrNone(text) == None)
    var failed = false
    try { YearMonth.parse(text) } catch (error: IllegalArgumentException) { failed = true }
    check(failed)
}
fun main() {
    check(LocalDate.MIN.toString() == "-999999999-01-01")
    check(LocalDate.MAX.toString() == "+999999999-12-31")
    check(LocalDate(0, 1, 1).toString() == "0000-01-01")
    check(LocalDate(-1, 12, 31).toString() == "-0001-12-31")
    check(LocalDate(9999, 1, 1).toString() == "9999-01-01")
    check(LocalDate(10000, 1, 1).toString() == "+10000-01-01")
    check(LocalDate.parse("+00010000-01-01") == LocalDate(10000, 1, 1))
    check(LocalDate.parse("-000000001-02-03") == LocalDate(-1, 2, 3))
    check(YearMonth.parse("-0001-12").toString() == "-0001-12")
    check(YearMonth.parse("+10000-01") == YearMonth(10000, 1))
    val dates = ArrayList<String>()
    dates.add(""); dates.add("2024-1-01"); dates.add("2024-01-1"); dates.add("2024/01/01")
    dates.add("2023-02-29"); dates.add("1900-02-29"); dates.add("2024-00-01"); dates.add("2024-13-01")
    dates.add("2024-01-00"); dates.add("2024-04-31"); dates.add("2024-01-01Z"); dates.add(" 2024-01-01")
    dates.add("2024-01-01 "); dates.add("+2024-01-01"); dates.add("-0000-01-01"); dates.add("-001-01-01")
    dates.add("10000-01-01"); dates.add("+1000000000-01-01"); dates.add("-1000000000-01-01")
    dates.add("2024-０1-01"); dates.add("2024-01-01\u{0}"); dates.add("999999999999999999999-01-01")
    for (text in dates) rejectDate(text)
    val months = ArrayList<String>()
    months.add(""); months.add("2024-1"); months.add("2024-13"); months.add("2024-01-01")
    months.add("+2024-01"); months.add("-0000-01"); months.add("10000-01"); months.add("+1000000000-01")
    months.add("2024-01 "); months.add("2024/01"); months.add("2024-０1")
    for (text in months) rejectMonth(text)
    println("date-text passed")
}
