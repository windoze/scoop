import scoop.datetime.*
import scoop.time.*
import scoop.collections.*

fun check(ok: Boolean) { if (!ok) throw IllegalStateException() }
fun invalid(block: () -> Unit) {
    var failed = false
    try { block() } catch (error: IllegalArgumentException) { failed = true }
    check(failed)
}
fun overflow(block: () -> Unit) {
    var failed = false
    try { block() } catch (error: ArithmeticException) { failed = true }
    check(failed)
}
class FakeClock : Clock {
    var calls: Int = 0
    public override fun now(): Instant { calls += 1; return Instant.fromEpochSeconds(-calls.toLong()) }
}
fun main() {
    val epoch = Instant.fromEpochSeconds(0L)
    check(epoch.toString() == "1970-01-01T00:00:00Z")
    check(Instant.fromEpochSeconds(1L, -1000000001L) == epoch - 1.nanoseconds())
    check(Instant.fromEpochSeconds(0L, Long.MIN_VALUE) == epoch + Duration.nanoseconds(Long.MIN_VALUE))
    check(Instant.fromEpochSeconds(0L, Long.MAX_VALUE) == epoch + Duration.nanoseconds(Long.MAX_VALUE))
    check((epoch - 1.nanoseconds()).toEpochMilliseconds() == -1L)
    check(Instant.fromEpochMilliseconds(-1L).toString() == "1969-12-31T23:59:59.999Z")
    check(Instant.fromEpochMilliseconds(Long.MIN_VALUE).toEpochMilliseconds() == Long.MIN_VALUE)
    check(Instant.fromEpochMilliseconds(Long.MAX_VALUE).toEpochMilliseconds() == Long.MAX_VALUE)
    check((Instant.fromEpochMilliseconds(Long.MAX_VALUE) + 999999.nanoseconds()).toEpochMilliseconds() == Long.MAX_VALUE)
    overflow { (Instant.fromEpochMilliseconds(Long.MIN_VALUE) - 1.nanoseconds()).toEpochMilliseconds() }
    overflow { (Instant.fromEpochMilliseconds(Long.MAX_VALUE) + 1.milliseconds()).toEpochMilliseconds() }
    overflow { Instant.MIN.toEpochMilliseconds() }; overflow { Instant.MAX.toEpochMilliseconds() }
    check(Instant.MIN.toString() == "-999999999-01-01T00:00:00Z")
    check(Instant.MAX.toString() == "+999999999-12-31T23:59:59.999999999Z")
    check(Instant.parse(Instant.MIN.toString()) == Instant.MIN && Instant.parse(Instant.MAX.toString()) == Instant.MAX)
    check(Instant.MIN + (Instant.MAX - Instant.MIN) == Instant.MAX)
    check(Instant.MAX - (Instant.MAX - Instant.MIN) == Instant.MIN)
    check(Instant.fromEpochSeconds(Instant.MIN.epochSeconds - 1L, 1000000000L) == Instant.MIN)
    check(Instant.fromEpochSeconds(Instant.MAX.epochSeconds + 1L, -1L) == Instant.MAX)
    invalid { Instant.fromEpochSeconds(Long.MIN_VALUE) }; invalid { Instant.fromEpochSeconds(Long.MAX_VALUE) }
    invalid { Instant.fromEpochSeconds(Instant.MIN.epochSeconds, -1L) }
    invalid { Instant.fromEpochSeconds(Instant.MAX.epochSeconds, 1000000000L) }
    overflow { Instant.MIN - 1.nanoseconds() }; overflow { Instant.MAX + 1.nanoseconds() }
    overflow { epoch + Duration.seconds(Long.MIN_VALUE) }; overflow { epoch - Duration.seconds(Long.MIN_VALUE) }
    overflow { Instant.MIN.toLocalDateTime(UtcOffset.fromTotalSeconds(-1)) }
    overflow { Instant.MAX.toLocalDateTime(UtcOffset.fromTotalSeconds(1)) }
    check(Instant.parse("1970-01-01T00:00:00+00:00:01") == epoch - 1.seconds())
    check(Instant.parse("1969-12-31T23:59:59-00:00:01") == epoch)
    check(Instant.parse("1970-01-01T18:00:00+18:00") == epoch)
    check(Instant.parse("1969-12-31T06:00:00-18:00") == epoch)
    check(hashMapOf((epoch, 1))[Instant.parse("1970-01-01T00:00:00Z")] == Some(1))
    check(epoch < epoch + 1.nanoseconds())
    val bad = ArrayList<String>()
    bad.add("1970-01-01T00:00:00"); bad.add("2016-12-31T23:59:60Z")
    bad.add("-999999999-01-01T00:00:00+00:00:01"); bad.add("+999999999-12-31T23:59:59.999999999-00:00:01")
    for (text in bad) { check(Instant.parseOrNone(text) == None); invalid { Instant.parse(text) } }
    val clock = FakeClock()
    val first = clock.now()
    val second = clock.now()
    check(second < first && first - second == 1.seconds() && clock.calls == 2)
    println("instant passed")
}
