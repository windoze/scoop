import scoop.datetime.*
import scoop.time.*
import scoop.collections.*

fun check(ok: Boolean) { if (!ok) throw IllegalStateException() }
fun invalid(block: () -> Unit) {
    var failed = false
    try { block() } catch (error: IllegalArgumentException) { failed = true }
    check(failed)
}
fun main() {
    val midnight = LocalTime(0, 0)
    val last = LocalTime(23, 59, 59, 999999999)
    check(midnight.toNanosecondOfDay() == 0L && last.toNanosecondOfDay() == 86399999999999L)
    check(LocalTime.fromNanosecondOfDay(86399999999999L) == last)
    check(last + 1.nanoseconds() == midnight && midnight - 1.nanoseconds() == last)
    check(LocalTime(12, 30, 45, 123456789) + 7.days() == LocalTime(12, 30, 45, 123456789))
    check(midnight + Duration.seconds(Long.MIN_VALUE) == LocalTime(8, 29, 52))
    check(midnight - Duration.seconds(Long.MIN_VALUE) == LocalTime(15, 30, 8))
    check(midnight + Duration.seconds(Long.MAX_VALUE, 999999999L) == LocalTime(15, 30, 7, 999999999))
    check(midnight - Duration.seconds(Long.MAX_VALUE, 999999999L) == LocalTime(8, 29, 52, 1))
    check(midnight + Duration.seconds(-1L, 1L) == LocalTime(23, 59, 59, 1))
    check(midnight < last && hashMapOf((LocalTime(1, 2, 3), 4))[LocalTime(1, 2, 3)] == Some(4))
    check(LocalTime.parse("01:02:03.100000000").toString() == "01:02:03.1")
    check(LocalTime.parse("01:02:03.000000001") == LocalTime(1, 2, 3, 1))
    check(LocalTime.parse("01:02:03.000").toString() == "01:02:03")
    check(LocalTime.parse(last.toString()) == last && midnight.toString() == "00:00:00")
    val bad = ArrayList<String>()
    bad.add(""); bad.add("01:02"); bad.add("1:02:03"); bad.add("01:2:03"); bad.add("01:02:3")
    bad.add("24:00:00"); bad.add("23:59:60"); bad.add("00:60:00"); bad.add("-1:00:00")
    bad.add("01:02:03."); bad.add("01:02:03.1234567890"); bad.add("01:02:03,1")
    bad.add("01:02:03Z"); bad.add("01:02:03+00:00"); bad.add("01:02:03 ")
    bad.add("０1:02:03"); bad.add("01:02:03.1x"); bad.add("2024-01-01T01:02:03")
    for (text in bad) { check(LocalTime.parseOrNull(text) == None); invalid { LocalTime.parse(text) } }
    invalid { LocalTime(24, 0) }; invalid { LocalTime(-1, 0) }
    invalid { LocalTime(0, -1) }; invalid { LocalTime(0, 60) }
    invalid { LocalTime(0, 0, -1) }; invalid { LocalTime(0, 0, 60) }
    invalid { LocalTime(0, 0, 0, -1) }; invalid { LocalTime(0, 0, 0, 1000000000) }
    invalid { LocalTime.fromNanosecondOfDay(-1L) }; invalid { LocalTime.fromNanosecondOfDay(86400000000000L) }
    invalid { LocalTime.fromNanosecondOfDay(Long.MAX_VALUE) }
    println("local-time passed")
}
