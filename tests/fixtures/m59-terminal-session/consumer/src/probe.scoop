import scoop.terminal.*
import scoop.terminal.screen.SetTitle

fun check(value: Boolean, message: String = "terminal session assertion failed") {
    if (!value) {
        eprintln(message)
        throw IllegalStateException(Some(message))
    }
}

fun acknowledge() {
    @Unsafe { check(nativeWaitAck() == 0, "acknowledgement read failed") }
    gcCollect()
}

fun stage(session: TerminalSession, name: String) {
    session.execute(SetTitle(name))
    acknowledge()
}

fun inputNonblocking(): Int { @Unsafe { return nativeInputNonblocking() } }
fun redirect() { @Unsafe { check(nativeRedirect() == 0) } }
fun restore() { @Unsafe { check(nativeRestore() == 0, "restore standard streams failed") } }

@Extern(name = "m59_stdin_nonblocking")
private fun nativeInputNonblocking(): Int
@Extern(name = "m59_wait_ack")
private fun nativeWaitAck(): Int
@Extern(name = "m59_redirect")
private fun nativeRedirect(): Int
@Extern(name = "m59_restore")
private fun nativeRestore(): Int
