import scoop.asyncio.*
import scoop.bytes.ByteArrayBuilder
import scoop.http.*
import scoop.platform.memory.NativeByteBuffer
import scoop.text.endsWith

suspend fun serveWebSocket(peer: AsyncByteStream) {
    val request = decodeRequest(awaitHead(peer))
    val handshake = WebSocketHandshake.parse(request)
    check(when (request.target) { case Http1(bytes) -> String.fromUtf8(bytes) == "/chat?x=%2F"; else -> false })
    check(String.fromUtf8(request.fields.findAll("Host".toByteArray())[0L].value) == "xn--bcher-kva.example")
    val response = handshake.response(Some("chat"), Some(WebSocketDeflate(true, false, Some(10), Some(9))))
    val output = ByteArrayBuilder().append(encodeResponse(response))
    output.append([130.toByte(), 3.toByte(), 115.toByte(), 114.toByte(), 118.toByte()])
    sendBytes(peer, output.toByteArray())
    checkBytes(awaitBytes(peer, 6L), [137.toByte(), 128.toByte(), 1.toByte(), 2.toByte(), 3.toByte(), 4.toByte()])
    sendBytes(peer, [136.toByte(), 0.toByte()])
}

private suspend fun awaitHead(source: AsyncByteSource): Array<Byte> {
    val result = ByteArrayBuilder()
    return NativeByteBuffer.allocate(512L).use suspend { buffer ->
        while (result.size < 4096L) {
            buffer.clear()
            val count = source.readInto(buffer, 512L)
            check(count > 0L)
            result.append(buffer.readBytes(count))
            val bytes = result.toByteArray()
            if (String.fromUtf8(bytes).endsWith("\r\n\r\n")) return@use bytes
        }
        throw IllegalStateException(Some("unexpected fixture request size"))
    }
}

suspend fun sendBytes(sink: AsyncByteSink, bytes: List<Byte>) {
    NativeByteBuffer.allocate(bytes.size).use suspend { buffer -> buffer.writeBytes(bytes); sink.writeFully(buffer) }
}

suspend fun awaitBytes(source: AsyncByteSource, count: Long): Array<Byte> =
    NativeByteBuffer.allocate(count).use suspend { buffer -> source.readFully(buffer, count); buffer.readBytes(count) }

fun checkBytes(actual: Array<Byte>, expected: List<Byte>) {
    check(actual.size == expected.size)
    var index = 0L
    while (index < actual.size) { check(actual[index] == expected[index]); index += 1L }
}
