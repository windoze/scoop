// EXPECT: pass
// 目标：T0712 单态化（monomorphization）：`id(1)` 与 `id("s")` 生成两个实例。
// 备注：当前后端仍以“最小 main（ret 0）”为主，因此该 fixture 目前只作为：
// - 前端检查（parse/resolve/typecheck）能通过的回归；
// - `scoop run`/run-pass phase 的 smoke（能编译 + 能执行）。

package fixtures.codegen

import scoop.core.*

fun id<T>(x: T): T {
    return x
}

// 说明：run-pass/codegen smoke 应覆盖真实可达的 monomorphized call site，而不是依赖未从
// `main` 可达的局部函数 body 仍被强制 codegen。
fun main(): Int {
    val a = id(1)
    val b = id("s")
    return 0
}
