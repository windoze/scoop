// Scoop stdlib（pure scoop）：math utilities v0
//
// 说明：
// - 本文件提供 Int 专用的基础数学操作（min/max）；`abs(Int)` 由 compiled sysroot core 提供，
//   以避免与 Float.abs intrinsic declaration 同 FQN overload 互相遮蔽。
// - 不使用 Int/String 字面量（跨文件 codegen 限制）；零值通过 `sizeOf` 派生。

package scoop.core

/// 返回两个 Int 中较小的值。
fun min(a: Int, b: Int): Int {
    var result: Int = a
    when (a <= b) {
        true -> { result = a }
        false -> { result = b }
    }
    return result
}

/// 返回两个 Int 中较大的值。
fun max(a: Int, b: Int): Int {
    var result: Int = a
    when (a >= b) {
        true -> { result = a }
        false -> { result = b }
    }
    return result
}
