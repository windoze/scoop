// Scoop stdlib（pure scoop）：迭代协议与桥接 helper（early stage）
//
// 目标（TODO T1325c）：
// - 为满足 `Iterable/Iterator` 迭代协议的视图提供显式转换为 `Array` 的 helper（例如 `toArray()`），
//   以支持调用点 `*view.toArray()` 的 vararg spread 用例。
//
// 重要限制（当前阶段）：
// - 自定义 iterator 的 `for` lowering 已可执行，但 `toArray()` 的完整 collections 语义仍未单独落任务；
// - 因此这里先保留一个**可编译**的最小实现，避免 stdlib 注入后影响 `scoop build/run`。

package scoop.collections

import scoop.core.*

/// 把 `Iterable<Int>` 显式收集为 `Array<Int>`。
///
/// 说明：
/// - 该 helper 的主要用途是“调用点显式分配”：`f(*xs.toArray())`；
/// - 当前阶段先保证 API surface 可用（typecheck 可通过），并保持实现可编译。
fun IntIterable.toArray(): Array<Int> {
    // 最小实现：当前仍先返回空数组；真正的迭代收集逻辑会在后续 collections 任务中补齐。
    val empty: MutableArray<Int> = mutableArrayNew<Int>()
    return empty.freeze()
}
