// Scoop stdlib（pure scoop）：prelude v1
//
// 说明：
// - 本目录下的 `.scoop` 文件会被 driver 在 `scoop build/run` 时注入到编译单元（TODO T1315a）；
// - 早期阶段后端仍以“单源文件切片”读取字面量文本（Span -> SourceFile），因此这里尽量避免直接使用
//   数值/字符串字面量，防止跨文件 codegen 误读文本。

package scoop.core

// --- 内部：避免字面量的 Int 常量派生 ---

/// 生成 `0`（不使用字面量）。
fun __stdlib_int_zero(sample: Int): Int {
    val w: Int = sizeOf(sample)
    return w - w
}

/// 生成 `1`（不使用字面量）。
fun __stdlib_int_one(sample: Int): Int {
    val w: Int = sizeOf(sample)
    return w / w
}

// Kotlin-like preconditions（early stage）。
//
// 说明：
// - Kotlin 的 `require/check` 通常抛出不同异常类型；Scoop 0.1 当前阶段先复用 `Raise<RuntimeError>`
//   作为最小可执行落点；
// - 更精细的错误类型与 message（String）承载可在后续 `std` 任务中补齐。
fun require(condition: Bool): Unit / Raise<RuntimeError> {
    when (condition) {
        true -> ()
        false -> Raise.raise(RuntimeError.NullAssertionFailed)
    }
}

fun check(condition: Bool): Unit / Raise<RuntimeError> {
    when (condition) {
        true -> ()
        false -> Raise.raise(RuntimeError.ClassCastFailed)
    }
}

// Kotlin-like preconditions：lazy message variants（early stage）。
//
// 说明：
// - 当前 LLVM codegen 的顶层函数仍不支持同名 overload 的稳定 ABI/mangling，因此这里用不同函数名承载；
// - message 仅在失败分支求值（lazy），失败分支通过 `Raise<RuntimeError>` 抛出最小错误载体。
fun requireLazy(condition: Bool, lazyMessage: () -> Unit): Unit / Raise<RuntimeError> {
    when (condition) {
        true -> ()
        false -> {
            lazyMessage()
            Raise.raise(RuntimeError.NullAssertionFailed)
        }
    }
}

fun checkLazy(condition: Bool, lazyMessage: () -> Unit): Unit / Raise<RuntimeError> {
    when (condition) {
        true -> ()
        false -> {
            lazyMessage()
            Raise.raise(RuntimeError.ClassCastFailed)
        }
    }
}

// Kotlin-like scope functions（spec §11）。
//
// 说明：
// - 这些函数是库定义的（非编译器内建），用于提升示例可写性；
// - 它们应当是 effect-polymorphic：lambda body 中的 effects 会经 `<eff E>` 推断并传播到调用点；
// - v1 限制：当前阶段仅先对 `Int` 提供最小可执行落点；更完整的 `<T>` 泛型版本后续再补齐。
fun <eff E = Pure> Int.let(block: (Int) -> Int / E): Int / E {
    return block(this)
}

fun <eff E = Pure> Int.run(block: Int.() -> Int / E): Int / E {
    return block(this)
}

fun <eff E = Pure> Int.also(block: (Int) -> Unit / E): Int / E {
    block(this)
    return this
}

fun <eff E = Pure> Int.apply(block: Int.() -> Unit / E): Int / E {
    block(this)
    return this
}

// Kotlin-like ranges / progressions（Appendix B.12）与最小可惰性迭代（v0）。
//
// 说明：
// - 当前阶段后端 multi-file lowering 对“非入口文件的 Int/String 字面量”有门禁（见 T1315a），
//   因此这里避免引入任何 Int/String literal；range/progression 的默认 step（1/-1）由调用方显式传入。
// - v0 只提供 Int 专用落点（与 scope functions v1 一致），后续 `std` 再推广到泛型/其它标量类型。

// 注意：`IntProgression` 类型本身在 sysroot 中提供声明表面；stdlib 在此提供可执行实现。

/// 内部 helper：派生默认 range step（`1`），避免在 stdlib 中直接写 Int 字面量。
fun __scoop_range_default_step(sample: Int): Int {
    val word: Int = sizeOf(sample)
    return word / word
}

/// Kotlin-like：`start.rangeTo(endInclusive, step)`（v0：step 显式传入）。
fun Int.rangeTo(endInclusive: Int, step: Int): IntProgression {
    return IntProgression {
        first: this,
        last: endInclusive,
        step: step,
        increasing: true,
    }
}

/// Kotlin-like：`start.downTo(endInclusive, step)`（v0：step 显式传入）。
fun Int.downTo(endInclusive: Int, step: Int): IntProgression {
    return IntProgression {
        first: this,
        last: endInclusive,
        step: step,
        increasing: false,
    }
}

/// Kotlin-like：`start.until(endExclusive)`（exclusive end，默认 step = 1）。
fun Int.until(endExclusive: Int): IntProgression {
    val one: Int = __scoop_range_default_step(this)
    return this.rangeTo(endExclusive - one, one)
}

/// 最小迭代工具：`progression.forEach { ... }`（effect-polymorphic）。
fun <eff E = Pure> IntProgression.forEach(action: (Int) -> Unit / E): Unit / E {
    var cur: Int = this.first
    when (this.increasing) {
        true -> {
            while (cur <= this.last) {
                action(cur)
                cur = cur + this.step
            }
        }
        false -> {
            while (cur >= this.last) {
                action(cur)
                cur = cur - this.step
            }
        }
    }
    return ()
}
