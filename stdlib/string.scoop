// Scoop stdlib（pure scoop）：String 扩展方法
//
// T0122：将 runtime/c 的 substring 类函数替换为纯 Scoop 实现。
// 基于 T0120（byteLength/getByte）和 T0121（unsafeSliceBytes）构建。
//
// 重要限制：
// - LLVM 后端暂不支持 block 内 return/break/continue（需 function-level CFG）。
//   因此所有函数只在顶层使用一次 return；循环提前退出用 flag + 越界赋值模拟。
//   (T0141 已解除 return/break/continue 限制，但本文件尚未迁移利用。)
// - 非入口文件不可使用 source-backed literals（Int/String），常量通过 sizeOf 派生。
//   (T0140 已解除字面量限制，但本文件尚未迁移利用。)

package scoop.core

import scoop.core.*

// --- 内部：String 版 array builder（for split） ---

@Intrinsic
fun __scoop_array_builder_push_string(builder: Any, value: String): Unit

@Intrinsic
fun __scoop_array_builder_build_array_string(builder: Any): Array<String>

// --- 内部：常量派生（无字面量） ---

fun __string_zero(sample: Int): Int {
    val w: Int = sizeOf(sample)
    return w - w
}

fun __string_one(sample: Int): Int {
    val w: Int = sizeOf(sample)
    return w / w
}

fun __string_is_whitespace_byte(byte: Int): Bool {
    val eight: Int = sizeOf(byte)
    val one: Int = eight / eight
    val two: Int = one + one
    val four: Int = two + two
    val nine: Int = eight + one
    val thirteen: Int = nine + four
    val thirty_two: Int = eight * four
    val result: Bool = if (byte == thirty_two) { true }
        else if (byte >= nine) { if (byte <= thirteen) { true } else { false } }
        else { false }
    return result
}

// --- String 扩展方法 ---

fun String.substring(start: Int, end: Int): String {
    val len: Int = this.byteLength()
    val zero: Int = __string_zero(len)

    var s: Int = start
    if (s < zero) { s = zero }
    if (s > len) { s = len }

    var e: Int = end
    if (e < s) { e = s }
    if (e > len) { e = len }

    val sliceLen: Int = e - s
    return @Unsafe { this.unsafeSliceBytes(s, sliceLen) }
}

fun String.indexOf(substr: String): Int {
    val slen: Int = this.byteLength()
    val dlen: Int = substr.byteLength()
    val zero: Int = __string_zero(slen)
    val one: Int = __string_one(slen)
    val notFound: Int = zero - one

    var result: Int = notFound
    if (dlen <= zero) {
        result = zero
    } else if (dlen <= slen) {
        val limit: Int = slen - dlen
        var i: Int = zero
        while (i <= limit) {
            var j: Int = zero
            var matched: Bool = true
            while (j < dlen) {
                if (this.getByte(i + j) != substr.getByte(j)) {
                    matched = false
                    j = dlen
                }
                j = j + one
            }
            if (matched) {
                result = i
                i = limit + one
            } else {
                i = i + one
            }
        }
    }
    return result
}

fun String.contains(substr: String): Bool {
    val zero: Int = __string_zero(this.byteLength())
    return this.indexOf(substr) >= zero
}

fun String.startsWith(prefix: String): Bool {
    val slen: Int = this.byteLength()
    val plen: Int = prefix.byteLength()
    val zero: Int = __string_zero(slen)
    val one: Int = __string_one(slen)

    var result: Bool = true
    if (plen > slen) {
        result = false
    } else {
        var i: Int = zero
        while (i < plen) {
            if (this.getByte(i) != prefix.getByte(i)) {
                result = false
                i = plen
            }
            i = i + one
        }
    }
    return result
}

fun String.endsWith(suffix: String): Bool {
    val slen: Int = this.byteLength()
    val plen: Int = suffix.byteLength()
    val zero: Int = __string_zero(slen)
    val one: Int = __string_one(slen)

    var result: Bool = true
    if (plen > slen) {
        result = false
    } else {
        val offset: Int = slen - plen
        var i: Int = zero
        while (i < plen) {
            if (this.getByte(offset + i) != suffix.getByte(i)) {
                result = false
                i = plen
            }
            i = i + one
        }
    }
    return result
}

fun String.split(delimiter: String): Array<String> {
    val slen: Int = this.byteLength()
    val dlen: Int = delimiter.byteLength()
    val zero: Int = __string_zero(slen)
    val one: Int = __string_one(slen)

    val b: Any = __scoop_array_builder_new()

    if (slen <= zero) {
        val empty: String = @Unsafe { this.unsafeSliceBytes(zero, zero) }
        __scoop_array_builder_push_string(b, empty)
    } else if (dlen <= zero) {
        __scoop_array_builder_push_string(b, this)
    } else {
        var start: Int = zero
        var i: Int = zero
        val limit: Int = slen - dlen

        while (i <= limit) {
            var j: Int = zero
            var matched: Bool = true
            while (j < dlen) {
                if (this.getByte(i + j) != delimiter.getByte(j)) {
                    matched = false
                    j = dlen
                }
                j = j + one
            }

            if (matched) {
                val segLen: Int = i - start
                val seg: String = @Unsafe { this.unsafeSliceBytes(start, segLen) }
                __scoop_array_builder_push_string(b, seg)
                start = i + dlen
                i = start
            } else {
                i = i + one
            }
        }

        val tailLen: Int = slen - start
        val tail: String = @Unsafe { this.unsafeSliceBytes(start, tailLen) }
        __scoop_array_builder_push_string(b, tail)
    }

    return __scoop_array_builder_build_array_string(b)
}

fun String.trimStart(): String {
    val len: Int = this.byteLength()
    val zero: Int = __string_zero(len)
    val one: Int = __string_one(len)

    var start: Int = zero
    var scanning: Bool = true
    while (scanning) {
        if (start >= len) {
            scanning = false
        } else if (__string_is_whitespace_byte(this.getByte(start))) {
            start = start + one
        } else {
            scanning = false
        }
    }

    val sliceLen: Int = len - start
    return @Unsafe { this.unsafeSliceBytes(start, sliceLen) }
}

fun String.trimEnd(): String {
    val len: Int = this.byteLength()
    val zero: Int = __string_zero(len)
    val one: Int = __string_one(len)

    var end: Int = len
    var scanning: Bool = true
    while (scanning) {
        if (end <= zero) {
            scanning = false
        } else if (__string_is_whitespace_byte(this.getByte(end - one))) {
            end = end - one
        } else {
            scanning = false
        }
    }

    return @Unsafe { this.unsafeSliceBytes(zero, end) }
}

fun String.trim(): String {
    return this.trimStart().trimEnd()
}
