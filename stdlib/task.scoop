// Scoop stdlib（pure scoop）：Task/executor async adapters v0
//
// 目标（TODO T1320b）：
// - 在 stdlib 层为 `Task<Int>`/`Executor` 提供最小的组合子与桥接工具：
//   - `spawn`：create + tryStart
//   - `await`：驱动 executor 直到 task 完成（早期阶段的“阻塞式等待”）
//   - `map/andThen`：最小可组合工具，便于样例/fixtures 书写
//
// 重要限制（与其它 stdlib v1 一致）：
// - 由于 LLVM 后端 multi-file lowering 仍会拒绝“非入口文件中的 source-backed literals”，
//   本文件中避免出现任何 Int/String 字面量；所需常量通过 `sizeOf(Int)` 派生得到。

package scoop.task

import scoop.core.*

// 说明：
// - sysroot 与 stdlib 属于不同 cone；在 resolver 的最小规则下，跨 cone 的声明需要通过 import 引入；
// - 这里显式 `import scoop.task.*`，用于把 sysroot 中的 `taskCreate/Task.tryStart/...` 置于可见范围。
import scoop.task.*

/// bridge：创建并尝试 start 一个 task（lazy body 入队到 executor）。
///
/// 说明：
/// - `spawn` 只负责把 body 入队；真正执行仍由 `Executor.runNext/runUntilIdle/await` 驱动；
/// - `tryStart` 的返回值用于调试；v0 不把它作为错误模型的一部分。
fun Executor.spawn(block: () -> Int): Task<Int> {
    val t: Task<Int> = taskCreate(block)
    val _started: Bool = t.tryStart(this)
    return t
}

/// await：驱动 executor 直到 task 完成，并返回结果（v0：`Int` 专用）。
///
/// 失败语义（early stage）：
/// - 若 executor 无可运行 job 但 task 仍未完成，则视为 deadlock（或缺失 I/O driver），
///   通过 `Raise.raise(RuntimeError.NullAssertionFailed)` 终止。
fun Executor.await(task: Task<Int>): Int / Raise<RuntimeError> {
    // 说明：
    // - 规范层面 `await` 是 `perform Async.await(task)`（见 `scoop.core.Async`）；
    // - `Executor.await` 在 stdlib v0 阶段提供“阻塞式等待”：驱动 executor 直到 task 完成；
    // - 为避免在 handler arm 的 block expression 内引入 `while`（当前阶段 typecheck 对该形态仍有限制），
    //   这里先在函数体内完成“驱动 executor”工作，再用一个非恢复 arm 把最终取值统一表达为 `Async.await(task)`。
    val _ = task.tryStart(this)

    // runtime/c/scoop_task_executor.c:
    // - CREATED = 0
    // - SCHEDULED = 1
    // - RUNNING = 2
    // - COMPLETED = 3
    //
    // 为避免字面量：用 `sizeOf(Int)` 派生出 `1`，并组合得到 `3`。
    val stateNow: Int = task.state()
    val w: Int = sizeOf(stateNow)
    val one: Int = w / w
    val completed: Int = one + one + one

    while (task.state() != completed) {
        val ran: Bool = this.runNext()
        when (ran) {
            true -> ()
            false -> Raise.raise(RuntimeError.NullAssertionFailed)
        }
    }

    val result: Int = handle {
        Async.await(task)
    } with {
        Async.await(taskArg: Task<Int>) -> taskArg.result()
    }
    return result
}

/// map：当 task 完成时，应用 mapper 并完成一个新的 task（v0：`Int` 专用）。
///
/// 说明：
/// - v0 只支持 `Int`，避免过早引入泛型/单态化边角；
/// - 该实现基于“escape continuation + executor”的语义：
///   - 当 handler 捕获到 `Async.await(task)` 时，把 continuation 注册到 `task.onComplete`；
///   - task 完成时，runtime 会把 continuation 入队到 executor 并以 result 恢复；
///   - continuation 恢复后执行 mapper 并 complete 输出 task。
fun Task<Int>.map(executor: Executor, mapper: (Int) -> Int): Task<Int> {
    val resultTask: Task<Int> = taskCreateManual()
    val _ = this.tryStart(executor)

    val _setup: Unit = handle {
        val v: Int = Async.await(this)
        val mapped: Int = mapper(v)
        val done: Bool = resultTask.complete(mapped)
        when (done) {
            true -> ()
            false -> ()
        }
    } with {
        Async.await(task: Task<Int>), k -> {
            val ok: Bool = task.onComplete(executor, k)
            when (ok) {
                true -> ()
                false -> ()
            }
        }
    }

    return resultTask
}

/// andThen（flatMap）：当 task 完成时，运行 binder 生成下一个 task，并转发其完成结果。
///
/// 说明：
/// - `andThen` 会在获得 next task 后尝试 start 它，以便 `executor.await(t.andThen(...))` 可直接工作；
/// - next task 也允许是 manual task：此时 `tryStart` 会返回 false，但仍可被外部 complete。
fun Task<Int>.andThen(executor: Executor, binder: (Int) -> Task<Int>): Task<Int> {
    val resultTask: Task<Int> = taskCreateManual()
    val _ = this.tryStart(executor)

    val _setup: Unit = handle {
        val v1: Int = Async.await(this)
        val next: Task<Int> = binder(v1)
        val _ = next.tryStart(executor)

        // 当前 LLVM 后端的 escape continuation handle 只支持单个 perform 点；
        // 因此这里用“二段 handle”串联两个 await：
        // - 第一段：等待 `this` 完成，拿到 v1 后创建/启动 next；
        // - 第二段：等待 next 完成，拿到 v2 后完成 resultTask。
        val _setup2: Unit = handle {
            val v2: Int = Async.await(next)
            val done: Bool = resultTask.complete(v2)
            when (done) {
                true -> ()
                false -> ()
            }
        } with {
            Async.await(task: Task<Int>), k -> {
                val ok: Bool = task.onComplete(executor, k)
                when (ok) {
                    true -> ()
                    false -> ()
                }
            }
        }
    } with {
        Async.await(task: Task<Int>), k -> {
            val ok: Bool = task.onComplete(executor, k)
            when (ok) {
                true -> ()
                false -> ()
            }
        }
    }

    return resultTask
}
