// Scoop stdlib（pure scoop）：Set / MutableSet
//
// T1818：
// - `MutableSet` 的内部表示改为开放寻址（linear probing）哈希表；
// - 公开表面仍保持 `typealias` + 扩展函数，不新增 intrinsic；
// - `Set` 继续导出为顺序只读视图，避免把哈希表内部槽位暴露给常规只读使用方。
//
// 说明：
// - 内部哈希表 helper 继续尽量复用现有 `__stdlib_int_*` 派生风格；
// - 只读兼容层（`Set` 视图）使用少量小整数字面量，以避开当前 typealias 扩展上的边角。

package scoop.collections

import scoop.core.*

/// 只读 `Set` 视图（v0）：继续导出为顺序 `Array<Int>`。
typealias Set = Array<Int>

/// 可变 `Set`：内部为哈希表布局，但对外仍保持 `MutableArray<Int>` 别名。
typealias MutableSet = MutableArray<Int>

/// Set：元素个数（只读顺序视图）。
///
/// 注意：这里不叫 `size()`，避免与 sysroot 的 `Array<T>.size()` 扩展函数在同一作用域下冲突。
fun Set.len(): Int {
    return this.size()
}

/// Set：包含查询（只读顺序视图，线性扫描）。
///
/// 说明：
/// - `Set` 由 `MutableSet.asSet()` 导出为紧凑顺序数组；
/// - 因此这里继续按顺序数组语义实现，避免把内部哈希槽位泄漏给只读调用方。
fun Set.contains(value: Int): Bool {
    val n: Int = this.size()
    var found: Bool = false
    var i: Int = 0
    while (i < n) {
        val cur: Int = this.get(i)
        when (cur == value) {
            true -> {
                found = true
                i = n
            }
            false -> ()
        }
        i = i + 1
    }
    return found
}

// --- MutableSet：开放寻址哈希表内部 helper ---
//
// 布局：
//   [entry_count, capacity, state0, key0, state1, key1, ...]
//
// 状态位：
// - 0：空槽位
// - 1：已占用
//
// 说明：
// - 写操作继续保持“返回新集合”的 copy 语义；
// - 因此删除不使用 tombstone，而是重建一张新表，保持探测链紧凑。

/// 根据目标元素个数选择容量，保持负载因子不超过 1/2。
fun __set_capacity_for_entries(entryCount: Int): Int {
    val one: Int = __stdlib_int_one(entryCount)
    val two: Int = one + one
    val four: Int = two + two
    val minCap: Int = four + four

    var needed: Int = entryCount * two
    when (needed < minCap) {
        true -> {
            needed = minCap
        }
        false -> ()
    }

    var cap: Int = minCap
    while (cap < needed) {
        cap = cap + cap
    }
    return cap
}

/// 槽位 state 的索引。
fun __set_slot_state_index(slot: Int, sample: Int): Int {
    val one: Int = __stdlib_int_one(sample)
    val two: Int = one + one
    return two + slot * two
}

/// 槽位 key 的索引。
fun __set_slot_key_index(slot: Int, sample: Int): Int {
    val one: Int = __stdlib_int_one(sample)
    return __set_slot_state_index(slot, sample) + one
}

/// 申请一张空表，并把所有槽位初始化为 empty。
fun __set_alloc_empty_table(capacity: Int): MutableSet {
    val one: Int = __stdlib_int_one(capacity)
    val zero: Int = __stdlib_int_zero(capacity)
    val two: Int = one + one
    val total: Int = two + capacity * two

    val b: Any = __scoop_array_builder_new()
    var i: Int = zero
    while (i < total) {
        __scoop_array_builder_push(b, zero)
        i = i + one
    }

    var table: MutableSet = __scoop_array_builder_build_mutable_array(b)
    table.set(zero, zero)
    table.set(one, capacity)
    return table
}

/// 申请一张足够容纳 `entryCount` 个元素的空表。
fun __set_new_table_for_entries(entryCount: Int): MutableSet {
    return __set_alloc_empty_table(__set_capacity_for_entries(entryCount))
}

/// 把 `%` 的结果调整到 `[0, modulus)`。
fun __set_positive_mod(hash: Int, modulus: Int): Int {
    val zero: Int = __stdlib_int_zero(modulus)

    var result: Int = hash % modulus
    when (result < zero) {
        true -> {
            result = result + modulus
        }
        false -> ()
    }
    return result
}

/// 线性探测的下一个槽位。
fun __set_next_slot(slot: Int, capacity: Int): Int {
    val one: Int = __stdlib_int_one(capacity)
    val zero: Int = __stdlib_int_zero(capacity)

    var next: Int = slot + one
    when (next == capacity) {
        true -> {
            next = zero
        }
        false -> ()
    }
    return next
}

/// 在哈希表中查找 key；命中返回槽位索引，未命中返回 `capacity` 作为哨兵。
fun __set_find_slot(table: MutableSet, key: Int): Int {
    val rawLen: Int = table.size()
    val zero: Int = __stdlib_int_zero(rawLen)
    val one: Int = __stdlib_int_one(rawLen)
    val capacity: Int = table.get(one)
    val full: Int = one

    var result: Int = capacity
    var probes: Int = zero
    var slot: Int = __set_positive_mod(key.hash(), capacity)
    while (probes < capacity) {
        val stateIdx: Int = __set_slot_state_index(slot, capacity)
        val state: Int = table.get(stateIdx)
        when (state == full) {
            true -> {
                val cur: Int = table.get(__set_slot_key_index(slot, capacity))
                when (cur == key) {
                    true -> {
                        result = slot
                        probes = capacity
                    }
                    false -> {
                        probes = probes + one
                        slot = __set_next_slot(slot, capacity)
                    }
                }
            }
            false -> {
                probes = capacity
            }
        }
    }
    return result
}

/// 判断当前底层数组是否符合哈希表布局。
///
/// 说明：
/// - `Set` / `MutableSet` 当前都是 alias；调用点可能把只读顺序视图路由到 mutable 扩展实现；
/// - 因此 mutable 路径需要在运行时区分“哈希表 backing”与“顺序只读视图”。
fun __set_is_hash_layout(table: MutableSet): Bool {
    val rawLen: Int = table.size()
    val zero: Int = __stdlib_int_zero(rawLen)
    val one: Int = __stdlib_int_one(rawLen)
    val two: Int = one + one

    var hashed: Bool = false
    when (rawLen > one) {
        true -> {
            val entryCount: Int = table.get(zero)
            val capacity: Int = table.get(one)
            val expectedTotal: Int = two + capacity * two
            when (capacity > zero) {
                true -> {
                    when (expectedTotal == rawLen) {
                        true -> {
                            when (entryCount <= capacity) {
                                true -> {
                                    hashed = true
                                }
                                false -> ()
                            }
                        }
                        false -> ()
                    }
                }
                false -> ()
            }
        }
        false -> ()
    }
    return hashed
}

/// 向空表或保证不存在重复 key 的表中插入一个元素。
fun __set_insert_assume_absent(table: MutableSet, key: Int): Unit {
    val rawLen: Int = table.size()
    val zero: Int = __stdlib_int_zero(rawLen)
    val one: Int = __stdlib_int_one(rawLen)
    val capacity: Int = table.get(one)
    val full: Int = one

    var probes: Int = zero
    var slot: Int = __set_positive_mod(key.hash(), capacity)
    while (probes < capacity) {
        val stateIdx: Int = __set_slot_state_index(slot, capacity)
        val state: Int = table.get(stateIdx)
        when (state == full) {
            true -> {
                probes = probes + one
                slot = __set_next_slot(slot, capacity)
            }
            false -> {
                table.set(stateIdx, full)
                table.set(__set_slot_key_index(slot, capacity), key)

                val entryCount: Int = table.get(zero)
                table.set(zero, entryCount + one)
                probes = capacity
            }
        }
    }
    return ()
}

/// 把旧表中的 live entries 复制到新表；`skipEnabled=true` 时跳过指定 key。
fun __set_copy_live_entries(
    source: MutableSet,
    dest: MutableSet,
    skipKey: Int,
    skipEnabled: Bool
): Unit {
    val rawLen: Int = source.size()
    val zero: Int = __stdlib_int_zero(rawLen)
    val one: Int = __stdlib_int_one(rawLen)
    val capacity: Int = source.get(one)
    val full: Int = one

    var slot: Int = zero
    while (slot < capacity) {
        val stateIdx: Int = __set_slot_state_index(slot, capacity)
        val state: Int = source.get(stateIdx)
        when (state == full) {
            true -> {
                val key: Int = source.get(__set_slot_key_index(slot, capacity))
                var shouldCopy: Bool = true
                when (skipEnabled) {
                    true -> {
                        when (key == skipKey) {
                            true -> {
                                shouldCopy = false
                            }
                            false -> ()
                        }
                    }
                    false -> ()
                }
                when (shouldCopy) {
                    true -> {
                        __set_insert_assume_absent(dest, key)
                    }
                    false -> ()
                }
            }
            false -> ()
        }
        slot = slot + one
    }
    return ()
}

/// MutableSet：元素个数（O(1) header 读取）。
///
/// 注意：这里不叫 `size()`，避免与 sysroot 的 `MutableArray<T>.size()` 扩展函数在同一作用域下冲突。
fun MutableSet.len(): Int {
    val rawLen: Int = this.size()
    val zero: Int = __stdlib_int_zero(rawLen)
    var result: Int = rawLen
    when (__set_is_hash_layout(this)) {
        true -> {
            result = this.get(zero)
        }
        false -> {
            result = rawLen
        }
    }
    return result
}

/// MutableSet：包含查询（开放寻址，O(1) expected）。
fun MutableSet.contains(value: Int): Bool {
    val rawLen: Int = this.size()
    val one: Int = __stdlib_int_one(rawLen)

    var found: Bool = false
    when (__set_is_hash_layout(this)) {
        true -> {
            val capacity: Int = this.get(one)
            found = __set_find_slot(this, value) != capacity
        }
        false -> {
            var i: Int = 0
            while (i < rawLen) {
                val cur: Int = this.get(i)
                when (cur == value) {
                    true -> {
                        found = true
                        i = rawLen
                    }
                    false -> ()
                }
                i = i + 1
            }
        }
    }
    return found
}

/// 把哈希表布局导出为紧凑顺序数组。
///
/// 说明：
/// - 把物化逻辑放在普通 top-level helper 中，避免当前阶段 typealias receiver 扩展在
///   codegen 上出现额外边角。
fun __set_export_view(table: MutableSet): Array<Int> {
    val rawLen: Int = table.size()
    val zero: Int = __stdlib_int_zero(rawLen)
    val one: Int = __stdlib_int_one(rawLen)
    val capacity: Int = table.get(one)
    val full: Int = one

    val b: Any = __scoop_array_builder_new()
    var slot: Int = zero
    while (slot < capacity) {
        val stateIdx: Int = __set_slot_state_index(slot, capacity)
        val state: Int = table.get(stateIdx)
        when (state == full) {
            true -> {
                val key: Int = table.get(__set_slot_key_index(slot, capacity))
                __scoop_array_builder_push(b, key)
            }
            false -> ()
        }
        slot = slot + one
    }

    return __scoop_array_builder_build_array(b)
}

/// MutableSet → Set（只读视图）：导出为紧凑顺序数组。
fun MutableSet.asSet(): Set {
    var result: Set = __set_export_view(this)
    when (__set_is_hash_layout(this)) {
        true -> {
            result = __set_export_view(this)
        }
        false -> {
            val rawLen: Int = this.size()
            val b: Any = __scoop_array_builder_new()
            var i: Int = 0
            while (i < rawLen) {
                val v: Int = this.get(i)
                __scoop_array_builder_push(b, v)
                i = i + 1
            }
            result = __scoop_array_builder_build_array(b)
        }
    }
    return result
}

/// MutableSet：添加一个元素；若已存在则返回自身。
fun MutableSet.add(value: Int): MutableSet {
    var result: MutableSet = this
    when (this.contains(value)) {
        true -> {
            result = this
        }
        false -> {
            val oldCount: Int = this.len()
            val one: Int = __stdlib_int_one(oldCount)

            val rebuilt: MutableSet = __set_new_table_for_entries(oldCount + one)
            __set_copy_live_entries(this, rebuilt, value, false)
            __set_insert_assume_absent(rebuilt, value)
            result = rebuilt
        }
    }
    return result
}

/// MutableSet：移除一个元素；若不存在则返回自身。
fun MutableSet.remove(value: Int): MutableSet {
    var result: MutableSet = this
    when (this.contains(value)) {
        true -> {
            val oldCount: Int = this.len()
            val one: Int = __stdlib_int_one(oldCount)

            val rebuilt: MutableSet = __set_new_table_for_entries(oldCount - one)
            __set_copy_live_entries(this, rebuilt, value, true)
            result = rebuilt
        }
        false -> {
            result = this
        }
    }
    return result
}

/// 创建一个空 `MutableSet`。
fun mutableIntSet(): MutableSet {
    val b: Any = __scoop_array_builder_new()
    val empty: MutableArray<Int> = __scoop_array_builder_build_mutable_array(b)
    val zero: Int = empty.size()
    return __set_new_table_for_entries(zero)
}
