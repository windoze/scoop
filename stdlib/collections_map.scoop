// Scoop stdlib（pure scoop）：Map / MutableMap v0（early stage）
//
// 目标（TODO T1317f4）：
// - 基于 `MutableArray` 在 pure Scoop 中实现最小 `MutableMap<Int, Int>` 落点；
// - 先以语义正确与可回归为主：线性查找、copy 语义（操作返回新 map）；
// - 不新增 intrinsic；后续可用 `Hashable.hash` + 开放寻址优化。
//
// 重要限制（T1315a）：
// - LLVM 后端 multi-file lowering 仍会拒绝“非入口文件中的 source-backed literals”，
//   因此本文件中避免出现任何 Int/String 字面量；循环常量通过 `__stdlib_int_zero/one` 派生。
//
// 表示方式（v0）：
// - 以一个 `Array<Int>` / `MutableArray<Int>` 承载键值对序列：`[k0, v0, k1, v1, ...]`（长度恒为偶数）。

package scoop.collections

// 说明：
// - sysroot 与 stdlib 属于不同 cone；在 resolver 的最小规则下，跨 cone 的声明需要通过 import 引入；
// - 这里显式 `import scoop.core.*`，用于把 sysroot 的 `Array/MutableArray.size/get` 与 stdlib 的
//   `__stdlib_int_zero/one` / array builder helpers 引入可见范围。
import scoop.core.*

/// 只读 `Map` 视图（v0）：`Int -> Int` 专用落点。
///
/// 注意：
/// - 这里不叫 `Map`，避免与 sysroot 中 `scoop.collections.Map<K, V>`（delegated property 表面）重名。
/// - 0.1 阶段 LLVM codegen 尚未支持“struct 持有 reference fields”（例如 `Array/MutableArray`），
///   因此这里先把 `MapView/MutableMap` 表示为 `Array<Int>` / `MutableArray<Int>` 的 typealias。
typealias MapView = Array<Int>

/// 可变 `Map`（v0）：`Int -> Int` 专用落点（copy 语义：操作返回新 map）。
typealias MutableMap = MutableArray<Int>

/// MapView：键值对个数（v0：Int->Int 专用）。
///
/// 注意：
/// - 不叫 `size()`：避免与 sysroot 的 `Array<T>.size()` 扩展函数在同一作用域下冲突；
/// - 不叫 `len()`：避免与 `MutableSet.len()` 在当前 resolver 的 alias 归一化规则下产生重载歧义。
fun MapView.entryCount(): Int {
    val n: Int = this.size()
    val one: Int = __stdlib_int_one(n)
    val two: Int = one + one
    return n / two
}

/// MapView：是否包含 key（v0：Int->Int 专用）。
fun MapView.containsKey(key: Int): Bool {
    val n: Int = this.size()
    val one: Int = __stdlib_int_one(n)
    val two: Int = one + one
    val zero: Int = __stdlib_int_zero(n)

    var found: Bool = false
    var i: Int = zero
    while (i < n) {
        val k: Int = this.get(i)
        when (k == key) {
            true -> {
                found = true
                // v0：无 `break`；用 `i = n` 退出循环。
                i = n
            }
            false -> ()
        }
        i = i + two
    }
    return found
}

/// MapView：按 key 查询；若不存在返回 `default`（v0：Int->Int 专用）。
fun MapView.getOrDefault(key: Int, default: Int): Int {
    val n: Int = this.size()
    val one: Int = __stdlib_int_one(n)
    val two: Int = one + one
    val zero: Int = __stdlib_int_zero(n)

    var result: Int = default
    var i: Int = zero
    while (i < n) {
        val k: Int = this.get(i)
        when (k == key) {
            true -> {
                val v: Int = this.get(i + one)
                result = v
                i = n
            }
            false -> ()
        }
        i = i + two
    }
    return result
}

/// MutableMap：键值对个数（v0：Int->Int 专用）。
///
/// 注意：
/// - 不叫 `size()`：避免与 sysroot 的 `MutableArray<T>.size()` 扩展函数在同一作用域下冲突；
/// - 不叫 `len()`：避免与 `MutableSet.len()` 在当前 resolver 的 alias 归一化规则下产生重载歧义。
fun MutableMap.entryCount(): Int {
    val n: Int = this.size()
    val one: Int = __stdlib_int_one(n)
    val two: Int = one + one
    return n / two
}

/// MutableMap：是否包含 key（v0：Int->Int 专用）。
fun MutableMap.containsKey(key: Int): Bool {
    val n: Int = this.size()
    val one: Int = __stdlib_int_one(n)
    val two: Int = one + one
    val zero: Int = __stdlib_int_zero(n)

    var found: Bool = false
    var i: Int = zero
    while (i < n) {
        val k: Int = this.get(i)
        when (k == key) {
            true -> {
                found = true
                i = n
            }
            false -> ()
        }
        i = i + two
    }
    return found
}

/// MutableMap：按 key 查询；若不存在返回 `default`（v0：Int->Int 专用）。
fun MutableMap.getOrDefault(key: Int, default: Int): Int {
    val n: Int = this.size()
    val one: Int = __stdlib_int_one(n)
    val two: Int = one + one
    val zero: Int = __stdlib_int_zero(n)

    var result: Int = default
    var i: Int = zero
    while (i < n) {
        val k: Int = this.get(i)
        when (k == key) {
            true -> {
                val v: Int = this.get(i + one)
                result = v
                i = n
            }
            false -> ()
        }
        i = i + two
    }
    return result
}

/// MutableMap：按 key 查询；若不存在返回 `-1`（v0：Int->Int 专用）。
///
/// 说明：v0 为保持纯函数签名（无 `Option<Int>`/无 `Raise`）先使用一个哨兵值；
/// 调用方可先用 `containsKey` 判定是否存在。
///
/// 注意：不叫 `get()`，避免与 `Array/MutableArray.get(index)` 冲突（当前阶段 Map 以数组为底座）。
fun MutableMap.getByKey(key: Int): Int {
    val n: Int = this.size()
    val one: Int = __stdlib_int_one(n)
    val zero: Int = __stdlib_int_zero(n)
    val minus_one: Int = zero - one
    return this.getOrDefault(key, minus_one)
}

/// MutableMap：插入或更新一个键值对（v0：Int->Int 专用）。
///
/// 语义：
/// - 若 key 已存在：更新其 value；
/// - 若 key 不存在：追加 `(key, value)`；
/// - 返回新 map（copy 语义）。
fun MutableMap.put(key: Int, value: Int): MutableMap {
    val n: Int = this.size()
    val one: Int = __stdlib_int_one(n)
    val two: Int = one + one
    val zero: Int = __stdlib_int_zero(n)

    val b: Any = __scoop_array_builder_new()

    var found: Bool = false
    var i: Int = zero
    while (i < n) {
        val k: Int = this.get(i)
        val v: Int = this.get(i + one)
        when (k == key) {
            true -> {
                __scoop_array_builder_push(b, k)
                __scoop_array_builder_push(b, value)
                found = true
            }
            false -> {
                __scoop_array_builder_push(b, k)
                __scoop_array_builder_push(b, v)
            }
        }
        i = i + two
    }

    when (found) {
        true -> ()
        false -> {
            __scoop_array_builder_push(b, key)
            __scoop_array_builder_push(b, value)
        }
    }

    return __scoop_array_builder_build_mutable_array(b)
}

/// MutableMap：移除一个 key；若 key 不存在则返回自身（v0：Int->Int 专用）。
///
/// 注意：不叫 `remove()`，避免与 `MutableSet.remove()` 在当前 resolver 的 alias 归一化规则下产生重载歧义。
fun MutableMap.removeKey(key: Int): MutableMap {
    val n: Int = this.size()
    val one: Int = __stdlib_int_one(n)
    val two: Int = one + one
    val zero: Int = __stdlib_int_zero(n)

    val b: Any = __scoop_array_builder_new()

    var removed: Bool = false
    var i: Int = zero
    while (i < n) {
        val k: Int = this.get(i)
        val v: Int = this.get(i + one)
        when (k == key) {
            true -> {
                removed = true
            }
            false -> {
                __scoop_array_builder_push(b, k)
                __scoop_array_builder_push(b, v)
            }
        }
        i = i + two
    }

    var result: MutableMap = this
    when (removed) {
        true -> {
            result = __scoop_array_builder_build_mutable_array(b)
        }
        false -> {
            result = this
        }
    }
    return result
}

/// MutableMap → MapView（只读视图）：复制为 `Array<Int>`（v0：Int->Int 专用）。
fun MutableMap.asMapView(): MapView {
    val n: Int = this.size()
    val one: Int = __stdlib_int_one(n)
    val zero: Int = __stdlib_int_zero(n)

    val b: Any = __scoop_array_builder_new()
    var i: Int = zero
    while (i < n) {
        // 说明：同 `MutableSet.asSet`：避免把 `get(i)` 直接作为 `array_builder_push` 的实参，
        // 通过显式 `val v: Int = ...` 固化 expected type。
        val v: Int = this.get(i)
        __scoop_array_builder_push(b, v)
        i = i + one
    }

    return __scoop_array_builder_build_array(b)
}

/// 创建一个空 `MutableMap`（不使用字面量）。
fun mutableIntIntMap(): MutableMap {
    val b: Any = __scoop_array_builder_new()
    return __scoop_array_builder_build_mutable_array(b)
}
