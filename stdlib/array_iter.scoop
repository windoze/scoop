// Scoop stdlib（pure scoop）：Array/List 迭代与算法（v0）
//
// 目标（TODO T1317f3）：
// - 在 `Array/MutableArray/List/MutableList` 上提供最小迭代/算法 API：
//   `forEach/map/filter/fold`
// - 当前阶段优先覆盖 `Int` 版本，并保持 effect-polymorphic（`<eff E>`）形态。
//
// 重要限制（T1315a）：
// - LLVM 后端 multi-file lowering 仍会拒绝“非入口文件中的 source-backed literals”，
//   因此本文件中避免出现任何 Int/String 字面量；循环常量通过 `__stdlib_int_zero/one` 派生。

package scoop.core.array

// 说明：
// - 这里显式 import `scoop.core.*`，用于引入 sysroot 的 `Array.size/get` 声明，
//   以及 stdlib 里复用的 `__stdlib_int_zero/one` 与 array builder helpers。
import scoop.core.*

/// 迭代：对每个元素执行 `action`（effect-polymorphic）。
fun <eff E = Pure> Array<Int>.forEach(action: (Int) -> Unit / E): Unit / E {
    val n: Int = this.size()
    val one: Int = __stdlib_int_one(n)
    val zero: Int = __stdlib_int_zero(n)

    var i: Int = zero
    while (i < n) {
        action(this.get(i))
        i = i + one
    }
    return ()
}

/// 变换：把每个元素映射为新值，返回新 `List<Int>`（当前阶段为 `Array<Int>` 的别名）。
fun <eff E = Pure> Array<Int>.map(transform: (Int) -> Int / E): List<Int> / E {
    val n: Int = this.size()
    val one: Int = __stdlib_int_one(n)
    val zero: Int = __stdlib_int_zero(n)

    val b: Any = __scoop_array_builder_new()
    var i: Int = zero
    while (i < n) {
        val v: Int = this.get(i)
        __scoop_array_builder_push(b, transform(v))
        i = i + one
    }

    return __scoop_array_builder_build_array(b)
}

/// 过滤：保留满足 `predicate` 的元素，返回新 `List<Int>`（当前阶段为 `Array<Int>` 的别名）。
fun <eff E = Pure> Array<Int>.filter(predicate: (Int) -> Bool / E): List<Int> / E {
    val n: Int = this.size()
    val one: Int = __stdlib_int_one(n)
    val zero: Int = __stdlib_int_zero(n)

    val b: Any = __scoop_array_builder_new()
    var i: Int = zero
    while (i < n) {
        val v: Int = this.get(i)
        when (predicate(v)) {
            true -> __scoop_array_builder_push(b, v)
            false -> ()
        }
        i = i + one
    }

    return __scoop_array_builder_build_array(b)
}

/// 折叠：从 `initial` 开始，把元素依次合并为一个值（effect-polymorphic）。
fun <eff E = Pure> Array<Int>.fold(initial: Int, op: (Int, Int) -> Int / E): Int / E {
    val n: Int = this.size()
    val one: Int = __stdlib_int_one(n)
    val zero: Int = __stdlib_int_zero(n)

    var acc: Int = initial
    var i: Int = zero
    while (i < n) {
        acc = op(acc, this.get(i))
        i = i + one
    }
    return acc
}
