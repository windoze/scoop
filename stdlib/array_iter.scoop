// Scoop stdlib（pure scoop）：Array/List 迭代与算法（v0）
//
// 目标（TODO T1317f3）：
// - 在 `Array/MutableArray/List/MutableList` 上提供最小迭代/算法 API：
//   `forEach/map/filter/fold`
// - 当前阶段优先覆盖 `Int` 版本，并保持 effect-polymorphic（`<eff E>`）形态。
//
// 重要限制（T1315a）：
// - LLVM 后端 multi-file lowering 仍会拒绝“非入口文件中的 source-backed literals”，
//   因此本文件中避免出现任何 Int/String 字面量；循环常量通过 `__stdlib_int_zero/one` 派生。

package scoop.core.array

// 说明：
// - 这里显式 import `scoop.core.*`，用于引入 sysroot 的 `Array.size/get` 声明，
//   以及 stdlib 里复用的 `__stdlib_int_zero/one` 与 MutableArray helpers。
import scoop.core.*

/// 迭代：对每个元素执行 `action`（effect-polymorphic）。
fun <eff E = Pure> Array<Int>.forEach(action: (Int) -> Unit / E): Unit / E {
    val n: Int = this.size()
    val one: Int = __stdlib_int_one(n)
    val zero: Int = __stdlib_int_zero(n)

    var i: Int = zero
    while (i < n) {
        action(this.get(i))
        i = i + one
    }
    return ()
}

/// 变换：把每个元素映射为新值，返回新 `List<Int>`（当前阶段为 `Array<Int>` 的别名）。
fun <eff E = Pure> Array<Int>.map(transform: (Int) -> Int / E): List<Int> / E {
    val n: Int = this.size()
    val one: Int = __stdlib_int_one(n)
    val zero: Int = __stdlib_int_zero(n)

    val result: MutableArray<Int> = mutableArrayNew<Int>(capacity = n)
    var i: Int = zero
    while (i < n) {
        val v: Int = this.get(i)
        result.push(transform(v))
        i = i + one
    }

    return result.freeze()
}

/// 过滤：保留满足 `predicate` 的元素，返回新 `List<Int>`（当前阶段为 `Array<Int>` 的别名）。
fun <eff E = Pure> Array<Int>.filter(predicate: (Int) -> Bool / E): List<Int> / E {
    val n: Int = this.size()
    val one: Int = __stdlib_int_one(n)
    val zero: Int = __stdlib_int_zero(n)

    val result: MutableArray<Int> = mutableArrayNew<Int>(capacity = n)
    var i: Int = zero
    while (i < n) {
        val v: Int = this.get(i)
        when (predicate(v)) {
            true -> result.push(v)
            false -> ()
        }
        i = i + one
    }

    return result.freeze()
}

/// 折叠：从 `initial` 开始，把元素依次合并为一个值（effect-polymorphic）。
fun <eff E = Pure> Array<Int>.fold(initial: Int, op: (Int, Int) -> Int / E): Int / E {
    val n: Int = this.size()
    val one: Int = __stdlib_int_one(n)
    val zero: Int = __stdlib_int_zero(n)

    var acc: Int = initial
    var i: Int = zero
    while (i < n) {
        acc = op(acc, this.get(i))
        i = i + one
    }
    return acc
}

/// 归约：从第一个元素开始，依次合并为一个值（要求非空数组）。
///
/// 与 `fold` 的区别：不需要 `initial`，直接以 `this.get(0)` 作为初始累加器，
/// 从索引 1 开始迭代。空数组行为未定义（当前阶段不做额外检查）。
fun <eff E = Pure> Array<Int>.reduce(op: (Int, Int) -> Int / E): Int / E {
    val n: Int = this.size()
    val one: Int = __stdlib_int_one(n)
    val zero: Int = __stdlib_int_zero(n)

    var acc: Int = this.get(zero)
    var i: Int = one
    while (i < n) {
        acc = op(acc, this.get(i))
        i = i + one
    }
    return acc
}

/// 配对：将两个 `Array<Int>` 按索引配对，返回 flat interleaved `Array<Int>`。
///
/// 结果格式：`[a[0], b[0], a[1], b[1], ...]`，长度为 `min(a.size, b.size) * 2`。
/// 当前阶段返回 flat 布局（tuple array 尚不支持）。
fun Array<Int>.zip(other: Array<Int>): Array<Int> {
    val n: Int = this.size()
    val m: Int = other.size()
    val one: Int = __stdlib_int_one(n)
    val zero: Int = __stdlib_int_zero(n)

    // len = min(n, m)
    var len: Int = n
    when (m < n) {
        true -> { len = m }
        false -> ()
    }

    val result: MutableArray<Int> = mutableArrayNew<Int>(capacity = len + len)
    var i: Int = zero
    while (i < len) {
        result.push(this.get(i))
        result.push(other.get(i))
        i = i + one
    }
    return result.freeze()
}

/// T1816: 将 Array<Int> 的元素以指定分隔符连接为字符串。
///
/// 使用 `Int.toString()` 和 `String.concat()` 实现。
/// 空数组返回空字符串（通过 separator.substring(0, 0) 派生）。
fun Array<Int>.joinToString(separator: String): String {
    val n: Int = this.size()
    val one: Int = __stdlib_int_one(n)
    val zero: Int = __stdlib_int_zero(n)

    // 空字符串派生：separator.substring(0, 0) 返回空字符串，无需字面量。
    var result: String = separator.substring(zero, zero)

    var i: Int = zero
    while (i < n) {
        when (i > zero) {
            true -> { result = result.concat(separator) }
            false -> ()
        }
        val elem: String = this.get(i).toString()
        result = result.concat(elem)
        i = i + one
    }
    return result
}
