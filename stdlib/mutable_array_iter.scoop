// Scoop stdlib（pure scoop）：MutableArray/MutableList 迭代与算法（v0）
//
// 目标（TODO T1317f3）：
// - 为 `MutableArray<Int>` 提供 Kotlin-like `forEach/map/filter/fold`；
// - 与 `MutableList<Int>`（sysroot typealias）兼容：receiver 归一化由 resolver（T1317f2）负责。
//
// 重要限制（T1315a）：
// - LLVM 后端 multi-file lowering 仍会拒绝“非入口文件中的 source-backed literals”，
//   因此本文件中避免出现任何 Int/String 字面量；循环常量通过 `__stdlib_int_zero/one` 派生。

package scoop.core.mutable_array

import scoop.core.*

/// 迭代：对每个元素执行 `action`（effect-polymorphic）。
fun <eff E = Pure> MutableArray<Int>.forEach(action: (Int) -> Unit / E): Unit / E {
    val n: Int = this.size()
    val one: Int = __stdlib_int_one(n)
    val zero: Int = __stdlib_int_zero(n)

    var i: Int = zero
    while (i < n) {
        action(this.get(i))
        i = i + one
    }
    return ()
}

/// 变换：把每个元素映射为新值，返回新 `List<Int>`（当前阶段为 `Array<Int>` 的别名）。
fun <eff E = Pure> MutableArray<Int>.map(transform: (Int) -> Int / E): List<Int> / E {
    val n: Int = this.size()
    val one: Int = __stdlib_int_one(n)
    val zero: Int = __stdlib_int_zero(n)

    val result: MutableArray<Int> = mutableArrayNew<Int>(capacity = n)
    var i: Int = zero
    while (i < n) {
        val v: Int = this.get(i)
        result.push(transform(v))
        i = i + one
    }

    return result.freeze()
}

/// 过滤：保留满足 `predicate` 的元素，返回新 `List<Int>`（当前阶段为 `Array<Int>` 的别名）。
fun <eff E = Pure> MutableArray<Int>.filter(predicate: (Int) -> Bool / E): List<Int> / E {
    val n: Int = this.size()
    val one: Int = __stdlib_int_one(n)
    val zero: Int = __stdlib_int_zero(n)

    val result: MutableArray<Int> = mutableArrayNew<Int>(capacity = n)
    var i: Int = zero
    while (i < n) {
        val v: Int = this.get(i)
        when (predicate(v)) {
            true -> result.push(v)
            false -> ()
        }
        i = i + one
    }

    return result.freeze()
}

/// 折叠：从 `initial` 开始，把元素依次合并为一个值（effect-polymorphic）。
fun <eff E = Pure> MutableArray<Int>.fold(
    initial: Int,
    op: (Int, Int) -> Int / E,
): Int / E {
    val n: Int = this.size()
    val one: Int = __stdlib_int_one(n)
    val zero: Int = __stdlib_int_zero(n)

    var acc: Int = initial
    var i: Int = zero
    while (i < n) {
        acc = op(acc, this.get(i))
        i = i + one
    }
    return acc
}

/// 归约：从第一个元素开始，依次合并为一个值（要求非空数组）。
///
/// 与 `fold` 的区别：不需要 `initial`，直接以 `this.get(0)` 作为初始累加器，
/// 从索引 1 开始迭代。空数组行为未定义（当前阶段不做额外检查）。
fun <eff E = Pure> MutableArray<Int>.reduce(op: (Int, Int) -> Int / E): Int / E {
    val n: Int = this.size()
    val one: Int = __stdlib_int_one(n)
    val zero: Int = __stdlib_int_zero(n)

    var acc: Int = this.get(zero)
    var i: Int = one
    while (i < n) {
        acc = op(acc, this.get(i))
        i = i + one
    }
    return acc
}

/// 原地排序（选择排序，O(n²)；性能后置）。
///
/// 使用 `get`/`set` 进行原地交换，不分配新数组。
fun MutableArray<Int>.sort(): Unit {
    val n: Int = this.size()
    val one: Int = __stdlib_int_one(n)
    val zero: Int = __stdlib_int_zero(n)

    var i: Int = zero
    while (i < n) {
        // 在 [i, n) 中找到最小值的索引
        var minIdx: Int = i
        var j: Int = i + one
        while (j < n) {
            when (this.get(j) < this.get(minIdx)) {
                true -> { minIdx = j }
                false -> ()
            }
            j = j + one
        }
        // 交换 this[i] 与 this[minIdx]
        val tmp: Int = this.get(i)
        this.set(i, this.get(minIdx))
        this.set(minIdx, tmp)
        i = i + one
    }
    return ()
}
