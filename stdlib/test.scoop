// Scoop stdlib（pure scoop）：test utilities v0
//
// 说明：
// - 本文件为 fixtures/示例提供最小断言工具（TODO T1320a）。
// - 由于当前阶段后端对 multi-file lowering 的限制（非入口文件的字面量门禁），
//   本文件不直接包含 Int/String 字面量；断言失败时通过 `Raise<RuntimeError>` 终止。

package scoop.test

import scoop.core.*

/// 断言：condition 必须为 true。
///
/// 失败语义：通过 `Raise.raise(RuntimeError.NullAssertionFailed)` 终止当前计算（见 `require`）。
fun assertTrue(condition: Bool): Unit / Raise<RuntimeError> {
    require(condition)
}

/// 断言：condition 必须为 false。
///
/// 失败语义：通过 `Raise.raise(RuntimeError.NullAssertionFailed)` 终止当前计算。
fun assertFalse(condition: Bool): Unit / Raise<RuntimeError> {
    when (condition) {
        true -> Raise.raise(RuntimeError.NullAssertionFailed)
        false -> ()
    }
}

/// 断言：两个 Int 必须相等。
///
/// 说明：v0 仅提供 `Int` 专用版本，避免过早引入泛型比较/接口约束的边角。
fun assertEqInt(expected: Int, actual: Int): Unit / Raise<RuntimeError> {
    require(expected == actual)
}

/// 断言：`value` 必须是 `Some(Int)`；并返回其中的 Int 值，方便链式书写。
fun assertSomeInt(value: Int?): Int / Raise<RuntimeError> {
    // 说明：
    // - 当前阶段 LLVM codegen 对“`when` 的结果值合并”有较强约束；
    // - 为避免 `Some(v) -> v` 与 `None -> Raise.raise(...)` 的分支返回类型不一致导致的 codegen 失败，
    //   这里改为“先给 out 一个占位初值，再在 `Some` 分支写回；`None` 分支直接 raise 并退出”。
    //
    // `__scoop_effect_slot_read_value()` 用作“无字面量的 Int 占位值”：
    // - 该路径仅用于初始化占位；在 `Some` 分支会被覆盖；
    // - `None` 分支会 `Raise.raise`，因此不会返回该占位值到调用点。
    var result: Int = __scoop_effect_slot_read_value()
    when (value) {
        Some(v) -> {
            result = v
        }
        None -> {
            Raise.raise(RuntimeError.NullAssertionFailed)
        }
    }
    return result
}

/// 断言：`value` 必须是 `None`。
fun assertNoneInt(value: Int?): Unit / Raise<RuntimeError> {
    when (value) {
        Some(_) -> Raise.raise(RuntimeError.NullAssertionFailed)
        None -> ()
    }
}
